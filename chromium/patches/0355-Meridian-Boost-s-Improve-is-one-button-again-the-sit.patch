diff --git a/chrome/browser/resources/webui_browser/meridian/improve_words.ts b/chrome/browser/resources/webui_browser/meridian/improve_words.ts
new file mode 100644
index 0000000000..9dbae4e390
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/improve_words.ts
@@ -0,0 +1,53 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Boost's Improve with AI, as in 1.5.2 and simpler: one button makes the
+// site less distracting in one quick round, and what it hides becomes the
+// site's Zaps, each with its name. Its words in Russian or English (the
+// browser's language).
+
+export function improveInRussian(): boolean {
+  return (document.documentElement.lang || navigator.language || '')
+      .toLowerCase()
+      .startsWith('ru');
+}
+
+// A Zap the AI picked carries its name as a comment ("ytd-rich-shelf-renderer
+// [is-shorts] /* the Shorts shelf */", boost_improver.cc): the name for the
+// list, the selector for the page.
+const NAMED = /^(.*?)\s*\/\*\s*(.*?)\s*\*\/\s*$/s;
+
+export function zapName(zap: string): string {
+  const m = zap.match(NAMED);
+  return m && m[2] ? m[2] : zap;
+}
+
+export function zapSelector(zap: string): string {
+  const m = zap.match(NAMED);
+  return m ? m[1]! : zap;
+}
+
+export function improveWords(ru: boolean) {
+  return ru ? {
+    button: 'Убрать лишнее',
+    looking: 'Смотрю страницу…',
+    hint: (ai: string) => `${ai} спрячет то, что отвлекает: полки Shorts, ` +
+        'счётчики, промо-баннеры, всплывашки. Каждое станет Zap — вернуть ' +
+        'можно по одному.',
+    undo: 'Отменить всё',
+    undone: 'Отменено.',
+    setUp: 'Открыть Настройки › ИИ',
+    noAi: 'Нет ИИ для Improve: подключите Claude Code, Codex или ключ API.',
+  } : {
+    button: 'Declutter',
+    looking: 'Looking at the page…',
+    hint: (ai: string) => `${ai} hides what distracts: Shorts shelves, ` +
+        'counters, promo banners, popups. Each becomes a Zap you can bring ' +
+        'back one by one.',
+    undo: 'Undo all',
+    undone: 'Undone.',
+    setUp: 'Open Settings › AI',
+    noAi: 'No AI for Improve yet: connect Claude Code, Codex or an API key.',
+  };
+}
