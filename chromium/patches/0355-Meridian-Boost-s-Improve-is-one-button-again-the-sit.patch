+// A Zap with its name as a comment, the name made safe for one.
+std::string NamedZap(const std::string& sel, std::string name) {
+  base::ReplaceSubstringsAfterOffset(&name, 0, "*/", "");
+  base::ReplaceSubstringsAfterOffset(&name, 0, "/*", "");
+  std::erase_if(name, [](char c) {
+    return c == '{' || c == '}' || c == '<' || c == '\\' || c == '\n';
+  });
+  name = std::string(base::TrimWhitespaceASCII(name, base::TRIM_ALL));
+  return name.empty() ? sel : sel + " /* " + name + " */";
+}
+
+// A Zap's selector, without its name.
+std::string ZapSelector(const std::string& zap) {
+  const size_t at = zap.find(" /* ");
+  return at == std::string::npos || !zap.ends_with(" */") ? zap
+                                                          : zap.substr(0, at);
+}
+
