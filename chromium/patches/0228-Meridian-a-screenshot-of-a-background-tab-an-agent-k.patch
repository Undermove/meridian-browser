From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Sat, 21 Nov 2026 20:24:27 +0400
Subject: [PATCH 228/297] Meridian: a screenshot of a background tab an agent
 keeps awake; 0.6.24

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../browser/meridian/agent/agent_service.cc   | 36 +++++++++++++------
 chrome/browser/meridian/update_check.h        |  2 +-
 2 files changed, 26 insertions(+), 12 deletions(-)

diff --git a/chrome/browser/meridian/agent/agent_service.cc b/chrome/browser/meridian/agent/agent_service.cc
index 684a9049e2..5e85ae7038 100644
--- a/chrome/browser/meridian/agent/agent_service.cc
+++ b/chrome/browser/meridian/agent/agent_service.cc
@@ -1297,25 +1297,39 @@ void AgentService::Screenshot(std::unique_ptr<Call> call) {
   // On the screen: a copy of what it shows. Not (a background tab, a covered
   // or minimized window): one frame of a video capture, which draws without
   // the window (as Chrome's tab previews).
+  const auto capture_frame = [](content::RenderWidgetHostView* view,
+                                std::unique_ptr<Call> call) {
+    const gfx::Size size = gfx::ScaleToCeiledSize(view->GetViewBounds().size(),
+                                                  view->GetDeviceScaleFactor());
+    meridian::CaptureTabFrame(
+        view, size.IsEmpty() ? gfx::Size(1280, 800) : size, base::Seconds(10),
+        base::BindOnce(&FinishScreenshot, std::move(call)));
+  };
   if (contents->GetVisibility() == content::Visibility::VISIBLE) {
+    // "Visible" is also a background tab an agent keeps awake: it has no
+    // surface to copy, so then a frame of a video capture.
     view->CopyFromSurface(
         gfx::Rect(), gfx::Size(), base::Seconds(10),
         base::BindOnce(
-            [](std::unique_ptr<Call> call,
+            [](base::WeakPtr<content::WebContents> contents,
+               void (*capture_frame)(content::RenderWidgetHostView*,
+                                     std::unique_ptr<Call>),
+               std::unique_ptr<Call> call,
                const content::CopyFromSurfaceResult& result) {
-              FinishScreenshot(std::move(call), result.has_value()
-                                                    ? result->bitmap
-                                                    : SkBitmap());
+              if (result.has_value() && !result->bitmap.drawsNothing()) {
+                return FinishScreenshot(std::move(call), result->bitmap);
+              }
+              content::RenderWidgetHostView* view =
+                  contents ? contents->GetRenderWidgetHostView() : nullptr;
+              if (!view) {
+                return FinishScreenshot(std::move(call), SkBitmap());
+              }
+              capture_frame(view, std::move(call));
             },
-            std::move(call)));
+            contents->GetWeakPtr(), +capture_frame, std::move(call)));
     return;
   }
-  const gfx::Size size = gfx::ScaleToCeiledSize(
-      view->GetViewBounds().size(),
-      view->GetDeviceScaleFactor());
-  meridian::CaptureTabFrame(
-      view, size.IsEmpty() ? gfx::Size(1280, 800) : size, base::Seconds(10),
-      base::BindOnce(&FinishScreenshot, std::move(call)));
+  capture_frame(view, std::move(call));
 }
 
