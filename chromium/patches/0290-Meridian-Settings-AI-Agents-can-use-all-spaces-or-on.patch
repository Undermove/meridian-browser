+bool AgentService::SpaceAllowed(const std::string& space_id) {
+  PrefService* prefs = profile_->GetPrefs();
+  return space_id.empty() || prefs->GetString(prefs::kAgentSpaces) != "only" ||
+         prefs->GetList(prefs::kAgentSpaceIds).contains(space_id);
+}
+
+std::string AgentService::SpaceOfTab(tabs::TabInterface* tab) {
+  SidebarService* service = SidebarServiceFactory::GetForProfile(profile_);
+  const TabData* data = TabData::Get(tab->GetContents());
+  if (data && !data->item_id().empty()) {
+    // A favorite is in every space.
+    std::function<bool(const std::vector<Item>&)> has =
+        [&](const std::vector<Item>& items) {
+          for (const Item& item : items) {
+            if (item.id == data->item_id() ||
+                (item.is_folder && has(item.children))) {
+              return true;
+            }
+          }
+          return false;
+        };
+    if (has(service->favorites())) {
+      return std::string();
+    }
+  }
+  return data && !data->space_id().empty() ? data->space_id()
+                                           : service->active_space_id();
+}
+
+std::string AgentService::SpaceOfItem(const std::string& item_id) {
+  SidebarService* service = SidebarServiceFactory::GetForProfile(profile_);
+  std::function<bool(const std::vector<Item>&)> has =
+      [&](const std::vector<Item>& items) {
+        for (const Item& item : items) {
+          if (item.id == item_id || (item.is_folder && has(item.children))) {
+            return true;
+          }
+        }
+        return false;
+      };
+  for (const Space& space : service->spaces()) {
+    if (has(space.pinned)) {
+      return space.id;
+    }
+  }
+  return std::string();
+}
+
 tabs::TabInterface* AgentService::AnyTabFor(const Call& call) {
+  tabs::TabInterface* tab = AnyTabInAnySpace(call);
+  if (tab) {
+    std::string space = SpaceOfTab(tab);
+    if (!SpaceAllowed(space)) {
+      const Space* s =
+          SidebarServiceFactory::GetForProfile(profile_)->FindSpace(space);
+      call.space_refused = s && !s->name.empty() ? s->name : "another space";
+      return nullptr;
+    }
+  }
+  return tab;
+}
