+  // "Only these" starts from the space on screen.
+  private async chooseAgentSpaces_(value: string) {
+    if (value !== 'only' || this.settings_!.agentSpaceIds.length) {
+      this.save_({agentSpaces: value});
+      return;
+    }
+    const {state} = await this.handler_.getState();
+    this.save_({
+      agentSpaces: value,
+      agentSpaceIds: state.activeSpaceId ? [state.activeSpaceId] : [],
+    });
+  }
+
+  protected onAgentSpaceChange_(e: Event) {
+    const input = e.target as HTMLInputElement;
+    const id = input.dataset['space']!;
+    const ids = this.settings_!.agentSpaceIds.filter(s => s !== id);
+    this.save_({agentSpaceIds: input.checked ? [...ids, id] : ids});
+  }
+
   protected onAllowJsChange_(e: Event) {
     this.save_({agentAllowJs: (e.target as HTMLInputElement).checked});
   }
