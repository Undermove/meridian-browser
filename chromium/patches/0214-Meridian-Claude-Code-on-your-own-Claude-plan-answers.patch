+std::optional<bool> ClaudeCodeAuth(const std::string& out, std::string*) {
+  std::optional<base::Value> v = base::JSONReader::Read(out, 0);
+  if (!v || !v->is_dict()) {
+    return std::nullopt;
+  }
+  return v->GetDict().FindBool("loggedIn");
+}
+
