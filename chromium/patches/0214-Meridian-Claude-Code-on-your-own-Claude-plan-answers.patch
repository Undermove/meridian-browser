   bool resume = false;
+  // Started inside Meridian's sandbox (the CLI keeps tools that read files).
+  // Claude Code runs with every tool off by its own switches instead: the
+  // sandbox would also keep it from its sign-in (in the Keychain).
+  bool sandboxed = true;
   // HTTP: where the local server listens; cloud: the API base.
   std::string base;
 };
