+void ClaudeCode(const base::DictValue& o, std::vector<Event>& out) {
+  std::string type = StringAt(o, "type");
+  const base::Value* parent = o.Find("parent_tool_use_id");
+  const bool top = !parent || parent->is_none();
+  if (type == "stream_event" && top &&
+      StringAt(o, "event.type") == "content_block_delta" &&
+      StringAt(o, "event.delta.type") == "text_delta") {
+    out.push_back({Event::Type::kDelta, StringAt(o, "event.delta.text")});
+  } else if (type == "result") {
+    if (BoolAt(o, "is_error")) {
+      std::string message = StringAt(o, "result");
+      if (const base::ListValue* errors = o.FindList("errors");
+          message.empty() && errors && !errors->empty() &&
+          (*errors)[0].is_string()) {
+        message = (*errors)[0].GetString();
+      }
+      out.push_back({Event::Type::kError,
+                     message.empty() ? "Claude Code failed" : message});
+    } else {
+      out.push_back({Event::Type::kFinal, StringAt(o, "result")});
+    }
+  }
+}
+
