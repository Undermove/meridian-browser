+                 "stream-json",
+                 "--verbose",
+                 "--include-partial-messages",
+                 "--tools",
+                 "",
+                 "--permission-mode",
+                 "dontAsk",
+                 "--no-session-persistence",
+                 "--disable-slash-commands",
+                 "--strict-mcp-config",
+                 "--setting-sources",
+                 "",
+                 "--append-system-prompt",
+                 rules};
+    model("--model");
+    spec.stdin_text = turn.prompt;
   } else if (p.id == "opencode") {
     // Every permission denied; no project config, Claude Code files or
     // plugins.
@@ -642,6 +714,7 @@ std::unique_ptr<OutputParser> MakeParser(const Provider& p) {
