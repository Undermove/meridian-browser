From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 19 Nov 2026 20:48:53 +0400
Subject: [PATCH] Meridian: the Windows build of the background task count

BackgroundShells is used only where background tasks are counted (not on
Windows, where the process list has no command lines); on Windows it is
left out, so the build doesn't fail on its FilePath from a std::string.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/meridian/workbench/workbench_handler.cc | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/chrome/browser/meridian/workbench/workbench_handler.cc b/chrome/browser/meridian/workbench/workbench_handler.cc
index 450e0b1852..5cc90a209e 100644
--- a/chrome/browser/meridian/workbench/workbench_handler.cc
+++ b/chrome/browser/meridian/workbench/workbench_handler.cc
@@ -2675,6 +2675,7 @@ void WorkbenchHandler::CreateSandbox(std::string kind,
           cols, rows, std::move(registration), std::move(reply)));
 }
 
+#if !BUILDFLAG(IS_WIN)  // Counted only where the process list has command lines.
 namespace {
 
 // The background commands an agent left running: shells (`sh -c …`, how
@@ -2722,6 +2723,7 @@ int BackgroundShells(int root,
 }
 
 }  // namespace
+#endif  // !BUILDFLAG(IS_WIN)
 
 void WorkbenchHandler::CountBackgroundTasks() {
   std::map<std::string, int> roots;
