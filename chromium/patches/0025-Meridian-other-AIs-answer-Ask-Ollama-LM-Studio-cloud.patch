+std::vector<std::string> DetectKey(const std::string& raw) {
+  std::string key(base::TrimWhitespaceASCII(raw, base::TRIM_ALL));
+  if (RE2::PartialMatch(key, "^sk-ant-")) {
+    return {"anthropic"};
+  }
+  if (RE2::PartialMatch(key, "^sk-or-")) {
+    return {"openrouter"};
+  }
+  if (RE2::FullMatch(key, "AIza[0-9A-Za-z_-]{30,}")) {
+    return {"gemini"};
+  }
+  if (RE2::PartialMatch(key, "^xai-")) {
+    return {"xai"};
+  }
+  if (RE2::PartialMatch(key, "^gsk_")) {
+    return {"groq"};
+  }
+  if (RE2::PartialMatch(key, "^sk-(proj|svcacct|admin)-")) {
+    return {"openai"};
+  }
+  if (RE2::FullMatch(key, "sk-[0-9a-f]{32}")) {
+    return {"deepseek", "openai"};
+  }
+  if (RE2::FullMatch(key, "sk-[A-Za-z0-9_-]{20,}")) {
+    return {"openai", "deepseek"};
+  }
+  if (RE2::FullMatch(key, "[A-Za-z0-9]{32}")) {
+    return {"mistral"};
+  }
+  return {};
+}
