+// Every run: tools off, or as close to off as the CLI allows (read-only
+// sandbox, no MCP, no user plugins or hooks), because page text in the
+// prompt is untrusted. The prompt goes on stdin where the CLI supports it,
+// never through a shell.
+CommandSpec BuildCommand(const Provider& p,
+                         const Turn& turn,
+                         const std::string& cwd) {
+  CommandSpec spec;
+  const bool resume = p.resume && !turn.resume.empty();
+  const bool first = !resume;
+  auto model = [&](const char* flag) {
+    if (!turn.model.empty()) {
+      spec.args.push_back(flag);
+      spec.args.push_back(turn.model);
+    }
+  };
+  if (p.id == "codex") {
+    // No "no tools" switch: a read-only sandbox (no writes, no network).
+    // `exec resume` has no --sandbox flag; the config override works for
+    // both.
+    std::vector<std::string> base = {"--json",
+                                     "--skip-git-repo-check",
+                                     "-c",
+                                     "sandbox_mode=\"read-only\"",
+                                     "-c",
+                                     "approval_policy=\"never\"",
+                                     "--ignore-user-config",
+                                     "--ignore-rules"};
+    if (!turn.model.empty()) {
+      base.push_back("-m");
+      base.push_back(turn.model);
+    }
+    spec.args = {"exec"};
+    if (resume) {
+      spec.args.push_back("resume");
+    }
+    spec.args.insert(spec.args.end(), base.begin(), base.end());
+    if (resume) {
+      spec.args.push_back(turn.resume);
+    }
+    spec.args.push_back("-");
+    spec.stdin_text = WithSystem(turn, first);
+  } else if (p.id == "copilot") {
+    // No stdin prompt mode: the prompt goes in argv (no shell involved).
+    spec.args = {"-p",
+                 WithSystem(turn, true),
+                 "-s",
+                 "--stream",
+                 "on",
+                 "--available-tools=",
+                 "--disable-builtin-mcps",
+                 "--no-custom-instructions",
+                 "--no-ask-user",
+                 "--no-auto-update",
+                 "--no-color"};
+    model("--model");
+  } else if (p.id == "cursor") {
+    // "ask" mode is Cursor's read-only Q&A.
+    spec.args = {"-p",
+                 WithSystem(turn, first),
+                 "--output-format",
+                 "stream-json",
+                 "--stream-partial-output",
+                 "--mode",
+                 "ask",
+                 "--trust",
+                 "--workspace",
+                 cwd};
+    if (resume) {
+      spec.args.push_back("--resume");
+      spec.args.push_back(turn.resume);
+    }
+    model("--model");
+  } else if (p.id == "opencode") {
+    // Every permission denied; no project config, Claude Code files or
+    // plugins.
+    base::DictValue permission;
+    permission.Set("*", "deny");
+    base::DictValue config;
+    config.Set("permission", std::move(permission));
+    if (!turn.system.empty()) {
+      config.Set("agent",
+                 base::DictValue().Set(
+                     "meridian", base::DictValue()
+                                     .Set("prompt", turn.system)
+                                     .Set("mode", "primary")));
+    }
+    spec.args = {"run", "--format", "json", "--dir", cwd};
+    if (!turn.system.empty()) {
+      spec.args.push_back("--agent");
+      spec.args.push_back("meridian");
+    }
+    if (resume) {
+      spec.args.push_back("--session");
+      spec.args.push_back(turn.resume);
+    }
+    model("-m");
+    spec.stdin_text = turn.prompt;
+    spec.env = {{"OPENCODE_CONFIG_CONTENT", Json(base::Value(std::move(config)))},
+                {"OPENCODE_DISABLE_PROJECT_CONFIG", "1"},
+                {"OPENCODE_DISABLE_CLAUDE_CODE", "1"},
+                {"OPENCODE_DISABLE_EXTERNAL_SKILLS", "1"},
+                {"OPENCODE_DISABLE_DEFAULT_PLUGINS", "1"}};
+  } else if (p.id == "qwen") {
+    // Plan mode is read-only; safe mode drops MCP, hooks and extensions.
+    spec.args = {"-p", "", "-o", "stream-json", "--include-partial-messages",
+                 "--approval-mode", "plan", "--safe-mode"};
+    if (!turn.system.empty()) {
+      spec.args.push_back("--system-prompt");
+      spec.args.push_back(turn.system);
+    }
+    if (resume) {
+      spec.args.push_back("--resume");
+      spec.args.push_back(turn.resume);
+    }
+    model("-m");
+    spec.stdin_text = turn.prompt;
+  } else if (p.id == "amp") {
+    // An isolated settings file turns every tool off.
+    spec.args = {"-x", "--stream-json", "--settings-file", "amp-settings.json"};
+    spec.stdin_text = WithSystem(turn, true);
+    spec.files["amp-settings.json"] =
+        "{\"amp.tools.disable\":[\"*\"],\"amp.mcpServers\":{}}";
+  } else if (p.id == "goose") {
+    // No profile and no built-ins = no extensions or MCP tools.
+    spec.args = {"run",         "-i",           "-",         "--output-format",
+                 "stream-json", "--no-profile", "--no-session", "--quiet"};
+    if (!turn.system.empty()) {
+      spec.args.push_back("--system");
+      spec.args.push_back(turn.system);
+    }
+    model("--model");
+    spec.stdin_text = turn.prompt;
+  } else if (p.id == "droid") {
+    // exec is read-only by default; drop the shell tool too.
+    spec.args = {"exec", "-o", "json", "--remove-tools", "Execute",
+                 "--cwd", cwd};
+    if (!turn.system.empty()) {
+      spec.args.push_back("--append-system-prompt");
+      spec.args.push_back(turn.system);
+    }
+    if (resume) {
+      spec.args.push_back("-s");
+      spec.args.push_back(turn.resume);
+    }
+    model("-m");
+    spec.stdin_text = turn.prompt;
+  }
+  return spec;
+}
