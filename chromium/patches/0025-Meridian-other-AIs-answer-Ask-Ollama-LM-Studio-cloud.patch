@@ -0,0 +1,75 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AI_PROCESS_RUNNER_H_
+#define CHROME_BROWSER_MERIDIAN_AI_PROCESS_RUNNER_H_
+
+#include <atomic>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted.h"
+#include "base/time/time.h"
+
+namespace meridian::ai {
+
+// Set from any thread to stop a run.
+class CancelFlag : public base::RefCountedThreadSafe<CancelFlag> {
+ public:
+  CancelFlag();
+  void Set() { set_ = true; }
+  bool IsSet() const { return set_; }
+
+ private:
+  friend class base::RefCountedThreadSafe<CancelFlag>;
+  ~CancelFlag();
+  std::atomic<bool> set_{false};
+};
+
+struct ProcessSpec {
+  // argv[0] is an absolute path: no shell, no PATH lookup.
+  std::vector<std::string> argv;
+  // The whole environment of the child.
+  std::map<std::string, std::string> env;
+  std::string cwd;
+  std::optional<std::string> stdin_text;
+  base::TimeDelta timeout = base::Minutes(5);
+  // Output beyond this stops the run.
+  size_t max_output = 4u << 20;
+};
+
+struct ProcessResult {
+  bool started = false;
+  int exit_code = -1;
+  // Stopped by the flag, the timeout or the output cap.
+  bool killed = false;
+  bool timed_out = false;
+  bool too_long = false;
+  // The first 8 KB.
+  std::string stderr_text;
+};
+
+// Runs a process to the end, feeding `stdin_text` and handing stdout to
+// `on_output` in chunks as it arrives (on the calling thread). Blocks: call
+// it on a thread that may block and wait for processes. The child gets its
+// own process group, which is killed as a whole when the run stops.
+ProcessResult RunProcess(
+    const ProcessSpec& spec,
+    scoped_refptr<CancelFlag> cancel,
+    base::RepeatingCallback<void(std::string_view)> on_output);
+
+// Runs a short command and returns stdout and stderr together (for
+// `<cli> login status` and the like).
+std::string CaptureOutput(const std::vector<std::string>& argv,
+                          const std::map<std::string, std::string>& env,
+                          const std::string& cwd,
+                          base::TimeDelta timeout,
+                          int* exit_code = nullptr);
+
+}  // namespace meridian::ai
+
+#endif  // CHROME_BROWSER_MERIDIAN_AI_PROCESS_RUNNER_H_
