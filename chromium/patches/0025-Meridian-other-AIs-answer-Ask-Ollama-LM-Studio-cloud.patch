+std::optional<AuthCheck> AuthCheckFor(const Provider& p) {
+  if (p.id == "codex") {
+    return AuthCheck{{"login", "status"}, CodexAuth};
+  }
+  if (p.id == "cursor") {
+    return AuthCheck{{"status"}, CursorAuth};
+  }
+  if (p.id == "opencode") {
+    return AuthCheck{{"auth", "list"}, OpenCodeAuth};
+  }
+  return std::nullopt;
+}
