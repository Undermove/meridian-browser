+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/ai/process_runner.h"
+
+#include "base/functional/bind.h"
+#include "base/test/task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::ai {
+namespace {
+
+class ProcessRunnerTest : public testing::Test {
+ protected:
+  ProcessResult Run(ProcessSpec spec,
+                    std::string* out,
+                    scoped_refptr<CancelFlag> cancel = nullptr) {
+    spec.env = {{"PATH", "/usr/bin:/bin"}};
+    return RunProcess(
+        spec, cancel,
+        base::BindRepeating(
+            [](std::string* out, std::string_view chunk) { out->append(chunk); },
+            base::Unretained(out)));
+  }
+  base::test::TaskEnvironment env_;
+};
+
+TEST_F(ProcessRunnerTest, FeedsStdinAndReadsStdout) {
+  ProcessSpec spec;
+  spec.argv = {"/bin/cat"};
+  // More than a pipe buffer holds, both ways.
+  spec.stdin_text = std::string(300000, 'x');
+  std::string out;
+  ProcessResult result = Run(spec, &out);
+  EXPECT_TRUE(result.started);
+  EXPECT_EQ(result.exit_code, 0);
+  EXPECT_EQ(out.size(), 300000u);
+}
+
+TEST_F(ProcessRunnerTest, KeepsStderrAndTheExitCode) {
+  ProcessSpec spec;
+  spec.argv = {"/bin/sh", "-c", "echo out; echo oops >&2; exit 3"};
+  std::string out;
+  ProcessResult result = Run(spec, &out);
+  EXPECT_EQ(out, "out\n");
+  EXPECT_EQ(result.stderr_text, "oops\n");
+  EXPECT_EQ(result.exit_code, 3);
+  EXPECT_FALSE(result.killed);
+}
+
+TEST_F(ProcessRunnerTest, TimeoutKillsTheWholeGroup) {
+  ProcessSpec spec;
+  // A grandchild holding the pipe open must die too.
+  spec.argv = {"/bin/sh", "-c", "sleep 30 & sleep 30"};
+  spec.timeout = base::Milliseconds(300);
+  std::string out;
+  base::TimeTicks start = base::TimeTicks::Now();
+  ProcessResult result = Run(spec, &out);
+  EXPECT_TRUE(result.killed);
+  EXPECT_TRUE(result.timed_out);
+  EXPECT_LT(base::TimeTicks::Now() - start, base::Seconds(5));
+}
+
+TEST_F(ProcessRunnerTest, CancelStops) {
+  ProcessSpec spec;
+  spec.argv = {"/bin/sh", "-c", "echo started; sleep 30"};
+  auto cancel = base::MakeRefCounted<CancelFlag>();
+  cancel->Set();
+  std::string out;
+  ProcessResult result = Run(spec, &out, cancel);
+  EXPECT_TRUE(result.killed);
+  EXPECT_FALSE(result.timed_out);
+}
+
+TEST_F(ProcessRunnerTest, MissingExecutable) {
+  ProcessSpec spec;
+  spec.argv = {"/nonexistent/agent"};
+  std::string out;
+  ProcessResult result = Run(spec, &out);
+  EXPECT_NE(result.exit_code, 0);
+}
+
+}  // namespace
+}  // namespace meridian::ai
