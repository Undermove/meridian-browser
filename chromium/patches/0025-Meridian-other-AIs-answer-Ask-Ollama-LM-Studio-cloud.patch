+
+#ifndef CHROME_BROWSER_MERIDIAN_AI_LOCAL_AGENTS_H_
+#define CHROME_BROWSER_MERIDIAN_AI_LOCAL_AGENTS_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "chrome/browser/meridian/ai/providers.h"
+
+class Profile;
+
+namespace meridian::ai {
+
+// The other AIs that can answer (providers.h): coding-agent CLIs started per
+// turn, local model servers, and cloud models on the person's own API keys.
+// They answer as text only: no browser tools.
+//
+// Every CLI run starts the executable directly (no shell) with the person's
+// login-shell environment, in a private empty working directory, gets the
+// prompt on stdin where the CLI supports it, and is killed on Stop, on a
+// timeout or when the browser closes.
+class LocalAgents {
+ public:
+  struct Status {
+    std::string id;
+    bool installed = false;
+    // nullopt = can't tell.
+    std::optional<bool> signed_in;
+    // The account it's signed in as, or for a cloud key the model in use.
+    std::string account;
+    std::string install_command;
+    // What the install command needs and this computer lacks.
+    std::string install_missing;
+  };
+
+  // "text" (a delta), "session" (internal: the CLI's session id), "done"
+  // ("stopped" when the person stopped it) or "error".
+  using EventCallback =
+      base::RepeatingCallback<void(const std::string& type,
+                                   const std::string& text)>;
+
+  explicit LocalAgents(Profile* profile);
+  LocalAgents(const LocalAgents&) = delete;
+  LocalAgents& operator=(const LocalAgents&) = delete;
+  ~LocalAgents();
+
+  // Installed? Signed in? Cached for a minute unless `fresh`.
+  void List(bool fresh, base::OnceCallback<void(std::vector<Status>)> done);
+
+  void Chat(const std::string& run_id,
+            const std::string& provider_id,
+            Turn turn,
+            EventCallback events);
+  void Stop(const std::string& run_id);
+
+  // Cloud keys (OpenAI, Gemini…). Checked with the provider's free model
+  // list before they're stored, encrypted.
+  bool HasCloudKey(const std::string& id) const;
+  std::vector<std::string> CloudKeyIds() const;
+  void AddCloudKey(
+      const std::string& key,
+      base::OnceCallback<void(bool ok, std::string provider, std::string error)>
+          done);
+  void RemoveCloudKey(const std::string& id);
+  void CloudModels(const std::string& id,
+                   base::OnceCallback<void(std::vector<std::string> models,
+                                           std::string error)> done);
+
+ private:
+  struct Run;
+  class LineStream;
+
+  void OnCliOutput(const std::string& run_id, std::string chunk);
+  void OnCliDone(const std::string& run_id,
+                 bool found,
+                 bool started,
+                 int exit_code,
+                 bool killed,
+                 bool timed_out,
+                 bool too_long,
+                 std::string stderr_text);
+  void HttpChat(const std::string& run_id, Turn turn);
+  void StartHttp(const std::string& run_id,
+                 Turn turn,
+                 std::string url,
+                 std::string key,
+                 std::string model);
+  void OnHttpLine(const std::string& run_id, std::string_view line);
+  void OnHttpDone(const std::string& run_id, int status, std::string body);
+  void Finish(const std::string& run_id,
+              const std::string& type,
+              const std::string& text);
+
+  // A local server's models (nullopt: not running).
+  Status CloudStatus(const std::string& id) const;
+  void LocalModels(const Provider& provider,
+                   base::OnceCallback<void(std::optional<std::vector<std::string>>)>
+                       done);
+  void WithCloudKey(const std::string& id,
+                    base::OnceCallback<void(std::optional<std::string>)> done);
+  void ListModels(const std::string& id,
+                  const std::string& key,
+                  base::OnceCallback<void(int status,
+                                          std::vector<std::string>)> done);
+
+  raw_ptr<Profile> profile_;
+  base::FilePath workdir_;
+  std::map<std::string, std::unique_ptr<Run>> runs_;
+  std::optional<std::pair<base::TimeTicks, std::vector<Status>>> cache_;
+  std::map<std::string, std::pair<base::TimeTicks, std::vector<std::string>>>
+      models_;
+  base::WeakPtrFactory<LocalAgents> weak_factory_{this};
+};
+
+}  // namespace meridian::ai
+
+#endif  // CHROME_BROWSER_MERIDIAN_AI_LOCAL_AGENTS_H_
