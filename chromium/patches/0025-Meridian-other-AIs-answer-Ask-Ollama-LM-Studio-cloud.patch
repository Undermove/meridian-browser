+std::vector<Event> Parse(const std::string& id, const std::string& output) {
+  std::unique_ptr<OutputParser> parser = MakeParser(*FindProvider(id));
+  std::vector<Event> events;
+  // In awkward chunks, as a pipe delivers it.
+  for (size_t i = 0; i < output.size(); i += 7) {
+    parser->Push(std::string_view(output).substr(i, 7), events);
+  }
+  parser->End(events);
+  return events;
+}
+
+std::string Text(const std::vector<Event>& events, Event::Type type) {
+  std::string out;
+  for (const Event& e : events) {
+    if (e.type == type) {
+      out += e.text;
+    }
+  }
+  return out;
+}
+
+TEST(ProvidersTest, CodexStreamGivesTextAndSession) {
+  std::vector<Event> events = Parse(
+      "codex",
+      "{\"type\":\"thread.started\",\"thread_id\":\"t-1\"}\n"
+      "noise that is not json\n"
+      "{\"type\":\"item.completed\",\"item\":{\"type\":\"reasoning\","
+      "\"text\":\"hidden\"}}\n"
+      "{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\","
+      "\"text\":\"Hello\"}}");
+  EXPECT_EQ(Text(events, Event::Type::kSession), "t-1");
+  EXPECT_EQ(Text(events, Event::Type::kDelta), "Hello\n");
+  EXPECT_EQ(Text(events, Event::Type::kError), "");
+}
+
+TEST(ProvidersTest, CursorSkipsRepeatsAndKeepsTheResult) {
+  std::vector<Event> events = Parse(
+      "cursor",
+      "{\"type\":\"system\",\"session_id\":\"c-9\"}\n"
+      "{\"type\":\"assistant\",\"timestamp_ms\":1,\"message\":{\"content\":"
+      "[{\"type\":\"text\",\"text\":\"Hi \"}]}}\n"
+      "{\"type\":\"assistant\",\"timestamp_ms\":2,\"model_call_id\":\"m\","
+      "\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"Hi there\"}]}}\n"
+      "{\"type\":\"result\",\"result\":\"Hi there\"}\n");
+  EXPECT_EQ(Text(events, Event::Type::kDelta), "Hi ");
+  EXPECT_EQ(Text(events, Event::Type::kFinal), "Hi there");
+  EXPECT_EQ(Text(events, Event::Type::kSession), "c-9");
+}
+
+TEST(ProvidersTest, ErrorsComeThrough) {
+  EXPECT_EQ(Text(Parse("droid", "{\"type\":\"result\",\"is_error\":true,"
+                                "\"result\":\"no credits\"}"),
+                 Event::Type::kError),
+            "no credits");
+  EXPECT_EQ(Text(Parse("opencode",
+                       "{\"type\":\"error\",\"error\":{\"data\":{\"message\":"
+                       "\"bad model\"}}}\n"),
+                 Event::Type::kError),
+            "bad model");
+}
+
+TEST(ProvidersTest, CopilotIsPlainTextWithoutColours) {
+  EXPECT_EQ(Text(Parse("copilot", "\x1b[1mBold\x1b[0m answer"),
+                 Event::Type::kDelta),
+            "Bold answer");
+}
+
+TEST(ProvidersTest, PromptGoesOnStdinAndToolsStayOff) {
+  Turn turn;
+  turn.prompt = "What is this page?";
+  turn.system = "Be brief.";
+  CommandSpec codex = BuildCommand(*FindProvider("codex"), turn, "/tmp/x");
+  EXPECT_EQ(codex.args.front(), "exec");
+  EXPECT_EQ(codex.args.back(), "-");
+  EXPECT_NE(std::ranges::find(codex.args, "sandbox_mode=\"read-only\""),
+            codex.args.end());
+  EXPECT_EQ(codex.stdin_text, "Be brief.\n\nWhat is this page?");
+
+  // A resumed Codex session gets only the new message.
+  turn.resume = "t-1";
+  CommandSpec resumed = BuildCommand(*FindProvider("codex"), turn, "/tmp/x");
+  EXPECT_EQ(resumed.args[1], "resume");
+  EXPECT_EQ(resumed.stdin_text, "What is this page?");
+
+  CommandSpec amp = BuildCommand(*FindProvider("amp"), turn, "/tmp/x");
+  EXPECT_TRUE(amp.files.contains("amp-settings.json"));
+  CommandSpec opencode =
+      BuildCommand(*FindProvider("opencode"), turn, "/tmp/x");
+  EXPECT_NE(opencode.env["OPENCODE_CONFIG_CONTENT"].find("\"deny\""),
+            std::string::npos);
+}
+
+TEST(ProvidersTest, KeysAreRecognisedByShape) {
+  EXPECT_EQ(DetectKey(" sk-ant-api03-xyz "),
+            std::vector<std::string>{"anthropic"});
+  EXPECT_EQ(DetectKey("AIzaSyA1234567890abcdefghijklmnopqrstu"),
+            std::vector<std::string>{"gemini"});
+  EXPECT_EQ(DetectKey("sk-proj-abc"), std::vector<std::string>{"openai"});
+  EXPECT_EQ(DetectKey("sk-0123456789abcdef0123456789abcdef"),
+            (std::vector<std::string>{"deepseek", "openai"}));
+  EXPECT_EQ(DetectKey("gsk_abc"), std::vector<std::string>{"groq"});
+  EXPECT_TRUE(DetectKey("hello").empty());
+}
+
+TEST(ProvidersTest, ModelsAreFilteredAndTheNewestPreferredOneWins) {
+  std::optional<base::Value> answer = base::JSONReader::Read(
+      R"({"data":[{"id":"gpt-4o-mini"},{"id":"gpt-5.2-mini"},
+         {"id":"gpt-5.10-mini"},{"id":"text-embedding-3"},{"id":"dall-e-3"},
+         {"id":"gpt-5.2"}]})",
+      0);
+  std::vector<std::string> models = ChatModels("openai", answer->GetDict());
+  EXPECT_EQ(models.size(), 4u);
+  EXPECT_EQ(PickModel("openai", models, ""), "gpt-5.10-mini");
+  EXPECT_EQ(PickModel("openai", models, "gpt-5.2"), "gpt-5.2");
+  EXPECT_EQ(PickModel("openai", models, "gone"), "gpt-5.10-mini");
+  EXPECT_EQ(PickModel("openrouter", {}, ""), "openrouter/auto");
+}
