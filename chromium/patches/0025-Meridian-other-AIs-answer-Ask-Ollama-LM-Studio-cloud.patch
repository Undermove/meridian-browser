+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/ai/process_runner.h"
+
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <unistd.h>
+
+#include <array>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/process/launch.h"
+#include "base/process/process.h"
+#include "base/strings/string_view_util.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "build/build_config.h"
+
+namespace meridian::ai {
+
+CancelFlag::CancelFlag() = default;
+CancelFlag::~CancelFlag() = default;
+
+namespace {
+
+constexpr size_t kStderrLimit = 8192;
+// After SIGTERM, how long the group gets before SIGKILL.
+constexpr base::TimeDelta kGrace = base::Milliseconds(1500);
+
+void SetNonBlocking(int fd) {
+  int flags = fcntl(fd, F_GETFL);
+  if (flags != -1) {
+    fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+  }
+}
+
+}  // namespace
+
+ProcessResult RunProcess(
+    const ProcessSpec& spec,
+    scoped_refptr<CancelFlag> cancel,
+    base::RepeatingCallback<void(std::string_view)> on_output) {
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::WILL_BLOCK);
+  ProcessResult result;
+  base::ScopedFD in_read, in_write, out_read, out_write, err_read, err_write;
+  if (!base::CreatePipe(&in_read, &in_write) ||
+      !base::CreatePipe(&out_read, &out_write) ||
+      !base::CreatePipe(&err_read, &err_write)) {
+    return result;
+  }
+  base::LaunchOptions options;
+  options.fds_to_remap = {{in_read.get(), STDIN_FILENO},
+                          {out_write.get(), STDOUT_FILENO},
+                          {err_write.get(), STDERR_FILENO}};
+  options.clear_environment = true;
+  for (const auto& [name, value] : spec.env) {
+    options.environment[name] = value;
+  }
+  if (!spec.cwd.empty()) {
+    options.current_directory = base::FilePath(spec.cwd);
+  }
+  options.new_process_group = true;
+#if BUILDFLAG(IS_MAC)
+  // Privacy prompts (if a CLI touches protected folders) name the CLI, not
+  // Meridian.
+  options.disclaim_responsibility = true;
+#endif
+  base::Process process = base::LaunchProcess(spec.argv, options);
+  in_read.reset();
+  out_write.reset();
+  err_write.reset();
+  if (!process.IsValid()) {
+    return result;
+  }
+  result.started = true;
+  const pid_t group = process.Pid();
+
+  std::string_view pending;
+  if (spec.stdin_text) {
+    pending = *spec.stdin_text;
+  }
+  if (pending.empty()) {
+    in_write.reset();
+  } else {
+    SetNonBlocking(in_write.get());
+  }
+  SetNonBlocking(out_read.get());
+  SetNonBlocking(err_read.get());
+
+  const base::TimeTicks deadline = base::TimeTicks::Now() + spec.timeout;
+  std::optional<base::TimeTicks> kill_at;
+  size_t output = 0;
+  std::array<char, 65536> buffer;
+  auto stop = [&] {
+    if (!result.killed) {
+      result.killed = true;
+      kill(-group, SIGTERM);
+      kill_at = base::TimeTicks::Now() + kGrace;
+    }
+  };
+  while (out_read.is_valid() || err_read.is_valid()) {
+    if (!result.killed) {
+      if (cancel && cancel->IsSet()) {
+        stop();
+      } else if (base::TimeTicks::Now() > deadline) {
+        result.timed_out = true;
+        stop();
+      }
+    }
+    if (kill_at && base::TimeTicks::Now() > *kill_at) {
+      kill(-group, SIGKILL);
+      kill_at.reset();
+    }
+    std::array<pollfd, 3> fds{};
+    nfds_t count = 0;
+    int out_index = -1, err_index = -1, in_index = -1;
+    if (out_read.is_valid()) {
+      out_index = count;
+      fds[count++] = {out_read.get(), POLLIN, 0};
+    }
+    if (err_read.is_valid()) {
+      err_index = count;
+      fds[count++] = {err_read.get(), POLLIN, 0};
+    }
+    if (in_write.is_valid()) {
+      in_index = count;
+      fds[count++] = {in_write.get(), POLLOUT, 0};
+    }
+    int ready = HANDLE_EINTR(poll(fds.data(), count, 100));
+    if (ready <= 0) {
+      continue;
+    }
+    auto drain = [&](base::ScopedFD& fd, bool is_stdout) {
+      ssize_t n = HANDLE_EINTR(read(fd.get(), buffer.data(), buffer.size()));
+      if (n == 0 || (n < 0 && errno != EAGAIN)) {
+        fd.reset();
+        return;
+      }
+      if (n < 0) {
+        return;
+      }
+      std::string_view chunk =
+          base::as_string_view(base::span(buffer).first(static_cast<size_t>(n)));
+      if (!is_stdout) {
+        if (result.stderr_text.size() < kStderrLimit) {
+          result.stderr_text.append(chunk.substr(
+              0, kStderrLimit - result.stderr_text.size()));
+        }
+        return;
+      }
+      output += chunk.size();
+      if (output > spec.max_output) {
+        result.too_long = true;
+        stop();
+        return;
+      }
+      if (!result.killed) {
+        on_output.Run(chunk);
+      }
+    };
+    if (out_index >= 0 && fds[out_index].revents) {
+      drain(out_read, true);
+    }
+    if (err_index >= 0 && fds[err_index].revents) {
+      drain(err_read, false);
+    }
+    if (in_index >= 0 && fds[in_index].revents) {
+      if (fds[in_index].revents & (POLLERR | POLLHUP)) {
+        in_write.reset();
+      } else {
+        ssize_t n = HANDLE_EINTR(
+            write(in_write.get(), pending.data(), pending.size()));
+        if (n > 0) {
+          pending.remove_prefix(static_cast<size_t>(n));
+        }
+        if ((n < 0 && errno != EAGAIN) || pending.empty()) {
+          in_write.reset();
+        }
+      }
+    }
+  }
+  in_write.reset();
+  // Both pipes closed: the process is exiting (or a grandchild kept them
+  // open until it was killed).
+  if (!process.WaitForExitWithTimeout(kGrace, &result.exit_code)) {
+    kill(-group, SIGKILL);
+    process.WaitForExit(&result.exit_code);
+  }
+  return result;
+}
+
+std::string CaptureOutput(const std::vector<std::string>& argv,
+                          const std::map<std::string, std::string>& env,
+                          const std::string& cwd,
+                          base::TimeDelta timeout,
+                          int* exit_code) {
+  ProcessSpec spec;
+  spec.argv = argv;
+  spec.env = env;
+  spec.cwd = cwd;
+  spec.timeout = timeout;
+  spec.max_output = 1u << 20;
+  std::string out;
+  ProcessResult result = RunProcess(
+      spec, nullptr,
+      base::BindRepeating(
+          [](std::string* out, std::string_view chunk) { out->append(chunk); },
+          base::Unretained(&out)));
+  if (exit_code) {
+    *exit_code = result.started && !result.killed ? result.exit_code : -1;
+  }
+  return out + result.stderr_text;
+}
+
+}  // namespace meridian::ai
