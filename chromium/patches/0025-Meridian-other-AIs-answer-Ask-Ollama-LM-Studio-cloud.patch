+std::vector<std::string> ChatModels(const std::string& id,
+                                    const base::DictValue& answer) {
+  std::vector<std::string> out;
+  auto it = Cloud().find(id);
+  if (it == Cloud().end()) {
+    return out;
+  }
+  const base::ListValue* list = answer.FindList("data");
+  if (!list) {
+    list = answer.FindList("models");
+  }
+  if (!list) {
+    return out;
+  }
+  RE2 keep(it->second.keep);
+  RE2 not_chat(kNotChat);
+  for (const base::Value& m : *list) {
+    if (!m.is_dict()) {
+      continue;
+    }
+    std::string name = StringAt(m.GetDict(), "id");
+    if (name.empty()) {
+      name = StringAt(m.GetDict(), "name");
+    }
+    if (!name.empty() && RE2::PartialMatch(name, keep) &&
+        !RE2::PartialMatch(name, not_chat)) {
+      out.push_back(name);
+    }
+  }
+  return out;
+}
