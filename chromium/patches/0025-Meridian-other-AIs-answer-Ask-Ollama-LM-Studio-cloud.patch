+
+void SidebarHandler::GetAiProviders(bool fresh,
+                                    GetAiProvidersCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!ai) {
+    std::move(callback).Run({});
+    return;
+  }
+  ai->local().List(
+      fresh,
+      base::BindOnce(
+          [](GetAiProvidersCallback callback,
+             std::vector<ai::LocalAgents::Status> list) {
+            std::vector<mojom::AiProviderPtr> out;
+            for (const ai::LocalAgents::Status& s : list) {
+              const ai::Provider* p = ai::FindProvider(s.id);
+              auto m = mojom::AiProvider::New();
+              m->id = p->id;
+              m->label = p->label;
+              m->vendor = p->vendor;
+              m->plan = p->plan;
+              m->opt_in = p->policy == ai::Policy::kOptIn;
+              m->kind = p->kind == ai::Kind::kCli     ? "cli"
+                        : p->kind == ai::Kind::kCloud ? "cloud"
+                                                      : "local";
+              m->installed = s.installed;
+              m->signed_in = s.signed_in ? (*s.signed_in ? 1 : 0) : -1;
+              m->account = s.account;
+              m->install_command = s.install_command;
+              m->install_missing = s.install_missing;
+              m->login_command = p->login;
+              m->docs = p->docs;
+              out.push_back(std::move(m));
+            }
+            std::move(callback).Run(std::move(out));
+          },
+          std::move(callback)));
+}
+
+void SidebarHandler::AddAiKey(const std::string& key,
+                              AddAiKeyCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!ai) {
+    std::move(callback).Run(false, std::string(),
+                            "AI isn’t available in a private window.");
+    return;
+  }
+  std::vector<std::string> kinds = ai::DetectKey(key);
+  if (!kinds.empty() && kinds.front() == "anthropic") {
+    ai->SetKey(key, base::BindOnce(
+                        [](AddAiKeyCallback callback, bool ok,
+                           std::string error) {
+                          std::move(callback).Run(ok, ok ? "api" : "", error);
+                        },
+                        std::move(callback)));
+    return;
+  }
+  ai->local().AddCloudKey(
+      key, base::BindOnce(
+               [](AddAiKeyCallback callback, bool ok, std::string provider,
+                  std::string error) {
+                 std::move(callback).Run(ok, provider, error);
+               },
+               std::move(callback)));
+}
+
+void SidebarHandler::RemoveCloudKey(const std::string& id) {
+  if (AiService* ai =
+          AiServiceFactory::GetForProfile(browser_->GetProfile())) {
+    ai->local().RemoveCloudKey(id);
+    PrefService* prefs = browser_->GetProfile()->GetPrefs();
+    if (prefs->GetString(prefs::kAiProvider) == id) {
+      prefs->SetString(prefs::kAiProvider, std::string());
+    }
+  }
+}
+
+void SidebarHandler::GetCloudModels(const std::string& id,
+                                    GetCloudModelsCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  const ai::Provider* p = ai::FindProvider(id);
+  if (!ai || !p || p->kind != ai::Kind::kCloud) {
+    std::move(callback).Run({}, std::string(), "Unknown provider.");
+    return;
+  }
+  const std::string* chosen =
+      browser_->GetProfile()->GetPrefs()->GetDict(prefs::kAiModels).FindString(
+          id);
+  ai->local().CloudModels(
+      id, base::BindOnce(
+              [](GetCloudModelsCallback callback, std::string chosen,
+                 std::vector<std::string> models, std::string error) {
+                std::move(callback).Run(std::move(models), chosen, error);
+              },
+              std::move(callback), chosen ? *chosen : std::string()));
+}
+
+void SidebarHandler::SetCloudModel(const std::string& id,
+                                   const std::string& model) {
+  const ai::Provider* p = ai::FindProvider(id);
+  if (!p || p->kind != ai::Kind::kCloud) {
+    return;
+  }
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              prefs::kAiModels);
+  if (model.empty()) {
+    update->Remove(id);
+  } else {
+    update->Set(id, model);
+  }
+}
+
+void SidebarHandler::CheckAiProvider(const std::string& id,
+                                     CheckAiProviderCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!ai || !ai::FindProvider(id)) {
+    std::move(callback).Run(false, "Unknown AI.");
+    return;
+  }
+  ai::Turn turn;
+  turn.prompt = "Reply with just the word OK.";
+  // One answer: the callback is repeating, so it lives in shared state.
+  auto pending = base::MakeRefCounted<
+      base::RefCountedData<CheckAiProviderCallback>>(std::move(callback));
+  ai->local().Chat(
+      "check-" + id, id, std::move(turn),
+      base::BindRepeating(
+          [](scoped_refptr<base::RefCountedData<CheckAiProviderCallback>>
+                 pending,
+             const std::string& type, const std::string& text) {
+            if (pending->data.is_null() || (type != "done" && type != "error")) {
+              return;
+            }
+            std::move(pending->data).Run(type == "done" && text != "stopped",
+                                         type == "error" ? text : "");
+          },
+          pending));
+}
+
+void SidebarHandler::RunAiSetup(const std::string& id,
+                                const std::string& what,
+                                RunAiSetupCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  const ai::Provider* p = ai::FindProvider(id);
+  if (!ai || !p || (what != "install" && what != "login")) {
+    std::move(callback).Run(false, "Unknown AI.");
+    return;
+  }
+  ai->local().List(
+      false,
+      base::BindOnce(
+          [](std::string id, std::string what, RunAiSetupCallback callback,
+             std::vector<ai::LocalAgents::Status> list) {
+            const ai::Provider* p = ai::FindProvider(id);
+            std::string command = what == "login" ? p->login : std::string();
+            for (const ai::LocalAgents::Status& s : list) {
+              if (s.id == id && what == "install") {
+                command = s.install_command;
+              }
+            }
+            if (command.empty()) {
+              std::move(callback).Run(false,
+                                      "No setup command for " + p->label +
+                                          " on this computer.");
+              return;
+            }
+            base::ThreadPool::PostTaskAndReplyWithResult(
+                FROM_HERE, {base::MayBlock()},
+                base::BindOnce(&OpenInTerminal, command,
+                               (what == "install" ? "Install " : "Sign in to ") +
+                                   p->label),
+                base::BindOnce(
+                    [](RunAiSetupCallback callback, bool ok) {
+                      std::move(callback).Run(
+                          ok, ok ? "" : "Couldn’t open Terminal.");
+                    },
+                    std::move(callback)));
+          },
+          id, what, std::move(callback)));
+}
