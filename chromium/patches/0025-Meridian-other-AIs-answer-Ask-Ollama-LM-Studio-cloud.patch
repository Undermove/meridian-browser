+// Who can answer Ask (⌘T), the ⌘J panel and the welcome tour besides Claude
+// on an Anthropic key. Only where the provider's terms allow it (checked
+// October 2026):
+//  - kDefault: local model servers (Ollama, LM Studio) and cloud models on the
+//    person's own API key (OpenAI, Gemini, OpenRouter, xAI, Mistral,
+//    DeepSeek, Groq).
+//  - kOptIn: shown only after the person turns on "Other agents" in
+//    Settings > AI, labelled as running under their own account and that
+//    provider's terms.
+// Claude Code and Gemini CLI aren't here on purpose: Anthropic and Google
+// don't allow third-party apps to run their features on a consumer
+// subscription login.
+enum class Policy { kDefault, kOptIn };
+
+// How a provider is reached.
+enum class Kind {
+  kCli,          // a coding-agent CLI started per turn
+  kOllama,       // Ollama's own HTTP API
+  kOpenAiLocal,  // an OpenAI-compatible server on this computer (LM Studio)
+  kCloud,        // a cloud API on the person's key (OpenAI-compatible)
+};
+
+struct Install {
+  std::string command;
+  // A tool on the login PATH the command needs ("brew", "npm"), or empty.
+  std::string needs;
+};
+
+struct Provider {
+  std::string id;
+  std::string label;
+  std::string vendor;
+  Kind kind;
+  Policy policy;
+  // What it works with ("a Cursor plan", "your own API key…").
+  std::string plan;
+  std::string docs;
+  // CLIs: the executable, other names it installs as, how to sign in.
+  std::string bin;
+  std::vector<std::string> alt_bins;
+  std::string login;
+  std::vector<Install> install;
+  // Can continue a conversation by session id (so only the new message is
+  // sent).
+  bool resume = false;
+  // HTTP: where the local server listens; cloud: the API base.
+  std::string base;
+};
+
+const std::vector<Provider>& Providers();
+const Provider* FindProvider(const std::string& id);
+
+// One CLI run.
+struct CommandSpec {
+  std::vector<std::string> args;
+  // Sent on stdin, then closed; nullopt = the prompt is in `args`.
+  std::optional<std::string> stdin_text;
+  std::map<std::string, std::string> env;
+  // Written into the working directory first (name -> content).
+  std::map<std::string, std::string> files;
+};
+
+struct Turn {
+  std::string prompt;
+  std::string system;
+  // The CLI's own session to continue, if it can.
+  std::string resume;
+  std::string model;
+};
+
+// `cwd`: the run's private working directory.
+CommandSpec BuildCommand(const Provider& provider,
+                         const Turn& turn,
+                         const std::string& cwd);
+
+// What a CLI's output turns into.
+struct Event {
+  enum class Type { kDelta, kFinal, kSession, kError };
+  Type type;
+  std::string text;
+};
+
+// Turns a CLI's stdout (in whatever chunks it arrives) into events.
+class OutputParser {
+ public:
+  virtual ~OutputParser() = default;
+  virtual void Push(std::string_view chunk, std::vector<Event>& out) = 0;
+  virtual void End(std::vector<Event>& out) = 0;
+};
+
+std::unique_ptr<OutputParser> MakeParser(const Provider& provider);
+
+// A message the person can act on, from a CLI's error and stderr.
+std::string FriendlyCliError(const Provider& provider,
+                             const std::string& message,
+                             const std::string& stderr_text);
+
+// Signed in? From `<cli> login status` and the like. nullopt = can't tell.
+struct AuthCheck {
+  std::vector<std::string> args;
+  // stdout+stderr -> signed in, and the account if it says.
+  std::optional<bool> (*parse)(const std::string& output, std::string* account);
+};
+std::optional<AuthCheck> AuthCheckFor(const Provider& provider);
+
+// ---------------------------------------------------------------- cloud keys
+
+// Which cloud providers a pasted key could belong to, most likely first
+// ("anthropic" for a Claude key).
+std::vector<std::string> DetectKey(const std::string& key);
+
+// Chat models from a provider's GET /models answer.
+std::vector<std::string> ChatModels(const std::string& provider_id,
+                                    const base::DictValue& models_answer);
+
+// The person's pick if the provider still has it, else the first preferred
+// model (newest version first).
+std::string PickModel(const std::string& provider_id,
+                      const std::vector<std::string>& models,
+                      const std::string& chosen);
+
+// One line of an OpenAI-style (`data: {...}`) or Ollama (`{...}`) stream:
+// the text it adds, or an error.
+struct StreamLine {
+  std::string delta;
+  std::string error;
+};
+StreamLine ParseStreamLine(Kind kind, std::string_view line);
+
+}  // namespace meridian::ai
