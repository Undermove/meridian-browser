 namespace {
 
+// POSIX shell single quotes.
+std::string ShellQuote(const std::string& s) {
+  std::string out = "'";
+  for (char c : s) {
+    out += c == '\'' ? std::string("'\\''") : std::string(1, c);
+  }
+  return out + "'";
+}
+
+// Opens Terminal running `command` in the login shell, then leaves the
+// window open. Blocking.
+bool OpenInTerminal(const std::string& command, const std::string& title) {
+  base::FilePath dir;
+  if (!base::CreateNewTempDirectory("meridian-setup-", &dir)) {
+    return false;
+  }
+  base::FilePath file = dir.Append("setup.command");
+  std::string shell = base::Environment::Create()->GetVar("SHELL").value_or("");
+  if (shell.empty() || !base::PathExists(base::FilePath(shell))) {
+    shell = "/bin/zsh";
+  }
+  std::string script = "#!" + shell + " -l\n" +
+                       "printf '\\033]0;%s\\007' " + ShellQuote(title) +
+                       "\nclear\necho " + ShellQuote("▶ " + command) +
+                       "\necho\n" + command + "\necho\necho " +
+                       ShellQuote("Done. You can close this window and go "
+                                  "back to Meridian.") +
+                       "\nrm -rf " + ShellQuote(dir.value()) + "\nexec " +
+                       shell + " -l\n";
+  if (!base::WriteFile(file, script) ||
+      !base::SetPosixFilePermissions(file, 0700)) {
+    return false;
+  }
+  base::LaunchOptions options;
+  return base::LaunchProcess({"/usr/bin/open", "-a", "Terminal", file.value()},
+                             options)
+      .IsValid();
+}
