+std::string WithSystem(const Turn& turn, bool first) {
+  return !turn.system.empty() && first ? turn.system + "\n\n" + turn.prompt
+                                       : turn.prompt;
+}
+
+std::string Json(const base::Value& value) {
+  return base::WriteJson(value).value_or("{}");
+}
+
+std::string StringAt(const base::DictValue& dict, std::string_view path) {
+  const base::Value* v = dict.FindByDottedPath(path);
+  if (!v) {
+    return std::string();
+  }
+  if (v->is_string()) {
+    return v->GetString();
+  }
+  if (v->is_int()) {
+    return base::NumberToString(v->GetInt());
+  }
+  return std::string();
+}
+
+bool BoolAt(const base::DictValue& dict, std::string_view key) {
+  return dict.FindBool(key).value_or(false);
+}
+
+// Text blocks of an Anthropic-style message ({content: [{type, text}]}).
+void TextBlocks(const base::DictValue& message, std::vector<Event>& out) {
+  const base::ListValue* content = message.FindList("content");
+  if (!content) {
+    return;
+  }
+  for (const base::Value& c : *content) {
+    if (!c.is_dict()) {
+      continue;
+    }
+    const std::string* type = c.GetDict().FindString("type");
+    const std::string* text = c.GetDict().FindString("text");
+    if (type && *type == "text" && text && !text->empty()) {
+      out.push_back({Event::Type::kDelta, *text});
+    }
+  }
+}
+
+using ObjectHandler =
+    std::function<void(const base::DictValue&, std::vector<Event>&)>;
+
+// One JSON object per line.
+class JsonLinesParser : public OutputParser {
+ public:
+  explicit JsonLinesParser(ObjectHandler handler)
+      : handler_(std::move(handler)) {}
+
+  void Push(std::string_view chunk, std::vector<Event>& out) override {
+    buffer_.append(chunk);
+    size_t newline;
+    while ((newline = buffer_.find('\n')) != std::string::npos) {
+      std::string line = buffer_.substr(0, newline);
+      buffer_.erase(0, newline + 1);
+      Line(line, out);
+    }
+  }
+
+  void End(std::vector<Event>& out) override {
+    Line(buffer_, out);
+    buffer_.clear();
+  }
+
+ private:
+  void Line(std::string_view line, std::vector<Event>& out) {
+    line = base::TrimWhitespaceASCII(line, base::TRIM_ALL);
+    if (!line.starts_with("{")) {
+      return;
+    }
+    std::optional<base::Value> v = base::JSONReader::Read(line, 0);
+    if (v && v->is_dict()) {
+      handler_(v->GetDict(), out);
+    }
+  }
+
+  ObjectHandler handler_;
+  std::string buffer_;
+};
+
+// Copilot prints the answer as plain text.
+class PlainTextParser : public OutputParser {
+ public:
+  void Push(std::string_view chunk, std::vector<Event>& out) override {
+    std::string text(chunk);
+    RE2::GlobalReplace(&text, "\x1b\\[[0-9;?]*[A-Za-z]", "");
+    if (!text.empty()) {
+      out.push_back({Event::Type::kDelta, text});
+    }
+  }
+  void End(std::vector<Event>& out) override {}
+};
+
+void Codex(const base::DictValue& o, std::vector<Event>& out) {
+  std::string type = StringAt(o, "type");
+  if (type == "thread.started" && !StringAt(o, "thread_id").empty()) {
+    out.push_back({Event::Type::kSession, StringAt(o, "thread_id")});
+  } else if (type == "item.completed" &&
+             StringAt(o, "item.type") == "agent_message") {
+    out.push_back({Event::Type::kDelta, StringAt(o, "item.text") + "\n"});
+  } else if (type == "error" || type == "turn.failed") {
+    std::string message = StringAt(o, "message");
+    if (message.empty()) {
+      message = StringAt(o, "error.message");
+    }
+    out.push_back(
+        {Event::Type::kError, message.empty() ? "Codex failed" : message});
+  }
+}
+
+// Claude Code's stream format (Cursor, Qwen Code and Amp use variations).
+void Result(const base::DictValue& o,
+            std::vector<Event>& out,
+            const std::string& fallback) {
+  if (!StringAt(o, "session_id").empty()) {
+    out.push_back({Event::Type::kSession, StringAt(o, "session_id")});
+  }
+  if (BoolAt(o, "is_error")) {
+    std::string message = StringAt(o, "error.message");
+    if (message.empty()) {
+      message = StringAt(o, "error");
+    }
+    if (message.empty()) {
+      message = StringAt(o, "result");
+    }
+    out.push_back({Event::Type::kError, message.empty() ? fallback : message});
+  } else {
+    out.push_back({Event::Type::kFinal, StringAt(o, "result")});
+  }
+}
+
+void Cursor(const base::DictValue& o, std::vector<Event>& out) {
+  std::string type = StringAt(o, "type");
+  if (type == "system" && !StringAt(o, "session_id").empty()) {
+    out.push_back({Event::Type::kSession, StringAt(o, "session_id")});
+  }
+  // With partial output, a delta is an assistant event with timestamp_ms and
+  // no model_call_id; the others repeat text already sent.
+  if (type == "assistant" && o.Find("timestamp_ms") &&
+      !o.Find("model_call_id")) {
+    if (const base::DictValue* message = o.FindDict("message")) {
+      TextBlocks(*message, out);
+    }
+  } else if (type == "result") {
+    Result(o, out, "Cursor failed");
+  }
+}
+
+void OpenCode(const base::DictValue& o, std::vector<Event>& out) {
+  if (!StringAt(o, "sessionID").empty()) {
+    out.push_back({Event::Type::kSession, StringAt(o, "sessionID")});
+  }
+  std::string type = StringAt(o, "type");
+  if (type == "text" && !StringAt(o, "part.text").empty()) {
+    out.push_back({Event::Type::kDelta, StringAt(o, "part.text") + "\n"});
+  } else if (type == "error") {
+    std::string message = StringAt(o, "error.data.message");
+    if (message.empty()) {
+      message = StringAt(o, "error.message");
+    }
+    out.push_back(
+        {Event::Type::kError, message.empty() ? "OpenCode failed" : message});
+  }
+}
+
+void Qwen(const base::DictValue& o, std::vector<Event>& out) {
+  std::string type = StringAt(o, "type");
+  if (type == "stream_event" &&
+      StringAt(o, "event.type") == "content_block_delta" &&
+      StringAt(o, "event.delta.type") == "text_delta") {
+    out.push_back({Event::Type::kDelta, StringAt(o, "event.delta.text")});
+  } else if (type == "system" && !StringAt(o, "session_id").empty()) {
+    out.push_back({Event::Type::kSession, StringAt(o, "session_id")});
+  } else if (type == "result") {
+    Result(o, out, "Qwen Code failed");
+  }
+}
+
+void Amp(const base::DictValue& o, std::vector<Event>& out) {
+  std::string type = StringAt(o, "type");
+  if (type == "system" && !StringAt(o, "session_id").empty()) {
+    out.push_back({Event::Type::kSession, StringAt(o, "session_id")});
+  }
+  if (type == "assistant") {
+    if (const base::DictValue* message = o.FindDict("message")) {
+      TextBlocks(*message, out);
+    }
+  } else if (type == "result" && BoolAt(o, "is_error")) {
+    std::string message = StringAt(o, "error");
+    out.push_back(
+        {Event::Type::kError, message.empty() ? "Amp failed" : message});
+  } else if (type == "system" &&
+             StringAt(o, "subtype") == "error_during_execution") {
+    std::string message = StringAt(o, "error");
+    out.push_back(
+        {Event::Type::kError, message.empty() ? "Amp failed" : message});
+  }
+}
+
+void Goose(const base::DictValue& o, std::vector<Event>& out) {
+  std::string type = StringAt(o, "type");
+  if (type == "message" && StringAt(o, "message.role") == "assistant") {
+    TextBlocks(*o.FindDict("message"), out);
+  } else if (type == "error") {
+    std::string message = StringAt(o, "error");
+    out.push_back(
+        {Event::Type::kError, message.empty() ? "Goose failed" : message});
+  }
+}
+
+void Droid(const base::DictValue& o, std::vector<Event>& out) {
+  if (StringAt(o, "type") == "result") {
+    Result(o, out, "Droid failed");
+  }
+}
+
+std::optional<bool> CodexAuth(const std::string& out, std::string* account) {
+  if (RE2::PartialMatch(out, "(?i)not logged in")) {
+    return false;
+  }
+  if (RE2::PartialMatch(out, "(?i)logged in")) {
+    if (RE2::PartialMatch(out, "(?i)ChatGPT")) {
+      *account = "ChatGPT";
+    }
+    return true;
+  }
+  return std::nullopt;
+}
+
+std::optional<bool> CursorAuth(const std::string& out, std::string* account) {
+  if (RE2::PartialMatch(out, "(?i)not logged in|log in|login required")) {
+    return false;
+  }
+  RE2::PartialMatch(out, "(?i)logged in(?: as)?\\s+([^\\s]+@[^\\s]+)", account);
+  if (RE2::PartialMatch(out, "(?i)logged in")) {
+    return true;
+  }
+  return std::nullopt;
+}
+
+std::optional<bool> OpenCodeAuth(const std::string& out, std::string*) {
+  std::string clean = out;
+  RE2::GlobalReplace(&clean, "\x1b\\[[0-9;]*m", "");
+  int count = 0;
+  if (RE2::PartialMatch(clean, "(?i)(\\d+)\\s+credentials?", &count)) {
+    return count > 0;
+  }
+  return std::nullopt;
+}
