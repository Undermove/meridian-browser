+}
+
+void LocalAgents::List(bool fresh,
+                       base::OnceCallback<void(std::vector<Status>)> done) {
+  if (!fresh && cache_ &&
+      base::TimeTicks::Now() - cache_->first < kListCacheAge) {
+    std::vector<Status> list = cache_->second;
+    // Cloud keys change without a re-check.
+    for (Status& s : list) {
+      if (const Provider* p = FindProvider(s.id); p && p->kind == Kind::kCloud) {
+        s = CloudStatus(s.id);
+      }
+    }
+    std::move(done).Run(std::move(list));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::WithBaseSyncPrimitives(),
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&ListBlocking),
+      base::BindOnce(
+          [](base::WeakPtr<LocalAgents> self,
+             base::OnceCallback<void(std::vector<Status>)> done,
+             std::vector<Status> found) {
+            if (!self) {
+              return;
+            }
+            // The two local servers, one after the other, then the keys.
+            struct Assemble {
+              static void Next(base::WeakPtr<LocalAgents> self,
+                               base::OnceCallback<void(std::vector<Status>)> done,
+                               std::vector<Status> found,
+                               size_t index) {
+                if (!self) {
+                  return;
+                }
+                while (index < found.size()) {
+                  const Provider* p = FindProvider(found[index].id);
+                  if (p->kind == Kind::kOllama ||
+                      p->kind == Kind::kOpenAiLocal) {
+                    break;
+                  }
+                  ++index;
+                }
+                if (index == found.size()) {
+                  std::vector<Status> list;
+                  for (const Provider& p : Providers()) {
+                    if (p.kind != Kind::kCloud) {
+                      for (Status& s : found) {
+                        if (s.id == p.id) {
+                          list.push_back(std::move(s));
+                        }
+                      }
+                      continue;
+                    }
+                    list.push_back(self->CloudStatus(p.id));
+                  }
+                  self->cache_ = std::make_pair(base::TimeTicks::Now(), list);
+                  std::move(done).Run(std::move(list));
+                  return;
+                }
+                const Provider* p = FindProvider(found[index].id);
+                self->LocalModels(
+                    *p,
+                    base::BindOnce(
+                        [](base::WeakPtr<LocalAgents> self,
+                           base::OnceCallback<void(std::vector<Status>)> done,
+                           std::vector<Status> found, size_t index,
+                           std::optional<std::vector<std::string>> models) {
+                          Status& s = found[index];
+                          s.installed = models && !models->empty();
+                          if (s.installed) {
+                            s.signed_in = true;
+                            s.account = models->front();
+                          }
+                          Next(self, std::move(done), std::move(found),
+                               index + 1);
+                        },
+                        self, std::move(done), std::move(found), index));
+              }
+            };
+            Assemble::Next(self, std::move(done), std::move(found), 0);
+          },
+          weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void LocalAgents::Chat(const std::string& run_id,
+                       const std::string& provider_id,
+                       Turn turn,
+                       EventCallback events) {
+  Stop(run_id);
+  const Provider* p = FindProvider(provider_id);
+  if (!p) {
+    events.Run("error", "Unknown AI.");
+    return;
+  }
+  auto run = std::make_unique<Run>();
+  run->provider = p;
+  run->events = events;
+  runs_[run_id] = std::move(run);
+  if (p->kind != Kind::kCli) {
+    HttpChat(run_id, std::move(turn));
+    return;
+  }
+  Run* r = runs_[run_id].get();
+  r->cancel = base::MakeRefCounted<CancelFlag>();
+  r->parser = MakeParser(*p);
+  auto output = base::BindPostTaskToCurrentDefault(base::BindRepeating(
+      &LocalAgents::OnCliOutput, weak_factory_.GetWeakPtr(), run_id));
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::WithBaseSyncPrimitives(),
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&RunCliBlocking, provider_id, std::move(turn), workdir_,
+                     r->cancel, output),
+      base::BindOnce(
+          [](base::WeakPtr<LocalAgents> self, std::string run_id,
+             CliOutcome outcome) {
+            if (self) {
+              self->OnCliDone(run_id, outcome.found, outcome.result.started,
+                              outcome.result.exit_code, outcome.result.killed,
+                              outcome.result.timed_out,
+                              outcome.result.too_long,
+                              outcome.result.stderr_text);
+            }
+          },
+          weak_factory_.GetWeakPtr(), run_id));
+}
+
+void LocalAgents::OnCliOutput(const std::string& run_id, std::string chunk) {
+  auto it = runs_.find(run_id);
+  if (it == runs_.end()) {
+    return;
+  }
+  Run* run = it->second.get();
+  std::vector<Event> events;
+  run->parser->Push(chunk, events);
+  for (const Event& e : events) {
+    switch (e.type) {
+      case Event::Type::kDelta:
+        run->text += e.text;
+        run->events.Run("text", e.text);
+        break;
+      case Event::Type::kFinal:
+        run->final_text = e.text;
+        break;
+      case Event::Type::kSession:
+        run->events.Run("session", e.text);
+        break;
+      case Event::Type::kError:
+        run->error = e.text;
+        break;
+    }
+  }
+}
+
+void LocalAgents::OnCliDone(const std::string& run_id,
+                            bool found,
+                            bool started,
+                            int exit_code,
+                            bool killed,
+                            bool timed_out,
+                            bool too_long,
+                            std::string stderr_text) {
+  auto it = runs_.find(run_id);
+  if (it == runs_.end()) {
+    return;
+  }
+  Run* run = it->second.get();
+  const Provider& p = *run->provider;
+  if (!found) {
+    Finish(run_id, "error",
+           p.label + " isn’t installed. Set it up in Settings > AI.");
+    return;
+  }
+  if (!started) {
+    Finish(run_id, "error", "Couldn’t start " + p.label + ".");
+    return;
+  }
+  OnCliOutput(run_id, std::string());
+  std::vector<Event> tail;
+  run->parser->End(tail);
+  for (const Event& e : tail) {
+    if (e.type == Event::Type::kDelta) {
+      run->text += e.text;
+      run->events.Run("text", e.text);
+    } else if (e.type == Event::Type::kFinal) {
+      run->final_text = e.text;
+    } else if (e.type == Event::Type::kSession) {
+      run->events.Run("session", e.text);
+    } else {
+      run->error = e.text;
+    }
+  }
+  // CLIs that don't stream (or only sent the final result) still answer.
+  if (run->text.empty() && !run->final_text.empty()) {
+    run->text = run->final_text;
+    run->events.Run("text", run->final_text);
+  }
+  if (timed_out) {
+    Finish(run_id, "error", p.label + " took too long to answer.");
+  } else if (too_long) {
+    Finish(run_id, "error", "The answer was too long.");
+  } else if (!run->error.empty()) {
+    Finish(run_id, "error", FriendlyCliError(p, run->error, stderr_text));
+  } else if (killed) {
+    Finish(run_id, "done", "stopped");
+  } else if (exit_code != 0 && run->text.empty()) {
+    Finish(run_id, "error", FriendlyCliError(p, std::string(), stderr_text));
+  } else {
+    Finish(run_id, "done", std::string());
+  }
+}
+
+void LocalAgents::Stop(const std::string& run_id) {
+  auto it = runs_.find(run_id);
+  if (it == runs_.end()) {
+    return;
+  }
+  if (it->second->cancel) {
+    it->second->cancel->Set();
+  }
+  Finish(run_id, "done", "stopped");
+}
+
+void LocalAgents::Finish(const std::string& run_id,
+                         const std::string& type,
+                         const std::string& text) {
+  auto it = runs_.find(run_id);
+  if (it == runs_.end()) {
+    return;
+  }
+  std::unique_ptr<Run> run = std::move(it->second);
+  runs_.erase(it);
+  run->events.Run(type, text);
+  // A LineStream may be finishing this run from inside its own callback.
+  if (run->http) {
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(run->http));
+  }
+}
+
+void LocalAgents::HttpChat(const std::string& run_id, Turn turn) {
+  const Provider& p = *runs_[run_id]->provider;
+  if (p.kind == Kind::kCloud) {
+    std::string id = p.id;
+    WithCloudKey(
+        id,
+        base::BindOnce(
+            [](base::WeakPtr<LocalAgents> self, std::string run_id, Turn turn,
+               std::optional<std::string> key) {
+              if (!self || !self->runs_.contains(run_id)) {
+                return;
+              }
+              const Provider& p = *self->runs_[run_id]->provider;
+              if (!key) {
+                self->Finish(run_id, "error",
+                             "Add your " + p.vendor +
+                                 " API key in Settings > AI.");
+                return;
+              }
+              std::string id = p.id;
+              self->CloudModels(
+                  id, base::BindOnce(
+                          [](base::WeakPtr<LocalAgents> self,
+                             std::string run_id, Turn turn, std::string key,
+                             std::vector<std::string> models,
+                             std::string error) {
+                            if (!self || !self->runs_.contains(run_id)) {
+                              return;
+                            }
+                            const Provider& p = *self->runs_[run_id]->provider;
+                            if (!error.empty()) {
+                              self->Finish(run_id, "error", error);
+                              return;
+                            }
+                            const std::string* chosen =
+                                self->profile_->GetPrefs()
+                                    ->GetDict(prefs::kAiModels)
+                                    .FindString(p.id);
+                            std::string model = PickModel(
+                                p.id, models,
+                                !turn.model.empty()
+                                    ? turn.model
+                                    : (chosen ? *chosen : std::string()));
+                            if (model.empty()) {
+                              self->Finish(run_id, "error",
+                                           p.vendor +
+                                               " didn’t list any chat models "
+                                               "for this key.");
+                              return;
+                            }
+                            self->StartHttp(run_id, std::move(turn),
+                                            CloudBase(p) + "/chat/completions",
+                                            key, model);
+                          },
+                          self, run_id, std::move(turn), *key));
+            },
+            weak_factory_.GetWeakPtr(), run_id, std::move(turn)));
+    return;
+  }
+  LocalModels(
+      p, base::BindOnce(
+             [](base::WeakPtr<LocalAgents> self, std::string run_id, Turn turn,
+                std::optional<std::vector<std::string>> models) {
+               if (!self || !self->runs_.contains(run_id)) {
+                 return;
+               }
+               const Provider& p = *self->runs_[run_id]->provider;
+               if (!models) {
+                 self->Finish(run_id, "error",
+                              p.label +
+                                  " isn’t running. Start it, then try again.");
+                 return;
+               }
+               if (models->empty()) {
+                 self->Finish(run_id, "error",
+                              p.label +
+                                  " has no models yet. Download one first.");
+                 return;
+               }
+               std::string model =
+                   std::ranges::find(*models, turn.model) != models->end()
+                       ? turn.model
+                       : models->front();
+               std::string url =
+                   *LocalBase(p) + (p.kind == Kind::kOllama
+                                        ? "/api/chat"
+                                        : "/v1/chat/completions");
+               self->StartHttp(run_id, std::move(turn), url, std::string(),
+                               model);
+             },
+             weak_factory_.GetWeakPtr(), run_id, std::move(turn)));
+}
+
+void LocalAgents::StartHttp(const std::string& run_id,
+                            Turn turn,
+                            std::string url,
+                            std::string key,
+                            std::string model) {
+  Run* run = runs_[run_id].get();
+  base::ListValue messages;
+  if (!turn.system.empty()) {
+    messages.Append(
+        base::DictValue().Set("role", "system").Set("content", turn.system));
+  }
+  messages.Append(
+      base::DictValue().Set("role", "user").Set("content", turn.prompt));
+  base::DictValue body;
+  body.Set("model", model);
+  body.Set("messages", std::move(messages));
+  body.Set("stream", true);
+  auto loader = Request(url, "POST", key, *run->provider);
+  loader->AttachStringForUpload(base::WriteJson(body).value_or("{}"),
+                                "application/json");
+  run->http = std::make_unique<LineStream>(
+      std::move(loader),
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindRepeating(&LocalAgents::OnHttpLine, weak_factory_.GetWeakPtr(),
+                          run_id),
+      base::BindOnce(&LocalAgents::OnHttpDone, weak_factory_.GetWeakPtr(),
+                     run_id));
+}
+
+void LocalAgents::OnHttpLine(const std::string& run_id,
+                             std::string_view line) {
+  auto it = runs_.find(run_id);
+  if (it == runs_.end()) {
+    return;
+  }
+  Run* run = it->second.get();
+  StreamLine parsed = ParseStreamLine(run->provider->kind, line);
+  if (!parsed.error.empty()) {
+    run->error = parsed.error;
+  } else if (!parsed.delta.empty()) {
+    run->text += parsed.delta;
+    run->events.Run("text", parsed.delta);
+  }
+}
+
+void LocalAgents::OnHttpDone(const std::string& run_id,
+                             int status,
+                             std::string body) {
+  auto it = runs_.find(run_id);
+  if (it == runs_.end()) {
+    return;
+  }
+  Run* run = it->second.get();
+  const Provider& p = *run->provider;
+  if (status != 200) {
+    Finish(run_id, "error", HttpError(p, status, body));
+  } else if (!run->error.empty()) {
+    Finish(run_id, "error",
+           (p.kind == Kind::kCloud ? p.vendor : p.label) + ": " + run->error);
+  } else {
+    Finish(run_id, "done", std::string());
+  }
+}
+
+void LocalAgents::LocalModels(
+    const Provider& p,
+    base::OnceCallback<void(std::optional<std::vector<std::string>>)> done) {
+  std::optional<std::string> base = LocalBase(p);
+  if (!base) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  bool ollama = p.kind == Kind::kOllama;
+  auto loader = Request(*base + (ollama ? "/api/tags" : "/v1/models"), "GET",
+                        std::string(), p);
+  loader->SetTimeoutDuration(base::Milliseconds(1200));
+  network::SimpleURLLoader* raw = loader.get();
+  raw->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(
+          [](std::unique_ptr<network::SimpleURLLoader> loader, bool ollama,
+             base::OnceCallback<void(std::optional<std::vector<std::string>>)>
+                 done,
+             std::optional<std::string> body) {
+            const network::mojom::URLResponseHead* head = loader->ResponseInfo();
+            int status =
+                head && head->headers ? head->headers->response_code() : 0;
+            std::optional<base::Value> v =
+                body ? base::JSONReader::Read(*body, 0) : std::nullopt;
+            if (status != 200 || !v || !v->is_dict()) {
+              std::move(done).Run(std::nullopt);
+              return;
+            }
+            std::vector<std::string> models;
+            const base::ListValue* list =
+                v->GetDict().FindList(ollama ? "models" : "data");
+            if (list) {
+              for (const base::Value& m : *list) {
+                const std::string* name =
+                    m.is_dict() ? m.GetDict().FindString(ollama ? "name" : "id")
+                                : nullptr;
+                if (name) {
+                  models.push_back(*name);
+                }
+              }
+            }
+            std::move(done).Run(std::move(models));
+          },
+          std::move(loader), ollama, std::move(done)),
+      1 << 20);
+}
+
+LocalAgents::Status LocalAgents::CloudStatus(const std::string& id) const {
+  Status s;
+  s.id = id;
+  s.installed = HasCloudKey(id);
+  if (s.installed) {
+    s.signed_in = true;
+    auto it = models_.find(id);
+    if (it != models_.end()) {
+      // The default model (what "Default" in the picker means).
+      s.account = PickModel(id, it->second.second, std::string());
+    }
+  }
+  return s;
+}
+
+bool LocalAgents::HasCloudKey(const std::string& id) const {
+  return profile_->GetPrefs()->GetDict(prefs::kAiCloudKeys).FindString(id);
+}
+
+std::vector<std::string> LocalAgents::CloudKeyIds() const {
+  std::vector<std::string> ids;
+  for (const Provider& p : Providers()) {
+    if (p.kind == Kind::kCloud && HasCloudKey(p.id)) {
+      ids.push_back(p.id);
+    }
+  }
+  return ids;
+}
+
+void LocalAgents::WithCloudKey(
+    const std::string& id,
+    base::OnceCallback<void(std::optional<std::string>)> done) {
+  const std::string* stored =
+      profile_->GetPrefs()->GetDict(prefs::kAiCloudKeys).FindString(id);
+  std::string sealed;
+  if (!stored || !base::Base64Decode(*stored, &sealed) || sealed.empty()) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+      [](base::OnceCallback<void(std::optional<std::string>)> done,
+         std::string sealed,
+         scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+        std::string key;
+        if (!encryptor || !encryptor->DecryptString(sealed, &key)) {
+          std::move(done).Run(std::nullopt);
+          return;
+        }
+        std::move(done).Run(key);
+      },
+      std::move(done), sealed));
+}
+
+void LocalAgents::ListModels(
+    const std::string& id,
+    const std::string& key,
+    base::OnceCallback<void(int, std::vector<std::string>)> done) {
+  const Provider* p = FindProvider(id);
+  auto loader = Request(CloudBase(*p) + "/models", "GET", key, *p);
+  loader->SetTimeoutDuration(base::Seconds(10));
+  network::SimpleURLLoader* raw = loader.get();
+  raw->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(
+          [](std::unique_ptr<network::SimpleURLLoader> loader, std::string id,
+             base::OnceCallback<void(int, std::vector<std::string>)> done,
+             std::optional<std::string> body) {
+            const network::mojom::URLResponseHead* head = loader->ResponseInfo();
+            int status =
+                head && head->headers ? head->headers->response_code() : 0;
+            std::vector<std::string> models;
+            std::optional<base::Value> v =
+                body ? base::JSONReader::Read(*body, 0) : std::nullopt;
+            if (status == 200 && v && v->is_dict()) {
+              models = ChatModels(id, v->GetDict());
+            }
+            std::move(done).Run(status, std::move(models));
+          },
+          std::move(loader), id, std::move(done)),
+      4 << 20);
+}
+
+void LocalAgents::CloudModels(
+    const std::string& id,
+    base::OnceCallback<void(std::vector<std::string>, std::string)> done) {
+  auto it = models_.find(id);
+  if (it != models_.end() &&
+      base::TimeTicks::Now() - it->second.first < kModelsCacheAge) {
+    std::move(done).Run(it->second.second, std::string());
+    return;
+  }
+  WithCloudKey(
+      id,
+      base::BindOnce(
+          [](base::WeakPtr<LocalAgents> self, std::string id,
+             base::OnceCallback<void(std::vector<std::string>, std::string)>
+                 done,
+             std::optional<std::string> key) {
+            if (!self) {
+              return;
+            }
+            const Provider* p = FindProvider(id);
+            if (!key) {
+              std::move(done).Run({}, "Add your " + p->vendor +
+                                          " API key in Settings > AI.");
+              return;
+            }
+            self->ListModels(
+                id, *key,
+                base::BindOnce(
+                    [](base::WeakPtr<LocalAgents> self, std::string id,
+                       base::OnceCallback<void(std::vector<std::string>,
+                                               std::string)> done,
+                       int status, std::vector<std::string> models) {
+                      const Provider* p = FindProvider(id);
+                      if (status == 401 || status == 403) {
+                        std::move(done).Run({}, p->vendor +
+                                                    " rejected the API key. "
+                                                    "Add it again in Settings "
+                                                    "> AI.");
+                        return;
+                      }
+                      if (status != 200) {
+                        std::move(done).Run({}, HttpError(*p, status, ""));
+                        return;
+                      }
+                      if (self) {
+                        self->models_[id] = {base::TimeTicks::Now(), models};
+                      }
+                      std::move(done).Run(std::move(models), std::string());
+                    },
+                    self, id, std::move(done)));
+          },
+          weak_factory_.GetWeakPtr(), id, std::move(done)));
+}
+
+void LocalAgents::AddCloudKey(
+    const std::string& raw,
+    base::OnceCallback<void(bool, std::string, std::string)> done) {
+  std::string key(base::TrimWhitespaceASCII(raw, base::TRIM_ALL));
+  std::vector<std::string> candidates;
+  for (const std::string& id : DetectKey(key)) {
+    const Provider* p = FindProvider(id);
+    if (p && p->kind == Kind::kCloud) {
+      candidates.push_back(id);
+    }
+  }
+  if (candidates.empty()) {
+    std::move(done).Run(
+        false, std::string(),
+        "That doesn’t look like an API key. A key is one long code, like "
+        "“sk-…” or “AIza…”: copy the whole thing from the provider’s page. "
+        "Meridian knows keys from Anthropic, OpenAI, Google Gemini, "
+        "OpenRouter, xAI, Mistral, DeepSeek and Groq.");
+    return;
+  }
+  // Each candidate in turn; the first that lists models owns the key.
+  struct Try {
+    static void Next(base::WeakPtr<LocalAgents> self, std::string key,
+                     std::vector<std::string> candidates, size_t index,
+                     int last_status,
+                     base::OnceCallback<void(bool, std::string, std::string)>
+                         done) {
+      if (!self) {
+        return;
+      }
+      if (index == candidates.size()) {
+        std::string who = FindProvider(candidates.front())->vendor;
+        std::move(done).Run(
+            false, std::string(),
+            last_status == 401 || last_status == 403
+                ? who + " didn’t accept this key. Copy it again from your " +
+                      who + " account."
+                : "Couldn’t reach " + who +
+                      " to check the key. Check your connection and try "
+                      "again.");
+        return;
+      }
+      std::string id = candidates[index];
+      self->ListModels(
+          id, key,
+          base::BindOnce(
+              [](base::WeakPtr<LocalAgents> self, std::string key,
+                 std::vector<std::string> candidates, size_t index,
+                 base::OnceCallback<void(bool, std::string, std::string)> done,
+                 int status, std::vector<std::string> models) {
+                if (!self) {
+                  return;
+                }
+                if (status != 200) {
+                  Next(self, key, std::move(candidates), index + 1, status,
+                       std::move(done));
+                  return;
+                }
+                std::string id = candidates[index];
+                self->models_[id] = {base::TimeTicks::Now(), models};
+                g_browser_process->os_crypt_async()->GetInstance(
+                    base::BindOnce(
+                        [](base::WeakPtr<LocalAgents> self, std::string id,
+                           std::string key,
+                           base::OnceCallback<void(bool, std::string,
+                                                   std::string)> done,
+                           scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+                          std::string sealed;
+                          if (!self || !encryptor ||
+                              !encryptor->EncryptString(key, &sealed)) {
+                            std::move(done).Run(
+                                false, std::string(),
+                                "Meridian couldn’t reach your Mac’s keychain "
+                                "to store the key safely.");
+                            return;
+                          }
+                          ScopedDictPrefUpdate(self->profile_->GetPrefs(),
+                                               prefs::kAiCloudKeys)
+                              ->Set(id, base::Base64Encode(sealed));
+                          std::move(done).Run(true, id, std::string());
+                        },
+                        self, id, key, std::move(done)));
+              },
+              self, key, std::move(candidates), index, std::move(done)));
+    }
+  };
+  Try::Next(weak_factory_.GetWeakPtr(), key, std::move(candidates), 0, 0,
+            std::move(done));
+}
+
+void LocalAgents::RemoveCloudKey(const std::string& id) {
+  ScopedDictPrefUpdate(profile_->GetPrefs(), prefs::kAiCloudKeys)->Remove(id);
+  models_.erase(id);
+}
+
+}  // namespace meridian::ai
