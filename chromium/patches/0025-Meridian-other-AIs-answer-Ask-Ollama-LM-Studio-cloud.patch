+          "(Ollama, LM Studio) or a cloud API on their own key (OpenAI, "
+          "Gemini, OpenRouter, xAI, Mistral, DeepSeek, Groq). Also lists the "
+          "models a key can use, to check it."
+        trigger: "The person asks in the Ask panel or the command bar, or "
+                 "adds a key in Settings > AI."
+        data: "The question, the current page's text, earlier turns."
+        destination: OTHER
+        destination_other: "The provider the person picked."
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Settings > AI."
+        policy_exception_justification: "Opt-in feature."
+      })");
+
+const base::CommandLine& Switches() {
+  return *base::CommandLine::ForCurrentProcess();
+}
+
+// Tests put fake CLIs here and get none of the developer's own agents,
+// login shell or model servers.
+std::string TestPath() {
+  return Switches().GetSwitchValueASCII("meridian-agents-path");
+}
+
+std::string Env(const std::string& name) {
+  return base::Environment::Create()->GetVar(name).value_or("");
+}
+
+bool Skipped(const std::string& name) {
+  return !RE2::FullMatch(name, "[A-Za-z_][A-Za-z0-9_]*") ||
+         RE2::PartialMatch(name,
+                           "^(MERIDIAN_|CHROME_|npm_|NODE_OPTIONS$|PWD$|"
+                           "OLDPWD$|SHLVL$|_$|TERM_SESSION_ID$|TMUX)");
+}
+
+// The person's login-shell environment (CLAUDE_CONFIG_DIR, CODEX_HOME,
+// proxies, PATH… that an app started from the Dock doesn't get). Blocking;
+// computed once.
+std::map<std::string, std::string> ChildEnv() {
+  static base::NoDestructor<base::Lock> lock;
+  static base::NoDestructor<std::optional<std::map<std::string, std::string>>>
+      cache;
+  base::AutoLock hold(*lock);
+  if (!cache->has_value()) {
+    std::map<std::string, std::string> env;
+    std::string shell = Env("SHELL");
+    if (shell.empty()) {
+      shell = "/bin/zsh";
+    }
+    std::map<std::string, std::string> base_env = {
+        {"HOME", Env("HOME")},       {"USER", Env("USER")},
+        {"LOGNAME", Env("LOGNAME")}, {"SHELL", shell},
+        {"TMPDIR", Env("TMPDIR")},   {"LANG", "en_US.UTF-8"},
+        {"PATH", "/usr/bin:/bin:/usr/sbin:/sbin"}};
+    std::string test_path = TestPath();
+    if (!test_path.empty()) {
+      env = base_env;
+      env["PATH"] = test_path + ":/usr/bin:/bin";
+    } else {
+      base_env["TERM"] = "dumb";
+      std::string out = CaptureOutput(
+          {shell, "-ilc",
+           "printf __MERIDIAN_ENV__; env -0; printf __MERIDIAN_END__"},
+          base_env, Env("HOME"), base::Seconds(5));
+      size_t start = out.find("__MERIDIAN_ENV__");
+      size_t end = out.find("__MERIDIAN_END__");
+      if (start != std::string::npos && end != std::string::npos &&
+          end > start) {
+        start += strlen("__MERIDIAN_ENV__");
+        for (const std::string& entry :
+             base::SplitString(out.substr(start, end - start),
+                               std::string(1, '\0'), base::KEEP_WHITESPACE,
+                               base::SPLIT_WANT_NONEMPTY)) {
+          size_t eq = entry.find('=');
+          if (eq == std::string::npos || eq == 0) {
+            continue;
+          }
+          std::string name = entry.substr(0, eq);
+          if (!Skipped(name)) {
+            env[name] = entry.substr(eq + 1);
+          }
+        }
+      }
+      for (const auto& [name, value] : base_env) {
+        if (!env.contains(name) && name != "TERM") {
+          env[name] = value;
+        }
+      }
+    }
+    env["NO_COLOR"] = "1";
+    env["CI"] = "1";
+    env["TERM"] = "dumb";
+    *cache = std::move(env);
+  }
+  return **cache;
+}
+
+std::string Which(const std::string& name, const std::string& path) {
+  for (const std::string& dir : base::SplitString(
+           path, ":", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    base::FilePath candidate = base::FilePath(dir).Append(name);
+    if (!base::DirectoryExists(candidate) &&
+        access(candidate.value().c_str(), X_OK) == 0) {
+      return candidate.value();
+    }
+  }
+  return std::string();
+}
+
+// Cursor also installs itself as `agent`, a name other tools use too: that
+// one only counts when it really is Cursor's.
+std::string FindBin(const Provider& p, const std::string& path) {
+  std::string direct = Which(p.bin, path);
+  if (!direct.empty()) {
+    return direct;
+  }
+  for (const std::string& alt : p.alt_bins) {
+    std::string bin = Which(alt, path);
+    if (!bin.empty() &&
+        base::ToLowerASCII(
+            base::MakeAbsoluteFilePath(base::FilePath(bin)).value())
+                .find("cursor") != std::string::npos) {
+      return bin;
+    }
+  }
+  return std::string();
+}
+
+// The first install command whose tool is here.
+std::pair<std::string, std::string> InstallFor(const Provider& p,
+                                               const std::string& path) {
+  std::string missing;
+  for (const Install& option : p.install) {
+    if (option.needs.empty() || !Which(option.needs, path).empty()) {
+      return {option.command, std::string()};
+    }
+    if (missing.empty()) {
+      missing = option.needs == "npm" ? "Node.js (nodejs.org)" : option.needs;
+    }
+  }
+  return {std::string(), missing};
+}
+
+// Blocking: what's installed and signed in, and how to install the rest.
+std::vector<LocalAgents::Status> ListBlocking() {
+  std::map<std::string, std::string> env = ChildEnv();
+  const std::string& path = env["PATH"];
+  std::vector<LocalAgents::Status> out;
+  for (const Provider& p : Providers()) {
+    if (p.kind == Kind::kCloud) {
+      continue;
+    }
+    LocalAgents::Status status;
+    status.id = p.id;
+    std::tie(status.install_command, status.install_missing) =
+        InstallFor(p, path);
+    if (p.kind == Kind::kCli) {
+      std::string bin = FindBin(p, path);
+      status.installed = !bin.empty();
+      std::optional<AuthCheck> check = AuthCheckFor(p);
+      if (status.installed && check) {
+        std::vector<std::string> argv = {bin};
+        argv.insert(argv.end(), check->args.begin(), check->args.end());
+        std::string output =
+            CaptureOutput(argv, env, env["HOME"], base::Seconds(4));
+        status.signed_in = check->parse(output, &status.account);
+      }
+    }
+    out.push_back(std::move(status));
+  }
+  return out;
+}
+
+struct CliOutcome {
+  bool found = false;
+  ProcessResult result;
+};
+
+CliOutcome RunCliBlocking(std::string provider_id,
+                          Turn turn,
+                          base::FilePath workdir,
+                          scoped_refptr<CancelFlag> cancel,
+                          base::RepeatingCallback<void(std::string)> output) {
+  CliOutcome outcome;
+  const Provider* p = FindProvider(provider_id);
+  std::map<std::string, std::string> env = ChildEnv();
+  std::string bin = p ? FindBin(*p, env["PATH"]) : std::string();
+  if (bin.empty()) {
+    return outcome;
+  }
+  outcome.found = true;
+  // A stable, private, empty working directory per provider.
+  base::FilePath dir = workdir.Append(p->id);
+  base::CreateDirectory(dir);
+  base::SetPosixFilePermissions(dir, 0700);
+  CommandSpec command = BuildCommand(*p, turn, dir.value());
+  for (const auto& [name, content] : command.files) {
+    base::FilePath file = dir.Append(name);
+    base::WriteFile(file, content);
+    base::SetPosixFilePermissions(file, 0600);
+  }
+  ProcessSpec spec;
+  spec.argv = {bin};
+  spec.argv.insert(spec.argv.end(), command.args.begin(), command.args.end());
+  spec.env = env;
+  for (const auto& [name, value] : command.env) {
+    spec.env[name] = value;
+  }
+  spec.cwd = dir.value();
+  spec.stdin_text = command.stdin_text;
+  spec.timeout = kRunTimeout;
+  outcome.result = RunProcess(
+      spec, cancel,
+      base::BindRepeating(
+          [](base::RepeatingCallback<void(std::string)> output,
+             std::string_view chunk) { output.Run(std::string(chunk)); },
+          output));
+  return outcome;
+}
+
+std::string CloudBase(const Provider& p) {
+  std::string mock = Switches().GetSwitchValueASCII("meridian-cloud-base-url");
+  return mock.empty() ? p.base : mock + "/" + p.id;
+}
+
+// nullopt: tests that didn't ask for one never see the developer's own
+// server.
+std::optional<std::string> LocalBase(const Provider& p) {
+  std::string url =
+      Switches().GetSwitchValueASCII("meridian-" + p.id + "-url");
+  if (!url.empty()) {
+    return url;
+  }
+  if (!TestPath().empty()) {
+    return std::nullopt;
+  }
+  return p.base;
+}
+
+std::string HttpError(const Provider& p, int status, const std::string& body) {
+  std::string detail;
+  if (std::optional<base::Value> v = base::JSONReader::Read(body, 0);
+      v && v->is_dict()) {
+    const base::DictValue& d = v->GetDict();
+    if (const std::string* m = d.FindStringByDottedPath("error.message")) {
+      detail = *m;
+    } else if (const std::string* m2 = d.FindString("message")) {
+      detail = *m2;
+    } else if (const std::string* m3 = d.FindString("error")) {
+      detail = *m3;
+    }
+  }
+  if (detail.size() > 300) {
+    detail.resize(300);
+  }
+  std::string who = p.kind == Kind::kCloud ? p.vendor : p.label;
+  if (status == 0) {
+    return "Couldn’t reach " + who + ". Check your connection.";
+  }
+  if (status == 401 || status == 403) {
+    return who + " rejected the API key" +
+           (detail.empty() ? "" : ": " + detail) + ".";
+  }
+  if (status == 402) {
+    return who + ": the account is out of credit. Top it up on their site.";
+  }
+  if (status == 429) {
+    return who + " says: too many requests or no quota left" +
+           (detail.empty() ? "" : " (" + detail + ")") + ".";
+  }
+  return who + ": HTTP " + base::NumberToString(status) +
+         (detail.empty() ? "" : " — " + detail);
+}
+
+std::unique_ptr<network::SimpleURLLoader> Request(
+    const std::string& url,
+    const std::string& method,
+    const std::string& key,
+    const Provider& p) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(url);
+  request->method = method;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  if (!key.empty()) {
+    request->headers.SetHeader("Authorization", "Bearer " + key);
+  }
+  // OpenRouter shows which app sent the request (their optional attribution
+  // headers).
+  if (p.id == "openrouter") {
+    request->headers.SetHeader("HTTP-Referer",
+                               "https://undermove.github.io/meridian-browser/");
+    request->headers.SetHeader("X-Title", "Meridian");
+  }
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+  loader->SetAllowHttpErrorResults(true);
+  return loader;
+}
