+TEST(ProvidersTest, StreamLines) {
+  EXPECT_EQ(ParseStreamLine(Kind::kCloud,
+                            "data: {\"choices\":[{\"delta\":{\"content\":"
+                            "\"Hi\"}}]}")
+                .delta,
+            "Hi");
+  EXPECT_EQ(ParseStreamLine(Kind::kCloud, "data: [DONE]").delta, "");
+  EXPECT_EQ(ParseStreamLine(Kind::kOllama,
+                            "{\"message\":{\"content\":\"Yo\"},\"done\":false}")
+                .delta,
+            "Yo");
+  EXPECT_EQ(ParseStreamLine(Kind::kCloud,
+                            "data: {\"error\":{\"message\":\"quota\"}}")
+                .error,
+            "quota");
+}
+
+TEST(ProvidersTest, FriendlyErrors) {
+  const Provider& codex = *FindProvider("codex");
+  EXPECT_EQ(FriendlyCliError(codex, "", "Error: not logged in"),
+            "Codex isn’t signed in. Open Settings > AI and sign in.");
