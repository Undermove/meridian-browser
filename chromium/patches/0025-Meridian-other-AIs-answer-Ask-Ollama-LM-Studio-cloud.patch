+struct LocalAgents::Run {
+  raw_ptr<const Provider> provider;
+  EventCallback events;
+  scoped_refptr<CancelFlag> cancel;
+  std::unique_ptr<OutputParser> parser;
+  std::string text;
+  std::string final_text;
+  std::string error;
+  std::unique_ptr<LineStream> http;
+};
+
+// A streamed HTTP answer, line by line; an error answer is kept whole.
+class LocalAgents::LineStream : public network::SimpleURLLoaderStreamConsumer {
+ public:
+  using LineCallback = base::RepeatingCallback<void(std::string_view)>;
+  using Done = base::OnceCallback<void(int status, std::string body)>;
+
+  LineStream(std::unique_ptr<network::SimpleURLLoader> loader,
+             network::mojom::URLLoaderFactory* factory,
+             LineCallback on_line,
+             Done done)
+      : loader_(std::move(loader)),
+        on_line_(std::move(on_line)),
+        done_(std::move(done)) {
+    loader_->SetOnResponseStartedCallback(base::BindOnce(
+        [](LineStream* self, const GURL&,
+           const network::mojom::URLResponseHead& head) {
+          self->status_ = head.headers ? head.headers->response_code() : 0;
+        },
+        base::Unretained(this)));
+    loader_->DownloadAsStream(factory, this);
+  }
+
+  void OnDataReceived(std::string_view data,
+                      base::OnceClosure resume) override {
+    buffer_.append(data);
+    if (status_ == 200) {
+      size_t newline;
+      while ((newline = buffer_.find('\n')) != std::string::npos) {
+        std::string line = buffer_.substr(0, newline);
+        buffer_.erase(0, newline + 1);
+        on_line_.Run(line);
+      }
+    }
+    std::move(resume).Run();
+  }
+
+  void OnComplete(bool success) override {
+    if (status_ == 200 && !buffer_.empty()) {
+      on_line_.Run(buffer_);
+    }
+    // Runs last: may delete this.
+    std::move(done_).Run(success || status_ != 200 ? status_ : 0, buffer_);
+  }
+
+  void OnRetry(base::OnceClosure start_retry) override {}
+
+ private:
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  LineCallback on_line_;
+  Done done_;
+  std::string buffer_;
+  int status_ = 0;
+};
