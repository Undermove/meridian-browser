+std::unique_ptr<OutputParser> MakeParser(const Provider& p) {
+  if (p.id == "copilot") {
+    return std::make_unique<PlainTextParser>();
+  }
+  static const base::NoDestructor<std::map<std::string, ObjectHandler>>
+      handlers(std::map<std::string, ObjectHandler>{
+          {"codex", Codex},
+          {"cursor", Cursor},
+          {"opencode", OpenCode},
+          {"qwen", Qwen},
+          {"amp", Amp},
+          {"goose", Goose},
+          {"droid", Droid},
+      });
+  auto it = handlers->find(p.id);
+  return std::make_unique<JsonLinesParser>(
+      it != handlers->end() ? it->second : ObjectHandler(Droid));
+}
+
+std::string FriendlyCliError(const Provider& p,
+                             const std::string& message,
+                             const std::string& stderr_text) {
+  std::string all = message + "\n" + stderr_text;
+  if (RE2::PartialMatch(all,
+                        "(?i)not logged in|log in|login|unauthori[sz]ed|"
+                        "authenticat|401|credentials")) {
+    return p.label + " isn’t signed in. Open Settings > AI and sign in.";
+  }
+  if (RE2::PartialMatch(all, "(?i)policy|access denied")) {
+    return p.label + " is blocked by your organization’s policy.";
+  }
+  if (RE2::PartialMatch(all, "(?i)rate.?limit|429|usage limit|quota")) {
+    return p.label +
+           " hit a usage limit. Try again later or pick another agent.";
+  }
+  std::string last = "Something went wrong.";
+  for (const std::string& line :
+       base::SplitString(message.empty() ? stderr_text : message, "\n",
+                         base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    last = line;
+  }
+  if (last.size() > 300) {
+    last.resize(300);
+  }
+  return p.label + ": " + last;
+}
