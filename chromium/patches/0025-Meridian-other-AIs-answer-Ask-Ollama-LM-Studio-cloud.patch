+std::string PickModel(const std::string& id,
+                      const std::vector<std::string>& models,
+                      const std::string& chosen) {
+  if (!chosen.empty() && std::ranges::find(models, chosen) != models.end()) {
+    return chosen;
+  }
+  auto it = Cloud().find(id);
+  if (it == Cloud().end()) {
+    return models.empty() ? std::string() : models.front();
+  }
+  std::vector<std::string> newest_first = models;
+  std::ranges::sort(newest_first, [](const std::string& a,
+                                     const std::string& b) {
+    return NumericLess(b, a);
+  });
+  for (const std::string& pattern : it->second.prefer) {
+    RE2 re(pattern);
+    for (const std::string& m : newest_first) {
+      if (RE2::PartialMatch(m, re)) {
+        return m;
+      }
+    }
+  }
+  if (!it->second.fallback.empty()) {
+    return it->second.fallback;
+  }
+  return newest_first.empty() ? std::string() : newest_first.front();
+}
+
+StreamLine ParseStreamLine(Kind kind, std::string_view raw) {
+  StreamLine out;
+  std::string_view line = base::TrimWhitespaceASCII(raw, base::TRIM_ALL);
+  if (kind != Kind::kOllama) {
+    if (!line.starts_with("data:")) {
+      return out;
+    }
+    line = base::TrimWhitespaceASCII(line.substr(5), base::TRIM_ALL);
+    if (line == "[DONE]") {
+      return out;
+    }
+  }
+  if (!line.starts_with("{")) {
+    return out;
+  }
+  std::optional<base::Value> v = base::JSONReader::Read(line, 0);
+  if (!v || !v->is_dict()) {
+    return out;
+  }
+  const base::DictValue& o = v->GetDict();
+  if (const base::Value* error = o.Find("error")) {
+    out.error = error->is_string() ? error->GetString()
+                                   : StringAt(o, "error.message");
+    if (out.error.empty()) {
+      out.error = "the server reported an error";
+    }
+    return out;
+  }
+  if (kind == Kind::kOllama) {
+    out.delta = StringAt(o, "message.content");
+  } else if (const base::ListValue* choices = o.FindList("choices");
+             choices && !choices->empty() && choices->front().is_dict()) {
+    out.delta = StringAt(choices->front().GetDict(), "delta.content");
+  }
+  return out;
+}
