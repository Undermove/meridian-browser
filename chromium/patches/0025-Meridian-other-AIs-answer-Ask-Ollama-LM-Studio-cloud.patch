+void AiService::LocalChat(const std::string& id,
+                          const std::string& provider,
+                          const Request& request) {
+  Session* session = sessions_[id].get();
+  ai::Turn turn;
+  turn.resume = session->resume[provider];
+  // AIs that can't continue a session get the conversation so far.
+  if (turn.resume.empty() && !session->history.empty()) {
+    std::string past;
+    size_t from = session->history.size() > 12 ? session->history.size() - 12
+                                                : 0;
+    for (size_t i = from; i < session->history.size(); ++i) {
+      const auto& [role, text] = session->history[i];
+      past += (role == "user" ? "User: " : "Assistant: ") + text + "\n\n";
+    }
+    if (past.size() > 24000) {
+      past = past.substr(past.size() - 24000);
+    }
+    turn.prompt += "<conversation_so_far>\n" + Neutralize(past) +
+                   "</conversation_so_far>\n\n";
+  }
+  if (!request.page_text.empty()) {
+    constexpr size_t kLimit = 60000;
+    std::string body = Neutralize(request.page_text);
+    if (body.size() > kLimit) {
+      body = body.substr(0, kLimit) +
+             "\n[Page text truncated: showing the first part only.]";
+    }
+    turn.prompt += "<current_page url=\"" + Attr(request.page_url) +
+                   "\" title=\"" + Attr(request.page_title) + "\">\n" + body +
+                   "\n</current_page>\n\n";
+  }
+  turn.prompt += request.text;
+  turn.system = TextOnlySystem(request.mode);
+  local_->Chat(
+      id, provider, std::move(turn),
+      base::BindRepeating(
+          [](base::WeakPtr<AiService> self, std::string id,
+             std::string provider, int turn, const std::string& type,
+             const std::string& text) {
+            if (!self || !self->sessions_.contains(id)) {
+              return;
+            }
+            Session* session = self->sessions_[id].get();
+            if (session->turn != turn || session->stopped) {
+              return;
+            }
+            if (type == "session") {
+              session->resume[provider] = text;
+              return;
+            }
+            session->events.Run(type, text);
+          },
+          weak_factory_.GetWeakPtr(), id, provider, session->turn));
+}
