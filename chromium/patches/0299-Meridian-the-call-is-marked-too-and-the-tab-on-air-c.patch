+// static
+std::vector<WebContents*> TabSharingUIViews::Capturers() {
+  std::vector<WebContents*> out;
+  for (TabSharingUIViews* ui : LiveTabSharingUIs()) {
+    WebContents* capturer = WebContentsFromId(ui->capturer_);
+    if (capturer && ui->shared_tab_ && !ui->stop_callback_.is_null() &&
+        !std::ranges::contains(out, capturer)) {
+      out.push_back(capturer);
+    }
+  }
+  return out;
+}
+
+// static
+bool TabSharingUIViews::StopSharingOf(WebContents* contents) {
+  std::vector<base::WeakPtr<TabSharingUIViews>> hits;
+  for (TabSharingUIViews* ui : LiveTabSharingUIs()) {
+    if (ui->shared_tab_ == contents ||
+        WebContentsFromId(ui->capturer_) == contents) {
+      hits.push_back(ui->weak_factory_.GetWeakPtr());
+    }
+  }
+  for (const auto& ui : hits) {
+    if (ui) {
+      ui->StopSharing("Meridian sidebar: Stop sharing");
+    }
+  }
+  return !hits.empty();
+}
