+  // The monitor on the tab on air: what's shared and a way to stop; on any
+  // other tab it moves the share there (Chromium's "Share this tab instead").
   onShareClick(e: Event, tab: Tab, alreadyShared: boolean) {
     e.stopPropagation();
     if (!alreadyShared) {
       this.handler_.shareTabInstead(tab.id);
+      return;
+    }
+    this.openShareMenu_(e as MouseEvent, [
+      {label: 'Sharing this tab', header: true},
+      ...this.goToCallEntries_(),
+      {label: 'Stop sharing', icon: 'x', danger: true,
+       action: () => this.handler_.stopTabSharing(tab.id)},
+    ]);
+  }
+
+  // The call that shares a tab: which tab is on air, and a way to stop.
+  onCallClick(e: Event, tab: Tab) {
+    e.stopPropagation();
+    const shared = [...this.tabs_.values()].filter(
+        t => t.alertStates?.includes(TabAlertState.kTabCapturing));
+    this.openShareMenu_(e as MouseEvent, [
+      {label: 'Sharing a tab from this call', header: true},
+      ...shared.map(t => ({
+        label: `Show ${t.title || t.url}`,
+        icon: 'monitor' as const,
+        action: () => this.tabStripService_.activateTab(t.id),
+      })),
+      {label: 'Stop sharing', icon: 'x', danger: true,
+       action: () => this.handler_.stopTabSharing(tab.id)},
+    ]);
+  }
+
+  private goToCallEntries_(): MenuEntry[] {
+    return [...this.callTabs_].map(id => this.tabs_.get(id))
+        .filter((t): t is Tab => !!t)
+        .map(t => ({
+          label: `Back to ${t.title || t.url}`,
+          icon: 'onAir' as const,
+          action: () => this.tabStripService_.activateTab(t.id),
+        }));
+  }
+
+  // Opened under the button, like a row's own menu.
+  private openShareMenu_(e: MouseEvent, entries: MenuEntry[]) {
+    const r = (e.currentTarget as HTMLElement|null)?.getBoundingClientRect();
+    e.preventDefault();
+    this.menu_ = {x: r ? r.left : e.clientX, y: r ? r.bottom + 4 : e.clientY,
+                  entries, sel: -1, sub: null};
+  }
+
+  // The tab of a call that shares another tab right now.
+  isCallTab(tab: Tab|null): boolean {
+    return !!tab && this.callTabs_.has(tab.id);
+  }
+
+  // Which tabs share another one: asked when the tab on air changes (the
+  // call's own capture can land a moment after the shared tab's alert).
+  private refreshCallTabs_(key: string, tries = 4) {
+    if (!key) {
+      if (this.callTabs_.size) {
+        this.callTabs_ = new Set();
+        this.rev_++;
+      }
+      return;
     }
+    this.handler_.callTabs().then(({tabIds}) => {
+      if (key !== this.shareKey_) {
+        return;
+      }
+      if (!tabIds.length && tries > 1) {
+        setTimeout(() => this.refreshCallTabs_(key, tries - 1), 400);
+        return;
+      }
+      this.callTabs_ = new Set(tabIds);
+      this.rev_++;
+    });
   }
 
   // Asked when the pointer comes to a row, only during a share.
