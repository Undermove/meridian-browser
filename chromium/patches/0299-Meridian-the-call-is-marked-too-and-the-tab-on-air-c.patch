diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index 30af781d99..d74b7a8bc1 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -718,6 +718,23 @@ void SidebarHandler::CanShareTabInstead(const tabs_api::NodeId& tab_id,
                           TabSharingUIViews::CanShareInstead(tab->GetContents()));
 }
 
+void SidebarHandler::CallTabs(CallTabsCallback callback) {
+  std::vector<tabs_api::NodeId> ids;
+  for (content::WebContents* contents : TabSharingUIViews::Capturers()) {
+    if (tabs::TabInterface* tab =
+            tabs::TabInterface::MaybeGetFromContents(contents)) {
+      ids.push_back(tabs_api::NodeId::FromTabHandle(tab->GetHandle()));
+    }
+  }
+  std::move(callback).Run(std::move(ids));
+}
+
+void SidebarHandler::StopTabSharing(const tabs_api::NodeId& tab_id) {
+  if (tabs::TabInterface* tab = TabFor(tab_id)) {
+    TabSharingUIViews::StopSharingOf(tab->GetContents());
+  }
+}
