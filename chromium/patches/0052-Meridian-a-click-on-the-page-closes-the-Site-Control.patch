-  sound: 'speaker',
   clipboard: 'copy',
   downloads: 'download',
   pip: 'littleWindow',
@@ -203,6 +202,12 @@ export class MeridianSiteControlElement extends CrLitElement {
     this.refresh_();
   }
 
+  // A click on the page goes to the page's own process, so the browser never
+  // hears it; this layer over the page catches it and closes the controls.
+  protected onShieldMousedown_() {
+    this.fire('site-control-action', 'close');
+  }
+
   protected onSecurityClick_() {
     this.fire('site-control-action', 'page-info');
   }
