+std::optional<Release> ParseRelease(std::string_view json,
+                                    std::string_view arch,
+                                    bool test_feed) {
+  return ParseFor(json, arch, test_feed,
+                  {"-mac-", ".zip", "SHA256SUMS.txt", "SHA256SUMS",
