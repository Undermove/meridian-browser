+TEST(UpdateCheckTest, AWindowsReleaseIsTheInstallerWithItsOwnChecksums) {
+  static constexpr char kWindowsJson[] = R"({
+    "tag_name": "v1.2.0", "html_url": "https://example.test/page",
+    "assets": [
+      {"name": "Meridian-1.2.0-mac-arm64.zip",
+       "browser_download_url": "https://example.test/mac.zip"},
+      {"name": "SHA256SUMS.txt",
+       "browser_download_url": "https://example.test/mac-sums"},
+      {"name": "SHA256SUMS.txt.sig",
+       "browser_download_url": "https://example.test/mac-sig"},
+      {"name": "Meridian-1.2.0-win-x64-setup.exe",
+       "browser_download_url": "https://example.test/setup.exe"},
+      {"name": "SHA256SUMS-win.txt",
+       "browser_download_url": "https://example.test/win-sums"},
+      {"name": "SHA256SUMS-win.txt.sig",
+       "browser_download_url": "https://example.test/win-sig"}]})";
+  std::optional<Release> r = ParseWindowsRelease(kWindowsJson, "x64");
+  ASSERT_TRUE(r);
+  EXPECT_EQ(r->version, "1.2.0");
+  EXPECT_EQ(r->zip_name, "Meridian-1.2.0-win-x64-setup.exe");
+  EXPECT_EQ(r->zip_url, "https://example.test/setup.exe");
+  EXPECT_EQ(r->sums_url, "https://example.test/win-sums");
+  EXPECT_EQ(r->sig_url, "https://example.test/win-sig");
+  // No installer for that architecture; and the Mac's zip is still found by
+  // the Mac, with the Mac's checksums.
+  EXPECT_FALSE(ParseWindowsRelease(kWindowsJson, "arm64"));
+  std::optional<Release> mac = ParseRelease(kWindowsJson, "arm64");
+  ASSERT_TRUE(mac);
+  EXPECT_EQ(mac->sums_url, "https://example.test/mac-sums");
+  EXPECT_EQ(mac->sig_url, "https://example.test/mac-sig");
+}
+
+#if BUILDFLAG(IS_WIN)
+// The script runs for real, with a harmless program (doskey, which takes any
+// argument and succeeds) standing in for the
+// installer: it waits for a process that is gone, runs the stand-in, and
+// removes it.
+TEST(UpdateCheckTest, TheWindowsInstallScriptRunsTheInstallerAndRemovesIt) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::FilePath system;
+  ASSERT_TRUE(base::PathService::Get(base::DIR_SYSTEM, &system));
+  // A name with a space and a percent sign.
+  base::FilePath setup = dir.GetPath().AppendASCII("Meridian 100% setup.exe");
+  ASSERT_TRUE(base::CopyFile(system.AppendASCII("doskey.exe"), setup));
+  base::FilePath script = dir.GetPath().AppendASCII("update.cmd");
+  ASSERT_TRUE(base::WriteFile(
+      script, WindowsInstallScript(999999, setup, base::FilePath())));
+  base::CommandLine line(system.AppendASCII("cmd.exe"));
+  line.AppendArgNative(L"/d");
+  line.AppendArgNative(L"/c");
+  line.AppendArgPath(script);
+  std::string out;
+  ASSERT_TRUE(base::GetAppOutput(line, &out));
+  EXPECT_EQ(out.find("the installer failed"), std::string::npos) << out;
+  EXPECT_FALSE(base::PathExists(setup));
+}
+#endif
+
 }  // namespace
 }  // namespace meridian::update
