+
+// The updater on Windows (updater.cc is the macOS one; updater.h says what
+// both do). The same release feed, the same release key over the checksums;
+// what is downloaded is the installer (Meridian-<version>-win-<arch>-
+// setup.exe), and "Restart to update" quits and lets a small script run it
+// and open Meridian again. Only a copy that an installer put there updates
+// itself: a build in out/ doesn't.
+//
+// Tests: --meridian-update-feed and --meridian-test-update-key as on macOS;
+// --meridian-test-update-target=<file in the temp folder> gets a copy of the
+// downloaded installer instead of the installer being run.
+namespace meridian {
+
+namespace {
+
+constexpr base::TimeDelta kFirstCheck = base::Seconds(15);
+constexpr base::TimeDelta kEvery = base::Hours(24);
+constexpr int64_t kMaxInstaller = int64_t{2} << 30;
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("meridian_updater_win", R"(
+        semantics {
+          sender: "Meridian Updater"
+          description:
+            "Meridian asks GitHub whether a newer release exists and "
+            "downloads its installer, its checksums and their signature."
+          trigger:
+            "A little after Meridian starts, then daily, and Check for "
+            "Updates in Settings."
+          data: "Nothing about the person: plain requests for public files."
+          destination: OTHER
+          destination_other: "GitHub releases of Meridian."
+          user_data {
+            type: NONE
+          }
+          internal {
+            contacts {
+              owners: "//chrome/browser/meridian/OWNERS"
+            }
+          }
+          last_reviewed: "2026-11-15"
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "There is no setting; a build that wasn't installed "
+                   "doesn't check."
+          policy_exception_justification: "Not implemented."
+        })");
+
+const char* Arch() {
+#if defined(ARCH_CPU_ARM64)
+  return "arm64";
+#else
+  return "x64";
+#endif
+}
+
+// A stand-in GitHub (tests); it may serve over http and sign with a test key.
+bool TestFeed() {
+  return HasTestSwitch("meridian-update-feed");
+}
+
+std::string CurrentVersion() {
+  return HasTestSwitch("meridian-test-version")
+             ? TestSwitchValue("meridian-test-version")
+             : std::string(update::kVersion);
+}
+
+// Whether this copy was put here by Meridian's installer, which keeps itself
+// beside the browser's code (<version>\Installer\setup.exe): only such a copy
+// can be updated by running a newer installer. Blocking.
+bool IsInstalledCopy() {
+  base::FilePath module_dir;
+  return base::PathService::Get(base::DIR_MODULE, &module_dir) &&
+         base::PathExists(module_dir.AppendASCII("Installer")
+                              .AppendASCII("setup.exe"));
+}
+
+// Whether a test may have `target` written: a file in the temp folder.
+// Blocking.
+bool IsTestTarget(const base::FilePath& target) {
+  base::FilePath dir = RealFilePath(target.DirName());
+  base::FilePath temp;
+  if (dir.empty() || !base::GetTempDir(&temp)) {
+    return false;
+  }
+  base::FilePath real_temp = RealFilePath(temp);
+  return !real_temp.empty() && (dir == real_temp || real_temp.IsParent(dir));
+}
+
+std::unique_ptr<network::SimpleURLLoader> Request(const std::string& url) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(url);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  // Not IDLE: SimpleURLLoader would write the file at BEST_EFFORT, which
+  // waits for startup to finish.
+  request->priority = net::LOW;
+  request->headers.SetHeader("Accept", "application/vnd.github+json");
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+  loader->SetRetryOptions(
+      2, network::SimpleURLLoader::RETRY_ON_NETWORK_CHANGE |
+             network::SimpleURLLoader::RETRY_ON_5XX);
+  return loader;
+}
+
+// On a worker: whether the downloaded installer is the one the signed
+// checksums name. An error for the person, or none (the second of the pair
+// is the macOS updater's code-signing requirement; there is none here).
+std::pair<std::string, std::string> Verify(base::FilePath installer,
+                                           std::string sum) {
+  auto fail = [](std::string error) {
+    return std::make_pair(std::move(error), std::string());
+  };
+  base::File file(installer, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return fail("The download is missing.");
+  }
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+  std::vector<uint8_t> buffer(1 << 20);
+  while (true) {
+    std::optional<size_t> n = file.ReadAtCurrentPos(buffer);
+    if (!n) {
+      return fail("The download couldn’t be read.");
+    }
+    if (*n == 0) {
+      break;
+    }
+    hasher.Update(base::span(buffer).first(*n));
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  if (base::HexEncodeLower(digest) != sum) {
+    file.Close();
+    base::DeleteFile(installer);
+    return fail("The download doesn’t match the release’s checksum.");
+  }
+  return std::make_pair(std::string(), std::string());
+}
+
+}  // namespace
+
+// static
+Updater& Updater::Get() {
+  static base::NoDestructor<Updater> updater;
+  return *updater;
+}
+
+Updater::Updater() = default;
+Updater::~Updater() = default;
+
+void Updater::Start() {
+  if (started_) {
+    return;
+  }
+  started_ = true;
+  base::PathService::Get(chrome::DIR_USER_DATA, &dir_);
+  dir_ = dir_.AppendASCII("Meridian Update");
+  // The browser to open again after the update.
+  base::PathService::Get(base::FILE_EXE, &bundle_);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath test_target, base::FilePath dir) {
+            base::CreateDirectory(dir);
+            Located located;
+            // (`is_signed` is the macOS word for "a release, not a build in
+            // out/".)
+            located.is_signed = IsInstalledCopy();
+            located.in_place = located.is_signed;
+            if (!test_target.empty()) {
+              if (!IsTestTarget(test_target)) {
+                LOG(WARNING) << "Meridian update: the test target isn’t in "
+                                "the temp folder";
+                return located;
+              }
+              located.test_target = true;
+              located.in_place = true;
+            }
+            return located;
+          },
+          TestSwitchPath("meridian-test-update-target"), dir_),
+      base::BindOnce(&Updater::OnLocated, weak_factory_.GetWeakPtr()));
+}
+
+void Updater::OnLocated(Located located) {
+  in_place_ = located.in_place;
+  test_target_ = located.test_target;
+  located_ = true;
+  if (user_check_) {
+    Check();
+  }
+  if (!located.is_signed && !TestFeed()) {
+    return;
+  }
+  first_.Start(FROM_HERE, TestFeed() ? base::TimeDelta() : kFirstCheck,
+               base::BindOnce(&Updater::Check, weak_factory_.GetWeakPtr()));
+  timer_.Start(FROM_HERE, kEvery,
+               base::BindRepeating(&Updater::Check,
+                                   weak_factory_.GetWeakPtr()));
+}
+
+void Updater::CheckNow() {
+  user_check_ = true;
+  Start();
+  if (located_) {
+    Check();
+  }
+}
+
+void Updater::Check() {
+  // Busy, or already waiting for a restart.
+  if (status_ == mojom::UpdateStatus::kChecking ||
+      status_ == mojom::UpdateStatus::kDownloading ||
+      status_ == mojom::UpdateStatus::kReady) {
+    return;
+  }
+  std::string feed =
+      TestFeed() ? TestSwitchValue("meridian-update-feed") : update::kFeed;
+  Set(mojom::UpdateStatus::kChecking);
+  loader_ = Request(feed);
+  loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&Updater::OnFeed, weak_factory_.GetWeakPtr()), 1 << 20);
+}
+
+void Updater::OnFeed(std::optional<std::string> body) {
+  loader_.reset();
+  bool user = std::exchange(user_check_, false);
+  if (!body) {
+    Set(user ? mojom::UpdateStatus::kFailed : mojom::UpdateStatus::kIdle,
+        "Couldn’t reach GitHub to check for updates.");
+    return;
+  }
+  std::optional<update::Release> release =
+      update::ParseWindowsRelease(*body, Arch(), TestFeed());
+  if (!release || !update::IsNewer(release->version, CurrentVersion())) {
+    Set(mojom::UpdateStatus::kUpToDate);
+    return;
+  }
+  release_ = *release;
+  if (!in_place_) {
+    // A build that wasn't installed: the release page has the installer.
+    Set(mojom::UpdateStatus::kAvailable);
+    return;
+  }
+  progress_ = 0;
+  zip_size_ = 0;
+  Set(mojom::UpdateStatus::kDownloading);
+  loader_ = Request(release_.zip_url);
+  loader_->SetOnResponseStartedCallback(base::BindOnce(
+      [](Updater* self, const GURL&,
+         const network::mojom::URLResponseHead& head) {
+        self->zip_size_ = head.content_length;
+      },
+      base::Unretained(this)));
+  loader_->SetOnDownloadProgressCallback(base::BindRepeating(
+      [](Updater* self, uint64_t current) {
+        if (self->zip_size_ > 0) {
+          double progress = static_cast<double>(current) / self->zip_size_;
+          // A few updates are enough.
+          if (progress - self->progress_ >= 0.02 || progress >= 1) {
+            self->progress_ = progress;
+            self->observers_.Notify(&Observer::OnUpdateStateChanged);
+          }
+        }
+      },
+      base::Unretained(this)));
+  // (`zip_` and `OnZip` are the macOS names; here it is the installer.)
+  loader_->DownloadToFile(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&Updater::OnZip, weak_factory_.GetWeakPtr()),
+      dir_.AppendUTF8(release_.zip_name), kMaxInstaller);
+}
+
+void Updater::OnZip(base::FilePath path) {
+  bool ok = loader_ && loader_->NetError() == net::OK && !path.empty();
+  loader_.reset();
+  if (!ok) {
+    Set(mojom::UpdateStatus::kFailed, "The update didn’t download.");
+    return;
+  }
+  zip_ = path;
+  loader_ = Request(release_.sums_url);
+  loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&Updater::OnSums, weak_factory_.GetWeakPtr()), 64 << 10);
+}
+
+void Updater::OnSums(std::optional<std::string> body) {
+  loader_.reset();
+  if (!body) {
+    Set(mojom::UpdateStatus::kFailed,
+        "The release has no checksum for Windows.");
+    return;
+  }
+  sums_ = std::move(*body);
+  if (release_.sig_url.empty()) {
+    Set(mojom::UpdateStatus::kFailed,
+        "The release’s checksums aren’t signed by Meridian.");
+    return;
+  }
+  loader_ = Request(release_.sig_url);
+  loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&Updater::OnSig, weak_factory_.GetWeakPtr()), 4 << 10);
+}
+
+void Updater::OnSig(std::optional<std::string> body) {
+  loader_.reset();
+  // No checksum is trusted before the signature over all of them is.
+  std::array<uint8_t, 32> key = update::kReleaseKey;
+  if (TestFeed()) {
+    if (std::optional<std::array<uint8_t, 32>> test_key =
+            update::ParsePublicKey(
+                TestSwitchValue("meridian-test-update-key"))) {
+      key = *test_key;
+    }
+  }
+  if (!body || !update::SumsSignedBy(sums_, *body, key)) {
+    Set(mojom::UpdateStatus::kFailed,
+        "The release’s checksums aren’t signed by Meridian.");
+    return;
+  }
+  std::optional<std::string> sum = update::FindSum(sums_, release_.zip_name);
+  if (!sum) {
+    Set(mojom::UpdateStatus::kFailed,
+        "The release has no checksum for Windows.");
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&Verify, zip_, *sum),
+      base::BindOnce(&Updater::OnStaged, weak_factory_.GetWeakPtr()));
+}
+
+void Updater::OnStaged(
+    std::pair<std::string, std::string> error_and_requirement) {
+  const std::string& error = error_and_requirement.first;
+  if (!error.empty()) {
+    LOG(WARNING) << "Meridian update " << release_.version << ": " << error;
+    Set(mojom::UpdateStatus::kFailed, error);
+    return;
+  }
+  Set(mojom::UpdateStatus::kReady);
+}
+
+bool Updater::Install() {
+  if (status_ != mojom::UpdateStatus::kReady) {
+    return false;
+  }
+  const int pid = static_cast<int>(base::Process::Current().Pid());
+  std::string script;
+  if (test_target_) {
+    // A test: the installer isn't run, a copy of it lands where the test
+    // said.
+    base::FilePath target = TestSwitchPath("meridian-test-update-target");
+    // Once Meridian has quit, as the real script does.
+    const std::string id = base::NumberToString(pid);
+    script = "@echo off\r\nchcp 65001 >nul\r\n:wait\r\n"
+             "tasklist /fi \"PID eq " +
+             id + "\" 2>nul | find \" " + id +
+             " \" >nul && (ping -n 2 127.0.0.1 >nul & goto wait)\r\n"
+             "copy /y \"" +
+             zip_.AsUTF8Unsafe() + "\" \"" + target.AsUTF8Unsafe() +
+             "\" >nul\r\n";
+  } else {
+    script = update::WindowsInstallScript(pid, zip_, bundle_);
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(
+          [](base::FilePath dir, std::string script) {
+            base::FilePath path = dir.AppendASCII("update.cmd");
+            base::FilePath cmd;
+            if (!base::WriteFile(path, script) ||
+                !base::PathService::Get(base::DIR_SYSTEM, &cmd)) {
+              return false;
+            }
+            base::CommandLine line(cmd.AppendASCII("cmd.exe"));
+            line.AppendArgNative(L"/d");
+            line.AppendArgNative(L"/c");
+            line.AppendArgPath(path);
+            base::LaunchOptions options;
+            // No console window; the script outlives Meridian.
+            options.start_hidden = true;
+            return base::LaunchProcess(line, options).IsValid();
+          },
+          dir_, std::move(script)),
+      base::BindOnce(
+          [](base::WeakPtr<Updater> self, bool started) {
+            if (!started) {
+              if (self) {
+                self->Set(mojom::UpdateStatus::kFailed,
+                          "Couldn’t start the update.");
+              }
+              return;
+            }
+            // Quit as from the menu: the session is saved and comes back in
+            // the new version.
+            chrome::AttemptExit();
+          },
+          weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+mojom::UpdateStatePtr Updater::State() const {
+  auto state = mojom::UpdateState::New();
+  state->status = status_;
+  state->current = CurrentVersion();
+  state->version = release_.version;
+  state->progress = progress_;
+  state->error = error_;
+  state->page_url = release_.page_url;
+  return state;
+}
+
+void Updater::Set(mojom::UpdateStatus status, std::string error) {
+  status_ = status;
+  error_ = std::move(error);
+  observers_.Notify(&Observer::OnUpdateStateChanged);
+}
+
+void Updater::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void Updater::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
