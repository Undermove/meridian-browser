+std::optional<Release> ParseWindowsRelease(std::string_view json,
+                                           std::string_view arch,
+                                           bool test_feed) {
+  return ParseFor(json, arch, test_feed,
+                  {"-win-", "-setup.exe", "SHA256SUMS-win.txt",
+                   "SHA256SUMS-win.txt", "SHA256SUMS-win.txt.sig"});
+}
