+std::string WindowsInstallScript(int pid,
+                                 const base::FilePath& setup,
+                                 const base::FilePath& browser) {
+  // Paths in double quotes: a Windows file name has none in it, and "%" (the
+  // one thing cmd would still expand inside quotes) is doubled.
+  auto quoted = [](const base::FilePath& path) {
+    std::string text = path.AsUTF8Unsafe();
+    base::ReplaceSubstringsAfterOffset(&text, 0, "%", "%%");
+    return "\"" + text + "\"";
+  };
+  const std::string id = base::NumberToString(pid);
+  std::string script =
+      "@echo off\r\n"
+      "chcp 65001 >nul\r\n"
+      // ping is the wait that works without a console.
+      ":wait\r\n"
+      "tasklist /fi \"PID eq " + id + "\" 2>nul | find \" " + id +
+      " \" >nul && (ping -n 2 127.0.0.1 >nul & goto wait)\r\n"
+      "set tries=0\r\n"
+      ":install\r\n"
+      "ping -n 3 127.0.0.1 >nul\r\n" +
+      quoted(setup) +
+      " --do-not-launch-chrome\r\n"
+      "if not errorlevel 1 goto done\r\n"
+      "set /a tries+=1\r\n"
+      "if %tries% lss 5 goto install\r\n"
+      "echo the installer failed\r\n"
+      ":done\r\n";
+  if (!browser.empty()) {
+    script += "start \"\" " + quoted(browser) + "\r\n";
+  }
+  script += "del " + quoted(setup) + "\r\n";
+  return script;
+}
