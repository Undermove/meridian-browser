+// What a CLI may keep using under a closed home folder: its own settings,
+// sign-in and caches.
+std::vector<base::FilePath> CliOwnFolders(
+    const std::string& id,
+    const base::FilePath& home,
+    const std::map<std::string, std::string>& env) {
+  static const base::NoDestructor<
+      std::map<std::string, std::vector<const char*>>>
+      kFolders({
+          {"codex", {".codex"}},
+          {"copilot",
+           {".copilot", ".config/github-copilot", "Library/Caches/copilot"}},
+          {"opencode",
+           {".config/opencode", ".local/share/opencode",
+            ".local/state/opencode", ".cache/opencode"}},
+          {"cursor", {".cursor", ".config/cursor"}},
+          {"qwen", {".qwen"}},
+          {"droid", {".factory"}},
+          {"goose",
+           {".config/goose", ".local/share/goose", ".local/state/goose"}},
+          {"amp", {".config/amp", ".local/share/amp", ".cache/amp"}},
+      });
+  std::vector<base::FilePath> out;
+  if (auto it = kFolders->find(id); it != kFolders->end()) {
+    for (const char* path : it->second) {
+      out.push_back(home.AppendASCII(path));
+    }
+  }
+  if (auto it = env.find("CODEX_HOME");
+      id == "codex" && it != env.end() && !it->second.empty()) {
+    out.push_back(base::FilePath::FromUTF8Unsafe(it->second));
+  }
+  return out;
+}
+
+// Where command-line tools are installed under the home folder, and the CLI
+// itself wherever it is: read only.
+std::vector<base::FilePath> CliToolFolders(const base::FilePath& home,
+                                           const std::string& bin) {
+  std::vector<base::FilePath> out;
+  for (const char* path : {".local/bin", ".local/lib", ".nvm", ".volta", ".bun",
+                           ".npm-global", ".asdf", ".fnm", ".pyenv",
+                           ".cargo/bin"}) {
+    out.push_back(home.AppendASCII(path));
+  }
+  const base::FilePath real = RealFilePath(base::FilePath::FromUTF8Unsafe(bin));
+  if (home.IsParent(real) && real.DirName() != home) {
+    out.push_back(real.DirName());
+  }
+  return out;
+}
