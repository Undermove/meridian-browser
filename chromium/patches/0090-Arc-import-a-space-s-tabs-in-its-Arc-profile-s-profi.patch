+void SidebarHandler::RehomeTabs() {
+  if (!HoldsSpaceTabs(browser_)) {
+    return;
+  }
+  std::vector<content::WebContents*> strays;
+  for (int i = 0; i < model()->count(); ++i) {
+    tabs::TabInterface* tab = model()->GetTabAtIndex(i);
+    const TabData* data = TabData::Get(tab->GetContents());
+    const Space* space = data ? service_->FindSpace(data->space_id()) : nullptr;
+    if (space && !tab->GetSplit() &&
+        space->profile != ProfileIdOf(Profile::FromBrowserContext(
+                              tab->GetContents()->GetBrowserContext()))) {
+      strays.push_back(tab->GetContents());
+    }
+  }
+  for (content::WebContents* old : strays) {
+    int index = model()->GetIndexOfWebContents(old);
+    const TabData* data = TabData::Get(old);
+    const Space* space = service_->FindSpace(data->space_id());
+    content::NavigationController& history = old->GetController();
+    std::vector<sessions::SerializedNavigationEntry> entries;
+    for (int i = 0; i < history.GetEntryCount(); ++i) {
+      entries.push_back(
+          sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+              i, history.GetEntryAtIndex(i)));
+    }
+    if (index == TabStripModel::kNoTab || !space || entries.empty()) {
+      continue;
+    }
+    std::string space_id = data->space_id();
+    std::string item_id = data->item_id();
+    bool active = model()->GetActiveWebContents() == old;
+    // The same page, its history kept, loaded when opened (a page can't
+    // change profiles: it is signed in as that profile is).
+    content::WebContents* made = chrome::AddRestoredTab(
+        browser_, entries, index + 1,
+        std::max(history.GetCurrentEntryIndex(), 0),
+        /*extension_app_id=*/std::string(), /*group=*/std::nullopt, active,
+        /*pin=*/false, base::TimeTicks::Now(), base::Time::Now(),
+        /*session_storage_namespace=*/nullptr,
+        sessions::SerializedUserAgentOverride(),
+        TabData::ExtraDataFor(space_id, space->profile),
+        /*from_session_restore=*/false, /*is_active_browser=*/std::nullopt);
+    if (!made) {
+      continue;
+    }
+    TabData::Set(made, space_id, item_id);
+    rehoming_ = old;
+    model()->DetachAndDeleteWebContentsAt(model()->GetIndexOfWebContents(old));
+    rehoming_ = nullptr;
+  }
+}
