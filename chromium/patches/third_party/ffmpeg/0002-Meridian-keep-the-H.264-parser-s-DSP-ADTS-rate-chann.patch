From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 9 Nov 2026 02:42:07 +0400
Subject: [PATCH 2/2] Meridian: keep the H.264 parser's DSP; ADTS rate,
 channels and frame length

The H.264 parser finds start codes with h264dsp (and h264idct), so they
stay. With no AAC decoder to fill them in, the AAC parser takes a raw
ADTS file's sample rate, channels and frame length from its headers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 BUILD.gn                    | 14 ++++++++++----
 libavcodec/aac_ac3_parser.c | 11 +++++++++++
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/BUILD.gn b/BUILD.gn
index f27d4a6..f0938e6 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -18,13 +18,19 @@ if (is_mac && ffmpeg_branding == "Chrome") {
     "*/h264_refs.c",
     "*/h264_slice.c",
     "*/h264dec.c",
-    "*/h264dsp.c",
-    "*/h264idct.c",
     "*/h264pred.c",
     "*/h264qpel.c",
     "*/h264chroma.c",
-    "*/aarch64/*h264*",
-    "*/x86/*h264*",
+    "*/aarch64/*h264cmc*",
+    "*/aarch64/*h264chroma*",
+    "*/aarch64/*h264pred*",
+    "*/aarch64/*h264qpel*",
+    "*/x86/*h264_chromamc*",
+    "*/x86/*h264chroma*",
+    "*/x86/*h264_intrapred*",
+    "*/x86/*h264_qpel*",
+
+    # (h264dsp and h264idct stay: the H.264 parser finds start codes with them.)
 
     # AAC
     "*/aac/aacdec*.c",
diff --git a/libavcodec/aac_ac3_parser.c b/libavcodec/aac_ac3_parser.c
index 51c8012..c7fb621 100644
--- a/libavcodec/aac_ac3_parser.c
+++ b/libavcodec/aac_ac3_parser.c
@@ -157,6 +157,17 @@ get_next:
             /* ADTS does not support USAC */
             s1->key_frame = 1;
             bit_rate = hdr.bit_rate;
+#if !CONFIG_AAC_DECODER
+            /* Meridian: no AAC decoder fills these in (macOS decodes AAC), so
+               the ADTS header's (the AAC core's, for HE-AAC) are the ones. */
+            if (!avctx->sample_rate)
+                avctx->sample_rate = hdr.sample_rate;
+            if (!avctx->ch_layout.nb_channels && hdr.chan_config)
+                av_channel_layout_default(&avctx->ch_layout,
+                                          hdr.chan_config == 7 ? 8 : hdr.chan_config);
+            /* and each frame's length, which its timestamps come from */
+            s1->duration = hdr.samples;
+#endif
 #endif
         }
 
