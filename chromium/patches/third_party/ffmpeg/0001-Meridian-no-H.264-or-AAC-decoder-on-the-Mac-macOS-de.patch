From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 9 Nov 2026 02:06:16 +0400
Subject: [PATCH 1/2] Meridian: no H.264 or AAC decoder on the Mac; macOS
 decodes them

The Chrome configuration (MP4 demuxer, H.264 and AAC parsers) without
FFmpeg's H.264 and AAC decoders: VideoToolbox and AudioToolbox decode
them, under Apple's licences, as in Firefox.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 BUILD.gn                                      | 46 +++++++++++++++++++
 .../Chrome/mac/arm64/config_components.h      |  4 +-
 .../Chrome/mac/arm64/libavcodec/codec_list.c  |  2 -
 .../config/Chrome/mac/x64/config_components.h |  4 +-
 .../Chrome/mac/x64/libavcodec/codec_list.c    |  2 -
 5 files changed, 50 insertions(+), 8 deletions(-)

diff --git a/BUILD.gn b/BUILD.gn
index a00ce51..f27d4a6 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -3,6 +3,52 @@
 # found in the LICENSE file.
 
 import("ffmpeg_generated.gni")
+
+# Meridian: on the Mac, H.264 and AAC are decoded by macOS (VideoToolbox, AudioToolbox), so this
+# FFmpeg ships without its own H.264 and AAC decoders; it keeps their parsers and the MP4 demuxer.
+if (is_mac && ffmpeg_branding == "Chrome") {
+  _system_decoded = [
+    # H.264
+    "*/h264_cabac.c",
+    "*/h264_cavlc.c",
+    "*/h264_direct.c",
+    "*/h264_loopfilter.c",
+    "*/h264_mb.c",
+    "*/h264_picture.c",
+    "*/h264_refs.c",
+    "*/h264_slice.c",
+    "*/h264dec.c",
+    "*/h264dsp.c",
+    "*/h264idct.c",
+    "*/h264pred.c",
+    "*/h264qpel.c",
+    "*/h264chroma.c",
+    "*/aarch64/*h264*",
+    "*/x86/*h264*",
+
+    # AAC
+    "*/aac/aacdec*.c",
+    "*/aacps_common.c",
+    "*/aacps_float.c",
+    "*/aacpsdsp_float.c",
+    "*/aacsbr.c",
+    "*/sbrdsp.c",
+    "*/aarch64/*aacpsdsp*",
+    "*/aarch64/*sbrdsp*",
+    "*/x86/*aacpsdsp*",
+    "*/x86/*sbrdsp*",
+  ]
+  _kept_c = filter_exclude(ffmpeg_c_sources, _system_decoded)
+  ffmpeg_c_sources = []
+  ffmpeg_c_sources = _kept_c
+  _kept_gas = filter_exclude(ffmpeg_gas_sources, _system_decoded)
+  ffmpeg_gas_sources = []
+  ffmpeg_gas_sources = _kept_gas
+  _kept_asm = filter_exclude(ffmpeg_asm_sources, _system_decoded)
+  ffmpeg_asm_sources = []
+  ffmpeg_asm_sources = _kept_asm
+}
+
 import("ffmpeg_options.gni")
 
 import("//build/buildflag_header.gni")
