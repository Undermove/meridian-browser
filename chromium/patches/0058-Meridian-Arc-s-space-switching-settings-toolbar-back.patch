+// `a` and `b` (#rrggbb) blended, `t` of the way to `b`.
+function mixColor(a: string, b: string, t: number): string {
+  const rgb = (c: string) => /^#[0-9a-f]{6}$/i.test(c) ?
+      [1, 3, 5].map(i => parseInt(c.slice(i, i + 2), 16)) :
+      null;
+  const x = rgb(a);
+  const y = rgb(b);
+  if (!x || !y) {
+    return t < 0.5 ? a : b;
+  }
+  return '#' +
+      x.map((v, i) => Math.round(v + (y[i]! - v) * t)
+                          .toString(16)
+                          .padStart(2, '0'))
+          .join('');
