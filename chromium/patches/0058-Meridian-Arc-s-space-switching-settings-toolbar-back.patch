+  // Meridian: where the arrow shows over the WebUI browser frame.
+  MeridianHistoryOverlayHost* __strong _historyOverlayHost;
 }
 
 - (instancetype)initWithRenderWidgetHost:
@@ -167,8 +182,36 @@
   return !swiping_control || swiping_control->ShouldAllowHistorySwiping();
 }
 
+// Meridian: over the WebUI browser frame the arrow comes in at the edge of the
+// active tab's page, not of the window (over the sidebar).
 - (NSView*)viewThatWantsHistoryOverlay {
-  return self.nsView;
+  NSView* view = self.nsView;
+  content::WebContents* page =
+      view.window ? [self historyWebContentsOnWindow:view.window] : nullptr;
+  content::RenderWidgetHostView* pageView =
+      page && page != self.webContents ? page->GetRenderWidgetHostView()
+                                       : nullptr;
+  if (!pageView) {
+    return view;
+  }
+  NSRect rect = [view
+      convertRect:[view.window convertRectFromScreen:gfx::ScreenRectToNSRect(
+                                                         pageView->GetViewBounds())]
+         fromView:nil];
+  rect = NSIntersectionRect(rect, view.bounds);
+  if (NSIsEmptyRect(rect) || NSEqualRects(rect, view.bounds)) {
+    return view;
+  }
+  if (!_historyOverlayHost) {
+    _historyOverlayHost = [[MeridianHistoryOverlayHost alloc] init];
+    _historyOverlayHost.wantsLayer = YES;
+    _historyOverlayHost.clipsToBounds = YES;
+  }
+  _historyOverlayHost.frame = rect;
+  if (_historyOverlayHost.superview != view) {
+    [view addSubview:_historyOverlayHost];
+  }
+  return _historyOverlayHost;
 }
 
