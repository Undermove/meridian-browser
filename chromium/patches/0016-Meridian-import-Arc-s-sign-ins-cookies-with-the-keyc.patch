+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <Security/Security.h>
+
+#include "chrome/browser/meridian/arc_logins.h"
+#include "crypto/apple/keychain_v2.h"
+#include "third_party/boringssl/src/include/openssl/mem.h"
+
+namespace meridian::internal {
+
+std::string ReadArcKeychainPassword(std::string* error) {
+  auto result = crypto::apple::KeychainV2::GetInstance().FindGenericPassword(
+      "Arc Safe Storage", "Arc");
+  if (!result.has_value()) {
+    *error = result.error() == errSecItemNotFound ? "not-found" : "denied";
+    return std::string();
+  }
+  std::string password(result->begin(), result->end());
+  OPENSSL_cleanse(result->data(), result->size());
+  if (password.empty()) {
+    *error = "denied";
+  }
+  return password;
+}
+
+}  // namespace meridian::internal
