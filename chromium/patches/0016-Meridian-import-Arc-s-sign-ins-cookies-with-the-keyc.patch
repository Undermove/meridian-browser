+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_ARC_LOGINS_H_
+#define CHROME_BROWSER_MERIDIAN_ARC_LOGINS_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+
+class Profile;
+
+namespace meridian {
+
+// Brings Arc's cookies (the sites you're signed in to) into this profile, so
+// you stay signed in. macOS only.
+//
+// Arc is Chromium: each profile folder in Arc's "User Data" has a Cookies
+// database whose values are encrypted with a key derived from the
+// "Arc Safe Storage" password in the login keychain:
+//   key   = PBKDF2-HMAC-SHA1(password, "saltysalt", 1003 iterations, 16 bytes)
+//   value = "v10" + AES-128-CBC(key, IV = 16 spaces)
+//   meta.version >= 24: the plaintext starts with SHA256(host_key), stripped.
+// Reading the password makes macOS ask the person first.
+//
+// Nothing leaves the machine and Arc is never written to: each database is
+// copied to a private temp folder, read, and the copy deleted. Cookie values
+// and the key are never logged. Arc's other profiles are folded into this one;
+// the first profile wins when two have the same cookie.
+struct ArcLoginsResult {
+  int imported = 0;
+  int failed = 0;
+  // Empty on success, else "no-data", "not-found" (no key in the keychain),
+  // "denied" (the person said no) or "read".
+  std::string error;
+};
+
+// Whether Arc's cookie databases are there (blocking: file IO).
+bool ArcLoginsAvailable();
+
+void ImportArcLogins(Profile* profile,
+                     base::OnceCallback<void(ArcLoginsResult)> done);
+
+namespace internal {
+// macOS: "Arc Safe Storage" from the login keychain (macOS asks first);
+// empty with `error` set if it isn't there or the person said no.
+std::string ReadArcKeychainPassword(std::string* error);
+}  // namespace internal
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_ARC_LOGINS_H_
