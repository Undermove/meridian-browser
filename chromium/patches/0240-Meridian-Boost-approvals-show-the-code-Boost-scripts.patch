From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 23 Nov 2026 23:53:11 +0400
Subject: [PATCH 240/297] Meridian: Boost approvals show the code; Boost
 scripts run on their own

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../browser/meridian/agent/agent_service.cc   | 22 ++++++++++++++++++-
 .../meridian/boosts/boost_tab_helper.cc       | 15 ++++++-------
 chrome/common/chrome_isolated_world_ids.h     |  3 +++
 3 files changed, 31 insertions(+), 9 deletions(-)

diff --git a/chrome/browser/meridian/agent/agent_service.cc b/chrome/browser/meridian/agent/agent_service.cc
index 1d32843dc6..ef3bf76b13 100644
--- a/chrome/browser/meridian/agent/agent_service.cc
+++ b/chrome/browser/meridian/agent/agent_service.cc
@@ -2184,7 +2184,27 @@ void AgentService::SetBoost(std::unique_ptr<Call> call) {
         "allow JavaScript in Settings > AI.");
   }
   bool remove = call->input.FindBool("remove").value_or(false);
-  std::string summary = (remove ? "Remove the boost of " : "Boost ") + host;
+  std::string summary = (remove ? "Remove the boost of " : "Boost ") + host +
+                        " and its subdomains";
+  if (!remove) {
+    // What will stay on the site, as it is: the person approves this code.
+    const auto show = [&](const char* key, const char* title) {
+      const std::string* code = call->Str(key);
+      if (!code || code->empty()) {
+        return;
+      }
+      constexpr size_t kShown = 1200;
+      std::string shown;
+      base::TruncateUTF8ToByteSize(*code, kShown, &shown);
+      summary += std::string("\n\n") + title + ":\n" + shown;
+      if (shown.size() < code->size()) {
+        summary += "\n… and " + base::NumberToString(code->size() - shown.size()) +
+                   " more characters";
+      }
+    };
+    show("css", "CSS on every page of the site");
+    show("js", "JavaScript on every page of the site");
+  }
   Confirm(
       std::move(call), summary,
       base::BindOnce(
diff --git a/chrome/browser/meridian/boosts/boost_tab_helper.cc b/chrome/browser/meridian/boosts/boost_tab_helper.cc
index 122149a87d..ee8b14e2bb 100644
--- a/chrome/browser/meridian/boosts/boost_tab_helper.cc
+++ b/chrome/browser/meridian/boosts/boost_tab_helper.cc
@@ -477,14 +477,13 @@ void BoostTabHelper::DOMContentLoaded(content::RenderFrameHost* frame) {
     if (boost->js.empty()) {
       continue;
     }
-    RunInFrame(frame,
-               "(() => { try {\n" + boost->js +
-                   "\n} catch (e) { console.error('Boost " +
-                   base::WriteJson(base::Value(boost->name))
-                       .value_or("")
-                       .substr(0, 60) +
-                   ":', e); } })();",
-               base::NullCallback());
+    frame->ExecuteJavaScriptInIsolatedWorld(
+        base::UTF8ToUTF16(
+            "(() => { try {\n" + boost->js +
+            "\n} catch (e) { console.error('Boost " +
+            base::WriteJson(base::Value(boost->name)).value_or("").substr(0, 60) +
+            ":', e); } })();"),
+        base::NullCallback(), ISOLATED_WORLD_ID_MERIDIAN_BOOST);
   }
 }
 
diff --git a/chrome/common/chrome_isolated_world_ids.h b/chrome/common/chrome_isolated_world_ids.h
index a095f3c9f5..654e486b7c 100644
--- a/chrome/common/chrome_isolated_world_ids.h
+++ b/chrome/common/chrome_isolated_world_ids.h
@@ -25,6 +25,9 @@ enum ChromeIsolatedWorldIDs {
   // Isolated world ID for Chrome Actor.
   ISOLATED_WORLD_ID_ACTOR,
 
+  // Meridian: a Boost's own JavaScript, apart from Meridian's page helpers.
+  ISOLATED_WORLD_ID_MERIDIAN_BOOST,
+
 #if BUILDFLAG(IS_MAC)
   // Isolated world ID for AppleScript.
   ISOLATED_WORLD_ID_APPLESCRIPT,
