+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_WEBUI_BROWSER_FRAME_VIEW_WIN_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_WEBUI_BROWSER_FRAME_VIEW_WIN_H_
+
+#include "base/memory/raw_ptr.h"
+#include "ui/views/window/frame_view.h"
+
+namespace views {
+class Widget;
+}
+
+// Meridian, Windows: the browser window without a title bar. The page that is
+// the window's UI (chrome://webui-browser) reaches every edge and draws the
+// top bar itself, the caption buttons included, as the macOS window does
+// under its transparent title bar (webui_browser_window_mac.mm).
+//
+// This frame draws nothing. It leaves the whole window to the client view
+// and answers Windows's hit tests: the edges resize, and the rest is the
+// client view's, which says where the window is dragged by (the page's
+// `app-region: drag` areas).
+class WebUIBrowserFrameViewWin : public views::FrameView {
+ public:
+  explicit WebUIBrowserFrameViewWin(views::Widget* widget);
+  WebUIBrowserFrameViewWin(const WebUIBrowserFrameViewWin&) = delete;
+  WebUIBrowserFrameViewWin& operator=(const WebUIBrowserFrameViewWin&) = delete;
+  ~WebUIBrowserFrameViewWin() override;
+
+  // views::FrameView:
+  gfx::Rect GetBoundsForClientView() const override;
+  gfx::Rect GetWindowBoundsForClientBounds(
+      const gfx::Rect& client_bounds) const override;
+  int NonClientHitTest(const gfx::Point& point) override;
+
+ private:
+  const raw_ptr<views::Widget> widget_;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_BROWSER_WEBUI_BROWSER_FRAME_VIEW_WIN_H_
