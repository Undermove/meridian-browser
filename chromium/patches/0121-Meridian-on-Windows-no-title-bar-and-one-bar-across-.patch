diff --git a/chrome/browser/resources/webui_browser/app.css b/chrome/browser/resources/webui_browser/app.css
index 9164b5f149..35d2a488aa 100644
--- a/chrome/browser/resources/webui_browser/app.css
+++ b/chrome/browser/resources/webui_browser/app.css
@@ -720,3 +720,111 @@ cr-icon-button[hidden] {
   border-radius: 0;
   box-shadow: none;
 }
+
+/* Windows: one bar across the top of the window (app.html.ts), as Arc has
+ * there. The window has no title bar of Windows's own, so this bar is what
+ * it is dragged by, and the caption buttons are its right end. */
+:host([os-win]) #rootContainer {
+  position: relative;
+  box-sizing: border-box;
+  padding-top: 38px;
+}
+
+#winTopBar {
+  display: none;
+}
+
+:host([os-win]) #winTopBar {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  z-index: 16;
+  height: 38px;
+  display: flex;
+  align-items: center;
+  app-region: drag;
+  -webkit-app-region: drag;
+}
+
+/* As wide as the sidebar: the menu and Hide Sidebar at its left, Back,
+ * Forward and Reload at its right edge. */
+#winTopLeft {
+  box-sizing: border-box;
+  width: var(--meridian-sidebar-w);
+  flex: none;
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  padding: 0 8px 0 10px;
+}
+
+#winTopBar cr-icon-button {
+  app-region: no-drag;
+  -webkit-app-region: no-drag;
+}
+
+#winTopCenter {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  justify-content: center;
+}
+
+#winTopBar #urlPill {
+  width: min(440px, 100%);
+  height: 28px;
+  margin-bottom: 0;
+}
+
+#winTopBar .win-caption {
+  flex: none;
+  display: flex;
+  align-self: stretch;
+  margin-left: 8px;
+}
+
+.win-cap {
+  width: 46px;
+  height: 100%;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--meridian-text);
+  app-region: no-drag;
+  -webkit-app-region: no-drag;
+}
+
+.win-cap:hover {
+  background: var(--meridian-row-hover);
+}
+
+.win-cap.win-close:hover {
+  background: #c42b1c;
+  color: #fff;
+}
+
+/* The sidebar's top row, now in the bar: no room kept for macOS's traffic
+ * lights, and the bar is the drag area. */
+:host([os-win]) #sidebarTop {
+  flex: 1;
+  padding-left: 0;
+  margin-bottom: 0;
+}
+
+:host([os-win]) #sidebar {
+  padding-top: 2px;
+}
+
+:host([os-win]) #main {
+  padding-top: 0;
+}
+
+/* A Little Window keeps its own compact layout: only the caption buttons. */
+:host([os-win][little]) #winTopLeft,
+:host([os-win][little]) #winTopCenter {
+  visibility: hidden;
+}
