+namespace meridian {
+
+namespace {
+
+constexpr size_t kMaxItems = 5000;
+constexpr int64_t kMaxFile = 64 * 1024 * 1024;
+
+std::optional<base::DictValue> ReadJson(const base::FilePath& file) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(file, &text, kMaxFile)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> v =
+      base::JSONReader::Read(text, base::JSON_ALLOW_TRAILING_COMMAS);
+  if (!v || !v->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(*v).TakeDict();
+}
+
+void Convert(const base::ListValue& children,
+             int depth,
+             size_t& count,
+             std::vector<Item>& out) {
+  for (const base::Value& v : children) {
+    if (!v.is_dict() || count >= kMaxItems) {
+      continue;
+    }
+    const base::DictValue& node = v.GetDict();
+    const std::string* type = node.FindString("type");
+    const std::string* name = node.FindString("name");
+    if (type && *type == "url") {
+      const std::string* url = node.FindString("url");
+      GURL gurl = url ? GURL(*url) : GURL();
+      // Web pages only: no javascript: bookmarklets, chrome: or file: links.
+      if (!gurl.is_valid() || !gurl.SchemeIsHTTPOrHTTPS()) {
+        continue;
+      }
+      Item item;
+      item.url = gurl;
+      item.title = name && !name->empty() ? *name : gurl.spec();
+      ++count;
+      out.push_back(std::move(item));
+    } else if (type && *type == "folder" && depth < 32) {
+      const base::ListValue* kids = node.FindList("children");
+      Item folder;
+      folder.is_folder = true;
+      folder.open = false;
+      folder.title = name && !name->empty() ? *name : "Folder";
+      if (kids) {
+        Convert(*kids, depth + 1, count, folder.children);
+      }
+      if (!folder.children.empty()) {
+        ++count;
+        out.push_back(std::move(folder));
+      }
+    }
+  }
+}
+
+// The newest session file of a profile (Sessions/Session_<time>).
+base::FilePath NewestSession(const base::FilePath& profile) {
+  base::FileEnumerator files(profile.AppendASCII("Sessions"), false,
+                             base::FileEnumerator::FILES,
+                             FILE_PATH_LITERAL("Session_*"));
+  base::FilePath best;
+  base::Time best_time;
+  for (base::FilePath f = files.Next(); !f.empty(); f = files.Next()) {
+    base::Time t = files.GetInfo().GetLastModifiedTime();
+    if (best.empty() || t > best_time) {
+      best = f;
+      best_time = t;
+    }
+  }
+  return best;
+}
+
+}  // namespace
+
+namespace internal {
+
+std::vector<Item> ChromeBookmarks(const base::DictValue& root) {
+  std::vector<Item> out;
+  size_t count = 0;
+  const base::DictValue* roots = root.FindDict("roots");
+  if (!roots) {
+    return out;
+  }
+  // The bookmarks bar at the top; the other roots as folders below it.
+  if (const base::ListValue* bar =
+          roots->FindListByDottedPath("bookmark_bar.children")) {
+    Convert(*bar, 0, count, out);
+  }
+  for (const auto& [key, title] :
+       {std::pair<const char*, const char*>{"other", "Other bookmarks"},
+        {"synced", "Mobile bookmarks"}}) {
+    const base::ListValue* kids =
+        roots->FindListByDottedPath(std::string(key) + ".children");
+    if (!kids) {
+      continue;
+    }
+    Item folder;
+    folder.is_folder = true;
+    folder.open = false;
+    folder.title = title;
+    Convert(*kids, 1, count, folder.children);
+    if (!folder.children.empty()) {
+      out.push_back(std::move(folder));
+    }
+  }
+  return out;
+}
+
+std::vector<ArcSidebar::Tab> ChromeOpenTabs(const std::string& data) {
+  std::vector<ArcSidebar::Tab> out;
+  base::span<const uint8_t> bytes = base::as_byte_span(data);
+  if (bytes.size() < 8) {
+    return out;
+  }
+  // "SNSS", then the version: 3 is a plain file (5 is encrypted).
+  if (base::U32FromLittleEndian(bytes.first<4>()) != 0x53534E53 ||
+      base::U32FromLittleEndian(bytes.subspan<4, 4>()) != 3) {
+    return out;
+  }
+  std::vector<std::unique_ptr<sessions::SessionCommand>> commands;
+  size_t at = 8;
+  // Each command: its size (2 bytes, with the id), its id (1), its contents.
+  while (at + 3 <= bytes.size()) {
+    size_t size = base::U16FromLittleEndian(bytes.subspan(at).first<2>());
+    at += 2;
+    if (size < 1 || at + size > bytes.size()) {
+      break;
+    }
+    uint8_t id = bytes[at];
+    auto command = std::make_unique<sessions::SessionCommand>(
+        id, static_cast<sessions::SessionCommand::size_type>(size - 1));
+    command->contents().copy_from(bytes.subspan(at + 1, size - 1));
+    at += size;
+    if (id != 255) {  // the marker that the initial state is written
+      commands.push_back(std::move(command));
+    }
+  }
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  SessionID active = SessionID::InvalidValue();
+  std::string platform_session_id;
+  std::set<SessionID> discarded;
+  sessions::RestoreSessionFromCommands(commands, &windows, &active,
+                                       &platform_session_id, &discarded);
+  for (const auto& window : windows) {
+    if (window->type != sessions::SessionWindow::TYPE_NORMAL) {
+      continue;
+    }
+    for (const auto& tab : window->tabs) {
+      if (tab->navigations.empty()) {
+        continue;
+      }
+      const sessions::SerializedNavigationEntry& nav =
+          tab->navigations[tab->normalized_navigation_index()];
+      GURL url = nav.virtual_url();
+      if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+          out.size() >= 500) {
+        continue;
+      }
+      out.push_back({url, nav.title().empty() ? url.spec()
+                                              : base::UTF16ToUTF8(nav.title())});
+    }
+  }
+  return out;
+}
+
+}  // namespace internal
+
+std::optional<ArcSidebar> ReadChromeSidebar(const ImportSource& source) {
+  if (source.user_data.empty() || !base::DirectoryExists(source.user_data)) {
+    return std::nullopt;
+  }
+  // The names people gave their Chrome profiles.
+  std::optional<base::DictValue> local_state =
+      ReadJson(source.user_data.AppendASCII("Local State"));
+  const base::DictValue* info =
+      local_state ? local_state->FindDictByDottedPath("profile.info_cache")
+                  : nullptr;
+  std::vector<std::string> dirs;
+  base::FileEnumerator found(source.user_data, false,
+                             base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath dir = found.Next(); !dir.empty(); dir = found.Next()) {
+    std::string name = dir.BaseName().AsUTF8Unsafe();
+    if (IsProfileDir(name) &&
+        (base::PathExists(dir.AppendASCII("Bookmarks")) ||
+         base::DirectoryExists(dir.AppendASCII("Sessions")) ||
+         base::PathExists(dir.AppendASCII("History")))) {
+      dirs.push_back(name);
+    }
+  }
+  std::ranges::sort(dirs, {}, [](const std::string& d) {
+    int n = 0;
+    base::StringToInt(d.substr(std::min<size_t>(8, d.size())), &n);
+    return d == "Default" ? -1 : n;
+  });
+  if (dirs.empty()) {
+    return std::nullopt;
+  }
+  ArcSidebar out;
+  for (const std::string& dir : dirs) {
+    base::FilePath path = source.user_data.AppendUTF8(dir);
+    const std::string* name =
+        info ? info->FindStringByDottedPath(dir + ".name") : nullptr;
+    Space space;
+    space.name = name && !name->empty() ? name->substr(0, 60) : "Chrome";
+    if (dirs.size() == 1 && space.name.starts_with("Person ")) {
+      space.name = "Chrome";
+    }
+    space.icon = "🌐";
+    space.profile = ProfileIdFor(source, dir);
+    if (std::optional<base::DictValue> bookmarks =
+            ReadJson(path.AppendASCII("Bookmarks"))) {
+      space.pinned = internal::ChromeBookmarks(*bookmarks);
+    }
+    std::vector<ArcSidebar::Tab> open;
+    base::FilePath session = NewestSession(path);
+    std::string data;
+    if (!session.empty() &&
+        base::ReadFileToStringWithMaxSize(session, &data, kMaxFile)) {
+      open = internal::ChromeOpenTabs(data);
+    }
+    if (!space.profile.empty()) {
+      out.profile_names[space.profile] = space.name;
+    }
+    out.spaces.push_back(std::move(space));
+    out.today.push_back(std::move(open));
+  }
+  return out;
+}
+
+}  // namespace meridian
