+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/import_source.h"
+
+#include "base/base_paths.h"
+#include "base/path_service.h"
+#include "base/strings/string_number_conversions.h"
+#include "build/build_config.h"
+#include "chrome/browser/meridian/arc_import.h"
+#include "chrome/browser/meridian/test_switches.h"
+
+namespace meridian {
+
+ImportSource::ImportSource() = default;
+ImportSource::ImportSource(const ImportSource&) = default;
+ImportSource& ImportSource::operator=(const ImportSource&) = default;
+ImportSource::~ImportSource() = default;
+
+ImportSource ArcSource() {
+  ImportSource s;
+  s.kind = "arc";
+  s.name = "Arc";
+  s.app_data = ArcDataDir();
+  if (!s.app_data.empty()) {
+    s.user_data = s.app_data.AppendASCII("User Data");
+  }
+  s.keychain_service = "Arc Safe Storage";
+  s.keychain_account = "Arc";
+  s.key_switch = "meridian-arc-safe-storage";
+  s.dir_switch = "meridian-arc-dir";
+  s.profile_prefix = "Meridian Profile Arc ";
+  return s;
+}
+
+ImportSource ChromeSource() {
+  ImportSource s;
+  s.kind = "chrome";
+  s.name = "Google Chrome";
+  s.keychain_service = "Chrome Safe Storage";
+  s.keychain_account = "Chrome";
+  s.key_switch = "meridian-chrome-safe-storage";
+  s.dir_switch = "meridian-chrome-dir";
+  s.profile_prefix = "Meridian Profile Chrome ";
+  // Tests: a fake Chrome user data folder.
+  if (HasTestSwitch(s.dir_switch)) {
+    s.user_data = TestSwitchPath(s.dir_switch);
+    return s;
+  }
+#if BUILDFLAG(IS_WIN)
+  base::FilePath local;
+  if (base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local)) {
+    s.user_data = local.AppendASCII("Google")
+                      .AppendASCII("Chrome")
+                      .AppendASCII("User Data");
+  }
+#elif BUILDFLAG(IS_MAC)
+  base::FilePath home;
+  if (base::PathService::Get(base::DIR_HOME, &home)) {
+    s.user_data = home.AppendASCII("Library/Application Support/Google/Chrome");
+  }
+#else
+  base::FilePath home;
+  if (base::PathService::Get(base::DIR_HOME, &home)) {
+    s.user_data = home.AppendASCII(".config/google-chrome");
+  }
+#endif
+  return s;
+}
+
+ImportSource ImportSourceFor(const std::string& kind) {
+  return kind == "chrome" ? ChromeSource() : ArcSource();
+}
+
+bool IsProfileDir(const std::string& name) {
+  int n = 0;
+  return name == "Default" ||
+         (name.starts_with("Profile ") && base::StringToInt(name.substr(8), &n));
+}
+
+std::string ProfileIdFor(const ImportSource& source, const std::string& dir) {
+  int n = 0;
+  if (dir.starts_with("Profile ") && base::StringToInt(dir.substr(8), &n) &&
+      n > 0) {
+    return source.profile_prefix + base::NumberToString(n);
+  }
+  return std::string();
+}
+
+}  // namespace meridian
