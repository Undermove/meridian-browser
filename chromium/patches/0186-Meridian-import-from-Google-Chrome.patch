+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_IMPORT_SOURCE_H_
+#define CHROME_BROWSER_MERIDIAN_IMPORT_SOURCE_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+
+namespace meridian {
+
+// A Chromium browser Meridian moves in from: Arc or Google Chrome. Both keep
+// their profiles the same way ("Default", "Profile N" with History, Cookies,
+// Login Data…), encrypted with a key from the keychain (macOS) or from
+// "Local State" (Windows), so one import reads either.
+struct ImportSource {
+  ImportSource();
+  ImportSource(const ImportSource&);
+  ImportSource& operator=(const ImportSource&);
+  ~ImportSource();
+
+  // "arc" or "chrome".
+  std::string kind;
+  // For people: "Arc", "Google Chrome".
+  std::string name;
+  // Where the profile folders and "Local State" are.
+  base::FilePath user_data;
+  // Where Arc's own files are (its sidebar, archive, rules); empty for
+  // Chrome.
+  base::FilePath app_data;
+  // macOS keychain item holding the cookie key's password.
+  std::string keychain_service;
+  std::string keychain_account;
+  // Tests: a switch with that password instead of the keychain ("__deny__"
+  // acts like the person clicking Deny), and the one with the fake folder.
+  std::string key_switch;
+  std::string dir_switch;
+  // Meridian profile folders for its profiles other than "Default".
+  std::string profile_prefix;
+};
+
+ImportSource ArcSource();
+ImportSource ChromeSource();
+// "arc" or "chrome" (anything else: Arc).
+ImportSource ImportSourceFor(const std::string& kind);
+
+// The Meridian profile for one of its profile folders: "" (the main one) for
+// "Default", "<prefix>3" for "Profile 3". The same every time, so each part of
+// the import lands in the same profile whichever comes first.
+std::string ProfileIdFor(const ImportSource& source, const std::string& dir);
+
+// Whether `name` is a real profile folder ("Default", "Profile N"; not
+// "Guest Profile" or "System Profile").
+bool IsProfileDir(const std::string& name);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_IMPORT_SOURCE_H_
