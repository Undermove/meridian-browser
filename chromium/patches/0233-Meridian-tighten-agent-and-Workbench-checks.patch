+namespace {
+
+// A setting that makes git start a program. The ones RunGitCommand overrides
+// on every call (fsmonitor, pager, sshCommand, diff.external) aren't here.
+bool RunsAProgram(std::string key) {
+  key = base::ToLowerASCII(key);
+  const auto section = [&](std::string_view s) {
+    return key.starts_with(std::string(s) + ".");
+  };
+  const auto ends = [&](std::string_view s) { return key.ends_with(s); };
+  if (section("filter")) {
+    return ends(".clean") || ends(".smudge") || ends(".process");
+  }
+  if (section("diff")) {
+    return ends(".command") || ends(".textconv");
+  }
+  if (section("merge")) {
+    return ends(".driver");
+  }
+  if (section("remote")) {
+    return ends(".uploadpack") || ends(".receivepack") || ends(".vcs");
+  }
+  if (section("credential")) {
+    return ends(".helper");
+  }
+  if (section("gpg")) {
+    return ends(".program");
+  }
+  if (section("submodule")) {
+    return ends(".update");
+  }
+  return section("pager") || key == "core.gitproxy" || key == "core.editor" ||
+         key == "core.askpass" || key == "sequence.editor" ||
+         key == "interactive.difffilter";
+}
+
+// The first setting in the repository's own config (with what it includes)
+// that would start a program. The person's global config is their own; a
+// repository's arrives with a downloaded folder. Listing runs nothing.
+std::string ProgramInRepoConfig(const std::string& program,
+                                const base::FilePath& root,
+                                const std::map<std::string, std::string>& env) {
+  ai::ProcessSpec spec;
+  spec.argv = {program,        "-c",     "core.fsmonitor=false", "config",
+               "--includes",   "--show-scope", "--name-only",    "--list"};
+  spec.env = env;
+  spec.env["LC_ALL"] = "C";
+  spec.cwd = root.AsUTF8Unsafe();
+  spec.timeout = base::Seconds(10);
+  spec.max_output = 1u << 20;
+  std::string out;
+  ai::RunProcess(spec, base::MakeRefCounted<ai::CancelFlag>(),
+                 base::BindRepeating([](std::string* out,
+                                        std::string_view chunk) {
+                   out->append(chunk);
+                 }, base::Unretained(&out)));
+  for (std::string_view line : base::SplitStringPiece(
+           out, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    const size_t tab = line.find('\t');
+    if (tab == std::string_view::npos) {
+      continue;
+    }
+    const std::string_view scope = line.substr(0, tab);
+    const std::string key(line.substr(tab + 1));
+    if ((scope == "local" || scope == "worktree") && RunsAProgram(key)) {
+      return key;
+    }
+  }
+  return std::string();
+}
+
