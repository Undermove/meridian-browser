+}  // namespace
+
+base::ListValue FindGitRepos(const base::FilePath& project,
+                             const std::vector<std::string>& transcripts,
+                             const std::vector<base::FilePath>& extra) {
+  constexpr size_t kMax = 16;
+  base::ListValue list;
+  base::flat_set<base::FilePath> seen;
+  const auto add = [&](const base::FilePath& p, const char* kind) {
+    if (list.size() < kMax && seen.insert(p).second) {
+      list.Append(base::DictValue()
+                      .Set("path", p.AsUTF8Unsafe())
+                      .Set("name", p.BaseName().AsUTF8Unsafe())
+                      .Set("kind", kind));
+    }
+  };
+  add(project, "project");
+  for (const base::FilePath& p : extra) {
+    add(p, "agent");
+  }
+  std::vector<std::string> paths;
+  for (const std::string& t : transcripts) {
+    PathsInTranscript(base::FilePath::FromUTF8Unsafe(t), paths);
+  }
+  base::flat_set<std::string> looked;
+  for (const std::string& raw : paths) {
+    if (looked.size() >= 300 || !looked.insert(raw).second) {
+      continue;
+    }
+    const base::FilePath p = base::FilePath::FromUTF8Unsafe(raw);
+    if (!p.IsAbsolute()) {
+      continue;
+    }
+    if (std::optional<base::FilePath> repo = RepoOf(p)) {
+      add(*repo, "agent");
+    }
+  }
+  std::vector<base::FilePath> nested;
+  NestedRepos(project, 1, nested);
+  for (const base::FilePath& p : nested) {
+    add(p, "nested");
+  }
+  return list;
+}
