+// The repository a path is in, if any.
+std::optional<base::FilePath> RepoOf(base::FilePath p) {
+  while (!p.empty() && p != p.DirName()) {
+    if (base::PathExists(p.AppendASCII(".git"))) {
+      return p;
+    }
+    p = p.DirName();
+  }
+  return std::nullopt;
+}
+
+// Absolute paths an agent worked with, the latest first: the end of its
+// transcript, `"file_path":"…"` and `"cwd":"…"`.
+void PathsInTranscript(const base::FilePath& transcript,
+                       std::vector<std::string>& out) {
+  constexpr int64_t kTail = 16 << 20;
+  base::File f(transcript, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!f.IsValid()) {
+    return;
+  }
+  const int64_t size = f.GetLength();
+  const int64_t from = std::max<int64_t>(0, size - kTail);
+  std::string text(static_cast<size_t>(size - from), '\0');
+  const std::optional<size_t> got =
+      f.Read(from, base::as_writable_byte_span(text));
+  if (!got) {
+    return;
+  }
+  text.resize(*got);
+  std::vector<std::string> found;
+  for (std::string_view key : {"\"file_path\":\"", "\"cwd\":\""}) {
+    for (size_t at = text.find(key); at != std::string::npos;
+         at = text.find(key, at + 1)) {
+      const size_t begin = at + key.size();
+      const size_t end = text.find('"', begin);
+      if (end == std::string::npos || end - begin > 4096) {
+        continue;
+      }
+      std::string path = text.substr(begin, end - begin);
+      base::ReplaceSubstringsAfterOffset(&path, 0, "\\\\", "\\");
+      found.push_back(std::move(path));
+    }
+  }
+  out.insert(out.end(), found.rbegin(), found.rend());
+}
+
+void NestedRepos(const base::FilePath& dir, int depth,
+                 std::vector<base::FilePath>& out) {
+  if (depth > 3 || out.size() >= 12) {
+    return;
+  }
+  base::FileEnumerator it(dir, false, base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath p = it.Next(); !p.empty(); p = it.Next()) {
+    const std::string name = p.BaseName().AsUTF8Unsafe();
+    if (name.starts_with(".") || name == "node_modules" || name == "vendor" ||
+        name == "dist" || name == "build" || name == "out" ||
+        name == "target") {
+      continue;
+    }
+    if (base::PathExists(p.AppendASCII(".git"))) {
+      out.push_back(p);
+    } else {
+      NestedRepos(p, depth + 1, out);
+    }
+  }
+}
