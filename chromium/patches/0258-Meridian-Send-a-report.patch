@@ -0,0 +1,254 @@
+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #css_wrapper_metadata_end */
+
+/* "Send a report": the sheet with everything the report contains. */
+
+:host {
+  font-family: system-ui, -apple-system, sans-serif;
+}
+
+button {
+  font: inherit;
+  color: inherit;
+  background: none;
+  border: 0;
+  padding: 0;
+  cursor: pointer;
+}
+
+.scrim {
+  position: fixed;
+  inset: 0;
+  z-index: 190;
+  display: grid;
+  place-items: center;
+  background: rgba(10, 10, 16, 0.36);
+  animation: fade 0.2s ease;
+}
+
+@keyframes fade {
+  from {
+    opacity: 0;
+  }
+}
+
+.sheet {
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  width: min(640px, 92vw);
+  max-height: 88vh;
+  overflow-y: auto;
+  padding: 20px 22px 18px;
+  border-radius: 18px;
+  background: var(--meridian-surface, #fff);
+  color: var(--meridian-text, #17171c);
+  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35),
+      0 0 0 0.5px var(--meridian-border, rgba(0, 0, 0, 0.1));
+  animation: pop 0.26s cubic-bezier(0.05, 0.7, 0.1, 1);
+}
+
+@keyframes pop {
+  from {
+    opacity: 0;
+    transform: translateY(10px) scale(0.98);
+  }
+}
+
+.head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+h3 {
+  margin: 0;
+  font-size: 18px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+}
+
+.sub {
+  margin: 6px 0 14px;
+  font-size: 13px;
+  line-height: 1.5;
+  color: var(--meridian-text-muted, #66655f);
+}
+
+.x {
+  display: grid;
+  place-items: center;
+  width: 26px;
+  height: 26px;
+  border-radius: 8px;
+  color: var(--meridian-text-muted, #66655f);
+}
+
+.x:hover {
+  background: color-mix(in srgb, currentColor 12%, transparent);
+}
+
+.label {
+  margin: 4px 0 6px;
+  font-size: 12.5px;
+  font-weight: 600;
+}
+
+textarea {
+  box-sizing: border-box;
+  width: 100%;
+  margin-bottom: 12px;
+  padding: 9px 11px;
+  border: 0;
+  border-radius: 10px;
+  outline: none;
+  resize: vertical;
+  font: inherit;
+  font-size: 13px;
+  line-height: 1.45;
+  color: inherit;
+  background: color-mix(in srgb, currentColor 6%, transparent);
+  box-shadow: inset 0 0 0 0.5px var(--meridian-border, rgba(0, 0, 0, 0.12));
+}
+
+textarea:focus {
+  box-shadow: inset 0 0 0 1.5px
+      color-mix(in srgb, currentColor 45%, transparent);
+}
+
+textarea.details {
+  min-height: 180px;
+  font-size: 12px;
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  white-space: pre;
+  overflow-wrap: normal;
+}
+
+.loading {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  height: 180px;
+  margin-bottom: 12px;
+  padding: 0 12px;
+  border-radius: 10px;
+  font-size: 13px;
+  color: var(--meridian-text-muted, #66655f);
+  background: color-mix(in srgb, currentColor 4%, transparent);
+}
+
+.loading i {
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: currentColor;
+  animation: blink 1.2s infinite ease-in-out;
+}
+
+.loading i:nth-child(2) {
+  animation-delay: 0.15s;
+}
+
+.loading i:nth-child(3) {
+  animation-delay: 0.3s;
+}
+
+.loading span {
+  margin-left: 8px;
+}
+
+@keyframes blink {
+  50% {
+    opacity: 0.25;
+  }
+}
+
+.privacy {
+  padding: 10px 12px;
+  border-radius: 10px;
+  font-size: 12px;
+  line-height: 1.5;
+  color: var(--meridian-text-muted, #55554f);
+  background: color-mix(in srgb, currentColor 4%, transparent);
+}
+
+.privacy p {
+  margin: 0 0 4px;
+}
+
+.privacy p:last-child {
+  margin: 0;
+}
+
+.privacy b {
+  color: var(--meridian-text, #17171c);
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  margin-top: 14px;
+}
+
+.grow {
+  flex: 1;
+}
+
+.btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  height: 34px;
+  padding: 0 14px;
+  border-radius: 10px;
+  font-size: 13px;
+  font-weight: 600;
+  background: color-mix(in srgb, currentColor 8%, transparent);
+}
+
+.btn:hover {
+  background: color-mix(in srgb, currentColor 13%, transparent);
+}
+
+.btn.ghost {
+  background: none;
+  padding: 0 8px;
+}
+
+.btn.ghost:hover {
+  background: color-mix(in srgb, currentColor 8%, transparent);
+}
+
+.btn.primary {
+  background: var(--meridian-text, #17171c);
+  color: var(--meridian-surface, #fff);
+}
+
+.btn:disabled {
+  opacity: 0.55;
+  cursor: default;
+}
+
+.done {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin: 10px 0 0;
+  font-size: 12.5px;
+  color: var(--meridian-text-muted, #55554f);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .scrim,
+  .sheet,
+  .loading i {
+    animation: none;
+  }
+}
