+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/report.h"
+
+#include <algorithm>
+#include <array>
+#include <deque>
+#include <utility>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/synchronization/lock.h"
+#include "base/time/time.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace meridian::report {
+
+namespace {
+
+constexpr size_t kMaxLine = 500;
+constexpr size_t kMaxAgents = 20;
+
+struct Store {
+  base::Lock lock;
+  std::deque<std::string> lines;
+  std::vector<std::string> agents;
+};
+
+Store& GetStore() {
+  static base::NoDestructor<Store> store;
+  return *store;
+}
+
+std::string Clock() {
+  base::Time::Exploded t;
+  base::Time::Now().LocalExplode(&t);
+  return base::StringPrintf("%02d:%02d:%02d", t.hour, t.minute, t.second);
+}
+
+logging::LogMessageHandlerFunction g_previous_handler = nullptr;
+
+bool OnLogMessage(int severity,
+                  const char* file,
+                  int line,
+                  size_t message_start,
+                  const std::string& str) {
+  if (severity >= logging::LOGGING_WARNING && file) {
+    std::string_view path(file);
+    if (path.find("meridian") != std::string_view::npos) {
+      size_t slash = path.find_last_of("/\\");
+      std::string_view name =
+          slash == std::string_view::npos ? path : path.substr(slash + 1);
+      std::string_view message =
+          message_start < str.size() ? std::string_view(str).substr(message_start)
+                                     : std::string_view();
+      message = base::TrimWhitespaceASCII(message, base::TRIM_ALL);
+      NoteError(severity >= logging::LOGGING_ERROR ? "error" : "warning",
+                std::string(name) + ":" + base::NumberToString(line) + " " +
+                    std::string(message));
+    }
+  }
+  return g_previous_handler &&
+         g_previous_handler(severity, file, line, message_start, str);
+}
+
+using Groups = std::array<std::string_view, 4>;
+
+// Replaces every match of `re` in `text` with what `with` returns for it
+// (the whole match and its first group, if any).
+template <typename Fn>
+std::string ReplaceEach(std::string_view text, const RE2& re, Fn with) {
+  std::string out;
+  size_t pos = 0;
+  const int groups = std::min(re.NumberOfCapturingGroups(), 3);
+  std::array<std::string_view, 4> m;
+  while (pos <= text.size() &&
+         re.Match(text, pos, text.size(), RE2::UNANCHORED, m.data(),
+                  groups + 1)) {
+    const size_t start = m[0].data() - text.data();
+    out.append(text.substr(pos, start - pos));
+    out += with(m);
+    pos = start + m[0].size();
+    if (m[0].empty()) {
+      if (pos < text.size()) {
+        out += text[pos];
+      }
+      ++pos;
+    }
+  }
+  if (pos < text.size()) {
+    out.append(text.substr(pos));
+  }
+  return out;
+}
+
+std::string ReplaceAll(std::string_view text,
+                       const RE2& re,
+                       std::string_view with) {
+  return ReplaceEach(text, re,
+                     [&](const Groups&) { return std::string(with); });
+}
+
+bool IsLoopback(std::string_view host) {
+  std::string h = base::ToLowerASCII(host);
+  // Without user info and port.
+  if (size_t at = h.rfind('@'); at != std::string::npos) {
+    h = h.substr(at + 1);
+  }
+  if (!h.empty() && h[0] == '[') {
+    return h.starts_with("[::1]");
+  }
+  if (size_t colon = h.find(':'); colon != std::string::npos) {
+    h = h.substr(0, colon);
+  }
+  return h == "localhost" || h == "127.0.0.1" || h == "0.0.0.0";
+}
+
+bool MixedLettersAndDigits(std::string_view s) {
+  bool letter = false;
+  bool digit = false;
+  for (char c : s) {
+    letter |= base::IsAsciiAlpha(c);
+    digit |= base::IsAsciiDigit(c);
+  }
+  return letter && digit;
+}
+
+void ReplaceLiteral(std::string& text,
+                    std::string_view what,
+                    std::string_view with) {
+  if (what.empty()) {
+    return;
+  }
+  base::ReplaceSubstringsAfterOffset(&text, 0, what, with);
+}
+
+}  // namespace
+
+void NoteError(std::string_view source, std::string_view text) {
+  const std::string prefix = Clock() + " " + std::string(source) + ": ";
+  std::vector<std::string> lines;
+  for (std::string_view line : base::SplitStringPiece(
+           text, "\r\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    std::string l = prefix + std::string(line);
+    if (l.size() > kMaxLine) {
+      base::TruncateUTF8ToByteSize(l, kMaxLine, &l);
+      l += "…";
+    }
+    lines.push_back(std::move(l));
+  }
+  Store& store = GetStore();
+  base::AutoLock lock(store.lock);
+  for (std::string& l : lines) {
+    store.lines.push_back(std::move(l));
+  }
+  while (store.lines.size() > kMaxErrorLines) {
+    store.lines.pop_front();
+  }
+}
+
+void NoteAgent(std::string_view name) {
+  std::string n(name.substr(0, 60));
+  if (n.empty()) {
+    return;
+  }
+  Store& store = GetStore();
+  base::AutoLock lock(store.lock);
+  if (!std::ranges::contains(store.agents, n) &&
+      store.agents.size() < kMaxAgents) {
+    store.agents.push_back(std::move(n));
+  }
+}
+
+std::vector<std::string> RecentErrors() {
+  Store& store = GetStore();
+  base::AutoLock lock(store.lock);
+  return {store.lines.begin(), store.lines.end()};
+}
+
+std::vector<std::string> AgentsSeen() {
+  Store& store = GetStore();
+  base::AutoLock lock(store.lock);
+  return store.agents;
+}
+
+void CaptureLogs() {
+  static bool installed = false;
+  if (installed) {
+    return;
+  }
+  installed = true;
+  g_previous_handler = logging::GetLogMessageHandler();
+  logging::SetLogMessageHandler(&OnLogMessage);
+}
+
+void ResetForTesting() {
+  Store& store = GetStore();
+  base::AutoLock lock(store.lock);
+  store.lines.clear();
+  store.agents.clear();
+}
+
+Private::Private() = default;
+Private::Private(const Private&) = default;
+Private::~Private() = default;
+
+Private ThisComputer() {
+  Private p;
+  base::FilePath home = base::GetHomeDir();
+  p.home = home.AsUTF8Unsafe();
+  std::string account = home.BaseName().AsUTF8Unsafe();
+  if (!account.empty() && account != "/" && account != "\\") {
+    p.names.push_back(account);
+  }
+  return p;
+}
+
+std::string Scrub(std::string_view input, const Private& p) {
+  // Addresses: a page's, a file's, an API's. A server on this computer
+  // keeps its scheme, host and port (useful, and nobody's browsing).
+  static const base::NoDestructor<RE2> kUrl(
+      R"((?i)\b([a-z][a-z0-9+.\-]{1,20})://([^\s/?#"'<>()\[\]{}`|\\]*)[^\s"'<>()\[\]{}`|]*)");
+  std::string text = ReplaceEach(input, *kUrl, [](const Groups& m) {
+    if (IsLoopback(m[2])) {
+      std::string host(m[2]);
+      if (size_t at = host.rfind('@'); at != std::string::npos) {
+        host = host.substr(at + 1);
+      }
+      return base::ToLowerASCII(m[1]) + "://" + host;
+    }
+    return std::string("[link]");
+  });
+
+  // The home folder, as the person's own and as anyone's.
+  if (p.home.size() > 1) {
+    std::string home = p.home;
+    while (home.size() > 1 && (home.back() == '/' || home.back() == '\\')) {
+      home.pop_back();
+    }
+    // A folder seen through /private (macOS) first.
+    ReplaceLiteral(text, "/private" + home, "~");
+    ReplaceLiteral(text, home, "~");
+    std::string other = home;
+    std::replace(other.begin(), other.end(), '\\', '/');
+    ReplaceLiteral(text, other, "~");
+    std::replace(other.begin(), other.end(), '/', '\\');
+    ReplaceLiteral(text, other, "~");
+  }
+  static const base::NoDestructor<RE2> kPosixHome(
+      R"((/private)?/(Users|home)/[^/\s:"'<>|]+)");
+  text = ReplaceAll(text, *kPosixHome, "~");
+  static const base::NoDestructor<RE2> kWindowsHome(
+      R"((?i)\b[a-z]:[\\/]+(Users|Documents and Settings)[\\/]+[^\\/\s:"'<>|]+)");
+  text = ReplaceAll(text, *kWindowsHome, "~");
+
+  static const base::NoDestructor<RE2> kEmail(
+      R"([A-Za-z0-9._%+\-]+@[A-Za-z0-9\-]+(\.[A-Za-z0-9\-]+)*\.[A-Za-z]{2,})");
+  text = ReplaceAll(text, *kEmail, "[email]");
+
+  // Keys and tokens.
+  static const base::NoDestructor<RE2> kBearer(
+      R"((?i)\b(Bearer)\s+[A-Za-z0-9._~+/=\-]{6,})");
+  text = ReplaceEach(text, *kBearer, [](const Groups& m) {
+    return std::string(m[1]) + " [hidden]";
+  });
+  static const base::NoDestructor<RE2> kNamedSecret(
+      R"((?i)((?:x-)?api[_\-]?key|secret[_\-]?key|private[_\-]?key|access[_\-]?token|auth[_\-]?token|refresh[_\-]?token|client[_\-]?secret|secret|token|password|passwd|authorization)(["']?\s*[:=]\s*["']?)([^\s"',;}&]+))");
+  text = ReplaceEach(text, *kNamedSecret, [](const Groups& m) {
+    if (m[3] == "[hidden]" || base::EqualsCaseInsensitiveASCII(m[3], "Bearer")) {
+      return std::string(m[0]);
+    }
+    return std::string(m[1]) + std::string(m[2]) + "[hidden]";
+  });
+  static const base::NoDestructor<RE2> kKnownKey(
+      R"(\b(sk-[A-Za-z0-9_\-]{8,}|gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_\-]{20,}|xox[abprs]-[A-Za-z0-9\-]{10,}|glpat-[A-Za-z0-9_\-]{16,}|(AKIA|ASIA)[0-9A-Z]{16}|eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+))");
+  text = ReplaceAll(text, *kKnownKey, "[hidden]");
+  // Anything long that looks random (base64, hex, ids).
+  static const base::NoDestructor<RE2> kLong(R"([A-Za-z0-9+/=_\-]{32,})");
+  text = ReplaceEach(text, *kLong, [](const Groups& m) {
+    std::string_view run = m[0];
+    // Base64 with slashes in it.
+    if (run.size() >= 40 && MixedLettersAndDigits(run) &&
+        (run.find('+') != std::string_view::npos || run.ends_with('='))) {
+      return std::string("[hidden]");
+    }
+    std::vector<std::string> parts;
+    for (std::string_view part : base::SplitStringPiece(
+             run, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+      parts.push_back(part.size() >= 32 && MixedLettersAndDigits(part)
+                          ? std::string("[hidden]")
+                          : std::string(part));
+    }
+    return base::JoinString(parts, "/");
+  });
+
+  // Names.
+  for (const std::string& name : p.names) {
+    std::string n(base::TrimWhitespaceASCII(name, base::TRIM_ALL));
+    if (n.size() < 3 || n == "hidden" || n == "name" || n == "link" ||
+        n == "email") {
+      continue;
+    }
+    if (base::IsStringASCII(n)) {
+      RE2 word("(?i)\\b" + RE2::QuoteMeta(n) + "\\b");
+      if (word.ok()) {
+        text = ReplaceAll(text, word, "[name]");
+      }
+    } else {
+      ReplaceLiteral(text, n, "[name]");
+    }
+  }
+  return text;
+}
+
+Facts::Facts() = default;
+Facts::Facts(const Facts&) = default;
+Facts::~Facts() = default;
+
+std::string Details(const Facts& f, const Private& p) {
+  auto yes = [](bool b) { return b ? "Yes" : "No"; };
+  std::string md;
+  md += "## Meridian\n";
+  md += "- Version: Meridian " + f.version + " (Chromium " +
+        f.chromium_version + ")\n";
+  md += "- System: " + f.os + ", " + f.arch + "\n";
+
+  md += "\n## Settings › AI\n";
+  md += "- Ask and Chat answer with: " + f.ai_answers + "\n";
+  md += "- Agent access: " + f.agent_access + "\n";
+  md += "- Sending to AIs on the internet: " + f.ai_consent + "\n";
+  md += "- Other agents offered: " + std::string(yes(f.other_agents)) + "\n";
+
+  md += "\n## AIs Meridian can use\n";
+  std::vector<std::string> missing;
+  for (const Ai& ai : f.ais) {
+    if (!ai.installed && ai.unavailable.empty()) {
+      missing.push_back(ai.label);
+      continue;
+    }
+    std::string line = "- " + ai.label + " (" + ai.kind + "): ";
+    std::vector<std::string> bits;
+    if (!ai.unavailable.empty()) {
+      bits.push_back("can’t answer here: " + ai.unavailable);
+    } else {
+      bits.push_back(ai.kind == "cloud" ? "key saved" : "installed");
+      // (A model on this computer has no account.)
+      if (ai.kind == "local") {
+      } else if (ai.signed_in == 1) {
+        bits.push_back("signed in");
+      } else if (ai.signed_in == 0) {
+        bits.push_back("not signed in");
+      }
+      if (!ai.model.empty()) {
+        bits.push_back("model " + ai.model);
+      }
+    }
+    md += line + base::JoinString(bits, ", ") + "\n";
+  }
+  if (!missing.empty()) {
+    md += "- Not set up: " + base::JoinString(missing, ", ") + "\n";
+  }
+
+  md += "\n## Coding agents\n";
+  std::vector<std::string> not_found;
+  for (const Agent& a : f.agents) {
+    if (!a.found) {
+      not_found.push_back(a.name);
+      continue;
+    }
+    std::string line = "- " + a.name + ": found";
+    if (a.connected) {
+      line += ", has Meridian";
+    }
+    if (!a.version.empty()) {
+      line += ", version " + a.version;
+    }
+    md += line + "\n";
+  }
+  if (!f.agents_seen.empty()) {
+    md += "- Used Meridian this session: " +
+          base::JoinString(f.agents_seen, ", ") + "\n";
+  }
+  if (!not_found.empty()) {
+    md += "- Not found: " + base::JoinString(not_found, ", ") + "\n";
+  }
+
+  md += "\n## Updates\n- " + f.update + "\n";
+
+  md += "\n## Recent errors\n";
+  if (f.errors.empty()) {
+    md += "None this session.\n";
+  } else {
+    md += "The last " + base::NumberToString(f.errors.size()) +
+          " lines Meridian noted since it started.\n\n```text\n";
+    for (std::string line : f.errors) {
+      base::ReplaceSubstringsAfterOffset(&line, 0, "```", "'''");
+      md += line + "\n";
+    }
+    md += "```\n";
+  }
+  return Scrub(md, p);
+}
+
+}  // namespace meridian::report
diff --git a/chrome/browser/meridian/report.h b/chrome/browser/meridian/report.h
new file mode 100644
index 0000000000..4f892953c0
--- /dev/null
+++ b/chrome/browser/meridian/report.h
@@ -0,0 +1,111 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_REPORT_H_
+#define CHROME_BROWSER_MERIDIAN_REPORT_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+// "Send a report": what the person can send the developer when something
+// goes wrong, shown to them in full before anything leaves (and nothing ever
+// leaves by itself: they copy it, save it or paste it into an issue).
+//
+// Meridian keeps its recent errors here (Ask and provider failures, agent
+// tool failures, the updater, and its own LOG(WARNING) and worse lines) for
+// this run only, never on disk. Everything that goes into a report passes
+// through Scrub(): no addresses of pages, no keys or tokens, no e-mail
+// addresses, no name, and the home folder written as ~.
+namespace meridian::report {
+
+// The last lines kept.
+inline constexpr size_t kMaxErrorLines = 200;
+
+// Something went wrong: `source` is a short tag ("ask", "agent", "update",
+// "log"), `text` may span lines (each kept, with the time and the tag).
+// Any thread.
+void NoteError(std::string_view source, std::string_view text);
+// An agent (MCP client) used Meridian this run, by the name it gave.
+void NoteAgent(std::string_view name);
+// Oldest first, each line at most 500 characters. Not scrubbed yet.
+std::vector<std::string> RecentErrors();
+std::vector<std::string> AgentsSeen();
+// Keeps Meridian's own LOG(WARNING) and worse (from chrome/browser/meridian)
+// among the errors from now on; once per process.
+void CaptureLogs();
+void ResetForTesting();
+
+// What is private on this computer: the home folder, and names (the account
+// name, the person's full name, the member card's name).
+struct Private {
+  Private();
+  Private(const Private&);
+  ~Private();
+  std::string home;
+  std::vector<std::string> names;
+};
+// The home folder and the account and full name from the system.
+Private ThisComputer();
+
+// `text` without what must not leave this computer: page and other addresses
+// ([link]; a server on this computer keeps http://localhost:port), e-mail
+// addresses ([email]), API keys and tokens (sk-…, ghp_…, AIza…, Bearer …,
+// key=…, JWTs, long base64/hex: [hidden]), names ([name]), and the home
+// folder (any /Users/<name> or C:\Users\<name>) as ~. Scrubbing twice changes
+// nothing more.
+std::string Scrub(std::string_view text, const Private& p);
+
+// The facts in a report, gathered by the window (sidebar_handler.cc).
+struct Ai {
+  std::string label;
+  // "cli", "local" or "cloud".
+  std::string kind;
+  bool installed = false;
+  // 1 signed in, 0 not, -1 can't tell.
+  int signed_in = -1;
+  // A local or cloud model in use (never a CLI's account).
+  std::string model;
+  // Why it can't answer here.
+  std::string unavailable;
+};
+struct Agent {
+  std::string name;
+  bool found = false;
+  // Its config has Meridian (Claude Desktop), else unknown.
+  bool connected = false;
+  // The first line of `<cli> --version`, if it has one.
+  std::string version;
+};
+struct Facts {
+  Facts();
+  Facts(const Facts&);
+  ~Facts();
+  std::string version;
+  std::string chromium_version;
+  // "macOS 26.2", "Windows 11 (10.0.26100)".
+  std::string os;
+  // "arm64", "x86_64".
+  std::string arch;
+  // Settings > AI: who answers ("Automatic (Claude Code)"), agent access,
+  // sending to AIs on the internet, "other agents" offered.
+  std::string ai_answers;
+  std::string agent_access;
+  std::string ai_consent;
+  bool other_agents = false;
+  std::vector<Ai> ais;
+  std::vector<Agent> agents;
+  std::vector<std::string> agents_seen;
+  // "Up to date", "Failed: …".
+  std::string update;
+  std::vector<std::string> errors;
+};
+
+// The report's details (everything but the person's own words), as
+// Markdown, scrubbed.
+std::string Details(const Facts& facts, const Private& p);
+
+}  // namespace meridian::report
+
+#endif  // CHROME_BROWSER_MERIDIAN_REPORT_H_
