@@ -0,0 +1,71 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import type {MeridianReportElement} from './report.js';
+
+export function getHtml(this: MeridianReportElement) {
+  return html`<!--_html_template_start_-->
+${this.open ? html`
+  <div class="scrim" @click="${this.onScrimClick_}"
+      @keydown="${this.onKeydown_}">
+    <div class="sheet" role="dialog" aria-modal="true"
+        aria-labelledby="reportTitle" @click="${this.onSheetClick_}">
+      <div class="head">
+        <h3 id="reportTitle">Send a report</h3>
+        <button id="close" class="x" title="Close"
+            @click="${this.onCloseClick_}">${icon('x', 14)}</button>
+      </div>
+      <p class="sub">Something went wrong? This helps the developer see why.
+        Below is everything the report contains. Read it, change anything,
+        then copy it, save it, or open an issue on GitHub.</p>
+
+      <label class="label" for="happened">What happened?</label>
+      <textarea id="happened" rows="3"
+          placeholder="For example: I asked about a page and OpenCode showed an error."
+          .value="${this.happened_}"
+          @input="${this.onHappenedInput_}"></textarea>
+
+      <label class="label" for="details">What else is in the report</label>
+      ${this.loading_ ? html`
+        <div id="loading" class="loading" role="status">
+          <i></i><i></i><i></i><span>Gathering versions and recent
+            errors…</span></div>` : html`
+        <textarea id="details" class="details" rows="12" spellcheck="false"
+            .value="${this.details_}"
+            @input="${this.onDetailsInput_}"></textarea>`}
+
+      <div id="privacy" class="privacy">
+        <p><b>Included:</b> your words, the Meridian and system versions,
+          your Settings › AI choices, the names and versions of the AIs and
+          coding agents Meridian found, and Meridian’s recent errors.</p>
+        <p><b>Never included:</b> your tabs or their addresses, page
+          contents, history, cookies, passwords, API keys or tokens, file
+          contents, or your name and email. Your home folder shows as ~.</p>
+        <p>Nothing is sent by itself.</p>
+      </div>
+
+      <div class="actions">
+        <button id="issue" class="btn ghost"
+            ?disabled="${this.loading_ || this.busy_}"
+            @click="${this.onIssueClick_}">
+          ${icon('external', 14)} Open an issue on GitHub</button>
+        <div class="grow"></div>
+        <button id="save" class="btn"
+            ?disabled="${this.loading_ || this.busy_}"
+            @click="${this.onSaveClick_}">Save as file…</button>
+        <button id="copy" class="btn primary"
+            ?disabled="${this.loading_ || this.busy_}"
+            @click="${this.onCopyClick_}">
+          ${icon('copy', 14)} Copy report</button>
+      </div>
+      ${this.done_ ? html`
+        <p id="done" class="done" role="status">${icon('check', 14)}
+          ${this.done_}</p>` : ''}
+    </div>
+  </div>` : ''}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/report.ts b/chrome/browser/resources/webui_browser/meridian/report.ts
new file mode 100644
index 0000000000..d85199e501
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/report.ts
@@ -0,0 +1,242 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// "Send a report": a sheet that shows everything a report would contain
+// (the person's own words, versions, Settings › AI, the AIs and agents found,
+// Meridian's recent errors), editable, before anything leaves. Nothing is
+// sent by itself: the person copies it, saves it as a file or opens a
+// GitHub issue and pastes it there. Meridian scrubs it (report.h) when it's
+// gathered and again on the way out.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {SidebarHandlerInterface} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './report.css.js';
+import {getHtml} from './report.html.js';
+
+// Where the sheet was opened from, and the error shown there (if any).
+export interface ReportFrom {
+  from: 'settings'|'command-bar'|'ask'|'chat'|'ask-bar';
+  error?: string;
+}
+
+const ISSUES = 'https://github.com/Undermove/meridian-browser/issues/new';
+// GitHub and browsers take longer addresses, but not every one: well under.
+export const MAX_ISSUE_URL = 2000;
+
+const PLACES: {[from: string]: string} = {
+  'settings': 'Settings',
+  'command-bar': 'the command bar',
+  'ask': 'an error in the Ask panel',
+  'chat': 'an error in Chat',
+  'ask-bar': 'an error in the command bar’s Ask',
+};
+
+// The issue's title from the person's words.
+export function issueTitle(happened: string, version: string): string {
+  const first = happened.trim().split('\n')[0]!.trim();
+  if (!first) {
+    return `Report from Meridian ${version}`.trim();
+  }
+  return first.length > 70 ? `${first.slice(0, 69).trimEnd()}…` : first;
+}
+
+// A new issue with a short body; the whole report is on the clipboard.
+export function issueUrl(
+    happened: string, version: string, system: string): string {
+  const title = issueTitle(happened, version);
+  const make = (words: string) => {
+    const body = [
+      '**What happened**',
+      words.trim() || '(not filled in)',
+      '',
+      [version && `Meridian ${version}`, system].filter(Boolean).join(' · '),
+      '',
+      '**Full report:** it’s on your clipboard. Paste it below.',
+      '',
+      '',
+    ].join('\n');
+    return `${ISSUES}?title=${encodeURIComponent(title)}&body=${
+        encodeURIComponent(body)}`;
+  };
+  let words = happened.trim();
+  let url = make(words);
+  while (url.length > MAX_ISSUE_URL && words.length > 0) {
+    words = words.slice(0, Math.max(0, Math.floor(words.length * 0.8) - 1));
+    url = make(words ? `${words.trimEnd()}…` : '');
+  }
+  return url;
+}
+
+export class MeridianReportElement extends CrLitElement {
+  static get is() {
+    return 'meridian-report';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      loading_: {state: true, type: Boolean},
+      happened_: {state: true, type: String},
+      details_: {state: true, type: String},
+      done_: {state: true, type: String},
+      busy_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  protected accessor loading_: boolean = false;
+  protected accessor happened_: string = '';
+  protected accessor details_: string = '';
+  // What just happened ("Copied…"), under the buttons.
+  protected accessor done_: string = '';
+  protected accessor busy_: boolean = false;
+  // The last report that left the sheet, and the issue address (tests).
+  lastReport: string = '';
+  lastIssueUrl: string = '';
+
+  private readonly handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  private opened_ = 0;
+
+  async show(from: ReportFrom) {
+    const run = ++this.opened_;
+    this.open = true;
+    this.loading_ = true;
+    this.done_ = '';
+    this.details_ = '';
+    await this.updateComplete;
+    this.shadowRoot.querySelector<HTMLTextAreaElement>('#happened')?.focus();
+    const {details} = await this.handler_.getReport();
+    let where = `## Where it was sent from\n- ${PLACES[from.from] || 'Meridian'}`;
+    if (from.error) {
+      where += `\n- The error shown: ${from.error.replace(/\s+/g, ' ').trim()}`;
+    }
+    const {text} = await this.handler_.scrubReport(where);
+    if (run !== this.opened_ || !this.open) {
+      return;
+    }
+    this.details_ = `${text}\n\n${details}`;
+    this.loading_ = false;
+  }
+
+  close() {
+    this.open = false;
+    this.busy_ = false;
+  }
+
+  // The report as it will leave: what the person sees, scrubbed (the boxes
+  // show the scrubbed text, so nothing differs from what was shown).
+  private async final_(): Promise<string> {
+    const [happened, details] = await Promise.all([
+      this.handler_.scrubReport(this.happened_),
+      this.handler_.scrubReport(this.details_),
+    ]);
+    this.happened_ = happened.text;
+    this.details_ = details.text;
+    return [
+      '# Meridian report',
+      '',
+      '## What happened',
+      this.happened_.trim() || '(not filled in)',
+      '',
+      this.details_.trim(),
+      '',
+    ].join('\n');
+  }
+
+  private version_(): {version: string, system: string} {
+    const line = (label: string) =>
+        this.details_.match(new RegExp(`^- ${label}: (.*)$`, 'm'))?.[1] || '';
+    return {
+      version: line('Version').replace(/^Meridian /, '').replace(/ \(.*$/, ''),
+      system: line('System'),
+    };
+  }
+
+  protected async onCopyClick_() {
+    if (this.busy_ || this.loading_) {
+      return;
+    }
+    this.busy_ = true;
+    const {copied} = await this.handler_.copyReport(await this.final_());
+    this.lastReport = copied;
+    this.busy_ = false;
+    this.done_ = 'Copied. Paste it into a chat or an email to the developer.';
+  }
+
+  protected async onSaveClick_() {
+    if (this.busy_ || this.loading_) {
+      return;
+    }
+    this.busy_ = true;
+    const report = await this.final_();
+    const {saved} = await this.handler_.saveReport(report);
+    this.busy_ = false;
+    if (saved) {
+      this.lastReport = report;
+      this.done_ = 'Saved. Send the file to the developer in any chat.';
+    }
+  }
+
+  protected async onIssueClick_() {
+    if (this.busy_ || this.loading_) {
+      return;
+    }
+    this.busy_ = true;
+    const {copied} = await this.handler_.copyReport(await this.final_());
+    this.lastReport = copied;
+    const {version, system} = this.version_();
+    this.lastIssueUrl = issueUrl(this.happened_, version, system);
+    this.busy_ = false;
+    this.done_ = 'The full report is on your clipboard: paste it into the ' +
+        'issue, below the short note.';
+    this.fire('meridian-open-url', this.lastIssueUrl);
+  }
+
+  protected onHappenedInput_(e: Event) {
+    this.happened_ = (e.target as HTMLTextAreaElement).value;
+  }
+
+  protected onDetailsInput_(e: Event) {
+    this.details_ = (e.target as HTMLTextAreaElement).value;
+  }
+
+  protected onScrimClick_() {
+    this.close();
+  }
+
+  protected onSheetClick_(e: Event) {
+    e.stopPropagation();
+  }
+
+  protected onCloseClick_() {
+    this.close();
+  }
+
+  protected onKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.close();
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-report': MeridianReportElement;
+  }
+}
+
+customElements.define(MeridianReportElement.is, MeridianReportElement);
diff --git a/chrome/browser/resources/webui_browser/meridian/settings.html.ts b/chrome/browser/resources/webui_browser/meridian/settings.html.ts
index afc7f52eab..9af35ca64f 100644
