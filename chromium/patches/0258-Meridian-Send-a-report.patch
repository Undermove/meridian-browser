+namespace {
+
+std::string OsName() {
+#if BUILDFLAG(IS_MAC)
+  return "macOS " + base::SysInfo::OperatingSystemVersion();
+#elif BUILDFLAG(IS_WIN)
+  return "Windows " + base::SysInfo::OperatingSystemVersion();
+#else
+  return base::SysInfo::OperatingSystemName() + " " +
+         base::SysInfo::OperatingSystemVersion();
+#endif
+}
+
+std::string AccessName(const std::string& access) {
+  if (access == "read") {
+    return "Read only";
+  }
+  if (access == "ask") {
+    return "Ask before each action";
+  }
+  if (access == "full") {
+    return "Full";
+  }
+  return "Off";
+}
+
+std::string ConsentName(const std::string& consent) {
+  if (consent == "always") {
+    return "Always send";
+  }
+  if (consent == "off") {
+    return "AI features off";
+  }
+  return "Ask first";
+}
+
+std::string UpdateText(const mojom::UpdateStatePtr& u) {
+  switch (u->status) {
+    case mojom::UpdateStatus::kChecking:
+      return "Checking for updates";
+    case mojom::UpdateStatus::kUpToDate:
+      return "Up to date";
+    case mojom::UpdateStatus::kAvailable:
+      return "Meridian " + u->version + " is available";
+    case mojom::UpdateStatus::kDownloading:
+      return "Downloading Meridian " + u->version;
+    case mojom::UpdateStatus::kReady:
+      return "Meridian " + u->version + " is ready (restart to update)";
+    case mojom::UpdateStatus::kFailed:
+      return "Update failed: " + u->error;
+    case mojom::UpdateStatus::kIdle:
+      break;
+  }
+  return "Not checked yet";
+}
+
+// The first line of `<cli> --version`, or empty. Blocking (a few seconds at
+// most). Only a program file is run: not an app or a config folder.
+std::string CliVersion(const std::string& path) {
+  base::FilePath file = base::FilePath::FromUTF8Unsafe(path);
+  if (path.empty() || base::DirectoryExists(file) || !base::PathExists(file)) {
+    return std::string();
+  }
+  std::vector<std::string> argv = {path, "--version"};
+#if BUILDFLAG(IS_WIN)
+  // A .cmd wrapper (npm's) needs the shell.
+  if (!base::EndsWith(path, ".exe", base::CompareCase::INSENSITIVE_ASCII)) {
+    std::string comspec =
+        base::Environment::Create()->GetVar("ComSpec").value_or(
+            "C:\\Windows\\System32\\cmd.exe");
+    argv = {comspec, "/d", "/c", path, "--version"};
+  }
+#endif
+  std::string out = ai::CaptureOutput(argv, ai::LoginEnvironment(),
+                                      base::GetHomeDir().AsUTF8Unsafe(),
+                                      base::Seconds(6));
+  std::vector<std::string_view> lines = base::SplitStringPiece(
+      out, "\r\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  return lines.empty() ? std::string()
+                       : std::string(lines.front().substr(0, 100));
+}
+
+struct FoundAgents {
+  std::vector<AgentCli> clis;
+  bool desktop_connected = false;
+};
+
+FoundAgents FindAgents() {
+  return {DetectAgentClis(), GetClaudeDesktopState().connected};
+}
+
+// Saves the report where the person chose; owns itself until then.
+class ReportSaver : public ui::SelectFileDialog::Listener {
+ public:
+  ReportSaver(std::string markdown,
+              base::OnceCallback<void(bool)> done)
+      : markdown_(std::move(markdown)), done_(std::move(done)) {}
+
+  void Ask(BrowserWindowInterface* browser) {
+    base::FilePath dir;
+    base::PathService::Get(chrome::DIR_DEFAULT_DOWNLOADS, &dir);
+    base::Time::Exploded now;
+    base::Time::Now().LocalExplode(&now);
+    const std::string name =
+        base::StringPrintf("Meridian report %04d-%02d-%02d.md", now.year,
+                           now.month, now.day_of_month);
+    ui::SelectFileDialog::FileTypeInfo types;
+    types.extensions = {{FILE_PATH_LITERAL("md")}};
+    types.include_all_files = true;
+    dialog_ = ui::SelectFileDialog::Create(
+        this, std::make_unique<ChromeSelectFilePolicy>(nullptr));
+    dialog_->SelectFile(
+        ui::SelectFileDialog::SELECT_SAVEAS_FILE, u"Save the report",
+        dir.Append(base::FilePath::FromUTF8Unsafe(name)), &types, 1,
+        FILE_PATH_LITERAL("md"),
+        browser && browser->GetWindow()
+            ? browser->GetWindow()->GetNativeWindow()
+            : gfx::NativeWindow());
+  }
+
+  void FileSelected(const ui::SelectedFileInfo& file, int) override {
+    Write(file.path());
+  }
+
+  void FileSelectionCanceled() override { Finish(false); }
+
+  void Write(const base::FilePath& path) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+        base::BindOnce(
+            [](base::FilePath path, std::string text) {
+              return base::WriteFile(path, text);
+            },
+            path, markdown_),
+        base::BindOnce(&ReportSaver::Finish, base::Unretained(this)));
+  }
+
+ private:
+  ~ReportSaver() override {
+    if (dialog_) {
+      dialog_->ListenerDestroyed();
+    }
+  }
+
+  void Finish(bool saved) {
+    std::move(done_).Run(saved);
+    delete this;
+  }
+
+  std::string markdown_;
+  base::OnceCallback<void(bool)> done_;
+  scoped_refptr<ui::SelectFileDialog> dialog_;
+};
+
+}  // namespace
+
+void SidebarHandler::GetReport(GetReportCallback callback) {
+  Profile* profile = browser_->GetProfile();
+  PrefService* prefs = profile->GetPrefs();
+  PrefService* main_prefs = MainProfileFor(profile)->GetPrefs();
+  report::Facts facts;
+  facts.version = update::kVersion;
+  facts.chromium_version = std::string(version_info::GetVersionNumber());
+  facts.os = OsName();
+  facts.arch = base::SysInfo::OperatingSystemArchitecture();
+  AiService* ai = AiServiceFactory::GetForProfile(profile);
+  const std::string chosen = prefs->GetString(prefs::kAiProvider);
+  const std::string label = ai ? ai->CurrentLabel() : std::string();
+  if (chosen.empty()) {
+    facts.ai_answers =
+        "Automatic (" + (label.empty() ? "nothing set up" : label) + ")";
+  } else {
+    facts.ai_answers = label.empty() ? chosen + " (not set up)" : label;
+  }
+  facts.agent_access = AccessName(main_prefs->GetString(prefs::kAgentAccess));
+  if (main_prefs->GetBoolean(prefs::kAgentAllowJs)) {
+    facts.agent_access += ", JavaScript allowed";
+  }
+  facts.ai_consent = ConsentName(prefs->GetString(prefs::kAiConsent));
+  facts.other_agents = prefs->GetBoolean(prefs::kAiOtherAgents);
+  facts.update = UpdateText(Updater::Get().State());
+  facts.agents_seen = report::AgentsSeen();
+  facts.errors = report::RecentErrors();
+  report::Private p = report::ThisComputer();
+  for (const std::string& name :
+       {prefs->GetString(prefs::kMemberName), SystemUserFullName()}) {
+    if (!name.empty()) {
+      p.names.push_back(name);
+    }
+  }
+
+  // The agents and their versions (blocking), then the AIs (Settings > AI).
+  auto with_ais = base::BindOnce(
+      [](base::WeakPtr<AiService> ai, report::Facts facts, report::Private p,
+         GetReportCallback callback, std::vector<report::Agent> agents) {
+        facts.agents = std::move(agents);
+        auto finish = base::BindOnce(
+            [](report::Facts facts, report::Private p,
+               GetReportCallback callback,
+               std::vector<ai::LocalAgents::Status> list) {
+              for (const ai::LocalAgents::Status& s : list) {
+                const ai::Provider* provider = ai::FindProvider(s.id);
+                if (!provider) {
+                  continue;
+                }
+                report::Ai a;
+                a.label = provider->label;
+                a.kind = provider->kind == ai::Kind::kCli     ? "cli"
+                         : provider->kind == ai::Kind::kCloud ? "cloud"
+                                                              : "local";
+                a.installed = s.installed;
+                a.signed_in = s.signed_in ? (*s.signed_in ? 1 : 0) : -1;
+                // A CLI's "account" is who is signed in: never in a report.
+                if (provider->kind != ai::Kind::kCli) {
+                  a.model = s.account;
+                }
+                a.unavailable = s.unavailable;
+                facts.ais.push_back(std::move(a));
+              }
+              std::move(callback).Run(report::Details(facts, p));
+            },
+            std::move(facts), std::move(p), std::move(callback));
+        if (!ai) {
+          std::move(finish).Run({});
+          return;
+        }
+        ai->local().List(/*fresh=*/false, std::move(finish));
+      },
+      ai ? ai->GetWeakPtr() : base::WeakPtr<AiService>(), std::move(facts),
+      std::move(p), std::move(callback));
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&FindAgents),
+      base::BindOnce(
+          [](base::OnceCallback<void(std::vector<report::Agent>)> done,
+             FoundAgents found) {
+            std::vector<report::Agent> agents;
+            for (const AgentCli& cli : found.clis) {
+              report::Agent a;
+              a.name = cli.name;
+              a.found = !cli.path.empty();
+              a.connected =
+                  cli.id == "claude-desktop" && found.desktop_connected;
+              agents.push_back(std::move(a));
+            }
+            // Each found CLI's --version at the same time.
+            auto collect = base::BarrierCallback<
+                std::pair<size_t, std::string>>(
+                found.clis.size(),
+                base::BindOnce(
+                    [](std::vector<report::Agent> agents,
+                       base::OnceCallback<void(std::vector<report::Agent>)>
+                           done,
+                       std::vector<std::pair<size_t, std::string>> versions) {
+                      for (auto& [i, version] : versions) {
+                        agents[i].version = std::move(version);
+                      }
+                      std::move(done).Run(std::move(agents));
+                    },
+                    std::move(agents), std::move(done)));
+            for (size_t i = 0; i < found.clis.size(); ++i) {
+              const AgentCli& cli = found.clis[i];
+              if (cli.path.empty() || cli.id == "claude-desktop") {
+                collect.Run({i, std::string()});
+                continue;
+              }
+              base::ThreadPool::PostTaskAndReplyWithResult(
+                  FROM_HERE,
+                  {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+                  base::BindOnce(
+                      [](size_t i, std::string path) {
+                        return std::make_pair(i, CliVersion(path));
+                      },
+                      i, cli.path),
+                  base::BindOnce(collect));
+            }
+          },
+          std::move(with_ais)));
+}
+
+void SidebarHandler::ScrubReport(const std::string& text,
+                                 ScrubReportCallback callback) {
+  report::Private p = report::ThisComputer();
+  for (const std::string& name :
+       {browser_->GetProfile()->GetPrefs()->GetString(prefs::kMemberName),
+        SystemUserFullName()}) {
+    if (!name.empty()) {
+      p.names.push_back(name);
+    }
+  }
+  std::move(callback).Run(report::Scrub(text, p));
+}
+
+void SidebarHandler::CopyReport(const std::string& markdown,
+                                CopyReportCallback callback) {
+  ScrubReport(markdown,
+              base::BindOnce(
+                  [](CopyReportCallback callback, const std::string& text) {
+                    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+                        .WriteText(base::UTF8ToUTF16(text));
+                    std::move(callback).Run(text);
+                  },
+                  std::move(callback)));
+}
+
+void SidebarHandler::SaveReport(const std::string& markdown,
+                                SaveReportCallback callback) {
+  ScrubReport(
+      markdown,
+      base::BindOnce(
+          [](base::WeakPtr<SidebarHandler> self, SaveReportCallback callback,
+             const std::string& text) {
+            auto* saver = new ReportSaver(text, std::move(callback));
+            if (HasTestSwitch("meridian-test-save-report")) {
+              saver->Write(TestSwitchPath("meridian-test-save-report"));
+              return;
+            }
+            saver->Ask(self ? self->browser_.get() : nullptr);
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
