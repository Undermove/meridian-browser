+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/report.h"
+
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::report {
+namespace {
+
+Private Mac() {
+  Private p;
+  p.home = "/Users/sasha";
+  p.names = {"sasha", "Alexandra Petrova"};
+  return p;
+}
+
+Private Windows() {
+  Private p;
+  p.home = "C:\\Users\\Sasha";
+  p.names = {"Sasha"};
+  return p;
+}
+
+bool Has(const std::string& text, const std::string& part) {
+  return text.find(part) != std::string::npos;
+}
+
+TEST(ReportScrubTest, HomeFolderBecomesTilde) {
+  const Private p = Mac();
+  EXPECT_EQ(Scrub("couldn't read /Users/sasha/.config/opencode/opencode.json",
+                  p),
+            "couldn't read ~/.config/opencode/opencode.json");
+  EXPECT_EQ(Scrub("cwd /private/Users/sasha/x", p), "cwd ~/x");
+  // Anyone's home folder, not only this one's.
+  EXPECT_EQ(Scrub("at /Users/someone/Library/x and /home/bob/.bashrc", p),
+            "at ~/Library/x and ~/.bashrc");
+  const Private w = Windows();
+  EXPECT_EQ(Scrub("spawn C:\\Users\\Sasha\\AppData\\npm\\opencode.cmd", w),
+            "spawn ~\\AppData\\npm\\opencode.cmd");
+  EXPECT_EQ(Scrub("open c:/users/Bob/x.json failed", w), "open ~/x.json failed");
+}
+
+TEST(ReportScrubTest, NoAddresses) {
+  const Private p = Mac();
+  EXPECT_EQ(Scrub("couldn't reach https://mail.example.com/inbox?id=7#top", p),
+            "couldn't reach [link]");
+  EXPECT_EQ(Scrub("file:///Users/sasha/secret.txt (wss://x.io/s)", p),
+            "[link] ([link])");
+  EXPECT_EQ(Scrub("chrome://settings/passwords", p), "[link]");
+  // A server on this computer keeps where it is, not what it was asked.
+  EXPECT_EQ(Scrub("Ollama at http://localhost:11434/api/chat?q=page", p),
+            "Ollama at http://localhost:11434");
+  EXPECT_EQ(Scrub("http://user:pw@127.0.0.1:1234/v1", p),
+            "http://127.0.0.1:1234");
+}
+
+TEST(ReportScrubTest, NoKeysOrTokens) {
+  const Private p = Mac();
+  const char* secrets[] = {
+      "sk-ant-api03-AbCdEf0123456789_xyz-QWERTY",
+      "sk-proj-1234567890abcdef",
+      "ghp_0123456789abcdefABCDEF0123456789abcd",
+      "github_pat_11ABCDEFG0123456789_abcdefghijklmnop",
+      "AIzaSyD-0123456789abcdefghijklmnopqrstu",
+      "xoxb-1234567890-abcdefghij",
+      "AKIAIOSFODNN7EXAMPLE",
+      "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0In0.c2lnbmF0dXJl",
+      "0123456789abcdef0123456789abcdef0123",
+      "dGhpcyBpcyBhIHNlY3JldCBrZXkgdGhhdCBpcyBsb25n+/x9==",
+  };
+  for (const char* secret : secrets) {
+    const std::string out = Scrub(std::string("key: ") + secret + " end", p);
+    EXPECT_FALSE(Has(out, secret)) << out;
+    EXPECT_TRUE(Has(out, "[hidden]")) << out;
+    EXPECT_TRUE(Has(out, " end")) << out;
+  }
+  EXPECT_EQ(Scrub("Authorization: Bearer abc.DEF-123_456", p),
+            "Authorization: Bearer [hidden]");
+  EXPECT_EQ(Scrub("OPENAI_API_KEY=hunter2 and \"api_key\": \"short1\"", p),
+            "OPENAI_API_KEY=[hidden] and \"api_key\": \"[hidden]\"");
+  EXPECT_EQ(Scrub("password=letmein;", p), "password=[hidden];");
+}
+
+TEST(ReportScrubTest, KeepsWhatHelps) {
+  const Private p = Mac();
+  const std::string plain =
+      "OpenCode exited with code 1: Error: model qwen2.5-coder-32b-instruct "
+      "not found (Meridian 1.1.0, Chromium 147.0.7727.15). Token limit "
+      "reached; ~/node_modules/@ai-sdk/openai-compatible/dist/index.js:42";
+  EXPECT_EQ(Scrub(plain, p), plain);
+}
+
+TEST(ReportScrubTest, NoEmailsOrNames) {
+  const Private p = Mac();
+  EXPECT_EQ(Scrub("Logged in as sasha.p+dev@gmail.com", p),
+            "Logged in as [email]");
+  EXPECT_EQ(Scrub("Hi Sasha, from Alexandra Petrova (sasha)", p),
+            "Hi [name], from [name] ([name])");
+  Private ru;
+  ru.names = {"Александра"};
+  EXPECT_EQ(Scrub("Привет, Александра!", ru), "Привет, [name]!");
+}
+
+TEST(ReportScrubTest, ScrubbingTwiceChangesNothing) {
+  const Private p = Mac();
+  const std::string once = Scrub(
+      "sasha at /Users/sasha/x https://a.b/c http://localhost:3000/x "
+      "Bearer abcdefgh sk-1234567890abc a@b.co token=xyz",
+      p);
+  EXPECT_EQ(Scrub(once, p), once);
+}
+
+TEST(ReportErrorsTest, KeepsTheLastLinesWithTimeAndSource) {
+  ResetForTesting();
+  NoteError("ask", "OpenCode took too long\nsecond line\n\n");
+  std::vector<std::string> lines = RecentErrors();
+  ASSERT_EQ(lines.size(), 2u);
+  EXPECT_TRUE(Has(lines[0], " ask: OpenCode took too long"));
+  EXPECT_TRUE(Has(lines[1], " ask: second line"));
+  for (size_t i = 0; i < kMaxErrorLines + 50; ++i) {
+    NoteError("log", "line " + std::to_string(i));
+  }
+  lines = RecentErrors();
+  ASSERT_EQ(lines.size(), kMaxErrorLines);
+  EXPECT_TRUE(Has(lines.back(), "line " + std::to_string(kMaxErrorLines + 49)));
+  NoteError("ask", std::string(2000, 'a'));
+  EXPECT_LE(RecentErrors().back().size(), 520u);
+  NoteAgent("Claude Code");
+  NoteAgent("Claude Code");
+  EXPECT_EQ(AgentsSeen(), std::vector<std::string>{"Claude Code"});
+  ResetForTesting();
+}
+
+TEST(ReportDetailsTest, SaysWhatMattersAndNothingPrivate) {
+  Facts f;
+  f.version = "1.1.0";
+  f.chromium_version = "147.0.7727.15";
+  f.os = "macOS 26.2";
+  f.arch = "arm64";
+  f.ai_answers = "OpenCode";
+  f.agent_access = "Ask before each action";
+  f.ai_consent = "Ask first";
+  f.ais = {{"Claude Code", "cli", true, 1, "", ""},
+           {"OpenCode", "cli", true, -1, "", ""},
+           {"Ollama", "local", true, -1, "llama3.2", ""},
+           {"Codex", "cli", false, -1, "", ""}};
+  f.agents = {{"OpenCode", true, false, "0.15.2"},
+              {"Claude Desktop", true, true, ""},
+              {"Cursor", false, false, ""}};
+  f.agents_seen = {"opencode"};
+  f.update = "Up to date";
+  f.errors = {"10:00:00 ask: OpenCode exited with code 1 at "
+              "/Users/sasha/.config/opencode with sk-ant-1234567890abcdef "
+              "on https://bank.example/account",
+              "10:00:01 log: ``` fence"};
+  const std::string md = Details(f, Mac());
+  EXPECT_TRUE(Has(md, "- Version: Meridian 1.1.0 (Chromium 147.0.7727.15)"));
+  EXPECT_TRUE(Has(md, "- System: macOS 26.2, arm64"));
+  EXPECT_TRUE(Has(md, "- Ask and Chat answer with: OpenCode"));
+  EXPECT_TRUE(Has(md, "- Agent access: Ask before each action"));
+  EXPECT_TRUE(Has(md, "- Claude Code (cli): installed, signed in"));
+  EXPECT_TRUE(Has(md, "- Ollama (local): installed, model llama3.2"));
+  EXPECT_TRUE(Has(md, "- Not set up: Codex"));
+  EXPECT_TRUE(Has(md, "- OpenCode: found, version 0.15.2"));
+  EXPECT_TRUE(Has(md, "- Claude Desktop: found, has Meridian"));
+  EXPECT_TRUE(Has(md, "- Used Meridian this session: opencode"));
+  EXPECT_TRUE(Has(md, "- Not found: Cursor"));
+  EXPECT_TRUE(Has(md, "The last 2 lines"));
+  EXPECT_TRUE(Has(md, "at ~/.config/opencode with [hidden] on [link]"));
+  EXPECT_FALSE(Has(md, "/Users/sasha"));
+  EXPECT_FALSE(Has(md, "bank.example"));
+  EXPECT_FALSE(Has(md, "sk-ant"));
+  EXPECT_TRUE(Has(md, "log: ''' fence"));
+}
+
+}  // namespace
+}  // namespace meridian::report
