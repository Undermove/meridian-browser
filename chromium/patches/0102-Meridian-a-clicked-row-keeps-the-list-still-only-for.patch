 .../webui_browser/meridian/sidebar.ts         | 39 ++++++++++++++-----
 1 file changed, 30 insertions(+), 9 deletions(-)

diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
index 9437af0c0d..76c2e195da 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
@@ -939,7 +939,7 @@ export class MeridianSidebarElement extends CrLitElement implements
     if (e.button !== 0 || this.isButton_(e)) {
       return;
     }
-    this.notePickedInView_(e);
+    this.notePickedInView_(e, {tab: tab.id});
     this.tabStripService_.activateTab(tab.id);
   }
 
@@ -951,15 +951,17 @@ export class MeridianSidebarElement extends CrLitElement implements
       this.handler_.setFolderOpen(item.id, !item.open);
       return;
     }
-    this.notePickedInView_(e);
+    this.notePickedInView_(e, {item: item.id});
     this.handler_.openItem(item.id);
   }
 
   // Arc: a row clicked where the list shows it whole stays where it is. A
   // pinned tab that isn't loaded shows in Today while it opens, then comes
-  // back: the list doesn't follow it there and back.
-  private pickedInView_ = 0;
-  private notePickedInView_(e: MouseEvent) {
+  // back: the list doesn't follow it there and back. Only that one: a tab
+  // made active afterwards (⌘⌥↓) is brought into sight as ever.
+  private pickedInView_: {at: number, tab?: NodeId, item?: string}|null = null;
+  private notePickedInView_(e: MouseEvent, picked: {tab?: NodeId, item?: string}) {
+    this.pickedInView_ = null;
     const page = this.shadowRoot.getElementById('spacePage');
     const row = e.currentTarget as HTMLElement | null;
     if (!page || !row?.getBoundingClientRect) {
@@ -967,8 +969,28 @@ export class MeridianSidebarElement extends CrLitElement implements
     }
     const v = page.getBoundingClientRect();
     const r = row.getBoundingClientRect();
-    this.pickedInView_ =
-        r.top >= v.top - 1 && r.bottom <= v.bottom + 1 ? performance.now() : 0;
+    if (r.top >= v.top - 1 && r.bottom <= v.bottom + 1) {
+      this.pickedInView_ = {at: performance.now(), ...picked};
+    }
+  }
+
+  // The active tab is the row just clicked where it was shown whole (a
+  // pinned tab's, or the one opening for it, which has no item yet).
+  private isPickedInView_(active: Tab): boolean {
+    const picked = this.pickedInView_;
+    if (!picked || performance.now() - picked.at > 2000) {
+      return false;
+    }
+    if (picked.tab !== undefined) {
+      return picked.tab === active.id;
+    }
+    const own = picked.item ? this.liveTab(picked.item) : null;
+    if (own) {
+      return own.id === active.id;
+    }
+    // Not in the state yet, or not with its item yet.
+    const info = this.state_?.tabs.find(t => t.tabId === active.id);
+    return !info?.itemId;
   }
 
   onCloseClick(e: Event, tab: Tab) {
@@ -1640,8 +1662,7 @@ export class MeridianSidebarElement extends CrLitElement implements
         this.sightSpaceId_ = this.shownSpaceId_;
         return;
       }
-      if (this.pickedInView_ &&
-          performance.now() - this.pickedInView_ < 2000) {
+      if (this.isPickedInView_(active)) {
         return;
       }
       row.scrollIntoView({block: 'nearest'});
