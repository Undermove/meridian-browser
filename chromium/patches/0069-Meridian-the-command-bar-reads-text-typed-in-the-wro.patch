diff --git a/chrome/browser/resources/webui_browser/meridian/layout_fix.ts b/chrome/browser/resources/webui_browser/meridian/layout_fix.ts
new file mode 100644
index 0000000000..069098ac23
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/layout_fix.ts
@@ -0,0 +1,123 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Text typed in the wrong keyboard layout ("ghbdtn" for "привет", "пщщпду"
+// for "google"): the same keys in the other layout (Russian ЙЦУКЕН and US
+// QWERTY), when its letters are much more like that language's than the typed
+// ones are like theirs (letter frequencies, per letter on average).
+
+const EN = '`qwertyuiop[]asdfghjkl;\'zxcvbnm,./';
+const RU = 'ёйцукенгшщзхъфывапролджэячсмитьбю.';
+
+// Letter frequencies, in percent.
+const EN_FREQ: Record<string, number> = {
+  e: 12.7, t: 9.06, a: 8.17, o: 7.51, i: 6.97, n: 6.75, s: 6.33, h: 6.09,
+  r: 5.99, d: 4.25, l: 4.03, c: 2.78, u: 2.76, m: 2.41, w: 2.36, f: 2.23,
+  g: 2.02, y: 1.97, p: 1.93, b: 1.29, v: 0.98, k: 0.77, j: 0.15, x: 0.15,
+  q: 0.10, z: 0.07,
+};
+const RU_FREQ: Record<string, number> = {
+  'о': 10.97, 'е': 8.45, 'а': 8.01, 'и': 7.35, 'н': 6.70, 'т': 6.26,
+  'с': 5.47, 'р': 4.73, 'в': 4.54, 'л': 4.40, 'к': 3.49, 'м': 3.21,
+  'д': 2.98, 'п': 2.81, 'у': 2.62, 'я': 2.01, 'ы': 1.90, 'ь': 1.74,
+  'г': 1.70, 'з': 1.65, 'б': 1.59, 'ч': 1.44, 'й': 1.21, 'х': 0.97,
+  'ж': 0.94, 'ш': 0.73, 'ю': 0.64, 'ц': 0.48, 'щ': 0.36, 'э': 0.32,
+  'ф': 0.26, 'ъ': 0.04, 'ё': 0.04,
+};
+
+// How much more likely the converted text has to be, in nats per letter.
+const MARGIN = 0.6;
+
+function convert(text: string, from: string, to: string): string {
+  let out = '';
+  for (const ch of text) {
+    const lower = ch.toLowerCase();
+    const i = from.indexOf(lower);
+    if (i < 0) {
+      out += ch;
+      continue;
+    }
+    const mapped = to[i]!;
+    out += ch === lower ? mapped : mapped.toUpperCase();
+  }
+  return out;
+}
+
+// The mean log-frequency of `text`'s letters; null without any.
+function score(text: string, freq: Record<string, number>): number|null {
+  let sum = 0;
+  let n = 0;
+  for (const ch of text.toLowerCase()) {
+    const f = freq[ch];
+    if (f !== undefined) {
+      sum += Math.log(f);
+      n++;
+    }
+  }
+  return n ? sum / n : null;
+}
+
+// Sites people type by name; with the open tabs' hosts they catch "пшерги"
+// (github), where letters alone can't tell.
+const SITES = [
+  'google', 'gmail', 'github', 'gitlab', 'youtube', 'yandex', 'wikipedia',
+  'facebook', 'instagram', 'twitter', 'reddit', 'linkedin', 'amazon',
+  'netflix', 'spotify', 'notion', 'figma', 'slack', 'telegram', 'whatsapp',
+  'chatgpt', 'openai', 'claude', 'anthropic', 'stackoverflow', 'medium',
+  'habr', 'translate', 'maps', 'drive', 'docs', 'calendar', 'outlook',
+  'apple', 'microsoft', 'booking', 'airbnb', 'ozon', 'wildberries', 'avito',
+  'kinopoisk', 'twitch', 'discord', 'zoom', 'jira', 'confluence', 'trello',
+];
+
+const EN_VOWELS = 'aeiouy';
+const RU_VOWELS = 'аеёиоуыэюя';
+
+function vowelShare(text: string, vowels: string): number {
+  const letters = text.toLowerCase().replace(/[^\p{L}]/gu, '');
+  return letters ?
+      [...letters].filter(ch => vowels.includes(ch)).length / letters.length :
+      0;
+}
+
+// What was meant, or '' when `text` looks typed in the right layout. `known`:
+// more names to recognise (the open tabs' hosts).
+export function fixLayout(text: string, known: string[] = []): string {
+  // Addresses and numbers are typed as they are.
+  if (/\d|:\/\/|\.\w{2,}(\/|$)/.test(text)) {
+    return '';
+  }
+  // Three letters are too few to tell ("sql").
+  const letters = text.replace(/[^\p{L}]/gu, '');
+  if (letters.length < 4) {
+    return '';
+  }
+  if (/^[a-z]+$/i.test(letters)) {
+    const ru = convert(text, EN, RU);
+    const vowels = vowelShare(text, EN_VOWELS);
+    const typed = score(text, EN_FREQ)!;
+    const other = score(ru, RU_FREQ)!;
+    // Russian vowels sit on English consonant keys: hardly any vowels left
+    // (and the Russian reads no worse: not "html", "strengths").
+    if (vowels < 0.15 && vowelShare(ru, RU_VOWELS) >= 0.25 &&
+        other >= typed) {
+      return ru;
+    }
+    return vowels < 0.3 && other - typed >= MARGIN ? ru : '';
+  }
+  if (/^[а-яё]+$/i.test(letters)) {
+    const en = convert(text, RU, EN);
+    const word = en.toLowerCase().replace(/[^a-z]/g, '');
+    if (word.length >= 4 &&
+        [...SITES, ...known].some(name => name.startsWith(word))) {
+      return en;
+    }
+    const typed = score(text, RU_FREQ)!;
+    const other = score(en, EN_FREQ)!;
+    return vowelShare(text, RU_VOWELS) < 0.4 &&
+            vowelShare(en, EN_VOWELS) >= 0.25 && other - typed >= MARGIN ?
+        en :
+        '';
+  }
+  return '';
+}
