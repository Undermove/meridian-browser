+bool OpenCodeWantsTextOnly(const base::FilePath& dir,
+                           const base::FilePath& state_file) {
+  // Both files, as OpenCode merges them (the .jsonc one may have comments).
+  std::vector<std::string> configs;
+  for (const char* name : {"opencode.json", "opencode.jsonc"}) {
+    std::string text;
+    if (base::ReadFileToStringWithMaxSize(dir.AppendASCII(name), &text,
+                                          1 << 20)) {
+      configs.push_back(std::move(text));
+    }
+  }
+  base::FilePath state = state_file;
+  if (state.empty()) {
+    std::unique_ptr<base::Environment> env = base::Environment::Create();
+    const std::string xdg = env->GetVar("XDG_STATE_HOME").value_or("");
+    state = (xdg.empty() ? base::GetHomeDir().AppendASCII(".local/state")
+                         : base::FilePath::FromUTF8Unsafe(xdg))
+                .AppendASCII("opencode/model.json");
+  }
+  std::string state_json;
+  base::ReadFileToStringWithMaxSize(state, &state_json, 1 << 20);
+  return ai::OpenCodeModelTakesNoImages(
+      configs, ai::OpenCodeChosenModel(configs, state_json));
 }
 
