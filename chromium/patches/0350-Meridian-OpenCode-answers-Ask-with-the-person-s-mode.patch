+namespace {
+
+std::optional<base::DictValue> ReadJsonc(const std::string& text) {
+  return base::JSONReader::ReadDict(
+      text, base::JSON_ALLOW_COMMENTS | base::JSON_ALLOW_TRAILING_COMMAS);
+}
+
+// "provider/model", both parts there.
+bool IsModelRef(const std::string& model) {
+  const size_t slash = model.find('/');
+  return slash != std::string::npos && slash > 0 && slash + 1 < model.size();
+}
+
+}  // namespace
+
+std::string OpenCodeChosenModel(const std::vector<std::string>& configs,
+                                const std::string& state_json) {
+  std::string model;
+  for (const std::string& text : configs) {
+    std::optional<base::DictValue> root = ReadJsonc(text);
+    const std::string* m = root ? root->FindString("model") : nullptr;
+    if (m && IsModelRef(*m)) {
+      model = *m;
+    }
+  }
+  if (!model.empty()) {
+    return model;
+  }
+  std::optional<base::DictValue> state = ReadJsonc(state_json);
+  const base::ListValue* recent = state ? state->FindList("recent") : nullptr;
+  if (recent && !recent->empty() && recent->front().is_dict()) {
+    const base::DictValue& last = recent->front().GetDict();
+    const std::string* provider = last.FindString("providerID");
+    const std::string* id = last.FindString("modelID");
+    if (provider && id && IsModelRef(*provider + "/" + *id)) {
+      return *provider + "/" + *id;
+    }
+  }
+  return std::string();
+}
+
+bool OpenCodeModelTakesNoImages(const std::vector<std::string>& configs,
+                                const std::string& model) {
+  if (!IsModelRef(model)) {
+    return false;
+  }
+  const size_t slash = model.find('/');
+  const std::string provider_id = model.substr(0, slash);
+  const std::string model_id = model.substr(slash + 1);
+  // The later file wins, as in OpenCode.
+  std::optional<bool> no_images;
+  for (const std::string& text : configs) {
+    std::optional<base::DictValue> root = ReadJsonc(text);
+    const base::DictValue* providers =
+        root ? root->FindDict("provider") : nullptr;
+    const base::DictValue* provider =
+        providers ? providers->FindDict(provider_id) : nullptr;
+    if (!provider) {
+      continue;
+    }
+    // OpenCode 1 says "npm", 2 "package".
+    const std::string* package = provider->FindString("npm");
+    if (!package) {
+      package = provider->FindString("package");
+    }
+    const base::DictValue* models = provider->FindDict("models");
+    const base::DictValue* entry =
+        models ? models->FindDict(model_id) : nullptr;
+    if (!package || package->find("openai-compatible") == std::string::npos ||
+        !entry) {
+      no_images = false;
+      continue;
+    }
+    const base::ListValue* input =
+        entry->FindListByDottedPath("modalities.input");
+    if (!input) {
+      input = entry->FindListByDottedPath("capabilities.input");
+    }
+    bool image = false;
+    if (input) {
+      for (const base::Value& kind : *input) {
+        image |= kind.is_string() && kind.GetString().starts_with("image");
+      }
+    }
+    no_images = !image;
+  }
+  return no_images.value_or(false);
+}
