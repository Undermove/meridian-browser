+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_SETUP_PROFILE_H_
+#define CHROME_BROWSER_MERIDIAN_SETUP_PROFILE_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "chrome/browser/meridian/sidebar_service.h"
+
+namespace meridian {
+
+// "Let's make it yours" in the welcome tour: a starting setup (spaces and
+// favorites) guessed from the apps installed on this computer, with simple
+// rules. It runs locally; nothing is sent anywhere.
+struct SetupProposal {
+  SetupProposal();
+  SetupProposal(const SetupProposal&);
+  SetupProposal& operator=(const SetupProposal&);
+  ~SetupProposal();
+
+  std::string persona;  // developer, designer, manager or everyday
+  std::string mode;     // developer, creative or everyday
+  std::string title;
+  std::string color;
+  std::vector<Space> spaces;      // name, icon and colour only
+  std::vector<Item> favorites;    // links
+  std::vector<std::string> seen;  // notable apps found, to show back
+};
+
+// Names of the installed apps (blocking: reads /Applications and the like).
+std::vector<std::string> InstalledApps();
+
+// `persona` empty: guessed from `apps`. `locale` picks Russian names.
+SetupProposal ProposeSetup(const std::vector<std::string>& apps,
+                           std::string_view locale,
+                           std::string_view persona = {});
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_SETUP_PROFILE_H_
