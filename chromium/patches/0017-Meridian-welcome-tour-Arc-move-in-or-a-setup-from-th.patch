new file mode 100644
index 0000000000..4fb6402e9a
--- /dev/null
+++ b/chrome/browser/meridian/setup_profile_unittest.cc
@@ -0,0 +1,52 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/setup_profile.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+std::vector<std::string> Titles(const std::vector<Item>& items) {
+  std::vector<std::string> out;
+  for (const Item& item : items) {
+    out.push_back(item.title);
+  }
+  return out;
+}
+
+TEST(SetupProfileTest, GuessesFromInstalledApps) {
+  SetupProposal dev =
+      ProposeSetup({"Calculator", "Slack", "Visual Studio Code"}, "en-US");
+  EXPECT_EQ(dev.persona, "developer");
+  EXPECT_EQ(dev.mode, "developer");
+  EXPECT_EQ(Titles(dev.favorites),
+            (std::vector<std::string>{"GitHub", "Linear", "Slack", "Claude"}));
+  EXPECT_EQ(dev.seen, (std::vector<std::string>{"Slack", "Visual Studio Code"}));
+
+  EXPECT_EQ(ProposeSetup({"Figma"}, "en").persona, "designer");
+  SetupProposal manager = ProposeSetup({"Microsoft Outlook", "Zoom"}, "en");
+  EXPECT_EQ(manager.persona, "manager");
+  EXPECT_EQ(manager.favorites[0].title, "Outlook");
+  EXPECT_EQ(manager.favorites[2].title, "Microsoft Teams");
+}
+
+TEST(SetupProfileTest, EverydayInTheirLanguage) {
+  SetupProposal p = ProposeSetup({"Calculator"}, "ru-RU");
+  EXPECT_EQ(p.persona, "everyday");
+  ASSERT_EQ(p.spaces.size(), 1u);
+  EXPECT_EQ(p.spaces[0].name, "Личное");
+  EXPECT_EQ(p.favorites.back().title, "Telegram");
+  EXPECT_EQ(p.favorites[0].url, GURL("https://mail.google.com/"));
+  EXPECT_TRUE(p.seen.empty());
+}
+
+TEST(SetupProfileTest, PersonaOverridesTheGuess) {
+  EXPECT_EQ(ProposeSetup({"Xcode"}, "en", "designer").persona, "designer");
+  EXPECT_EQ(ProposeSetup({"Xcode"}, "en", "bogus").persona, "developer");
+}
+
+}  // namespace
+}  // namespace meridian
