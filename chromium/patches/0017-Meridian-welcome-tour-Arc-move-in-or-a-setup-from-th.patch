+void SidebarHandler::ProposeSetup(bool use_apps,
+                                  ProposeSetupCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](bool use_apps, std::string locale) {
+            return meridian::ProposeSetup(
+                use_apps ? InstalledApps() : std::vector<std::string>(),
+                locale);
+          },
+          use_apps, base::i18n::GetConfiguredLocale()),
+      base::BindOnce(
+          [](ProposeSetupCallback callback, SetupProposal p) {
+            auto out = mojom::SetupProposal::New();
+            out->title = p.title;
+            out->mode = p.mode;
+            for (const Space& space : p.spaces) {
+              auto s = mojom::Space::New();
+              s->name = space.name;
+              s->icon = space.icon;
+              s->color = space.color;
+              s->color2 = space.color2;
+              out->spaces.push_back(std::move(s));
+            }
+            for (const Item& item : p.favorites) {
+              out->favorites.push_back(ToMojo(item));
+            }
+            out->seen_apps = p.seen;
+            std::move(callback).Run(std::move(out));
+          },
+          std::move(callback)));
+}
+
+void SidebarHandler::ApplySetup(std::vector<mojom::SpacePtr> spaces,
+                                std::vector<mojom::ItemPtr> favorites,
+                                const std::string& mode) {
+  std::vector<Space> chosen;
+  for (const mojom::SpacePtr& s : spaces) {
+    Space space;
+    space.name = s->name.substr(0, 40);
+    space.icon = s->icon.substr(0, 16);
+    space.color = s->color;
+    space.color2 = s->color2;
+    chosen.push_back(std::move(space));
+  }
+  std::vector<Item> links;
+  for (const mojom::ItemPtr& f : favorites) {
+    if (!f->is_folder && f->url.SchemeIsHTTPOrHTTPS()) {
+      Item item;
+      item.title = f->title.substr(0, 200);
+      item.url = f->url;
+      links.push_back(std::move(item));
+    }
+  }
+  // The tour's spaces replace the untouched first space; tabs already open
+  // in it follow to the first new space.
+  std::string old_active = service_->active_space_id();
+  service_->Import(chosen, std::move(links));
+  if (!chosen.empty() && !service_->FindSpace(old_active)) {
+    for (int i = 0; i < model()->count(); ++i) {
+      content::WebContents* contents = model()->GetWebContentsAt(i);
+      const TabData* data = TabData::Get(contents);
+      if (data && data->space_id() == old_active) {
+        TabData::Set(contents, chosen[0].id, data->item_id());
+      }
+    }
+  }
+  if (mode == "everyday" || mode == "creative" || mode == "developer") {
+    browser_->GetProfile()->GetPrefs()->SetString(prefs::kMode, mode);
+  }
+  ScheduleNotify();
+}
+
+void SidebarHandler::FinishOnboarding() {
+  browser_->GetProfile()->GetPrefs()->SetBoolean(prefs::kOnboarded, true);
+  ScheduleNotify();
+}
