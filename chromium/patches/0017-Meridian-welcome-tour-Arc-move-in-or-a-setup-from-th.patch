+
+export function getHtml(this: MeridianOnboardingElement) {
+  return html`<!--_html_template_start_-->
+<div id="root" data-step="${this.step_}" @keydown="${this.onRootKeydown_}">
+  <div class="bg"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
+  <div class="top">
+    <div class="grow"></div>
+    <button id="skip" class="skip" ?hidden="${this.step_ === 'done'}"
+        @click="${this.onSkipClick_}">Skip</button>
+  </div>
+  <div class="stage">
+    ${repeat([this.step_], s => s, () => html`
+      <div class="page step-${this.step_}">
+        ${this.step_ === 'hello' ? html`
+          <div class="hello">
+            <div class="hello-word" aria-live="polite">
+              ${repeat([this.hello_], w => w, w => html`<span>${w}</span>`)}
+            </div>
+            <div class="hello-mark">
+              <svg width="26" height="26" viewBox="0 7 64 64" class="logo">
+                <path d="M10 50 A26 26 0 0 1 54 50" fill="none"
+                    stroke="currentColor" stroke-width="6"
+                    stroke-linecap="round"/>
+                <circle cx="32" cy="50" r="4.5" fill="currentColor"/>
+              </svg>
+              <span>Meridian</span>
+            </div>
+          </div>` : ''}
+
+        ${this.step_ === 'arc' && this.arc_ ? html`
+          <h2>Bring everything from Arc</h2>
+          <p class="whisper top">Your spaces, pinned tabs and favorites move
+            over as they are. Arc stays untouched.</p>
+          <div class="arc-move">
+            <div class="arc-stats">
+              <b>${this.arc_.spaceCount} spaces</b>
+              <b>${this.arcTabs_} tabs</b>
+              <b>${this.arc_.favoriteCount} favorites</b>
+            </div>
+            <div class="arc-spaces">
+              ${this.arcSpaces_.map(s => html`
+                <span class="space" style="--c:${s.color}">
+                  ${s.icon ? html`<em>${s.icon}</em>` : html`<i></i>`}
+                  ${s.name}
+                </span>`)}
+            </div>
+            ${this.arc_.loginsAvailable ? html`
+              <button id="logins" class="opt ${this.withLogins_ ? 'on' : ''}"
+                  @click="${this.onLoginsClick_}">
+                <span class="opt-ic">${icon('lock', 16)}</span>
+                <span><b>Stay signed in to your sites</b>
+                  <em>So you don’t have to log in everywhere again</em></span>
+                <span class="tick">${icon('check', 13)}</span>
+              </button>` : ''}
+          </div>
+          ${this.canStartFresh_ ? html`
+            <button id="fresh" class="link" @click="${this.onFreshClick_}">
+              Start fresh instead</button>` : ''}
+          ${this.note_ ? html`<p class="whisper">${this.note_}</p>` : ''}
+        ` : ''}
+
+        ${this.step_ === 'arc' && !this.arc_ ? html`
+          <h2>Arc isn’t on this Mac</h2>
+          <p class="whisper">There is nothing to bring over.</p>` : ''}
+
+        ${this.step_ === 'tailor' ? html`
+          <h2>Let’s make it yours</h2>
+          <div class="tailor">
+            <div class="consent" ?hidden="${this.thinking_}">
+              <button id="useApps" class="pill ${this.useApps_ ? 'on' : ''}"
+                  @click="${this.onUseAppsClick_}">
+                ${icon('grid', 15)} Look at the apps I use
+              </button>
+            </div>
+            <div class="think" ?hidden="${!this.thinking_}">
+              <div class="orb"><i></i><i></i><i></i></div>
+              <ul class="lines">
+                ${this.lines_.map((line, i) => html`
+                  <li class="${i === this.lines_.length - 1 &&
+                               this.proposal_ ? 'final' : ''}">${line}</li>`)}
+              </ul>
+            </div>
+          </div>
+          <p class="whisper">Meridian suggests spaces and favorites that fit
+            you. This happens on your computer — nothing is sent anywhere, and
+            nothing changes until you say so.</p>` : ''}
+
+        ${this.step_ === 'preview' ? html`
+          <div class="preview-title">
+            <span class="persona">${this.persona_}</span>
+            <h2>Here’s your Meridian</h2>
+          </div>
+          <div class="pv-window">
+            <div class="pv-side">
+              <div class="pv-url"></div>
+              <div class="pv-favs">
+                ${this.tiles_.map(t => html`
+                  <button class="pv-fav ${t.off ? 'off' : ''}" title="${t.title}"
+                      data-index="${t.index}" @click="${this.onTileClick_}">
+                    <span class="fav" style="--c:${t.color}">${t.letter}</span>
+                  </button>`)}
+              </div>
+              <div class="pv-spaces">
+                ${this.chips_.map(s => html`
+                  <button class="pv-space ${s.off ? 'off' : ''}"
+                      style="--c:${s.color}" data-index="${s.index}"
+                      @click="${this.onChipClick_}">
+                    <em>${s.icon}</em>${s.name}
+                  </button>`)}
+              </div>
+              <div class="pv-rows"><i></i><i></i><i class="s"></i></div>
+            </div>
+            <div class="pv-page"><i class="w60"></i><i></i><i class="w80"></i>
+            </div>
+          </div>
+          <p class="whisper">Tap anything to leave it out.</p>` : ''}
+
+        ${this.step_ === 'default' ? html`
+          <div class="hero">
+            <div class="mark">${icon('link', 46)}</div>
+            <h2>Open your links in Meridian?</h2>
+            <p class="whisper">Links from Mail, Slack, Notion and other apps
+              will open here instead of your old browser. You can change this
+              any time.</p>
+            <button id="useMeridian" class="btn primary big default-btn"
+                @click="${this.onDefaultClick_}">
+              ${icon('check', 16)} Yes, use Meridian
+            </button>
+          </div>` : ''}
+
+        ${this.step_ === 'done' ? html`
+          <div class="hero">
+            <div class="mark done">${icon('check', 54)}</div>
+            <h1>You’re all set</h1>
+            <p class="whisper">Press <kbd>⌘</kbd><kbd>T</kbd> to open a new tab
+              or find anything you had open.</p>
+            ${this.note_ ? html`<p class="whisper">${this.note_}</p>` : ''}
+          </div>` : ''}
+      </div>`)}
+  </div>
+  <div class="foot">
+    <button id="back" class="btn ghost"
+        ?hidden="${this.stepIndex_ === 0 || this.step_ === 'done'}"
+        @click="${this.onBackClick_}">${icon('arrowLeft', 16)}</button>
+    <div class="dots">
+      ${this.dots_.map(d => html`
+        <button class="dot ${d.cls}" data-index="${d.index}"
+            aria-label="Step ${d.index + 1}" @click="${this.onDotClick_}">
+        </button>`)}
+    </div>
+    <button id="next"
+        class="btn primary ${this.step_ === 'hello' ? 'round' : ''}
+            ${this.busy_ ? 'busy' : ''}"
+        ?disabled="${!!this.busy_}" @click="${this.onNextClick_}">
+      ${this.step_ === 'hello' ? html`${icon('arrowRight', 18)}` :
+                                 html`${this.nextLabel_}`}
+    </button>
+  </div>
+  ${this.confirmLogins_ ? html`
+    <div class="confirm" role="dialog" aria-modal="true">
+      <div class="card">
+        <h3>Your Mac will ask for permission</h3>
+        <p>To keep you signed in to your sites, Meridian copies Arc’s sign-ins.
+          Your Mac will ask once whether Meridian may read them: click
+          <b>Always Allow</b> (and type your Mac password if asked).</p>
+        <p>Nothing leaves your computer, and Arc stays as it is. Saved
+          passwords aren’t copied.</p>
+        <div class="card-actions">
+          <button id="confirmCancel" class="btn ghost"
+              @click="${this.onConfirmCancelClick_}">Cancel</button>
+          <button id="confirmContinue" class="btn primary"
+              @click="${this.onConfirmContinueClick_}">Continue</button>
+        </div>
+      </div>
+    </div>` : ''}
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/onboarding.ts b/chrome/browser/resources/webui_browser/meridian/onboarding.ts
new file mode 100644
index 0000000000..066a576e9b
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/onboarding.ts
@@ -0,0 +1,430 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The welcome tour, full window (in the spirit of a new Mac's first launch).
+// It is about moving in:
+//   Arc found:  hello → Bring everything from Arc → links → All set
+//   no Arc:     hello → Make it yours (from the apps on this computer, worked
+//               out locally) → Here's your Meridian → links → All set
+// Help > Welcome Tour runs it again; File > Import from Arc opens its Arc step.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {ArcPreview, Item, SetupProposal, SidebarHandlerInterface, Space} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './onboarding.css.js';
+import {getHtml} from './onboarding.html.js';
+
+export type StepName = 'hello'|'arc'|'tailor'|'preview'|'default'|'done';
+
+const HELLOS = [
+  'hello', 'привет', 'hola', 'bonjour', 'hallo', 'ciao', 'olá', 'გამარჯობა',
+  'merhaba', 'hej', 'こんにちは', '你好',
+];
+
+const FAV_COLORS: Record<string, string> = {
+  'Gmail': '#ea4335',
+  'Google Calendar': '#4285f4',
+  'Google Docs': '#4285f4',
+  'Google Maps': '#34a853',
+  'Notion': '#111',
+  'Slack': '#4a154b',
+  'Linear': '#5e6ad2',
+  'Figma': '#a259ff',
+  'GitHub': '#24292f',
+  'Telegram': '#2aabee',
+  'WhatsApp': '#25d366',
+  'YouTube': '#ff0000',
+  'Claude': '#d97757',
+  'Dribbble': '#ea4c89',
+  'Pinterest': '#e60023',
+  'Outlook': '#0078d4',
+  'Microsoft Teams': '#6264a7',
+};
+
+export interface Dot {
+  index: number;
+  cls: string;
+}
+
+export interface FavTile {
+  index: number;
+  title: string;
+  letter: string;
+  color: string;
+  off: boolean;
+}
+
+export interface SpaceChip {
+  index: number;
+  name: string;
+  icon: string;
+  color: string;
+  off: boolean;
+}
+
+export class MeridianOnboardingElement extends CrLitElement {
+  static get is() {
+    return 'meridian-onboarding';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      step_: {state: true, type: String},
+      steps_: {state: true, type: Array},
+      arc_: {state: true, type: Object},
+      withLogins_: {state: true, type: Boolean},
+      confirmLogins_: {state: true, type: Boolean},
+      proposal_: {state: true, type: Object},
+      pickedSpaces_: {state: true, type: Array},
+      pickedFavorites_: {state: true, type: Array},
+      busy_: {state: true, type: String},
+      hello_: {state: true, type: String},
+      lines_: {state: true, type: Array},
+      thinking_: {state: true, type: Boolean},
+      useApps_: {state: true, type: Boolean},
+      note_: {state: true, type: String},
+      dots_: {state: true, type: Array},
+      stepIndex_: {state: true, type: Number},
+      nextLabel_: {state: true, type: String},
+      arcSpaces_: {state: true, type: Array},
+      tiles_: {state: true, type: Array},
+      chips_: {state: true, type: Array},
+      persona_: {state: true, type: String},
+      arcTabs_: {state: true, type: Number},
+      canStartFresh_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  protected accessor step_: StepName = 'hello';
+  protected accessor steps_: StepName[] = [];
+  protected accessor arc_: ArcPreview|null = null;
+  protected accessor withLogins_: boolean = true;
+  protected accessor confirmLogins_: boolean = false;
+  protected accessor proposal_: SetupProposal|null = null;
+  protected accessor pickedSpaces_: boolean[] = [];
+  protected accessor pickedFavorites_: boolean[] = [];
+  // The Continue button's label while it works ('' when idle).
+  protected accessor busy_: string = '';
+  protected accessor hello_: string = HELLOS[0]!;
+  protected accessor lines_: string[] = [];
+  protected accessor thinking_: boolean = false;
+  protected accessor useApps_: boolean = true;
+  // A line under the Arc step after an import (e.g. sign-ins not brought).
+  protected accessor note_: string = '';
+
+  // Derived in willUpdate() for the template.
+  protected accessor dots_: Dot[] = [];
+  protected accessor stepIndex_: number = 0;
+  protected accessor nextLabel_: string = 'Continue';
+  protected accessor arcSpaces_: SpaceChip[] = [];
+  protected accessor tiles_: FavTile[] = [];
+  protected accessor chips_: SpaceChip[] = [];
+  protected accessor persona_: string = '';
+  protected accessor arcTabs_: number = 0;
+  protected accessor canStartFresh_: boolean = false;
+
+  private readonly handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  private isDefault_: boolean = false;
+  private fresh_: boolean = false;
+  private helloTimer_: number|null = null;
+
+  // `start`: 'arc' opens straight at the Arc step (File > Import from Arc).
+  async show(start: 'tour'|'arc' = 'tour') {
+    if (this.open) {
+      return;
+    }
+    const [{preview}, {isDefault}] = await Promise.all([
+      this.handler_.getArcPreview(),
+      this.handler_.isDefaultBrowser(),
+    ]);
+    this.arc_ = preview;
+    this.isDefault_ = isDefault;
+    this.fresh_ = false;
+    this.withLogins_ = !!preview?.loginsAvailable;
+    this.confirmLogins_ = false;
+    this.proposal_ = null;
+    this.lines_ = [];
+    this.thinking_ = false;
+    this.useApps_ = true;
+    this.note_ = '';
+    this.busy_ = '';
+    this.steps_ = start === 'arc' ? ['arc', 'done'] : this.tourSteps_();
+    this.step_ = this.steps_[0]!;
+    this.open = true;
+    this.startHello_();
+  }
+
+  private tourSteps_(): StepName[] {
+    const steps: StepName[] = ['hello'];
+    steps.push(...(this.arc_ && !this.fresh_ ? ['arc' as const] :
+                                             ['tailor' as const,
+                                              'preview' as const]));
+    if (!this.isDefault_) {
+      steps.push('default');
+    }
+    steps.push('done');
+    return steps;
+  }
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    this.stepIndex_ = this.steps_.indexOf(this.step_);
+    this.dots_ = this.steps_.map((_, index) => ({
+                                   index,
+                                   cls: index === this.stepIndex_ ? 'on' :
+                                       index < this.stepIndex_    ? 'past' :
+                                                                    '',
+                                 }));
+    this.nextLabel_ = this.busy_ || {
+      hello: '',
+      arc: this.arc_ ? 'Bring everything' : 'Continue',
+      tailor: 'Suggest a setup',
+      preview: 'Looks great',
+      default: 'Not now',
+      done: 'Start browsing',
+    }[this.step_];
+    this.arcTabs_ = (this.arc_?.pinnedCount || 0) + (this.arc_?.todayCount || 0);
+    this.canStartFresh_ = this.steps_.includes('hello');
+    this.arcSpaces_ = (this.arc_?.spaces || []).map(
+        (s, index) => ({index, name: s.name, icon: s.icon,
+                        color: s.color || '#8a8fe0', off: false}));
+    const p = this.proposal_;
+    this.persona_ = p?.title || '';
+    this.tiles_ = (p?.favorites || []).map((f, index) => ({
+                                             index,
+                                             title: f.title,
+                                             letter: f.title.charAt(0),
+                                             color: FAV_COLORS[f.title] ||
+                                                 '#8a8fe0',
+                                             off: !this.pickedFavorites_[index],
+                                           }));
+    this.chips_ = (p?.spaces || []).map((s, index) => ({
+                                          index,
+                                          name: s.name,
+                                          icon: s.icon,
+                                          color: s.color,
+                                          off: !this.pickedSpaces_[index],
+                                        }));
+  }
+
+  override updated(changed: PropertyValues<this>) {
+    super.updated(changed);
+    if (changed.has('step_' as keyof MeridianOnboardingElement) && this.open) {
+      this.shadowRoot.querySelector<HTMLElement>('#next')?.focus();
+    }
+  }
+
+  private startHello_() {
+    this.stopHello_();
+    let i = 0;
+    this.helloTimer_ = setInterval(() => {
+      i = (i + 1) % HELLOS.length;
+      this.hello_ = HELLOS[i]!;
+    }, 2600);
+  }
+
+  private stopHello_() {
+    if (this.helloTimer_ !== null) {
+      clearInterval(this.helloTimer_);
+      this.helloTimer_ = null;
+    }
+  }
+
+  private goTo_(step: StepName) {
+    this.busy_ = '';
+    this.step_ = step;
+  }
+
+  private advance_() {
+    const next = this.steps_[this.stepIndex_ + 1];
+    if (next) {
+      this.goTo_(next);
+    } else {
+      this.finish_();
+    }
+  }
+
+  private finish_() {
+    this.stopHello_();
+    this.open = false;
+    this.handler_.finishOnboarding();
+  }
+
+  // ------------------------------------------------------------ events
+
+  protected onSkipClick_() {
+    this.finish_();
+  }
+
+  protected onBackClick_() {
+    const previous = this.steps_[this.stepIndex_ - 1];
+    if (previous && !this.busy_) {
+      this.goTo_(previous);
+    }
+  }
+
+  protected onDotClick_(e: Event) {
+    const index = Number((e.currentTarget as HTMLElement).dataset['index']);
+    if (index < this.stepIndex_ && !this.busy_) {
+      this.goTo_(this.steps_[index]!);
+    }
+  }
+
+  protected onRootKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape' && this.confirmLogins_) {
+      this.confirmLogins_ = false;
+    }
+  }
+
+  protected async onNextClick_() {
+    if (this.busy_) {
+      return;
+    }
+    switch (this.step_) {
+      case 'arc':
+        return this.arc_ ? this.bringArc_() : this.advance_();
+      case 'tailor':
+        return this.suggest_();
+      case 'preview':
+        return this.applyProposal_();
+      default:
+        return this.advance_();
+    }
+  }
+
+  protected onLoginsClick_() {
+    this.withLogins_ = !this.withLogins_;
+  }
+
+  protected onFreshClick_() {
+    this.fresh_ = true;
+    this.steps_ = this.tourSteps_();
+    this.goTo_('tailor');
+  }
+
+  protected onUseAppsClick_() {
+    this.useApps_ = !this.useApps_;
+  }
+
+  protected onTileClick_(e: Event) {
+    const i = Number((e.currentTarget as HTMLElement).dataset['index']);
+    const picks = [...this.pickedFavorites_];
+    picks[i] = !picks[i];
+    this.pickedFavorites_ = picks;
+  }
+
+  protected onChipClick_(e: Event) {
+    const i = Number((e.currentTarget as HTMLElement).dataset['index']);
+    const picks = [...this.pickedSpaces_];
+    picks[i] = !picks[i];
+    this.pickedSpaces_ = picks;
+  }
+
+  protected async onDefaultClick_() {
+    if (this.busy_) {
+      return;
+    }
+    this.busy_ = 'One moment…';
+    const {isDefault} = await this.handler_.setDefaultBrowser();
+    this.busy_ = '';
+    if (isDefault) {
+      this.advance_();
+    }
+  }
+
+  protected onConfirmCancelClick_() {
+    this.confirmLogins_ = false;
+  }
+
+  protected onConfirmContinueClick_() {
+    this.confirmLogins_ = false;
+    this.bringArc_(/*confirmed=*/ true);
+  }
+
+  // ------------------------------------------------------------ actions
+
+  private async bringArc_(confirmed = false) {
+    // Reading Arc's sign-ins makes macOS ask; say so first.
+    if (this.withLogins_ && this.arc_?.loginsAvailable && !confirmed) {
+      this.confirmLogins_ = true;
+      return;
+    }
+    this.busy_ = 'Moving in…';
+    const {ok} = await this.handler_.importArc();
+    if (ok && this.withLogins_ && this.arc_?.loginsAvailable) {
+      const {imported, error} = await this.handler_.importArcLogins();
+      this.note_ = error === 'denied' ?
+          'Sign-ins weren’t brought over. You can try again from File > Import from Arc.' :
+          error ? 'Arc’s sign-ins couldn’t be read.' :
+                  `You’re still signed in to your sites (${
+                      imported.toLocaleString()} sign-ins brought over).`;
+    }
+    this.advance_();
+  }
+
+  private async suggest_() {
+    this.busy_ = 'One moment…';
+    this.thinking_ = true;
+    this.lines_ = this.useApps_ ? ['Looking at your apps…'] : [];
+    const [{proposal}] = await Promise.all([
+      this.handler_.proposeSetup(this.useApps_),
+      new Promise(r => setTimeout(r, 1500)),
+    ]);
+    if (!this.open || this.step_ !== 'tailor') {
+      return;
+    }
+    if (proposal.seenApps.length) {
+      this.lines_ = [
+        ...this.lines_,
+        `Found ${proposal.seenApps.slice(0, 4).join(', ')}${
+            proposal.seenApps.length > 4 ? '…' : ''}`,
+      ];
+    }
+    await new Promise(r => setTimeout(r, 600));
+    this.lines_ = [...this.lines_, proposal.title];
+    this.proposal_ = proposal;
+    this.pickedSpaces_ = proposal.spaces.map(() => true);
+    this.pickedFavorites_ = proposal.favorites.map(() => true);
+    await new Promise(r => setTimeout(r, 1000));
+    if (this.open && this.step_ === 'tailor') {
+      this.thinking_ = false;
+      this.advance_();
+    }
+  }
+
+  private applyProposal_() {
+    const p = this.proposal_;
+    if (!p) {
+      return this.advance_();
+    }
+    this.busy_ = 'Setting up…';
+    const spaces: Space[] = p.spaces.filter((_, i) => this.pickedSpaces_[i]);
+    const favorites: Item[] =
+        p.favorites.filter((_, i) => this.pickedFavorites_[i]);
+    this.handler_.applySetup(spaces, favorites, p.mode);
+    this.advance_();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-onboarding': MeridianOnboardingElement;
+  }
+}
+
+customElements.define(MeridianOnboardingElement.is, MeridianOnboardingElement);
diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
index adc35227f5..4f3ac80b6f 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
@@ -107,6 +107,7 @@ export class MeridianSidebarElement extends CrLitElement implements
   private commandBarListenerId_: number|null = null;
