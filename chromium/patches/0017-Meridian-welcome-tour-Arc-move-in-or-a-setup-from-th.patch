@@ -0,0 +1,203 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/setup_profile.h"
+
+#include <algorithm>
+#include <map>
+#include <set>
+
+#include "base/base_paths.h"
+#include "base/no_destructor.h"
+#include "base/files/file_enumerator.h"
+#include "base/path_service.h"
+#include "base/strings/string_util.h"
+
+namespace meridian {
+
+namespace {
+
+struct WebApp {
+  const char* title;
+  const char* url;
+};
+
+// Web apps a proposal can put in Favorites.
+const std::map<std::string_view, WebApp>& Catalog() {
+  static const base::NoDestructor<std::map<std::string_view, WebApp>> catalog({
+      {"gmail", {"Gmail", "https://mail.google.com/"}},
+      {"calendar", {"Google Calendar", "https://calendar.google.com/"}},
+      {"docs", {"Google Docs", "https://docs.google.com/"}},
+      {"maps", {"Google Maps", "https://maps.google.com/"}},
+      {"outlook", {"Outlook", "https://outlook.office.com/"}},
+      {"teams", {"Microsoft Teams", "https://teams.microsoft.com/"}},
+      {"notion", {"Notion", "https://www.notion.so/"}},
+      {"slack", {"Slack", "https://app.slack.com/"}},
+      {"linear", {"Linear", "https://linear.app/"}},
+      {"figma", {"Figma", "https://www.figma.com/files"}},
+      {"dribbble", {"Dribbble", "https://dribbble.com/"}},
+      {"pinterest", {"Pinterest", "https://www.pinterest.com/"}},
+      {"github", {"GitHub", "https://github.com/"}},
+      {"claude", {"Claude", "https://claude.ai/"}},
+      {"telegram", {"Telegram", "https://web.telegram.org/"}},
+      {"whatsapp", {"WhatsApp", "https://web.whatsapp.com/"}},
+      {"youtube", {"YouTube", "https://www.youtube.com/"}},
+  });
+  return *catalog;
+}
+
+// Case-insensitive "starts with any of".
+bool HasApp(const std::vector<std::string>& apps,
+            std::initializer_list<std::string_view> prefixes) {
+  return std::ranges::any_of(apps, [&](const std::string& app) {
+    return std::ranges::any_of(prefixes, [&](std::string_view prefix) {
+      return base::StartsWith(app, prefix,
+                              base::CompareCase::INSENSITIVE_ASCII);
+    });
+  });
+}
+
+constexpr std::initializer_list<std::string_view> kDevApps = {
+    "Xcode",      "Visual Studio Code", "Cursor",         "Zed",
+    "IntelliJ",   "WebStorm",           "PyCharm",        "Rider",
+    "GoLand",     "Android Studio",     "iTerm",          "Warp",
+    "Ghostty",    "Docker",             "OrbStack",       "Postman",
+    "TablePlus",  "Sublime Text",       "Nova",           "Tower",
+    "Fork",       "GitHub Desktop"};
+constexpr std::initializer_list<std::string_view> kDesignApps = {
+    "Figma",           "Sketch",
+    "Adobe Photoshop", "Adobe Illustrator",
+    "Adobe XD",        "Adobe InDesign",
+    "Adobe After Effects", "Adobe Premiere",
+    "Affinity",        "Pixelmator",
+    "Framer",          "Principle",
+    "Blender",         "Cinema 4D",
+    "Procreate",       "Spline",
+    "Rive"};
+constexpr std::initializer_list<std::string_view> kOfficeApps = {
+    "Slack",    "Microsoft Teams", "Microsoft Outlook", "Microsoft Excel",
+    "Microsoft Word", "Microsoft PowerPoint", "Zoom", "Notion",
+    "Linear",   "Keynote",  "Numbers", "Pages", "Miro", "Loom",
+    "Superhuman", "Spark"};
+// Shown back to the person ("Found Figma, Slack…").
+constexpr std::initializer_list<std::string_view> kNotableApps = {
+    "Figma",   "Sketch",   "Adobe ",   "Affinity ", "Framer",  "Blender",
+    "Procreate", "Xcode",  "Visual Studio Code", "Cursor", "Zed",
+    "IntelliJ IDEA", "WebStorm", "PyCharm", "Rider", "Android Studio",
+    "iTerm",   "Warp",     "Ghostty",  "Docker",    "OrbStack", "Postman",
+    "Slack",   "Microsoft Teams", "Microsoft Outlook", "Microsoft Excel",
+    "Microsoft Word", "Microsoft PowerPoint", "Zoom", "Notion", "Linear",
+    "Keynote", "Miro",     "Loom",     "Telegram",  "WhatsApp", "Discord",
+    "Spotify", "Obsidian", "Logic Pro", "Final Cut Pro", "DaVinci Resolve",
+    "Ableton Live"};
+
+Space MakeSpace(const char* name, const char* icon, const char* color) {
+  Space space;
+  space.name = name;
+  space.icon = icon;
+  space.color = color;
+  space.color2 = color;
+  return space;
+}
+
+}  // namespace
+
+SetupProposal::SetupProposal() = default;
+SetupProposal::SetupProposal(const SetupProposal&) = default;
+SetupProposal& SetupProposal::operator=(const SetupProposal&) = default;
+SetupProposal::~SetupProposal() = default;
+
+std::vector<std::string> InstalledApps() {
+  std::set<std::string> names;
+  base::FilePath home;
+  base::PathService::Get(base::DIR_HOME, &home);
+  for (const base::FilePath& dir :
+       {base::FilePath("/Applications"),
+        base::FilePath("/Applications/Utilities"), home.Append("Applications"),
+        base::FilePath("/System/Applications")}) {
+    base::FileEnumerator apps(dir, false, base::FileEnumerator::DIRECTORIES,
+                              "*.app");
+    for (base::FilePath app = apps.Next(); !app.empty(); app = apps.Next()) {
+      std::string name = app.BaseName().RemoveExtension().value();
+      if (!name.empty() && name.size() <= 60 && name[0] != '.') {
+        names.insert(name);
+      }
+      if (names.size() >= 250) {
+        break;
+      }
+    }
+  }
+  return std::vector<std::string>(names.begin(), names.end());
+}
+
+SetupProposal ProposeSetup(const std::vector<std::string>& apps,
+                           std::string_view locale,
+                           std::string_view persona) {
+  bool ru = base::StartsWith(locale, "ru") || base::StartsWith(locale, "uk") ||
+            base::StartsWith(locale, "be") || base::StartsWith(locale, "kk");
+  auto t = [ru](const char* en, const char* ru_text) {
+    return ru ? ru_text : en;
+  };
+  std::string pick(persona);
+  if (pick != "developer" && pick != "designer" && pick != "manager" &&
+      pick != "everyday") {
+    pick = HasApp(apps, kDevApps)        ? "developer"
+           : HasApp(apps, kDesignApps)   ? "designer"
+           : HasApp(apps, kOfficeApps)   ? "manager"
+                                         : "everyday";
+  }
+  bool slack = HasApp(apps, {"Slack"});
+  SetupProposal p;
+  p.persona = pick;
+  std::vector<std::string_view> favorites;
+  if (pick == "developer") {
+    p.mode = "developer";
+    p.color = "#7f7fd5";
+    p.title = t("Set up for building things", "Для разработчика");
+    p.spaces = {MakeSpace(t("Work", "Работа"), "💼", "#7f7fd5"),
+                MakeSpace(t("Personal", "Личное"), "🏠", "#43cea2")};
+    favorites = {"github", "linear", slack ? "slack" : "gmail", "claude"};
+  } else if (pick == "designer") {
+    p.mode = "creative";
+    p.color = "#c471f5";
+    p.title = t("Set up for design work", "Для дизайнера");
+    p.spaces = {MakeSpace(t("Projects", "Проекты"), "🎨", "#c471f5"),
+                MakeSpace(t("Inspiration", "Вдохновение"), "💡", "#f7b267"),
+                MakeSpace(t("Personal", "Личное"), "🏠", "#43cea2")};
+    favorites = {"figma", "dribbble", "pinterest", slack ? "slack" : "gmail"};
+  } else if (pick == "manager") {
+    p.mode = "creative";
+    p.color = "#4facfe";
+    p.title = t("Set up for teamwork", "Для работы с командой");
+    p.spaces = {MakeSpace(t("Work", "Работа"), "💼", "#4facfe"),
+                MakeSpace(t("Personal", "Личное"), "🏠", "#43cea2")};
+    bool outlook = std::ranges::any_of(apps, [](const std::string& a) {
+      return a.find("Outlook") != std::string::npos;
+    });
+    favorites = {outlook ? "outlook" : "gmail", "calendar",
+                 slack ? "slack" : "teams",
+                 HasApp(apps, {"Notion"}) ? "notion" : "docs"};
+  } else {
+    p.mode = "everyday";
+    p.color = "#8a8fe0";
+    p.title = t("Set up for everyday browsing", "Для каждого дня");
+    p.spaces = {MakeSpace(t("Personal", "Личное"), "🏠", "#8a8fe0")};
+    favorites = {"gmail", "youtube", "maps", ru ? "telegram" : "whatsapp"};
+  }
+  for (std::string_view id : favorites) {
+    const WebApp& app = Catalog().at(id);
+    Item item;
+    item.title = app.title;
+    item.url = GURL(app.url);
+    p.favorites.push_back(std::move(item));
+  }
+  for (const std::string& app : apps) {
+    if (p.seen.size() < 8 && HasApp({app}, kNotableApps)) {
+      p.seen.push_back(app);
+    }
+  }
+  return p;
+}
+
+}  // namespace meridian
