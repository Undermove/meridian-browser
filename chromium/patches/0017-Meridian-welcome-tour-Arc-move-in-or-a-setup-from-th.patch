+:host([open]) {
+  display: block;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+button {
+  font: inherit;
+  color: inherit;
+  background: none;
+  border: 0;
+  padding: 0;
+  cursor: default;
+}
+
+#root {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  background: color-mix(in srgb, var(--meridian-space, #8a8fe0) 55%, #101018);
+  animation: fade 0.35s ease;
+}
+
+#root::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: radial-gradient(ellipse at 50% 40%, transparent 30%,
+                              rgba(0, 0, 0, 0.28));
+  pointer-events: none;
+}
+
+@keyframes fade {
+  from {
+    opacity: 0;
+  }
+}
+
+/* ------------------------------------------------------------ background */
+
+.bg {
+  position: absolute;
+  inset: -20%;
+  pointer-events: none;
+  filter: blur(70px) saturate(1.2);
+}
+
+.bg i {
+  position: absolute;
+  border-radius: 50%;
+  opacity: 0.85;
+}
+
+.bg .b1 {
+  width: 60vw;
+  height: 60vw;
+  left: 5%;
+  top: 0;
+  background: var(--meridian-space, #8a8fe0);
+  animation: drift1 16s ease-in-out infinite alternate;
+}
+
+.bg .b2 {
+  width: 55vw;
+  height: 55vw;
+  right: 0;
+  bottom: 0;
+  background: var(--meridian-space2, #b48ae0);
+  animation: drift2 19s ease-in-out infinite alternate;
+}
+
+.bg .b3 {
+  width: 40vw;
+  height: 40vw;
+  left: 35%;
+  top: 35%;
+  background: color-mix(in srgb, var(--meridian-space, #8a8fe0) 50%, #fff);
+  opacity: 0.35;
+  animation: drift3 23s ease-in-out infinite alternate;
+}
+
+@keyframes drift1 {
+  to {
+    transform: translate(18vw, 12vh) scale(1.15);
+  }
+}
+
+@keyframes drift2 {
+  to {
+    transform: translate(-16vw, -10vh) scale(0.9);
+  }
+}
+
+@keyframes drift3 {
+  to {
+    transform: translate(-12vw, 8vh) scale(1.25);
+  }
+}
+
+/* ------------------------------------------------------------ frame */
+
+.top,
+.stage,
+.foot {
+  position: relative;
+  z-index: 1;
+}
+
+/* Only the top strip moves the window. */
+.top {
+  display: flex;
+  height: 52px;
+  align-items: center;
+  padding: 0 22px 0 90px;
+  app-region: drag;
+  -webkit-app-region: drag;
+}
+
+.grow {
+  flex: 1;
+}
+
+.skip {
+  color: rgba(255, 255, 255, 0.72);
+  font-weight: 500;
+  padding: 5px 10px;
+  border-radius: 8px;
+  app-region: no-drag;
+  -webkit-app-region: no-drag;
+}
+
+.skip:hover {
+  color: #fff;
+  background: rgba(255, 255, 255, 0.12);
+}
+
+.stage {
+  flex: 1;
+}
+
+.page {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: 0 40px 20px;
+  text-align: center;
+  animation: page-in 0.56s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+
+@keyframes page-in {
+  from {
+    opacity: 0;
+    transform: translateX(60px) scale(0.98);
+    filter: blur(8px);
+  }
+}
+
+h1 {
+  font-size: clamp(38px, 6vw, 64px);
+  font-weight: 750;
+  letter-spacing: -0.035em;
+  margin: 24px 0 14px;
+  line-height: 1.02;
+}
+
+h2 {
+  font-size: clamp(30px, 4.4vw, 46px);
+  font-weight: 750;
+  letter-spacing: -0.03em;
+  margin: 0 0 12px;
+  line-height: 1.05;
+}
+
+.whisper {
+  font-size: 15px;
+  line-height: 1.5;
+  color: rgba(255, 255, 255, 0.72);
+  max-width: 460px;
+  margin: 26px 0 0;
+}
+
+.whisper.top {
+  margin: 0 0 30px;
+}
+
+kbd {
+  color: #fff;
+  background: rgba(255, 255, 255, 0.16);
+  border: 1px solid rgba(255, 255, 255, 0.22);
+  border-bottom-width: 2px;
+  border-radius: 6px;
+  padding: 0 6px;
+  font: 600 13px system-ui;
+}
+
+.hero {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+}
+
+.mark {
+  width: 132px;
+  height: 132px;
+  border-radius: 34px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: rgba(255, 255, 255, 0.16);
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25),
+      0 20px 60px rgba(0, 0, 0, 0.2);
+  animation: float 6s ease-in-out infinite;
+  margin-bottom: 20px;
+}
+
+.mark.done {
+  border-radius: 50%;
+}
+
+@keyframes float {
+  50% {
+    transform: translateY(-8px);
+  }
+}
+
+/* ------------------------------------------------------------ footer */
+
+.foot {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 18px 28px 26px;
+}
+
+#back {
+  position: absolute;
+  left: 28px;
+  width: 40px;
+  padding: 0;
+}
+
+.dots {
+  position: absolute;
+  left: 50%;
+  bottom: 10px;
+  transform: translateX(-50%);
+  display: flex;
+  gap: 7px;
+}
+
+.dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 4px;
+  background: rgba(255, 255, 255, 0.32);
+  transition: width 0.3s, background 0.3s;
+}
+
+.dot.past {
+  background: rgba(255, 255, 255, 0.6);
+}
+
+.dot.on {
+  width: 24px;
+  background: #fff;
+}
+
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  height: 40px;
+  padding: 0 18px;
+  border-radius: 12px;
+  font-weight: 600;
+  font-size: 14px;
+  transition: transform 0.12s, background 0.15s, box-shadow 0.15s;
+}
+
+.btn:active:not(:disabled) {
+  transform: scale(0.97);
+}
+
+.btn.primary {
+  background: #fff;
+  color: #17171c;
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+}
+
+.btn.ghost {
+  color: rgba(255, 255, 255, 0.85);
+}
+
+.btn.ghost:hover {
+  background: rgba(255, 255, 255, 0.12);
+}
+
+.btn.big {
+  height: 48px;
+  padding: 0 24px;
+  font-size: 15px;
+  border-radius: 14px;
+}
+
+#next {
+  min-width: 168px;
+  height: 46px;
+  border-radius: 23px;
+  font-size: 15px;
+  margin-bottom: 18px;
+}
+
+#next.round {
+  min-width: 0;
+  width: 58px;
+  height: 58px;
+  border-radius: 50%;
+  padding: 0;
+}
+
+#next:disabled {
+  opacity: 0.75;
+}
+
+#next:focus-visible,
+.btn:focus-visible {
+  outline: 2px solid rgba(255, 255, 255, 0.45);
+  outline-offset: 4px;
+}
+
+#root[data-step='default'] #next {
+  background: transparent;
+  color: rgba(255, 255, 255, 0.85);
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
+}
+
+.default-btn {
+  margin-top: 26px;
+}
+
+.link {
+  font-size: 12px;
+  color: rgba(255, 255, 255, 0.75);
+  text-decoration: underline;
+  margin-top: 22px;
+}
+
+/* ------------------------------------------------------------ hello */
+
+.hello {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 28px;
+}
+
+.hello-word {
+  position: relative;
+  height: 1.25em;
+  min-width: 6ch;
+  display: grid;
+  place-items: center;
+  font: 400 clamp(84px, 13vw, 168px) / 1.1 'Snell Roundhand', 'Apple Chancery',
+      cursive;
+  text-shadow: 0 6px 40px rgba(0, 0, 0, 0.18);
+}
+
+.hello-word span {
+  grid-area: 1 / 1;
+  white-space: nowrap;
+  padding: 0 0.15em;
+  animation: write 1.5s cubic-bezier(0.55, 0.1, 0.25, 1) both;
+}
+
+@keyframes write {
+  from {
+    clip-path: inset(-20% 100% -20% -15%);
+    opacity: 0.4;
+    filter: blur(2px);
+  }
+  to {
+    clip-path: inset(-20% -10% -20% -15%);
+    opacity: 1;
+    filter: blur(0);
+  }
+}
+
+.hello-mark {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-weight: 650;
+  font-size: 15px;
+  color: rgba(255, 255, 255, 0.82);
+  animation: fade 1.2s 0.9s ease both;
+}
+
+/* ------------------------------------------------------------ arc */
+
+.arc-move {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 18px;
+  width: min(560px, 100%);
+}
+
+.arc-stats {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  justify-content: center;
+}
+
+.arc-stats b {
+  font-size: 15px;
+  font-weight: 650;
+  padding: 8px 16px;
+  border-radius: 14px;
+  background: rgba(255, 255, 255, 0.14);
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
+}
+
+.arc-spaces {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+  justify-content: center;
+}
+
+.space {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  height: 28px;
+  padding: 0 12px 0 8px;
+  border-radius: 14px;
+  background: rgba(255, 255, 255, 0.14);
+  font-weight: 500;
+  font-size: 13px;
+}
+
+.space i {
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: var(--c);
+  box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.5);
+}
+
+.space em,
+.pv-space em {
+  font-style: normal;
+}
+
+.opt {
+  width: min(420px, 100%);
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 14px;
+  border-radius: 16px;
+  text-align: left;
+  background: rgba(255, 255, 255, 0.1);
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
+  transition: background 0.2s;
+}
+
+.opt > span:nth-child(2) {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.opt b {
+  font-size: 14px;
+}
+
+.opt em {
+  font-style: normal;
+  font-size: 12px;
+  color: rgba(255, 255, 255, 0.7);
+}
+
+.opt-ic {
+  width: 32px;
+  height: 32px;
+  border-radius: 10px;
+  display: grid;
+  place-items: center;
+  background: rgba(255, 255, 255, 0.16);
+  flex: none;
+}
+
+.tick {
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.5);
+  color: transparent;
+  flex: none;
+  transition: all 0.2s;
+}
+
+.opt.on {
+  background: rgba(255, 255, 255, 0.2);
+}
+
+.opt.on .tick {
+  background: #fff;
+  color: #17171c;
+  box-shadow: none;
+}
+
+/* ------------------------------------------------------------ tailor */
+
+.tailor {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 18px;
+  width: min(560px, 100%);
+  min-height: 150px;
+  margin-top: 8px;
+}
+
+.consent {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  justify-content: center;
+}
+
+.pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  height: 42px;
+  padding: 0 18px;
+  border-radius: 21px;
+  font-weight: 600;
+  font-size: 14px;
+  color: rgba(255, 255, 255, 0.75);
+  background: rgba(255, 255, 255, 0.08);
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
+  transition: all 0.2s;
+}
+
+.pill.on {
+  background: #fff;
+  color: #17171c;
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+}
+
+.think {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 22px;
+}
+
+.orb {
+  position: relative;
+  width: 92px;
+  height: 92px;
+}
+
+.orb i {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  mix-blend-mode: screen;
+  filter: blur(6px);
+}
+
+.orb i:nth-child(1) {
+  background: radial-gradient(circle at 35% 35%, #fff,
+                              var(--meridian-space, #8a8fe0) 60%);
+  animation: orb1 2.4s ease-in-out infinite;
+}
+
+.orb i:nth-child(2) {
+  background: radial-gradient(circle at 65% 40%, #ffb3d9, transparent 60%);
+  animation: orb2 3.1s ease-in-out infinite;
+}
+
+.orb i:nth-child(3) {
+  background: radial-gradient(circle at 50% 70%, #9fd8ff, transparent 60%);
+  animation: orb3 2.7s ease-in-out infinite;
+}
+
+@keyframes orb1 {
+  50% {
+    transform: scale(1.12);
+  }
+}
+
+@keyframes orb2 {
+  50% {
+    transform: translate(8px, -6px) scale(0.9);
+  }
+}
+
+@keyframes orb3 {
+  50% {
+    transform: translate(-7px, 5px) scale(1.1);
+  }
+}
+
+.lines {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8px;
+  min-height: 120px;
+}
+
+.lines li {
+  font-size: 15px;
+  color: rgba(255, 255, 255, 0.75);
+  animation: rise 0.36s ease-out both;
+}
+
+.lines li.final {
+  font-size: 24px;
+  font-weight: 700;
+  letter-spacing: -0.02em;
+  color: #fff;
+  margin-top: 6px;
+}
+
+@keyframes rise {
+  from {
+    opacity: 0;
+    transform: translateY(6px);
+  }
+}
+
+/* ------------------------------------------------------------ preview */
+
+.preview-title {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 10px;
+}
+
+.preview-title h2 {
+  margin-bottom: 18px;
+}
+
+.persona {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 13px;
+  font-weight: 650;
+  padding: 5px 12px;
+  border-radius: 14px;
+  background: rgba(255, 255, 255, 0.16);
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
+}
+
+.pv-window {
+  width: 440px;
+  height: 270px;
+  border-radius: 16px;
+  display: flex;
+  overflow: hidden;
+  text-align: left;
+  background: linear-gradient(140deg,
+      color-mix(in srgb, var(--meridian-space, #8a8fe0) 70%, #fff),
+      color-mix(in srgb, var(--meridian-space2, #b48ae0) 75%, #fff));
+  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3),
+      0 0 0 1px rgba(255, 255, 255, 0.3);
+  animation: window-rise 0.7s 0.15s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+
+@keyframes window-rise {
+  from {
+    transform: translateY(18px) scale(0.97);
+    opacity: 0;
+  }
+}
+
+.pv-side {
+  width: 168px;
+  padding: 12px 10px;
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+  color: #17171c;
+}
+
+.pv-url {
+  height: 20px;
+  border-radius: 6px;
+  background: rgba(255, 255, 255, 0.55);
+}
+
+.pv-favs {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 5px;
+}
+
+.pv-fav {
+  height: 34px;
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.5);
+  display: grid;
+  place-items: center;
+  transition: opacity 0.2s, transform 0.2s;
+  animation: pop 0.4s cubic-bezier(0.3, 1.5, 0.5, 1) both;
+}
+
+@keyframes pop {
+  from {
+    transform: scale(0.4);
+    opacity: 0;
+  }
+}
+
+.pv-fav.off,
+.pv-space.off {
+  opacity: 0.28;
+  transform: scale(0.94);
+}
+
+.fav {
+  width: 20px;
+  height: 20px;
+  border-radius: 6px;
+  background: var(--c);
+  color: #fff;
+  font: 700 11px system-ui;
+  display: grid;
+  place-items: center;
+}
+
+.pv-spaces {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+
+.pv-space {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  height: 26px;
+  padding: 0 8px;
+  border-radius: 7px;
+  font-size: 12.5px;
+  font-weight: 600;
+  color: #17171c;
+  text-align: left;
+  transition: opacity 0.2s, transform 0.2s;
+}
+
+.pv-space:first-child {
+  background: rgba(255, 255, 255, 0.6);
+}
+
+.pv-rows {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin-top: 2px;
+}
+
+.pv-rows i {
+  height: 8px;
+  border-radius: 4px;
+  background: rgba(23, 23, 28, 0.12);
+}
+
+.pv-rows i.s {
+  width: 60%;
+}
+
+.pv-page {
+  flex: 1;
+  margin: 8px 8px 8px 0;
+  border-radius: 10px;
+  background: rgba(255, 255, 255, 0.92);
+  padding: 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+}
+
+.pv-page i {
+  height: 9px;
+  border-radius: 5px;
+  background: rgba(23, 23, 28, 0.08);
+}
+
+.pv-page i.w60 {
+  width: 60%;
+}
+
+.pv-page i.w80 {
+  width: 80%;
+}
+
+/* ------------------------------------------------------------ busy, confirm */
+
+#next.busy {
+  color: transparent;
+  position: relative;
+}
+
+#next.busy::after {
+  content: '';
+  position: absolute;
+  width: 18px;
+  height: 18px;
+  border-radius: 50%;
+  border: 2.5px solid rgba(23, 23, 28, 0.25);
+  border-top-color: #17171c;
+  animation: spin 0.7s linear infinite;
+}
+
+@keyframes spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+.confirm {
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  display: grid;
+  place-items: center;
+  background: rgba(10, 10, 16, 0.4);
+  animation: fade 0.2s ease;
+}
+
+.card {
+  width: min(440px, 90vw);
+  padding: 22px 24px 18px;
+  border-radius: 18px;
+  background: #fff;
+  color: #17171c;
+  text-align: left;
+  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
+}
+
+.card h3 {
+  margin: 0 0 10px;
+  font-size: 17px;
+}
+
+.card p {
+  margin: 0 0 10px;
+  font-size: 13.5px;
+  line-height: 1.5;
+  color: #44444c;
+}
+
+.card-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  margin-top: 14px;
+}
+
+.card .btn.ghost {
+  color: #44444c;
+}
+
+.card .btn.ghost:hover {
+  background: rgba(0, 0, 0, 0.06);
+}
+
+.card .btn.primary {
+  background: #17171c;
+  color: #fff;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .hello-word span,
+  .pv-window,
+  .pv-fav,
+  .orb i,
+  .mark,
+  .page {
+    animation: none !important;
+  }
+}
