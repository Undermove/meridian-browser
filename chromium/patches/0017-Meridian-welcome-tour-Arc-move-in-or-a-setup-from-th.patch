+bool IsDefault() {
+  NSURL* handler = [NSWorkspace.sharedWorkspace
+      URLForApplicationToOpenURL:[NSURL URLWithString:@"https://example.com/"]];
+  return handler &&
+         [handler.URLByStandardizingPath.path
+             isEqualToString:NSBundle.mainBundle.bundleURL
+                                 .URLByStandardizingPath.path];
+}
+
+}  // namespace
+
+void SidebarHandler::IsDefaultBrowser(IsDefaultBrowserCallback callback) {
+  std::move(callback).Run(IsDefault());
+}
+
+void SidebarHandler::SetDefaultBrowser(SetDefaultBrowserCallback callback) {
+  // macOS shows its own "Use Meridian as your default browser?" prompt for
+  // http; https follows the same choice.
+  __block SetDefaultBrowserCallback block_callback = std::move(callback);
+  NSURL* app = NSBundle.mainBundle.bundleURL;
+  [NSWorkspace.sharedWorkspace
+      setDefaultApplicationAtURL:app
+           toOpenURLsWithScheme:@"http"
+              completionHandler:^(NSError* http_error) {
+                [NSWorkspace.sharedWorkspace
+                    setDefaultApplicationAtURL:app
+                         toOpenURLsWithScheme:@"https"
+                            completionHandler:^(NSError* https_error) {
+                              content::GetUIThreadTaskRunner({})->PostTask(
+                                  FROM_HERE,
+                                  base::BindOnce(
+                                      [](SetDefaultBrowserCallback cb) {
+                                        std::move(cb).Run(IsDefault());
+                                      },
+                                      std::move(block_callback)));
+                            }];
+              }];
+}
+
 }  // namespace meridian
