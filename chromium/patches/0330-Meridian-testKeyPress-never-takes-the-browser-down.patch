-        chrome::ExecuteCommand(browser_,
-                               (modifiers & NSEventModifierFlagShift)
-                                   ? IDC_CLOSE_WINDOW
-                                   : IDC_CLOSE_TAB);
+                                         keyCode:key_code];
+      // What -[NSApplication sendEvent:] does for the key window, which a
+      // test window in the background isn't: key equivalents first (the
+      // window's, then the main menu's), then the window's first responder.
+      if (type == NSEventTypeKeyUp || [window performKeyEquivalent:event]) {
+        if (type == NSEventTypeKeyUp) {
