Subject: [PATCH 330/330] Meridian: testKeyPress never takes the browser down
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A main-menu item's action was sent straight to the test window; items
the window doesn't take (⌘J Jump to Selection, ⌘E, ⌘C…) threw an
Objective-C exception that ended the browser. The action now goes where
AppKit would send it for a key window (the window, its responder chain,
its delegate, NSApp), or the key goes on to the page when nobody takes
it. Keys and modifiers no keyboard has, and a window that's gone, are
refused; any exception is logged instead of crashing. The whole-AppKit
path (1 << 30) is used only for a window on screen.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../browser/meridian/sidebar_handler_mac.mm   | 176 +++++++++++++-----
 1 file changed, 129 insertions(+), 47 deletions(-)

diff --git a/chrome/browser/meridian/sidebar_handler_mac.mm b/chrome/browser/meridian/sidebar_handler_mac.mm
index b87de0bdb6..05da6182b9 100644
--- a/chrome/browser/meridian/sidebar_handler_mac.mm
+++ b/chrome/browser/meridian/sidebar_handler_mac.mm
@@ -8,6 +8,7 @@
 #include "chrome/browser/meridian/sidebar_handler.h"
 
 #include "base/command_line.h"
+#include "base/logging.h"
 #include "base/strings/escape.h"
 #include "base/strings/sys_string_conversions.h"
 #include "chrome/app/chrome_command_ids.h"
@@ -436,24 +437,108 @@ NSMenuItem* MenuItemFor(NSMenu* menu, NSString* chars, uint32_t modifiers) {
 
 }  // namespace
 
+namespace {
+
+// Who AppKit would send a menu item's `action` to if `window` were the key
+// window: the window itself first (Chromium's commandDispatch: lives there),
+// then its first responder's chain, the window's delegate, NSApp and its
+// delegate. Null when nobody takes it or the item is disabled for it, as the
+// menu would leave it: then the key goes on to the page.
+id MenuTargetIn(NSWindow* window, NSMenuItem* item) {
+  SEL action = item.action;
+  id target = nil;
+  // The class, not -respondsToSelector:: a views window without a command
+  // handler of its own says it doesn't take commandDispatch:, yet dispatches
+  // it (to its parent's), which ⌘F and the other browser commands rely on.
+  if ([window.class instancesRespondToSelector:action]) {
+    target = window;
+  }
+  for (NSResponder* r = window.firstResponder; !target && r;
+       r = r.nextResponder) {
+    if ([r respondsToSelector:action]) {
+      target = r;
+    }
+  }
+  if (!target && [window.delegate respondsToSelector:action]) {
+    target = window.delegate;
+  }
+  if (!target && [NSApp respondsToSelector:action]) {
+    target = NSApp;
+  }
+  if (!target && [NSApp.delegate respondsToSelector:action]) {
+    target = NSApp.delegate;
+  }
+  if (!target || target == window) {
+    return target;
+  }
+  if ([target respondsToSelector:@selector(validateMenuItem:)] &&
+      ![target validateMenuItem:item]) {
+    return nil;
+  }
+  if ([target respondsToSelector:@selector(validateUserInterfaceItem:)] &&
+      ![target validateUserInterfaceItem:item]) {
+    return nil;
+  }
+  return target;
+}
+
+}  // namespace
