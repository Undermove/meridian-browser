 .../ui/webui_browser/webui_browser_window.cc  | 15 +++++++++-
 .../ui/webui_browser/webui_browser_window.h   |  3 ++
 .../render_widget_host_view_mac.mm            |  6 ++++
 6 files changed, 74 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index 5bacd43eef..e286c3cd00 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -372,10 +372,17 @@ void SidebarHandler::Adopt(tabs::TabInterface* tab) {
     return;
   }
   // Its opener's space (a link opened in a new tab stays with its page).
+  // Only a link's: Navigate() also makes the active tab the opener of what
+  // the sidebar opens, which goes to its own space.
   int index = model()->GetIndexOfTab(tab);
-  if (tabs::TabInterface* opener = index == TabStripModel::kNoTab
-                                       ? nullptr
-                                       : model()->GetOpenerOfTabAt(index)) {
+  content::NavigationEntry* entry = contents->GetController().GetVisibleEntry();
+  bool from_link = entry && ui::PageTransitionCoreTypeIs(
+                                entry->GetTransitionType(),
+                                ui::PAGE_TRANSITION_LINK);
+  if (tabs::TabInterface* opener =
+          index == TabStripModel::kNoTab || !from_link
+              ? nullptr
+              : model()->GetOpenerOfTabAt(index)) {
     const TabData* from = TabData::Get(opener->GetContents());
     if (from && service_->FindSpace(from->space_id())) {
       TabData::Set(contents, from->space_id(), std::string());
@@ -1780,10 +1787,26 @@ void SidebarHandler::OnSidebarChanged() {
     base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
         FROM_HERE, base::BindOnce(&SidebarHandler::RehomeTabs,
                                   weak_factory_.GetWeakPtr()));
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SidebarHandler::ShowActiveSpaceTab,
+                                  weak_factory_.GetWeakPtr()));
   }
   ScheduleNotify();
 }
 
+void SidebarHandler::ShowActiveSpaceTab() {
+  tabs::TabInterface* active = model()->GetActiveTab();
+  const TabData* data = active ? TabData::Get(active->GetContents()) : nullptr;
+  const std::string& space_id = service_->active_space_id();
+  if (!HoldsSpaceTabs(browser_) || !service_->FindSpace(space_id) ||
+      (data && data->space_id() == space_id) ||
+      (data && !data->item_id().empty() &&
+       IsFavorites(service_->ContainerOf(data->item_id())))) {
+    return;
+  }
+  ActivateSpaceHere(space_id);
+}
+
 void SidebarHandler::RehomeTabs() {
   if (!HoldsSpaceTabs(browser_)) {
     return;
