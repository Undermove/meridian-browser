 viz::FrameSinkId RenderWidgetHostViewMac::GetRootFrameSinkId() {
+  // Meridian: a frame inside a tab can still name this view as its root
+  // after it was destroyed (Destroy() drops the compositor); a focus change
+  // reported then crashed the browser.
+  if (!browser_compositor_) {
+    return viz::FrameSinkId();
+  }
   return browser_compositor_->GetRootFrameSinkId();
 }
 
