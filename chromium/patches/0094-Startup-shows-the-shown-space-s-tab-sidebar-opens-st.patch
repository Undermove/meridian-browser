@@ -115,6 +115,28 @@ void SidebarHandler::TestKeyPress(uint16_t key_code,
   NSWindow* window =
       browser_->GetWindow()->GetNativeWindow().GetNativeNSWindow();
   NSString* chars = base::SysUTF8ToNSString(characters);
+  // 1 << 30: the whole of AppKit's way, as for a key typed in the key
+  // window: the window made key (without bringing the app forward) and the
+  // event given to NSApp.
+  constexpr uint32_t kThroughApp = 1u << 30;
+  if (modifiers & kThroughApp) {
+    modifiers &= ~kThroughApp;
+    [window makeKeyWindow];
+    for (NSEventType type : {NSEventTypeKeyDown, NSEventTypeKeyUp}) {
+      [NSApp sendEvent:[NSEvent keyEventWithType:type
+                                        location:NSZeroPoint
+                                   modifierFlags:modifiers
+                                       timestamp:NSProcessInfo.processInfo
+                                                     .systemUptime
+                                    windowNumber:window.windowNumber
+                                         context:nil
+                                      characters:chars
+                     charactersIgnoringModifiers:chars
+                                       isARepeat:NO
+                                         keyCode:key_code]];
+    }
+    return;
+  }
   for (NSEventType type : {NSEventTypeKeyDown, NSEventTypeKeyUp}) {
     NSEvent* event = [NSEvent keyEventWithType:type
                                       location:NSZeroPoint
