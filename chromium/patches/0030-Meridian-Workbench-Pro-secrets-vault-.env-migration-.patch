+// A .env file's credentials go to the vault (project scope); the file keeps
+// the keys with empty values, and gets into .gitignore when the project uses
+// git.
+void WorkbenchHandler::MigrateDotenv(const std::string& rel, Reply reply) {
+  if (!project_) {
+    return std::move(reply).Run(base::unexpected("no project is open"));
+  }
+  if (!IsDotenvFile(rel)) {
+    return std::move(reply).Run(
+        base::unexpected("Only .env files can be migrated."));
+  }
+  struct Read {
+    std::string text;
+    std::vector<DotenvEntry> entries;
+  };
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](ProjectFs project, std::string rel)
+              -> base::expected<Read, std::string> {
+            base::expected<base::FilePath, std::string> abs =
+                project.Resolve(rel, true);
+            if (!abs.has_value()) {
+              return base::unexpected(abs.error());
+            }
+            if (base::IsLink(*abs)) {
+              return base::unexpected(
+                  rel + " is a symlink — move the keys from the file it "
+                        "points to.");
+            }
+            std::optional<int64_t> size = base::GetFileSize(*abs);
+            Read r;
+            if (!size || *size > 256 * 1024 ||
+                !base::ReadFileToString(*abs, &r.text)) {
+              return base::unexpected("not a .env file");
+            }
+            r.entries = ParseDotenv(r.text);
+            return r;
+          },
+          *project_, rel),
+      base::BindOnce(
+          [](base::WeakPtr<WorkbenchHandler> self, std::string rel,
+             Reply reply, base::expected<Read, std::string> read) {
+            if (!self || !self->project_) {
+              return;
+            }
+            if (!read.has_value()) {
+              return std::move(reply).Run(base::unexpected(read.error()));
+            }
+            Vault& vault =
+                WorkbenchServiceFactory::GetForProfile(self->profile_)->vault();
+            std::string why = vault.UnavailableReason();
+            if (!why.empty()) {
+              return std::move(reply).Run(base::unexpected(why));
+            }
+            std::vector<DotenvEntry> moved;
+            base::ListValue imported, skipped;
+            for (const DotenvEntry& e : read->entries) {
+              if (!e.secret) {
+                continue;  // ordinary settings stay in the file
+              }
+              if (!IsValidSecretName(e.name)) {
+                skipped.Append(e.name);
+                continue;
+              }
+              base::expected<base::DictValue, std::string> set = vault.Set(
+                  base::DictValue()
+                      .Set("name", e.name)
+                      .Set("value", e.value)
+                      .Set("scope", "project")
+                      .Set("note", "Imported from " + rel),
+                  self->project_->root().value());
+              if (!set.has_value()) {
+                return std::move(reply).Run(base::unexpected(set.error()));
+              }
+              moved.push_back(e);
+              imported.Append(e.name);
+            }
+            self->Broadcast("wb:vault-change");
+            std::string text = BlankDotenv(read->text, moved);
+            self->files_->PostTaskAndReplyWithResult(
+                FROM_HERE,
+                base::BindOnce(
+                    [](ProjectFs project, std::string rel, std::string text,
+                       bool changed, base::ListValue imported,
+                       base::ListValue skipped) -> Result {
+                      if (changed) {
+                        base::expected<base::DictValue, std::string> w =
+                            project.Write(rel, text);
+                        if (!w.has_value()) {
+                          return base::unexpected(w.error());
+                        }
+                      }
+                      // Keep it out of git too.
+                      bool gitignored = false;
+                      if (base::PathExists(project.root().Append(".git"))) {
+                        base::FilePath gi = project.root().Append(".gitignore");
+                        std::string cur;
+                        if (base::IsLink(gi)) {
+                          return base::Value(
+                              base::DictValue()
+                                  .Set("imported", std::move(imported))
+                                  .Set("skipped", std::move(skipped))
+                                  .Set("gitignored", false)
+                                  .Set("gitignoreSkipped",
+                                       ".gitignore is not a regular file "
+                                       "(symlink?) — add the entry yourself."));
+                        }
+                        base::ReadFileToString(gi, &cur);
+                        std::string entry = "/" + rel;
+                        bool covered = false;
+                        for (const std::string& l : base::SplitString(
+                                 cur, "\n", base::TRIM_WHITESPACE,
+                                 base::SPLIT_WANT_NONEMPTY)) {
+                          covered |= l == entry || l == rel || l == ".env*" ||
+                                     (l == ".env" && rel == ".env") ||
+                                     (l == ".env.*" &&
+                                      rel.starts_with(".env."));
+                        }
+                        if (!covered) {
+                          std::string next =
+                              cur + (cur.empty() || cur.ends_with("\n")
+                                         ? ""
+                                         : "\n") +
+                              entry + "\n";
+                          gitignored = project.Write(".gitignore", next)
+                                           .has_value();
+                        }
+                      }
+                      return base::Value(base::DictValue()
+                                             .Set("imported", std::move(imported))
+                                             .Set("skipped", std::move(skipped))
+                                             .Set("gitignored", gitignored));
+                    },
+                    *self->project_, rel, std::move(text), !moved.empty(),
+                    std::move(imported), std::move(skipped)),
+                std::move(reply));
+          },
+          weak_factory_.GetWeakPtr(), rel, std::move(reply)));
+}
+
+// A Claude Code session wants to read something that looks like a secret
+// file: the person decides, in a native dialog.
+void WorkbenchHandler::GuardDecision(
+    std::string root,
+    std::shared_ptr<std::set<std::string>> allowed,
+    GuardServer::Request request,
+    GuardServer::Answer answer) {
+  std::string key = request.command.empty()
+                        ? base::JoinString(request.paths, "\n")
+                        : "cmd:" + request.command;
+  if (allowed->contains(key)) {
+    return std::move(answer).Run("allow",
+                                 "Allowed for this session in Meridian.");
+  }
+  base::FilePath base(root);
+  auto rel_of = [&](const std::string& abs) -> std::string {
+    base::FilePath rel;
+    return base.AppendRelativePath(base::FilePath(abs), &rel) ? rel.value()
+                                                              : std::string();
+  };
+  // .env files in the project that still hold values: "move to vault".
+  std::vector<std::string> candidates;
+  for (const std::string& p : request.paths) {
+    std::string rel = rel_of(p);
+    if (!rel.empty() && IsDotenvFile(rel)) {
+      candidates.push_back(rel);
+    }
+  }
+  if (!request.command.empty()) {
+    std::string_view input(request.command);
+    std::string m;
+    static const base::NoDestructor<RE2> env_word(
+        R"re((?:^|[\s'"=<>|;&(])((?:[\w.-]+/)*\.env(?:\.[\w-]+)?)(?:$|[\s'";|&)<>]))re");
+    while (RE2::FindAndConsume(&input, *env_word, &m)) {
+      if (m.starts_with("./")) {
+        m = m.substr(2);
+      }
+      if (IsDotenvFile(m)) {
+        candidates.push_back(m);
+      }
+    }
+  }
+  struct Found {
+    std::vector<std::string> dotenvs;
+    std::vector<std::string> keys;
+  };
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath root, std::vector<std::string> candidates) {
+            Found f;
+            std::optional<ProjectFs> project = ProjectFs::Open(root);
+            for (const std::string& rel : candidates) {
+              base::expected<base::FilePath, std::string> abs =
+                  project ? project->Resolve(rel, true)
+                          : base::unexpected(std::string());
+              std::string text;
+              if (!abs.has_value() || !base::ReadFileToString(*abs, &text)) {
+                continue;
+              }
+              bool any = false;
+              for (const DotenvEntry& e : ParseDotenv(text)) {
+                if (e.secret) {
+                  any = true;
+                  if (std::ranges::find(f.keys, e.name) == f.keys.end()) {
+                    f.keys.push_back(e.name);
+                  }
+                }
+              }
+              if (any) {
+                f.dotenvs.push_back(rel);
+              }
+            }
+            return f;
+          },
+          base, std::move(candidates)),
+      base::BindOnce(
+          [](base::WeakPtr<WorkbenchHandler> self, std::string root,
+             std::shared_ptr<std::set<std::string>> allowed,
+             GuardServer::Request request, std::string key,
+             GuardServer::Answer answer, Found found) {
+            if (!self) {
+              return std::move(answer).Run(
+                  "deny", "The Meridian Workbench for this session is gone.");
+            }
+            // Everything in the request comes from the agent: plain,
+            // bounded lines.
+            base::FilePath base(root);
+            std::vector<std::string> shown;
+            for (const std::string& p : request.paths) {
+              base::FilePath rel;
+              shown.push_back(ai::OneLine(
+                  base.AppendRelativePath(base::FilePath(p), &rel) ? rel.value()
+                                                                   : p,
+                  160));
+            }
+            std::string what =
+                !request.command.empty()
+                    ? "run a command that may read a secret file"
+                : request.paths.size() == 1
+                    ? "read a file that may contain secrets"
+                    : "read " + base::NumberToString(request.paths.size()) +
+                          " files that may contain secrets";
