@@ -0,0 +1,366 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/vault.h"
+
+#include <algorithm>
+#include <set>
+
+#include "base/base64.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/uuid.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/meridian/workbench/secret_files.h"
+#include "components/os_crypt/async/browser/os_crypt_async.h"
+#include "components/os_crypt/async/common/encryptor.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+constexpr size_t kMaxItems = 500;
+constexpr size_t kMaxValue = 32 * 1024;
+constexpr size_t kMaxNote = 500;
+
+double Now() {
+  return base::Time::Now().InMillisecondsFSinceUnixEpoch();
+}
+
+bool InScope(const base::DictValue& item, const std::string& project) {
+  const std::string* scope = item.FindString("scope");
+  return scope && (*scope == "global" || (!project.empty() && *scope == project));
+}
+
+}  // namespace
+
+Vault::Vault(base::FilePath file)
+    : file_(std::move(file)),
+      files_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath file) {
+            std::string json;
+            base::ReadFileToString(file, &json);
+            return json;
+          },
+          file_),
+      base::BindOnce(
+          [](base::WeakPtr<Vault> self, std::string json) {
+            if (!self) {
+              return;
+            }
+            std::optional<base::Value> v = base::JSONReader::Read(json, 0);
+            const base::ListValue* items =
+                v && v->is_dict() ? v->GetDict().FindList("items") : nullptr;
+            if (items) {
+              for (const base::Value& i : *items) {
+                const base::DictValue* d = i.is_dict() ? &i.GetDict() : nullptr;
+                if (d && d->FindString("id") && d->FindString("enc") &&
+                    d->FindString("scope") && d->FindString("name") &&
+                    IsValidSecretName(*d->FindString("name"))) {
+                  self->items_.Append(d->Clone());
+                }
+              }
+            }
+            self->loaded_ = true;
+            if (self->encryptor_done_) {
+              for (auto& w : self->waiting_) {
+                std::move(w).Run();
+              }
+              self->waiting_.clear();
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+  g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+      [](base::WeakPtr<Vault> self,
+         scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+        if (!self) {
+          return;
+        }
+        self->encryptor_ = std::move(encryptor);
+        self->encryptor_done_ = true;
+        if (self->loaded_) {
+          for (auto& w : self->waiting_) {
+            std::move(w).Run();
+          }
+          self->waiting_.clear();
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+}
+
+Vault::~Vault() = default;
+
+void Vault::WhenReady(base::OnceClosure ready) {
+  if (loaded_ && encryptor_done_) {
+    std::move(ready).Run();
+    return;
+  }
+  waiting_.push_back(std::move(ready));
+}
+
+std::string Vault::UnavailableReason() const {
+  if (!encryptor_done_) {
+    return "The vault is still opening.";
+  }
+  return encryptor_ ? std::string()
+                    : "OS keychain encryption is not available on this Mac.";
+}
+
+base::ListValue Vault::List(const std::string& project) const {
+  std::vector<const base::DictValue*> mine;
+  for (const base::Value& i : items_) {
+    if (InScope(i.GetDict(), project)) {
+      mine.push_back(&i.GetDict());
+    }
+  }
+  std::ranges::sort(mine, [](const base::DictValue* a, const base::DictValue* b) {
+    const std::string& na = *a->FindString("name");
+    const std::string& nb = *b->FindString("name");
+    if (na != nb) {
+      return na < nb;
+    }
+    return *a->FindString("scope") != "global";
+  });
+  base::ListValue out;
+  for (const base::DictValue* i : mine) {
+    bool global = *i->FindString("scope") == "global";
+    const std::string* note = i->FindString("note");
+    out.Append(base::DictValue()
+                   .Set("id", *i->FindString("id"))
+                   .Set("name", *i->FindString("name"))
+                   .Set("scope", global ? "global" : "project")
+                   .Set("note", note ? *note : "")
+                   .Set("sandbox", !global && i->FindBool("sandbox").value_or(false))
+                   .Set("createdAt", i->FindDouble("createdAt").value_or(0))
+                   .Set("updatedAt", i->FindDouble("updatedAt").value_or(0)));
+  }
+  return out;
+}
+
+base::expected<base::DictValue, std::string> Vault::Set(
+    const base::DictValue& item,
+    const std::string& project) {
+  std::string why = UnavailableReason();
+  if (!why.empty()) {
+    return base::unexpected(why);
+  }
+  const std::string* name_p = item.FindString("name");
+  std::string name = name_p ? *name_p : std::string();
+  if (!RE2::FullMatch(name, "[A-Z_][A-Z0-9_]{0,63}")) {
+    return base::unexpected(
+        "Names use A–Z, 0–9 and _ and don’t start with a digit (like "
+        "OPENAI_API_KEY).");
+  }
+  if (IsReservedName(name)) {
+    return base::unexpected(name +
+                            " is a system variable and can’t be stored as a "
+                            "secret.");
+  }
+  const std::string* scope_p = item.FindString("scope");
+  std::string scope;
+  if (scope_p && *scope_p == "global") {
+    scope = "global";
+  } else if (scope_p && *scope_p == "project" && !project.empty()) {
+    scope = project;
+  } else {
+    return base::unexpected("Choose “All projects” or open a project first.");
+  }
+  const std::string* note_p = item.FindString("note");
+  std::string note = note_p ? note_p->substr(0, kMaxNote) : std::string();
+  const std::string* id = item.FindString("id");
+  base::DictValue* existing = nullptr;
+  if (id && !id->empty()) {
+    for (base::Value& i : items_) {
+      if (*i.GetDict().FindString("id") == *id && InScope(i.GetDict(), project)) {
+        existing = &i.GetDict();
+      }
+    }
+    if (!existing) {
+      return base::unexpected("That secret no longer exists.");
+    }
+  }
+  const std::string* value = item.FindString("value");
+  if (value) {
+    if (value->empty()) {
+      return base::unexpected("The value is empty.");
+    }
+    if (value->size() > kMaxValue) {
+      return base::unexpected("The value is too long.");
+    }
+    if (value->find('\0') != std::string::npos) {
+      return base::unexpected("The value contains a NUL byte.");
+    }
+  } else if (!existing) {
+    return base::unexpected("The value is empty.");
+  }
+  // Same name and scope: replaced (renaming onto another one replaces it).
+  base::DictValue* clash = nullptr;
+  for (base::Value& i : items_) {
+    base::DictValue& d = i.GetDict();
+    if (&d != existing && *d.FindString("name") == name &&
+        *d.FindString("scope") == scope) {
+      clash = &d;
+    }
+  }
+  std::string clash_id = clash ? *clash->FindString("id") : std::string();
+  if (existing && clash) {
+    items_.EraseIf([&](const base::Value& i) {
+      return *i.GetDict().FindString("id") == clash_id;
+    });
+    // `existing` may have moved.
+    existing = nullptr;
+    for (base::Value& i : items_) {
+      if (*i.GetDict().FindString("id") == *id) {
+        existing = &i.GetDict();
+      }
+    }
+    clash = nullptr;
+  }
+  base::DictValue* target = existing ? existing : clash;
+  if (!target) {
+    if (items_.size() >= kMaxItems) {
+      return base::unexpected("The vault is full.");
+    }
+    items_.Append(base::DictValue()
+                      .Set("id", base::Uuid::GenerateRandomV4().AsLowercaseString())
+                      .Set("createdAt", Now()));
+    target = &items_.back().GetDict();
+  }
+  if (value) {
+    std::string sealed;
+    if (!encryptor_->EncryptString(*value, &sealed)) {
+      return base::unexpected(
+          "Meridian couldn’t reach your Mac’s keychain to store the secret.");
+    }
+    target->Set("enc", base::Base64Encode(sealed));
+  }
+  target->Set("name", name);
+  target->Set("scope", scope);
+  target->Set("note", note);
+  target->Set("updatedAt", Now());
+  target->Set("sandbox",
+              scope != "global" && item.FindBool("sandbox").value_or(false));
+  base::DictValue out;
+  out.Set("id", *target->FindString("id"));
+  out.Set("name", name);
+  out.Set("scope", scope == "global" ? "global" : "project");
+  Save();
+  return out;
+}
+
+base::expected<std::string, std::string> Vault::Reveal(
+    const std::string& id,
+    const std::string& project) const {
+  for (const base::Value& i : items_) {
+    const base::DictValue& d = i.GetDict();
+    if (*d.FindString("id") == id && InScope(d, project)) {
+      std::string sealed, value;
+      if (!encryptor_ || !base::Base64Decode(*d.FindString("enc"), &sealed) ||
+          !encryptor_->DecryptString(sealed, &value)) {
+        return base::unexpected("Meridian couldn’t decrypt this secret.");
+      }
+      return base::ok(value);
+    }
+  }
+  return base::unexpected("No such secret.");
+}
+
+bool Vault::Remove(const std::string& id, const std::string& project) {
+  size_t removed = items_.EraseIf([&](const base::Value& i) {
+    return *i.GetDict().FindString("id") == id && InScope(i.GetDict(), project);
+  });
+  if (removed) {
+    Save();
+  }
+  return removed > 0;
+}
+
+std::map<std::string, std::string> Vault::EnvFor(
+    const std::string& project) const {
+  std::map<std::string, std::string> env;
+  if (!encryptor_) {
+    return env;
+  }
+  for (bool global : {true, false}) {
+    for (const base::Value& i : items_) {
+      const base::DictValue& d = i.GetDict();
+      const std::string& scope = *d.FindString("scope");
+      if (global ? scope != "global" : (project.empty() || scope != project)) {
+        continue;
+      }
+      std::string sealed, value;
+      if (base::Base64Decode(*d.FindString("enc"), &sealed) &&
+          encryptor_->DecryptString(sealed, &value)) {
+        env[*d.FindString("name")] = value;
+      }
+    }
+  }
+  return env;
+}
+
+std::vector<std::pair<std::string, std::string>> Vault::AllValues() const {
+  std::vector<std::pair<std::string, std::string>> out;
+  if (!encryptor_) {
+    return out;
+  }
+  for (const base::Value& i : items_) {
+    const base::DictValue& d = i.GetDict();
+    std::string sealed, value;
+    if (base::Base64Decode(*d.FindString("enc"), &sealed) &&
+        encryptor_->DecryptString(sealed, &value)) {
+      out.emplace_back(*d.FindString("name"), value);
+    }
+  }
+  return out;
+}
+
+std::vector<std::string> Vault::SandboxDefaults(
+    const std::string& project,
+    const std::vector<std::string>& needs) const {
+  std::set<std::string> out;
+  for (const base::Value& i : items_) {
+    const base::DictValue& d = i.GetDict();
+    if (!InScope(d, project)) {
+      continue;
+    }
+    const std::string& name = *d.FindString("name");
+    if (std::ranges::find(needs, name) != needs.end()) {
+      out.insert(name);
+    }
+    if (*d.FindString("scope") == project &&
+        d.FindBool("sandbox").value_or(false)) {
+      out.insert(name);
+    }
+  }
+  return std::vector<std::string>(out.begin(), out.end());
+}
+
+void Vault::Save() {
+  std::string json =
+      base::WriteJson(base::DictValue().Set("version", 1).Set("items",
+                                                              items_.Clone()))
+          .value_or("{}");
+  files_->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath file, std::string json) {
+            base::FilePath tmp = file.AddExtension("tmp");
+            if (base::WriteFile(tmp, json) &&
+                base::SetPosixFilePermissions(tmp, 0600)) {
+              base::ReplaceFile(tmp, file, nullptr);
+            }
+          },
+          file_, std::move(json)));
+}
