+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_GUARD_SERVER_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_GUARD_SERVER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+
+namespace meridian::workbench {
+
+// The secret-file guard's socket. Each Claude Code session started from the
+// Workbench gets a blocking PreToolUse hook (`Meridian --secret-guard`). The
+// hook decides locally whether a tool call touches a secret-looking file;
+// only then it asks Meridian here: a unix socket in a fresh 0700 temp dir (no
+// TCP port), requests carrying the session's token. Meridian asks the person
+// and answers with a Claude Code permission decision.
+class GuardServer {
+ public:
+  struct Request {
+    std::string tool;
+    std::vector<std::string> paths;
+    std::string command;
+  };
+  // "allow", "deny" or "ask", and why.
+  using Answer = base::OnceCallback<void(std::string decision,
+                                         std::string reason)>;
+  using Decide = base::RepeatingCallback<
+      void(const std::string& session, Request request, Answer answer)>;
+
+  // `decide` runs on the sequence that creates the server.
+  explicit GuardServer(Decide decide);
+  GuardServer(const GuardServer&) = delete;
+  GuardServer& operator=(const GuardServer&) = delete;
+  ~GuardServer();
+
+  void Start(base::OnceCallback<void(base::FilePath)> done);
+  const base::FilePath& socket_path() const { return socket_path_; }
+  std::string Register(const std::string& session);
+  void Unregister(const std::string& token);
+
+ private:
+  class Core;
+
+  scoped_refptr<Core> core_;
+  base::FilePath socket_path_;
+  bool starting_ = false;
+  std::vector<base::OnceCallback<void(base::FilePath)>> waiting_;
+  base::WeakPtrFactory<GuardServer> weak_factory_{this};
+};
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_GUARD_SERVER_H_
