+                names += (i ? ", " : "") + found.keys[i];
+              }
+              parts.push_back("It contains " +
+                              base::NumberToString(found.keys.size()) +
+                              (found.keys.size() == 1 ? " key: " : " keys: ") +
+                              names + ".");
+            }
+            parts.push_back(
+                "Whatever an agent reads is sent to the model and kept in the "
+                "session transcript.");
+            if (!found.keys.empty()) {
+              parts.push_back(
+                  "“Move keys to vault” stores the values encrypted in "
+                  "Meridian, leaves the keys empty in the file, and gives the "
+                  "values to terminals and agents Meridian starts as "
+                  "environment variables. The agent then sees only the "
+                  "names.");
+            }
+            // Block is the default.
+            std::vector<std::string> buttons = {"Block", "Allow once",
+                                                "Allow for this session"};
+            if (!found.keys.empty()) {
+              buttons.push_back("Move keys to vault");
+            }
+            AskNative(
