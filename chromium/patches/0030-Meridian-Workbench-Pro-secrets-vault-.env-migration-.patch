+// `done` gets the index of the button pressed.
+// --meridian-test-dialog-answer=<label> answers at once (tests).
+void AskNative(content::WebContents* contents,
+               const std::string& message,
+               const std::string& detail,
+               const std::vector<std::string>& buttons,
