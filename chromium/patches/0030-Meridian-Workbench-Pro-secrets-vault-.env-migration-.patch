@@ -0,0 +1,81 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/secret_files.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::workbench {
+namespace {
+
+TEST(SecretFilesTest, KnowsSecretFilesButNotTemplates) {
+  for (const char* p : {".env", "app/.env.local", ".envrc", "id_rsa",
+                        "certs/server.pem", "aws-credentials.json",
+                        "service-account-prod.json", ".npmrc", "secrets.yaml"}) {
+    EXPECT_TRUE(IsSecretFile(p)) << p;
+  }
+  for (const char* p : {".env.example", ".env.sample", "README.md",
+                        "environment.ts", "src/env.js"}) {
+    EXPECT_FALSE(IsSecretFile(p)) << p;
+  }
+  EXPECT_TRUE(IsDotenvFile(".env.production"));
+  EXPECT_FALSE(IsDotenvFile(".env.template"));
+}
+
+TEST(SecretFilesTest, CommandsThatNameSecretFiles) {
+  EXPECT_TRUE(CommandNamesSecretFile("cat .env"));
+  EXPECT_TRUE(CommandNamesSecretFile("source .env.local && npm start"));
+  EXPECT_TRUE(CommandNamesSecretFile("ssh-add < ~/.ssh/id_rsa"));
+  EXPECT_FALSE(CommandNamesSecretFile("cp .env.example .env.example.bak"));
+  EXPECT_FALSE(CommandNamesSecretFile("npm run env"));
+}
+
+TEST(SecretFilesTest, ParsesDotenvAndSpotsCredentials) {
+  std::vector<DotenvEntry> e = ParseDotenv(
+      "# comment\nPORT=3000\nexport OPENAI_API_KEY=\"sk-proj-abc\\\"def\"\n"
+      "DATABASE_URL=postgres://u:p4ss@db/x # prod\nEMPTY=\nNOTE='a b'\n");
+  ASSERT_EQ(e.size(), 4u);
+  EXPECT_EQ(e[0].name, "PORT");
+  EXPECT_FALSE(e[0].secret);
+  EXPECT_EQ(e[1].value, "sk-proj-abc\"def");
+  EXPECT_TRUE(e[1].secret);
+  EXPECT_EQ(e[2].value, "postgres://u:p4ss@db/x");
+  EXPECT_TRUE(e[2].secret);
+  EXPECT_FALSE(e[3].secret);
+}
+
+TEST(SecretFilesTest, BlankingKeepsKeysAndAddsTheNote) {
+  std::string text = "PORT=3000\r\nAPI_KEY=abc\r\n";
+  std::vector<DotenvEntry> e = ParseDotenv(text);
+  std::vector<DotenvEntry> moved = {e[1]};
+  std::string out = BlankDotenv(text, moved);
+  EXPECT_NE(out.find("PORT=3000\r\nAPI_KEY=\r\n"), std::string::npos) << out;
+  EXPECT_TRUE(out.starts_with("# Values of the empty keys"));
+  EXPECT_EQ(BlankDotenv(out, {}), out);
+}
+
+TEST(SecretFilesTest, Names) {
+  EXPECT_TRUE(IsValidSecretName("STRIPE_KEY"));
+  EXPECT_FALSE(IsValidSecretName("PATH"));
+  EXPECT_FALSE(IsValidSecretName("DYLD_INSERT_LIBRARIES"));
+  EXPECT_FALSE(IsValidSecretName("lower"));
+}
+
+TEST(SecretFilesTest, ScanFindsOnlyFilesWithSecrets) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().Append(".env"), "API_KEY=abc\n"));
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().Append(".env.test"), "PORT=1\n"));
+  ASSERT_TRUE(base::CreateDirectory(dir.GetPath().Append("node_modules")));
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().Append("node_modules/.env"),
+                              "API_KEY=x\n"));
+  base::ListValue found = ScanProject(dir.GetPath());
+  ASSERT_EQ(found.size(), 1u);
+  EXPECT_EQ(*found[0].GetDict().FindString("path"), ".env");
+}
+
+}  // namespace
+}  // namespace meridian::workbench
