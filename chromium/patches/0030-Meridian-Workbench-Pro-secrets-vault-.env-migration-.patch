+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/workbench_service_factory.h"
+
+#include "chrome/browser/meridian/workbench/workbench_service.h"
+#include "chrome/browser/profiles/profile.h"
+
+namespace meridian::workbench {
+
+WorkbenchService* WorkbenchServiceFactory::GetForProfile(Profile* profile) {
+  return static_cast<WorkbenchService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+WorkbenchServiceFactory* WorkbenchServiceFactory::GetInstance() {
+  static base::NoDestructor<WorkbenchServiceFactory> instance;
+  return instance.get();
+}
+
+WorkbenchServiceFactory::WorkbenchServiceFactory()
+    : ProfileKeyedServiceFactory(
+          "MeridianWorkbench",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .WithGuest(ProfileSelection::kNone)
+              .Build()) {}
+
+WorkbenchServiceFactory::~WorkbenchServiceFactory() = default;
+
+std::unique_ptr<KeyedService>
+WorkbenchServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  return std::make_unique<WorkbenchService>(
+      Profile::FromBrowserContext(context));
+}
+
+}  // namespace meridian::workbench
