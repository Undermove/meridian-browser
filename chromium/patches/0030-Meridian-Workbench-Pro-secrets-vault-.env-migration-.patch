+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_SECRET_FILES_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_SECRET_FILES_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/values.h"
+
+namespace meridian::workbench {
+
+// Files agents shouldn't read (their values would go to the model and the
+// transcript): .env*, .envrc, credentials, *.pem, id_rsa, .npmrc…
+// Templates (.env.example, .env.sample…) don't count.
+bool IsSecretFile(const std::string& path);
+bool IsDotenvFile(const std::string& path);
+
+// A shell command that names a secret file as a word (`cat .env`,
+// `source .env.local`, `< ~/.ssh/id_rsa`). Heuristic: a command that reads a
+// secret without naming it isn't caught.
+bool CommandNamesSecretFile(const std::string& command);
+
+// Does a dotenv entry hold a credential? (PORT=3000 or NODE_ENV=dev don't.)
+bool IsSecretEntry(const std::string& name, const std::string& value);
+
+struct DotenvEntry {
+  std::string name;
+  std::string value;
+  size_t line;
+  bool secret;
+};
+std::vector<DotenvEntry> ParseDotenv(const std::string& text);
+
+// Environment variables a secret may never set: they change how processes
+// start or where they look for code (PATH, DYLD_*, NODE_OPTIONS…).
+bool IsReservedName(const std::string& name);
+bool IsValidSecretName(const std::string& name);
+
+// Secret-looking files in the project (bounded walk): [{path, dotenv,
+// keys}]; dotenv files count only when they hold credentials. Blocking.
+base::ListValue ScanProject(const base::FilePath& root);
+
+// The dotenv text with the values of `names` emptied (the keys stay), and a
+// note at the top saying where the values went.
+std::string BlankDotenv(const std::string& text,
+                        const std::vector<DotenvEntry>& moved);
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_SECRET_FILES_H_
