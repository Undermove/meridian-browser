+                      }
+                      std::move(answer).Run(
+                          "deny",
+                          "The user blocked this in Meridian: files with "
+                          "secrets must not be read." +
+                              hint);
+                    },
+                    self, root, allowed, std::move(request), key, buttons,
+                    found.dotenvs, std::move(answer)));
+          },
+          weak_factory_.GetWeakPtr(), root, allowed, std::move(request), key,
+          std::move(answer)));
+}
