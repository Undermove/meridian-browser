@@ -0,0 +1,53 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/workbench_service.h"
+
+#include "base/functional/callback_helpers.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/meridian/workbench/vault.h"
+#include "chrome/browser/profiles/profile.h"
+
+namespace meridian::workbench {
+
+WorkbenchService::WorkbenchService(Profile* profile)
+    : vault_(std::make_unique<Vault>(
+          profile->GetPath().Append("Meridian Vault.json"))) {
+  guard_ = std::make_unique<GuardServer>(base::BindRepeating(
+      &WorkbenchService::Decide, weak_factory_.GetWeakPtr()));
+  guard_->Start(base::DoNothing());
+}
+
+WorkbenchService::~WorkbenchService() = default;
+
+std::string WorkbenchService::RegisterGuard(GuardDecider decider) {
+  std::string session = "g" + base::NumberToString(++next_session_);
+  deciders_[session] = std::move(decider);
+  std::string token = guard_->Register(session);
+  tokens_[token] = session;
+  return token;
+}
+
+void WorkbenchService::UnregisterGuard(const std::string& token) {
+  guard_->Unregister(token);
+  auto it = tokens_.find(token);
+  if (it != tokens_.end()) {
+    deciders_.erase(it->second);
+    tokens_.erase(it);
+  }
+}
+
+void WorkbenchService::Decide(const std::string& session,
+                              GuardServer::Request request,
+                              GuardServer::Answer answer) {
+  auto it = deciders_.find(session);
+  if (it == deciders_.end()) {
+    std::move(answer).Run("deny",
+                          "The Meridian Workbench for this session is gone.");
+    return;
+  }
+  it->second.Run(std::move(request), std::move(answer));
+}
+
+}  // namespace meridian::workbench
