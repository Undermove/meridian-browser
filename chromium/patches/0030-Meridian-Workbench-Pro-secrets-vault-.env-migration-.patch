+                        bool only_migrated = request.command.empty() &&
+                                             !request.paths.empty();
+                        for (const std::string& p : request.paths) {
+                          base::FilePath rel;
+                          only_migrated &=
+                              base.AppendRelativePath(base::FilePath(p), &rel) &&
+                              std::ranges::find(dotenvs, rel.value()) !=
+                                  dotenvs.end();
+                        }
+                        for (const std::string& rel : dotenvs) {
+                          self->MigrateDotenv(
+                              rel,
+                              base::BindOnce(
+                                  [](std::shared_ptr<size_t> remaining,
+                                     std::shared_ptr<std::vector<std::string>>
+                                         moved,
+                                     std::shared_ptr<std::string> failed,
+                                     std::shared_ptr<GuardServer::Answer> answer,
+                                     bool only_migrated, Result r) {
+                                    if (!r.has_value()) {
+                                      *failed = r.error();
+                                    } else if (const base::ListValue* names =
+                                                   r->GetDict().FindList(
+                                                       "imported")) {
+                                      for (const base::Value& n : *names) {
+                                        moved->push_back(n.GetString());
+                                      }
+                                    }
+                                    if (--*remaining || !*answer) {
+                                      return;
+                                    }
+                                    if (!failed->empty()) {
+                                      return std::move(*answer).Run(
+                                          "deny",
+                                          "Meridian couldn’t move the keys: " +
+                                              *failed);
+                                    }
+                                    std::string text =
+                                        "The values were moved to the "
+                                        "Meridian vault; the file now holds "
+                                        "only key names (" +
+                                        base::JoinString(*moved, ", ") +
+                                        "). They are set as environment "
+                                        "variables in sessions Meridian starts "
+                                        "— restart this session to get them.";
+                                    if (only_migrated) {
+                                      return std::move(*answer).Run("allow",
+                                                                    text);
+                                    }
+                                    std::move(*answer).Run(
+                                        "deny",
+                                        text +
+                                            " This request was not run "
+                                            "because it also reads other "
+                                            "files or runs a command — retry "
+                                            "it if you still need it.");
+                                  },
+                                  remaining, moved, failed, shared_answer,
+                                  only_migrated));
+                        }
+                        return;
+                      }
+                      std::string hint =
+                          " Ask the user to add the keys you need to the "
+                          "Meridian vault; they will be provided as "
+                          "environment variables.";
+                      if (self) {
+                        std::map<std::string, std::string> env =
+                            WorkbenchServiceFactory::GetForProfile(
+                                self->profile_)
+                                ->vault()
+                                .EnvFor(root);
