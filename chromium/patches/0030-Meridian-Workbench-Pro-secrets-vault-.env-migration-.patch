new file mode 100644
index 0000000000..6f9d2a81ba
--- /dev/null
+++ b/chrome/browser/meridian/workbench/guard_hook.cc
@@ -0,0 +1,215 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/guard_hook.h"
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <cstdlib>
+#include <iostream>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/meridian/workbench/secret_files.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+constexpr std::string_view kSwitch = "--secret-guard";
+
+base::span<const char*> Args(int argc, const char** argv) {
+  // SAFETY: main() gives `argc` arguments in `argv`.
+  return UNSAFE_BUFFERS(base::span(argv, static_cast<size_t>(argc)));
+}
+
+void Out(const std::string& decision, const std::string& reason) {
+  if (!decision.empty()) {
+    base::DictValue out;
+    out.Set("hookSpecificOutput",
+            base::DictValue()
+                .Set("hookEventName", "PreToolUse")
+                .Set("permissionDecision", decision)
+                .Set("permissionDecisionReason", reason));
+    std::cout << base::WriteJson(out).value_or("") << std::flush;
+  }
+}
+
+// The real path of `p` (symlinks resolved); for a path that doesn't exist
+// yet, its parent's real path.
+std::string RealOf(const base::FilePath& p) {
+  base::FilePath real = base::MakeAbsoluteFilePath(p);
+  if (!real.empty()) {
+    return real.value();
+  }
+  base::FilePath parent = base::MakeAbsoluteFilePath(p.DirName());
+  return parent.empty() ? p.value() : parent.Append(p.BaseName()).value();
+}
+
+bool IsSecret(std::string p) {
+  base::ReplaceChars(p, "*", "x", &p);
+  return IsSecretFile(p);
+}
+
+}  // namespace
+
+bool IsSecretGuard(int argc, const char** argv) {
+  for (const char* arg : Args(argc, argv).subspan(1u)) {
+    if (std::string_view(arg) == kSwitch) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::optional<GuardHit> CheckToolCall(const base::DictValue& ev) {
+  const std::string* tool_p = ev.FindString("tool_name");
+  std::string tool = tool_p ? *tool_p : std::string();
+  const base::DictValue* raw_input = ev.FindDict("tool_input");
+  base::DictValue empty;
+  const base::DictValue& input = raw_input ? *raw_input : empty;
+  const std::string* cwd_p = ev.FindString("cwd");
+  base::FilePath cwd(cwd_p ? *cwd_p : "/");
+  std::vector<base::FilePath> paths;
+  auto add = [&](const base::Value* v) {
+    if (v && v->is_string() && !v->GetString().empty()) {
+      base::FilePath p(v->GetString());
+      paths.push_back(p.IsAbsolute() ? p : cwd.Append(p));
+    }
+  };
+  GuardHit hit;
+  if (tool == "Read" || tool == "NotebookRead" || tool == "NotebookEdit" ||
+      tool == "Edit" || tool == "MultiEdit" || tool == "LSP") {
+    add(input.Find("file_path"));
+    add(input.Find("notebook_path"));
+    add(input.Find("filePath"));
+  } else if (tool == "Grep") {
+    add(input.Find("path"));
+    const std::string* glob = input.FindString("glob");
+    if (glob && IsSecret(*glob)) {
+      const std::string* base = input.FindString("path");
+      base::Value joined(
+          base::FilePath(base ? *base : ".").Append(*glob).value());
+      add(&joined);
+    }
+  } else if (tool == "Glob") {
+    const std::string* pattern = input.FindString("pattern");
+    if (pattern && (pattern->find(".env") != std::string::npos ||
+                    pattern->find(".pem") != std::string::npos ||
+                    pattern->find("id_rsa") != std::string::npos ||
+                    base::ToLowerASCII(*pattern).find("credentials") !=
+                        std::string::npos)) {
+      const std::string* base = input.FindString("path");
+      base::Value joined(
+          base::FilePath(base ? *base : ".").Append(*pattern).value());
+      add(&joined);
+    }
+  } else if (tool == "Bash" || tool == "PowerShell" || tool == "Monitor" ||
+             tool == "REPL") {
+    for (const auto [key, value] : input) {
+      if (value.is_string() && CommandNamesSecretFile(value.GetString())) {
+        hit.command = value.GetString();
+        break;
+      }
+    }
+  }
+  for (const base::FilePath& p : paths) {
+    std::string real = RealOf(p);
+    if (IsSecret(real)) {
+      hit.paths.push_back(real);
+    } else if (IsSecret(p.value())) {
+      hit.paths.push_back(p.value());
+    }
+  }
+  if (hit.paths.empty() && hit.command.empty()) {
+    return std::nullopt;
+  }
+  return hit;
+}
+
+int RunSecretGuard(int argc, const char** argv) {
+  std::string input;
+  for (int c = std::cin.get(); c != EOF; c = std::cin.get()) {
+    input += static_cast<char>(c);
+    if (input.size() > 2000000) {
+      return 0;
+    }
+  }
+  std::optional<base::Value> ev = base::JSONReader::Read(input, 0);
+  if (!ev || !ev->is_dict()) {
+    return 0;
+  }
+  std::optional<GuardHit> hit = CheckToolCall(ev->GetDict());
+  if (!hit) {
+    return 0;
+  }
+  const char* socket_path = getenv("MERIDIAN_GUARD_SOCKET");
+  const char* token = getenv("MERIDIAN_GUARD_TOKEN");
+  constexpr char kAsk[] = "This reads a file that may contain secrets.";
+  sockaddr_un addr = {};
+  if (!socket_path || !token || strlen(socket_path) >= sizeof(addr.sun_path)) {
+    Out("ask", kAsk);
+    return 0;
+  }
+  base::ListValue paths;
+  for (const std::string& p : hit->paths) {
+    paths.Append(p);
+  }
+  std::string request =
+      base::WriteJson(base::DictValue()
+                          .Set("token", token)
+                          .Set("tool", *ev->GetDict().FindString("tool_name"))
+                          .Set("paths", std::move(paths))
+                          .Set("command", hit->command.empty()
+                                              ? base::Value()
+                                              : base::Value(hit->command)))
+          .value_or("{}") +
+      "\n";
+  int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  addr.sun_family = AF_UNIX;
+  base::span(addr.sun_path)
+      .copy_prefix_from(base::span(std::string_view(socket_path)));
+  std::string answer;
+  if (fd >= 0 &&
+      connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) == 0 &&
+      base::WriteFileDescriptor(fd, request)) {
+    // The person may take a while to decide.
+    pollfd p = {fd, POLLIN, 0};
+    std::array<char, 4096> chunk;
+    while (poll(&p, 1, 135000) > 0) {
+      ssize_t n = read(fd, chunk.data(), chunk.size());
+      if (n <= 0) {
+        break;
+      }
+      answer.append(base::as_string_view(
+          base::span(chunk).first(static_cast<size_t>(n))));
+    }
+  }
+  if (fd >= 0) {
+    close(fd);
+  }
+  std::optional<base::Value> reply = base::JSONReader::Read(
+      base::TrimWhitespaceASCII(answer, base::TRIM_ALL), 0);
+  const std::string* decision =
+      reply && reply->is_dict() ? reply->GetDict().FindString("decision")
+                                : nullptr;
+  if (!decision ||
+      (*decision != "allow" && *decision != "deny" && *decision != "ask")) {
+    Out("ask", "Meridian could not be reached; this reads a file that may "
+               "contain secrets.");
+    return 0;
+  }
+  const std::string* reason = reply->GetDict().FindString("reason");
+  Out(*decision, reason ? reason->substr(0, 1000) : std::string());
+  return 0;
+}
+
+}  // namespace meridian::workbench
