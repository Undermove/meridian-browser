@@ -0,0 +1,59 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/native_dialog.h"
+
+#import <AppKit/AppKit.h>
+
+#include "base/command_line.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/native_ui_types.h"
+
+namespace meridian::workbench {
+
+void AskNative(content::WebContents* contents,
+               const std::string& message,
+               const std::string& detail,
+               const std::vector<std::string>& buttons,
+               base::OnceCallback<void(int)> done) {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (cl->HasSwitch("meridian-test-dialog-answer")) {
+    std::string answer = cl->GetSwitchValueASCII("meridian-test-dialog-answer");
+    int index = 0;
+    for (size_t i = 0; i < buttons.size(); ++i) {
+      if (buttons[i] == answer) {
+        index = static_cast<int>(i);
+      }
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), index));
+    return;
+  }
+  NSAlert* alert = [[NSAlert alloc] init];
+  alert.alertStyle = NSAlertStyleWarning;
+  alert.messageText = base::SysUTF8ToNSString(message);
+  alert.informativeText = base::SysUTF8ToNSString(detail);
+  for (const std::string& b : buttons) {
+    [alert addButtonWithTitle:base::SysUTF8ToNSString(b)];
+  }
+  if (alert.buttons.count) {
+    alert.buttons[0].keyEquivalent = @"\r";
+  }
+  __block base::OnceCallback<void(int)> callback = std::move(done);
+  void (^finish)(NSModalResponse) = ^(NSModalResponse response) {
+    int index = static_cast<int>(response - NSAlertFirstButtonReturn);
+    std::move(callback).Run(index >= 0 ? index : 0);
+  };
+  NSWindow* window =
+      contents ? contents->GetTopLevelNativeWindow().GetNativeNSWindow() : nil;
+  if (window) {
+    [alert beginSheetModalForWindow:window completionHandler:finish];
+  } else {
+    finish([alert runModal]);
+  }
+}
+
+}  // namespace meridian::workbench
diff --git a/chrome/browser/meridian/workbench/secret_files.cc b/chrome/browser/meridian/workbench/secret_files.cc
new file mode 100644
index 0000000000..f0e268aead
--- /dev/null
+++ b/chrome/browser/meridian/workbench/secret_files.cc
@@ -0,0 +1,259 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/secret_files.h"
+
+#include <cmath>
+#include <map>
+#include <set>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/meridian/mission/secrets.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+constexpr char kHeader[] =
+    "# Values of the empty keys below are stored in the Meridian vault "
+    "(encrypted) and are set as";
+constexpr char kHeader2[] =
+    "# environment variables in terminals and agents that Meridian starts "
+    "for this project.";
+
+bool IsTemplateSuffix(std::string_view suffix) {
+  std::string s = base::ToLowerASCII(suffix);
+  return s == "example" || s == "sample" || s == "template" || s == "dist" ||
+         s == "defaults";
+}
+
+std::string BaseName(const std::string& path) {
+  size_t slash = path.find_last_of("/\\");
+  return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+double Entropy(const std::string& s) {
+  std::map<char, int> counts;
+  for (char c : s) {
+    ++counts[c];
+  }
+  double h = 0;
+  for (const auto& [c, n] : counts) {
+    double p = static_cast<double>(n) / s.size();
+    h -= p * std::log2(p);
+  }
+  return h;
+}
+
+}  // namespace
+
+bool IsDotenvFile(const std::string& path) {
+  std::string base = base::ToLowerASCII(BaseName(path));
+  if (base == ".env") {
+    return true;
+  }
+  if (!base.starts_with(".env.")) {
+    return false;
+  }
+  std::string suffix = base.substr(5);
+  return !suffix.empty() && !IsTemplateSuffix(suffix) &&
+         RE2::FullMatch(suffix, "[\\w.-]+");
+}
+
+bool IsSecretFile(const std::string& path) {
+  std::string base = BaseName(path);
+  if (IsDotenvFile(path)) {
+    return true;
+  }
+  static const base::NoDestructor<RE2> other(
+      "(?i)\\.envrc|([\\w.-]*[-_.])?credentials(\\.(json|ya?ml|toml|ini))?|"
+      "service[-_]account[\\w.-]*\\.json|.*\\.pem|.*\\.p12|"
+      "id_(rsa|dsa|ecdsa|ed25519)|\\.npmrc|\\.pypirc|\\.netrc|"
+      "\\.git-credentials|secrets?\\.(json|ya?ml|toml)");
+  return RE2::FullMatch(base, *other);
+}
+
+bool CommandNamesSecretFile(const std::string& command) {
+  static const base::NoDestructor<RE2> word(
+      "(?i)(?:^|[\\s'\"=<>|;&(\\\\/])(\\.env(?:\\.[\\w-]+)?|\\.envrc|"
+      "credentials(?:\\.json)?|[\\w.-]+\\.pem|id_(?:rsa|dsa|ecdsa|ed25519)|"
+      "\\.npmrc|\\.netrc|\\.git-credentials)(?:$|[\\s'\";|&)<>])");
+  std::string_view input(command);
+  std::string_view match;
+  while (RE2::FindAndConsume(&input, *word, &match)) {
+    std::string m = base::ToLowerASCII(match);
+    if (m.starts_with(".env.") && IsTemplateSuffix(m.substr(5))) {
+      continue;
+    }
+    return true;
+  }
+  return false;
+}
+
+bool IsSecretEntry(const std::string& name, const std::string& value) {
+  if (RE2::PartialMatch(name,
+                        "(?i)(KEY|TOKEN|SECRET|PASSW(OR)?D|PWD|PASS|AUTH|"
+                        "CREDENTIAL|PRIVATE|DSN|SIGNING|SALT|WEBHOOK|COOKIE|"
+                        "SESSION)")) {
+    return true;
+  }
+  if (RE2::PartialMatch(name,
+                        "(?i)((DATABASE|DB|REDIS|MONGO(DB)?|POSTGRES(QL)?|PG|"
+                        "MYSQL|AMQP|RABBIT(MQ)?|SMTP)_?URL|URI|CONNECTION_?"
+                        "STRING)$") &&
+      RE2::PartialMatch(value, "://[^/\\s:@]+:[^/\\s@]+@")) {
+    return true;
+  }
+  if (!mission::FindSecrets(value).empty()) {
+    return true;
+  }
+  return value.size() >= 24 && Entropy(value) >= 4 &&
+         std::ranges::any_of(value, base::IsAsciiDigit<char>) &&
+         std::ranges::any_of(value, base::IsAsciiAlpha<char>) &&
+         value.find_first_of(" \t/") == std::string::npos;
+}
+
+std::vector<DotenvEntry> ParseDotenv(const std::string& text) {
+  std::vector<DotenvEntry> out;
+  std::vector<std::string> lines = base::SplitString(
+      text, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  static const base::NoDestructor<RE2> entry(
+      "^\\s*(?:export\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(.*)$");
+  for (size_t i = 0; i < lines.size(); ++i) {
+    std::string line = lines[i];
+    if (line.ends_with("\r")) {
+      line.pop_back();
+    }
+    std::string name, raw;
+    if (!RE2::FullMatch(line, *entry, &name, &raw)) {
+      continue;
+    }
+    std::string v(base::TrimWhitespaceASCII(raw, base::TRIM_ALL));
+    if (!v.empty() && (v[0] == '"' || v[0] == '\'') &&
+        (v.size() < 2 || v.back() != v[0])) {
+      continue;  // a multi-line value: left alone
+    }
+    if (v.size() >= 2 && (v[0] == '"' || v[0] == '\'') && v.back() == v[0]) {
+      bool dq = v[0] == '"';
+      v = v.substr(1, v.size() - 2);
+      if (dq) {
+        base::ReplaceSubstringsAfterOffset(&v, 0, "\\n", "\n");
+        base::ReplaceSubstringsAfterOffset(&v, 0, "\\\"", "\"");
+        base::ReplaceSubstringsAfterOffset(&v, 0, "\\\\", "\\");
+      }
+    } else {
+      RE2::Replace(&v, "\\s+#.*$", "");
+    }
+    if (!v.empty()) {
+      out.push_back({name, v, i, IsSecretEntry(name, v)});
+    }
+  }
+  return out;
+}
+
+bool IsReservedName(const std::string& name) {
+  static const base::NoDestructor<RE2> reserved(
+      "PATH|HOME|USER|LOGNAME|SHELL|PWD|OLDPWD|TERM|TERM_PROGRAM|COLORTERM|"
+      "LANG|LC_[A-Z_]+|TMPDIR|TEMP|TMP|NODE_OPTIONS|NODE_PATH|LD_[A-Z_]+|"
+      "DYLD_[A-Z_]+|PYTHONPATH|PYTHONSTARTUP|PERL5LIB|PERL5OPT|RUBYOPT|"
+      "BASH_ENV|ENV|ZDOTDIR|PROMPT_COMMAND|IFS|SSH_AUTH_SOCK|DISPLAY|"
+      "XDG_[A-Z_]+|MERIDIAN_[A-Z_]+|ELECTRON_[A-Z_]+");
+  return RE2::FullMatch(name, *reserved);
+}
+
+bool IsValidSecretName(const std::string& name) {
+  return RE2::FullMatch(name, "[A-Z_][A-Z0-9_]{0,63}") &&
+         !IsReservedName(name);
+}
+
+base::ListValue ScanProject(const base::FilePath& root) {
+  static const base::NoDestructor<std::set<std::string>> skip(
+      std::set<std::string>{"node_modules", ".git", ".hg", ".svn", "dist",
+                            "build", ".next", "target", "vendor", ".venv",
+                            "venv", "__pycache__", ".cache"});
+  base::ListValue found;
+  size_t seen = 0;
+  struct Dir {
+    base::FilePath path;
+    int depth;
+  };
+  std::vector<Dir> stack = {{root, 0}};
+  while (!stack.empty() && seen < 20000 && found.size() < 50) {
+    Dir dir = stack.back();
+    stack.pop_back();
+    base::FileEnumerator e(dir.path, false,
+                           base::FileEnumerator::FILES |
+                               base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath p = e.Next(); !p.empty() && found.size() < 50;
+         p = e.Next()) {
+      if (++seen > 20000) {
+        break;
+      }
+      std::string name = p.BaseName().value();
+      if (e.GetInfo().IsDirectory()) {
+        if (!skip->contains(name) && dir.depth < 6) {
+          stack.push_back({p, dir.depth + 1});
+        }
+        continue;
+      }
+      base::FilePath rel_path;
+      root.AppendRelativePath(p, &rel_path);
+      std::string rel = rel_path.value();
+      if (!IsSecretFile(rel)) {
+        continue;
+      }
+      bool dotenv = IsDotenvFile(rel);
+      base::ListValue keys;
+      if (dotenv) {
+        std::string text;
+        if (e.GetInfo().GetSize() < 256 * 1024 &&
+            base::ReadFileToString(p, &text)) {
+          for (const DotenvEntry& entry : ParseDotenv(text)) {
+            if (entry.secret) {
+              keys.Append(entry.name);
+            }
+          }
+        }
+        if (keys.empty()) {
+          continue;  // a template or plain settings: nothing to protect
+        }
+      }
+      found.Append(base::DictValue()
+                       .Set("path", rel)
+                       .Set("dotenv", dotenv)
+                       .Set("keys", std::move(keys)));
+    }
+  }
+  return found;
+}
+
+std::string BlankDotenv(const std::string& text,
+                        const std::vector<DotenvEntry>& moved) {
+  std::string eol = text.find("\r\n") != std::string::npos ? "\r\n" : "\n";
+  std::vector<std::string> lines = base::SplitString(
+      text, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  for (std::string& l : lines) {
+    if (l.ends_with("\r")) {
+      l.pop_back();
+    }
+  }
+  for (const DotenvEntry& e : moved) {
+    if (e.line < lines.size()) {
+      RE2::Replace(&lines[e.line],
+                   "^(\\s*(?:export\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*=).*$",
+                   "\\1");
+    }
+  }
+  if (!moved.empty() && text.find(kHeader) == std::string::npos) {
+    lines.insert(lines.begin(), {kHeader, kHeader2});
+  }
+  return base::JoinString(lines, eol);
+}
+
+}  // namespace meridian::workbench
