+// The Workbench secrets vault ("Meridian Vault.json" in the profile, 0600).
+//  - Values are encrypted with Chromium's OS-backed encryption (the macOS
+//    keychain) before they touch the disk; the file holds only names, scopes,
+//    notes and ciphertext.
+//  - Plaintext exists only in memory, in the environment of processes the
+//    Workbench starts (terminals, agents, sandboxes), and in the page when the
+//    person confirms Reveal in a native dialog.
+//  - Scope: "global" or the real path of one project folder.
+class Vault {
+ public:
+  explicit Vault(base::FilePath file);
+  Vault(const Vault&) = delete;
+  Vault& operator=(const Vault&) = delete;
+  ~Vault();
+
+  // Runs `ready` once the file is read and the encryptor is available.
+  void WhenReady(base::OnceClosure ready);
+  // A reason when values can't be encrypted, else empty.
+  std::string UnavailableReason() const;
+
+  // Metadata only, never values: [{id, name, scope, note, sandbox,
+  // createdAt, updatedAt}] for global items and `project`'s.
+  base::ListValue List(const std::string& project) const;
+  // {id?, name, value?, scope: "global"|"project", note, sandbox}; the value
+  // may be left out when editing metadata.
+  base::expected<base::DictValue, std::string> Set(const base::DictValue& item,
+                                                   const std::string& project);
+  base::expected<std::string, std::string> Reveal(
+      const std::string& id,
+      const std::string& project) const;
+  bool Remove(const std::string& id, const std::string& project);
+  // NAME -> value for a process started in `project` (project scope wins).
+  std::map<std::string, std::string> EnvFor(const std::string& project) const;
+  // Every value with its name (Mission Control masks them in summaries).
+  std::vector<std::pair<std::string, std::string>> AllValues() const;
+  // What a sandbox gets unless the person picks otherwise: what the agent
+  // needs to sign in (`needs`) plus project secrets marked for sandboxes.
+  std::vector<std::string> SandboxDefaults(
+      const std::string& project,
+      const std::vector<std::string>& needs) const;
+
+ private:
+  void Save();
+
+  base::FilePath file_;
+  // Reads and writes, in order.
+  scoped_refptr<base::SequencedTaskRunner> files_;
+  bool loaded_ = false;
+  scoped_refptr<os_crypt_async::Encryptor> encryptor_;
+  bool encryptor_done_ = false;
+  std::vector<base::OnceClosure> waiting_;
+  base::ListValue items_;
+  base::WeakPtrFactory<Vault> weak_factory_{this};
+};
+
