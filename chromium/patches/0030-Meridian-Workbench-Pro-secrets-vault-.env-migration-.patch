+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_WORKBENCH_SERVICE_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_WORKBENCH_SERVICE_H_
+
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/meridian/workbench/guard_server.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+class Profile;
+
+namespace meridian::workbench {
+
+class Vault;
+
+// What every Workbench tab of a profile shares: the secrets vault and the
+// secret-file guard's socket.
+class WorkbenchService : public KeyedService {
+ public:
+  // Decides about one guarded tool call (the Workbench that started the
+  // session asks the person).
+  using GuardDecider = base::RepeatingCallback<void(GuardServer::Request,
+                                                    GuardServer::Answer)>;
+
+  explicit WorkbenchService(Profile* profile);
+  WorkbenchService(const WorkbenchService&) = delete;
+  WorkbenchService& operator=(const WorkbenchService&) = delete;
+  ~WorkbenchService() override;
+
+  Vault& vault() { return *vault_; }
+  GuardServer& guard() { return *guard_; }
+
+  // A guarded Claude Code session; returns its token.
+  std::string RegisterGuard(GuardDecider decider);
+  void UnregisterGuard(const std::string& token);
+
+ private:
+  void Decide(const std::string& session,
+              GuardServer::Request request,
+              GuardServer::Answer answer);
+
+  std::unique_ptr<Vault> vault_;
+  std::unique_ptr<GuardServer> guard_;
+  // session id -> who decides.
+  std::map<std::string, GuardDecider> deciders_;
+  std::map<std::string, std::string> tokens_;
+  int next_session_ = 0;
+  base::WeakPtrFactory<WorkbenchService> weak_factory_{this};
+};
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_WORKBENCH_SERVICE_H_
