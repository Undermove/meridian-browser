+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_GUARD_HOOK_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_GUARD_HOOK_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+
+namespace meridian::workbench {
+
+// `Meridian --secret-guard`: Claude Code's PreToolUse hook that asks
+// Meridian before the agent reads a secret file. It starts no browser.
+// File tools (Read, Edit, NotebookEdit, LSP, Grep, Glob) are checked by path,
+// both as given and by real path (a symlink can't hide a secret file);
+// shell-like tools by a secret file name appearing in the command.
+// stdout: nothing (no opinion) or a permission decision. When Meridian can't
+// be reached it answers "ask", never a silent allow.
+bool IsSecretGuard(int argc, const char** argv);
+int RunSecretGuard(int argc, const char** argv);
+
+// What a tool call touches: secret paths, or the command that names one.
+struct GuardHit {
+  std::vector<std::string> paths;
+  std::string command;
+};
+std::optional<GuardHit> CheckToolCall(const base::DictValue& event);
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_GUARD_HOOK_H_
