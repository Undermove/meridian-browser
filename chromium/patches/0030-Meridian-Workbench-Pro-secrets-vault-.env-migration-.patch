+void WorkbenchHandler::VaultCall(const std::string& method,
+                                 const base::ListValue& params,
+                                 Reply reply) {
+  WorkbenchService* service = WorkbenchServiceFactory::GetForProfile(profile_);
+  std::string root = project_ ? project_->root().value() : std::string();
+  std::string a = StringParam(params, 0);
+  base::DictValue item = params.size() && params[0].is_dict()
+                             ? params[0].GetDict().Clone()
+                             : base::DictValue();
+  if (method == "secretScan") {
+    if (!project_) {
+      return std::move(reply).Run(base::unexpected("no project is open"));
+    }
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::FilePath root) -> Result {
+              return base::Value(ScanProject(root));
+            },
+            project_->root()),
+        std::move(reply));
+    return;
+  }
+  // Everything else needs the vault open.
+  service->vault().WhenReady(base::BindOnce(
+      [](base::WeakPtr<WorkbenchHandler> self, std::string method,
+         std::string root, std::string a, base::DictValue item, Reply reply) {
+        if (!self) {
+          return;
+        }
+        Vault& vault =
+            WorkbenchServiceFactory::GetForProfile(self->profile_)->vault();
+        if (method == "vaultList") {
+          std::string why = vault.UnavailableReason();
+          return std::move(reply).Run(base::Value(
+              base::DictValue()
+                  .Set("unavailable", why.empty() ? base::Value()
+                                                  : base::Value(why))
+                  .Set("items", vault.List(root))
+                  .Set("project", self->project_
+                                      ? base::Value(self->project_->name())
+                                      : base::Value())));
+        }
+        if (method == "vaultSet") {
+          base::expected<base::DictValue, std::string> r =
+              vault.Set(item, root);
+          if (r.has_value()) {
+            self->Broadcast("wb:vault-change");
+          }
+          return std::move(reply).Run(Wrap(std::move(r)));
+        }
+        if (method == "vaultDelete") {
+          bool ok = vault.Remove(a, root);
+          self->Broadcast("wb:vault-change");
+          return std::move(reply).Run(base::Value(ok));
+        }
+        if (method == "vaultReveal") {
+          // Always a native confirm: a click in the page (or a plugin) isn't
+          // enough.
+          const base::DictValue* found = nullptr;
+          base::ListValue list = vault.List(root);
+          for (const base::Value& i : list) {
+            if (*i.GetDict().FindString("id") == a) {
+              found = &i.GetDict();
+            }
+          }
+          if (!found) {
+            return std::move(reply).Run(base::unexpected("No such secret."));
+          }
+          bool project = *found->FindString("scope") == "project";
+          AskNative(
+              self->web_ui()->GetWebContents(),
+              "Show the value of " + *found->FindString("name") + "?",
+              std::string(project ? "Project" : "Global") +
+                  " secret. The value is shown in the Workbench for 20 "
+                  "seconds; anything running in the Workbench page, "
+                  "including plugins, can read what is shown there.",
+              {"Cancel", "Reveal"},
+              base::BindOnce(
+                  [](base::WeakPtr<WorkbenchHandler> self, std::string id,
+                     std::string root, Reply reply, int choice) {
+                    if (!self) {
+                      return;
+                    }
+                    if (choice != 1) {
+                      return std::move(reply).Run(
+                          base::unexpected("Not revealed."));
+                    }
+                    base::expected<std::string, std::string> value =
+                        WorkbenchServiceFactory::GetForProfile(self->profile_)
+                            ->vault()
+                            .Reveal(id, root);
+                    std::move(reply).Run(Wrap(std::move(value)));
+                  },
+                  self, a, root, std::move(reply)));
+          return;
+        }
+        if (method == "secretMigrate") {
+          return self->MigrateDotenv(a, std::move(reply));
+        }
+        std::move(reply).Run(base::unexpected("unknown vault call"));
+      },
+      weak_factory_.GetWeakPtr(), method, root, a, std::move(item),
+      std::move(reply)));
+}
