+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/guard_hook.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::workbench {
+namespace {
+
+TEST(GuardHookTest, CatchesSecretFilesEvenBehindASymlink) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::FilePath root = base::MakeAbsoluteFilePath(dir.GetPath());
+  ASSERT_TRUE(base::WriteFile(root.Append(".env"), "KEY=1"));
+  ASSERT_TRUE(base::CreateSymbolicLink(root.Append(".env"),
+                                       root.Append("notes.txt")));
+  auto check = [&](const std::string& json) {
+    return CheckToolCall(base::JSONReader::Read(json, 0)->GetDict());
+  };
+  std::string cwd = "\"cwd\": \"" + root.value() + "\"";
+  std::optional<GuardHit> hit = check(
+      "{\"tool_name\": \"Read\", " + cwd + ", \"tool_input\": {\"file_path\": "
+      "\"notes.txt\"}}");
+  ASSERT_TRUE(hit);
+  EXPECT_EQ(hit->paths[0], root.Append(".env").value());
+  EXPECT_FALSE(check("{\"tool_name\": \"Read\", " + cwd +
+                     ", \"tool_input\": {\"file_path\": \"README.md\"}}"));
+  hit = check("{\"tool_name\": \"Bash\", " + cwd +
+              ", \"tool_input\": {\"command\": \"cat .env | head\"}}");
+  ASSERT_TRUE(hit);
+  EXPECT_EQ(hit->command, "cat .env | head");
+  EXPECT_TRUE(check("{\"tool_name\": \"Glob\", " + cwd +
+                    ", \"tool_input\": {\"pattern\": \"**/.env\"}}"));
+  EXPECT_FALSE(check("{\"tool_name\": \"WebFetch\", \"tool_input\": "
+                     "{\"url\": \"https://x/.env\"}}"));
+}
+
+}  // namespace
+}  // namespace meridian::workbench
diff --git a/chrome/browser/meridian/workbench/guard_server.cc b/chrome/browser/meridian/workbench/guard_server.cc
new file mode 100644
index 0000000000..3e59975453
--- /dev/null
+++ b/chrome/browser/meridian/workbench/guard_server.cc
@@ -0,0 +1,321 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/guard_server.h"
+
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <array>
+#include <atomic>
+#include <map>
+
+#include "base/containers/span.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/memory/ref_counted.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_view_util.h"
+#include "base/synchronization/lock.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/time/time.h"
+#include "crypto/secure_util.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+constexpr size_t kMaxRequest = 64 * 1024;
+constexpr base::TimeDelta kTimeout = base::Seconds(150);
+
+void SetNonBlocking(int fd) {
+  int flags = fcntl(fd, F_GETFL);
+  if (flags != -1) {
+    fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+  }
+  fcntl(fd, F_SETFD, FD_CLOEXEC);
+}
+
+std::string Line(const std::string& decision, const std::string& reason) {
+  return base::WriteJson(base::DictValue()
+                             .Set("decision", decision)
+                             .Set("reason", reason))
+             .value_or("{}") +
+         "\n";
+}
+
+}  // namespace
+
+class GuardServer::Core : public base::RefCountedThreadSafe<Core> {
+ public:
+  explicit Core(Decide decide) : decide_(std::move(decide)) {}
+
+  void Run(base::OnceCallback<void(base::FilePath)> started) {
+    base::ScopedBlockingCall blocking(FROM_HERE,
+                                      base::BlockingType::WILL_BLOCK);
+    base::FilePath dir;
+    sockaddr_un addr = {};
+    addr.sun_family = AF_UNIX;
+    base::ScopedFD listener(socket(AF_UNIX, SOCK_STREAM, 0));
+    int wake[2];
+    if (!base::CreateNewTempDirectory("mg-", &dir) || !listener.is_valid() ||
+        pipe(wake) != 0) {
+      std::move(started).Run(base::FilePath());
+      return;
+    }
+    base::SetPosixFilePermissions(dir, 0700);
+    base::FilePath path = dir.Append("guard.sock");
+    if (path.value().size() >= sizeof(addr.sun_path)) {
+      std::move(started).Run(base::FilePath());
+      return;
+    }
+    base::span(addr.sun_path)
+        .copy_prefix_from(base::span(std::string_view(path.value())));
+    if (bind(listener.get(), reinterpret_cast<sockaddr*>(&addr),
+             sizeof(addr)) != 0 ||
+        listen(listener.get(), 16) != 0) {
+      std::move(started).Run(base::FilePath());
+      return;
+    }
+    base::SetPosixFilePermissions(path, 0600);
+    SetNonBlocking(listener.get());
+    base::ScopedFD wake_read(wake[0]);
+    {
+      base::AutoLock hold(lock_);
+      wake_write_ = wake[1];
+    }
+    SetNonBlocking(wake_read.get());
+    std::move(started).Run(path);
+
+    struct Conn {
+      base::ScopedFD fd;
+      std::string buffer;
+      base::TimeTicks deadline;
+      bool asked = false;
+    };
+    std::map<int, Conn> conns;
+    int next_id = 0;
+    std::array<char, 8192> chunk;
+    while (!stop_) {
+      std::vector<pollfd> fds = {{listener.get(), POLLIN, 0},
+                                 {wake_read.get(), POLLIN, 0}};
+      std::vector<int> ids;
+      for (const auto& [id, c] : conns) {
+        if (!c.asked) {
+          fds.push_back({c.fd.get(), POLLIN, 0});
+          ids.push_back(id);
+        }
+      }
+      HANDLE_EINTR(poll(fds.data(), fds.size(), 500));
+      base::TimeTicks now = base::TimeTicks::Now();
+      if (fds[1].revents & POLLIN) {
+        while (HANDLE_EINTR(read(wake_read.get(), chunk.data(), chunk.size())) > 0) {
+        }
+      }
+      // Answers from the person.
+      std::vector<std::pair<int, std::string>> answers;
+      {
+        base::AutoLock hold(lock_);
+        answers.swap(answers_);
+      }
+      for (auto& [id, line] : answers) {
+        auto it = conns.find(id);
+        if (it != conns.end()) {
+          base::WriteFileDescriptor(it->second.fd.get(), line);
+          conns.erase(it);
+        }
+      }
+      for (size_t i = 0; i < ids.size(); ++i) {
+        auto it = conns.find(ids[i]);
+        if (it == conns.end() || !(fds[i + 2].revents & (POLLIN | POLLHUP))) {
+          continue;
+        }
+        Conn& c = it->second;
+        ssize_t n = HANDLE_EINTR(read(c.fd.get(), chunk.data(), chunk.size()));
+        if (n <= 0) {
+          if (n == 0 || errno != EAGAIN) {
+            conns.erase(it);
+          }
+          continue;
+        }
+        c.buffer.append(base::as_string_view(
+            base::span(chunk).first(static_cast<size_t>(n))));
+        if (c.buffer.size() > kMaxRequest) {
+          base::WriteFileDescriptor(c.fd.get(),
+                                    Line("deny", "request too large"));
+          conns.erase(it);
+          continue;
+        }
+        size_t nl = c.buffer.find('\n');
+        if (nl == std::string::npos) {
+          continue;
+        }
+        std::optional<std::string> reply = Handle(ids[i], c.buffer.substr(0, nl));
+        if (reply) {
+          base::WriteFileDescriptor(c.fd.get(), *reply);
+          conns.erase(it);
+        } else {
+          c.asked = true;
+        }
+      }
+      if (fds[0].revents & POLLIN) {
+        base::ScopedFD fd(HANDLE_EINTR(accept(listener.get(), nullptr, nullptr)));
+        if (fd.is_valid() && conns.size() < 32) {
+          SetNonBlocking(fd.get());
+          conns[next_id++] = {std::move(fd), std::string(), now + kTimeout};
+        }
+      }
+      std::erase_if(conns, [&](const auto& kv) { return now > kv.second.deadline; });
+    }
+    listener.reset();
+    base::DeletePathRecursively(dir);
+  }
+
+  void Stop() {
+    stop_ = true;
+    Wake();
+  }
+
+  std::string Register(const std::string& session) {
+    std::string token = base::HexEncodeLower(base::RandBytesAsVector(32));
+    base::AutoLock hold(lock_);
+    sessions_[token] = session;
+    return token;
+  }
+
+  void Unregister(const std::string& token) {
+    base::AutoLock hold(lock_);
+    sessions_.erase(token);
+  }
+
+  void Answer(int conn, std::string decision, std::string reason) {
+    {
+      base::AutoLock hold(lock_);
+      answers_.emplace_back(conn, Line(decision, reason));
+    }
+    Wake();
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<Core>;
+  ~Core() {
+    if (wake_write_ >= 0) {
+      close(wake_write_);
+    }
+  }
+
+  void Wake() {
+    base::AutoLock hold(lock_);
+    if (wake_write_ >= 0) {
+      char c = 0;
+      HANDLE_EINTR(write(wake_write_, &c, 1));
+    }
+  }
+
+  // An immediate reply, or nullopt when the person is asked.
+  std::optional<std::string> Handle(int conn, const std::string& line) {
+    std::optional<base::Value> v = base::JSONReader::Read(line, 0);
+    if (!v || !v->is_dict()) {
+      return Line("deny", "bad request");
+    }
+    const base::DictValue& req = v->GetDict();
+    const std::string* given = req.FindString("token");
+    std::string session;
+    {
+      base::AutoLock hold(lock_);
+      for (const auto& [token, s] : sessions_) {
+        if (given && given->size() == token.size() &&
+            crypto::SecureMemEqual(base::as_byte_span(token),
+                                   base::as_byte_span(*given))) {
+          session = s;
+        }
+      }
+    }
+    if (session.empty()) {
+      return Line("ask", "Unknown Meridian session.");
+    }
+    Request request;
+    if (const std::string* tool = req.FindString("tool")) {
+      request.tool = tool->substr(0, 64);
+    }
+    if (const base::ListValue* paths = req.FindList("paths")) {
+      for (const base::Value& p : *paths) {
+        if (p.is_string() && request.paths.size() < 20) {
+          request.paths.push_back(p.GetString().substr(0, 4096));
+        }
+      }
+    }
+    if (const std::string* command = req.FindString("command")) {
+      request.command = command->substr(0, 2000);
+    }
+    decide_.Run(session, std::move(request),
+                base::BindOnce(&Core::Answer, base::WrapRefCounted(this), conn));
+    return std::nullopt;
+  }
+
+  Decide decide_;
+  std::atomic<bool> stop_{false};
+  base::Lock lock_;
+  int wake_write_ GUARDED_BY(lock_) = -1;
+  std::map<std::string, std::string> sessions_ GUARDED_BY(lock_);
+  std::vector<std::pair<int, std::string>> answers_ GUARDED_BY(lock_);
+};
+
+GuardServer::GuardServer(Decide decide)
+    : core_(base::MakeRefCounted<Core>(
+          base::BindPostTaskToCurrentDefault(std::move(decide)))) {}
+
+GuardServer::~GuardServer() {
+  core_->Stop();
+}
+
+void GuardServer::Start(base::OnceCallback<void(base::FilePath)> done) {
+  if (!socket_path_.empty()) {
+    std::move(done).Run(socket_path_);
+    return;
+  }
+  waiting_.push_back(std::move(done));
+  if (starting_) {
+    return;
+  }
+  starting_ = true;
+  auto started = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::WeakPtr<GuardServer> self, base::FilePath path) {
+        if (!self) {
+          return;
+        }
+        self->socket_path_ = path;
+        if (path.empty()) {
+          self->starting_ = false;
+        }
+        for (auto& w : self->waiting_) {
+          std::move(w).Run(path);
+        }
+        self->waiting_.clear();
+      },
+      weak_factory_.GetWeakPtr()));
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&Core::Run, core_, std::move(started)));
+}
+
+std::string GuardServer::Register(const std::string& session) {
+  return core_->Register(session);
+}
+
+void GuardServer::Unregister(const std::string& token) {
+  core_->Unregister(token);
+}
+
+}  // namespace meridian::workbench
