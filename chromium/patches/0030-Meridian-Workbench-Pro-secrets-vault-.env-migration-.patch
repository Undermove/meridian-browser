+// Hook lists concatenated per event, so every hook runs.
+base::DictValue MergeClaudeSettings(base::DictValue base,
+                                    const base::DictValue& more) {
+  for (const auto [key, value] : more) {
+    if (key != "hooks" || !value.is_dict()) {
+      base.Set(key, value.Clone());
+      continue;
+    }
+    base::DictValue* hooks = base.EnsureDict("hooks");
+    for (const auto [event, list] : value.GetDict()) {
+      base::ListValue* into = hooks->EnsureList(event);
+      if (list.is_list()) {
+        for (const base::Value& entry : list.GetList()) {
+          into->Append(entry.Clone());
+        }
+      }
+    }
+  }
+  return base;
+}
