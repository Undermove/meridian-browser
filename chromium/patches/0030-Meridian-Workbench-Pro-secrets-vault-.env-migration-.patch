+                       std::shared_ptr<std::set<std::string>> allowed,
+                       GuardServer::Request request, std::string key,
+                       std::vector<std::string> buttons,
+                       std::vector<std::string> dotenvs,
+                       GuardServer::Answer answer, int index) {
+                      std::string choice = buttons[index];
+                      if (choice == "Allow for this session") {
+                        allowed->insert(key);
+                        return std::move(answer).Run(
+                            "allow", "Allowed for this session in Meridian.");
+                      }
+                      if (choice == "Allow once") {
+                        return std::move(answer).Run("allow",
+                                                     "Allowed once in Meridian.");
+                      }
+                      if (choice == "Move keys to vault" && self) {
+                        // Move each file's keys, then allow the call only
+                        // if it reads nothing but those files.
+                        auto remaining = std::make_shared<size_t>(dotenvs.size());
+                        auto moved = std::make_shared<std::vector<std::string>>();
+                        auto failed = std::make_shared<std::string>();
+                        auto shared_answer =
+                            std::make_shared<GuardServer::Answer>(
