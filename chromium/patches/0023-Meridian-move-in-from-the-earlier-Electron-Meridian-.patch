new file mode 100644
index 0000000000..02f466ef79
--- /dev/null
+++ b/chrome/browser/meridian/electron_import.h
@@ -0,0 +1,64 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_ELECTRON_IMPORT_H_
+#define CHROME_BROWSER_MERIDIAN_ELECTRON_IMPORT_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/meridian/arc_import.h"
+#include "url/gurl.h"
+
+namespace meridian {
+
+// The earlier Meridian (Electron) kept everything in
+// ~/Library/Application Support/Meridian/state.json: spaces with pinned tabs,
+// folders and open tabs, favorites per profile, the archive and settings.
+// Moving to this Meridian brings it all over; the old files are only read.
+struct ElectronState {
+  ElectronState();
+  ElectronState(ElectronState&&);
+  ElectronState& operator=(ElectronState&&);
+  ~ElectronState();
+
+  struct ArchivedTab {
+    GURL url;
+    std::string title;
+    // Index into sidebar.spaces, or -1.
+    int space = -1;
+    base::Time closed_at;
+  };
+
+  // Spaces, open (Today) tabs and favorites, in the Arc import's shape.
+  ArcSidebar sidebar;
+  // The space that was open.
+  int active_space = 0;
+  // The old ids of sidebar.spaces (link rules point at them).
+  std::vector<std::string> space_ids;
+  std::vector<ArchivedTab> archive;
+  // Settings worth keeping (only the keys present).
+  std::optional<bool> sidebar_right;
+  std::optional<bool> adblock;
+  std::optional<int> archive_after_hours;
+  std::optional<std::string> mode;
+  std::optional<base::DictValue> atc;
+};
+
+// The Electron Meridian's folder, or the one given with
+// --meridian-electron-dir (tests).
+base::FilePath ElectronDataDir();
+
+std::optional<ElectronState> ParseElectronState(const base::DictValue& root);
+
+// Reads and parses state.json; blocking (file IO).
+std::optional<ElectronState> ReadElectronState();
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_ELECTRON_IMPORT_H_
