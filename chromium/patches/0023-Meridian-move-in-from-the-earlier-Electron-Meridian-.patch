+// Preview counts for an import (Arc or the Electron Meridian).
+mojom::ArcPreviewPtr PreviewOf(const ArcSidebar& sidebar, bool logins) {
+  auto preview = mojom::ArcPreview::New();
+  preview->space_count = sidebar.spaces.size();
+  preview->favorite_count = sidebar.favorites.size();
+  preview->logins_available = logins;
+  std::function<int(const std::vector<Item>&)> count =
+      [&](const std::vector<Item>& items) {
+        int n = 0;
+        for (const Item& item : items) {
+          n += item.is_folder ? count(item.children) : 1;
+        }
+        return n;
+      };
+  for (size_t i = 0; i < sidebar.spaces.size(); ++i) {
+    const Space& space = sidebar.spaces[i];
+    preview->pinned_count += count(space.pinned);
+    preview->today_count += sidebar.today[i].size();
+    if (i < 8) {
+      auto s = mojom::Space::New();
+      s->name = space.name;
+      s->icon = space.icon;
+      s->color = space.color;
+      s->color2 = space.color2;
+      preview->spaces.push_back(std::move(s));
+    }
+  }
+  return preview;
+}
