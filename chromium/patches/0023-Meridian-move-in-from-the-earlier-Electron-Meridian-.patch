diff --git a/chrome/browser/meridian/electron_import.cc b/chrome/browser/meridian/electron_import.cc
new file mode 100644
index 0000000000..283ad19581
--- /dev/null
+++ b/chrome/browser/meridian/electron_import.cc
@@ -0,0 +1,207 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/electron_import.h"
+
+#include <algorithm>
+
+#include "base/base_paths.h"
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr char kElectronDirSwitch[] = "meridian-electron-dir";
+
+const std::string& Str(const base::DictValue& d, const char* key) {
+  static const base::NoDestructor<std::string> empty;
+  const std::string* s = d.FindString(key);
+  return s ? *s : *empty;
+}
+
+// A pinned tab or folder; nullopt for anything else.
+std::optional<Item> ToItem(const base::DictValue& node, int depth = 0) {
+  if (depth > 32) {
+    return std::nullopt;
+  }
+  const std::string& type = Str(node, "type");
+  Item item;
+  if (type == "folder") {
+    item.is_folder = true;
+    item.title = Str(node, "title").empty() ? "Folder" : Str(node, "title");
+    item.open = !node.FindBool("collapsed").value_or(false);
+    if (const base::ListValue* children = node.FindList("children")) {
+      for (const base::Value& child : *children) {
+        if (const base::DictValue* c = child.GetIfDict()) {
+          if (std::optional<Item> i = ToItem(*c, depth + 1)) {
+            item.children.push_back(std::move(*i));
+          }
+        }
+      }
+    }
+    return item;
+  }
+  if (type != "tab") {
+    return std::nullopt;
+  }
+  // For pinned tabs and favorites, `url` is the home URL.
+  GURL url(Str(node, "url"));
+  if (!url.is_valid()) {
+    return std::nullopt;
+  }
+  item.url = url;
+  item.title = !Str(node, "customTitle").empty() ? Str(node, "customTitle")
+               : !Str(node, "title").empty()     ? Str(node, "title")
+                                                 : url.spec();
+  return item;
+}
+
+std::vector<Item> ToItems(const base::ListValue* list) {
+  std::vector<Item> out;
+  if (list) {
+    for (const base::Value& v : *list) {
+      if (const base::DictValue* d = v.GetIfDict()) {
+        if (std::optional<Item> item = ToItem(*d)) {
+          out.push_back(std::move(*item));
+        }
+      }
+    }
+  }
+  return out;
+}
+
+}  // namespace
+
+ElectronState::ElectronState() = default;
+ElectronState::ElectronState(ElectronState&&) = default;
+ElectronState& ElectronState::operator=(ElectronState&&) = default;
+ElectronState::~ElectronState() = default;
+
+base::FilePath ElectronDataDir() {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (cl->HasSwitch(kElectronDirSwitch)) {
+    return cl->GetSwitchValuePath(kElectronDirSwitch);
+  }
+  base::FilePath home;
+  if (!base::PathService::Get(base::DIR_HOME, &home)) {
+    return base::FilePath();
+  }
+  return home.Append("Library/Application Support/Meridian");
+}
+
+std::optional<ElectronState> ParseElectronState(const base::DictValue& root) {
+  const base::ListValue* spaces = root.FindList("spaces");
+  if (!spaces) {
+    return std::nullopt;
+  }
+  ElectronState out;
+  const std::string& active_id = Str(root, "activeSpaceId");
+  std::vector<std::string> space_ids;
+  for (const base::Value& v : *spaces) {
+    const base::DictValue* s = v.GetIfDict();
+    if (!s) {
+      continue;
+    }
+    Space space;
+    space.name = Str(*s, "name").empty() ? "Space" : Str(*s, "name");
+    space.icon = Str(*s, "icon");
+    space.color = Str(*s, "color");
+    space.color2 = Str(*s, "color2").empty() ? space.color : Str(*s, "color2");
+    space.pinned = ToItems(s->FindList("pinned"));
+    std::vector<ArcSidebar::Tab> today;
+    if (const base::ListValue* tabs = s->FindList("today")) {
+      for (const base::Value& t : *tabs) {
+        const base::DictValue* tab = t.GetIfDict();
+        GURL url = tab ? GURL(Str(*tab, "url")) : GURL();
+        if (url.is_valid() && url.SchemeIsHTTPOrHTTPS()) {
+          today.push_back({url, Str(*tab, "title")});
+        }
+      }
+    }
+    if (Str(*s, "id") == active_id) {
+      out.active_space = out.sidebar.spaces.size();
+    }
+    space_ids.push_back(Str(*s, "id"));
+    out.sidebar.spaces.push_back(std::move(space));
+    out.sidebar.today.push_back(std::move(today));
+  }
+  if (out.sidebar.spaces.empty()) {
+    return std::nullopt;
+  }
+  out.space_ids = space_ids;
+  // Favorites of every profile, the default one first, without duplicates.
+  if (const base::DictValue* favorites = root.FindDict("favorites")) {
+    std::vector<const base::ListValue*> lists;
+    if (const base::ListValue* def = favorites->FindList("default")) {
+      lists.push_back(def);
+    }
+    for (const auto [id, list] : *favorites) {
+      if (id != "default" && list.is_list()) {
+        lists.push_back(&list.GetList());
+      }
+    }
+    for (const base::ListValue* list : lists) {
+      for (Item& item : ToItems(list)) {
+        bool known = item.is_folder ||
+                     std::ranges::any_of(out.sidebar.favorites,
+                                         [&](const Item& f) {
+                                           return f.url == item.url;
+                                         });
+        if (!known) {
+          out.sidebar.favorites.push_back(std::move(item));
+        }
+      }
+    }
+  }
+  if (const base::ListValue* archive = root.FindList("archive")) {
+    for (const base::Value& v : *archive) {
+      const base::DictValue* a = v.GetIfDict();
+      GURL url = a ? GURL(Str(*a, "url")) : GURL();
+      if (!url.is_valid() || out.archive.size() >= 5000) {
+        continue;
+      }
+      ElectronState::ArchivedTab tab;
+      tab.url = url;
+      tab.title = Str(*a, "title");
+      auto it = std::ranges::find(space_ids, Str(*a, "spaceId"));
+      tab.space = it == space_ids.end() ? -1 : it - space_ids.begin();
+      tab.closed_at = base::Time::FromMillisecondsSinceUnixEpoch(
+          a->FindDouble("closedAt").value_or(0));
+      out.archive.push_back(std::move(tab));
+    }
+  }
+  if (const base::DictValue* settings = root.FindDict("settings")) {
+    out.sidebar_right = settings->FindBool("sidebarRight");
+    out.adblock = settings->FindBool("adblock");
+    out.archive_after_hours = settings->FindInt("archiveAfterHours");
+    if (const std::string* mode = settings->FindString("mode")) {
+      out.mode = *mode;
+    }
+    if (const base::DictValue* atc = settings->FindDict("atc")) {
+      out.atc = atc->Clone();
+    }
+  }
+  return out;
+}
+
+std::optional<ElectronState> ReadElectronState() {
+  base::FilePath dir = ElectronDataDir();
+  std::string json;
+  if (dir.empty() ||
+      !base::ReadFileToString(dir.Append("state.json"), &json)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> root = base::JSONReader::Read(json, 0);
+  if (!root || !root->is_dict()) {
+    return std::nullopt;
+  }
+  return ParseElectronState(root->GetDict());
+}
+
+}  // namespace meridian
