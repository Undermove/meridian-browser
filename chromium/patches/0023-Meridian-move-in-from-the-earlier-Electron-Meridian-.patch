+void SidebarHandler::GetElectronPreview(GetElectronPreviewCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce([] {
+        return std::make_pair(ReadElectronState(),
+                              LoginsAvailable(LoginsSource::kElectron));
+      }),
+      base::BindOnce(
+          [](GetElectronPreviewCallback callback,
+             std::pair<std::optional<ElectronState>, bool> read) {
+            std::move(callback).Run(
+                read.first ? PreviewOf(read.first->sidebar, read.second)
+                           : nullptr);
+          },
