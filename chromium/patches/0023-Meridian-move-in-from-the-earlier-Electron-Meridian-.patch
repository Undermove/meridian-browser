+void SidebarHandler::ImportElectron(ImportElectronCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadElectronState),
+      base::BindOnce(&SidebarHandler::OnElectronRead,
+                     weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void SidebarHandler::OnElectronRead(ImportElectronCallback callback,
+                                    std::optional<ElectronState> state) {
+  if (!state) {
+    std::move(callback).Run(false);
+    return;
+  }
+  ArcSidebar& sidebar = state->sidebar;
+  service_->Import(sidebar.spaces, std::move(sidebar.favorites));
+  AddLazyTabs(sidebar);
+  base::Time now = base::Time::Now();
+  for (const ElectronState::ArchivedTab& tab : state->archive) {
+    archive_->Add(tab.url, tab.title,
+                  tab.space >= 0 ? sidebar.spaces[tab.space].id
+                                 : service_->active_space_id(),
+                  tab.closed_at.is_null() ? now : tab.closed_at);
+  }
+  // Settings worth keeping; link rules point at the new space ids.
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  if (state->sidebar_right) {
+    prefs->SetBoolean(prefs::kSidebarRight, *state->sidebar_right);
+  }
+  if (state->archive_after_hours) {
+    int hours = *state->archive_after_hours;
+    if (hours == 0 || hours == 12 || hours == 24 || hours == 168 ||
+        hours == 720) {
+      prefs->SetInteger(prefs::kArchiveAfterHours, hours);
+    }
+  }
+  if (state->mode && (*state->mode == "everyday" ||
+                      *state->mode == "creative" ||
+                      *state->mode == "developer")) {
+    prefs->SetString(prefs::kMode, *state->mode);
+  }
+  if (state->adblock) {
+    HostContentSettingsMapFactory::GetForProfile(browser_->GetProfile())
+        ->SetDefaultContentSetting(ContentSettingsType::ADS,
+                                   *state->adblock ? CONTENT_SETTING_BLOCK
+                                                   : CONTENT_SETTING_ALLOW);
+  }
+  if (state->atc) {
+    if (base::ListValue* rules = state->atc->FindList("rules")) {
+      for (base::Value& rule : *rules) {
+        std::string* target =
+            rule.is_dict() ? rule.GetDict().FindString("target") : nullptr;
+        if (!target || !target->starts_with("space:")) {
+          continue;
+        }
+        auto it = std::ranges::find(state->space_ids, target->substr(6));
+        *target = it == state->space_ids.end()
+                      ? std::string("main")
+                      : "space:" + sidebar.spaces[it - state->space_ids.begin()].id;
       }
     }
+    if (std::optional<base::DictValue> atc = SanitizeAtc(*state->atc)) {
+      prefs->SetDict(prefs::kAtc, std::move(*atc));
+    }
+  }
+  if (state->active_space < static_cast<int>(sidebar.spaces.size())) {
+    service_->SetActiveSpace(sidebar.spaces[state->active_space].id);
   }
   ActivateSpace(service_->active_space_id());
   ScheduleNotify();
   std::move(callback).Run(true);
 }
 
+void SidebarHandler::ImportElectronLogins(
+    ImportElectronLoginsCallback callback) {
+  meridian::ImportLogins(
+      browser_->GetProfile(), LoginsSource::kElectron,
+      base::BindOnce(
+          [](ImportElectronLoginsCallback callback, ArcLoginsResult result) {
+            std::move(callback).Run(result.imported, result.error);
+          },
+          std::move(callback)));
+}
