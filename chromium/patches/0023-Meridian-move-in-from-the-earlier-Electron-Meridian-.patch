+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/electron_import.h"
+
+#include "base/json/json_reader.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+constexpr char kState[] = R"({
+  "activeSpaceId": "s2",
+  "spaces": [
+    {"id": "s1", "name": "Personal", "icon": "H", "color": "#8a8fe0",
+     "pinned": [
+       {"type": "tab", "url": "https://mail.example.com/", "title": "Inbox",
+        "customTitle": "Mail"},
+       {"type": "folder", "title": "Reading", "collapsed": true, "children": [
+         {"type": "tab", "url": "https://news.example.com/", "title": "News"}]},
+       {"type": "tab", "url": "not a url"}
+     ],
+     "today": [{"url": "https://a.example/", "title": "A"},
+               {"url": "chrome://settings", "title": "skip"}]},
+    {"id": "s2", "name": "Work", "color": "#4facfe", "color2": "#00f2fe"}
+  ],
+  "favorites": {
+    "work": [{"type": "tab", "url": "https://github.com/", "title": "GitHub"}],
+    "default": [{"type": "tab", "url": "https://cal.example/", "title": "Cal"},
+                {"type": "tab", "url": "https://github.com/", "title": "Dup"}]
+  },
+  "archive": [{"url": "https://old.example/", "title": "Old",
+               "closedAt": 1760000000000, "spaceId": "s1"}],
+  "settings": {"sidebarRight": true, "adblock": false,
+               "archiveAfterHours": 24, "mode": "developer",
+               "atc": {"fallback": "main", "rules": []}}
+})";
+
+TEST(ElectronImportTest, ReadsSpacesFavoritesArchiveAndSettings) {
+  std::optional<base::Value> root = base::JSONReader::Read(kState, 0);
+  std::optional<ElectronState> state = ParseElectronState(root->GetDict());
+  ASSERT_TRUE(state);
+  const ArcSidebar& s = state->sidebar;
+  ASSERT_EQ(s.spaces.size(), 2u);
+  EXPECT_EQ(state->active_space, 1);
+  EXPECT_EQ(state->space_ids, (std::vector<std::string>{"s1", "s2"}));
+  EXPECT_EQ(s.spaces[0].icon, "H");
+  EXPECT_EQ(s.spaces[0].color2, "#8a8fe0");
+  EXPECT_EQ(s.spaces[1].color2, "#00f2fe");
+  ASSERT_EQ(s.spaces[0].pinned.size(), 2u);
+  EXPECT_EQ(s.spaces[0].pinned[0].title, "Mail");
+  EXPECT_TRUE(s.spaces[0].pinned[1].is_folder);
+  EXPECT_FALSE(s.spaces[0].pinned[1].open);
+  EXPECT_EQ(s.spaces[0].pinned[1].children[0].title, "News");
+  ASSERT_EQ(s.today[0].size(), 1u);
+  EXPECT_EQ(s.today[0][0].title, "A");
+  // Default profile's favorites first, then the others, no duplicates.
+  ASSERT_EQ(s.favorites.size(), 2u);
+  EXPECT_EQ(s.favorites[0].title, "Cal");
+  EXPECT_EQ(s.favorites[1].title, "Dup");
+  ASSERT_EQ(state->archive.size(), 1u);
+  EXPECT_EQ(state->archive[0].space, 0);
+  EXPECT_EQ(state->archive[0].closed_at.InMillisecondsSinceUnixEpoch(),
+            1760000000000);
+  EXPECT_EQ(state->sidebar_right, true);
