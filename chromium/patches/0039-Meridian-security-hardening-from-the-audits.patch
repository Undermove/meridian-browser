+// A placeholder made without following anything already there: fails if
+// any entry (a symlink included) appeared under that name.
+bool MakePlaceholder(const base::FilePath& abs, bool dir) {
+  if (dir) {
+    return mkdir(abs.value().c_str(), 0755) == 0;
+  }
+  base::ScopedFD fd(HANDLE_EINTR(
+      open(abs.value().c_str(),
+           O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0644)));
+  return fd.is_valid() &&
+         base::WriteFileDescriptor(fd.get(),
+                                   Placeholder(abs.BaseName().value()));
+}
