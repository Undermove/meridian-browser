+constexpr char kNoTab[] =
+    "no such tab (agents can't use Meridian's own pages, browser settings or "
+    "local files)";
+
+// Agents work on web pages only: never on Meridian's or Chromium's own pages
+// (chrome://workbench has terminals, chrome://settings permissions…), local
+// files or extensions. The empty new tab is fine (to navigate it).
+bool AgentCanUse(content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  for (const GURL& url :
+       {contents->GetLastCommittedURL(), contents->GetVisibleURL()}) {
+    if (url.is_empty() || url.SchemeIsHTTPOrHTTPS() ||
+        url.SchemeIs(url::kDataScheme) || url.IsAboutBlank()) {
+      continue;
+    }
+    if (url.SchemeIs("chrome") && url.host() == "newtab") {
+      continue;
+    }
+    return false;
+  }
+  return true;
+}
+
