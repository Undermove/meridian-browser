+  // A path with a quote and a parenthesis can't break out of the profile.
+  base::FilePath secrets = dir.GetPath().Append("Sec\"ret (s)");
+  base::FilePath work = secrets.Append("Agent Chat");
+  ASSERT_TRUE(base::CreateDirectory(work));
+  ASSERT_TRUE(base::WriteFile(secrets.Append("key"), "hunter2"));
+  ASSERT_TRUE(base::WriteFile(work.Append("settings.json"), "{}"));
+
+  ProcessSpec spec;
+  spec.argv = SandboxedArgv(
+      {"/bin/sh", "-c",
+       "cat \"$1/key\" || echo no-read; echo x > \"$1/new\" || echo no-write; "
+       "cat \"$1/Agent Chat/settings.json\"; echo ok > \"$1/Agent Chat/out\"",
+       "sh", secrets.value()},
+      {secrets}, {work});
+  ASSERT_EQ(spec.argv[0], "/usr/bin/sandbox-exec");
+  std::string out;
+  ProcessResult result = Run(spec, &out);
+  EXPECT_TRUE(result.started);
+  EXPECT_EQ(out, "no-read\nno-write\n{}");
+  EXPECT_FALSE(base::PathExists(secrets.Append("new")));
+  EXPECT_TRUE(base::PathExists(work.Append("out")));
+
+  // The sensitive list is under the home folder.
+  for (const base::FilePath& path : SensitivePaths(base::FilePath("/Users/me"))) {
+    EXPECT_TRUE(base::FilePath("/Users/me").IsParent(path)) << path;
+  }
