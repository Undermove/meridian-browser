+
+std::vector<std::string> SandboxedArgv(
+    const std::vector<std::string>& argv,
+    const std::vector<base::FilePath>& denied,
+    const std::vector<base::FilePath>& allowed) {
+  // Metadata stays readable (so resolving a path through a denied folder to
+  // an allowed one works); contents, listings and writes don't. Later rules
+  // win, so `allowed` carves holes in `denied`.
+  std::vector<std::string> params;
+  auto rule = [&](const char* action, const char* prefix,
+                  const std::vector<base::FilePath>& paths) {
+    if (paths.empty()) {
+      return std::string();
+    }
+    std::string text = base::StrCat({"(", action, " file-read-data file-write*"});
+    for (size_t i = 0; i < paths.size(); ++i) {
+      std::string name = prefix + base::NumberToString(i);
+      params.push_back("-D");
+      params.push_back(name + "=" + Resolved(paths[i]).value());
+      base::StrAppend(&text, {" (subpath (param \"", name, "\"))"});
+    }
+    return text + ")";
+  };
+  std::string profile = "(version 1)(allow default)";
+  profile += rule("deny", "DENY", denied);
+  profile += rule("allow", "ALLOW", allowed);
+  std::vector<std::string> out = {"/usr/bin/sandbox-exec", "-p", profile};
+  out.insert(out.end(), params.begin(), params.end());
+  out.push_back("--");
+  out.insert(out.end(), argv.begin(), argv.end());
+  return out;
+}
