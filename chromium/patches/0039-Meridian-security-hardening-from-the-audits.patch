+// After the person approved `real`: a copy in a private folder of the
+// profile's parent (cleared at start), so the page gets exactly what was
+// approved even if the file changes before the form is sent. Blocking.
+base::FilePath SnapshotUpload(const base::FilePath& real,
+                              const base::FilePath& user_data) {
+  base::FilePath root = user_data.Append("Meridian Agent Uploads");
+  base::FilePath dir;
+  if (!base::CreateDirectory(root) ||
+      !base::SetPosixFilePermissions(root, 0700) ||
+      !base::CreateTemporaryDirInDir(root, "upload-", &dir)) {
+    return base::FilePath();
+  }
+  base::FilePath copy = dir.Append(real.BaseName());
+  return base::CopyFile(real, copy) ? copy : base::FilePath();
+}
