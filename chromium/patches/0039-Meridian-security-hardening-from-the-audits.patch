+namespace meridian {
+
+namespace {
+
+// realpath() directly: this runs once, early, on whichever thread asks
+// first, and must see through symlinks (a link in /tmp to the real profile).
+base::FilePath Real(const base::FilePath& path) {
+  char buffer[PATH_MAX];
+  return realpath(path.value().c_str(), buffer) ? base::FilePath(buffer)
+                                                : base::FilePath();
+}
+
+bool InTempFolder(const base::FilePath& path) {
+  base::FilePath real = Real(path);
+  if (real.empty()) {
+    return false;
+  }
+  base::FilePath temp;
+  if (base::GetTempDir(&temp)) {
+    base::FilePath real_temp = Real(temp);
+    if (!real_temp.empty() && real_temp.IsParent(real)) {
+      return true;
+    }
+  }
+  // The per-user temp folders and /tmp.
+  return base::FilePath("/private/var/folders").IsParent(real) ||
+         base::FilePath("/private/tmp").IsParent(real);
+}
+
+}  // namespace
+
+bool TestSwitchesAllowed() {
+  // Decided once (it looks at the disk), for the whole run.
+  static const bool allowed = [] {
+    const base::CommandLine& cl = *base::CommandLine::ForCurrentProcess();
+    return cl.HasSwitch("user-data-dir") &&
+           InTempFolder(cl.GetSwitchValuePath("user-data-dir"));
+  }();
+  return allowed;
+}
+
+bool HasTestSwitch(std::string_view name) {
+  return TestSwitchesAllowed() &&
+         base::CommandLine::ForCurrentProcess()->HasSwitch(name);
+}
+
+std::string TestSwitchValue(std::string_view name) {
+  return HasTestSwitch(name)
+             ? base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(name)
+             : std::string();
+}
+
+base::FilePath TestSwitchPath(std::string_view name) {
+  return HasTestSwitch(name)
+             ? base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(name)
+             : base::FilePath();
+}
+
+}  // namespace meridian
