+bool InsideRoot(const base::FilePath& root, const base::FilePath& abs) {
+  return abs == root || root.IsParent(abs);
+}
+
+// Opens `path` by its real path (which must be inside `root`) without
+// following a symlink at the last component, then checks the handle is still
+// what that real path names: a parent swapped for a symlink in between fails
+// here instead of being used. `real` gets the real path.
+base::expected<base::ScopedFD, std::string> OpenPinned(
+    const base::FilePath& root,
+    const base::FilePath& path,
+    int flags,
+    base::FilePath* real = nullptr) {
+  std::optional<base::FilePath> pinned = RealPath(path);
+  if (!pinned) {
+    return base::unexpected("ENOENT: no such file or folder");
+  }
+  if (!InsideRoot(root, *pinned)) {
+    return base::unexpected("path leads outside the project (symlink)");
+  }
+  base::ScopedFD fd(HANDLE_EINTR(
+      open(pinned->value().c_str(), flags | O_NOFOLLOW | O_CLOEXEC)));
+  if (!fd.is_valid()) {
+    if (errno == ELOOP) {
+      return base::unexpected("path leads outside the project (symlink)");
+    }
+    return base::unexpected("couldn’t open it");
+  }
+  struct stat opened;
+  struct stat named;
+  std::optional<base::FilePath> now = RealPath(*pinned);
+  if (fstat(fd.get(), &opened) != 0 || !now || *now != *pinned ||
+      stat(now->value().c_str(), &named) != 0 ||
+      named.st_ino != opened.st_ino || named.st_dev != opened.st_dev) {
+    return base::unexpected(
+        "it moved while opening (symlink race) — nothing was done");
+  }
+  if (real) {
+    *real = *pinned;
+  }
+  return base::ok(std::move(fd));
+}
+
+// Reads `fd` to the end; false past `max` bytes.
+bool ReadAll(int fd, int64_t max, std::string* out) {
+  std::array<char, 65536> chunk;
+  for (;;) {
+    ssize_t n = HANDLE_EINTR(read(fd, chunk.data(), chunk.size()));
+    if (n < 0) {
+      return false;
+    }
+    if (n == 0) {
+      return true;
+    }
+    out->append(base::as_string_view(
+        base::span(chunk).first(static_cast<size_t>(n))));
+    if (static_cast<int64_t>(out->size()) > max) {
+      return false;
+    }
+  }
+}
+
 }  // namespace
 
