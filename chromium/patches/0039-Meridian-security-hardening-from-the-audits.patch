+bool IsPublicAddress(const net::IPAddress& address) {
+  net::IPAddress ip = address;
+  if (ip.IsIPv4MappedIPv6()) {
+    ip = net::ConvertIPv4MappedIPv6ToIPv4(ip);
+  }
+  if (ip.IsIPv6()) {
+    const net::IPAddressBytes& b = ip.bytes();
+    const bool nat64 = b[0] == 0 && b[1] == 0x64 && b[2] == 0xff &&
+                       b[3] == 0x9b;
+    if (nat64 && b[4] == 0 && b[5] == 1) {
+      // 64:ff9b:1::/48, NAT64 for local networks.
+      return false;
+    }
+    bool zeros = true;
+    for (size_t i = 4; i < 12; ++i) {
+      zeros = zeros && b[i] == 0;
+    }
+    if (nat64 && zeros) {
+      // 64:ff9b::a.b.c.d reaches a.b.c.d.
+      ip = net::IPAddress(b[12], b[13], b[14], b[15]);
+    } else if (b[0] == 0x20 && b[1] == 0x02) {
+      // 6to4: 2002:AABB:CCDD::/48 reaches AA.BB.CC.DD.
+      ip = net::IPAddress(b[2], b[3], b[4], b[5]);
+    }
+  }
+  return ip.IsValid() && ip.IsPubliclyRoutable() && !ip.IsMulticast();
+}
+
 }  // namespace meridian::ai
