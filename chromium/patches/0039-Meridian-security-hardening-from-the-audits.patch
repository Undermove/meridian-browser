+// ReleasePlaceholders with PlaceholderLock() held.
+void ReleaseLocked(const std::vector<base::FilePath>& placeholders) {
+  PlaceholderLock().AssertAcquired();
+  for (const base::FilePath& abs : placeholders) {
+    auto it = PlaceholderRefs().find(abs);
+    if (it != PlaceholderRefs().end() && --it->second > 0) {
+      continue;
+    }
+    PlaceholderRefs().erase(abs);
+    struct stat st;
+    if (lstat(abs.value().c_str(), &st) != 0) {
+      continue;
+    }
+    if (S_ISDIR(st.st_mode)) {
+      rmdir(abs.value().c_str());  // stays if anything was put inside
+    } else if (S_ISREG(st.st_mode)) {
+      std::string content;
+      if (base::ReadFileToString(abs, &content) &&
+          content == Placeholder(abs.BaseName().value())) {
+        base::DeleteFile(abs);
+      }
+    }
+  }
+}
