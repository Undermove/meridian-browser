+void SidebarHandler::TestFloatingWindowShot(
+    TestFloatingWindowShotCallback callback) {
+  views::Widget* widget = nullptr;
+  if (HasTestSwitch("meridian-test-keys")) {
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* b) {
+          if (b->GetType() == BrowserWindowInterface::Type::TYPE_FLOATING &&
+              b->GetWindow()) {
+            widget = views::Widget::GetWidgetForNativeWindow(
+                b->GetWindow()->GetNativeWindow());
+          }
+          return !widget;
+        });
+  }
+  if (!widget || !widget->GetLayer()) {
+    std::move(callback).Run(std::string());
+    return;
+  }
+  // The compositor's own picture of the window: no screen capture involved.
+  widget->GetLayer()->RequestCopyOfOutput(std::make_unique<
+                                          viz::CopyOutputRequest>(
+      viz::CopyOutputRequest::ResultFormat::RGBA,
+      viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+      base::BindOnce(
+          [](TestFloatingWindowShotCallback callback,
+             std::unique_ptr<viz::CopyOutputResult> result) {
+            if (result->IsEmpty()) {
+              std::move(callback).Run(std::string());
+              return;
+            }
+            auto access = result->ScopedAccessSkBitmap();
+            std::optional<std::vector<uint8_t>> png =
+                gfx::PNGCodec::EncodeBGRASkBitmap(access.GetOutScopedBitmap(),
+                                                  /*discard_transparency=*/true);
+            std::move(callback).Run(png ? base::Base64Encode(*png)
+                                        : std::string());
+          },
+          std::move(callback))));
+  // A frame to copy, though nothing in the window changed.
+  if (ui::Compositor* compositor = widget->GetCompositor()) {
+    compositor->ScheduleFullRedraw();
+  }
+}
+
 }  // namespace meridian
