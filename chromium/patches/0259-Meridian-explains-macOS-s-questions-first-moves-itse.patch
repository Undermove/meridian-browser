+// macOS's question about Meridian: explained in the frontmost Meridian
+// window (whichever profile), at once when there is none.
+void ExplainSystemAskIn(const std::string& kind, base::OnceClosure done) {
+  SidebarHandler* best = nullptr;
+  for (auto& [browser, handler] : Handlers()) {
+    if (!handler->page_connected()) {
+      continue;
+    }
+    if (!best || browser->IsActive()) {
+      best = handler;
+    }
+  }
+  if (!best) {
+    std::move(done).Run();
+    return;
+  }
+  best->ExplainSystemAsk(kind, std::move(done));
+}
+
 }  // namespace
 
+void SidebarHandler::ExplainSystemAsk(const std::string& kind,
+                                      base::OnceClosure done) {
+  // Once per kind: macOS asks only once too.
+  PrefService* prefs = MainProfileFor(browser_->GetProfile())->GetPrefs();
+  const base::ListValue& explained =
+      prefs->GetList(prefs::kExplainedSystemAsks);
+  if (std::ranges::find(explained, base::Value(kind)) != explained.end()) {
+    std::move(done).Run();
+    return;
+  }
+  base::ListValue updated = explained.Clone();
+  updated.Append(kind);
+  prefs->SetList(prefs::kExplainedSystemAsks, std::move(updated));
+  page_->ExplainSystemAsk(
+      kind, mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(done)));
+}
+
+void SidebarHandler::OpenSystemSettingsFor(const std::string& kind) {
+#if BUILDFLAG(IS_MAC)
+  // Tests: said, never opened.
+  if (FakeSystemAsks()) {
+    base::FilePath log = TestSwitchPath("meridian-test-system-asks");
+    if (!log.empty()) {
+      base::ThreadPool::PostTask(
+          FROM_HERE, {base::MayBlock()},
+          base::BindOnce(
+              [](base::FilePath log, std::string line) {
+                if (!base::PathExists(log)) {
+                  base::WriteFile(log, "");
+                }
+                base::AppendToFile(log, line);
+              },
+              log, "settings " + kind + "\n"));
+    }
+    return;
+  }
+  using Pane = base::mac::SystemSettingsPane;
+  if (kind == "notifications") {
+    base::mac::OpenSystemSettingsPane(Pane::kNotifications,
+                                      base::apple::MainBundleIdentifier());
+    return;
+  }
+  static constexpr struct {
+    const char* kind;
+    Pane pane;
+  } kPanes[] = {
+      {"camera", Pane::kPrivacySecurity_Camera},
+      {"microphone", Pane::kPrivacySecurity_Microphone},
+      {"screen", Pane::kPrivacySecurity_ScreenRecording},
+      {"location", Pane::kPrivacySecurity_LocationServices},
+  };
+  for (const auto& p : kPanes) {
+    if (kind == p.kind) {
+      base::mac::OpenSystemSettingsPane(p.pane);
+      return;
+    }
+  }
+#endif
+}
