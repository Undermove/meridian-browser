--- /dev/null
+++ b/chrome/browser/meridian/self_install.cc
@@ -0,0 +1,79 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/self_install.h"
+
+#include "base/version.h"
+
+namespace meridian {
+
+namespace {
+
+bool Within(const base::FilePath& parent, const base::FilePath& path) {
+  return !parent.empty() && (parent == path || parent.IsParent(path));
+}
+
+}  // namespace
+
+SelfInstallOffer DecideSelfInstall(const SelfInstallFacts& f) {
+  if (f.app.empty() || f.applications.empty()) {
+    return SelfInstallOffer::kNone;
+  }
+  // Already installed (or the person keeps it in their own Applications).
+  if (Within(f.applications, f.app) || Within(f.user_applications, f.app)) {
+    return SelfInstallOffer::kNone;
+  }
+  // From a disk image, or a copy that came from the internet (Downloads, or
+  // unzipped elsewhere); never a build someone made on this Mac.
+  if (!f.on_disk_image && !f.forced && !f.quarantined &&
+      !Within(f.downloads, f.app)) {
+    return SelfInstallOffer::kNone;
+  }
+  if (!f.target_exists) {
+    return SelfInstallOffer::kInstall;
+  }
+  // Something else of the same name, or a Meridian that's open right now:
+  // left alone.
+  if (f.bundle_id.empty() || f.target_bundle_id != f.bundle_id ||
+      f.target_running) {
+    return SelfInstallOffer::kNone;
+  }
+  // Never an older Meridian over a newer one (its profile may be newer too).
+  base::Version mine(f.version);
+  base::Version theirs(f.target_version);
+  if (mine.IsValid() && theirs.IsValid() && theirs > mine) {
+    return SelfInstallOffer::kNone;
+  }
+  return SelfInstallOffer::kReplace;
+}
+
+SelfInstallTexts SelfInstallQuestion(SelfInstallOffer offer,
+                                     bool on_disk_image,
+                                     bool from_downloads) {
+  if (offer == SelfInstallOffer::kReplace) {
+    return {"Replace the Meridian in Applications?",
+            "There’s already a Meridian in your Applications folder. It goes "
+            "to the Trash and this one takes its place. Your tabs, spaces and "
+            "sign-ins stay as they are.",
+            "Replace", "Not Now"};
+  }
+  if (on_disk_image) {
+    return {"Install Meridian?",
+            "Meridian is running from the disk image. It copies itself to "
+            "your Applications folder, opens from there and keeps itself up "
+            "to date.",
+            "Install", "Not Now"};
+  }
+  return {"Move Meridian to Applications?",
+          from_downloads
+              ? "Meridian is running from your Downloads folder. It moves "
+                "itself to your Applications folder, opens from there and "
+                "keeps itself up to date."
+              : "Meridian is running from a folder outside Applications. It "
+                "moves itself to your Applications folder, opens from there "
+                "and keeps itself up to date.",
+          "Move to Applications", "Not Now"};
+}
+
+}  // namespace meridian
diff --git a/chrome/browser/meridian/self_install.h b/chrome/browser/meridian/self_install.h
new file mode 100644
index 0000000000..f410e52d18
--- /dev/null
+++ b/chrome/browser/meridian/self_install.h
@@ -0,0 +1,71 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_SELF_INSTALL_H_
+#define CHROME_BROWSER_MERIDIAN_SELF_INSTALL_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+
+namespace meridian {
+
+// "The person clicks and it installs": Meridian started from somewhere other
+// than Applications (a disk image, the Downloads folder, a folder it was
+// unzipped in) offers to move itself there (chrome/browser/mac/
+// install_from_dmg.mm). The decision alone, no system calls, so it can be
+// tested.
+struct SelfInstallFacts {
+  // Where this Meridian.app is (the original place when macOS runs it from a
+  // translocated copy).
+  base::FilePath app;
+  // It runs from a mounted disk image.
+  bool on_disk_image = false;
+  // macOS marked it as downloaded (com.apple.quarantine).
+  bool quarantined = false;
+  // ~/Downloads.
+  base::FilePath downloads;
+  // The Applications folders: where it's installed (/Applications, or the
+  // test folder) and the person's own ~/Applications.
+  base::FilePath applications;
+  base::FilePath user_applications;
+  // What is already at applications/<app name>, if anything: its bundle id and
+  // version ("" when nothing is there).
+  bool target_exists = false;
+  std::string target_bundle_id;
+  std::string target_version;
+  bool target_running = false;
+  // This Meridian's.
+  std::string bundle_id;
+  std::string version;
+  // Tests: offer even when the app isn't quarantined or in Downloads.
+  bool forced = false;
+};
+
+enum class SelfInstallOffer {
+  // Stay where it is.
+  kNone,
+  // Copy into Applications (from a disk image: Chromium's own question).
+  kInstall,
+  // Applications has an older (or the same) Meridian: it goes to the Trash
+  // and this one takes its place. The profile is never touched.
+  kReplace,
+};
+
+SelfInstallOffer DecideSelfInstall(const SelfInstallFacts& facts);
+
+// The question, for people. `from_downloads`: it's in the Downloads folder.
+struct SelfInstallTexts {
+  std::string title;
+  std::string body;
+  std::string yes;
+  std::string no;
+};
+SelfInstallTexts SelfInstallQuestion(SelfInstallOffer offer,
+                                     bool on_disk_image,
+                                     bool from_downloads);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_SELF_INSTALL_H_
