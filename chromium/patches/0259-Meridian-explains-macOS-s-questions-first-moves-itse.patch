+int CountSavedPasswords(const ImportSource& source) {
+  // Usernames per site, so the same password in "Login Data" and "Login Data
+  // For Account" counts once. Nothing is decrypted.
+  std::set<std::pair<std::string, std::string>> seen;
+  for (const ArcProfile& p : FindArcProfiles(source)) {
+    for (const base::FilePath& file : p.logins) {
+      base::ScopedTempDir tmp;
+      sql::Database db(sql::Database::Tag("Passwords"));
+      if (!internal::OpenCopy(file, tmp, db) ||
+          !db.DoesTableExist("logins")) {
+        continue;
+      }
+      sql::Statement s(db.GetUniqueStatement(
+          "SELECT signon_realm, username_value FROM logins "
+          "WHERE blacklisted_by_user = 0"));
+      while (s.Step()) {
+        seen.emplace(p.dir + " " + s.ColumnString(0), s.ColumnString(1));
+      }
+    }
+  }
+  return static_cast<int>(seen.size());
+}
