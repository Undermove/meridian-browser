+import {getCss} from './mac_ask.css.js';
+import {macAskGlyph} from './mac_ask_glyphs.js';
+import {getHtml} from './mac_ask.html.js';
+
+export interface MacAskLook {
+  // 'alert': macOS's centered question; 'banner': a notification's;
+  // 'keychain': the keychain's, with a password field.
+  style: 'alert'|'banner'|'keychain';
+  icon: 'camera'|'mic'|'location'|'bell'|'screen'|'key';
+  title: string;
+  text: string;
+  // Left to right; `press` is the one to press.
+  buttons: string[];
+  press: string;
+}
+
+// What macOS shows for each kind. `app`: the browser whose keychain item it
+// is ("Chrome", "Arc").
+export function macAskLook(kind: string, app = 'Chrome'): MacAskLook {
+  const why =
+      'Once Meridian has access, websites will be able to ask you for access.';
+  switch (kind) {
+    case 'camera':
+      return {
+        style: 'alert',
+        icon: 'camera',
+        title: '“Meridian” would like to access the camera.',
+        text: why,
+        buttons: ['Don’t Allow', 'Allow'],
+        press: 'Allow',
+      };
+    case 'microphone':
+      return {
+        style: 'alert',
+        icon: 'mic',
+        title: '“Meridian” would like to access the microphone.',
+        text: why,
+        buttons: ['Don’t Allow', 'Allow'],
+        press: 'Allow',
+      };
+    case 'location':
+      return {
+        style: 'alert',
+        icon: 'location',
+        title: '“Meridian” would like to use your current location.',
+        text: why,
+        buttons: ['Don’t Allow', 'Allow'],
+        press: 'Allow',
+      };
+    case 'notifications':
+      return {
+        style: 'banner',
+        icon: 'bell',
+        title: '“Meridian” Notifications',
+        text: 'Notifications may include alerts, sounds and icon badges.',
+        buttons: ['Don’t Allow', 'Allow'],
+        press: 'Allow',
+      };
+    case 'screen':
+      return {
+        style: 'alert',
+        icon: 'screen',
+        title: '“Meridian” will not be able to record the contents of your ' +
+            'screen until it is quit.',
+        text: '',
+        buttons: ['Later', 'Quit & Reopen'],
+        press: 'Quit & Reopen',
+      };
+    case 'keychain':
+    default:
+      return {
+        style: 'keychain',
+        icon: 'key',
+        title: `Meridian wants to use your confidential information stored ` +
+            `in “${app} Safe Storage” in your keychain.`,
+        text: 'To allow this, enter the “login” keychain password.',
+        buttons: ['Always Allow', 'Deny', 'Allow'],
+        press: 'Allow',
+      };
+  }
+}
+
+export class MeridianMacAskElement extends CrLitElement {
+  static get is() {
+    return 'meridian-mac-ask';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      kind: {type: String},
+      app: {type: String},
+      look_: {state: true, type: Object},
+    };
+  }
+
+  accessor kind: string = 'camera';
+  accessor app: string = 'Chrome';
+  protected accessor look_: MacAskLook = macAskLook('camera');
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    this.look_ = macAskLook(this.kind, this.app);
+  }
+
+  protected glyph_(): TemplateResult {
+    return macAskGlyph(this.look_.icon);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-mac-ask': MeridianMacAskElement;
+  }
+}
+
+customElements.define(MeridianMacAskElement.is, MeridianMacAskElement);
