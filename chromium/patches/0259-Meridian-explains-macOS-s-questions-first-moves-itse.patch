new file mode 100644
index 0000000000..678758a46a
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/system_ask.ts
@@ -0,0 +1,204 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Before macOS asks about Meridian for the first time (the camera, the
+// microphone, recording the screen, notifications, the location), one short
+// sheet: what will appear, why, which button to press, with a drawing of it,
+// and where to change it if the wrong button got pressed. Once per kind
+// (sidebar_handler.cc remembers); macOS asks only after "Continue".
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+
+import './mac_ask.js';
+
+import {getCss} from './system_ask.css.js';
+import {getHtml} from './system_ask.html.js';
+
+export interface SystemAskText {
+  title: string;
+  // Paragraphs; the last one names the button.
+  lines: string[];
+  // Numbered steps, when there's more than one button to press.
+  steps: string[];
+  // "Pressed the wrong button?" and the button to the right pane.
+  wrong: string;
+  settings: string;
+  // The main button: macOS asks right after it ("Continue"), or later
+  // ("Got it").
+  ok: string;
+}
+
+const PRIVACY = 'System Settings › Privacy & Security';
+
+export function systemAskText(kind: string): SystemAskText {
+  const device = (what: string, pane: string): SystemAskText => ({
+    title: `Your Mac will ask about the ${what}`,
+    lines: [
+      `This site can use your ${what} now. The first time, macOS also asks ` +
+          `whether Meridian may use it.`,
+      'Press Allow (on older Macs it says OK):',
+    ],
+    steps: [],
+    wrong: `Pressed Don’t Allow? Turn on Meridian in ${PRIVACY} › ${pane}.`,
+    settings: `Open ${pane} settings`,
+    ok: 'Continue',
+  });
+  switch (kind) {
+    case 'camera':
+      return device('camera', 'Camera');
+    case 'microphone':
+      return device('microphone', 'Microphone');
+    case 'location':
+      return {
+        ...device('location', 'Location Services'),
+        lines: [
+          'This site can see where you are now. The first time, macOS also ' +
+              'asks whether Meridian may use your location.',
+          'Press Allow (on older Macs it says OK):',
+        ],
+      };
+    case 'notifications':
+      return {
+        title: 'Your Mac will ask about notifications',
+        lines: [
+          'This site can send you notifications now. When the first one ' +
+              'comes, macOS asks whether Meridian may show them.',
+          'Press Allow:',
+        ],
+        steps: [],
+        wrong: 'Pressed Don’t Allow? Turn on Allow notifications for ' +
+            'Meridian in System Settings › Notifications.',
+        settings: 'Open Notifications settings',
+        ok: 'Got it',
+      };
+    case 'screen':
+    default:
+      return {
+        title: 'Sharing your screen takes one switch on your Mac',
+        lines: [
+          'Sharing a tab works right away. To share your whole screen or ' +
+              'another app’s window, macOS has to let Meridian record the ' +
+              'screen.',
+        ],
+        steps: [
+          'In the sharing window, pick Entire Screen or Window, then Open ' +
+              'System Settings.',
+          'Turn on Meridian in Screen & System Audio Recording.',
+          'macOS offers to quit and reopen Meridian: press Quit & Reopen. ' +
+              'Your tabs come back.',
+        ],
+        wrong: 'Pressed Later? The switch works the next time Meridian ' +
+            'opens. Or turn it on in ' + PRIVACY + ' › Screen & System Audio ' +
+            'Recording.',
+        settings: 'Open Screen Recording settings',
+        ok: 'Continue',
+      };
+  }
+}
+
+export class MeridianSystemAskElement extends CrLitElement {
+  static get is() {
+    return 'meridian-system-ask';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      kind_: {state: true, type: String},
+      text_: {state: true, type: Object},
+    };
+  }
+
+  accessor open: boolean = false;
+  protected accessor kind_: string = '';
+  protected accessor text_: SystemAskText = systemAskText('');
+
+  // Explanations waiting their turn (two kinds at once: camera and
+  // microphone), each with what runs once it's read.
+  private queue_: Array<{kind: string, done: () => void}> = [];
+  private listener_: number|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    const router = browserProxyFactory.getInstance().callbackRouter;
+    this.listener_ = router.explainSystemAsk.addListener(
+        (kind: string) =>
+            new Promise<void>(resolve => this.show(kind, resolve)));
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    if (this.listener_ !== null) {
+      browserProxyFactory.getInstance().callbackRouter.removeListener(
+          this.listener_);
+      this.listener_ = null;
+    }
+  }
+
+  // Also for tests and screenshots: the sheet for `kind`.
+  show(kind: string, done: () => void = () => {}) {
+    this.queue_.push({kind, done});
+    if (!this.open) {
+      this.next_();
+    }
+  }
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    this.text_ = systemAskText(this.kind_);
+  }
+
+  private next_() {
+    const first = this.queue_[0];
+    if (!first) {
+      this.open = false;
+      return;
+    }
+    this.kind_ = first.kind;
+    this.open = true;
+    this.updateComplete.then(
+        () => this.shadowRoot.querySelector<HTMLElement>('#ok')?.focus());
+  }
+
+  private close_() {
+    const first = this.queue_.shift();
+    first?.done();
+    this.next_();
+  }
+
+  protected onOkClick_() {
+    this.close_();
+  }
+
+  protected onSettingsClick_() {
+    browserProxyFactory.getInstance().handler.openSystemSettingsFor(
+        this.kind_);
+  }
+
+  protected onKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.close_();
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-system-ask': MeridianSystemAskElement;
+  }
+}
+
+customElements.define(MeridianSystemAskElement.is, MeridianSystemAskElement);
