+// Where a translocated app really is (macOS runs a downloaded app from a
+// read-only copy until it's moved); `path` itself otherwise. Security's SPI,
+// looked up at run time.
+NSString* OriginalPathOf(NSString* path) {
+  using IsTranslocatedFn = Boolean (*)(CFURLRef, bool*, CFErrorRef*);
+  using OriginalFn = CFURLRef (*)(CFURLRef, CFErrorRef*);
+  static auto is_translocated = reinterpret_cast<IsTranslocatedFn>(
+      dlsym(RTLD_DEFAULT, "SecTranslocateIsTranslocatedURL"));
+  static auto original = reinterpret_cast<OriginalFn>(
+      dlsym(RTLD_DEFAULT, "SecTranslocateCreateOriginalPathForURL"));
+  if (!is_translocated || !original) {
+    return path;
+  }
+  NSURL* url = [NSURL fileURLWithPath:path];
+  bool translocated = false;
+  if (!is_translocated(base::apple::NSToCFPtrCast(url), &translocated,
+                       nullptr) ||
+      !translocated) {
+    return path;
+  }
+  base::apple::ScopedCFTypeRef<CFURLRef> real(
+      original(base::apple::NSToCFPtrCast(url), nullptr));
+  return real ? base::apple::CFToNSPtrCast(real.get()).path : path;
+}
+
+// macOS marked it as downloaded from the internet.
+bool IsQuarantined(NSString* path) {
+  return getxattr(path.fileSystemRepresentation, "com.apple.quarantine",
+                  nullptr, 0, 0, 0) >= 0;
+}
+
+// A Meridian started from `path` is open right now.
+bool IsAppRunningAt(NSString* path, NSDictionary* info) {
+  NSString* bundle_id = base::apple::ObjCCast<NSString>(info[@"CFBundleIdentifier"]);
+  if (!bundle_id) {
+    return false;
+  }
+  NSString* wanted = path.stringByStandardizingPath;
+  for (NSRunningApplication* app in [NSRunningApplication
+           runningApplicationsWithBundleIdentifier:bundle_id]) {
+    if ([app.bundleURL.path.stringByStandardizingPath isEqualToString:wanted]) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Puts `path` in the Trash; its place there, or nil. Tests: a "Trash" folder
+// next to their Applications folder.
+NSURL* MoveToTrash(NSString* path) {
+  NSFileManager* file_manager = NSFileManager.defaultManager;
+  NSError* error = nil;
+  if (meridian::HasTestSwitch("meridian-test-applications-dir")) {
+    base::FilePath trash =
+        meridian::TestSwitchPath("meridian-test-applications-dir")
+            .DirName()
+            .AppendASCII("Trash");
+    base::CreateDirectory(trash);
+    NSString* to = [base::apple::FilePathToNSString(trash)
+        stringByAppendingPathComponent:path.lastPathComponent];
+    for (int n = 2; [file_manager fileExistsAtPath:to]; ++n) {
+      to = [base::apple::FilePathToNSString(trash)
+          stringByAppendingPathComponent:
+              [NSString stringWithFormat:@"%@ %d.app",
+                                         path.lastPathComponent
+                                             .stringByDeletingPathExtension,
+                                         n]];
+    }
+    if (![file_manager moveItemAtPath:path toPath:to error:&error]) {
+      return nil;
+    }
+    TestLog(base::StrCat({"trashed ", base::SysNSStringToUTF8(path)}));
+    return [NSURL fileURLWithPath:to];
+  }
+  NSURL* resulting = nil;
+  if (![file_manager trashItemAtURL:[NSURL fileURLWithPath:path]
+                   resultingItemURL:&resulting
+                              error:&error]) {
+    LOG(ERROR) << base::SysNSStringToUTF8(error.localizedDescription);
+    return nil;
+  }
+  return resulting;
+}
