+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/self_install.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+SelfInstallFacts FromDownloads() {
+  SelfInstallFacts f;
+  f.app = base::FilePath("/Users/ada/Downloads/Meridian.app");
+  f.downloads = base::FilePath("/Users/ada/Downloads");
+  f.applications = base::FilePath("/Applications");
+  f.user_applications = base::FilePath("/Users/ada/Applications");
+  f.bundle_id = "dev.meridian.browser";
+  f.version = "158.0.8127.42";
+  return f;
+}
+
+TEST(SelfInstallTest, FromDownloadsOffersToMove) {
+  EXPECT_EQ(DecideSelfInstall(FromDownloads()), SelfInstallOffer::kInstall);
+}
+
+TEST(SelfInstallTest, UnzippedElsewhereOnlyWhenDownloaded) {
+  SelfInstallFacts f = FromDownloads();
+  f.app = base::FilePath("/Users/ada/Desktop/Meridian.app");
+  // A build made on this Mac (no quarantine): stays where it is.
+  EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kNone);
+  f.quarantined = true;
+  EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kInstall);
+}
+
+TEST(SelfInstallTest, DiskImage) {
+  SelfInstallFacts f = FromDownloads();
+  f.app = base::FilePath("/Volumes/Meridian/Meridian.app");
+  f.on_disk_image = true;
+  EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kInstall);
+}
+
+TEST(SelfInstallTest, AlreadyInApplications) {
+  SelfInstallFacts f = FromDownloads();
+  f.quarantined = true;
+  f.app = base::FilePath("/Applications/Meridian.app");
+  EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kNone);
+  f.app = base::FilePath("/Users/ada/Applications/Meridian.app");
+  EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kNone);
+}
+
+TEST(SelfInstallTest, ReplacesAnOlderMeridian) {
+  SelfInstallFacts f = FromDownloads();
+  f.target_exists = true;
+  f.target_bundle_id = "dev.meridian.browser";
+  f.target_version = "157.0.1.1";
+  EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kReplace);
+  f.target_version = f.version;
+  EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kReplace);
+}
+
+TEST(SelfInstallTest, LeavesOtherAppsAndNewerOrOpenMeridianAlone) {
+  SelfInstallFacts f = FromDownloads();
+  f.target_exists = true;
+  f.target_bundle_id = "com.example.other";
+  EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kNone);
+  f.target_bundle_id = "dev.meridian.browser";
+  f.target_version = "159.0.0.0";
+  EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kNone);
+  f.target_version = "157.0.0.0";
+  f.target_running = true;
+  EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kNone);
+}
+
+TEST(SelfInstallTest, Texts) {
+  EXPECT_EQ(SelfInstallQuestion(SelfInstallOffer::kInstall, false, true).yes,
+            "Move to Applications");
+  EXPECT_EQ(SelfInstallQuestion(SelfInstallOffer::kReplace, false, true).yes,
+            "Replace");
+  EXPECT_EQ(SelfInstallQuestion(SelfInstallOffer::kInstall, true, false).title,
+            "Install Meridian?");
+}
+
+}  // namespace
+}  // namespace meridian
