diff --git a/chrome/browser/meridian/system_asks.cc b/chrome/browser/meridian/system_asks.cc
new file mode 100644
index 0000000000..0704abea2a
--- /dev/null
+++ b/chrome/browser/meridian/system_asks.cc
@@ -0,0 +1,53 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/system_asks.h"
+
+#include <set>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/meridian/test_switches.h"
+
+namespace meridian {
+
+namespace {
+
+SystemAskExplainer& Explainer() {
+  static base::NoDestructor<SystemAskExplainer> explainer;
+  return *explainer;
+}
+
+std::set<std::string>& FakeDone() {
+  static base::NoDestructor<std::set<std::string>> done;
+  return *done;
+}
+
+}  // namespace
+
+void SetSystemAskExplainer(SystemAskExplainer explainer) {
+  Explainer() = std::move(explainer);
+}
+
+void ExplainSystemAsk(const std::string& kind, base::OnceClosure then) {
+  if (!Explainer()) {
+    std::move(then).Run();
+    return;
+  }
+  Explainer().Run(kind, std::move(then));
+}
+
+bool FakeSystemAsks() {
+  return HasTestSwitch("meridian-test-system-asks");
+}
+
+bool FakeSystemAskDone(const std::string& kind) {
+  return FakeDone().contains(kind);
+}
+
+void SetFakeSystemAskDone(const std::string& kind) {
+  FakeDone().insert(kind);
+}
+
+}  // namespace meridian
diff --git a/chrome/browser/meridian/system_asks.h b/chrome/browser/meridian/system_asks.h
new file mode 100644
index 0000000000..54dffa9750
--- /dev/null
+++ b/chrome/browser/meridian/system_asks.h
@@ -0,0 +1,44 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_SYSTEM_ASKS_H_
+#define CHROME_BROWSER_MERIDIAN_SYSTEM_ASKS_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+
+namespace meridian {
+
+// Before macOS asks the person something about Meridian for the first time
+// (the camera, the microphone, recording the screen, notifications, the
+// location), Meridian shows its own short sheet first: what will appear, why,
+// and which button to press, so nobody is scared of the system's window.
+//
+// No browser deps: Chromium's own code calls ExplainSystemAsk() right before
+// it makes macOS ask, and the sidebar (sidebar_handler.cc) sets the explainer
+// that shows the sheet in the frontmost window, once per kind.
+
+// Kinds: "camera", "microphone", "screen", "notifications", "location".
+using SystemAskExplainer =
+    base::RepeatingCallback<void(const std::string& kind,
+                                 base::OnceClosure done)>;
+
+void SetSystemAskExplainer(SystemAskExplainer explainer);
+
+// Explains `kind` (once ever, the explainer remembers), then runs `then`.
+// Runs `then` at once when nothing can explain it (no window yet).
+void ExplainSystemAsk(const std::string& kind, base::OnceClosure then);
+
+// Tests (--meridian-test-system-asks, test profiles only): macOS is never
+// asked. Every kind starts "not decided yet", and a request is answered
+// "allowed" at once, as if the person had clicked Allow.
+bool FakeSystemAsks();
+// Whether `kind` was asked in this run (fake asks only).
+bool FakeSystemAskDone(const std::string& kind);
+void SetFakeSystemAskDone(const std::string& kind);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_SYSTEM_ASKS_H_
