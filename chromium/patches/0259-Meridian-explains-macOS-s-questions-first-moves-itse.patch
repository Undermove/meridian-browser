+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianSystemAskElement} from './system_ask.js';
+
+export function getHtml(this: MeridianSystemAskElement) {
+  return html`<!--_html_template_start_-->
+<div id="overlay" @keydown="${this.onKeydown_}">
+  <div id="card" role="dialog" aria-labelledby="title" tabindex="-1"
+      data-kind="${this.kind_}">
+    <div id="title">${this.text_.title}</div>
+    ${this.text_.lines.map(l => html`<p>${l}</p>`)}
+    ${this.text_.steps.length ? html`
+      <ol>${this.text_.steps.map(s => html`<li>${s}</li>`)}</ol>` : ''}
+    <div class="drawing">
+      <meridian-mac-ask .kind="${this.kind_}"></meridian-mac-ask>
+    </div>
+    <p class="wrong">${this.text_.wrong}
+      <button id="settings" class="link" @click="${this.onSettingsClick_}">
+        ${this.text_.settings}</button>
+    </p>
+    <footer>
+      <button id="ok" class="btn primary" @click="${this.onOkClick_}">
+        ${this.text_.ok}</button>
+    </footer>
+  </div>
+</div>
+<!--_html_template_end_-->`;
+}
