+void WorkbenchHandler::AttachSink(const std::string& id) {
+  auto it = terms_.find(id);
+  if (it == terms_.end() || !it->second.sink) {
+    return;
+  }
+  it->second.sink->Attach(
+      base::BindRepeating(&WorkbenchHandler::OnTerminalData,
+                          weak_factory_.GetWeakPtr(), id),
+      base::BindOnce(&WorkbenchHandler::OnTerminalExit,
+                     weak_factory_.GetWeakPtr(), id));
+}
+
+void WorkbenchHandler::TakeParked() {
+  if (!project_) {
+    return;
+  }
+  std::vector<std::unique_ptr<ParkedTerminal>> parked =
+      WorkbenchServiceFactory::GetForProfile(profile_)->TakeParkedTerminals(
+          project_->root().AsUTF8Unsafe());
+  if (parked.empty()) {
+    return;
+  }
+  mission::MissionControl* mission =
+      mission::MissionControlFactory::GetForProfile(profile_);
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(web_ui()->GetWebContents());
+  for (std::unique_ptr<ParkedTerminal>& p : parked) {
+    Term term = std::move(static_cast<Parked*>(p.get())->term);
+    p.reset();  // (its host key moved on with the term: nothing to drop)
+    std::string id = "t" + base::NumberToString(++term_seq_);
+    term.scrollback += term.sink->TakeKept();
+    term.scrollback +=
+        "\r\n\x1b[2m[This session kept running while the Workbench was "
+        "closed]\x1b[0m\r\n";
+    if (term.scrollback.size() > kScrollbackBytes) {
+      size_t cut = term.scrollback.size() - kScrollbackBytes;
+      while (cut < term.scrollback.size() &&
+             (term.scrollback[cut] & 0xc0) == 0x80) {
+        ++cut;
+      }
+      term.scrollback.erase(0, cut);
+    }
+    if (!term.guard_token.empty()) {
+      auto token = std::make_shared<std::string>(term.guard_token);
+      WorkbenchServiceFactory::GetForProfile(profile_)->RebindGuard(
+          term.guard_token,
+          base::BindRepeating(&WorkbenchHandler::GuardDecision,
+                              weak_factory_.GetWeakPtr(), token, term.root,
+                              std::make_shared<std::set<std::string>>()));
+    }
+    if (mission && !term.mission_node.empty()) {
+      mission->MoveTerminal(term.mission_node,
+                            tab ? tab->GetHandle().raw_value() : 0, id);
+    }
+    Terminal* terminal = term.terminal.get();
+    terms_[id] = std::move(term);
+    AttachSink(id);
+    // A full-screen program (Claude Code) draws itself again.
+    if (terminal && terms_.contains(id) && terms_[id].terminal) {
+      terminal->Redraw();
+    }
+  }
+}
