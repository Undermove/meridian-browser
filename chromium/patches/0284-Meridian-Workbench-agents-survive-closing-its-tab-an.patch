+void TermSink::Data(std::string data) {
+  if (on_data_) {
+    on_data_.Run(std::move(data));
+    return;
+  }
+  // The last 256 KiB, cut at a character's start.
+  constexpr size_t kKeep = 256 * 1024;
+  kept_ += data;
+  if (kept_.size() > kKeep) {
+    size_t cut = kept_.size() - kKeep;
+    while (cut < kept_.size() && (kept_[cut] & 0xc0) == 0x80) {
+      ++cut;
+    }
+    kept_.erase(0, cut);
+  }
+}
+
+void TermSink::Exit(int code, int signal) {
+  if (on_exit_) {
+    std::move(on_exit_).Run(code, signal);
+    return;
+  }
+  exited_ = true;
+  code_ = code;
+  signal_ = signal;
+}
+
+void TermSink::Attach(DataCallback on_data, ExitCallback on_exit) {
+  on_data_ = std::move(on_data);
+  on_exit_ = std::move(on_exit);
+  if (exited_ && on_exit_) {
+    exited_ = false;
+    std::move(on_exit_).Run(code_, signal_);
+  }
+}
+
+void TermSink::Detach() {
+  on_data_.Reset();
+  on_exit_.Reset();
+}
+
+std::string TermSink::TakeKept() {
+  return std::exchange(kept_, std::string());
+}
