-  // A boost on or off from the list; the page changes at once.
-  // The badge's colour, as Arc's: the boost's dark colour (the second one,
-  // which paints the page's dark parts), deep and quiet (Arc's: hsl(24 36%
-  // 29%) for a brown); the space's colour with no colour set.
+  // The badge's colours: the boost's dark colour (the second one, which
+  // paints the page's dark parts), deep and quiet (Arc's measured badge:
+  // hsl(24 36% 29%) for a brown), and the glints' warm light at their peak,
+  // the boost's main colour made pale; the space's colour with no colour set.
   protected boostInk_(b: Boost): string {
     if (b.tint < 0) {
       return '';
     }
     const hue = b.tint2 >= 0 ? b.tint2 : hueAt(angleOf(b.tint) + 180);
-    return `--boost-ink:hsl(${hue} 36% 29%)`;
+    return `--boost-ink:hsl(${hue} 36% 29%);` +
+        `--boost-glow:hsl(${b.tint} 90% 82%)`;
   }
 
+  // A boost on or off from the list; the page changes at once.
   protected async onBoostToggleClick_(e: Event) {
     const id = (e.currentTarget as HTMLElement).dataset['id'];
     const boost = this.boosts_.find(b => b.id === id);
