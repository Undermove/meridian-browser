From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Tue, 24 Nov 2026 19:33:38 +0400
Subject: [PATCH 248/297] Meridian: Ask AI About This Page in the page's
 context menu
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A person looked for asking AI about the page in the page's right-click menu
and found nothing. The item (IDC_MERIDIAN_ASK_PAGE) opens the same Ask panel
as ⌘J in a normal window; it only opens it, ⌘J still opens and closes. It
stays out of Chromium's context menu histograms.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/app/chrome_command_ids.h               |  2 ++
 chrome/app/meridian_strings.grdp              |  3 ++
 chrome/browser/meridian/sidebar_handler.cc    |  5 ++++
 .../render_view_context_menu.cc               | 30 +++++++++++++++++++
 .../render_view_context_menu.h                |  2 ++
 chrome/browser/resources/webui_browser/app.ts |  5 +++-
 .../webui_browser/meridian/sidebar.ts         |  3 +-
 .../browser/ui/browser_command_controller.cc  |  4 +--
 8 files changed, 50 insertions(+), 4 deletions(-)

diff --git a/chrome/app/chrome_command_ids.h b/chrome/app/chrome_command_ids.h
index ae2391d5b9..af9ad121d9 100644
--- a/chrome/app/chrome_command_ids.h
+++ b/chrome/app/chrome_command_ids.h
@@ -133,6 +133,8 @@
 #define IDC_MERIDIAN_MISSION          39725
 #define IDC_MERIDIAN_COPY_MARKDOWN    39726
 #define IDC_MERIDIAN_LITTLE_WINDOW    39727
+// The page's context menu: opens Ask (⌘J toggles it).
+#define IDC_MERIDIAN_ASK_PAGE         39728
 // Spaces 1-9: IDC_MERIDIAN_SPACE_1 + n.
 #define IDC_MERIDIAN_SPACE_1          39710
 #define IDC_MERIDIAN_SPACE_9          39718
diff --git a/chrome/app/meridian_strings.grdp b/chrome/app/meridian_strings.grdp
index fd308ac195..0407233f3a 100644
--- a/chrome/app/meridian_strings.grdp
+++ b/chrome/app/meridian_strings.grdp
@@ -34,6 +34,9 @@
   <message name="IDS_MERIDIAN_ASK_MAC" desc="View menu item: open the Ask panel (the built-in AI) beside the page.">
     Ask Meridian
   </message>
+  <message name="IDS_MERIDIAN_ASK_PAGE" desc="Item of a web page's right-click menu: open the Ask panel (the built-in AI) to ask about the page.">
+    Ask AI About This Page
+  </message>
   <message name="IDS_MERIDIAN_WORKBENCH_MAC" desc="View menu item: open the Workbench, a small code editor with terminals and coding agents, in a tab.">
     Workbench
   </message>
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index bfec765409..4cd169079a 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -842,6 +842,11 @@ bool SidebarHandler::HandleCommand(BrowserWindowInterface* browser,
       case IDC_MERIDIAN_ASK:
         command = mojom::Command::kAsk;
         break;
+      // The page's context menu: opens Ask, never closes it.
+      case IDC_MERIDIAN_ASK_PAGE:
+        command = mojom::Command::kAsk;
+        arg = 1;
+        break;
       case IDC_MERIDIAN_CHAT:
         command = mojom::Command::kChat;
         break;
diff --git a/chrome/browser/renderer_context_menu/render_view_context_menu.cc b/chrome/browser/renderer_context_menu/render_view_context_menu.cc
index 381d236026..9501047c80 100644
--- a/chrome/browser/renderer_context_menu/render_view_context_menu.cc
+++ b/chrome/browser/renderer_context_menu/render_view_context_menu.cc
@@ -1721,6 +1721,10 @@ std::u16string RenderViewContextMenu::GetImageSearchProviderName(
 }
 
 void RenderViewContextMenu::RecordUsedItem(int id) {
+  // Meridian's own item has no place in Chromium's histograms.
+  if (id == IDC_MERIDIAN_ASK_PAGE) {
+    return;
+  }
   // Log general ID.
 
   int enum_id =
@@ -1836,6 +1840,9 @@ void RenderViewContextMenu::RecordUsedItem(int id) {
 }
 
 void RenderViewContextMenu::RecordShownItem(int id, bool is_submenu) {
+  if (id == IDC_MERIDIAN_ASK_PAGE) {
+    return;
+  }
   // The "RenderViewContextMenu.Shown" histogram is not recorded for submenus.
   if (is_submenu) {
     return;
@@ -2677,6 +2684,8 @@ void RenderViewContextMenu::AppendPageItems() {
     menu_model_.AddItemWithStringId(IDC_RELOAD, IDS_CONTENT_CONTEXT_RELOAD);
     menu_model_.AddSeparator(ui::NORMAL_SEPARATOR);
 
+    AppendMeridianAskItem();
+
     // Save as & Print
     menu_model_.AddItemWithStringId(IDC_SAVE_PAGE,
                                     IDS_CONTENT_CONTEXT_SAVEPAGEAS);
@@ -2746,6 +2755,7 @@ void RenderViewContextMenu::AppendPageItems() {
   menu_model_.AddItemWithStringId(IDC_FORWARD, IDS_CONTENT_CONTEXT_FORWARD);
   menu_model_.AddItemWithStringId(IDC_RELOAD, IDS_CONTENT_CONTEXT_RELOAD);
   menu_model_.AddSeparator(ui::NORMAL_SEPARATOR);
+  AppendMeridianAskItem();
   if (!glic_below_search) {
     MaybeAppendOpenGlicItem();
   }
@@ -3526,6 +3536,17 @@ void RenderViewContextMenu::AppendLiveCaptionItem() {
   }
 }
 
+// Meridian: a person looks for "ask AI about this page" in the page's own
+// menu. It opens the Ask panel, as ⌘J does, in a window that has one.
+void RenderViewContextMenu::AppendMeridianAskItem() {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser || !tabs::TabInterface::MaybeGetFromContents(embedder_web_contents_) ||
+      !chrome::IsCommandEnabled(browser, IDC_MERIDIAN_ASK_PAGE)) {
+    return;
+  }
+  menu_model_.AddItemWithStringId(IDC_MERIDIAN_ASK_PAGE, IDS_MERIDIAN_ASK_PAGE);
+}
+
 // Menu delegate functions -----------------------------------------------------
 
 bool RenderViewContextMenu::IsCommandIdEnabled(int id) const {
@@ -3640,6 +3661,9 @@ bool RenderViewContextMenu::IsCommandIdEnabled(int id) const {
     case IDC_LIVE_CAPTION:
       return true;
 
+    case IDC_MERIDIAN_ASK_PAGE:
+      return GetBrowser() != nullptr;
+
     case IDC_VIEW_SOURCE:
     case IDC_CONTENT_CONTEXT_VIEWFRAMESOURCE:
       return IsViewSourceEnabled();
@@ -4303,6 +4327,12 @@ void RenderViewContextMenu::ExecuteCommand(int id, int event_flags) {
       ExecLiveCaption();
       break;
 
+    case IDC_MERIDIAN_ASK_PAGE:
+      if (BrowserWindowInterface* browser = GetBrowser()) {
+        chrome::ExecuteCommand(browser, IDC_MERIDIAN_ASK_PAGE);
+      }
+      break;
+
     case IDC_CONTENT_CONTEXT_RELOAD_PACKAGED_APP:
       ExecReloadPackagedApp();
       break;
diff --git a/chrome/browser/renderer_context_menu/render_view_context_menu.h b/chrome/browser/renderer_context_menu/render_view_context_menu.h
index c306d7d723..084723e5a7 100644
--- a/chrome/browser/renderer_context_menu/render_view_context_menu.h
+++ b/chrome/browser/renderer_context_menu/render_view_context_menu.h
@@ -391,6 +391,8 @@ class RenderViewContextMenu
   void AppendSharingItems();
   void AppendRegionSearchItem();
   void AppendLiveCaptionItem();
+  // Meridian: Ask about the page, as ⌘J.
+  void AppendMeridianAskItem();
   void AppendSendTabToSelfItem(bool add_separator);
   bool AppendQRCodeGeneratorItem(bool for_image,
                                  bool draw_icon,
diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index 6d94bb66bd..067c7459b9 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -973,8 +973,11 @@ export class WebuiBrowserAppElement extends CrLitElement {
     this.$.settings.show(this.$.tabstrip.spaces(), e.detail || 'member');
   }
 
-  protected onMeridianAsk_() {
+  protected onMeridianAsk_(e: CustomEvent<string|undefined>) {
     this.closeSiteControl_();
+    if (e.detail === 'open' && this.$.ask.open) {
+      return;
+    }
     this.$.ask.toggle();
   }
 
diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
index 42bf0715c4..870732a540 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
@@ -1025,7 +1025,8 @@ export class MeridianSidebarElement extends CrLitElement implements
         this.fire('meridian-show-settings');
         break;
       case Command.kAsk:
-        this.fire('meridian-ask');
+        // 1: from the page's context menu, which only opens it.
+        this.fire('meridian-ask', arg === 1 ? 'open' : 'toggle');
         break;
       case Command.kChat:
         this.fire('meridian-chat');
diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index 064c40228a..fcaa584a4b 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -651,13 +651,13 @@ void BrowserCommandController::ShowCustomizeChromeSidePanel(
 
 namespace {
 
-// Meridian's own commands (chrome_command_ids.h, 39700-39727). They have no
+// Meridian's own commands (chrome_command_ids.h, 39700-39728). They have no
 // ActionItem, and with UseActionsForBrowserCommands (on by default) the
 // command updater treats such a command as unsupported and disabled, which
 // left every Meridian menu item and shortcut dead. They are on in every
 // normal window and go straight to the sidebar.
 bool IsMeridianCommand(int id) {
-  return id >= IDC_MERIDIAN_TOGGLE_SIDEBAR && id <= IDC_MERIDIAN_LITTLE_WINDOW;
+  return id >= IDC_MERIDIAN_TOGGLE_SIDEBAR && id <= IDC_MERIDIAN_ASK_PAGE;
 }
 
 }  // namespace
