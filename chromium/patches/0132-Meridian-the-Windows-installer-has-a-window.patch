+// found in the LICENSE file.
+
+#ifndef CHROME_INSTALLER_MINI_INSTALLER_MERIDIAN_PROGRESS_H_
+#define CHROME_INSTALLER_MINI_INSTALLER_MERIDIAN_PROGRESS_H_
+
+#include <windows.h>
+
+// The installer's only window. Chromium's installer shows nothing at all
+// (Google's own is run by another program that has the window): a person who
+// opens Meridian's sees no sign that it started, for the minute it takes, or
+// that it failed.
+//
+// A small window with Meridian's icon, "Installing Meridian…" and a moving
+// bar, on a thread of its own while the installer works; when the installer
+// fails, a message that says so and where the log is.
+//
+// Like the rest of mini_installer: no C runtime, plain Win32.
+namespace mini_installer {
+
+// Shows the window. Nothing with --meridian-no-ui on the command line.
+void ShowMeridianProgress(HMODULE module);
+
+// With --meridian-ui-demo on the command line: shows the window for a few
+// seconds and installs nothing (for looking at it, and for tests). True if
+// that was asked for.
+bool ShowMeridianProgressDemo(HMODULE module);
+
+// Takes the window away. `exit_code` is the installer's: not zero is a
+// failure, which a person who ran the installer themselves is told about
+// (the in-app updater, which passes --do-not-launch-chrome, tries again by
+// itself and isn't interrupted by a message).
+void EndMeridianProgress(DWORD exit_code);
+
+}  // namespace mini_installer
+
+#endif  // CHROME_INSTALLER_MINI_INSTALLER_MERIDIAN_PROGRESS_H_
