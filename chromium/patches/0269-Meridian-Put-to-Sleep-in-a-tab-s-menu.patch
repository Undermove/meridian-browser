+void SidebarHandler::PutTabToSleep(const tabs_api::NodeId& tab_id,
+                                   PutTabToSleepCallback callback) {
+  tabs::TabInterface* tab = TabFor(tab_id);
+  if (!tab) {
+    std::move(callback).Run("failed");
+    return;
+  }
+  content::WebContents* contents = tab->GetContents();
+  auto* unit =
+      resource_coordinator::TabLifecycleUnitExternal::FromWebContents(contents);
+  if (!unit) {
+    std::move(callback).Run("failed");
+    return;
+  }
+  if (unit->GetTabState() ==
+          ::mojom::LifecycleUnitState::DISCARDED ||
+      contents->WasDiscarded()) {
+    std::move(callback).Run("asleep");
+    return;
+  }
+  if (tab == model()->GetActiveTab() || tab->GetSplit()) {
+    std::move(callback).Run("active");
+    return;
+  }
+  // The Workbench runs agent sessions.
+  const GURL& url = contents->GetLastCommittedURL();
+  if (url.SchemeIs(content::kChromeUIScheme) && url.host() == "workbench") {
+    std::move(callback).Run("workbench");
+    return;
+  }
+  // Meridian's own check, stricter than Chromium's: nothing typed is lost,
+  // nothing playing stops, no call or recording is cut.
+  scoped_refptr<MediaStreamCaptureIndicator> capture =
+      MediaCaptureDevicesDispatcher::GetInstance()
+          ->GetMediaStreamCaptureIndicator();
+  if (contents->IsBeingCaptured() ||
+      (capture && (capture->IsCapturingUserMedia(contents) ||
+                   capture->IsBeingMirrored(contents) ||
+                   capture->IsCapturingDisplay(contents)))) {
+    std::move(callback).Run("capture");
+    return;
+  }
+  if (contents->IsCurrentlyAudible() ||
+      contents->GetCurrentlyPlayingVideoCount() > 0 ||
+      contents->HasPictureInPictureVideo()) {
+    std::move(callback).Run("media");
+    return;
+  }
+  base::WeakPtr<performance_manager::PageNode> page =
+      performance_manager::PerformanceManager::
+          GetPrimaryPageNodeForWebContents(contents);
+  if (page && (page->HadFormInteraction() || page->HadUserEdits())) {
+    std::move(callback).Run("form");
+    return;
+  }
+  std::move(callback).Run(
+      unit->DiscardTab(::mojom::LifecycleUnitDiscardReason::EXTERNAL) ?
+          "" : "failed");
+}
