+  // "Put to Sleep": Chromium discards the tab (it reloads when opened),
+  // after Meridian's own check; a toast says why when it won't.
+  private sleepMenu_(tab: Tab): MenuEntry[] {
+    return [{
+      label: 'Put to Sleep',
+      icon: 'moon',
+      enabled: !tab.isActive,
+      action: () => this.putToSleep(tab.id),
+    }];
+  }
+
+  async putToSleep(id: NodeId): Promise<string> {
+    const toast = (title: string) =>
+        this.fire('meridian-mission-toast', {nodeId: '', title});
+    if (id === this.agentTab_) {
+      toast('Not put to sleep: an agent is working in this tab');
+      return 'agent';
+    }
+    const {reason} = await this.handler_.putTabToSleep(id);
+    const why: Record<string, string> = {
+      'active': 'Not put to sleep: it is the open tab',
+      'form': 'Not put to sleep: something typed on the page would be lost',
+      'media': 'Not put to sleep: it is playing sound or video',
+      'capture': 'Not put to sleep: it uses the camera, microphone or a screen share',
+      'workbench': 'Not put to sleep: the Workbench runs agent sessions',
+      'asleep': 'Already asleep',
+      'failed': 'Chromium could not put this tab to sleep',
+    };
+    toast(reason ? why[reason] || why['failed']! :
+                   'Put to sleep: it reloads when you open it');
+    return reason;
+  }
+
