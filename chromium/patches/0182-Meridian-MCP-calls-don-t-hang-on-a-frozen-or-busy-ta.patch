+AgentService::Awake::Awake() = default;
+AgentService::Awake::Awake(Awake&&) = default;
+AgentService::Awake& AgentService::Awake::operator=(Awake&&) = default;
+AgentService::Awake::~Awake() = default;
+
+void AgentService::KeepAwake(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  // A background tab Chromium froze (or would throttle): awake while the
+  // agent works in it, as if it were being captured.
+  contents->SetPageFrozen(false);
+  const int32_t id = tab->GetHandle().raw_value();
+  Awake& awake = awake_[id];
+  if (!awake.capture) {
+    awake.capture = contents->IncrementCapturerCount(
+        gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/true,
+        /*is_activity=*/false);
+  }
+  if (!awake.release) {
+    awake.release = std::make_unique<base::OneShotTimer>();
+  }
+  awake.release->Start(
+      FROM_HERE, base::Minutes(3),
+      base::BindOnce([](AgentService* self, int32_t id) { self->awake_.erase(id); },
+                     base::Unretained(this), id));
 }
 
