+
+// One tool call on a thread of its own: a call that waits (a page that is
+// slow to answer, the person deciding) doesn't hold up the others.
+class CallThread : public base::PlatformThread::Delegate {
+ public:
+  CallThread(base::FilePath user_data_dir,
+             std::string client,
+             base::Value id,
+             base::DictValue params)
+      : user_data_dir_(std::move(user_data_dir)),
+        client_(std::move(client)),
+        id_(std::move(id)),
+        params_(std::move(params)) {}
+
+  static void Start(base::FilePath user_data_dir,
+                    std::string client,
+                    base::Value id,
+                    base::DictValue params) {
+    auto* thread = new CallThread(std::move(user_data_dir), std::move(client),
+                                  id.Clone(), std::move(params));
+    if (!base::PlatformThread::CreateNonJoinable(0, thread)) {
+      // No thread to spare: answer here.
+      thread->ThreadMain();
+    }
+  }
+
+  void ThreadMain() override {
+    base::DictValue out;
+    out.Set("jsonrpc", "2.0");
+    out.Set("id", id_.Clone());
+    out.Set("result", CallTool(user_data_dir_, client_, params_));
+    Write(out);
+    delete this;
+  }
+
+ private:
+  const base::FilePath user_data_dir_;
+  const std::string client_;
+  const base::Value id_;
+  const base::DictValue params_;
+};
