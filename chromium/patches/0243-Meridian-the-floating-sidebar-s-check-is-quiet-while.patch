From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Tue, 24 Nov 2026 00:19:12 +0400
Subject: [PATCH 244/245] Meridian: the floating sidebar's check is quiet while
 a window closes

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/resources/webui_browser/meridian/sidebar.ts | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
index a2859e0789..42bf0715c4 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
@@ -1181,7 +1181,12 @@ export class MeridianSidebarElement extends CrLitElement implements
   }
 
   async pointerOverWindowControls(): Promise<boolean> {
-    return (await this.handler_.isPointerOverWindowControls()).over;
+    try {
+      return (await this.handler_.isPointerOverWindowControls()).over;
+    } catch {
+      // The window is closing.
+      return false;
+    }
   }
 
   setWindowControlsVisible(visible: boolean) {
