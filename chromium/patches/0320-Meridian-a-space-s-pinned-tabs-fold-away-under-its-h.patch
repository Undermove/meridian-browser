+.space-header:hover .space-chevron,
+.space-header:focus-visible .space-chevron,
+.space-header.collapsed .space-chevron {
+  opacity: 0.8;
+}
+
+.space-header.collapsed .space-chevron {
+  transform: rotate(-90deg);
