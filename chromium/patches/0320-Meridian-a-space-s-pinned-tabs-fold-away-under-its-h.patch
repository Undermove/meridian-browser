+  // Arc: the space's pinned section folds away under its header, per space,
+  // kept across restarts. Today stays as it is.
+  isPinnedCollapsed(spaceId: string): boolean {
+    return this.pinnedCollapsed_.has(spaceId);
+  }
+
+  setPinnedCollapsed(spaceId: string, collapsed: boolean) {
+    if (this.isPinnedCollapsed(spaceId) === collapsed) {
+      return;
+    }
+    const next = new Set(this.pinnedCollapsed_);
+    if (collapsed) {
+      next.add(spaceId);
+    } else {
+      next.delete(spaceId);
+    }
+    this.pinnedCollapsed_ = next;
+    try {
+      localStorage.setItem(PINNED_COLLAPSED_KEY, JSON.stringify([...next]));
+    } catch {
+      // Storage unavailable: it lasts until the window closes.
+    }
+    // The rows above Today come or go: the active one stays in sight.
+    this.shownActive_ = null;
+    this.keepActiveInSight_();
+  }
+
+  // Under a collapsed header Arc keeps the active pinned tab, alone, as one
+  // row (even from inside a folder): where it is and its parent folder.
+  protected collapsedActive_(space: Space): {item: Item, parentId: string}|
+      null {
+    const find = (items: Item[], parentId: string):
+        {item: Item, parentId: string}|null => {
+      for (const item of items) {
+        if (item.isFolder) {
+          const inner = find(item.children, item.id);
+          if (inner) {
+            return inner;
+          }
+        } else if (this.liveTab(item.id)?.isActive) {
+          return {item, parentId};
+        }
+      }
+      return null;
+    };
+    return find(space.pinned, '');
+  }
+
+  protected onSpaceHeaderClick_(e: MouseEvent) {
+    const space = this.activeSpace();
+    if (!space || e.button !== 0 || this.renaming_ === space.id ||
+        e.composedPath().some(n => n instanceof HTMLInputElement)) {
+      return;
+    }
+    this.setPinnedCollapsed(space.id, !this.isPinnedCollapsed(space.id));
+  }
+
+  protected onSpaceHeaderKeydown_(e: KeyboardEvent) {
+    const space = this.activeSpace();
+    if (!space || this.renaming_ === space.id ||
+        (e.key !== 'Enter' && e.key !== ' ')) {
+      return;
+    }
+    e.preventDefault();
+    this.setPinnedCollapsed(space.id, !this.isPinnedCollapsed(space.id));
+  }
+
   protected onSpaceRenameBlur_(e: Event) {
     const space = this.activeSpace();
     if (space) {
