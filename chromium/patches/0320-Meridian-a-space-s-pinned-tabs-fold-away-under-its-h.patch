+
+/* Arc: the chevron after the name folds the space's pinned section away;
+   it turns to point right while it is folded. */
+.space-chevron {
+  display: inline-flex;
+  flex: none;
+  margin-inline-start: -4px;
+  opacity: 0;
+  transition: opacity 120ms ease, transform 150ms ease;
