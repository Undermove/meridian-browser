+      arg.find_first_of(L" \t\n\v\"") == std::wstring::npos) {
     return arg;
   }
   std::wstring out(1, L'"');
@@ -76,8 +78,61 @@ std::wstring Quoted(const std::wstring& arg) {
   return out;
 }
 
+// A batch file (npm's claude.cmd): the command prompt runs it.
+bool IsBatch(const std::string& program) {
+  const std::wstring ext = base::ToLowerASCII(
+      base::FilePath::FromUTF8Unsafe(program).Extension());
+  return ext == L".cmd" || ext == L".bat";
+}
+
+// Every character the command prompt treats specially, behind a caret, so
+// it is read as itself (quotes too: then nothing is a quoted span).
+std::wstring CaretEscaped(const std::wstring& s) {
+  static constexpr std::wstring_view kSpecial = L"()[]%!^\"`<>&|;, *?";
+  std::wstring out;
+  for (wchar_t c : s) {
+    if (kSpecial.find(c) != std::wstring_view::npos) {
+      out.push_back(L'^');
+    }
+    out.push_back(c);
+  }
+  return out;
+}
+
 }  // namespace
 
+std::wstring WindowsCommandLine(const std::vector<std::string>& argv) {
+  std::wstring command;
+  if (argv.empty()) {
+    return command;
+  }
+  if (!IsBatch(argv[0])) {
+    for (const std::string& arg : argv) {
+      if (!command.empty()) {
+        command.push_back(L' ');
+      }
+      command += Quoted(base::UTF8ToWide(arg));
+    }
+    return command;
+  }
+  // As npm's own tools (cross-spawn) do it: cmd.exe reads the line once, and
+  // the wrapper's %* hands the arguments to a second reading, so each
+  // argument is quoted for the program, then escaped twice; the program's
+  // path once.
+  command = CaretEscaped(base::UTF8ToWide(argv[0]));
+  for (size_t i = 1; i < argv.size(); ++i) {
+    const std::wstring arg = base::UTF8ToWide(argv[i]);
+    // Always quoted: then nothing in it is a word break for the wrapper.
+    command += L" " + CaretEscaped(CaretEscaped(Quoted(arg, /*always=*/true)));
+  }
+  wchar_t system[MAX_PATH];
+  const UINT length = ::GetSystemDirectoryW(system, MAX_PATH);
+  std::wstring shell = length && length < MAX_PATH
+                           ? std::wstring(system, length) + L"\\cmd.exe"
+                           : std::wstring(L"cmd.exe");
+  return L"\"" + shell + L"\" /d /s /c \"" + command + L"\"";
+}
+
 ProcessResult RunProcess(
     const ProcessSpec& spec,
     scoped_refptr<CancelFlag> cancel,
