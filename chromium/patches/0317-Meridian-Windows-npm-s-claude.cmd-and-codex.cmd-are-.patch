@@ -83,6 +91,47 @@ TEST_F(ProcessRunnerTest, FeedsStdinAndReadsStdout) {
   EXPECT_EQ(out.size(), 300000u);
 }
 
+#if BUILDFLAG(IS_WIN)
+// npm's claude.cmd: found where there is no claude.exe, and run through the
+// command prompt with every argument arriving as it was: the wrapper's %*
+// line (what it hands its program) reads back to the same arguments.
+TEST_F(ProcessRunnerTest, NpmCmdWrapperFoundAndItsArgumentsArriveAsTheyWere) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::FilePath folder = dir.GetPath().AppendASCII("npm folder");
+  ASSERT_TRUE(base::CreateDirectory(folder));
+  ASSERT_TRUE(base::WriteFile(folder.AppendASCII("claude.cmd"),
+                              "@echo off\r\necho(%*\r\n"));
+  const std::string found = FindProgram("claude", folder.AsUTF8Unsafe());
+  EXPECT_EQ(found, folder.AppendASCII("claude.cmd").AsUTF8Unsafe());
+  const std::vector<std::string> args = {
+      "plain", "two words", "a&b|c<d>e", "100%", "^caret", "quote\"in",
+      "x!y",   "(paren)",   "semi;comma,", "%PATH%", "trailing\\"};
+  ProcessSpec spec;
+  spec.argv = {found};
+  spec.argv.insert(spec.argv.end(), args.begin(), args.end());
+  spec.env = {{"SystemRoot", base::Environment::Create()
+                                 ->GetVar("SystemRoot")
+                                 .value_or("C:\\Windows")}};
+  std::string out;
+  ProcessResult result = Run(spec, &out);
+  ASSERT_TRUE(result.started);
+  EXPECT_EQ(result.exit_code, 0);
+  base::TrimWhitespaceASCII(out, base::TRIM_ALL, &out);
+  int count = 0;
+  LPWSTR* parsed = ::CommandLineToArgvW(
+      base::UTF8ToWide("program " + out).c_str(), &count);
+  ASSERT_TRUE(parsed);
+  std::vector<std::string> back;
+  for (int i = 1; i < count; ++i) {
+    // SAFETY: CommandLineToArgvW returns `count` strings.
+    back.push_back(base::WideToUTF8(UNSAFE_BUFFERS(parsed[i])));
+  }
+  ::LocalFree(parsed);
+  EXPECT_EQ(back, args) << out;
+}
+#endif
