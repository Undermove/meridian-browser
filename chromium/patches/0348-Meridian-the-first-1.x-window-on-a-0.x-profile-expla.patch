diff --git a/chrome/browser/meridian/update_check.cc b/chrome/browser/meridian/update_check.cc
index ba514b7..6e2ceab 100644
--- a/chrome/browser/meridian/update_check.cc
+++ b/chrome/browser/meridian/update_check.cc
@@ -82,6 +82,22 @@ bool IsNewer(std::string_view latest, std::string_view current) {
   return false;
 }
 
+bool FirstStartAfterZeroX(std::string_view last,
+                          bool onboarded,
+                          std::string_view current) {
+  std::optional<std::vector<int>> now =
+      Parts(current.substr(0, current.find('-')));
+  if (!now || now->empty() || (*now)[0] < 1) {
+    return false;
+  }
+  if (last.empty()) {
+    return onboarded;
+  }
+  std::optional<std::vector<int>> before =
+      Parts(last.substr(0, last.find('-')));
+  return before && !before->empty() && (*before)[0] == 0;
+}
