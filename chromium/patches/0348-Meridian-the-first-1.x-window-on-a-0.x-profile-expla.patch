index 650cda9..4cd6919 100644
--- a/chrome/browser/meridian/update_check_unittest.cc
+++ b/chrome/browser/meridian/update_check_unittest.cc
@@ -26,6 +26,21 @@
 namespace meridian::update {
 namespace {
 
+TEST(UpdateCheckTest, FirstStartAfterZeroX) {
+  // From a 0.x profile to 1.x: macOS asks about the keychain item again.
+  EXPECT_TRUE(FirstStartAfterZeroX("0.6.30", true, "1.5.3"));
+  EXPECT_TRUE(FirstStartAfterZeroX("0.6.9", false, "1.0.0"));
+  // A profile from before the version was kept, but used (onboarded).
+  EXPECT_TRUE(FirstStartAfterZeroX("", true, "1.5.3"));
+  // A new install, the same signature, or a later start.
+  EXPECT_FALSE(FirstStartAfterZeroX("", false, "1.5.3"));
+  EXPECT_FALSE(FirstStartAfterZeroX("1.0.0", true, "1.5.3"));
+  EXPECT_FALSE(FirstStartAfterZeroX("1.5.3", true, "1.5.3"));
+  EXPECT_FALSE(FirstStartAfterZeroX("0.6.29", true, "0.6.30"));
+  EXPECT_TRUE(FirstStartAfterZeroX("0.6.30", true, "1.0.0-dev"));
+  EXPECT_FALSE(FirstStartAfterZeroX("garbage", true, "1.5.3"));
+}
