From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 9 Nov 2026 13:29:05 +0400
Subject: [PATCH 109/114] Meridian: full screen keeps the sidebar as the window
 had it, as in Arc
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Shown stays shown beside the page; hidden with ⌘S stays hidden and slides
over the page from the left edge. ⌘S in full screen is remembered as usual.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/resources/webui_browser/app.ts | 25 +++----------------
 1 file changed, 3 insertions(+), 22 deletions(-)

diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index 6a912a75c1..bb87b48fd9 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -529,10 +529,6 @@ export class WebuiBrowserAppElement extends CrLitElement {
     this.closeSiteControl_();
     this.sidebarHidden_ = !this.sidebarHidden_;
     this.sidebarPeek_ = false;
-    // In full screen it lasts until full screen ends.
-    if (this.sidebarHiddenOutsideFullscreen_ !== null) {
-      return;
-    }
     try {
       localStorage.setItem(SIDEBAR_HIDDEN_KEY, this.sidebarHidden_ ? '1' : '');
     } catch {
@@ -864,27 +860,12 @@ export class WebuiBrowserAppElement extends CrLitElement {
     this.showingSidePanel_ = false;
   }
 
-  // The ⌘S choice of the window, while full screen hides the sidebar.
-  private sidebarHiddenOutsideFullscreen_: boolean|null = null;
-
   protected onFullscreenModeChanged_(
       isFullscreen: boolean, context: FullscreenContext|null) {
+    // Arc: full screen keeps the sidebar as the window had it (shown, or
+    // hidden with ⌘S and sliding over the page from the left edge).
     this.updateFullscreenMode_(isFullscreen, context);
-    // Arc: full screen hides the sidebar; it slides over the page from the
-    // left edge, as after ⌘S. Leaving it brings back the window's own choice.
-    if (this.fullscreenMode_ === 'browser' &&
-        this.sidebarHiddenOutsideFullscreen_ === null) {
-      this.sidebarHiddenOutsideFullscreen_ = this.sidebarHidden_;
-      this.closeSiteControl_();
-      this.sidebarHidden_ = true;
-      this.sidebarPeek_ = false;
-    } else if (!this.fullscreenMode_ &&
-               this.sidebarHiddenOutsideFullscreen_ !== null) {
-      this.closeSiteControl_();
-      this.sidebarHidden_ = this.sidebarHiddenOutsideFullscreen_;
-      this.sidebarHiddenOutsideFullscreen_ = null;
-      this.sidebarPeek_ = false;
-    }
+    this.sidebarPeek_ = false;
   }
 
   private updateFullscreenMode_(
