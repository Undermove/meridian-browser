+// A screenshot's answer: JPEG, at most 1600 px wide.
+// static
+void AgentService::FinishScreenshot(std::unique_ptr<Call> call,
+                                    SkBitmap bitmap) {
+  if (bitmap.drawsNothing()) {
+    return call->Fail("couldn't capture the tab");
+  }
+  if (bitmap.width() > 1600) {
+    gfx::ImageSkia image = gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+    bitmap = *gfx::ImageSkiaOperations::CreateResizedImage(
+                  image, skia::ImageOperations::RESIZE_GOOD,
+                  gfx::Size(1600, bitmap.height() * 1600 / bitmap.width()))
+                  .bitmap();
+  }
+  std::optional<std::vector<uint8_t>> jpeg = gfx::JPEGCodec::Encode(bitmap, 75);
+  if (!jpeg) {
+    return call->Fail("couldn't encode the screenshot");
+  }
+  call->Ok(base::Value(base::DictValue()
+                           .Set("image", base::Base64Encode(*jpeg))
+                           .Set("mime_type", "image/jpeg")));
+}
