+// "github.com/foo" -> "github.com"; Arc shows just the site.
+function hostForPill(url: string): string {
+  if (!url) {
+    return '';
+  }
+  try {
+    const u = new URL(url);
+    if (u.protocol === 'http:' || u.protocol === 'https:') {
+      return u.hostname.replace(/^www\./, '');
+    }
+  } catch {
+    // Not a URL; show it as is.
+  }
+  return url;
+}
 
