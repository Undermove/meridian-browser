index 0000000000..6d25745f9b
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/command_bar.ts
@@ -0,0 +1,94 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The command bar (⌘T, ⌘L, New Tab, a click on the URL in the sidebar): a
+// centred overlay around Chromium's omnibox, so it has history, search
+// suggestions, URL completion and "switch to tab" for every space's tabs.
+
+import '../webui_browser_searchbox.js';
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {WebuiBrowserSearchboxElement} from '../webui_browser_searchbox.js';
+
+import {getCss} from './command_bar.css.js';
+import {getHtml} from './command_bar.html.js';
+
+export interface MeridianCommandBarElement {
+  $: {
+    address: WebuiBrowserSearchboxElement,
+  };
+}
+
+export class MeridianCommandBarElement extends CrLitElement {
+  static get is() {
+    return 'meridian-command-bar';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      newTab: {type: Boolean, reflect: true, attribute: 'new-tab'},
+    };
+  }
+
+  accessor open: boolean = false;
+  // Picks open in a new tab (⌘T) rather than in the current one (⌘L).
+  accessor newTab: boolean = false;
+
+  // `text`: what the field starts with (the current URL for ⌘L), selected.
+  async show(newTab: boolean, text: string) {
+    this.newTab = newTab;
+    this.open = true;
+    // A display:none field can't take the focus: wait for the render.
+    await this.updateComplete;
+    const box = this.$.address;
+    box.reset(text);
+    box.focusInput();
+    box.selectAll();
+  }
+
+  hide() {
+    if (!this.open) {
+      return;
+    }
+    this.open = false;
+    this.$.address.reset('');
+    this.fire('command-bar-closed');
+  }
+
+  protected onOverlayMousedown_(e: MouseEvent) {
+    if (e.target === e.currentTarget) {
+      this.hide();
+    }
+  }
+
+  protected onOverlayKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      e.stopPropagation();
+      this.hide();
+    }
+  }
+
+  protected onAddressSearchboxNavigated_() {
+    this.hide();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-command-bar': MeridianCommandBarElement;
+  }
+}
+
+customElements.define(MeridianCommandBarElement.is, MeridianCommandBarElement);
