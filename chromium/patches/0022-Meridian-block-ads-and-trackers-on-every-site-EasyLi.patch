 namespace component_updater {
 
 // The extension id is: gcmjkmgdlgnkkcocmoeiminaijmmjnii
@@ -146,15 +158,82 @@ SubresourceFilterComponentInstallerPolicy::GetInstallerAttributes() const {
   return attributes;
 }
 
+namespace {
+
+// Meridian blocks ads and trackers on every site with EasyList and
+// EasyPrivacy, converted at build time and shipped in the app, instead of
+// Google's short list of abusive-ad sites. Tests point at another ruleset with
+// --meridian-adblock-ruleset.
+base::FilePath MeridianRulesetPath() {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (cl->HasSwitch("meridian-adblock-ruleset")) {
+    return cl->GetSwitchValuePath("meridian-adblock-ruleset");
+  }
+#if BUILDFLAG(IS_MAC)
+  return base::apple::OuterBundlePath().Append(
+      "Contents/Resources/meridian_adblock.dat");
+#else
+  base::FilePath exe_dir;
+  base::PathService::Get(base::DIR_EXE, &exe_dir);
+  return exe_dir.AppendASCII("meridian_adblock.dat");
+#endif
+}
+
+void RegisterGoogleRuleset(ComponentUpdateService* cus) {
+  auto installer = base::MakeRefCounted<ComponentInstaller>(
+      std::make_unique<SubresourceFilterComponentInstallerPolicy>());
+  installer->Register(cus, base::OnceClosure());
+}
+
+// Without Meridian's ruleset (a development build), Google's list.
+void PublishMeridianRuleset(ComponentUpdateService* cus,
+                            base::FilePath path,
+                            std::optional<base::File::Info> info) {
+  if (!info) {
+    RegisterGoogleRuleset(cus);
+    return;
+  }
+  subresource_filter::RulesetService* ruleset_service =
+      g_browser_process->subresource_filter_ruleset_service();
+  if (!ruleset_service) {
+    return;
+  }
+  subresource_filter::UnindexedRulesetInfo ruleset_info;
+  // Newer than any component version, and new whenever the file changes.
+  ruleset_info.content_version = base::StringPrintf(
+      "1000.0.%u",
+      static_cast<uint32_t>(info->last_modified.InSecondsFSinceUnixEpoch()));
+  ruleset_info.ruleset_path = path;
+  ruleset_service->IndexAndStoreAndPublishRulesetIfNeeded(ruleset_info);
+}
+
+}  // namespace
+
 void RegisterSubresourceFilterComponent(ComponentUpdateService* cus) {
   if (!base::FeatureList::IsEnabled(
           subresource_filter::kSafeBrowsingSubresourceFilter)) {
     return;
   }
 
-  auto installer = base::MakeRefCounted<ComponentInstaller>(
-      std::make_unique<SubresourceFilterComponentInstallerPolicy>());
-  installer->Register(cus, base::OnceClosure());
+  // After startup, so indexing the ruleset doesn't get in the way of session
+  // restore.
+  base::FilePath meridian_ruleset = MeridianRulesetPath();
+  AfterStartupTaskUtils::PostTask(
+      FROM_HERE,
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE}),
+      base::BindOnce(
+          [](ComponentUpdateService* cus, base::FilePath path) {
+            std::optional<base::File::Info> result;
+            base::File::Info info;
+            if (base::GetFileInfo(path, &info) && !info.is_directory) {
+              result = info;
+            }
+            content::GetUIThreadTaskRunner({})->PostTask(
+                FROM_HERE, base::BindOnce(&PublishMeridianRuleset,
+                                          base::Unretained(cus), path, result));
+          },
+          base::Unretained(cus), meridian_ruleset));
 }
 
 }  // namespace component_updater
