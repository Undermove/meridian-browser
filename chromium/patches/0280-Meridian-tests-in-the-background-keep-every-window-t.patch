diff --git a/chrome/browser/meridian/sidebar_handler_mac.mm b/chrome/browser/meridian/sidebar_handler_mac.mm
index 995d21ec3e..1031ab8510 100644
--- a/chrome/browser/meridian/sidebar_handler_mac.mm
+++ b/chrome/browser/meridian/sidebar_handler_mac.mm
@@ -266,6 +266,33 @@ void SidebarHandler::TestWindowState(TestWindowStateCallback callback) {
           : std::string());
 }
 
+void SidebarHandler::TestBackgroundState(
+    TestBackgroundStateCallback callback) {
+  if (!HasTestSwitch("meridian-test-background")) {
+    std::move(callback).Run(false, 0, 0, 0, 0);
+    return;
+  }
+  int shown = 0, key = 0, may_switch = 0, windows = 0;
+  for (NSWindow* window in NSApp.windows) {
+    if (!window.isVisible) {
+      continue;
+    }
+    ++windows;
+    if (window.alphaValue > 0 || !window.ignoresMouseEvents) {
+      ++shown;
+    }
+    if (window.isKeyWindow) {
+      ++key;
+    }
+    if (!(window.collectionBehavior &
+          (NSWindowCollectionBehaviorMoveToActiveSpace |
+           NSWindowCollectionBehaviorCanJoinAllSpaces))) {
+      ++may_switch;
+    }
+  }
+  std::move(callback).Run(NSApp.isActive, shown, key, may_switch, windows);
+}
+
 void SidebarHandler::TestFloatingWindows(
     TestFloatingWindowsCallback callback) {
   std::vector<std::string> out;
