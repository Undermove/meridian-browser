+
+// Firefox's or Safari's history (web pages only).
+history::URLRows ReadOtherHistory(const ImportSource& source);
+// How many pages that is, without reading them all.
+int CountOtherHistory(const ImportSource& source);
+
+// Safari is here but macOS keeps its files from Meridian (Full Disk Access).
+bool SafariNeedsAccess(const ImportSource& source);
