+// Each Chromium browser: its own keychain item, its own Meridian profiles,
+// its own test switch.
+TEST(ImportSourceTest, EachBrowserItsOwn) {
+  struct {
+    const char* kind;
+    const char* keychain;
+    const char* account;
+    const char* prefix;
+  } kCases[] = {
+      {"chrome", "Chrome Safe Storage", "Chrome", "Meridian Profile Chrome "},
+      {"brave", "Brave Safe Storage", "Brave", "Meridian Profile Brave "},
+      {"edge", "Microsoft Edge Safe Storage", "Microsoft Edge",
+       "Meridian Profile Edge "},
+      {"vivaldi", "Vivaldi Safe Storage", "Vivaldi",
+       "Meridian Profile Vivaldi "},
+      {"opera", "Opera Safe Storage", "Opera", "Meridian Profile Opera "},
+  };
+  for (const auto& c : kCases) {
+    ImportSource s = ImportSourceFor(c.kind);
+    EXPECT_EQ(s.kind, c.kind);
+    EXPECT_EQ(s.format, ImportSource::Format::kChromium);
+    EXPECT_EQ(s.keychain_service, c.keychain);
+    EXPECT_EQ(s.keychain_account, c.account);
+    EXPECT_EQ(s.profile_prefix, c.prefix);
+    EXPECT_EQ(s.dir_switch, base::StrCat({"meridian-", c.kind, "-dir"}));
+  }
+  EXPECT_EQ(ImportSourceFor("firefox").format, ImportSource::Format::kFirefox);
+  EXPECT_EQ(ImportSourceFor("safari").format, ImportSource::Format::kSafari);
+  EXPECT_TRUE(ImportSourceFor("firefox").keychain_service.empty());
+  EXPECT_EQ(ImportSourceFor("nonsense").kind, "arc");
+  EXPECT_EQ(ImportKinds().front(), "arc");
+  EXPECT_EQ(ImportKinds().size(), 8u);
+  EXPECT_EQ(ImportedPref("chrome"), "meridian.chrome_imported");
+  EXPECT_EQ(DataImportedAtPref("chrome"), "meridian.chrome_data_imported_at");
+  EXPECT_EQ(DataImportedAtPref("arc"), "meridian.arc_data_imported_at");
+}
+
+TEST(ImportSourceTest, ProfileFolders) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  for (const char* name : {"Profile 10", "Default", "Profile 2",
+                           "System Profile", "Guest Profile", "Crashpad"}) {
+    ASSERT_TRUE(base::CreateDirectory(dir.GetPath().AppendASCII(name)));
+  }
+  ImportSource brave = ImportSourceFor("brave");
+  brave.user_data = dir.GetPath();
+  std::vector<std::string> names;
+  for (const auto& [name, path] : ProfileDirsOf(brave)) {
+    names.push_back(name);
+    EXPECT_EQ(path, dir.GetPath().AppendASCII(name));
+  }
+  EXPECT_EQ(names,
+            (std::vector<std::string>{"Default", "Profile 2", "Profile 10"}));
+  EXPECT_EQ(ProfileIdFor(brave, "Profile 2"), "Meridian Profile Brave 2");
+  EXPECT_EQ(ProfileIdFor(brave, "Default"), "");
+
+  // Opera: the folder itself is the one profile.
+  ImportSource opera = ImportSourceFor("opera");
+  opera.user_data = dir.GetPath();
+  auto dirs = ProfileDirsOf(opera);
+  ASSERT_EQ(dirs.size(), 1u);
+  EXPECT_EQ(dirs[0].first, "Default");
+  EXPECT_EQ(dirs[0].second, dir.GetPath());
+
+  // Firefox and Safari keep no Chromium profiles.
+  ImportSource firefox = ImportSourceFor("firefox");
+  firefox.user_data = dir.GetPath();
+  EXPECT_TRUE(ProfileDirsOf(firefox).empty());
+}
+
+// A profile Opera's way: Bookmarks right in the folder, the space named
+// "Opera".
+TEST(ImportSourceTest, OperaSidebar) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  ASSERT_TRUE(base::WriteFile(
+      dir.GetPath().AppendASCII("Bookmarks"),
+      R"({"roots": {"bookmark_bar": {"type": "folder", "children": [
+           {"type": "url", "name": "Dial", "url": "https://dial.example/"}]},
+         "other": {"type": "folder", "children": []}}})"));
+  ImportSource opera = ImportSourceFor("opera");
+  opera.user_data = dir.GetPath();
+  std::optional<ArcSidebar> sidebar = ReadChromeSidebar(opera);
+  ASSERT_TRUE(sidebar);
+  ASSERT_EQ(sidebar->spaces.size(), 1u);
+  EXPECT_EQ(sidebar->spaces[0].name, "Opera");
+  EXPECT_EQ(sidebar->spaces[0].profile, "");
+  ASSERT_EQ(sidebar->spaces[0].pinned.size(), 1u);
+  EXPECT_EQ(sidebar->spaces[0].pinned[0].title, "Dial");
+}
+
 }  // namespace
 }  // namespace meridian
