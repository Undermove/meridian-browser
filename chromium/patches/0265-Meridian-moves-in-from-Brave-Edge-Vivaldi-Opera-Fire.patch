+
+bool SourceFound(const ImportSource& source) {
+  if (source.user_data.empty() && source.app_data.empty()) {
+    return false;
+  }
+  const base::FilePath& dir = source.user_data;
+  switch (source.format) {
+    case ImportSource::Format::kFirefox:
+      return base::PathExists(dir.AppendASCII("profiles.ini"));
+    case ImportSource::Format::kSafari:
+      // Only whether they're there (macOS may keep what's in them private).
+      return base::PathExists(dir.AppendASCII("Bookmarks.plist")) ||
+             base::PathExists(dir.AppendASCII("History.db"));
+    case ImportSource::Format::kChromium:
+      break;
+  }
+  // Arc's own sidebar, or a profile.
+  if (!source.app_data.empty() &&
+      base::PathExists(source.app_data.AppendASCII("StorableSidebar.json"))) {
+    return true;
+  }
+  if (source.root_is_profile) {
+    return base::PathExists(dir.AppendASCII("Local State")) ||
+           base::PathExists(dir.AppendASCII("Bookmarks")) ||
+           base::PathExists(dir.AppendASCII("History"));
+  }
+  return !ProfileDirsOf(source).empty();
+}
+
+std::vector<std::pair<std::string, base::FilePath>> ProfileDirsOf(
+    const ImportSource& source) {
+  std::vector<std::pair<std::string, base::FilePath>> out;
+  if (source.format != ImportSource::Format::kChromium ||
+      source.user_data.empty()) {
+    return out;
+  }
+  if (source.root_is_profile) {
+    if (base::DirectoryExists(source.user_data)) {
+      out.emplace_back("Default", source.user_data);
+    }
+    return out;
+  }
+  base::FileEnumerator dirs(source.user_data, false,
+                            base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath dir = dirs.Next(); !dir.empty(); dir = dirs.Next()) {
+    std::string name = dir.BaseName().AsUTF8Unsafe();
+    if (IsProfileDir(name)) {
+      out.emplace_back(name, dir);
+    }
+  }
+  std::ranges::sort(out, {}, [](const auto& d) {
+    int n = 0;
+    base::StringToInt(d.first.substr(std::min<size_t>(8, d.first.size())), &n);
+    return d.first == "Default" ? -1 : n;
+  });
+  return out;
 }
 
