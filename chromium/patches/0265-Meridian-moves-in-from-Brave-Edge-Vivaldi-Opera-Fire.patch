+std::vector<std::pair<std::string, base::FilePath>> FirefoxProfiles(
+    const base::FilePath& root) {
+  std::vector<std::pair<std::string, base::FilePath>> out;
+  std::string ini;
+  if (!base::ReadFileToStringWithMaxSize(root.AppendASCII("profiles.ini"),
+                                         &ini, 1024 * 1024)) {
+    return out;
+  }
+  struct Section {
+    std::string name, path;
+    bool relative = true;
+    bool is_default = false;
+  };
+  std::vector<Section> sections;
+  bool in_profile = false;
+  for (std::string_view line : base::SplitStringPiece(
+           ini, "\r\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (line.starts_with("[")) {
+      in_profile = line.starts_with("[Profile");
+      if (in_profile) {
+        sections.emplace_back();
+      }
+      continue;
+    }
+    size_t eq = line.find('=');
+    if (!in_profile || eq == std::string_view::npos) {
+      continue;
+    }
+    std::string_view key = line.substr(0, eq);
+    std::string value(line.substr(eq + 1));
+    Section& s = sections.back();
+    if (key == "Name") {
+      s.name = value;
+    } else if (key == "Path") {
+      s.path = value;
+    } else if (key == "IsRelative") {
+      s.relative = value != "0";
+    } else if (key == "Default") {
+      s.is_default = value == "1";
+    }
+  }
+  // The default profile first.
+  std::ranges::stable_sort(sections, [](const Section& a, const Section& b) {
+    return a.is_default > b.is_default;
+  });
+  for (const Section& s : sections) {
+    if (s.path.empty() || s.path.find("..") != std::string::npos) {
+      continue;
+    }
+    base::FilePath dir = s.relative ? root.Append(base::FilePath::FromUTF8Unsafe(s.path))
+                                    : base::FilePath::FromUTF8Unsafe(s.path);
+    if (base::PathExists(PlacesOf(dir))) {
+      out.emplace_back(s.name, dir);
+    }
+  }
+  return out;
+}
+
+std::vector<Item> SafariBookmarks(const base::DictValue& root) {
+  std::vector<Item> out;
+  const base::ListValue* top = root.FindList("Children");
+  if (!top) {
+    return out;
+  }
+  size_t count = 0;
+  // The favorites bar on top; the menu and the reading list as folders.
+  std::vector<Item> rest;
+  for (const base::Value& v : *top) {
+    if (!v.is_dict()) {
+      continue;
+    }
+    const base::DictValue& node = v.GetDict();
+    const std::string* title = node.FindString("Title");
+    const base::ListValue* kids = node.FindList("Children");
+    const std::string* type = node.FindString("WebBookmarkType");
+    if (title && *title == "BookmarksBar" && kids) {
+      ConvertSafari(*kids, 0, count, out);
+    } else if (title && kids &&
+               (*title == "BookmarksMenu" ||
+                *title == "com.apple.ReadingList")) {
+      Item folder;
+      folder.is_folder = true;
+      folder.open = false;
+      folder.title =
+          *title == "BookmarksMenu" ? "Bookmarks menu" : "Reading List";
+      ConvertSafari(*kids, 1, count, folder.children);
+      if (!folder.children.empty()) {
+        rest.push_back(std::move(folder));
+      }
+    } else if (type && *type != "WebBookmarkTypeProxy") {
+      base::ListValue one;
+      one.Append(v.Clone());
+      ConvertSafari(one, 1, count, rest);
+    }
+  }
+  std::ranges::move(rest, std::back_inserter(out));
+  return out;
+}
