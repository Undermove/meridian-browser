+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/other_import.h"
+
+#import <Foundation/Foundation.h>
+
+#include "base/apple/foundation_util.h"
+#include "base/strings/sys_string_conversions.h"
+
+namespace meridian::internal {
+
+namespace {
+
+std::optional<base::Value> ToValue(id object, int depth) {
+  if (depth > 64) {
+    return std::nullopt;
+  }
+  if (NSString* s = base::apple::ObjCCast<NSString>(object)) {
+    return base::Value(base::SysNSStringToUTF8(s));
+  }
+  if (NSNumber* n = base::apple::ObjCCast<NSNumber>(object)) {
+    return base::Value(n.doubleValue);
+  }
+  if (NSArray* a = base::apple::ObjCCast<NSArray>(object)) {
+    base::ListValue list;
+    for (id item in a) {
+      if (std::optional<base::Value> v = ToValue(item, depth + 1)) {
+        list.Append(std::move(*v));
+      }
+    }
+    return base::Value(std::move(list));
+  }
+  if (NSDictionary* d = base::apple::ObjCCast<NSDictionary>(object)) {
+    base::DictValue dict;
+    for (id key in d) {
+      NSString* k = base::apple::ObjCCast<NSString>(key);
+      if (!k) {
+        continue;
+      }
+      if (std::optional<base::Value> v = ToValue(d[key], depth + 1)) {
+        dict.Set(base::SysNSStringToUTF8(k), std::move(*v));
+      }
+    }
+    return base::Value(std::move(dict));
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+std::optional<base::Value> ReadPlist(const base::FilePath& file) {
+  @autoreleasepool {
+    NSData* data = [NSData
+        dataWithContentsOfFile:base::apple::FilePathToNSString(file)];
+    if (!data || data.length > 64 * 1024 * 1024) {
+      return std::nullopt;
+    }
+    id plist = [NSPropertyListSerialization
+        propertyListWithData:data
+                     options:NSPropertyListImmutable
+                      format:nil
+                       error:nil];
+    return plist ? ToValue(plist, 0) : std::nullopt;
+  }
+}
+
+}  // namespace meridian::internal
