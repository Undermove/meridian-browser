+constexpr size_t kMaxItems = 5000;
+constexpr size_t kMaxHistory = 200000;
+
+// A web page worth a pinned tab or a history row.
+bool IsWebPage(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+}
+
+// Firefox's times: microseconds since 1970.
+base::Time FromPRTime(int64_t us) {
+  return us > 0 ? base::Time::UnixEpoch() + base::Microseconds(us)
+                : base::Time();
+}
+
+// Safari's: seconds since 2001.
+base::Time FromAppleTime(double s) {
+  return s > 0 ? base::Time::FromSecondsSinceUnixEpoch(s + 978307200)
+               : base::Time();
+}
+
+base::FilePath PlacesOf(const base::FilePath& profile) {
+  return profile.AppendASCII("places.sqlite");
+}
+
+// ------------------------------------------------------------- Firefox
+
+struct FirefoxNode {
+  int64_t id = 0;
+  int type = 0;  // 1 a page, 2 a folder, 3 a separator
+  std::string title;
+  std::string url;
+};
+
+void ConvertFirefox(
+    const std::map<int64_t, std::vector<FirefoxNode>>& children,
+    int64_t parent,
+    int depth,
+    size_t& count,
+    std::vector<Item>& out) {
+  auto it = children.find(parent);
+  if (it == children.end()) {
+    return;
+  }
+  for (const FirefoxNode& node : it->second) {
+    if (count >= kMaxItems) {
+      return;
+    }
+    if (node.type == 1) {
+      GURL url(node.url);
+      if (!IsWebPage(url)) {
+        continue;
+      }
+      Item item;
+      item.url = url;
+      item.title = node.title.empty() ? url.spec() : node.title;
+      ++count;
+      out.push_back(std::move(item));
+    } else if (node.type == 2 && depth < 32) {
+      Item folder;
+      folder.is_folder = true;
+      folder.open = false;
+      folder.title = node.title.empty() ? "Folder" : node.title;
+      ConvertFirefox(children, node.id, depth + 1, count, folder.children);
+      if (!folder.children.empty()) {
+        ++count;
+        out.push_back(std::move(folder));
+      }
+    }
+  }
+}
+
+std::vector<Item> FirefoxBookmarks(sql::Database& db) {
+  std::vector<Item> out;
+  if (!db.DoesTableExist("moz_bookmarks") ||
+      !db.DoesTableExist("moz_places")) {
+    return out;
+  }
+  std::map<std::string, int64_t> roots;
+  {
+    sql::Statement s(db.GetUniqueStatement(
+        "SELECT id, guid FROM moz_bookmarks WHERE guid IN ('toolbar_____', "
+        "'menu________', 'unfiled_____', 'mobile______')"));
+    while (s.Step()) {
+      roots[s.ColumnString(1)] = s.ColumnInt64(0);
+    }
+  }
+  std::map<int64_t, std::vector<FirefoxNode>> children;
+  {
+    sql::Statement s(db.GetUniqueStatement(
+        "SELECT b.id, b.type, b.parent, b.title, p.url FROM moz_bookmarks b "
+        "LEFT JOIN moz_places p ON b.fk = p.id ORDER BY b.parent, b.position"));
+    while (s.Step()) {
+      children[s.ColumnInt64(2)].push_back(
+          {s.ColumnInt64(0), s.ColumnInt(1), s.ColumnString(3),
+           s.ColumnString(4)});
+    }
+  }
+  size_t count = 0;
+  // The toolbar's on top; the menu, other and mobile bookmarks as folders.
+  if (auto it = roots.find("toolbar_____"); it != roots.end()) {
+    ConvertFirefox(children, it->second, 0, count, out);
+  }
+  for (const auto& [guid, title] :
+       {std::pair<const char*, const char*>{"menu________", "Bookmarks menu"},
+        {"unfiled_____", "Other bookmarks"},
+        {"mobile______", "Mobile bookmarks"}}) {
+    auto it = roots.find(guid);
+    if (it == roots.end()) {
+      continue;
+    }
+    Item folder;
+    folder.is_folder = true;
+    folder.open = false;
+    folder.title = title;
+    ConvertFirefox(children, it->second, 1, count, folder.children);
+    if (!folder.children.empty()) {
+      out.push_back(std::move(folder));
+    }
+  }
+  return out;
+}
+
+void ReadFirefoxHistory(const base::FilePath& places, history::URLRows& out) {
+  base::ScopedTempDir tmp;
+  sql::Database db(sql::Database::Tag("History"));
+  if (!internal::OpenCopy(places, tmp, db) ||
+      !db.DoesTableExist("moz_places")) {
+    return;
+  }
+  sql::Statement s(db.GetUniqueStatement(
+      "SELECT url, title, visit_count, typed, last_visit_date, hidden "
+      "FROM moz_places WHERE last_visit_date > 0 "
+      "ORDER BY last_visit_date DESC"));
+  while (s.Step() && out.size() < kMaxHistory) {
+    GURL url(s.ColumnString(0));
+    base::Time last = FromPRTime(s.ColumnInt64(4));
+    if (!IsWebPage(url) || last.is_null()) {
+      continue;
+    }
+    history::URLRow row(url);
+    row.set_title(s.ColumnString16(1));
+    row.set_visit_count(std::max(1, s.ColumnInt(2)));
+    row.set_typed_count(s.ColumnInt(3) ? 1 : 0);
+    row.set_last_visit(last);
+    row.set_hidden(s.ColumnInt(5) != 0);
+    out.push_back(std::move(row));
+  }
+}
