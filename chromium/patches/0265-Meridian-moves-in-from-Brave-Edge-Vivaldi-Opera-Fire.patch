+
+std::optional<ArcSidebar> ReadFirefoxSidebar(const ImportSource& source) {
+  if (!SourceFound(source)) {
+    return std::nullopt;
+  }
+  auto profiles = internal::FirefoxProfiles(source.user_data);
+  ArcSidebar out;
+  for (const auto& [name, dir] : profiles) {
+    Space space;
+    space.name = profiles.size() == 1 || name.empty() ||
+                         name.starts_with("default")
+                     ? source.short_name
+                     : name.substr(0, 60);
+    space.icon = "🦊";
+    base::ScopedTempDir tmp;
+    sql::Database db(sql::Database::Tag("History"));
+    if (internal::OpenCopy(PlacesOf(dir), tmp, db)) {
+      space.pinned = FirefoxBookmarks(db);
+    }
+    // Two "Firefox" spaces would be one too many: the name of the profile.
+    if (std::ranges::any_of(out.spaces, [&](const Space& s) {
+          return s.name == space.name;
+        })) {
+      space.name = name.substr(0, 60);
+    }
+    out.spaces.push_back(std::move(space));
+    out.today.emplace_back();
+  }
+  if (out.spaces.empty()) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+std::optional<ArcSidebar> ReadSafariSidebar(const ImportSource& source) {
+  if (!SourceFound(source)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> plist =
+      internal::ReadPlist(SafariBookmarksFile(source));
+  bool history = base::PathExists(SafariHistoryFile(source));
+  if ((!plist || !plist->is_dict()) && !history) {
+    return std::nullopt;
+  }
+  ArcSidebar out;
+  Space space;
+  space.name = source.short_name;
+  space.icon = "🧭";
+  if (plist && plist->is_dict()) {
+    space.pinned = internal::SafariBookmarks(plist->GetDict());
+  }
+  out.spaces.push_back(std::move(space));
+  out.today.emplace_back();
+  return out;
+}
+
+std::optional<ArcSidebar> ReadSidebarOf(const ImportSource& source) {
+  switch (source.format) {
+    case ImportSource::Format::kFirefox:
+      return ReadFirefoxSidebar(source);
+    case ImportSource::Format::kSafari:
+      return ReadSafariSidebar(source);
+    case ImportSource::Format::kChromium:
+      return source.kind == "arc" ? ReadArcSidebar()
+                                  : ReadChromeSidebar(source);
+  }
+}
+
+history::URLRows ReadOtherHistory(const ImportSource& source) {
+  history::URLRows out;
+  if (!SourceFound(source)) {
+    return out;
+  }
+  if (source.format == ImportSource::Format::kFirefox) {
+    for (const auto& [name, dir] : internal::FirefoxProfiles(source.user_data)) {
+      ReadFirefoxHistory(PlacesOf(dir), out);
+    }
+    return out;
+  }
+  if (source.format != ImportSource::Format::kSafari) {
+    return out;
+  }
+  base::ScopedTempDir tmp;
+  sql::Database db(sql::Database::Tag("History"));
+  if (!internal::OpenCopy(SafariHistoryFile(source), tmp, db) ||
+      !db.DoesTableExist("history_items") ||
+      !db.DoesTableExist("history_visits")) {
+    return out;
+  }
+  sql::Statement s(db.GetUniqueStatement(
+      "SELECT i.url, i.visit_count, MAX(v.visit_time), "
+      "(SELECT title FROM history_visits WHERE history_item = i.id "
+      "ORDER BY visit_time DESC LIMIT 1) "
+      "FROM history_items i JOIN history_visits v ON v.history_item = i.id "
+      "GROUP BY i.id ORDER BY MAX(v.visit_time) DESC"));
+  while (s.Step() && out.size() < kMaxHistory) {
+    GURL url(s.ColumnString(0));
+    base::Time last = FromAppleTime(s.ColumnDouble(2));
+    if (!IsWebPage(url) || last.is_null()) {
+      continue;
+    }
+    history::URLRow row(url);
+    row.set_title(s.ColumnString16(3));
+    row.set_visit_count(std::max(1, s.ColumnInt(1)));
+    row.set_last_visit(last);
+    out.push_back(std::move(row));
+  }
+  return out;
+}
+
+int CountOtherHistory(const ImportSource& source) {
+  return static_cast<int>(ReadOtherHistory(source).size());
+}
+
+bool SafariNeedsAccess(const ImportSource& source) {
+  if (source.format != ImportSource::Format::kSafari || !SourceFound(source)) {
+    return false;
+  }
+  for (const base::FilePath& file :
+       {SafariBookmarksFile(source), SafariHistoryFile(source)}) {
+    base::File f(file, base::File::FLAG_OPEN | base::File::FLAG_READ);
+    if (f.IsValid()) {
+      return false;
+    }
+    if (f.error_details() == base::File::FILE_ERROR_ACCESS_DENIED) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace meridian
