+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The browsers Meridian moves in from, in the order the first run offers
+// them: the name said, the keychain item macOS asks about ("<keychain> Safe
+// Storage"; none for Firefox and Safari, which bring bookmarks and history
+// only).
+export interface ImportSourceInfo {
+  name: string;
+  keychain: string;
+  // Bookmarks and history only: no open tabs, passwords or sign-ins.
+  limited: boolean;
+}
+
+export const IMPORT_SOURCES: Record<string, ImportSourceInfo> = {
+  arc: {name: 'Arc', keychain: 'Arc', limited: false},
+  chrome: {name: 'Chrome', keychain: 'Chrome', limited: false},
+  brave: {name: 'Brave', keychain: 'Brave', limited: false},
+  edge: {name: 'Edge', keychain: 'Microsoft Edge', limited: false},
+  vivaldi: {name: 'Vivaldi', keychain: 'Vivaldi', limited: false},
+  opera: {name: 'Opera', keychain: 'Opera', limited: false},
+  firefox: {name: 'Firefox', keychain: '', limited: true},
+  safari: {name: 'Safari', keychain: '', limited: true},
+};
+
+export const IMPORT_KINDS: string[] = Object.keys(IMPORT_SOURCES);
+
+export function sourceName(kind: string): string {
+  return IMPORT_SOURCES[kind]?.name || kind;
+}
