+// ------------------------------------------------------------- Safari
+
+base::FilePath SafariBookmarksFile(const ImportSource& source) {
+  return source.user_data.AppendASCII("Bookmarks.plist");
+}
+
+base::FilePath SafariHistoryFile(const ImportSource& source) {
+  return source.user_data.AppendASCII("History.db");
+}
+
+void ConvertSafari(const base::ListValue& children,
+                   int depth,
+                   size_t& count,
+                   std::vector<Item>& out) {
+  for (const base::Value& v : children) {
+    if (!v.is_dict() || count >= kMaxItems) {
+      continue;
+    }
+    const base::DictValue& node = v.GetDict();
+    const std::string* type = node.FindString("WebBookmarkType");
+    if (!type) {
+      continue;
+    }
+    if (*type == "WebBookmarkTypeLeaf") {
+      const std::string* spec = node.FindString("URLString");
+      GURL url = spec ? GURL(*spec) : GURL();
+      if (!IsWebPage(url)) {
+        continue;
+      }
+      const std::string* title = node.FindStringByDottedPath("URIDictionary.title");
+      Item item;
+      item.url = url;
+      item.title = title && !title->empty() ? *title : url.spec();
+      ++count;
+      out.push_back(std::move(item));
+    } else if (*type == "WebBookmarkTypeList" && depth < 32) {
+      const base::ListValue* kids = node.FindList("Children");
+      const std::string* title = node.FindString("Title");
+      Item folder;
+      folder.is_folder = true;
+      folder.open = false;
+      folder.title = title && !title->empty() ? *title : "Folder";
+      if (kids) {
+        ConvertSafari(*kids, depth + 1, count, folder.children);
+      }
+      if (!folder.children.empty()) {
+        ++count;
+        out.push_back(std::move(folder));
+      }
+    }
+  }
+}
