From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Tue, 27 Oct 2026 13:49:50 +0400
Subject: [PATCH 12/48] Meridian: loading indicators (row favicon pulse, URL
 pill bar)

---
 .../browser/resources/webui_browser/app.css   | 23 +++++++++++++++++++
 .../resources/webui_browser/app.html.ts       |  1 +
 .../webui_browser/meridian/item.html.ts       |  3 ++-
 .../resources/webui_browser/meridian/item.ts  |  7 ++++++
 .../resources/webui_browser/meridian/rows.css | 11 +++++++++
 .../webui_browser/meridian/tab_row.html.ts    |  3 ++-
 .../webui_browser/meridian/tab_row.ts         |  7 ++++++
 7 files changed, 53 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/resources/webui_browser/app.css b/chrome/browser/resources/webui_browser/app.css
index 9bd3ac152d..1258be062c 100644
--- a/chrome/browser/resources/webui_browser/app.css
+++ b/chrome/browser/resources/webui_browser/app.css
@@ -148,6 +148,7 @@ cr-icon-button {
 }
 
 #urlPill {
+  position: relative;
   display: flex;
   align-items: center;
   gap: 4px;
@@ -161,6 +162,28 @@ cr-icon-button {
   -webkit-app-region: no-drag;
 }
 
+/* Loading: a bar runs along the bottom of the URL pill. */
+#urlPill.loading::after {
+  content: '';
+  position: absolute;
+  left: 0;
+  bottom: 0;
+  height: 2px;
+  width: 40%;
+  border-radius: 2px;
+  background: var(--meridian-space);
+  animation: loadbar 1.1s ease-in-out infinite;
+}
+
+@keyframes loadbar {
+  from {
+    transform: translateX(-100%);
+  }
+  to {
+    transform: translateX(260%);
+  }
+}
+
 #urlPill:hover {
   background: var(--meridian-row-active);
 }
diff --git a/chrome/browser/resources/webui_browser/app.html.ts b/chrome/browser/resources/webui_browser/app.html.ts
index eed6fd2cf5..eea0032f61 100644
--- a/chrome/browser/resources/webui_browser/app.html.ts
+++ b/chrome/browser/resources/webui_browser/app.html.ts
@@ -46,6 +46,7 @@ export function getHtml(this: WebuiBrowserAppElement) {
       </cr-icon-button>
     </div>
     <div id="urlPill" role="button" tabindex="0"
+        class="${this.reloadOrStopIcon_ === 'icon-clear' ? 'loading' : ''}"
         title="Edit URL (⌘L)" @click="${this.onUrlPillClick_}">
       <cr-button id="locationIconButton" type="button"
           ?hidden="${!this.showLocationIconButton_}"
diff --git a/chrome/browser/resources/webui_browser/meridian/item.html.ts b/chrome/browser/resources/webui_browser/meridian/item.html.ts
index 1f3a5cfb92..498e4ec79f 100644
--- a/chrome/browser/resources/webui_browser/meridian/item.html.ts
+++ b/chrome/browser/resources/webui_browser/meridian/item.html.ts
@@ -35,7 +35,8 @@ ${this.item?.isFolder ? html`
 ` : ''}
 ${this.item && !this.item.isFolder ? html`
   <div class="row pinned ${this.tab_ ? '' : 'unloaded'} ${
-      this.tab_?.isActive ? 'active' : ''}" style="--depth:${this.depth}"
+      this.tab_?.isActive ? 'active' : ''} ${this.loading_ ? 'loading' : ''}"
+      style="--depth:${this.depth}"
       draggable="true" data-item="${this.item.id}"
       data-parent="${this.parentId}" title="${this.title_}"
       @mousedown="${this.onRowMousedown_}"
