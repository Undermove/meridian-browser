@@ -56,6 +59,7 @@ export class MeridianItemElement extends CrLitElement {
   protected accessor away_: boolean = false;
   protected accessor favicon_: string = '';
   protected accessor title_: string = '';
+  protected accessor loading_: boolean = false;
 
   override willUpdate(changed: PropertyValues<this>) {
     super.willUpdate(changed);
@@ -67,6 +71,9 @@ export class MeridianItemElement extends CrLitElement {
     this.tab_ = host.liveTab(item.id);
     this.away_ = host.awayFromHome(item, this.tab_);
     this.favicon_ = host.faviconFor(item, this.tab_);
+    this.loading_ = !!this.tab_ &&
+        (this.tab_.networkState === TabNetworkState.kLoading ||
+         this.tab_.networkState === TabNetworkState.kWaiting);
     this.title_ = this.tab_ && this.away_ ?
         this.tab_.title :
         item.title || this.tab_?.title || item.url;
diff --git a/chrome/browser/resources/webui_browser/meridian/rows.css b/chrome/browser/resources/webui_browser/meridian/rows.css
index f29ae0560b..321bd5c009 100644
--- a/chrome/browser/resources/webui_browser/meridian/rows.css
+++ b/chrome/browser/resources/webui_browser/meridian/rows.css
@@ -193,3 +193,14 @@ input.rename {
 .fav.drop-after {
   box-shadow: 3px 0 0 var(--meridian-space);
 }
+
+/* Loading: the favicon pulses (Electron: .row.loading .favicon). */
+.row.loading .favicon {
+  animation: pulse 1s ease-in-out infinite;
+}
+
+@keyframes pulse {
+  50% {
+    opacity: 0.35;
+  }
+}
