From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Sat, 21 Nov 2026 00:50:08 +0400
Subject: [PATCH 212/212] Meridian: OpenCode answers Ask again (no --dir); the
 conversation in Ask can be selected

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/ai/providers.cc                 | 4 +++-
 chrome/browser/resources/webui_browser/meridian/ask.css | 7 +++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/meridian/ai/providers.cc b/chrome/browser/meridian/ai/providers.cc
index 123cdc7e50..adf5d07f90 100644
--- a/chrome/browser/meridian/ai/providers.cc
+++ b/chrome/browser/meridian/ai/providers.cc
@@ -568,7 +568,9 @@ CommandSpec BuildCommand(const Provider& p,
                                      .Set("prompt", turn.system)
                                      .Set("mode", "primary")));
     }
-    spec.args = {"run", "--format", "json", "--dir", cwd};
+    // The run's directory is the process's own (no --dir: OpenCode before
+    // 1.x doesn't know it, "Unrecognized flag: --dir").
+    spec.args = {"run", "--format", "json"};
     if (!turn.system.empty()) {
       spec.args.push_back("--agent");
       spec.args.push_back("meridian");
diff --git a/chrome/browser/resources/webui_browser/meridian/ask.css b/chrome/browser/resources/webui_browser/meridian/ask.css
index ce066eccc6..46ac0cc07e 100644
--- a/chrome/browser/resources/webui_browser/meridian/ask.css
+++ b/chrome/browser/resources/webui_browser/meridian/ask.css
@@ -219,3 +219,10 @@ textarea {
   color: var(--meridian-text-muted);
   background: color-mix(in srgb, var(--meridian-text) 7%, transparent);
 }
+
+/* The browser's frame can't be selected (app.css); what the conversation says
+   can, to copy a question, an answer or an error. */
+.msg {
+  user-select: text;
+  cursor: text;
+}
