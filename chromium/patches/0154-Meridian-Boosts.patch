+// ------------------------------------------------------------------ boosts
+
+void AgentService::GetBoost(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail(kNoTab);
+  }
+  Activity(*call, tab);
+  std::string host = BoostHostFor(tab->GetContents()->GetLastCommittedURL());
+  if (host.empty()) {
+    return call->Fail("only websites (http or https) can have a boost");
+  }
+  const Boost* boost = BoostServiceFactory::GetForProfile(profile_)->ForHost(host);
+  call->Ok(base::Value(base::DictValue().Set("host", host).Set(
+      "boost", boost ? base::Value(boost->ToValue()) : base::Value())));
+}
+
+void AgentService::SetBoost(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail(kNoTab);
+  }
+  Activity(*call, tab);
+  std::string host = BoostHostFor(tab->GetContents()->GetLastCommittedURL());
+  if (host.empty()) {
+    return call->Fail("only websites (http or https) can have a boost");
+  }
+  const std::string* js = call->Str("js");
+  if (js && !js->empty() &&
+      !profile_->GetPrefs()->GetBoolean(prefs::kAgentAllowJs)) {
+    return call->Fail(
+        "JavaScript in boosts is off for agents. Use CSS, or the person can "
+        "allow JavaScript in Settings > AI.");
+  }
+  bool remove = call->input.FindBool("remove").value_or(false);
+  std::string summary = (remove ? "Remove the boost of " : "Boost ") + host;
+  Confirm(
+      std::move(call), summary,
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, std::string host, bool remove,
+             std::unique_ptr<Call> call) {
+            if (!self) {
+              return call->Fail("Meridian is closing");
+            }
+            BoostService* service =
+                BoostServiceFactory::GetForProfile(self->profile_);
+            const Boost* existing = service->ForHost(host);
+            if (remove) {
+              if (existing) {
+                service->Remove(existing->id);
+              }
+              return call->Ok(
+                  base::Value(base::DictValue().Set("removed", !!existing)));
+            }
+            base::DictValue value =
+                existing ? existing->ToValue()
+                         : base::DictValue().Set("host", host).Set("name",
+                                                                   host);
+            for (const char* key :
+                 {"css", "js", "zaps", "name", "enabled", "hue", "font"}) {
+              if (const base::Value* v = call->input.Find(key)) {
+                value.Set(key, v->Clone());
+              }
+            }
+            value.Set("host", host);
+            std::optional<Boost> boost = Boost::FromValue(value);
+            if (!boost) {
+              return call->Fail("that isn't a boost");
+            }
+            std::string id = service->Set(std::move(*boost));
+            call->Ok(base::Value(
+                base::DictValue().Set("id", id).Set("host", host).Set(
+                    "note",
+                    "Applied to the site's open tabs; JavaScript runs from "
+                    "each page's next load.")));
+          },
+          weak_factory_.GetWeakPtr(), host, remove));
+}
