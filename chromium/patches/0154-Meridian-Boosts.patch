+mojom::BoostPtr ToMojom(const Boost& b) {
+  auto m = mojom::Boost::New();
+  m->id = b.id;
+  m->host = b.host;
+  m->name = b.name;
+  m->enabled = b.enabled;
+  m->css = b.css;
+  m->js = b.js;
+  m->zaps = b.zaps;
+  m->hue = b.hue;
+  m->font = b.font;
+  return m;
+}
+
+}  // namespace
+
+void SidebarHandler::GetBoost(GetBoostCallback callback) {
+  auto state = mojom::BoostState::New();
+  content::WebContents* contents = model()->GetActiveWebContents();
+  Profile* profile = ActiveTabProfile();
+  BoostService* service =
+      profile ? BoostServiceFactory::GetForProfile(profile) : nullptr;
+  if (contents && service) {
+    state->host = BoostHostFor(contents->GetLastCommittedURL());
+    if (const Boost* b = service->ForHost(state->host)) {
+      state->boost = ToMojom(*b);
+    }
+    if (BoostTabHelper* helper = BoostTabHelper::FromWebContents(contents)) {
+      state->zapping = helper->zapping();
+    }
+  }
+  if (AiService* ai = profile ? AiServiceFactory::GetForProfile(profile)
+                              : nullptr) {
+    state->ai_label = ai->CurrentLabel();
+  }
+  std::move(callback).Run(std::move(state));
+}
+
+void SidebarHandler::GetBoosts(GetBoostsCallback callback) {
+  std::vector<mojom::BoostPtr> out;
+  if (BoostService* service =
+          BoostServiceFactory::GetForProfile(browser_->GetProfile())) {
+    for (const Boost& b : service->boosts()) {
+      out.push_back(ToMojom(b));
+    }
+  }
+  std::move(callback).Run(std::move(out));
+}
+
+void SidebarHandler::SetBoost(mojom::BoostPtr boost,
+                              SetBoostCallback callback) {
+  BoostService* service =
+      BoostServiceFactory::GetForProfile(browser_->GetProfile());
+  base::DictValue value = Boost().ToValue();
+  value.Set("id", boost->id);
+  value.Set("host", boost->host);
+  value.Set("name", boost->name);
+  value.Set("enabled", boost->enabled);
+  value.Set("css", boost->css);
+  value.Set("js", boost->js);
+  base::ListValue zaps;
+  for (const std::string& zap : boost->zaps) {
+    zaps.Append(zap);
+  }
+  value.Set("zaps", std::move(zaps));
+  value.Set("hue", boost->hue);
+  value.Set("font", boost->font);
+  std::optional<Boost> b = Boost::FromValue(value);
+  if (!service || !b) {
+    std::move(callback).Run(std::string());
+    return;
+  }
+  std::move(callback).Run(service->Set(std::move(*b)));
+}
+
+void SidebarHandler::DeleteBoost(const std::string& id) {
+  if (BoostService* service =
+          BoostServiceFactory::GetForProfile(browser_->GetProfile())) {
+    service->Remove(id);
+  }
+}
+
+void SidebarHandler::StartZap() {
+  if (content::WebContents* contents = model()->GetActiveWebContents()) {
+    if (BoostTabHelper* helper = BoostTabHelper::FromWebContents(contents)) {
+      contents->Focus();
+      helper->StartZap();
+    }
+  }
+}
+
+void SidebarHandler::ImproveBoost(const std::string& wish,
+                                  ImproveBoostCallback callback) {
+  content::WebContents* contents = model()->GetActiveWebContents();
+  BoostTabHelper* helper =
+      contents ? BoostTabHelper::FromWebContents(contents) : nullptr;
+  if (!helper) {
+    std::move(callback).Run("Only websites can be boosted.", std::string());
+    return;
+  }
+  helper->Improve(
+      wish.substr(0, 2000),
+      base::BindOnce(
+          [](ImproveBoostCallback callback, std::string error,
+             std::string summary) { std::move(callback).Run(error, summary); },
+          std::move(callback)));
+}
