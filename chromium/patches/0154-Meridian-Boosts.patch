diff --git a/chrome/browser/meridian/boosts/boost_service_unittest.cc b/chrome/browser/meridian/boosts/boost_service_unittest.cc
new file mode 100644
index 0000000000..1c9c30cbe2
--- /dev/null
+++ b/chrome/browser/meridian/boosts/boost_service_unittest.cc
@@ -0,0 +1,141 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/boosts/boost_service.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/test/task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+
+namespace {
+
+Boost Make(const std::string& host, const std::string& css) {
+  Boost b;
+  b.host = host;
+  b.name = host;
+  b.css = css;
+  return b;
+}
+
+}  // namespace
+
+TEST(BoostServiceTest, HostsWithoutWwwAndSubdomains) {
+  base::test::TaskEnvironment env;
+  BoostService service{base::FilePath()};
+  service.Set(Make("github.com", "a{}"));
+  service.Set(Make("*", "b{}"));
+  EXPECT_EQ(BoostHostFor(GURL("https://www.GitHub.com/x")), "github.com");
+  EXPECT_EQ(BoostHostFor(GURL("chrome://settings")), "");
+
+  auto found = service.ForUrl(GURL("https://gist.github.com/a"));
+  ASSERT_EQ(found.size(), 2u);
+  // Every-site boosts first, so the site's own come after them.
+  EXPECT_EQ(found[0]->host, "*");
+  EXPECT_EQ(found[1]->host, "github.com");
+  EXPECT_EQ(service.ForUrl(GURL("https://notgithub.com/")).size(), 1u);
+  EXPECT_TRUE(service.ForUrl(GURL("file:///tmp/a.html")).empty());
+}
+
+TEST(BoostServiceTest, OffBoostsDontApply) {
+  base::test::TaskEnvironment env;
+  BoostService service{base::FilePath()};
+  Boost b = Make("example.com", "a{}");
+  b.enabled = false;
+  service.Set(b);
+  EXPECT_TRUE(service.ForUrl(GURL("https://example.com/")).empty());
+  EXPECT_NE(service.ForHost("example.com"), nullptr);
+}
+
+TEST(BoostServiceTest, PageCssHasZapsHueAndFont) {
+  Boost b = Make("example.com", "body{color:red}");
+  b.zaps = {"#ad", ".promo > div"};
+  b.hue = 120;
+  b.font = "Georgia\"; } * { x";
+  std::string css = b.PageCss();
+  EXPECT_NE(css.find("body{color:red}"), std::string::npos);
+  EXPECT_NE(css.find("#ad { display: none !important; }"), std::string::npos);
+  EXPECT_NE(css.find(".promo > div { display: none !important; }"),
+            std::string::npos);
+  EXPECT_NE(css.find("hue-rotate(120deg)"), std::string::npos);
+  // The font name can't close the rule.
+  std::optional<Boost> round = Boost::FromValue(b.ToValue());
+  ASSERT_TRUE(round);
+  EXPECT_TRUE(round->font.starts_with("Georgia"));
+  EXPECT_EQ(round->font.find_first_of("\";{}"), std::string::npos);
+}
+
+TEST(BoostServiceTest, ImportSkipsSitesWithABoost) {
+  base::test::TaskEnvironment env;
+  BoostService service{base::FilePath()};
+  service.Set(Make("github.com", "mine{}"));
+  EXPECT_EQ(service.Import({Make("github.com", "arc{}"),
+                            Make("news.ycombinator.com", "arc{}")}),
+            1);
+  EXPECT_EQ(service.ForHost("github.com")->css, "mine{}");
+  EXPECT_EQ(service.boosts().size(), 2u);
+}
+
+TEST(BoostServiceTest, SavedAndReadBack) {
+  base::test::TaskEnvironment env;
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  {
+    BoostService service(dir.GetPath());
+    env.RunUntilIdle();
+    Boost b = Make("example.com", "a{}");
+    b.zaps = {"#x"};
+    service.Set(b);
+    service.FlushForTesting();
+    env.RunUntilIdle();
+  }
+  BoostService again(dir.GetPath());
+  env.RunUntilIdle();
+  ASSERT_EQ(again.boosts().size(), 1u);
+  EXPECT_EQ(again.boosts()[0].zaps, std::vector<std::string>{"#x"});
+  EXPECT_FALSE(again.boosts()[0].id.empty());
+}
+
+TEST(BoostServiceTest, ReadsArcBoostFolders) {
+  base::ScopedTempDir arc;
+  ASSERT_TRUE(arc.CreateUniqueTempDir());
+  base::FilePath one = arc.GetPath().AppendASCII("boosts").AppendASCII("A1");
+  ASSERT_TRUE(base::CreateDirectory(one));
+  ASSERT_TRUE(base::WriteFile(one.AppendASCII("manifest.json"), R"({
+    "manifest_version": 3, "name": "Quiet GitHub", "version": "1",
+    "content_scripts": [{"matches": ["*://*.github.com/*",
+                                     "https://www.gitlab.com/*"],
+                         "css": ["styles.css"], "js": ["content.js"],
+                         "run_at": "document_end"}],
+  })"));
+  ASSERT_TRUE(base::WriteFile(one.AppendASCII("styles.css"), ".ad{x:y}"));
+  ASSERT_TRUE(base::WriteFile(one.AppendASCII("content.js"), "go()"));
+  // Every site; and one with nothing in it, and one without a manifest.
+  base::FilePath all = arc.GetPath().AppendASCII("boosts").AppendASCII("B2");
+  ASSERT_TRUE(base::CreateDirectory(all));
+  ASSERT_TRUE(base::WriteFile(all.AppendASCII("manifest.json"), R"({
+    "name": "__MSG_name__",
+    "content_scripts": [{"matches": ["<all_urls>"], "css": ["a.css"]}]})"));
+  ASSERT_TRUE(base::WriteFile(all.AppendASCII("a.css"), "*{y:z}"));
+  base::FilePath empty = arc.GetPath().AppendASCII("boosts").AppendASCII("C3");
+  ASSERT_TRUE(base::CreateDirectory(empty));
+  ASSERT_TRUE(base::WriteFile(empty.AppendASCII("manifest.json"), R"({
+    "content_scripts": [{"matches": ["*://x.com/*"], "css": ["gone.css"]}]})"));
+  ASSERT_TRUE(base::CreateDirectory(
+      arc.GetPath().AppendASCII("boosts").AppendASCII("D4")));
+
+  std::vector<Boost> boosts = ReadArcBoosts(arc.GetPath());
+  ASSERT_EQ(boosts.size(), 3u);
+  EXPECT_EQ(boosts[0].host, "github.com");
+  EXPECT_EQ(boosts[0].name, "Quiet GitHub");
+  EXPECT_EQ(boosts[0].css, ".ad{x:y}");
+  EXPECT_EQ(boosts[0].js, "go()");
+  EXPECT_EQ(boosts[1].host, "gitlab.com");
+  EXPECT_EQ(boosts[2].host, "*");
+  EXPECT_EQ(boosts[2].name, "*");
+}
+
+}  // namespace meridian
