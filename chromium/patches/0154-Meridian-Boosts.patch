+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_BOOSTS_BOOST_SERVICE_H_
+#define CHROME_BROWSER_MERIDIAN_BOOSTS_BOOST_SERVICE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/important_file_writer.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/values.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "url/gurl.h"
+
+namespace meridian {
+
+// Arc's Boosts: a site made the way the person likes it. Colours (a hue
+// turn), a font, zapped elements (hidden for good), and their own CSS and
+// JavaScript, on every page of the site.
+struct Boost {
+  Boost();
+  Boost(const Boost&);
+  Boost& operator=(const Boost&);
+  ~Boost();
+
+  std::string id;
+  // The site, without "www." (subdomains too: "github.com" boosts
+  // "gist.github.com"); "*" is every site.
+  std::string host;
+  std::string name;
+  bool enabled = true;
+  std::string css;
+  // Runs in its own world on each page (as an extension's content script),
+  // once the page is parsed.
+  std::string js;
+  // CSS selectors of the zapped elements.
+  std::vector<std::string> zaps;
+  // Degrees the page's colours turn (0: as they are).
+  int hue = 0;
+  // A font for the page's text ("": the site's).
+  std::string font;
+
+  base::DictValue ToValue() const;
+  static std::optional<Boost> FromValue(const base::DictValue& value);
+  // Everything the page gets as CSS: the person's, the zaps, colours, font.
+  std::string PageCss() const;
+};
+
+// The site a boost for `url` is about: its host without "www.", or "" for
+// pages that can't be boosted (not http or https).
+std::string BoostHostFor(const GURL& url);
+
+// The boosts of the person (Arc's are for every profile too), saved in the
+// main profile's "Meridian Boosts.json".
+class BoostService : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnBoostsChanged() = 0;
+    // The profile is going: stop observing.
+    virtual void OnBoostServiceShutdown() = 0;
+  };
+
+  // `profile_path` empty: in memory only.
+  explicit BoostService(const base::FilePath& profile_path);
+  BoostService(const BoostService&) = delete;
+  BoostService& operator=(const BoostService&) = delete;
+  ~BoostService() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  const std::vector<Boost>& boosts() const { return boosts_; }
+  // The site's own boost (not the every-site ones), if it has one.
+  const Boost* ForHost(const std::string& host) const;
+  // The enabled boosts that apply on `url`, every-site ones first.
+  std::vector<const Boost*> ForUrl(const GURL& url) const;
+  // Adds it, or replaces the one with its id. A new one gets an id. Returns
+  // the id.
+  std::string Set(Boost boost);
+  void Remove(const std::string& id);
+  // Boosts brought from Arc: the ones whose site already has a boost here
+  // are skipped. Returns how many were added.
+  int Import(std::vector<Boost> boosts);
+
+  base::ListValue ToValue() const;
+  void FlushForTesting();
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  class Serializer;
+  void OnLoaded(std::optional<std::string> json);
+  void Changed();
+
+  std::vector<Boost> boosts_;
+  std::unique_ptr<Serializer> serializer_;
+  std::unique_ptr<base::ImportantFileWriter> writer_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<BoostService> weak_factory_{this};
+};
+
+// The boosts in Arc's folder ("boosts": one unpacked extension each, its
+// content scripts' CSS and JS for the sites it matches). Blocking: file IO.
+std::vector<Boost> ReadArcBoosts(const base::FilePath& arc_dir);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_BOOSTS_BOOST_SERVICE_H_
