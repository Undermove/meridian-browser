 };
 
+// A Boost (boosts/boost_service.h): a site the person's way.
+struct Boost {
+  string id;
+  // Without "www."; "*" is every site.
+  string host;
+  string name;
+  bool enabled;
+  string css;
+  string js;
+  // CSS selectors of the zapped elements.
+  array<string> zaps;
+  // Degrees the site's colours turn (0: none).
