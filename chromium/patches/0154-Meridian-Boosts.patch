@@ -0,0 +1,420 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/boosts/boost_service.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/memory/raw_ptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/uuid.h"
+#include "url/url_constants.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr base::FilePath::CharType kFileName[] =
+    FILE_PATH_LITERAL("Meridian Boosts.json");
+
+// Larger CSS or JS than this isn't a boost (and isn't kept).
+constexpr size_t kMaxCode = 512 * 1024;
+
+std::optional<std::string> ReadFile(const base::FilePath& path) {
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return std::nullopt;
+  }
+  return json;
+}
+
+std::string WithoutWww(std::string host) {
+  host = base::ToLowerASCII(host);
+  if (host.starts_with("www.")) {
+    host = host.substr(4);
+  }
+  while (!host.empty() && host.back() == '.') {
+    host.pop_back();
+  }
+  return host;
+}
+
+bool Matches(const std::string& boost_host, const std::string& host) {
+  return boost_host == "*" || host == boost_host ||
+         host.ends_with("." + boost_host);
+}
+
+// A font name as CSS can take it in quotes.
+std::string FontName(const std::string& font) {
+  std::string out;
+  for (char c : font) {
+    if (c != '"' && c != '\\' && c != ';' && c != '{' && c != '}' &&
+        c != '<' && c != '>' && c != '\n') {
+      out += c;
+    }
+  }
+  return std::string(base::TrimWhitespaceASCII(out, base::TRIM_ALL));
+}
+
+// "*://*.github.com/*" -> "github.com"; "<all_urls>" -> "*".
+std::string HostOfPattern(const std::string& pattern) {
+  if (pattern == "<all_urls>") {
+    return "*";
+  }
+  size_t scheme = pattern.find("://");
+  if (scheme == std::string::npos) {
+    return std::string();
+  }
+  std::string host = pattern.substr(scheme + 3);
+  host = host.substr(0, host.find('/'));
+  host = host.substr(0, host.find(':'));
+  if (host == "*") {
+    return "*";
+  }
+  if (host.starts_with("*.")) {
+    host = host.substr(2);
+  }
+  if (host.find('*') != std::string::npos) {
+    return std::string();
+  }
+  return WithoutWww(host);
+}
+
+}  // namespace
+
+Boost::Boost() = default;
+Boost::Boost(const Boost&) = default;
+Boost& Boost::operator=(const Boost&) = default;
+Boost::~Boost() = default;
+
+base::DictValue Boost::ToValue() const {
+  base::ListValue zap_list;
+  for (const std::string& zap : zaps) {
+    zap_list.Append(zap);
+  }
+  return base::DictValue()
+      .Set("id", id)
+      .Set("host", host)
+      .Set("name", name)
+      .Set("enabled", enabled)
+      .Set("css", css)
+      .Set("js", js)
+      .Set("zaps", std::move(zap_list))
+      .Set("hue", hue)
+      .Set("font", font);
+}
+
+// static
+std::optional<Boost> Boost::FromValue(const base::DictValue& value) {
+  const std::string* host = value.FindString("host");
+  if (!host || host->empty()) {
+    return std::nullopt;
+  }
+  Boost boost;
+  auto str = [&](const char* key) {
+    const std::string* s = value.FindString(key);
+    return s ? *s : std::string();
+  };
+  boost.id = str("id");
+  boost.host = *host == "*" ? *host : WithoutWww(*host);
+  boost.name = str("name");
+  boost.enabled = value.FindBool("enabled").value_or(true);
+  boost.css = str("css").substr(0, kMaxCode);
+  boost.js = str("js").substr(0, kMaxCode);
+  if (const base::ListValue* zaps = value.FindList("zaps")) {
+    for (const base::Value& zap : *zaps) {
+      if (zap.is_string() && !zap.GetString().empty()) {
+        boost.zaps.push_back(zap.GetString());
+      }
+    }
+  }
+  boost.hue = std::clamp(value.FindInt("hue").value_or(0), 0, 359);
+  boost.font = FontName(str("font"));
+  return boost;
+}
+
+std::string Boost::PageCss() const {
+  std::string out = css;
+  for (const std::string& zap : zaps) {
+    // A selector that isn't one would drop the rest: each zap on its own.
+    out += "\n" + zap + " { display: none !important; }";
+  }
+  if (hue) {
+    // Pictures and video turn back, so only the site's colours change.
+    std::string turn = base::NumberToString(hue);
+    out += "\nhtml { filter: hue-rotate(" + turn + "deg) !important; }" +
+           "\nimg, video, picture, canvas, iframe, svg image, "
+           "[style*=\"background-image\"] { filter: hue-rotate(-" +
+           turn + "deg) !important; }";
+  }
+  if (!font.empty()) {
+    // Not code, and not icon fonts (their names are their glyphs).
+    out += "\nbody, body *:not(pre):not(code):not(kbd):not(samp):not(i):not("
+           "[class*=\"icon\"]):not([class*=\"material\"]):not([class*=\"fa-\"]"
+           ") { font-family: \"" +
+           font + "\", system-ui, sans-serif !important; }";
+  }
+  return out;
+}
+
+std::string BoostHostFor(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.host().empty()) {
+    return std::string();
+  }
+  return WithoutWww(std::string(url.host()));
+}
+
+class BoostService::Serializer
+    : public base::ImportantFileWriter::DataSerializer {
+ public:
+  explicit Serializer(BoostService* service) : service_(service) {}
+  std::optional<std::string> SerializeData() override {
+    return base::WriteJson(service_->ToValue());
+  }
+
+ private:
+  raw_ptr<BoostService> service_;
+};
+
+BoostService::BoostService(const base::FilePath& profile_path)
+    : serializer_(std::make_unique<Serializer>(this)) {
+  if (profile_path.empty()) {
+    return;
+  }
+  scoped_refptr<base::SequencedTaskRunner> file_runner =
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
+  base::FilePath path = profile_path.Append(kFileName);
+  writer_ = std::make_unique<base::ImportantFileWriter>(path, file_runner);
+  file_runner->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ReadFile, path),
+      base::BindOnce(&BoostService::OnLoaded, weak_factory_.GetWeakPtr()));
+}
+
+BoostService::~BoostService() {
+  if (writer_ && writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
+
+void BoostService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void BoostService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void BoostService::OnLoaded(std::optional<std::string> json) {
+  if (!json) {
+    return;
+  }
+  std::optional<base::Value> root = base::JSONReader::Read(*json, 0);
+  if (!root || !root->is_list()) {
+    return;
+  }
+  // Ones made before the file was read stay.
+  std::vector<Boost> loaded;
+  for (const base::Value& v : root->GetList()) {
+    if (!v.is_dict()) {
+      continue;
+    }
+    std::optional<Boost> boost = Boost::FromValue(v.GetDict());
+    if (boost && !boost->id.empty() &&
+        std::ranges::none_of(boosts_, [&](const Boost& b) {
+          return b.id == boost->id;
+        })) {
+      loaded.push_back(std::move(*boost));
+    }
+  }
+  boosts_.insert(boosts_.begin(), loaded.begin(), loaded.end());
+  for (Observer& o : observers_) {
+    o.OnBoostsChanged();
+  }
+}
+
+const Boost* BoostService::ForHost(const std::string& host) const {
+  for (const Boost& boost : boosts_) {
+    if (boost.host == host) {
+      return &boost;
+    }
+  }
+  return nullptr;
+}
+
+std::vector<const Boost*> BoostService::ForUrl(const GURL& url) const {
+  std::string host = BoostHostFor(url);
+  std::vector<const Boost*> out;
+  if (host.empty()) {
+    return out;
+  }
+  for (const Boost& boost : boosts_) {
+    if (boost.enabled && boost.host == "*") {
+      out.push_back(&boost);
+    }
+  }
+  for (const Boost& boost : boosts_) {
+    if (boost.enabled && boost.host != "*" && Matches(boost.host, host)) {
+      out.push_back(&boost);
+    }
+  }
+  return out;
+}
+
+std::string BoostService::Set(Boost boost) {
+  if (boost.id.empty()) {
+    boost.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  std::string id = boost.id;
+  auto it = std::ranges::find(boosts_, id, &Boost::id);
+  if (it != boosts_.end()) {
+    *it = std::move(boost);
+  } else {
+    boosts_.push_back(std::move(boost));
+  }
+  Changed();
+  return id;
+}
+
+void BoostService::Remove(const std::string& id) {
+  if (std::erase_if(boosts_, [&](const Boost& b) { return b.id == id; })) {
+    Changed();
+  }
+}
+
+int BoostService::Import(std::vector<Boost> boosts) {
+  int added = 0;
+  for (Boost& boost : boosts) {
+    if (ForHost(boost.host)) {
+      continue;
+    }
+    boost.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    boosts_.push_back(std::move(boost));
+    ++added;
+  }
+  if (added) {
+    Changed();
+  }
+  return added;
+}
+
+base::ListValue BoostService::ToValue() const {
+  base::ListValue list;
+  for (const Boost& boost : boosts_) {
+    list.Append(boost.ToValue());
+  }
+  return list;
+}
+
+void BoostService::FlushForTesting() {
+  if (writer_ && writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
+
+void BoostService::Shutdown() {
+  for (Observer& o : observers_) {
+    o.OnBoostServiceShutdown();
+  }
+}
+
+void BoostService::Changed() {
+  if (writer_) {
+    writer_->ScheduleWrite(serializer_.get());
+  }
+  for (Observer& o : observers_) {
+    o.OnBoostsChanged();
+  }
+}
+
+std::vector<Boost> ReadArcBoosts(const base::FilePath& arc_dir) {
+  std::vector<Boost> out;
+  if (arc_dir.empty()) {
+    return out;
+  }
+  base::FileEnumerator dirs(arc_dir.AppendASCII("boosts"), false,
+                            base::FileEnumerator::DIRECTORIES);
+  std::vector<base::FilePath> found;
+  for (base::FilePath dir = dirs.Next(); !dir.empty(); dir = dirs.Next()) {
+    found.push_back(dir);
+  }
+  std::ranges::sort(found);
+  for (const base::FilePath& dir : found) {
+    std::string json;
+    if (!base::ReadFileToString(dir.AppendASCII("manifest.json"), &json)) {
+      continue;
+    }
+    std::optional<base::Value> manifest = base::JSONReader::Read(
+        json, base::JSON_ALLOW_TRAILING_COMMAS | base::JSON_ALLOW_COMMENTS);
+    if (!manifest || !manifest->is_dict()) {
+      continue;
+    }
+    const base::ListValue* scripts =
+        manifest->GetDict().FindList("content_scripts");
+    if (!scripts) {
+      continue;
+    }
+    // One boost per site its scripts match, with all their CSS and JS.
+    std::vector<std::string> hosts;
+    std::string css, js;
+    auto read_all = [&](const base::DictValue& script, const char* key,
+                        std::string& into) {
+      const base::ListValue* files = script.FindList(key);
+      if (!files) {
+        return;
+      }
+      for (const base::Value& f : *files) {
+        if (!f.is_string() || f.GetString().find("..") != std::string::npos) {
+          continue;
+        }
+        std::string code;
+        if (base::ReadFileToString(
+                dir.Append(base::FilePath::FromUTF8Unsafe(f.GetString())),
+                &code) &&
+            !code.empty()) {
+          into += (into.empty() ? "" : "\n") + code;
+        }
+      }
+    };
+    for (const base::Value& s : *scripts) {
+      if (!s.is_dict()) {
+        continue;
+      }
+      if (const base::ListValue* matches = s.GetDict().FindList("matches")) {
+        for (const base::Value& m : *matches) {
+          std::string host =
+              m.is_string() ? HostOfPattern(m.GetString()) : std::string();
+          if (!host.empty() && !std::ranges::contains(hosts, host)) {
+            hosts.push_back(host);
+          }
+        }
+      }
+      read_all(s.GetDict(), "css", css);
+      read_all(s.GetDict(), "js", js);
+    }
+    if (css.empty() && js.empty()) {
+      continue;
+    }
+    const std::string* name = manifest->GetDict().FindString("name");
+    for (const std::string& host : hosts) {
+      Boost boost;
+      boost.host = host;
+      boost.name = name && !name->starts_with("__MSG_") ? *name : host;
+      boost.css = css.substr(0, kMaxCode);
+      boost.js = js.substr(0, kMaxCode);
+      out.push_back(std::move(boost));
+    }
+  }
+  return out;
+}
+
+}  // namespace meridian
