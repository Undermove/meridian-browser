+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_BOOSTS_BOOST_TAB_HELPER_H_
+#define CHROME_BROWSER_MERIDIAN_BOOSTS_BOOST_TAB_HELPER_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "chrome/browser/meridian/boosts/boost_service.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace meridian {
+
+// Puts the boosts of a tab's site on its pages: their CSS as the page starts
+// (again once it's parsed, so it comes after the site's own), their
+// JavaScript once it's parsed. A change to a boost restyles the page at
+// once; its JavaScript runs from the next load.
+class BoostTabHelper : public content::WebContentsObserver,
+                       public content::WebContentsUserData<BoostTabHelper>,
+                       public BoostService::Observer {
+ public:
+  BoostTabHelper(const BoostTabHelper&) = delete;
+  BoostTabHelper& operator=(const BoostTabHelper&) = delete;
+  ~BoostTabHelper() override;
+
+  // Zap: the person clicks the things to hide (the one under the pointer is
+  // outlined), Esc or the page's next load ends it. Each one clicked goes
+  // into the site's boost (one is made if the site has none).
+  void StartZap();
+  bool zapping() const { return zap_timer_.IsRunning(); }
+
+  // Improve with AI: the page's outline goes to the AI picked in Settings >
+  // AI with `wish` (or "a calmer page"); its CSS becomes the site's boost.
+  // `done`: an error, or what changed in a sentence.
+  void Improve(const std::string& wish,
+               base::OnceCallback<void(std::string error, std::string summary)>
+                   done);
+
+ private:
+  friend class content::WebContentsUserData<BoostTabHelper>;
+  explicit BoostTabHelper(content::WebContents* contents);
+
+  // content::WebContentsObserver:
+  void PrimaryMainDocumentElementAvailable() override;
+  void DOMContentLoaded(content::RenderFrameHost* frame) override;
+  void PrimaryPageChanged(content::Page& page) override;
+
+  // BoostService::Observer:
+  void OnBoostsChanged() override;
+  void OnBoostServiceShutdown() override;
+
+  BoostService* service();
+  void ApplyCss();
+  void PollZap();
+  void OnZapPicked(base::Value result);
+  void OnOutline(std::string wish,
+                 base::OnceCallback<void(std::string, std::string)> done,
+                 base::Value outline);
+
+  base::ScopedObservation<BoostService, BoostService::Observer> observation_{
+      this};
+  base::RepeatingTimer zap_timer_;
+  base::WeakPtrFactory<BoostTabHelper> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_BOOSTS_BOOST_TAB_HELPER_H_
diff --git a/chrome/browser/meridian/sidebar.mojom b/chrome/browser/meridian/sidebar.mojom
