+TEST(BoostServiceTest, PageCssHasTintDarkSizeAndCase) {
+  Boost b = Make("example.com", "");
+  b.tint = 30;
+  b.tint_strength = 50;
+  b.dark = true;
+  b.size = 110;
+  b.text_case = "lower";
+  b.contrast = 120;
+  std::string css = b.PageCss();
+  EXPECT_NE(css.find("hsl(30 85% 50%)"), std::string::npos);
+  EXPECT_NE(css.find("opacity: 0.5"), std::string::npos);
+  EXPECT_NE(css.find("invert(1) hue-rotate(180deg) contrast(120%)"),
+            std::string::npos);
+  // Pictures undo the dark.
+  EXPECT_NE(css.find("img, video"), std::string::npos);
+  EXPECT_NE(css.find("zoom: 110%"), std::string::npos);
+  EXPECT_NE(css.find("text-transform: lowercase"), std::string::npos);
+  // Read back as it was; nonsense comes back as the site's.
+  std::optional<Boost> round = Boost::FromValue(b.ToValue());
+  ASSERT_TRUE(round);
+  EXPECT_EQ(round->tint, 30);
+  EXPECT_TRUE(round->dark);
+  base::DictValue odd = b.ToValue();
+  odd.Set("text_case", "sideways");
+  odd.Set("size", 5000);
+  round = Boost::FromValue(odd);
+  EXPECT_EQ(round->text_case, "");
+  EXPECT_EQ(round->size, 200);
+  // Nothing set: no look at all.
+  EXPECT_EQ(Make("example.com", "").PageCss(), "");
+}
