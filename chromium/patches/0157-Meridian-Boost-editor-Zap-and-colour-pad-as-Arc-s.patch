+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  position: fixed;
+  top: 18px;
+  right: 18px;
+  z-index: 94;
+  display: none;
+  color: var(--meridian-text);
+  font-size: 13px;
+}
+
+:host([open]) {
+  display: block;
+}
+
+button {
+  border: 0;
+  background: none;
+  font: inherit;
+  color: inherit;
+  padding: 0;
+  cursor: pointer;
+  text-align: left;
+}
+
+button:disabled {
+  cursor: default;
+  opacity: 0.55;
+}
+
+svg {
+  display: block;
+}
+
+#card {
+  width: 252px;
+  max-height: calc(100vh - 36px);
+  overflow-y: auto;
+  padding: 10px;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  border-radius: 16px;
+  background: color-mix(in srgb, var(--meridian-surface) 97%, var(--meridian-space));
+  backdrop-filter: blur(24px) saturate(1.6);
+  box-shadow: 0 0 0 0.5px var(--meridian-border),
+      0 16px 48px rgba(0, 0, 0, 0.22), 0 2px 8px rgba(0, 0, 0, 0.08);
+  animation: slide 0.16s cubic-bezier(0.2, 0.8, 0.2, 1);
+  user-select: none;
+}
+
+@keyframes slide {
+  from {
+    opacity: 0;
+    transform: translateX(12px);
+  }
+}
+
+.head {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.ic {
+  width: 26px;
+  height: 26px;
+  flex: none;
+  display: grid;
+  place-items: center;
+  border-radius: 8px;
+  color: var(--meridian-text-muted);
+}
+
+.ic:hover {
+  background: color-mix(in srgb, var(--meridian-text) 8%, transparent);
+  color: var(--meridian-text);
+}
+
+.name {
+  flex: 1;
+  min-width: 0;
+  border: 0;
+  border-radius: 7px;
+  padding: 4px 6px;
+  background: none;
+  color: inherit;
+  font: inherit;
+  font-weight: 650;
+  text-align: center;
+  outline: none;
+}
+
+.name:hover,
+.name:focus {
+  background: color-mix(in srgb, var(--meridian-text) 7%, transparent);
+}
+
+.bswitch {
+  display: flex;
+  flex: none;
+  padding: 4px;
+}
+
+.switch {
+  position: relative;
+  width: 30px;
+  height: 18px;
+  border-radius: 9px;
+  background: color-mix(in srgb, var(--meridian-text) 18%, transparent);
+  transition: background 0.15s;
+}
+
+.switch i {
+  position: absolute;
+  top: 2px;
+  left: 2px;
+  width: 14px;
+  height: 14px;
+  border-radius: 50%;
+  background: white;
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
+  transition: transform 0.15s;
+}
+
+.bswitch.on .switch {
+  background: var(--meridian-space);
+}
+
+.bswitch.on .switch i {
+  transform: translateX(12px);
+}
+
+/* As Arc's: a rim of the hues (red at the top, clockwise) around a dotted
+ * field, tinted where the knob is. */
+.pad {
+  position: relative;
+  aspect-ratio: 1 / 0.92;
+  padding: 6px;
+  box-sizing: border-box;
+  border-radius: 20px;
+  background: conic-gradient(hsl(0 90% 62%), hsl(45 95% 58%),
+      hsl(90 80% 52%), hsl(150 75% 50%), hsl(195 85% 55%),
+      hsl(240 85% 64%), hsl(285 80% 62%), hsl(330 85% 62%), hsl(360 90% 62%));
+  cursor: pointer;
+  touch-action: none;
+}
+
+.field {
+  position: relative;
+  height: 100%;
+  border-radius: 14px;
+  background:
+      radial-gradient(circle,
+          color-mix(in srgb, var(--meridian-text) 16%, transparent) 0.9px,
+          transparent 1.3px) 0 0 / 11px 11px,
+      var(--wash, none),
+      var(--meridian-surface);
+  box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.08);
+}
+
+.knob {
+  position: absolute;
+  width: 32px;
+  height: 32px;
+  margin: -16px 0 0 -16px;
+  border-radius: 50%;
+  border: 3px solid white;
+  box-sizing: border-box;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3), 0 0 0 0.5px rgba(0, 0, 0, 0.12);
+  pointer-events: none;
+  transition: left 0.45s cubic-bezier(0.3, 1.35, 0.5, 1),
+      top 0.45s cubic-bezier(0.3, 1.35, 0.5, 1),
+      background 0.3s, opacity 0.3s, transform 0.15s;
+}
+
+.knob.shade {
+  width: 18px;
+  height: 18px;
+  margin: -9px 0 0 -9px;
+  border-width: 2px;
+  transition-duration: 0.6s, 0.6s, 0.3s, 0.3s, 0.15s;
+}
+
+.pad.drag .knob {
+  transition: background 0.1s, transform 0.15s;
+}
+
+.pad.drag #knob {
+  transform: scale(1.12);
+}
+
+.tiles {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 6px;
+}
+
+.tile {
+  height: 40px;
+  display: grid;
+  place-items: center;
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--meridian-text) 7%, transparent);
+}
+
+.tile:hover {
+  background: color-mix(in srgb, var(--meridian-text) 11%, transparent);
+}
+
+.tile.on {
+  background: var(--meridian-space);
+  color: white;
+}
+
+.adjust {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding: 2px 4px;
+  font-size: 12px;
+  color: var(--meridian-text-muted);
+}
+
+.adjust label {
+  display: grid;
+  grid-template-columns: 74px 1fr;
+  align-items: center;
+}
+
+.adjust input {
+  width: 100%;
+  accent-color: var(--meridian-space);
+}
+
+.fonts {
+  display: grid;
+  grid-template-columns: repeat(5, 1fr);
+  gap: 2px;
+  padding: 6px;
+  border-radius: 12px;
+  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--meridian-text) 9%, transparent);
+}
+
+.font {
+  height: 32px;
+  border-radius: 8px;
+  text-align: center;
+  font-size: 15px;
+  color: var(--meridian-text-muted);
+}
+
+.font:hover {
+  background: color-mix(in srgb, var(--meridian-text) 7%, transparent);
+  color: var(--meridian-text);
+}
+
+.font.on {
+  background: color-mix(in srgb, var(--meridian-space) 22%, transparent);
+  color: var(--meridian-text);
+}
+
+.pair {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 6px;
+}
+
+.tile.wide {
+  display: flex;
+  justify-content: center;
+  gap: 6px;
+  font-weight: 600;
+}
+
+.val {
+  font-weight: 500;
+  opacity: 0.75;
+}
+
+.line {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  height: 40px;
+  padding: 0 12px;
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--meridian-text) 7%, transparent);
+  font-weight: 600;
+}
+
+.line:hover {
+  background: color-mix(in srgb, var(--meridian-text) 11%, transparent);
+}
+
+.line.on {
+  box-shadow: inset 0 0 0 1.5px var(--meridian-space);
+}
+
+.grow {
+  flex: 1;
+}
+
+.count {
+  font-weight: 500;
+  color: var(--meridian-text-muted);
+}
+
+.zap {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: -4px;
+  padding: 2px 4px 2px 12px;
+  font: 11px ui-monospace, Menlo, monospace;
+  color: var(--meridian-text-muted);
+}
+
+.zap span {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.zap-x {
+  width: 20px;
+  height: 20px;
+  display: grid;
+  place-items: center;
+  border-radius: 6px;
+}
+
+.zap-x:hover {
+  background: color-mix(in srgb, var(--meridian-text) 10%, transparent);
+}
+
+.code,
+.improve {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.code-label {
+  font-size: 11px;
+  font-weight: 600;
+  color: var(--meridian-text-muted);
+}
+
+.code-label span {
+  font-weight: 400;
+}
+
+textarea {
+  box-sizing: border-box;
+  width: 100%;
+  resize: vertical;
+  border: 0;
+  border-radius: 9px;
+  padding: 7px 9px;
+  background: color-mix(in srgb, var(--meridian-text) 6%, transparent);
+  color: inherit;
+  font: inherit;
+  outline: none;
+  user-select: text;
+}
+
+textarea:focus {
+  box-shadow: inset 0 0 0 1.5px var(--meridian-space);
+}
+
+#css,
+#js {
+  min-height: 80px;
+  font: 11.5px ui-monospace, Menlo, monospace;
+}
+
+.primary {
+  height: 32px;
+  border-radius: 9px;
+  text-align: center;
+  background: var(--meridian-space);
+  color: white;
+  font-weight: 600;
+}
+
+.note {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  font-size: 12px;
+  color: var(--meridian-text-muted);
+}
+
+.note.err {
+  color: #e5484d;
+}
+
+.note span {
+  flex: 1;
+}
+
+.link {
+  color: var(--meridian-space);
+  font-weight: 600;
+}
+
+.line.danger {
+  background: none;
+  color: var(--meridian-text-muted);
+  font-weight: 500;
+}
+
+.line.danger:hover,
+.line.danger.confirm {
+  background: color-mix(in srgb, #e5484d 12%, transparent);
+  color: #e5484d;
+}
