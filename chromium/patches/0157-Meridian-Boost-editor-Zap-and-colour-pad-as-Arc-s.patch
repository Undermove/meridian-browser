@@ -0,0 +1,132 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianBoostEditorElement} from './boost_editor.js';
+import {icon} from './icons.js';
+
+export function getHtml(this: MeridianBoostEditorElement) {
+  return html`<!--_html_template_start_-->
+${this.boost_ ? html`
+<div id="card" role="dialog" aria-label="Boost" @keydown="${this.onCardKeydown_}">
+  <div class="head">
+    <button id="close" class="ic" title="Close" @click="${this.onCloseClick_}">
+      ${icon('x', 14)}</button>
+    <input id="name" class="name" .value="${this.nameValue_()}"
+        spellcheck="false" maxlength="40" aria-label="Boost name"
+        @change="${this.onNameChange_}">
+    <button id="enabled" class="bswitch ${this.boost_.enabled ? 'on' : ''}"
+        title="${this.enabledTitle_()}" @click="${this.onEnabledClick_}">
+      <span class="switch"><i></i></span>
+    </button>
+    <button id="reset" class="ic" title="Back to the site’s look"
+        @click="${this.onResetClick_}">${icon('history', 15)}</button>
+  </div>
+
+  <div id="pad" class="pad ${this.dragging_ ? 'drag' : ''}" title="Colour"
+      @pointerdown="${this.onPadPointerdown_}">
+    <div class="field" style="${this.washStyle_()}">
+      <div id="shade" class="knob shade" style="${this.shadeStyle_()}"></div>
+      <div id="knob" class="knob" style="${this.knobStyle_()}"></div>
+    </div>
+  </div>
+  <div class="tiles">
+    <button id="dark" class="tile ${this.boost_.dark ? 'on' : ''}"
+        title="Dark or light" @click="${this.onDarkClick_}">
+      ${icon('moon', 17)}</button>
+    <button id="adjust" class="tile ${this.adjustOpen_ ? 'on' : ''}"
+        title="Brightness, contrast, saturation"
+        @click="${this.onAdjustClick_}">${icon('sliders', 17)}</button>
+    <button id="noColour" class="tile" title="No colour"
+        @click="${this.onNoColourClick_}">${icon('ban', 17)}</button>
+  </div>
+  ${this.adjustOpen_ ? html`
+    <div class="adjust">
+      <label>Brightness<input id="brightness" type="range" min="50"
+          max="150" data-key="brightness"
+          .value="${this.adjustValue_('brightness')}"
+          @input="${this.onAdjustInput_}"></label>
+      <label>Contrast<input id="contrast" type="range" min="50" max="150"
+          data-key="contrast" .value="${this.adjustValue_('contrast')}"
+          @input="${this.onAdjustInput_}"></label>
+      <label>Saturation<input id="saturation" type="range" min="0"
+          max="200" data-key="saturation"
+          .value="${this.adjustValue_('saturation')}"
+          @input="${this.onAdjustInput_}"></label>
+    </div>` : ''}
+
+  <div class="fonts">
+    ${this.fonts_.map(f => html`
+      <button class="font ${f.on ? 'on' : ''}" data-font="${f.name}"
+          title="${f.name}" style="font-family:'${f.name}'"
+          @click="${this.onFontClick_}">Aa</button>`)}
+  </div>
+
+  <div class="pair">
+    <button id="size" class="tile wide ${this.boost_.size !== 100 ? 'on' : ''}"
+        title="Size" @click="${this.onSizeClick_}">
+      <span>Size</span><span class="val">${this.sizeLabel_()}</span>
+    </button>
+    <button id="case" class="tile wide ${this.boost_.textCase ? 'on' : ''}"
+        title="${this.caseTitle_()}" @click="${this.onCaseClick_}">
+      ${this.caseLabel_()}</button>
+  </div>
+
+  <button id="zap" class="line ${this.zapping_ ? 'on' : ''}"
+      @click="${this.onZapClick_}">
+    ${icon('bolt', 15)}<span class="grow">${this.zapLabel_()}</span>
+    <span class="count">${this.zapCount_()}</span>
+  </button>
+  ${this.boost_.zaps.map((z, i) => html`
+    <div class="zap">
+      <span title="${z}">${z}</span>
+      <button class="zap-x" data-index="${i}" title="Show it again"
+          @click="${this.onZapRemoveClick_}">${icon('x', 12)}</button>
+    </div>`)}
+
+  <button id="code" class="line ${this.codeOpen_ ? 'on' : ''}"
+      @click="${this.onCodeClick_}">
+    ${icon('code', 15)}<span class="grow">Code</span>
+    <span class="count">{ }</span>
+  </button>
+  ${this.codeOpen_ ? html`
+    <div class="code">
+      <div class="code-label">CSS</div>
+      <textarea id="css" spellcheck="false"
+          .value="${this.boost_.css}"></textarea>
+      <div class="code-label">JavaScript
+        <span>runs from the next load</span></div>
+      <textarea id="js" spellcheck="false" .value="${this.boost_.js}"></textarea>
+      <button id="codeSave" class="primary" @click="${this.onCodeSaveClick_}">
+        Save</button>
+    </div>` : ''}
+
+  <button id="improveToggle" class="line ${this.improveOpen_ ? 'on' : ''}"
+      @click="${this.onImproveToggleClick_}">
+    ${icon('sparkles', 15)}<span class="grow">Improve with AI</span>
+  </button>
+  ${this.improveOpen_ ? html`
+    <div class="improve">
+      <textarea id="wish" rows="2"
+          placeholder="What to change? Empty: less clutter"></textarea>
+      <button id="improve" class="primary"
+          ?disabled="${this.improving_ || !this.aiLabel_}"
+          @click="${this.onImproveClick_}">${this.improveLabel_()}</button>
+      ${this.note_ ? html`
+        <div id="note" class="note ${this.noteError_ ? 'err' : ''}">
+          <span>${this.note_}</span>
+          ${this.canUndo_ ? html`
+            <button id="undo" class="link" @click="${this.onUndoClick_}">
+              Undo</button>` : ''}
+        </div>` : ''}
+    </div>` : ''}
+
+  <button id="delete" class="line danger ${this.confirmDelete_ ? 'confirm' : ''}"
+      @click="${this.onDeleteClick_}">
+    ${icon('trash', 15)}<span class="grow">${this.deleteLabel_()}</span>
+  </button>
+</div>` : ''}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/boost_editor.ts b/chrome/browser/resources/webui_browser/meridian/boost_editor.ts
new file mode 100644
index 0000000000..fe71a690f4
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/boost_editor.ts
@@ -0,0 +1,511 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The Boost editor, as Arc's: a card at the right of the page for one of the
+// site's boosts. A colour over the page (picked on a pad), dark or light,
+// brightness and contrast, a font, the text's size and case, Zap, its own
+// code, and Improve with the AI from Settings > AI. Every change shows on the
+// page at once.
+
+import {isWindows} from '//resources/js/platform.js';
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {Boost, SidebarHandlerInterface} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './boost_editor.css.js';
+import {getHtml} from './boost_editor.html.js';
+
+// A font as the grid shows it.
+export interface BoostFont {
+  name: string;
+  on: boolean;
+}
+
+// Fonts every Mac (or Windows) has ("system-ui": the system's own).
+const MAC_FONTS = [
+  'system-ui',        'Helvetica Neue', 'Avenir Next',     'Futura',
+  'Gill Sans',        'Optima',         'Georgia',         'Palatino',
+  'Baskerville',      'Didot',          'Iowan Old Style', 'Charter',
+  'Hoefler Text',     'Rockwell',       'American Typewriter',
+  'Courier New',      'Menlo',          'Marker Felt',     'Chalkboard SE',
+  'Snell Roundhand',
+];
+const WINDOWS_FONTS = [
+  'system-ui',         'Segoe UI',      'Arial',           'Calibri',
+  'Candara',           'Corbel',        'Georgia',         'Palatino Linotype',
+  'Book Antiqua',      'Cambria',       'Constantia',      'Times New Roman',
+  'Bahnschrift',       'Franklin Gothic Medium',           'Trebuchet MS',
+  'Verdana',           'Consolas',      'Courier New',     'Comic Sans MS',
+  'Segoe Print',
+];
+const FONTS = isWindows ? WINDOWS_FONTS : MAC_FONTS;
+
+// Size goes round these (percent).
+const SIZES = [100, 110, 125, 90];
+const CASES = ['', 'lower', 'upper'];
+
+export class MeridianBoostEditorElement extends CrLitElement {
+  static get is() {
+    return 'meridian-boost-editor';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      url: {type: String},
+      boost_: {state: true, type: Object},
+      fonts_: {state: true, type: Array},
+      aiLabel_: {state: true, type: String},
+      adjustOpen_: {state: true, type: Boolean},
+      codeOpen_: {state: true, type: Boolean},
+      improveOpen_: {state: true, type: Boolean},
+      improving_: {state: true, type: Boolean},
+      zapping_: {state: true, type: Boolean},
+      note_: {state: true, type: String},
+      noteError_: {state: true, type: Boolean},
+      canUndo_: {state: true, type: Boolean},
+      confirmDelete_: {state: true, type: Boolean},
+      dragging_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  // The active tab's address: another site closes the editor.
+  accessor url: string = '';
+  protected accessor boost_: Boost|null = null;
+  protected accessor fonts_: BoostFont[] = [];
+  // Who Improve asks ("" when no AI is set up).
+  protected accessor aiLabel_: string = '';
+  protected accessor adjustOpen_: boolean = false;
+  protected accessor codeOpen_: boolean = false;
+  protected accessor improveOpen_: boolean = false;
+  protected accessor improving_: boolean = false;
+  protected accessor zapping_: boolean = false;
+  // What Improve did, or why it couldn't.
+  protected accessor note_: string = '';
+  protected accessor noteError_: boolean = false;
+  protected accessor canUndo_: boolean = false;
+  protected accessor confirmDelete_: boolean = false;
+  // The colour knob is held: it follows the pointer without easing.
+  protected accessor dragging_: boolean = false;
+
+  private handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  private host_: string = '';
+  // The boost before Improve, for Undo.
+  private before_: Boost|null = null;
+  // Changes made while one is being saved go in the next save.
+  private dirty_: boolean = false;
+  private saving_: boolean = false;
+  private zapTimer_: number = 0;
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    clearInterval(this.zapTimer_);
+  }
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    if (changed.has('url') && this.open) {
+      this.checkSite_();
+    }
+    const changedPrivate = changed as Map<PropertyKey, unknown>;
+    if (changedPrivate.has('boost_')) {
+      this.fonts_ = FONTS.map(
+          name => ({name, on: (this.boost_?.font || '') === name}));
+    }
+  }
+
+  // Opens on the boost `id` of the active tab's site; "" makes a new one.
+  async show(id: string) {
+    const {state} = await this.handler_.getBoost();
+    if (!state.host) {
+      return;
+    }
+    this.host_ = state.host;
+    this.aiLabel_ = state.aiLabel;
+    let boost = state.boosts.find(b => b.id === id) || null;
+    if (!boost) {
+      boost = {
+        id: '',
+        host: state.host,
+        name: state.boosts.length ? `Boost ${state.boosts.length + 1}` :
+                                    'My Boost',
+        enabled: true,
+        css: '',
+        js: '',
+        zaps: [],
+        hue: 0,
+        font: '',
+        tint: -1,
+        tintStrength: 60,
+        dark: false,
+        brightness: 100,
+        contrast: 100,
+        saturation: 100,
+        size: 100,
+        textCase: '',
+      };
+      const {id: made} = await this.handler_.setBoost(boost);
+      boost = {...boost, id: made};
+    }
+    this.boost_ = boost;
+    this.adjustOpen_ = false;
+    this.codeOpen_ = !!(boost.css || boost.js);
+    this.improveOpen_ = false;
+    this.note_ = '';
+    this.canUndo_ = false;
+    this.confirmDelete_ = false;
+    this.open = true;
+  }
+
+  close() {
+    this.open = false;
+    this.stopZapWatch_();
+    this.fire('boost-editor-closed');
+  }
+
+  private async checkSite_() {
+    const {state} = await this.handler_.getBoost();
+    if (state.host !== this.host_) {
+      this.close();
+    }
+  }
+
+  // ------------------------------------------------------------ Saving
+
+  private change_(change: Partial<Boost>) {
+    if (!this.boost_) {
+      return;
+    }
+    this.boost_ = {...this.boost_, ...change};
+    this.dirty_ = true;
+    this.flush_();
+  }
+
+  // One save at a time, each with everything changed so far: a drag on the
+  // pad is many changes and one boost.
+  private async flush_() {
+    if (this.saving_) {
+      return;
+    }
+    this.saving_ = true;
+    while (this.dirty_ && this.boost_) {
+      this.dirty_ = false;
+      await this.handler_.setBoost(this.boost_);
+    }
+    this.saving_ = false;
+  }
+
+  private async reload_() {
+    const {state} = await this.handler_.getBoost();
+    const fresh = state.boosts.find(b => b.id === this.boost_?.id);
+    if (fresh && !this.dirty_) {
+      this.boost_ = fresh;
+    }
+    this.aiLabel_ = state.aiLabel;
+    return state;
+  }
+
+  // ------------------------------------------------------------ Template
+
+  protected nameValue_(): string {
+    return this.boost_?.name || '';
+  }
+
+  protected enabledTitle_(): string {
+    return this.boost_?.enabled ? 'Turn off' : 'Turn on';
+  }
+
+  // The pad, as Arc's: the hues around its rim, the colour's knob at the
+  // hue's angle from the middle, further out for more colour; a small knob
+  // opposite it shows the dark of the page in that colour.
+  protected knobStyle_(): string {
+    const b = this.boost_;
+    if (!b || b.tint < 0) {
+      return 'left:50%;top:50%;background:var(--meridian-surface)';
+    }
+    const [x, y] = this.knobAt_(b);
+    return `left:${x}%;top:${y}%;background:hsl(${b.tint} 85% 62%)`;
+  }
+
+  protected shadeStyle_(): string {
+    const b = this.boost_;
+    if (!b || b.tint < 0) {
+      return 'left:50%;top:50%;opacity:0';
+    }
+    const [x, y] = this.knobAt_(b);
+    return `left:${100 - x}%;top:${100 - y}%;` +
+        `background:hsl(${b.tint} ${Math.round(b.tintStrength * 0.5)}% 16%)`;
+  }
+
+  protected washStyle_(): string {
+    const b = this.boost_;
+    if (!b || b.tint < 0) {
+      return '';
+    }
+    const [x, y] = this.knobAt_(b);
+    return `--wash:radial-gradient(circle at ${x}% ${y}%, ` +
+        `hsl(${b.tint} 90% 65% / ${0.12 + b.tintStrength / 300}), ` +
+        `transparent 75%)`;
+  }
+
+  // Where the knob is, in percent of the pad's field: the edge of the square
+  // is full colour.
+  private knobAt_(b: Boost): [number, number] {
+    const a = b.tint * Math.PI / 180;
+    const vx = Math.sin(a);
+    const vy = -Math.cos(a);
+    const r = b.tintStrength / 2 / Math.max(Math.abs(vx), Math.abs(vy));
+    return [50 + vx * r, 50 + vy * r];
+  }
+
+  protected adjustValue_(key: 'brightness'|'contrast'|'saturation'): string {
+    return String(this.boost_?.[key] ?? 100);
+  }
+
+  protected sizeLabel_(): string {
+    return `${this.boost_?.size || 100}%`;
+  }
+
+  protected caseLabel_(): string {
+    const c = this.boost_?.textCase || '';
+    return c === 'lower' ? 'aa' : c === 'upper' ? 'AA' : 'Aa';
+  }
+
+  protected caseTitle_(): string {
+    const c = this.boost_?.textCase || '';
+    return c === 'lower' ? 'Lower case' :
+        c === 'upper'    ? 'Upper case' :
+                           'Text as the site has it';
+  }
+
+  protected zapCount_(): string {
+    return String(this.boost_?.zaps.length || 0);
+  }
+
+  protected zapLabel_(): string {
+    return this.zapping_ ? 'Zapping… Esc to stop' : 'Zap';
+  }
+
+  protected improveLabel_(): string {
+    if (this.improving_) {
+      return 'Improving…';
+    }
+    return this.aiLabel_ ? `Improve with ${this.aiLabel_}` :
+                           'Set up an AI in Settings';
+  }
+
+  protected deleteLabel_(): string {
+    return this.confirmDelete_ ? 'Click again to delete' : 'Delete boost';
+  }
+
+  // ------------------------------------------------------------ Events
+
+  protected onCloseClick_() {
+    this.close();
+  }
+
+  protected onCardKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      this.close();
+    }
+  }
+
+  protected onNameChange_(e: Event) {
+    const name = (e.target as HTMLInputElement).value.trim();
+    this.change_({name: name || 'My Boost'});
+  }
+
+  protected onEnabledClick_() {
+    this.change_({enabled: !this.boost_?.enabled});
+  }
+
+  // Back to the site's look; zaps and code stay.
+  protected onResetClick_() {
+    this.change_({
+      hue: 0,
+      font: '',
+      tint: -1,
+      dark: false,
+      brightness: 100,
+      contrast: 100,
+      saturation: 100,
+      size: 100,
+      textCase: '',
+    });
+  }
+
+  protected onPadPointerdown_(e: PointerEvent) {
+    const pad = e.currentTarget as HTMLElement;
+    const field = pad.querySelector<HTMLElement>('.field')!;
+    pad.setPointerCapture(e.pointerId);
+    this.pickColour_(field, e);
+    // A click glides the knob over; a drag holds it under the pointer.
+    const move = (ev: PointerEvent) => {
+      this.dragging_ = true;
+      this.pickColour_(field, ev);
+    };
+    const up = () => {
+      this.dragging_ = false;
+      pad.removeEventListener('pointermove', move);
+      pad.removeEventListener('pointerup', up);
+      pad.removeEventListener('pointercancel', up);
+    };
+    pad.addEventListener('pointermove', move);
+    pad.addEventListener('pointerup', up);
+    pad.addEventListener('pointercancel', up);
+  }
+
+  // The hue is the angle from the middle (red at the top, clockwise, as the
+  // rim), the amount of colour how far out.
+  private pickColour_(field: HTMLElement, e: PointerEvent) {
+    const r = field.getBoundingClientRect();
+    const dx = Math.min(0.5, Math.max(-0.5, (e.clientX - r.left) / r.width - 0.5));
+    const dy = Math.min(0.5, Math.max(-0.5, (e.clientY - r.top) / r.height - 0.5));
+    const hue = (Math.atan2(dx, -dy) * 180 / Math.PI + 360) % 360;
+    this.change_({
+      tint: Math.round(hue) % 360,
+      tintStrength: Math.round(Math.max(Math.abs(dx), Math.abs(dy)) * 200),
+    });
+  }
+
+  protected onDarkClick_() {
+    this.change_({dark: !this.boost_?.dark});
+  }
+
+  protected onAdjustClick_() {
+    this.adjustOpen_ = !this.adjustOpen_;
+  }
+
+  protected onNoColourClick_() {
+    this.change_({tint: -1, hue: 0});
+  }
+
+  protected onAdjustInput_(e: Event) {
+    const input = e.target as HTMLInputElement;
+    const key = input.dataset['key'] as 'brightness' | 'contrast' |
+        'saturation';
+    this.change_({[key]: Number(input.value)});
+  }
+
+  protected onFontClick_(e: Event) {
+    const font = (e.currentTarget as HTMLElement).dataset['font'] || '';
+    this.change_({font: this.boost_?.font === font ? '' : font});
+  }
+
+  protected onSizeClick_() {
+    const at = SIZES.indexOf(this.boost_?.size || 100);
+    this.change_({size: SIZES[(at + 1) % SIZES.length]});
+  }
+
+  protected onCaseClick_() {
+    const at = CASES.indexOf(this.boost_?.textCase || '');
+    this.change_({textCase: CASES[(at + 1) % CASES.length]});
+  }
+
+  // Zap: the page takes clicks on what to hide; the count follows.
+  protected onZapClick_() {
+    if (!this.boost_) {
+      return;
+    }
+    this.handler_.startZap(this.boost_.id);
+    this.zapping_ = true;
+    clearInterval(this.zapTimer_);
+    this.zapTimer_ = window.setInterval(async () => {
+      const state = await this.reload_();
+      if (!state.zapping) {
+        this.stopZapWatch_();
+      }
+    }, 400);
+  }
+
+  private stopZapWatch_() {
+    clearInterval(this.zapTimer_);
+    this.zapTimer_ = 0;
+    this.zapping_ = false;
+  }
+
+  protected onZapRemoveClick_(e: Event) {
+    const index = Number((e.currentTarget as HTMLElement).dataset['index']);
+    const zaps = [...(this.boost_?.zaps || [])];
+    zaps.splice(index, 1);
+    this.change_({zaps});
+  }
+
+  protected onCodeClick_() {
+    this.codeOpen_ = !this.codeOpen_;
+  }
+
+  protected onCodeSaveClick_() {
+    const css = this.shadowRoot.querySelector<HTMLTextAreaElement>('#css');
+    const js = this.shadowRoot.querySelector<HTMLTextAreaElement>('#js');
+    this.change_({css: css?.value || '', js: js?.value || ''});
+  }
+
+  protected async onImproveToggleClick_() {
+    this.improveOpen_ = !this.improveOpen_;
+    // An AI set up since the editor opened.
+    await this.reload_();
+  }
+
+  protected async onImproveClick_() {
+    if (!this.boost_) {
+      return;
+    }
+    const wish = this.shadowRoot.querySelector<HTMLTextAreaElement>('#wish');
+    this.before_ = {...this.boost_};
+    this.improving_ = true;
+    this.note_ = '';
+    this.canUndo_ = false;
+    const {error, summary} = await this.handler_.improveBoost(
+        this.boost_.id, wish?.value.trim() || '');
+    this.improving_ = false;
+    this.noteError_ = !!error;
+    this.note_ = error || summary;
+    this.canUndo_ = !error;
+    await this.reload_();
+  }
+
+  protected async onUndoClick_() {
+    if (this.before_) {
+      this.boost_ = this.before_;
+      await this.handler_.setBoost(this.before_);
+    }
+    this.canUndo_ = false;
+    this.note_ = 'Undone.';
+    this.noteError_ = false;
+  }
+
+  protected async onDeleteClick_() {
+    if (!this.confirmDelete_) {
+      this.confirmDelete_ = true;
+      return;
+    }
+    if (this.boost_) {
+      await this.handler_.deleteBoost(this.boost_.id);
+    }
+    this.boost_ = null;
+    this.close();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-boost-editor': MeridianBoostEditorElement;
+  }
+}
+
+customElements.define(
+    MeridianBoostEditorElement.is, MeridianBoostEditorElement);
