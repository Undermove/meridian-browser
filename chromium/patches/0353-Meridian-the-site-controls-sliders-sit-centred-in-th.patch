From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Fri, 27 Nov 2026 11:01:09 +0400
Subject: [PATCH] Meridian: the site controls' sliders sit centred in their
 square

The sliders at the end of the URL pill are a cr-button; their glyph sat on
the baseline of cr-button's 20px text line, 2.5px above the middle of the
hover square, so the square looked pushed against the pill's edge. The
glyph is now a block centred by the square (4px from the pill's top,
bottom and right, as from Copy Link), and cr-button's own hover layer and
ripple are off so both end buttons hover and press alike.

Test: node --test chrome/browser/resources/webui_browser/meridian/layout_tests/url_pill.test.mjs
(real app.css + cr_button.css in headless Google Chrome; light/dark,
rest/hover/pressed, 1x/2x, sidebar and Windows top bar).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../browser/resources/webui_browser/app.css   |  15 ++
 .../meridian/layout_tests/url_pill.test.mjs   | 221 ++++++++++++++++++
 2 files changed, 236 insertions(+)
 create mode 100644 chrome/browser/resources/webui_browser/meridian/layout_tests/url_pill.test.mjs

diff --git a/chrome/browser/resources/webui_browser/app.css b/chrome/browser/resources/webui_browser/app.css
index c8628fc3d2..8cb16831e1 100644
--- a/chrome/browser/resources/webui_browser/app.css
+++ b/chrome/browser/resources/webui_browser/app.css
@@ -298,10 +298,21 @@ cr-icon-button {
   background: transparent;
   --cr-button-background-color: transparent;
   --cr-button-text-color: var(--meridian-text-muted);
+  /* The sliders are a cr-button: its own hover layer and ripple would stack
+     on the square below, darker than Copy Link's. One look for both. */
+  --cr-hover-background-color: transparent;
+  --cr-button-ripple-opacity: 0;
   app-region: no-drag;
   -webkit-app-region: no-drag;
 }
 
+/* The glyph is a box of its own, centred by the flex square. Inline, inside
+   cr-button's 20px text line, it sat on the baseline: 2.5px above the middle. */
+.pill-btn svg {
+  display: block;
+  flex: none;
+}
+
 .pill-btn[hidden] {
   display: none;
 }
@@ -311,6 +322,10 @@ cr-icon-button {
   background: color-mix(in srgb, var(--meridian-text) 8%, transparent);
 }
 
+.pill-btn:active {
+  background: color-mix(in srgb, var(--meridian-text) 14%, transparent);
+}
+
 #urlPill:not(:hover) #copyLinkButton {
   opacity: 0;
 }
diff --git a/chrome/browser/resources/webui_browser/meridian/layout_tests/url_pill.test.mjs b/chrome/browser/resources/webui_browser/meridian/layout_tests/url_pill.test.mjs
new file mode 100644
index 0000000000..49d14d902b
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/layout_tests/url_pill.test.mjs
@@ -0,0 +1,221 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The URL pill's end buttons (Copy Link, the Site controls' sliders) are drawn
+// centred: the real app.css, cr_button.css and icons in headless Google Chrome,
+// with a stand-in <cr-button> (its real stylesheet and template, no ripple).
+// Light and dark, at rest / hover / pressed, at 1x and 2x, in the sidebar and
+// in the Windows top bar: each glyph's centre is within 0.5 px of its square's
+// centre, both glyphs sit on the pill's centre line, and the sliders' square is
+// as far from the pill's top, bottom and right edges as from Copy Link.
+// No build needed. Run: node --test chrome/browser/resources/webui_browser/meridian/layout_tests/url_pill.test.mjs
+// Skipped without Google Chrome (CHROME=/path/to/chrome to pick one).
+// MERIDIAN_SHOTS=<dir> also writes a crop of each case there.
+
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {spawn} from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const WEBUI = process.env.WEBUI_ROOT || path.resolve(HERE, '../..');
+const CR = path.resolve(WEBUI, '../../../../ui/webui/resources/cr_elements');
+const CHROME = process.env.CHROME ||
+    ['/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
+     '/usr/bin/google-chrome', '/usr/bin/chromium']
+        .find((p) => fs.existsSync(p));
+const SHOTS = process.env.MERIDIAN_SHOTS;
+
+const read = (f) => fs.readFileSync(f, 'utf8');
+
+// An icon from icons.ts as plain SVG markup.
+function icon(name, size) {
+  const src = read(path.join(WEBUI, 'meridian/icons.ts'));
+  const m = src.match(new RegExp(`case '${name}':\\s*return html\`([^\`]*)\``));
+  return m[1].replaceAll('${size}', String(size));
+}
+
+function page() {
+  const crButtonCss = read(path.join(CR, 'cr_button/cr_button.css'));
+  const sharedVars = read(path.join(CR, 'cr_shared_vars.css'));
+  const appCss = read(path.join(WEBUI, 'app.css'));
+  const pill = (id) => `
+    <div id="${id}" class="pill-host">
+      <div id="urlPill" role="button" tabindex="0">
+        <span class="host"><bdi dir="ltr">github.com</bdi></span>
+        <button id="copyLinkButton" class="pill-btn">${icon('link', 15)}</button>
+        <cr-button id="locationIconButton" type="button" class="pill-btn">${
+      icon('sliders', 15)}</cr-button>
+      </div>
+    </div>`;
+  return `<!doctype html><html><head><meta charset="utf-8">
+<style>${sharedVars}</style>
+<style>html, body { margin: 0; background: #888; }
+  #side { width: 260px; height: 60px; }
+  #win { width: 440px; height: 44px; margin-top: 8px; }</style>
+</head><body><div id="side"></div><div id="win"></div>
+<script>
+// The window (and its custom element registry) outlives setDocumentContent.
+if (!customElements.get('cr-button')) customElements.define('cr-button', class extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({mode: 'open'}).innerHTML =
+        '<style>' + ${JSON.stringify(crButtonCss)} + '</style>' +
+        '<div id="background"></div><slot id="prefixIcon" name="prefix-icon"></slot>' +
+        '<span id="content"><slot></slot></span>' +
+        '<slot id="suffixIcon" name="suffix-icon"></slot>' +
+        '<div id="hoverBackground" part="hoverBackground"></div>';
+  }
+});
+for (const [id, wrap] of [['side', (p) => p], ['win', (p) =>
+    '<div id="winTopBar"><div id="winTopCenter">' + p + '</div></div>']]) {
+  const root = document.getElementById(id).attachShadow({mode: 'open'});
+  root.innerHTML = '<style>' + ${JSON.stringify(appCss)} + '</style>' +
+      '<style>:host { padding: 13px 8px; box-sizing: border-box; }' +
+      '#winTopBar { flex: 1; display: flex; align-items: center; }' +
+      '.pill-host { flex: 1; min-width: 0; }</style>' +
+      wrap(${JSON.stringify(pill('pill'))});
+}
+</script></body></html>`;
+}
+
+// What the test reads: boxes, and each glyph's centre from its geometry
+// (getBBox in the icon's own units, mapped to the screen; the stroke is the
+// same on every side, so it doesn't move the centre).
+const MEASURE = `(which) => {
+  const root = document.getElementById(which).shadowRoot;
+  const box = (el) => { const r = el.getBoundingClientRect();
+    return {l: r.left, t: r.top, r: r.right, b: r.bottom,
+            cx: (r.left + r.right) / 2, cy: (r.top + r.bottom) / 2}; };
+  const ink = (svg) => { const b = svg.getBBox(); const m = svg.getScreenCTM();
+    const p = new DOMPoint(b.x + b.width / 2, b.y + b.height / 2).matrixTransform(m);
+    return {cx: p.x, cy: p.y}; };
+  const pill = root.getElementById('urlPill');
+  const copy = root.getElementById('copyLinkButton');
+  const site = root.getElementById('locationIconButton');
+  const bg = (el) => getComputedStyle(el).backgroundColor;
+  const hoverLayer = site.shadowRoot.getElementById('hoverBackground');
+  return {pill: box(pill), copy: box(copy), site: box(site),
+          copyInk: ink(copy.querySelector('svg')), siteInk: ink(site.querySelector('svg')),
+          copyBg: bg(copy), siteBg: bg(site),
+          siteLayer: getComputedStyle(hoverLayer).display === 'none' ? 'none' : bg(hoverLayer)};
+}`;
+
+async function launch() {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'url-pill-'));
+  const proc = spawn(CHROME, ['--headless=new', '--remote-debugging-port=0',
+    `--user-data-dir=${dir}`, '--no-first-run', '--no-default-browser-check',
+    '--hide-scrollbars', '--force-color-profile=srgb', 'about:blank'],
+    {stdio: 'ignore'});
+  const portFile = path.join(dir, 'DevToolsActivePort');
+  for (let i = 0; i < 200 && !fs.existsSync(portFile); i++) {
+    await new Promise((r) => setTimeout(r, 50));
+  }
+  const [port, wsPath] = read(portFile).trim().split('\n');
+  const ws = new WebSocket(`ws://127.0.0.1:${port}${wsPath}`);
+  await new Promise((r, j) => { ws.onopen = r; ws.onerror = j; });
+  let id = 0;
+  const waiting = new Map();
+  ws.onmessage = (e) => {
+    const msg = JSON.parse(e.data);
+    const w = waiting.get(msg.id);
+    if (!w) return;
+    waiting.delete(msg.id);
+    msg.error ? w.j(new Error(JSON.stringify(msg.error))) : w.r(msg.result);
+  };
+  const send = (method, params = {}, sessionId) => new Promise((r, j) => {
+    waiting.set(++id, {r, j});
+    ws.send(JSON.stringify({id, method, params, sessionId}));
+  });
+  const {targetId} = await send('Target.createTarget', {url: 'about:blank'});
+  const {sessionId} = await send('Target.attachToTarget', {targetId, flatten: true});
+  const s = (method, params) => send(method, params, sessionId);
+  return {
+    s,
+    async close() {
+      ws.close();
+      proc.kill();
+      await new Promise((r) => setTimeout(r, 200));
+      fs.rmSync(dir, {recursive: true, force: true});
+    },
+  };
+}
+
+// Every case is checked and shot; the misses are listed together at the end.
+const misses = [];
+const near = (a, b, tol, what) => {
+  if (!(Math.abs(a - b) <= tol)) misses.push(`${what}: ${a.toFixed(2)} vs ${b.toFixed(2)}`);
+};
+
+test('URL pill: the sliders and Copy Link glyphs sit centred in even squares',
+    {skip: !CHROME && 'no Google Chrome'}, async () => {
+  const b = await launch();
+  try {
+    const {s} = b;
+    const html = page();
+    await s('Page.enable');
+    const frameId = (await s('Page.getFrameTree')).frameTree.frame.id;
+    for (const scale of [1, 2]) {
+      await s('Emulation.setDeviceMetricsOverride',
+          {width: 480, height: 140, deviceScaleFactor: scale, mobile: false});
+      for (const scheme of ['light', 'dark']) {
+        await s('Emulation.setEmulatedMedia',
+            {features: [{name: 'prefers-color-scheme', value: scheme}]});
+        await s('Page.setDocumentContent', {frameId, html});
+        await s('Runtime.evaluate', {expression: 'document.fonts.ready', awaitPromise: true});
+        for (const which of ['side', 'win']) {
+          const at = async () => (await s('Runtime.evaluate',
+              {expression: `(${MEASURE})('${which}')`, returnByValue: true})).result.value;
+          for (const state of ['rest', 'hover', 'pressed']) {
+            const m0 = await at();
+            const x = m0.site.cx, y = m0.site.cy;
+            await s('Input.dispatchMouseEvent', {type: 'mouseMoved', x: 1, y: 1});
+            if (state !== 'rest') {
+              await s('Input.dispatchMouseEvent', {type: 'mouseMoved', x, y});
+            }
+            if (state === 'pressed') {
+              await s('Input.dispatchMouseEvent',
+                  {type: 'mousePressed', x, y, button: 'left', clickCount: 1});
+            }
+            const m = await at();
+            const tag = `${which} ${scheme} ${state} @${scale}x`;
+            near(m.siteInk.cx, m.site.cx, 0.5, `${tag}: sliders x`);
+            near(m.siteInk.cy, m.site.cy, 0.5, `${tag}: sliders y`);
+            near(m.copyInk.cx, m.copy.cx, 0.5, `${tag}: link x`);
+            near(m.copyInk.cy, m.copy.cy, 0.5, `${tag}: link y`);
+            near(m.siteInk.cy, m.copyInk.cy, 0.5, `${tag}: both glyphs on one line`);
+            near(m.site.cy, (m.pill.t + m.pill.b) / 2, 0.5, `${tag}: square on the pill's centre`);
+            const top = m.site.t - m.pill.t, bottom = m.pill.b - m.site.b;
+            const right = m.pill.r - m.site.r, gap = m.site.l - m.copy.r;
+            near(top, bottom, 0.5, `${tag}: top vs bottom inset`);
+            near(right, gap, 0.5, `${tag}: right inset vs gap to Copy Link`);
+            if (which === 'side') near(right, top, 0.5, `${tag}: right vs top inset`);
+            // One hover look for both buttons: no extra cr-button layer.
+            if (m.siteLayer !== 'none' && m.siteLayer !== 'rgba(0, 0, 0, 0)') {
+              misses.push(`${tag}: cr-button hover layer drawn (${m.siteLayer})`);
+            }
+            if (SHOTS) {
+              fs.mkdirSync(SHOTS, {recursive: true});
+              const clip = {x: m.pill.r - 90, y: m.pill.t - 6, width: 96,
+                            height: m.pill.b - m.pill.t + 12, scale: 1};
+              const {data} = await s('Page.captureScreenshot', {format: 'png', clip});
+              fs.writeFileSync(path.join(SHOTS,
+                  `${which}-${scheme}-${state}-${scale}x.png`), Buffer.from(data, 'base64'));
+            }
+            if (state === 'pressed') {
+              await s('Input.dispatchMouseEvent',
+                  {type: 'mouseReleased', x, y, button: 'left', clickCount: 1});
+            }
+          }
+        }
+      }
+    }
+  } finally {
+    await b.close();
+  }
+  assert.deepEqual(misses, []);
+});
