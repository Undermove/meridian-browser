--- /dev/null
+++ b/chrome/browser/meridian/agent/socket_path.h
@@ -0,0 +1,26 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AGENT_SOCKET_PATH_H_
+#define CHROME_BROWSER_MERIDIAN_AGENT_SOCKET_PATH_H_
+
+#include "base/files/file_path.h"
+
+namespace meridian {
+
+// Where the agent socket goes (AgentServer, not on Windows). A unix socket's
+// path must stay under ~104 bytes, and profile folders (or TMPDIR) can be
+// longer: in `user_data_dir` when it fits, else
+// "<short_root>/meridian-<uid>/<hash of user_data_dir>.sock" in a folder only
+// this user can open (0700), else a new private temp folder, which is then
+// put in `temp_dir` to remove with the socket. Clients find the path in
+// "Meridian Agent.json", so it can be anything.
+base::FilePath AgentSocketPath(
+    const base::FilePath& user_data_dir,
+    base::FilePath* temp_dir,
+    const base::FilePath& short_root = base::FilePath("/tmp"));
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_AGENT_SOCKET_PATH_H_
diff --git a/chrome/browser/meridian/agent/socket_path_unittest.cc b/chrome/browser/meridian/agent/socket_path_unittest.cc
new file mode 100644
index 0000000000..f35e783db7
--- /dev/null
+++ b/chrome/browser/meridian/agent/socket_path_unittest.cc
@@ -0,0 +1,95 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/agent/socket_path.h"
+
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "build/build_config.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+#if !BUILDFLAG(IS_WIN)
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "base/strings/string_number_conversions.h"
+
+namespace meridian {
+namespace {
+
+// A short profile folder keeps the socket inside it.
+TEST(AgentSocketPathTest, ShortProfileKeepsItInside) {
+  base::FilePath temp_dir;
+  base::FilePath dir("/tmp/p");
+  base::FilePath path = AgentSocketPath(dir, &temp_dir);
+  EXPECT_EQ(path.DirName(), dir);
+  EXPECT_TRUE(temp_dir.empty());
+}
+
+// A long one (tests' temp profiles, a long TMPDIR) gets a short path in a
+// private folder of this user's, the same for the same profile.
+TEST(AgentSocketPathTest, LongProfileGetsShortPrivatePath) {
+  base::ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDirUnderPath(base::FilePath("/tmp")));
+  base::FilePath profile("/Users/someone/" + std::string(150, 'x'));
+  base::FilePath temp_dir;
+  base::FilePath path = AgentSocketPath(profile, &temp_dir, root.GetPath());
+  EXPECT_LT(path.value().size(), 100u) << path.value();
+  EXPECT_TRUE(temp_dir.empty());
+  base::FilePath folder =
+      root.GetPath().AppendASCII("meridian-" + base::NumberToString(getuid()));
+  EXPECT_EQ(path.DirName(), folder);
+  EXPECT_EQ(path.Extension(), ".sock");
+  struct stat st;
+  ASSERT_EQ(lstat(folder.value().c_str(), &st), 0);
+  EXPECT_EQ(static_cast<int>(st.st_mode & 0777), 0700);
+  EXPECT_EQ(AgentSocketPath(profile, &temp_dir, root.GetPath()), path);
+  EXPECT_NE(AgentSocketPath(profile.AppendASCII("other"), &temp_dir,
+                            root.GetPath()),
+            path);
+}
+
+// An open folder of this user's is closed up before use.
+TEST(AgentSocketPathTest, ClosesAnOpenFolder) {
+  base::ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDirUnderPath(base::FilePath("/tmp")));
+  base::FilePath folder =
+      root.GetPath().AppendASCII("meridian-" + base::NumberToString(getuid()));
+  ASSERT_TRUE(base::CreateDirectory(folder));
+  ASSERT_TRUE(base::SetPosixFilePermissions(folder, 0777));
+  base::FilePath temp_dir;
+  base::FilePath path = AgentSocketPath(
+      base::FilePath("/Users/someone/" + std::string(150, 'y')), &temp_dir,
+      root.GetPath());
+  EXPECT_EQ(path.DirName(), folder);
+  int mode = 0;
+  ASSERT_TRUE(base::GetPosixFilePermissions(folder, &mode));
+  EXPECT_EQ(mode, 0700);
+}
+
+// A link planted where the folder goes isn't followed.
+TEST(AgentSocketPathTest, IgnoresALinkInItsPlace) {
+  base::ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDirUnderPath(base::FilePath("/tmp")));
+  base::ScopedTempDir elsewhere;
+  ASSERT_TRUE(elsewhere.CreateUniqueTempDir());
+  base::FilePath folder =
+      root.GetPath().AppendASCII("meridian-" + base::NumberToString(getuid()));
+  ASSERT_TRUE(base::CreateSymbolicLink(elsewhere.GetPath(), folder));
+  base::FilePath temp_dir;
+  base::FilePath path = AgentSocketPath(
+      base::FilePath("/Users/someone/" + std::string(150, 'z')), &temp_dir,
+      root.GetPath());
+  EXPECT_NE(path.DirName(), folder);
+  if (!temp_dir.empty()) {
+    base::DeletePathRecursively(temp_dir);
+  }
+}
+
+}  // namespace
+}  // namespace meridian
+
+#endif  // !BUILDFLAG(IS_WIN)
