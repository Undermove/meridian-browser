--- /dev/null
+++ b/chrome/browser/meridian/agent/socket_path.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/agent/socket_path.h"
+
+#include <errno.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/meridian/private_file.h"
+#include "crypto/hash.h"
+
+namespace meridian {
+
+namespace {
+
+// Unix socket paths must fit sun_path (104 bytes on macOS, with the NUL).
+constexpr size_t kMaxSocketPath = 100;
+
+// "/tmp/meridian-<uid>": made 0700 by this user, and checked to be a real
+// folder of this user's that nobody else can open (not a link someone else
+// planted). Empty when it can't be had.
+base::FilePath ShortPrivateDir(const base::FilePath& root) {
+  base::FilePath dir =
+      root.AppendASCII("meridian-" + base::NumberToString(getuid()));
+  if (mkdir(dir.value().c_str(), 0700) != 0 && errno != EEXIST) {
+    return {};
+  }
+  struct stat st;
+  if (lstat(dir.value().c_str(), &st) != 0 || !S_ISDIR(st.st_mode) ||
+      st.st_uid != getuid()) {
+    return {};
+  }
+  if ((st.st_mode & 0777) != 0700 && !MakePrivate(dir, 0700)) {
+    return {};
+  }
+  return dir;
+}
+
+}  // namespace
+
+// A short socket path: in the user data folder (private, 0700) if it fits;
+// else "/tmp/meridian-<uid>/<hash of the folder>.sock", so a long profile
+// path (or a long TMPDIR) still works; else a new private temp folder.
+// `temp_dir` is set only for that last one (removed with the socket).
+base::FilePath AgentSocketPath(const base::FilePath& user_data_dir,
+                               base::FilePath* temp_dir,
+                               const base::FilePath& short_root) {
+  std::string name =
+      "agent-" + base::HexEncodeLower(base::RandBytesAsVector(4)) + ".sock";
+  base::FilePath in_profile = user_data_dir.AppendASCII(name);
+  if (in_profile.value().size() < kMaxSocketPath) {
+    return in_profile;
+  }
+  base::FilePath short_dir = ShortPrivateDir(short_root);
+  if (!short_dir.empty()) {
+    std::string hash = base::HexEncodeLower(
+        crypto::hash::Sha256(user_data_dir.value()));
+    return short_dir.AppendASCII(hash.substr(0, 16) + ".sock");
+  }
+  if (base::CreateNewTempDirectory(FILE_PATH_LITERAL("meridian-agent"),
+                                   temp_dir)) {
+    MakePrivate(*temp_dir, 0700);
+    base::FilePath socket = temp_dir->AppendASCII("agent.sock");
+    if (socket.value().size() < kMaxSocketPath) {
+      return socket;
+    }
+  }
+  return in_profile;
+}
+
+}  // namespace meridian
