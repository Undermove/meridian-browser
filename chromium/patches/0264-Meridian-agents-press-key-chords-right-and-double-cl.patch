+// The same site, or one inside the other (upload.example.com on
+// example.com).
+bool SameSite(std::string_view a, std::string_view b) {
+  return a == b || (a.size() > b.size() && a.ends_with(b) &&
+                    a[a.size() - b.size() - 1] == '.') ||
+         (b.size() > a.size() && b.ends_with(a) &&
+          b[b.size() - a.size() - 1] == '.');
+}
