+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/agent/agent_input.h"
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/run_loop.h"
+#include "base/test/task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::agent_input {
+namespace {
+
+TEST(AgentInputTest, PlainKeysAsBefore) {
+  auto enter = ParseChord("Enter", true);
+  ASSERT_TRUE(enter.has_value());
+  EXPECT_EQ(enter->modifiers, 0);
+  EXPECT_EQ(enter->key.key, "Enter");
+  EXPECT_EQ(enter->key.code, "Enter");
+  EXPECT_EQ(enter->key.key_code, 13);
+  EXPECT_EQ(enter->key.text, "\r");
+  EXPECT_TRUE(enter->commands.empty());
+  EXPECT_EQ(enter->name, "Enter");
+  EXPECT_EQ(ParseChord("escape", true)->key.key, "Escape");
+  EXPECT_EQ(ParseChord("Space", false)->key.text, " ");
+  EXPECT_EQ(ParseChord(" ", false)->key.code, "Space");
+  EXPECT_EQ(ParseChord("PageDown", false)->key.key_code, 34);
+  EXPECT_EQ(ParseChord("a", false)->key.text, "a");
+  EXPECT_EQ(ParseChord("A", false)->key.text, "A");
+  EXPECT_EQ(ParseChord("?", false)->key.code, "Slash");
+}
+
+TEST(AgentInputTest, Chords) {
+  auto all = ParseChord("Meta+A", true);
+  ASSERT_TRUE(all.has_value());
+  EXPECT_EQ(all->modifiers, kMeta);
+  EXPECT_EQ(all->key.key, "a");
+  EXPECT_EQ(all->key.code, "KeyA");
+  EXPECT_EQ(all->key.key_code, 'A');
+  EXPECT_EQ(all->key.text, "");
+  ASSERT_EQ(all->commands.size(), 1u);
+  EXPECT_EQ(all->commands[0], "SelectAll");
+  EXPECT_EQ(all->name, "Meta+A");
+  ASSERT_EQ(all->modifier_keys.size(), 1u);
+  EXPECT_EQ(all->modifier_keys[0].key, "Meta");
+  // Elsewhere Blink selects all by itself.
+  EXPECT_TRUE(ParseChord("Meta+A", false)->commands.empty());
+
+  auto tab = ParseChord("Control+Shift+Tab", false);
+  ASSERT_TRUE(tab.has_value());
+  EXPECT_EQ(tab->modifiers, kControl | kShift);
+  EXPECT_EQ(tab->key.code, "Tab");
+  EXPECT_EQ(tab->key.text, "");
+  EXPECT_EQ(tab->name, "Control+Shift+Tab");
+  ASSERT_EQ(tab->modifier_keys.size(), 2u);
+
+  auto word = ParseChord("Alt+ArrowLeft", true);
+  ASSERT_TRUE(word.has_value());
+  EXPECT_EQ(word->modifiers, kAlt);
+  EXPECT_EQ(word->commands, std::vector<std::string>{"MoveWordLeft"});
+
+  EXPECT_EQ(ParseChord("cmd+shift+z", true)->commands,
+            std::vector<std::string>{"Redo"});
+  EXPECT_EQ(ParseChord("ControlOrMeta+Z", true)->modifiers, kMeta);
+  EXPECT_EQ(ParseChord("ControlOrMeta+Z", false)->modifiers, kControl);
+  auto shifted = ParseChord("Shift+a", false);
+  EXPECT_EQ(shifted->key.key, "A");
+  EXPECT_EQ(shifted->key.text, "A");
+  EXPECT_EQ(ParseChord("Shift+Enter", false)->key.text, "\r");
+  EXPECT_EQ(ParseChord("Control++", false)->key.code, "Equal");
+  EXPECT_EQ(ParseChord("Shift", false)->modifiers, kShift);
+}
+
+TEST(AgentInputTest, ClearErrors) {
+  auto bad = ParseChord("Hyper+A", true);
+  ASSERT_FALSE(bad.has_value());
+  EXPECT_NE(bad.error().find("unknown modifier “Hyper”"), std::string::npos);
+  EXPECT_NE(bad.error().find("Meta+A"), std::string::npos);
+  auto key = ParseChord("Meta+Foo", true);
+  ASSERT_FALSE(key.has_value());
+  EXPECT_NE(key.error().find("unknown key “Foo”"), std::string::npos);
+  EXPECT_FALSE(ParseChord("", true).has_value());
+  EXPECT_FALSE(ParseChord("Meta+", true).has_value());
+  // No pasting the clipboard into a page.
+  for (const char* paste : {"Meta+V", "Control+v", "Shift+Insert",
+                            "Control+Shift+V"}) {
+    auto p = ParseChord(paste, true);
+    ASSERT_FALSE(p.has_value()) << paste;
+    EXPECT_NE(p.error().find("doesn't paste"), std::string::npos);
+  }
+}
+
+TEST(AgentInputTest, OfferedFileGoesToTheNextChooserOnce) {
+  base::test::SingleThreadTaskEnvironment env;
+  int tab = 0;
+  std::string heard = "-";
+  OfferFile(&tab, "studio.example.com", base::FilePath("/copy/a.png"),
+            base::FilePath("/real/a.png"), base::Seconds(5),
+            base::BindOnce([](std::string* out, std::string e) { *out = e; },
+                           &heard));
+  // Another tab has nothing.
+  int other = 0;
+  EXPECT_FALSE(TakeFile(&other, "studio.example.com", Chooser::kOpen, false));
+  auto file = TakeFile(&tab, "upload.studio.example.com", Chooser::kOpen,
+                       false);
+  ASSERT_TRUE(file.has_value());
+  EXPECT_EQ(*file, base::FilePath("/copy/a.png"));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(heard, "");
+  // Once.
+  EXPECT_FALSE(TakeFile(&tab, "studio.example.com", Chooser::kOpen, false));
+
+  // Another site's frame, or a folder: cancelled, and said why.
+  OfferFile(&tab, "example.com", base::FilePath("/copy/a.png"),
+            base::FilePath("/real/a.png"), base::Seconds(5),
+            base::BindOnce([](std::string* out, std::string e) { *out = e; },
+                           &heard));
+  auto cancel = TakeFile(&tab, "evil.test", Chooser::kOpen, false);
+  ASSERT_TRUE(cancel.has_value());
+  EXPECT_TRUE(cancel->empty());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_NE(heard.find("evil.test"), std::string::npos);
+  OfferFile(&tab, "example.com", base::FilePath("/copy/a.png"),
+            base::FilePath("/real/a.png"), base::Seconds(5),
+            base::BindOnce([](std::string* out, std::string e) { *out = e; },
+                           &heard));
+  EXPECT_TRUE(TakeFile(&tab, "example.com", Chooser::kOther, true)->empty());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_NE(heard.find("folder"), std::string::npos);
+  // The picker gets the approved file itself.
+  OfferFile(&tab, "example.com", base::FilePath("/copy/a.png"),
+            base::FilePath("/real/a.png"), base::Seconds(5),
+            base::DoNothing());
+  EXPECT_EQ(*TakeFile(&tab, "example.com", Chooser::kOpenMultiple, true),
+            base::FilePath("/real/a.png"));
+  // Withdrawn: the native chooser again.
+  OfferFile(&tab, "example.com", base::FilePath("/copy/a.png"),
+            base::FilePath("/real/a.png"), base::Seconds(5),
+            base::BindOnce([](std::string* out, std::string e) { *out = e; },
+                           &heard));
+  Withdraw(&tab);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(heard, "withdrawn");
+  EXPECT_FALSE(TakeFile(&tab, "example.com", Chooser::kOpen, false));
+}
+
+TEST(AgentInputTest, ContextMenuOfAnAgentsRightClick) {
+  int tab = 0, other = 0;
+  EXPECT_FALSE(TakeContextMenu(&tab));
+  ExpectContextMenu(&tab);
+  EXPECT_FALSE(TakeContextMenu(&other));
+  EXPECT_TRUE(TakeContextMenu(&tab));
+  EXPECT_FALSE(TakeContextMenu(&tab));
+}
+
+}  // namespace
+}  // namespace meridian::agent_input
