+// Input.dispatchKeyEvent commands for a key chord: the modifiers down, the
+// key down and up, the modifiers up.
+std::vector<PageInput::Command> KeyCommands(
+    const agent_input::Chord& chord) {
+  std::vector<PageInput::Command> out;
+  auto event = [&](const char* type, const agent_input::Key& key,
+                   int modifiers) {
+    base::DictValue p;
+    p.Set("type", type);
+    p.Set("modifiers", modifiers);
+    p.Set("key", key.key);
+    p.Set("code", key.code);
+    p.Set("windowsVirtualKeyCode", key.key_code);
+    if (!key.text.empty() && std::string_view(type) == "keyDown") {
+      p.Set("text", key.text);
+      p.Set("unmodifiedText", key.text);
+    }
+    return p;
+  };
+  int held = 0;
+  for (const agent_input::Key& m : chord.modifier_keys) {
+    held |= agent_input::ParseChord(m.key, false)->modifiers;
+    out.emplace_back("Input.dispatchKeyEvent", event("rawKeyDown", m, held));
+  }
+  base::DictValue down = event(chord.key.text.empty() ? "rawKeyDown" : "keyDown",
+                               chord.key, chord.modifiers);
+  if (!chord.commands.empty()) {
+    base::ListValue commands;
+    for (const std::string& c : chord.commands) {
+      commands.Append(c);
+    }
+    down.Set("commands", std::move(commands));
+  }
+  out.emplace_back("Input.dispatchKeyEvent", std::move(down));
+  out.emplace_back("Input.dispatchKeyEvent",
+                   event("keyUp", chord.key, chord.modifiers));
+  for (auto m = chord.modifier_keys.rbegin(); m != chord.modifier_keys.rend();
+       ++m) {
+    held &= ~agent_input::ParseChord(m->key, false)->modifiers;
+    out.emplace_back("Input.dispatchKeyEvent", event("keyUp", *m, held));
+  }
+  return out;
+}
