+    return call->Fail(
+        "The page changed while waiting for approval, so nothing was "
+        "uploaded. Look at it again.");
+  }
+  // The button still there, not covered?
+  RunInPage(
+      tab->GetContents(), "__meridianAgent.verifyHit()",
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+             std::unique_ptr<Call> call, base::FilePath real,
+             base::FilePath copy, std::string mb, std::string label,
+             base::Value hit) {
+            tabs::TabInterface* tab = handle.Get();
+            if (!self || !tab) {
+              return call->Fail("the tab is gone");
+            }
+            const base::DictValue* h = hit.GetIfDict();
+            if (!h || !h->FindBool("ok").value_or(false)) {
+              const std::string* why = h ? h->FindString("why") : nullptr;
+              return call->Fail("couldn't click “" + label + "”: " +
+                                (why ? *why : std::string("it's gone")) +
+                                "; nothing was uploaded");
+            }
+            content::WebContents* contents = tab->GetContents();
+            const std::string host(contents->GetLastCommittedURL().host());
+            const std::string name = real.BaseName().AsUTF8Unsafe();
+            constexpr base::TimeDelta kWait = base::Seconds(10);
+            int offer = agent_input::OfferFile(
+                contents, host, copy, real, kWait,
+                base::BindOnce(
+                    [](std::unique_ptr<Call> call, std::string name,
+                       std::string mb, std::string label, std::string error) {
+                      if (error == "withdrawn") {
+                        return call->Fail(
+                            "clicking “" + label +
+                            "” didn't open a file chooser within 10 seconds; "
+                            "nothing was uploaded. Open the site's upload "
+                            "dialog first, or give its <input type=file> "
+                            "(get_interactive_elements lists it).");
+                      }
+                      if (!error.empty()) {
+                        return call->Fail(error);
+                      }
+                      call->Ok(base::Value(base::DictValue()
+                                               .Set("uploaded", name)
+                                               .Set("size", mb)
+                                               .Set("into", label)
+                                               .Set("through",
+                                                    "the site's file chooser")));
+                    },
+                    std::move(call), name, mb, label));
+            if (!SendMouse(contents, gfx::PointF(*h->FindDouble("x"),
+                                                 *h->FindDouble("y")),
+                           "left")) {
+              agent_input::Withdraw(contents, offer);
+              return;
+            }
+            base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+                FROM_HERE,
+                base::BindOnce(
+                    [](const void* tab, int offer) {
+                      agent_input::Withdraw(tab, offer);
+                    },
+                    static_cast<const void*>(contents), offer),
+                kWait);
+          },
+          weak_factory_.GetWeakPtr(), handle, std::move(call), real, copy, mb,
+          label));
+}
