+base::expected<Chord, std::string> ParseChord(std::string_view text,
+                                              bool mac) {
+  std::string_view rest = base::TrimWhitespaceASCII(text, base::TRIM_ALL);
+  if (text == " ") {
+    rest = text;
+  }
+  if (rest.empty()) {
+    return base::unexpected(std::string("give a key. ") + kKnown);
+  }
+  // The + key itself: "+", "Shift++".
+  std::string_view key_name;
+  if (rest == "+") {
+    key_name = rest;
+    rest = std::string_view();
+  } else if (rest.ends_with("++")) {
+    key_name = "+";
+    rest = rest.substr(0, rest.size() - 2);
+  } else if (size_t plus = rest.rfind('+'); plus != std::string_view::npos) {
+    key_name = rest.substr(plus + 1);
+    rest = rest.substr(0, plus);
+  } else {
+    key_name = rest;
+    rest = std::string_view();
+  }
+  if (key_name != " ") {
+    key_name = base::TrimWhitespaceASCII(key_name, base::TRIM_ALL);
+  }
+  Chord chord;
+  std::vector<std::string> names;
+  if (!rest.empty()) {
+    for (std::string_view part : base::SplitStringPiece(
+             rest, "+", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+      int bit = ModifierBit(part, mac);
+      if (!bit) {
+        return base::unexpected("unknown modifier “" + std::string(part) +
+                                "” in “" + std::string(text) + "”. " + kKnown);
+      }
+      if (!(chord.modifiers & bit)) {
+        chord.modifiers |= bit;
+        const Modifier& m = ModifierFor(bit);
+        chord.modifier_keys.push_back(Key{m.key, m.code, m.key_code, ""});
+        names.push_back(m.key);
+      }
+    }
+  }
+  if (key_name.empty()) {
+    return base::unexpected("no key after the modifiers in “" +
+                            std::string(text) + "”. " + kKnown);
+  }
+  // A modifier on its own ("Shift") is a key too, held as itself.
+  if (int bit = ModifierBit(key_name, mac); bit && key_name.size() > 1) {
+    chord.modifiers |= bit;
+    const Modifier& m = ModifierFor(bit);
+    chord.key = Key{m.key, m.code, m.key_code, ""};
+  } else if (std::optional<Key> key = KeyFor(key_name, chord.modifiers)) {
+    chord.key = *key;
+  } else {
+    return base::unexpected("unknown key “" + std::string(key_name) +
+                            "”. " + kKnown);
+  }
+  // Pasting would put the clipboard (the person's, maybe a password) into
+  // a page the agent then reads.
+  const bool command_or_control = chord.modifiers & (kMeta | kControl);
+  if ((command_or_control && chord.key.code == "KeyV") ||
+      ((chord.modifiers & kShift) && chord.key.code == "Insert")) {
+    return base::unexpected(
+        "press_key doesn't paste: the clipboard may hold the person's "
+        "passwords. Type the text with type_text instead.");
+  }
+  if (mac) {
+    chord.commands = MacCommands(chord.modifiers, chord.key.code);
+  }
+  names.push_back(key_name == " " ? std::string("Space")
+                  : key_name.size() == 1 && chord.modifiers
+                      ? base::ToUpperASCII(std::string(key_name))
+                      : std::string(key_name));
+  chord.name = base::JoinString(names, "+");
+  return chord;
+}
+
+int OfferFile(const void* tab,
+              std::string host,
+              base::FilePath for_input,
+              base::FilePath for_picker,
+              base::TimeDelta ttl,
+              base::OnceCallback<void(std::string error)> done) {
+  static int last_id = 0;
+  Withdraw(tab);
+  Offers()[tab] = Offer{++last_id,
+                        std::move(host),
+                        std::move(for_input),
+                        std::move(for_picker),
+                        base::TimeTicks::Now() + ttl,
+                        std::move(done)};
+  return last_id;
+}
+
+void Withdraw(const void* tab, int id) {
+  auto it = Offers().find(tab);
+  if (it == Offers().end() || (id && it->second.id != id)) {
+    return;
+  }
+  Tell(std::move(it->second.done), "withdrawn");
+  Offers().erase(it);
+}
+
+std::optional<base::FilePath> TakeFile(const void* tab,
+                                       std::string_view host,
+                                       Chooser kind,
+                                       bool picker) {
+  auto it = Offers().find(tab);
+  if (it == Offers().end()) {
+    return std::nullopt;
+  }
+  Offer offer = std::move(it->second);
+  Offers().erase(it);
+  if (base::TimeTicks::Now() > offer.deadline) {
+    Tell(std::move(offer.done), "withdrawn");
+    return std::nullopt;
+  }
+  if (!SameSite(host, offer.host)) {
+    Tell(std::move(offer.done),
+         "the file chooser opened in a frame of " + std::string(host) +
+             ", not " + offer.host + "; nothing was uploaded");
+    return base::FilePath();
+  }
+  if (kind == Chooser::kOther) {
+    Tell(std::move(offer.done),
+         "the site opened a folder or save dialog, not a file to open; "
+         "nothing was uploaded");
+    return base::FilePath();
+  }
+  Tell(std::move(offer.done), std::string());
+  return picker ? offer.for_picker : offer.for_input;
+}
+
+void ExpectContextMenu(const void* tab) {
+  Menus()[tab] = base::TimeTicks::Now() + base::Seconds(3);
+}
+
+bool TakeContextMenu(const void* tab) {
+  auto it = Menus().find(tab);
+  if (it == Menus().end()) {
+    return false;
+  }
+  bool fresh = base::TimeTicks::Now() <= it->second;
+  Menus().erase(it);
+  return fresh;
+}
+
+}  // namespace meridian::agent_input
diff --git a/chrome/browser/meridian/agent/agent_input.h b/chrome/browser/meridian/agent/agent_input.h
new file mode 100644
index 0000000000..53be7a0d3e
--- /dev/null
+++ b/chrome/browser/meridian/agent/agent_input.h
@@ -0,0 +1,90 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AGENT_AGENT_INPUT_H_
+#define CHROME_BROWSER_MERIDIAN_AGENT_AGENT_INPUT_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/time/time.h"
+#include "base/types/expected.h"
+
+// What agents' input needs from the rest of the browser, with no browser
+// deps (Chromium's file chooser and context menu code call it): key chords
+// for press_key, the file an approved upload_file gives the next file
+// chooser of a tab, and right clicks that are the page's alone. A tab is its
+// WebContents, as a pointer that is only compared.
+namespace meridian::agent_input {
+
+// A key as the DevTools protocol (Input.dispatchKeyEvent) sends it.
+struct Key {
+  std::string key;   // KeyboardEvent.key: "a", "A", "Enter", "ArrowLeft"
+  std::string code;  // KeyboardEvent.code: "KeyA", "Enter"
+  int key_code = 0;  // Windows virtual key code
+  std::string text;  // what it types, if anything
+};
+
+// press_key: "Enter", "a", "Meta+A", "Control+Shift+Tab", "Alt+ArrowLeft",
+// "ControlOrMeta+Z" (Meta on a Mac).
+struct Chord {
+  // Input.dispatchKeyEvent's: Alt 1, Control 2, Meta 4, Shift 8.
+  int modifiers = 0;
+  // The modifier keys pressed first (in order), then `key`.
+  std::vector<Key> modifier_keys;
+  Key key;
+  // Editing commands the Mac gets from the system for this chord (Cmd+A is
+  // SelectAll): the renderer runs them unless the page handles the key.
+  std::vector<std::string> commands;
+  // As the person reads it: "Meta+A".
+  std::string name;
+};
+
+inline constexpr int kAlt = 1, kControl = 2, kMeta = 4, kShift = 8;
+
+// An unknown key, modifier or a chord that pastes the clipboard (it may hold
+// the person's passwords) is an error that says what works.
+base::expected<Chord, std::string> ParseChord(std::string_view text,
+                                              bool mac);
+
+// upload_file through the file chooser a page opens from a button: for a few
+// seconds after the person approved the upload, the next chooser the tab's
+// page on `host` opens gets the file (`for_input` for an <input type=file>,
+// `for_picker` for showOpenFilePicker) without the native dialog. `done`
+// learns what happened: an empty string when the file was given, else why
+// not (a folder or save picker, another site's frame). Offering again or
+// Withdraw drops an earlier offer (its `done` hears "withdrawn"). Returns
+// the offer's id, for Withdraw.
+int OfferFile(const void* tab,
+               std::string host,
+               base::FilePath for_input,
+               base::FilePath for_picker,
+               base::TimeDelta ttl,
+               base::OnceCallback<void(std::string error)> done);
+// `id`: only that offer (0: any).
+void Withdraw(const void* tab, int id = 0);
+
+enum class Chooser { kOpen, kOpenMultiple, kOther };
+// For the chooser code: nullopt when there's no offer (show the native
+// chooser); an empty path to cancel the chooser (the offer couldn't go
+// there); else the file to give. `picker`: showOpenFilePicker's.
+std::optional<base::FilePath> TakeFile(const void* tab,
+                                       std::string_view host,
+                                       Chooser kind,
+                                       bool picker);
+
+// An agent's right click: the page's own contextmenu handlers get it, and
+// the native context menu it would show next is dropped.
+void ExpectContextMenu(const void* tab);
+// For the context menu code: true when the menu comes from an agent's right
+// click (don't show it).
+bool TakeContextMenu(const void* tab);
+
+}  // namespace meridian::agent_input
+
+#endif  // CHROME_BROWSER_MERIDIAN_AGENT_AGENT_INPUT_H_
