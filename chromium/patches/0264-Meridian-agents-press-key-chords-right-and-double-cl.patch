+// Sends input to a tab's page through DevTools (Input.insertText,
+// Input.dispatchKeyEvent), one command after the other, each after the page
+// took the one before (a key: once the page handled it), then detaches.
+// Deletes itself.
+//
+// Not WebContents::Replace and RenderWidgetHost::ForwardKeyboardEvent: the
+// browser UI (chrome://webui-browser) embeds tabs as surfaces, and a tab
+// that doesn't hold the window's focus (one in the background, or any while
+// the person types in the sidebar) has no focused frame tree, so Replace
+// dropped the text without a word; the Enter after it then sent an empty
+// message, which chat sites ignore ("Enter didn't send"). DevTools gives the
+// page focus and puts text and keys into its focused frame whether the tab
+// is shown or not, and keys it sends never reach the browser's own shortcuts.
+bool AgentCanUse(content::WebContents* contents);
+
+class PageInput : public content::DevToolsAgentHostClient {
+ public:
+  using Command = std::pair<std::string, base::DictValue>;
+
+  static void Run(content::WebContents* contents,
+                  std::vector<Command> commands,
+                  base::OnceCallback<void(std::string error)> done) {
+    auto* self = new PageInput(std::move(commands), std::move(done));
+    // Checked at the last moment: the tab may have moved since the call
+    // began.
+    if (!AgentCanUse(contents)) {
+      return self->Finish("Agents only work on web pages.");
+    }
+    self->host_ = content::DevToolsAgentHost::GetOrCreateFor(contents);
+    if (!self->host_->AttachClient(self)) {
+      self->host_ = nullptr;
+      return self->Finish("couldn't reach the page");
+    }
+    // A page that never takes the input (frozen, or stuck in a loop).
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&PageInput::Finish, self->weak_factory_.GetWeakPtr(),
+                       "the page didn't take the input within 15 seconds"),
+        base::Seconds(15));
+    self->Next();
+  }
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(content::DevToolsAgentHost*,
+                               base::span<const uint8_t> message) override {
+    std::optional<base::Value> v = base::JSONReader::Read(
+        std::string_view(reinterpret_cast<const char*>(message.data()),
+                         message.size()),
+        0);
+    if (!v || !v->is_dict() || v->GetDict().FindInt("id") != id_) {
+      return;  // events
+    }
+    if (const base::DictValue* error = v->GetDict().FindDict("error")) {
+      const std::string* m = error->FindString("message");
+      return Finish(m ? *m : "DevTools error");
+    }
+    // Not from inside the host's dispatch.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PageInput::Next, weak_factory_.GetWeakPtr()));
+  }
+  void AgentHostClosed(content::DevToolsAgentHost*) override {
+    host_ = nullptr;
+    Finish("the tab is gone");
+  }
+
+ private:
+  friend class base::DeleteHelper<PageInput>;
+
+  PageInput(std::vector<Command> commands,
+            base::OnceCallback<void(std::string)> done)
+      : commands_(std::move(commands)), done_(std::move(done)) {}
+  ~PageInput() override = default;
+
+  void Next() {
+    if (!done_) {
+      return;
+    }
+    if (next_ >= commands_.size()) {
+      return Finish(std::string());
+    }
+    Command& c = commands_[next_++];
+    std::string json =
+        base::WriteJson(base::DictValue()
+                            .Set("id", ++id_)
+                            .Set("method", c.first)
+                            .Set("params", std::move(c.second)))
+            .value_or("{}");
+    host_->DispatchProtocolMessage(this, base::as_byte_span(json));
+  }
+
+  void Finish(std::string error) {
+    // Once (a reply, the timeout and the host closing can each finish it).
+    if (!done_) {
+      return;
+    }
+    if (host_) {
+      host_->DetachClient(this);
+      host_ = nullptr;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done_), std::move(error)));
+    weak_factory_.InvalidateWeakPtrs();
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                               this);
+  }
+
+  std::vector<Command> commands_;
+  size_t next_ = 0;
+  base::OnceCallback<void(std::string)> done_;
+  scoped_refptr<content::DevToolsAgentHost> host_;
+  int id_ = 0;
+  base::WeakPtrFactory<PageInput> weak_factory_{this};
+};
