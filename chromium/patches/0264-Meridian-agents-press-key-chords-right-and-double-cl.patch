+
+// A US keyboard's other printing keys: the character, its key code, its
+// code, and the character with Shift.
+struct Printing {
+  char plain;
+  char shifted;
+  const char* code;
+  int key_code;
+};
+
+constexpr Printing kPrinting[] = {
+    {'0', ')', "Digit0", 48}, {'1', '!', "Digit1", 49},
+    {'2', '@', "Digit2", 50}, {'3', '#', "Digit3", 51},
+    {'4', '$', "Digit4", 52}, {'5', '%', "Digit5", 53},
+    {'6', '^', "Digit6", 54}, {'7', '&', "Digit7", 55},
+    {'8', '*', "Digit8", 56}, {'9', '(', "Digit9", 57},
+    {'-', '_', "Minus", 189}, {'=', '+', "Equal", 187},
+    {'[', '{', "BracketLeft", 219}, {']', '}', "BracketRight", 221},
+    {'\\', '|', "Backslash", 220}, {';', ':', "Semicolon", 186},
+    {'\'', '"', "Quote", 222}, {',', '<', "Comma", 188},
+    {'.', '>', "Period", 190}, {'/', '?', "Slash", 191},
+    {'`', '~', "Backquote", 192},
+};
+
+struct Modifier {
+  int bit;
+  const char* key;
+  const char* code;
+  int key_code;
+};
+
+constexpr Modifier kModifiers[] = {
+    {kAlt, "Alt", "AltLeft", 18},
+    {kControl, "Control", "ControlLeft", 17},
+    {kMeta, "Meta", "MetaLeft", 91},
+    {kShift, "Shift", "ShiftLeft", 16},
+};
+
+// 0 when `name` isn't a modifier.
+int ModifierBit(std::string_view name, bool mac) {
+  std::string n = base::ToLowerASCII(name);
+  if (n == "alt" || n == "option" || n == "opt") {
+    return kAlt;
+  }
+  if (n == "control" || n == "ctrl") {
+    return kControl;
+  }
+  if (n == "meta" || n == "cmd" || n == "command") {
+    return kMeta;
+  }
+  if (n == "shift") {
+    return kShift;
+  }
+  if (n == "controlormeta" || n == "cmdorctrl" || n == "commandorcontrol" ||
+      n == "mod") {
+    return mac ? kMeta : kControl;
+  }
+  return 0;
+}
+
+const Modifier& ModifierFor(int bit) {
+  for (const Modifier& m : kModifiers) {
+    if (m.bit == bit) {
+      return m;
+    }
+  }
+  return kModifiers[0];
+}
+
+std::optional<Key> KeyFor(std::string_view name, int modifiers) {
+  const bool shift = modifiers & kShift;
+  const bool typing_off = modifiers & (kAlt | kControl | kMeta);
+  for (const Named& n : kNamed) {
+    if (base::EqualsCaseInsensitiveASCII(name, n.name) ||
+        (name == " " && n.key_code == 32)) {
+      return Key{n.key, n.code, n.key_code, typing_off ? "" : n.text};
+    }
+  }
+  if (int bit = ModifierBit(name, /*mac=*/true)) {
+    const Modifier& m = ModifierFor(bit);
+    return Key{m.key, m.code, m.key_code, ""};
+  }
+  if (name.size() != 1) {
+    return std::nullopt;
+  }
+  const char c = name[0];
+  if (base::IsAsciiAlpha(c)) {
+    const char lower = base::ToLowerASCII(c);
+    const char upper = base::ToUpperASCII(c);
+    // As written when it's typed alone ("A" types A); with a modifier the
+    // way a keyboard reports it (Cmd+A is "a", Shift+A is "A").
+    char shown = modifiers ? (shift ? upper : lower) : c;
+    return Key{std::string(1, shown), std::string("Key") + upper, upper,
+               typing_off ? "" : std::string(1, shown)};
+  }
+  for (const Printing& p : kPrinting) {
+    if (c == p.plain || c == p.shifted) {
+      char shown = c == p.shifted ? c : (shift ? p.shifted : p.plain);
+      return Key{std::string(1, shown), p.code, p.key_code,
+                 typing_off ? "" : std::string(1, shown)};
+    }
+  }
+  return std::nullopt;
+}
+
+// What a Mac's text system makes of the chords Blink leaves to it.
+std::vector<std::string> MacCommands(int modifiers, const std::string& code) {
+  struct Entry {
+    int modifiers;
+    const char* code;
+    const char* command;
+  };
+  static constexpr Entry kEntries[] = {
+      {kMeta, "KeyA", "SelectAll"},
+      {kMeta, "KeyZ", "Undo"},
+      {kMeta | kShift, "KeyZ", "Redo"},
+      {kMeta, "ArrowLeft", "MoveToLeftEndOfLine"},
+      {kMeta | kShift, "ArrowLeft", "MoveToLeftEndOfLineAndModifySelection"},
+      {kMeta, "ArrowRight", "MoveToRightEndOfLine"},
+      {kMeta | kShift, "ArrowRight", "MoveToRightEndOfLineAndModifySelection"},
+      {kMeta, "ArrowUp", "MoveToBeginningOfDocument"},
+      {kMeta | kShift, "ArrowUp", "MoveToBeginningOfDocumentAndModifySelection"},
+      {kMeta, "ArrowDown", "MoveToEndOfDocument"},
+      {kMeta | kShift, "ArrowDown", "MoveToEndOfDocumentAndModifySelection"},
+      {kAlt, "ArrowLeft", "MoveWordLeft"},
+      {kAlt | kShift, "ArrowLeft", "MoveWordLeftAndModifySelection"},
+      {kAlt, "ArrowRight", "MoveWordRight"},
+      {kAlt | kShift, "ArrowRight", "MoveWordRightAndModifySelection"},
+      {kAlt, "Backspace", "DeleteWordBackward"},
+      {kMeta, "Backspace", "DeleteToBeginningOfLine"},
+      {kAlt, "Delete", "DeleteWordForward"},
+  };
+  for (const Entry& e : kEntries) {
+    if (e.modifiers == modifiers && code == e.code) {
+      return {e.command};
+    }
+  }
+  return {};
+}
+
+constexpr char kKnown[] =
+    "Use a key such as Enter, Escape, Tab, Backspace, Delete, "
+    "ArrowUp/Down/Left/Right, PageUp, PageDown, Home, End, Space, F1–F12, a "
+    "letter, digit or punctuation mark, optionally after modifiers joined "
+    "with +: Meta (Cmd), Control, Alt (Option), Shift, ControlOrMeta. For "
+    "example Meta+A, Control+Shift+Tab, Alt+ArrowLeft.";
+
+struct Offer {
+  int id = 0;
+  std::string host;
+  base::FilePath for_input;
+  base::FilePath for_picker;
+  base::TimeTicks deadline;
+  base::OnceCallback<void(std::string)> done;
+};
+
+std::map<const void*, Offer>& Offers() {
+  static base::NoDestructor<std::map<const void*, Offer>> offers;
+  return *offers;
+}
+
+std::map<const void*, base::TimeTicks>& Menus() {
+  static base::NoDestructor<std::map<const void*, base::TimeTicks>> menus;
+  return *menus;
+}
+
+void Tell(base::OnceCallback<void(std::string)> done, std::string what) {
+  if (done) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), std::move(what)));
+  }
+}
