+struct Named {
+  const char* name;
+  const char* key;
+  const char* code;
+  int key_code;
+  const char* text;
+};
+
+constexpr Named kNamed[] = {
+    {"Enter", "Enter", "Enter", 13, "\r"},
+    {"Return", "Enter", "Enter", 13, "\r"},
+    {"Tab", "Tab", "Tab", 9, "\t"},
+    {"Backspace", "Backspace", "Backspace", 8, ""},
+    {"Delete", "Delete", "Delete", 46, ""},
+    {"Del", "Delete", "Delete", 46, ""},
+    {"Escape", "Escape", "Escape", 27, ""},
+    {"Esc", "Escape", "Escape", 27, ""},
