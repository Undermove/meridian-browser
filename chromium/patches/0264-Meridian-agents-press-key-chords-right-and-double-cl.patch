+// The mouse at `css` (the page's CSS pixels): a move, then for a click the
+// button down and up (twice for a double click). A right click's native
+// context menu isn't shown: the page's own contextmenu handlers have it.
+// false when the page has no widget to send it to.
+bool SendMouse(content::WebContents* contents,
+               gfx::PointF css,
+               const std::string& kind) {
+  content::RenderWidgetHost* widget =
+      contents->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  if (!widget) {
+    return false;
+  }
+  double zoom = blink::ZoomLevelToZoomFactor(
+      zoom::ZoomController::GetZoomLevelForWebContents(contents));
+  gfx::PointF p(css.x() * zoom, css.y() * zoom);
+  using Type = blink::WebInputEvent::Type;
+  using Button = blink::WebPointerProperties::Button;
+  widget->ForwardMouseEvent(blink::WebMouseEvent(
+      Type::kMouseMove, p, p, Button::kNoButton, 0,
+      blink::WebInputEvent::kNoModifiers, base::TimeTicks::Now()));
+  if (kind == "hover") {
+    return true;
+  }
+  Button button = kind == "right"    ? Button::kRight
+                  : kind == "middle" ? Button::kMiddle
+                                     : Button::kLeft;
+  int down = kind == "right"    ? blink::WebInputEvent::kRightButtonDown
+             : kind == "middle" ? blink::WebInputEvent::kMiddleButtonDown
+                                : blink::WebInputEvent::kLeftButtonDown;
+  if (kind == "right") {
+    agent_input::ExpectContextMenu(contents);
+  }
+  for (int count = 1; count <= (kind == "double" ? 2 : 1); ++count) {
+    widget->ForwardMouseEvent(blink::WebMouseEvent(
+        Type::kMouseDown, p, p, button, count, down, base::TimeTicks::Now()));
+    widget->ForwardMouseEvent(
+        blink::WebMouseEvent(Type::kMouseUp, p, p, button, count,
+                             blink::WebInputEvent::kNoModifiers,
+                             base::TimeTicks::Now()));
+  }
+  return true;
+}
