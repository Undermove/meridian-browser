From: Dmitry Afonchenko <d.afonchenko@dodopizza.com>
Date: Thu, 26 Nov 2026 11:35:08 +0400
Subject: [PATCH 4/4] Meridian: a Workbench shell keeps the space's AI account
 over the person's .zshrc

A shell tab runs zsh -l, whose startup files ran after Meridian set
the account: a .zshrc exporting CLAUDE_CONFIG_DIR put it back, and a
space using ~/.claude (the variable taken away) ran the other account.
The shell's .zlogin now applies the account's variables last.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/workbench/agents.cc        | 14 ++++++++++++++
 .../meridian/workbench/workbench_handler.cc        | 12 ++++++++++++
 2 files changed, 26 insertions(+)

diff --git a/chrome/browser/meridian/workbench/agents.cc b/chrome/browser/meridian/workbench/agents.cc
index a558deefe7..e20fc67249 100644
--- a/chrome/browser/meridian/workbench/agents.cc
+++ b/chrome/browser/meridian/workbench/agents.cc
@@ -121,9 +121,23 @@ claude() {
   esac
 }
 )";
+// Last: the space's AI account wins over the startup files (a .zshrc that
+// exports CLAUDE_CONFIG_DIR would otherwise undo it). MERIDIAN_ACCOUNT_VARS
+// names the variables the account sets (MERIDIAN_ACCOUNT_SET_<name>) or
+// takes away.
 constexpr char kZshLogin[] = R"(ZDOTDIR=$MERIDIAN_USER_ZDOTDIR
 [[ -r $ZDOTDIR/.zlogin ]] && builtin source $ZDOTDIR/.zlogin
 unset _meridian_zdotdir
+for _meridian_var in ${(s:,:)MERIDIAN_ACCOUNT_VARS}; do
+  _meridian_set=MERIDIAN_ACCOUNT_SET_$_meridian_var
+  if (( ${+parameters[$_meridian_set]} )); then
+    export $_meridian_var=${(P)_meridian_set}
+    unset $_meridian_set
+  else
+    unset $_meridian_var
+  fi
+done
+unset MERIDIAN_ACCOUNT_VARS _meridian_var _meridian_set
 )";
 
 void AddShellClaude(LaunchSpec& spec, const McpBridge& bridge) {
diff --git a/chrome/browser/meridian/workbench/workbench_handler.cc b/chrome/browser/meridian/workbench/workbench_handler.cc
index f3a808201c..0a185745c5 100644
--- a/chrome/browser/meridian/workbench/workbench_handler.cc
+++ b/chrome/browser/meridian/workbench/workbench_handler.cc
@@ -2752,6 +2752,18 @@ void WorkbenchHandler::ContinueTerminal(base::DictValue opts,
               env[name] = value;
             }
             ai::ApplyAccountEnv(account_env, env);
+            // A shell's startup files may set the variables again: its
+            // .zlogin (agents.cc) puts the account's back.
+            if (kind == "shell" && !account_env.empty()) {
+              std::vector<std::string> names;
+              for (const auto& [name, value] : account_env) {
+                names.push_back(name);
+                if (!value.empty()) {
+                  env["MERIDIAN_ACCOUNT_SET_" + name] = value;
+                }
+              }
+              env["MERIDIAN_ACCOUNT_VARS"] = base::JoinString(names, ",");
+            }
             std::string id = "t" + base::NumberToString(++self->term_seq_);
             Terminal::Spec run;
             run.argv = spec->argv;
