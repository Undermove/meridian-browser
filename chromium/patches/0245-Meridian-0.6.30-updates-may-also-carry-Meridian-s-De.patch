From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Tue, 24 Nov 2026 14:46:15 +0400
Subject: [PATCH] Meridian 0.6.30: updates may also carry Meridian's Developer
 ID

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/update_check.cc          |  4 +++-
 chrome/browser/meridian/update_check.h           |  4 ++--
 chrome/browser/meridian/update_check_unittest.cc | 11 ++++++++---
 3 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/meridian/update_check.cc b/chrome/browser/meridian/update_check.cc
index fd5e4eff68..ba514b7dc5 100644
--- a/chrome/browser/meridian/update_check.cc
+++ b/chrome/browser/meridian/update_check.cc
@@ -56,7 +56,9 @@ std::string TrustedRequirement(const std::string& running) {
   }
   for (std::string_view team : kTrustedTeams) {
     any.push_back(base::StrCat(
-        {"(anchor apple generic and certificate leaf[subject.OU] = \"", team,
+        {"(anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] "
+         "and certificate leaf[field.1.2.840.113635.100.6.1.13] and "
+         "certificate leaf[subject.OU] = \"", team,
          "\" and identifier \"dev.meridian.browser\")"}));
   }
   return base::JoinString(any, " or ");
diff --git a/chrome/browser/meridian/update_check.h b/chrome/browser/meridian/update_check.h
index 02e7093565..e0ae9905e8 100644
--- a/chrome/browser/meridian/update_check.h
+++ b/chrome/browser/meridian/update_check.h
@@ -18,7 +18,7 @@
 namespace meridian::update {
 
 // This build's version (the release tag without "v").
-inline constexpr char kVersion[] = "0.6.29";
+inline constexpr char kVersion[] = "0.6.30";
 
 // GitHub's latest release of Meridian.
 inline constexpr char kFeed[] =
@@ -41,7 +41,7 @@ inline constexpr char kVersionFile[] = "Contents/Resources/meridian-version";
 // the certificate of the running app. Moving to a new certificate takes a
 // release that trusts it first (see SECURITY.md).
 // e.g. {"ABCDE12345"}.
-inline constexpr std::array<std::string_view, 0> kTrustedTeams = {};
+inline constexpr std::array<std::string_view, 1> kTrustedTeams = {"323MYL73WD"};
 
 // The code-signing requirement an update must meet: signed like the running
 // app (`running`, its designated requirement; empty for ad-hoc) or by one of
diff --git a/chrome/browser/meridian/update_check_unittest.cc b/chrome/browser/meridian/update_check_unittest.cc
index b9bdf0be3a..650cda905c 100644
--- a/chrome/browser/meridian/update_check_unittest.cc
+++ b/chrome/browser/meridian/update_check_unittest.cc
@@ -27,12 +27,17 @@ namespace meridian::update {
 namespace {
 
 TEST(UpdateCheckTest, TrustsTheRunningCertificate) {
+  const std::string team =
+      "(anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] "
+      "and certificate leaf[field.1.2.840.113635.100.6.1.13] and certificate "
+      "leaf[subject.OU] = \"323MYL73WD\" and identifier "
+      "\"dev.meridian.browser\")";
   EXPECT_EQ(TrustedRequirement("identifier \"dev.meridian.browser\" and "
                                "certificate root = H\"3c14\""),
             "(identifier \"dev.meridian.browser\" and certificate root = "
-            "H\"3c14\")");
-  // Ad-hoc and no trusted teams yet: nothing to check against.
-  EXPECT_EQ(TrustedRequirement(""), "");
+            "H\"3c14\") or " + team);
+  // Ad-hoc: only a Developer ID of the trusted team is accepted.
+  EXPECT_EQ(TrustedRequirement(""), team);
 }
 
 TEST(UpdateCheckTest, ComparesVersions) {
