--- a/chrome/browser/meridian/mission/mission_control.cc
+++ b/chrome/browser/meridian/mission/mission_control.cc
@@ -422,6 +422,27 @@ std::string MissionControl::AgentLine(const Node& n) {
              : n.label + " · " + n.sublabel;
 }
 
+void MissionControl::SetBackgroundTasks(
+    int owner_tab,
+    const std::map<std::string, int>& counts) {
+  bool changed = false;
+  for (auto& [id, node] : nodes_) {
+    if (node.owner_tab != owner_tab || node.term_id.empty() ||
+        node.ended_at) {
+      continue;
+    }
+    auto it = counts.find(node.term_id);
+    int n = it == counts.end() ? 0 : it->second;
+    if (n != node.background) {
+      node.background = n;
+      changed = true;
+    }
+  }
+  if (changed) {
+    Changed();
+  }
+}
+
