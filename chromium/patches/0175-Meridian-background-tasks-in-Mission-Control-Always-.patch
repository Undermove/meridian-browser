   }
 
+  // Don't ask again: agents get full control (Settings > AI > Agent access
+  // brings the questions back); this question and the waiting ones are
+  // allowed.
+  protected async onAlwaysClick_() {
+    if (performance.now() - this.shownAt_ < ALLOW_DELAY_MS) {
+      return;
+    }
+    const {settings} = await this.handler_.getSettings();
+    this.handler_.setSettings({...settings, agentAccess: 'full'});
+    while (this.question_) {
+      this.answer_(true);
+    }
+  }
+
   protected onCardKeydown_(e: KeyboardEvent) {
     if (e.key === 'Escape') {
       e.preventDefault();
