     int owner_tab,
     const std::map<std::string, std::string>& names) {
@@ -1134,6 +1155,7 @@ base::DictValue MissionControl::Snapshot() const {
                                  ? OptString(n.sublabel)
                                  : base::Value(AgentLine(n)))
