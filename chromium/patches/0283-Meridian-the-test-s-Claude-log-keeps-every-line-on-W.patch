From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Wed, 25 Nov 2026 12:38:44 +0400
Subject: [PATCH 283/297] Meridian: the test's Claude log keeps every line on
 Windows

Under --meridian-test-claude-log, OpenInClaude appended each link with
base::AppendToFile, which on Windows opens the file with no sharing: when
the test was reading the log at that moment, the line was lost and the
showcase test waited for a request that never came. base::File with
FLAG_APPEND shares the file. Test switch only, no change for people.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/meridian/sidebar_handler.cc | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index e5aa237b7c..64393d8414 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -34,6 +34,8 @@
 #include "base/task/thread_pool.h"
 #include "base/environment.h"
 #include "base/json/json_writer.h"
+#include "base/containers/span.h"
+#include "base/files/file.h"
 #include "base/files/file_util.h"
 #include "base/memory/ref_counted.h"
 #include "base/process/launch.h"
@@ -2508,12 +2510,12 @@ void SidebarHandler::OpenInClaude(const std::string& request,
           FROM_HERE, {base::MayBlock()},
           base::BindOnce(
               [](base::FilePath log, std::string line) {
+                // base::File lets others read while it writes: the test reads
+                // the log meanwhile, and on Windows AppendToFile then fails.
                 line += "\n";
-                if (!base::PathExists(log)) {
-                  base::WriteFile(log, line);
-                } else {
-                  base::AppendToFile(log, line);
-                }
+                base::File file(log, base::File::FLAG_OPEN_ALWAYS |
+                                         base::File::FLAG_APPEND);
+                file.WriteAtCurrentPos(base::as_byte_span(line));
               },
               log, link));
     }
