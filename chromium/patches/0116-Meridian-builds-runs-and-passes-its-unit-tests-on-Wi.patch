diff --git a/chrome/browser/meridian/win/posix_files.cc b/chrome/browser/meridian/win/posix_files.cc
new file mode 100644
index 0000000000..c97ccf8742
--- /dev/null
+++ b/chrome/browser/meridian/win/posix_files.cc
@@ -0,0 +1,498 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/win/posix_files.h"
+
+#include <windows.h>
+
+#include <io.h>
+#include <winioctl.h>
+
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <string>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/meridian/real_path.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr DWORD kShareAll =
+    FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE;
+// The tag of the file an AF_UNIX socket is bound to.
+constexpr DWORD kTagAfUnix = 0x80000023;
+
+// "\\?\C:\…" (or "\\?\UNC\…") of what `handle` has open; empty on failure.
+std::wstring FinalPath(HANDLE handle) {
+  std::wstring path(32768, L'\0');
+  DWORD length = ::GetFinalPathNameByHandleW(
+      handle, path.data(), static_cast<DWORD>(path.size()),
+      FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
+  if (length == 0 || length >= path.size()) {
+    return std::wstring();
+  }
+  path.resize(length);
+  return path;
+}
+
+HANDLE HandleOf(int fd) {
+  return reinterpret_cast<HANDLE>(_get_osfhandle(fd));
+}
+
+void SetErrno() {
+  switch (::GetLastError()) {
+    case ERROR_FILE_NOT_FOUND:
+    case ERROR_PATH_NOT_FOUND:
+    case ERROR_INVALID_NAME:
+    case ERROR_BAD_PATHNAME:
+      errno = ENOENT;
+      break;
+    case ERROR_FILE_EXISTS:
+    case ERROR_ALREADY_EXISTS:
+      errno = EEXIST;
+      break;
+    case ERROR_DIR_NOT_EMPTY:
+      errno = ENOTEMPTY;
+      break;
+    case ERROR_DIRECTORY:
+      errno = ENOTDIR;
+      break;
+    default:
+      errno = EACCES;
+  }
+}
+
+bool Fill(HANDLE handle, struct posix::stat* st) {
+  BY_HANDLE_FILE_INFORMATION info;
+  if (!::GetFileInformationByHandle(handle, &info)) {
+    SetErrno();
+    return false;
+  }
+  *st = {};
+  st->st_dev = info.dwVolumeSerialNumber;
+  st->st_ino = (static_cast<uint64_t>(info.nFileIndexHigh) << 32) |
+               info.nFileIndexLow;
+  st->st_nlink = info.nNumberOfLinks;
+  st->st_size = (static_cast<int64_t>(info.nFileSizeHigh) << 32) |
+                info.nFileSizeLow;
+  base::Time modified = base::Time::FromFileTime(info.ftLastWriteTime);
+  st->st_mtime = modified.ToTimeT();
+  st->mtime_internal = modified.ToDeltaSinceWindowsEpoch().InMicroseconds();
+  DWORD tag = 0;
+  if (info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) {
+    FILE_ATTRIBUTE_TAG_INFO tag_info;
+    if (::GetFileInformationByHandleEx(handle, FileAttributeTagInfo, &tag_info,
+                                       sizeof(tag_info))) {
+      tag = tag_info.ReparseTag;
+    }
+  }
+  if (tag == kTagAfUnix) {
+    st->st_mode = MERIDIAN_S_IFSOCK;
+  } else if (tag && IsReparseTagNameSurrogate(tag)) {
+    // A symbolic link or a junction, seen because the handle was opened on
+    // the link itself.
+    st->st_mode = MERIDIAN_S_IFLNK;
+  } else if (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+    st->st_mode = MERIDIAN_S_IFDIR;
+  } else if (::GetFileType(handle) == FILE_TYPE_DISK) {
+    st->st_mode = MERIDIAN_S_IFREG;
+  } else {
+    st->st_mode = 0x2000;
+  }
+  return true;
+}
+
+// A handle for looking at `path`, not for reading it.
+HANDLE OpenForStat(const std::wstring& path, bool follow) {
+  return ::CreateFileW(path.c_str(), FILE_READ_ATTRIBUTES, kShareAll, nullptr,
+                       OPEN_EXISTING,
+                       FILE_FLAG_BACKUP_SEMANTICS |
+                           (follow ? 0 : FILE_FLAG_OPEN_REPARSE_POINT),
+                       nullptr);
+}
+
+int StatWide(const std::wstring& path, bool follow, struct posix::stat* st) {
+  HANDLE handle = OpenForStat(path, follow);
+  if (handle == INVALID_HANDLE_VALUE) {
+    SetErrno();
+    return -1;
+  }
+  bool filled = Fill(handle, st);
+  ::CloseHandle(handle);
+  return filled ? 0 : -1;
+}
+
+int OpenWide(const std::wstring& path, int flags) {
+  const int access = flags & (O_RDONLY | O_WRONLY | O_RDWR);
+  DWORD desired = FILE_READ_ATTRIBUTES;
+  if (access == O_RDONLY || access == O_RDWR) {
+    desired |= GENERIC_READ;
+  }
+  if (access == O_WRONLY || access == O_RDWR) {
+    desired |= GENERIC_WRITE;
+  }
+  DWORD disposition = OPEN_EXISTING;
+  if ((flags & O_CREAT) && (flags & O_EXCL)) {
+    disposition = CREATE_NEW;
+  } else if ((flags & O_CREAT) && (flags & O_TRUNC)) {
+    disposition = CREATE_ALWAYS;
+  } else if (flags & O_CREAT) {
+    disposition = OPEN_ALWAYS;
+  } else if (flags & O_TRUNC) {
+    disposition = TRUNCATE_EXISTING;
+  }
+  // Not inherited by child processes (O_CLOEXEC is how it always is here).
+  HANDLE handle = ::CreateFileW(
+      path.c_str(), desired, kShareAll, nullptr, disposition,
+      FILE_FLAG_BACKUP_SEMANTICS |
+          ((flags & O_NOFOLLOW) ? FILE_FLAG_OPEN_REPARSE_POINT : 0),
+      nullptr);
+  if (handle == INVALID_HANDLE_VALUE) {
+    SetErrno();
+    return -1;
+  }
+  struct posix::stat st;
+  if (!Fill(handle, &st)) {
+    ::CloseHandle(handle);
+    return -1;
+  }
+  if ((flags & O_NOFOLLOW) && S_ISLNK(st.st_mode)) {
+    ::CloseHandle(handle);
+    errno = ELOOP;
+    return -1;
+  }
+  if ((flags & O_DIRECTORY) && !S_ISDIR(st.st_mode)) {
+    ::CloseHandle(handle);
+    errno = ENOTDIR;
+    return -1;
+  }
+  int fd = _open_osfhandle(reinterpret_cast<intptr_t>(handle),
+                           _O_BINARY | _O_NOINHERIT |
+                               (access == O_RDONLY ? _O_RDONLY : 0));
+  if (fd < 0) {
+    ::CloseHandle(handle);
+    errno = EMFILE;
+  }
+  return fd;
+}
+
+// `name` inside the folder open as `dir`: one name, never a path.
+std::wstring Inside(int dir, const char* name) {
+  std::string_view n(name);
+  if (n.empty() || n == "." || n == ".." ||
+      n.find_first_of("/\\:") != std::string_view::npos) {
+    errno = ENOENT;
+    return std::wstring();
+  }
+  std::wstring folder = FinalPath(HandleOf(dir));
+  if (folder.empty()) {
+    errno = EBADF;
+    return std::wstring();
+  }
+  return folder + L"\\" + base::UTF8ToWide(n);
+}
+
+}  // namespace
+
+base::FilePath RealFilePath(const base::FilePath& path) {
+  HANDLE handle = OpenForStat(path.value(), true);
+  if (handle == INVALID_HANDLE_VALUE) {
+    return base::FilePath();
+  }
+  std::wstring real = FinalPath(handle);
+  ::CloseHandle(handle);
+  // "\\?\C:\…" → "C:\…", "\\?\UNC\server\share" → "\\server\share".
+  if (real.starts_with(L"\\\\?\\UNC\\")) {
+    real = L"\\\\" + real.substr(8);
+  } else if (real.starts_with(L"\\\\?\\")) {
+    real.erase(0, 4);
+  }
+  return base::FilePath(real);
+}
+
+namespace posix {
+
+base::File::Info InfoFromStat(const struct stat& st) {
+  base::File::Info info;
+  info.size = st.st_size;
+  info.is_directory = S_ISDIR(st.st_mode);
+  info.is_symbolic_link = S_ISLNK(st.st_mode);
+  info.last_modified = base::Time::FromDeltaSinceWindowsEpoch(
+      base::Microseconds(st.mtime_internal));
+  info.last_accessed = info.last_modified;
+  info.creation_time = info.last_modified;
+  return info;
+}
+
+void FdCloser::Free(int fd) {
+  _close(fd);
+}
+
+bool WriteFileDescriptor(int fd, std::string_view data) {
+  while (!data.empty()) {
+    int n = _write(fd, data.data(),
+                   static_cast<unsigned>(std::min<size_t>(
+                       data.size(), std::numeric_limits<int>::max())));
+    if (n <= 0) {
+      return false;
+    }
+    data.remove_prefix(static_cast<size_t>(n));
+  }
+  return true;
+}
+
+int open(const char* path, int flags, int mode) {
+  return OpenWide(base::UTF8ToWide(path), flags);
+}
+
+int openat(int dir, const char* name, int flags, int mode) {
+  std::wstring path = Inside(dir, name);
+  return path.empty() ? -1 : OpenWide(path, flags);
+}
+
+int close(int fd) {
+  return _close(fd);
+}
+
+int dup(int fd) {
+  return _dup(fd);
+}
+
+ssize_t read(int fd, void* buffer, size_t size) {
+  return _read(fd, buffer,
+               static_cast<unsigned>(std::min<size_t>(
+                   size, std::numeric_limits<int>::max())));
+}
+
+ssize_t pread(int fd, void* buffer, size_t size, int64_t offset) {
+  OVERLAPPED at = {};
+  at.Offset = static_cast<DWORD>(offset & 0xffffffff);
+  at.OffsetHigh = static_cast<DWORD>(offset >> 32);
+  DWORD n = 0;
+  if (!::ReadFile(HandleOf(fd), buffer,
+                  static_cast<DWORD>(std::min<size_t>(
+                      size, std::numeric_limits<int>::max())),
+                  &n, &at)) {
+    if (::GetLastError() == ERROR_HANDLE_EOF) {
+      return 0;
+    }
+    SetErrno();
+    return -1;
+  }
+  return n;
+}
+
+int ftruncate(int fd, int64_t size) {
+  return _chsize_s(fd, size) == 0 ? 0 : -1;
+}
+
+int stat(const char* path, struct stat* st) {
+  return StatWide(base::UTF8ToWide(path), true, st);
+}
+
+int lstat(const char* path, struct stat* st) {
+  return StatWide(base::UTF8ToWide(path), false, st);
+}
+
+int fstat(int fd, struct stat* st) {
+  return Fill(HandleOf(fd), st) ? 0 : -1;
+}
+
+int fstatat(int dir, const char* name, struct stat* st, int flags) {
+  std::wstring path = Inside(dir, name);
+  return path.empty()
+             ? -1
+             : StatWide(path, !(flags & AT_SYMLINK_NOFOLLOW), st);
+}
+
+int mkdir(const char* path, int mode) {
+  if (::CreateDirectoryW(base::UTF8ToWide(path).c_str(), nullptr)) {
+    return 0;
+  }
+  SetErrno();
+  return -1;
+}
+
+int rmdir(const char* path) {
+  if (::RemoveDirectoryW(base::UTF8ToWide(path).c_str())) {
+    return 0;
+  }
+  SetErrno();
+  return -1;
+}
+
+int unlink(const char* path) {
+  std::wstring wide = base::UTF8ToWide(path);
+  if (::DeleteFileW(wide.c_str())) {
+    return 0;
+  }
+  // A link to a folder is a folder entry here; removing it leaves what it
+  // points at alone, as unlink() does.
+  DWORD attributes = ::GetFileAttributesW(wide.c_str());
+  if (attributes != INVALID_FILE_ATTRIBUTES &&
+      (attributes & FILE_ATTRIBUTE_DIRECTORY) &&
+      (attributes & FILE_ATTRIBUTE_REPARSE_POINT) &&
+      ::RemoveDirectoryW(wide.c_str())) {
+    return 0;
+  }
+  SetErrno();
+  return -1;
+}
+
+int rename(const char* from, const char* to) {
+  if (::MoveFileExW(base::UTF8ToWide(from).c_str(),
+                    base::UTF8ToWide(to).c_str(), MOVEFILE_REPLACE_EXISTING)) {
+    return 0;
+  }
+  SetErrno();
+  return -1;
+}
+
+int renameat(int from_dir,
+             const char* from_name,
+             int to_dir,
+             const char* to_name) {
+  std::wstring from = Inside(from_dir, from_name);
+  std::wstring to = Inside(to_dir, to_name);
+  if (from.empty() || to.empty()) {
+    return -1;
+  }
+  if (::MoveFileExW(from.c_str(), to.c_str(), 0)) {
+    return 0;
+  }
+  SetErrno();
+  return -1;
+}
+
+int access(const char* path, int mode) {
+  DWORD attributes = ::GetFileAttributesW(base::UTF8ToWide(path).c_str());
+  if (attributes == INVALID_FILE_ATTRIBUTES) {
+    SetErrno();
+    return -1;
+  }
+  if (mode == X_OK && (attributes & FILE_ATTRIBUTE_DIRECTORY)) {
+    errno = EACCES;
+    return -1;
+  }
+  return 0;
+}
+
+ssize_t readlinkat(int dir, const char* name, char* buffer, size_t size) {
+  std::wstring path = Inside(dir, name);
+  if (path.empty()) {
+    return -1;
+  }
+  HANDLE handle = OpenForStat(path, false);
+  if (handle == INVALID_HANDLE_VALUE) {
+    SetErrno();
+    return -1;
+  }
+  // REPARSE_DATA_BUFFER (ntifs.h): tag (4 bytes), data length (2), reserved
+  // (2); then, for a symbolic link or a junction, the offset and length of
+  // the substitute name and of the print name (2 bytes each), the link's
+  // flags (4, symbolic links only) and the names.
+  std::array<uint8_t, 16 * 1024> data;
+  DWORD got = 0;
+  bool read_ok = ::DeviceIoControl(handle, FSCTL_GET_REPARSE_POINT, nullptr, 0,
+                                   data.data(), static_cast<DWORD>(data.size()),
+                                   &got, nullptr);
+  ::CloseHandle(handle);
+  base::span<const uint8_t> bytes = base::span(data).first(got);
+  if (!read_ok || bytes.size() < 16) {
+    errno = EINVAL;
+    return -1;
+  }
+  uint32_t tag = base::U32FromLittleEndian(bytes.first<4>());
+  size_t names = tag == IO_REPARSE_TAG_SYMLINK       ? 20
+                 : tag == IO_REPARSE_TAG_MOUNT_POINT ? 16
+                                                     : 0;
+  if (!names) {
+    errno = EINVAL;
+    return -1;
+  }
+  size_t offset = base::U16FromLittleEndian(bytes.subspan<8, 2>());
+  size_t length = base::U16FromLittleEndian(bytes.subspan<10, 2>());
+  if (bytes.size() < names + offset + length || length % 2) {
+    errno = EINVAL;
+    return -1;
+  }
+  std::wstring target(length / 2, L'\0');
+  base::as_writable_byte_span(target).copy_from(
+      bytes.subspan(names + offset, length));
+  std::string utf8 = base::WideToUTF8(target);
+  size_t n = std::min(utf8.size(), size);
+  // SAFETY: the caller's buffer holds `size` bytes.
+  UNSAFE_BUFFERS(base::span(buffer, size))
+      .copy_prefix_from(base::span(utf8).first(n));
+  return static_cast<ssize_t>(n);
+}
+
+struct DIR {
+  int fd = -1;
+  std::wstring pattern;
+  HANDLE find = INVALID_HANDLE_VALUE;
+  bool done = false;
+  dirent entry;
+};
+
+DIR* fdopendir(int fd) {
+  std::wstring folder = FinalPath(HandleOf(fd));
+  if (folder.empty()) {
+    errno = EBADF;
+    return nullptr;
+  }
+  DIR* dir = new DIR;
+  dir->fd = fd;
+  dir->pattern = folder + L"\\*";
+  return dir;
+}
+
+dirent* readdir(DIR* dir) {
+  for (;;) {
+    if (dir->done) {
+      return nullptr;
+    }
+    WIN32_FIND_DATAW found;
+    if (dir->find == INVALID_HANDLE_VALUE) {
+      dir->find = ::FindFirstFileExW(dir->pattern.c_str(), FindExInfoBasic,
+                                     &found, FindExSearchNameMatch, nullptr,
+                                     FIND_FIRST_EX_LARGE_FETCH);
+      if (dir->find == INVALID_HANDLE_VALUE) {
+        dir->done = true;
+        return nullptr;
+      }
+    } else if (!::FindNextFileW(dir->find, &found)) {
+      dir->done = true;
+      return nullptr;
+    }
+    std::string name = base::WideToUTF8(found.cFileName);
+    base::span<char> out(dir->entry.d_name);
+    if (name.size() >= out.size()) {
+      continue;  // no name is this long
+    }
+    std::ranges::fill(out, '\0');
+    out.copy_prefix_from(base::span(name));
+    return &dir->entry;
+  }
+}
+
+int closedir(DIR* dir) {
+  if (dir->find != INVALID_HANDLE_VALUE) {
+    ::FindClose(dir->find);
+  }
+  _close(dir->fd);
+  delete dir;
+  return 0;
+}
+
+}  // namespace posix
+
+}  // namespace meridian
