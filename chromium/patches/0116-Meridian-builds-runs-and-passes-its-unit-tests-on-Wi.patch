+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WIN_POSIX_FILES_H_
+#define CHROME_BROWSER_MERIDIAN_WIN_POSIX_FILES_H_
+
+// Windows only. The Workbench reads and writes a project through a handful
+// of POSIX calls chosen for what they promise: an open that refuses a
+// symlink, a file's identity taken from the handle, a name looked up inside
+// a folder that is held open. These are the same calls over Win32 with the
+// same promises, so that code stays one piece instead of growing a second,
+// weaker copy.
+//
+// Paths are UTF-8. Descriptors are the C runtime's (base::ScopedFD closes
+// them, base::WriteFileDescriptor writes to them). A symlink is whatever
+// Windows resolves by name: symbolic links and junctions.
+//
+// A file brings the names into its own namespace with
+// MERIDIAN_USE_POSIX_FILES(), which hides the C runtime's look-alikes there.
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <time.h>
+
+#include <string_view>
+
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/scoped_generic.h"
+
+// Flags the C runtime doesn't have (above its own bits).
+#define O_NOFOLLOW 0x01000000
+#define O_CLOEXEC 0x02000000
+#define O_NONBLOCK 0x04000000
+#define O_DIRECTORY 0x08000000
+#ifndef O_RDONLY
+#define O_RDONLY _O_RDONLY
+#define O_WRONLY _O_WRONLY
+#define O_RDWR _O_RDWR
+#define O_CREAT _O_CREAT
+#define O_EXCL _O_EXCL
+#define O_TRUNC _O_TRUNC
+#endif
+
+#define AT_SYMLINK_NOFOLLOW 0x100
+#ifndef X_OK
+#define X_OK 1
+#endif
+#ifndef PATH_MAX
+#define PATH_MAX 4096
+#endif
+
+// File types in st_mode.
+#define MERIDIAN_S_IFMT 0xF000
+#define MERIDIAN_S_IFDIR 0x4000
+#define MERIDIAN_S_IFREG 0x8000
+#define MERIDIAN_S_IFLNK 0xA000
+#define MERIDIAN_S_IFSOCK 0xC000
+#undef S_ISDIR
+#undef S_ISREG
+#undef S_ISLNK
+#undef S_ISSOCK
+#define S_ISDIR(m) (((m) & MERIDIAN_S_IFMT) == MERIDIAN_S_IFDIR)
+#define S_ISREG(m) (((m) & MERIDIAN_S_IFMT) == MERIDIAN_S_IFREG)
+#define S_ISLNK(m) (((m) & MERIDIAN_S_IFMT) == MERIDIAN_S_IFLNK)
+#define S_ISSOCK(m) (((m) & MERIDIAN_S_IFMT) == MERIDIAN_S_IFSOCK)
+
+namespace meridian::posix {
+
+using ssize_t = ptrdiff_t;
+
+// `st_dev` and `st_ino` together name one file on this machine (the volume's
+// serial number and the file's index on it).
+struct stat {
+  uint64_t st_dev = 0;
+  uint64_t st_ino = 0;
+  int st_mode = 0;
+  uint32_t st_nlink = 0;
+  int64_t st_size = 0;
+  // Seconds since 1970.
+  time_t st_mtime = 0;
+  // As base::Time keeps it.
+  int64_t mtime_internal = 0;
+};
+
+// base::File::Info::FromStat.
+base::File::Info InfoFromStat(const struct stat& st);
+
+// base::ScopedFD and base::WriteFileDescriptor, which base only has on
+// POSIX.
+struct FdCloser {
+  static int InvalidValue() { return -1; }
+  static void Free(int fd);
+};
+using ScopedFD = base::ScopedGeneric<int, FdCloser>;
+bool WriteFileDescriptor(int fd, std::string_view data);
+
+int open(const char* path, int flags, int mode = 0);
+// `name` inside the folder open as `dir`.
+int openat(int dir, const char* name, int flags, int mode = 0);
+int close(int fd);
+int dup(int fd);
+ssize_t read(int fd, void* buffer, size_t size);
+ssize_t pread(int fd, void* buffer, size_t size, int64_t offset);
+int ftruncate(int fd, int64_t size);
+
+int stat(const char* path, struct stat* st);
+int lstat(const char* path, struct stat* st);
+int fstat(int fd, struct stat* st);
+int fstatat(int dir, const char* name, struct stat* st, int flags);
+
+int mkdir(const char* path, int mode);
+int rmdir(const char* path);
+int unlink(const char* path);
+// Replaces `to`, as POSIX does.
+int rename(const char* from, const char* to);
+// Never replaces: fails when `to_name` is there.
+int renameat(int from_dir,
+             const char* from_name,
+             int to_dir,
+             const char* to_name);
+// X_OK: a file that is there (Windows has no executable bit).
+int access(const char* path, int mode);
+// Where the link `name` in `dir` points, as it is written in the link.
+ssize_t readlinkat(int dir, const char* name, char* buffer, size_t size);
+
+struct dirent {
+  char d_name[1024];
+};
+struct DIR;
+// Takes `fd` over (closedir() closes it).
+DIR* fdopendir(int fd);
+dirent* readdir(DIR* dir);
+int closedir(DIR* dir);
+
+}  // namespace meridian::posix
+
+#define MERIDIAN_USE_POSIX_FILES()   \
+  using ::meridian::posix::access;   \
+  using ::meridian::posix::close;    \
+  using ::meridian::posix::closedir; \
+  using ::meridian::posix::DIR;      \
+  using ::meridian::posix::dirent;   \
+  using ::meridian::posix::dup;      \
+  using ::meridian::posix::fdopendir; \
+  using ::meridian::posix::fstat;    \
+  using ::meridian::posix::fstatat;  \
+  using ::meridian::posix::ftruncate; \
+  using ::meridian::posix::lstat;    \
+  using ::meridian::posix::mkdir;    \
+  using ::meridian::posix::open;     \
+  using ::meridian::posix::openat;   \
+  using ::meridian::posix::pread;    \
+  using ::meridian::posix::read;     \
+  using ::meridian::posix::readdir;  \
+  using ::meridian::posix::readlinkat; \
+  using ::meridian::posix::rename;   \
+  using ::meridian::posix::renameat; \
+  using ::meridian::posix::rmdir;    \
+  using ::meridian::posix::ScopedFD; \
+  using ::meridian::posix::WriteFileDescriptor; \
+  using ::meridian::posix::ssize_t;  \
+  using ::meridian::posix::stat;     \
+  using ::meridian::posix::unlink
+
+#endif  // CHROME_BROWSER_MERIDIAN_WIN_POSIX_FILES_H_
diff --git a/chrome/browser/meridian/win/posix_sockets.h b/chrome/browser/meridian/win/posix_sockets.h
new file mode 100644
index 0000000000..0787c6b0d7
--- /dev/null
+++ b/chrome/browser/meridian/win/posix_sockets.h
@@ -0,0 +1,200 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WIN_POSIX_SOCKETS_H_
+#define CHROME_BROWSER_MERIDIAN_WIN_POSIX_SOCKETS_H_
+
+// Windows only; included through local_socket.h. Meridian's helper processes
+// (the hooks of the coding agents, the MCP bridge) talk to the browser over
+// unix-domain sockets, which Windows has too, through Winsock. These are the
+// POSIX calls that code is written with, over Winsock, for sockets only: a
+// descriptor here is a SOCKET, never a file.
+
+#include <winsock2.h>
+
+#include <afunix.h>
+#include <errno.h>
+#include <stddef.h>
+#include <ws2tcpip.h>
+
+#include <string_view>
+#include <vector>
+
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/scoped_generic.h"
+
+namespace meridian::posix_sockets {
+
+using ssize_t = ptrdiff_t;
+
+// Winsock's own pollfd holds a SOCKET.
+struct pollfd {
+  int fd;
+  short events;
+  short revents;
+};
+
+inline void Init() {
+  [[maybe_unused]] static const bool started = [] {
+    WSADATA data;
+    return ::WSAStartup(MAKEWORD(2, 2), &data) == 0;
+  }();
+}
+
+// Handles are small numbers: they fit.
+inline int ToFd(SOCKET s) {
+  return s == INVALID_SOCKET ? -1 : static_cast<int>(s);
+}
+
+inline SOCKET ToSocket(int fd) {
+  return fd < 0 ? INVALID_SOCKET : static_cast<SOCKET>(fd);
+}
+
+inline int socket(int family, int type, int protocol) {
+  Init();
+  return ToFd(::socket(family, type, protocol));
+}
+
+inline int bind(int fd, const sockaddr* address, size_t size) {
+  return ::bind(ToSocket(fd), address, static_cast<int>(size)) == 0 ? 0 : -1;
+}
+
+inline int listen(int fd, int backlog) {
+  return ::listen(ToSocket(fd), backlog) == 0 ? 0 : -1;
+}
+
+inline int accept(int fd, sockaddr* address, int* size) {
+  return ToFd(::accept(ToSocket(fd), address, size));
+}
+
+inline int connect(int fd, const sockaddr* address, size_t size) {
+  return ::connect(ToSocket(fd), address, static_cast<int>(size)) == 0 ? 0
+                                                                       : -1;
+}
+
+inline ssize_t read(int fd, void* buffer, size_t size) {
+  int n = ::recv(ToSocket(fd), static_cast<char*>(buffer),
+                 static_cast<int>(size), 0);
+  if (n < 0) {
+    errno = ::WSAGetLastError() == WSAEWOULDBLOCK ? EAGAIN : EIO;
+  }
+  return n;
+}
+
+inline ssize_t write(int fd, const void* buffer, size_t size) {
+  int n = ::send(ToSocket(fd), static_cast<const char*>(buffer),
+                 static_cast<int>(size), 0);
+  if (n < 0) {
+    errno = ::WSAGetLastError() == WSAEWOULDBLOCK ? EAGAIN : EIO;
+  }
+  return n;
+}
+
+inline int close(int fd) {
+  return ::closesocket(ToSocket(fd)) == 0 ? 0 : -1;
+}
+
+inline int poll(pollfd* fds, size_t count, int timeout_ms) {
+  std::vector<WSAPOLLFD> native(count);
+  // SAFETY: the caller passes `count` entries.
+  auto entries = UNSAFE_BUFFERS(base::span(fds, count));
+  for (size_t i = 0; i < count; ++i) {
+    native[i] = {ToSocket(entries[i].fd), entries[i].events, 0};
+  }
+  int ready =
+      ::WSAPoll(native.data(), static_cast<ULONG>(count), timeout_ms);
+  for (size_t i = 0; i < count; ++i) {
+    entries[i].revents = ready > 0 ? native[i].revents : 0;
+  }
+  return ready;
+}
+
+// A connected pair standing in for a pipe (fds[0] reads what fds[1] writes),
+// so that it can sit in poll() next to the sockets: over the loopback
+// interface, the one end checked to be the other's peer.
+inline int pipe(int* fds) {
+  Init();
+  SOCKET listener = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+  SOCKET writer = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+  SOCKET reader = INVALID_SOCKET;
+  sockaddr_in address = {};
+  address.sin_family = AF_INET;
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  int size = sizeof(address);
+  sockaddr_in ours = {};
+  sockaddr_in theirs = {};
+  int ours_size = sizeof(ours);
+  int theirs_size = sizeof(theirs);
+  bool ok =
+      listener != INVALID_SOCKET && writer != INVALID_SOCKET &&
+      ::bind(listener, reinterpret_cast<sockaddr*>(&address), size) == 0 &&
+      ::listen(listener, 1) == 0 &&
+      ::getsockname(listener, reinterpret_cast<sockaddr*>(&address), &size) ==
+          0 &&
+      ::connect(writer, reinterpret_cast<sockaddr*>(&address), size) == 0 &&
+      (reader = ::accept(listener, nullptr, nullptr)) != INVALID_SOCKET &&
+      ::getsockname(writer, reinterpret_cast<sockaddr*>(&ours), &ours_size) ==
+          0 &&
+      ::getpeername(reader, reinterpret_cast<sockaddr*>(&theirs),
+                    &theirs_size) == 0 &&
+      ours.sin_port == theirs.sin_port;
+  if (listener != INVALID_SOCKET) {
+    ::closesocket(listener);
+  }
+  if (!ok) {
+    if (writer != INVALID_SOCKET) {
+      ::closesocket(writer);
+    }
+    if (reader != INVALID_SOCKET) {
+      ::closesocket(reader);
+    }
+    return -1;
+  }
+  // SAFETY: pipe() takes two descriptors.
+  auto pair = UNSAFE_BUFFERS(base::span(fds, 2u));
+  pair[0] = ToFd(reader);
+  pair[1] = ToFd(writer);
+  return 0;
+}
+
+inline void SetSocketNonBlocking(int fd) {
+  u_long on = 1;
+  ::ioctlsocket(ToSocket(fd), FIONBIO, &on);
+}
+
+inline bool WriteSocket(int fd, std::string_view data) {
+  while (!data.empty()) {
+    ssize_t n = write(fd, data.data(), data.size());
+    if (n <= 0) {
+      return false;
+    }
+    data.remove_prefix(static_cast<size_t>(n));
+  }
+  return true;
+}
+
+struct SocketCloser {
+  static int InvalidValue() { return -1; }
+  static void Free(int fd) { ::closesocket(ToSocket(fd)); }
+};
+using ScopedSocket = base::ScopedGeneric<int, SocketCloser>;
+
+}  // namespace meridian::posix_sockets
+
+#define MERIDIAN_USE_POSIX_SOCKETS()         \
+  using ::meridian::posix_sockets::accept;   \
+  using ::meridian::posix_sockets::bind;     \
+  using ::meridian::posix_sockets::close;    \
+  using ::meridian::posix_sockets::connect;  \
+  using ::meridian::posix_sockets::listen;   \
+  using ::meridian::posix_sockets::pipe;     \
+  using ::meridian::posix_sockets::poll;     \
+  using ::meridian::posix_sockets::pollfd;   \
+  using ::meridian::posix_sockets::read;     \
+  using ::meridian::posix_sockets::socket;   \
+  using ::meridian::posix_sockets::ssize_t;  \
+  using ::meridian::posix_sockets::write
+
+#endif  // CHROME_BROWSER_MERIDIAN_WIN_POSIX_SOCKETS_H_
