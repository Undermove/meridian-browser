@@ -0,0 +1,47 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_REAL_PATH_H_
+#define CHROME_BROWSER_MERIDIAN_REAL_PATH_H_
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "build/build_config.h"
+
+namespace meridian {
+
+// Where `path` really is: absolute, through every symlink on the way; empty
+// when nothing is there. What Meridian compares before trusting that a path
+// lies inside a folder. Blocking.
+//
+// realpath() everywhere but Windows, where base::MakeAbsoluteFilePath only
+// tidies the text of a path (it neither follows links nor looks at the
+// disk): there it is the final path of the opened file (win/posix_files.cc).
+#if BUILDFLAG(IS_WIN)
+base::FilePath RealFilePath(const base::FilePath& path);
+#else
+inline base::FilePath RealFilePath(const base::FilePath& path) {
+  return base::MakeAbsoluteFilePath(path);
+}
+#endif
+
+// A path inside a project or folder as the Workbench's page, the agents and
+// the files Meridian keeps write it: with "/" between the names on every
+// system (Windows's own paths have "\").
+inline std::string SlashPath(const base::FilePath& relative) {
+  return relative.NormalizePathSeparatorsTo('/').AsUTF8Unsafe();
+}
+
+// For base::FileEnumerator: symlinks listed as the links they are, not as
+// what they point at. Windows always lists them that way.
+#if BUILDFLAG(IS_WIN)
+inline constexpr int kShowSymLinks = 0;
+#else
+inline constexpr int kShowSymLinks = base::FileEnumerator::SHOW_SYM_LINKS;
+#endif
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_REAL_PATH_H_
