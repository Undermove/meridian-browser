index 0000000000..42b201dce4
--- /dev/null
+++ b/chrome/browser/meridian/workbench/terminal_win.cc
@@ -0,0 +1,320 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/terminal.h"
+
+#include <windows.h>
+
+#include <array>
+#include <atomic>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/memory/ptr_util.h"
+#include "base/memory/ref_counted.h"
+#include "base/process/process.h"
+#include "base/strings/string_view_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/synchronization/lock.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/win/scoped_handle.h"
+
+// The Workbench's terminals on Windows (terminal.cc is the POSIX one): a
+// pseudoconsole (ConPTY) where POSIX has a pty. The program runs in a job,
+// so closing a terminal ends everything started in it, which is what
+// SIGHUP to the process group does there.
+namespace meridian::workbench {
+
+namespace {
+
+int Clamp(int v, int lo, int hi) {
+  return v < lo ? lo : v > hi ? hi : v;
+}
+
+COORD Size(int cols, int rows) {
+  return {static_cast<SHORT>(Clamp(cols, 2, 500)),
+          static_cast<SHORT>(Clamp(rows, 2, 300))};
+}
+
+// The environment as CreateProcess takes it: "NAME=value" strings, each
+// ending with a NUL, then one more NUL.
+std::wstring EnvironmentBlock(const std::map<std::string, std::string>& env) {
+  std::wstring block;
+  for (const auto& [name, value] : env) {
+    block += base::UTF8ToWide(name + "=" + value);
+    block.push_back(L'\0');
+  }
+  block.push_back(L'\0');
+  return block;
+}
+
+}  // namespace
+
+// Reads the pseudoconsole until it closes, then reports how the program
+// ended. Lives on a blocking thread-pool task; the terminal can be gone by
+// then. Writes and resizes run on `writer_`.
+class Terminal::Io : public base::RefCountedThreadSafe<Terminal::Io> {
+ public:
+  Io(base::Process process,
+     base::win::ScopedHandle job,
+     HPCON console,
+     base::win::ScopedHandle input,
+     base::win::ScopedHandle output,
+     DataCallback on_data,
+     ExitCallback on_exit)
+      : process_(std::move(process)),
+        job_(std::move(job)),
+        console_(console),
+        input_(std::move(input)),
+        output_(std::move(output)),
+        writer_(base::ThreadPool::CreateSequencedTaskRunner(
+            {base::MayBlock(),
+             base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN})),
+        on_data_(std::move(on_data)),
+        on_exit_(std::move(on_exit)) {}
+
+  // Ends the program and whatever it started.
+  void Stop() {
+    base::AutoLock hold(lock_);
+    if (!exited_) {
+      ::TerminateJobObject(job_.get(), 1);
+    }
+  }
+
+  void Write(std::string data) {
+    writer_->PostTask(FROM_HERE,
+                      base::BindOnce(&Io::WriteOnWriter,
+                                     base::WrapRefCounted(this),
+                                     std::move(data)));
+  }
+
+  void Resize(COORD size) {
+    writer_->PostTask(FROM_HERE,
+                      base::BindOnce(&Io::ResizeOnWriter,
+                                     base::WrapRefCounted(this), size));
+  }
+
+  void Run() {
+    base::ScopedBlockingCall blocking(FROM_HERE,
+                                      base::BlockingType::WILL_BLOCK);
+    // The pseudoconsole keeps its end of the output pipe open for as long as
+    // it lives, so the pipe alone never says the program is gone: a watcher
+    // closes the pseudoconsole when the program exits, which ends the reads.
+    base::ThreadPool::PostTask(
+        FROM_HERE,
+        {base::MayBlock(), base::WithBaseSyncPrimitives(),
+         base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+        base::BindOnce(&Io::WaitForExit, base::WrapRefCounted(this)));
+    std::array<char, 65536> chunk;
+    std::string pending;
+    for (;;) {
+      DWORD n = 0;
+      if (!::ReadFile(output_.get(), chunk.data(),
+                      static_cast<DWORD>(chunk.size()), &n, nullptr) ||
+          n == 0) {
+        break;
+      }
+      pending.append(base::as_string_view(
+          base::span(chunk).first(static_cast<size_t>(n))));
+      std::string text = TakeCompleteUtf8(pending);
+      if (!text.empty()) {
+        on_data_.Run(std::move(text));
+      }
+    }
+    int code = -1;
+    process_.WaitForExit(&code);
+    std::move(on_exit_).Run(code, 0);
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<Io>;
+  ~Io() { CloseConsole(); }
+
+  void WaitForExit() {
+    base::ScopedBlockingCall blocking(FROM_HERE,
+                                      base::BlockingType::WILL_BLOCK);
+    ::WaitForSingleObject(process_.Handle(), INFINITE);
+    {
+      base::AutoLock hold(lock_);
+      exited_ = true;
+    }
+    // Behind the writes already queued, like the POSIX terminal closes its
+    // descriptor.
+    writer_->PostTask(FROM_HERE, base::BindOnce(&Io::CloseConsole,
+                                                base::WrapRefCounted(this)));
+  }
+
+  void WriteOnWriter(std::string data) {
+    if (!console_) {
+      return;
+    }
+    std::string_view rest(data);
+    while (!rest.empty()) {
+      DWORD n = 0;
+      if (!::WriteFile(input_.get(), rest.data(),
+                       static_cast<DWORD>(rest.size()), &n, nullptr) ||
+          n == 0) {
+        return;
+      }
+      rest.remove_prefix(n);
+    }
+  }
+
+  void ResizeOnWriter(COORD size) {
+    if (console_) {
+      ::ResizePseudoConsole(console_, size);
+    }
+  }
+
+  // On `writer_` (or in the destructor, when nothing else can run).
+  void CloseConsole() {
+    if (console_) {
+      // Flushes what is left into the output pipe and closes it.
+      ::ClosePseudoConsole(console_);
+      console_ = nullptr;
+    }
+    input_.Close();
+  }
+
+  base::Process process_;
+  base::win::ScopedHandle job_;
+  // Only used on `writer_` after the start.
+  HPCON console_;
+  base::win::ScopedHandle input_;
+  base::win::ScopedHandle output_;
+  const scoped_refptr<base::SequencedTaskRunner> writer_;
+  base::Lock lock_;
+  bool exited_ GUARDED_BY(lock_) = false;
+  DataCallback on_data_;
+  ExitCallback on_exit_;
+};
+
+// static
+std::unique_ptr<Terminal> Terminal::Start(const Spec& spec,
+                                          DataCallback on_data,
+                                          ExitCallback on_exit) {
+  if (spec.argv.empty()) {
+    return nullptr;
+  }
+  // The pseudoconsole reads our writes from one pipe and writes what the
+  // program prints into the other.
+  HANDLE console_reads = nullptr;
+  HANDLE we_write = nullptr;
+  HANDLE we_read = nullptr;
+  HANDLE console_writes = nullptr;
+  if (!::CreatePipe(&console_reads, &we_write, nullptr, 0)) {
+    return nullptr;
+  }
+  base::win::ScopedHandle console_in(console_reads);
+  base::win::ScopedHandle input(we_write);
+  if (!::CreatePipe(&we_read, &console_writes, nullptr, 0)) {
+    return nullptr;
+  }
+  base::win::ScopedHandle output(we_read);
+  base::win::ScopedHandle console_out(console_writes);
+  HPCON console = nullptr;
+  if (FAILED(::CreatePseudoConsole(Size(spec.cols, spec.rows),
+                                   console_in.get(), console_out.get(), 0,
+                                   &console))) {
+    return nullptr;
+  }
+  // The pseudoconsole has its own copies now.
+  console_in.Close();
+  console_out.Close();
+
+  base::win::ScopedHandle job(::CreateJobObjectW(nullptr, nullptr));
+  JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits = {};
+  limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+  SIZE_T attributes_size = 0;
+  ::InitializeProcThreadAttributeList(nullptr, 1, 0, &attributes_size);
+  std::vector<char> attributes(attributes_size);
+  STARTUPINFOEXW startup = {};
+  startup.StartupInfo.cb = sizeof(startup);
+  // Standard handles named, and empty: the program takes the
+  // pseudoconsole's. Left unnamed, it would get Meridian's own where those
+  // lead somewhere (a pipe, a log file).
+  startup.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+  startup.lpAttributeList =
+      reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(attributes.data());
+  if (!job.is_valid() ||
+      !::SetInformationJobObject(job.get(), JobObjectExtendedLimitInformation,
+                                 &limits, sizeof(limits)) ||
+      !::InitializeProcThreadAttributeList(startup.lpAttributeList, 1, 0,
+                                           &attributes_size)) {
+    ::ClosePseudoConsole(console);
+    return nullptr;
+  }
+  base::CommandLine command(base::FilePath::FromUTF8Unsafe(spec.argv[0]));
+  for (size_t i = 1; i < spec.argv.size(); ++i) {
+    command.AppendArgNative(base::UTF8ToWide(spec.argv[i]));
+  }
+  std::wstring command_line = command.GetCommandLineString();
+  std::wstring environment = EnvironmentBlock(spec.env);
+  std::wstring cwd = base::UTF8ToWide(spec.cwd);
+  // The folder may be gone: the shell then starts where Meridian is.
+  if (!cwd.empty() &&
+      ::GetFileAttributesW(cwd.c_str()) == INVALID_FILE_ATTRIBUTES) {
+    cwd.clear();
+  }
+  PROCESS_INFORMATION started = {};
+  // Suspended until it is in the job, so nothing it starts escapes it.
+  bool created =
+      ::UpdateProcThreadAttribute(startup.lpAttributeList, 0,
+                                  PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE, console,
+                                  sizeof(console), nullptr, nullptr) &&
+      ::CreateProcessW(nullptr, command_line.data(), nullptr, nullptr, FALSE,
+                       EXTENDED_STARTUPINFO_PRESENT |
+                           CREATE_UNICODE_ENVIRONMENT | CREATE_SUSPENDED,
+                       environment.data(), cwd.empty() ? nullptr : cwd.c_str(),
+                       &startup.StartupInfo, &started);
+  ::DeleteProcThreadAttributeList(startup.lpAttributeList);
+  if (!created) {
+    ::ClosePseudoConsole(console);
+    return nullptr;
+  }
+  base::Process process(started.hProcess);
+  ::AssignProcessToJobObject(job.get(), started.hProcess);
+  ::ResumeThread(started.hThread);
+  ::CloseHandle(started.hThread);
+
+  auto terminal =
+      base::WrapUnique(new Terminal(static_cast<int>(started.dwProcessId)));
+  terminal->io_ = base::MakeRefCounted<Io>(
+      std::move(process), std::move(job), console, std::move(input),
+      std::move(output), std::move(on_data), std::move(on_exit));
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::WithBaseSyncPrimitives(),
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&Io::Run, terminal->io_));
+  return terminal;
+}
+
+Terminal::Terminal(int pid) : pid_(pid) {}
+
+Terminal::~Terminal() {
+  Kill();
+}
+
+void Terminal::Write(std::string data) {
+  io_->Write(std::move(data));
+}
+
+void Terminal::Resize(int cols, int rows) {
+  io_->Resize(Size(cols, rows));
+}
+
+void Terminal::Kill() {
+  if (pid_ <= 0) {
+    return;
+  }
+  pid_ = -1;
+  io_->Stop();
+}
+
