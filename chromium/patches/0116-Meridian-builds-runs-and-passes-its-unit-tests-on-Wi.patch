+      handle, real.data(), static_cast<DWORD>(real.size()),
+      FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
+  ::CloseHandle(handle);
+  if (length == 0 || length >= real.size()) {
+    return base::FilePath();
+  }
+  real.resize(length);
+  // Without the prefix a final path comes with (network paths keep theirs;
+  // none is a temp folder).
+  if (real.starts_with(L"\\\\?\\") && !real.starts_with(L"\\\\?\\UNC\\")) {
+    real.erase(0, 4);
+  }
+  return base::FilePath(real);
+#else
   char buffer[PATH_MAX];
   return realpath(path.value().c_str(), buffer) ? base::FilePath(buffer)
                                                 : base::FilePath();
