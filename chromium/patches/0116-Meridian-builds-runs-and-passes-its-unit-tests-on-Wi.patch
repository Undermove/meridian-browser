+
+#ifndef CHROME_BROWSER_MERIDIAN_HELPER_MODES_H_
+#define CHROME_BROWSER_MERIDIAN_HELPER_MODES_H_
+
+#include <optional>
+
+#include "build/build_config.h"
+
+namespace meridian {
+
+// Meridian's helper programs are the browser's own binary started with a
+// switch: `--secret-guard` and `--mission-hook` (hooks of the coding agents)
+// and `--mcp-bridge` (the MCP server an agent talks to). They read stdin,
+// write stdout and never start a browser.
