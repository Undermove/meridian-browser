+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_LOCAL_SOCKET_H_
+#define CHROME_BROWSER_MERIDIAN_LOCAL_SOCKET_H_
+
+// The unix-domain sockets between Meridian and its helper processes, on
+// every system: the POSIX calls as they are, and on Windows the same calls
+// over Winsock (win/posix_sockets.h). A file that uses them says
+// MERIDIAN_USE_POSIX_SOCKETS() in its namespace.
+
+#include <string_view>
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_WIN)
+#include "chrome/browser/meridian/win/posix_sockets.h"
+#else
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#endif
+
+namespace meridian {
+
+#if BUILDFLAG(IS_WIN)
+using posix_sockets::ScopedSocket;
+using posix_sockets::SetSocketNonBlocking;
+using posix_sockets::WriteSocket;
+#else
+using ScopedSocket = base::ScopedFD;
+
+// Also closed in child processes.
+inline void SetSocketNonBlocking(int fd) {
+  int flags = fcntl(fd, F_GETFL);
+  if (flags != -1) {
+    fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+  }
+  fcntl(fd, F_SETFD, FD_CLOEXEC);
+}
+
+inline bool WriteSocket(int fd, std::string_view data) {
+  return base::WriteFileDescriptor(fd, data);
+}
+#endif
+
+}  // namespace meridian
+
+#if !BUILDFLAG(IS_WIN)
+#define MERIDIAN_USE_POSIX_SOCKETS() static_assert(true)
+#endif
+
+#endif  // CHROME_BROWSER_MERIDIAN_LOCAL_SOCKET_H_
