+namespace meridian {
+
+// Keeps a file or folder to this user: `mode` is 0600 for a file, 0700 for a
+// folder or a script. On Windows there are no modes to set: what Meridian
+// writes lies under the person's profile and temp folders, which other
+// accounts can't read to begin with.
+inline bool MakePrivate(const base::FilePath& path, int mode) {
+#if BUILDFLAG(IS_POSIX)
+  return base::SetPosixFilePermissions(path, mode);
+#else
+  return true;
+#endif
+}
+
