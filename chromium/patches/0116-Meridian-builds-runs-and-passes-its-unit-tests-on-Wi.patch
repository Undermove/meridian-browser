+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_TEST_LINKS_H_
+#define CHROME_BROWSER_MERIDIAN_TEST_LINKS_H_
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/process/launch.h"
+#endif
+
+namespace meridian {
+
+// For tests: makes `link` lead to `target`. False where this account may not
+// make one. On Windows a symbolic link takes Developer Mode or an
+// administrator; a link to a folder is then made as a junction, which anyone
+// may create, and a link to a file can't be made at all.
+inline bool MakeTestLink(const base::FilePath& target,
+                         const base::FilePath& link) {
+#if BUILDFLAG(IS_WIN)
+  const bool folder = base::DirectoryExists(target);
+  if (::CreateSymbolicLinkW(
+          link.value().c_str(), target.value().c_str(),
+          (folder ? SYMBOLIC_LINK_FLAG_DIRECTORY : 0) |
+              SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE)) {
+    return true;
+  }
+  if (!folder) {
+    return false;
+  }
+  base::CommandLine mklink(base::FilePath(FILE_PATH_LITERAL("cmd.exe")));
+  mklink.AppendArgNative(L"/d");
+  mklink.AppendArgNative(L"/c");
+  mklink.AppendArgNative(L"mklink");
+  mklink.AppendArgNative(L"/J");
+  mklink.AppendArgPath(link);
+  mklink.AppendArgPath(target);
+  std::string output;
+  return base::GetAppOutput(mklink, &output) && base::PathExists(link);
+#else
+  return base::CreateSymbolicLink(target, link);
+#endif
+}
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_TEST_LINKS_H_
