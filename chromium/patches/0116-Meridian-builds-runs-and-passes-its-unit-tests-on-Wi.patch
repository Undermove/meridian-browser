new file mode 100644
index 0000000000..fc60130b86
--- /dev/null
+++ b/chrome/browser/meridian/ai/process_runner_win.cc
@@ -0,0 +1,215 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/ai/process_runner.h"
+
+#include <windows.h>
+
+#include <algorithm>
+#include <array>
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/process/launch.h"
+#include "base/process/process.h"
+#include "base/strings/string_view_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/threading/platform_thread.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/win/scoped_handle.h"
+
+// RunProcess() on Windows (process_runner.cc has the POSIX one). The child
+// and whatever it starts live in a job, which ends them all when the run
+// stops: Windows has no process groups to signal, and no SIGTERM to ask
+// first.
+namespace meridian::ai {
+
+namespace {
+
+constexpr size_t kStderrLimit = 8192;
+constexpr base::TimeDelta kGrace = base::Milliseconds(1500);
+constexpr base::TimeDelta kIdle = base::Milliseconds(15);
+constexpr DWORD kPipeBuffer = 65536;
+
+// A pipe whose `ours` end stays in this process and whose `theirs` end the
+// child inherits.
+bool MakePipe(bool child_reads,
+              base::win::ScopedHandle* ours,
+              base::win::ScopedHandle* theirs) {
+  SECURITY_ATTRIBUTES inherit = {sizeof(inherit), nullptr, TRUE};
+  HANDLE read = nullptr;
+  HANDLE write = nullptr;
+  if (!::CreatePipe(&read, &write, &inherit, kPipeBuffer)) {
+    return false;
+  }
+  ours->Set(child_reads ? write : read);
+  theirs->Set(child_reads ? read : write);
+  return ::SetHandleInformation(ours->get(), HANDLE_FLAG_INHERIT, 0) != 0;
+}
+
+}  // namespace
+
+ProcessResult RunProcess(
+    const ProcessSpec& spec,
+    scoped_refptr<CancelFlag> cancel,
+    base::RepeatingCallback<void(std::string_view)> on_output) {
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::WILL_BLOCK);
+  ProcessResult result;
+  if (spec.argv.empty()) {
+    return result;
+  }
+  base::win::ScopedHandle in_write, in_read, out_read, out_write, err_read,
+      err_write;
+  if (!MakePipe(true, &in_write, &in_read) ||
+      !MakePipe(false, &out_read, &out_write) ||
+      !MakePipe(false, &err_read, &err_write)) {
+    return result;
+  }
+  base::win::ScopedHandle job(::CreateJobObjectW(nullptr, nullptr));
+  if (!job.is_valid() ||
+      !base::SetJobObjectLimitFlags(job.get(),
+                                    JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE)) {
+    return result;
+  }
+  base::CommandLine command(base::FilePath::FromUTF8Unsafe(spec.argv[0]));
+  for (size_t i = 1; i < spec.argv.size(); ++i) {
+    command.AppendArgNative(base::UTF8ToWide(spec.argv[i]));
+  }
+  base::LaunchOptions options;
+  options.stdin_handle = in_read.get();
+  options.stdout_handle = out_write.get();
+  options.stderr_handle = err_write.get();
+  options.handles_to_inherit = {in_read.get(), out_write.get(),
+                                err_write.get()};
+  options.clear_environment = true;
+  for (const auto& [name, value] : spec.env) {
+    options.environment[base::UTF8ToWide(name)] = base::UTF8ToWide(value);
+  }
+  if (!spec.cwd.empty()) {
+    options.current_directory = base::FilePath::FromUTF8Unsafe(spec.cwd);
+  }
+  options.job_handle = job.get();
+  // A console program started from here would open a console window.
+  options.start_hidden = true;
+  base::Process process = base::LaunchProcess(command, options);
+  in_read.Close();
+  out_write.Close();
+  err_write.Close();
+  if (!process.IsValid()) {
+    return result;
+  }
+  result.started = true;
+
+  std::string_view pending;
+  if (spec.stdin_text) {
+    pending = *spec.stdin_text;
+  }
+  if (pending.empty()) {
+    in_write.Close();
+  } else {
+    // Writes take what fits and come back, instead of waiting for a child
+    // that is itself waiting for its output to be read.
+    DWORD mode = PIPE_READMODE_BYTE | PIPE_NOWAIT;
+    ::SetNamedPipeHandleState(in_write.get(), &mode, nullptr, nullptr);
+  }
+
+  const base::TimeTicks deadline = base::TimeTicks::Now() + spec.timeout;
+  size_t output = 0;
+  std::array<char, 65536> buffer;
+  auto stop = [&] {
+    if (!result.killed) {
+      result.killed = true;
+      ::TerminateJobObject(job.get(), 1);
+    }
+  };
+  // Takes what is waiting in `pipe`, if anything, and closes it at its end.
+  // True when something was read.
+  auto drain = [&](base::win::ScopedHandle& pipe, bool is_stdout) {
+    DWORD available = 0;
+    if (!::PeekNamedPipe(pipe.get(), nullptr, 0, nullptr, &available,
+                         nullptr)) {
+      pipe.Close();
+      return false;
+    }
+    if (available == 0) {
+      return false;
+    }
+    DWORD n = 0;
+    if (!::ReadFile(
+            pipe.get(), buffer.data(),
+            std::min<DWORD>(available, static_cast<DWORD>(buffer.size())), &n,
+            nullptr) ||
+        n == 0) {
+      pipe.Close();
+      return false;
+    }
+    std::string_view chunk =
+        base::as_string_view(base::span(buffer).first(static_cast<size_t>(n)));
+    if (!is_stdout) {
+      if (result.stderr_text.size() < kStderrLimit) {
+        result.stderr_text.append(
+            chunk.substr(0, kStderrLimit - result.stderr_text.size()));
+      }
+      return true;
+    }
+    output += chunk.size();
+    if (output > spec.max_output) {
+      result.too_long = true;
+      stop();
+      return true;
+    }
+    if (!result.killed) {
+      on_output.Run(chunk);
+    }
+    return true;
+  };
+  while (out_read.is_valid() || err_read.is_valid()) {
+    if (!result.killed) {
+      if (cancel && cancel->IsSet()) {
+        stop();
+      } else if (base::TimeTicks::Now() > deadline) {
+        result.timed_out = true;
+        stop();
+      }
+    }
+    bool busy = false;
+    if (out_read.is_valid()) {
+      busy |= drain(out_read, true);
+    }
+    if (err_read.is_valid()) {
+      busy |= drain(err_read, false);
+    }
+    if (in_write.is_valid()) {
+      DWORD n = 0;
+      if (!::WriteFile(
+              in_write.get(), pending.data(),
+              static_cast<DWORD>(std::min<size_t>(pending.size(), 4096)), &n,
+              nullptr)) {
+        in_write.Close();
+      } else {
+        pending.remove_prefix(n);
+        busy |= n > 0;
+        if (pending.empty()) {
+          in_write.Close();
+        }
+      }
+    }
+    if (!busy) {
+      base::PlatformThread::Sleep(kIdle);
+    }
+  }
+  in_write.Close();
+  // Both pipes closed: the process is exiting (or a grandchild kept them
+  // open until the job ended).
+  if (!process.WaitForExitWithTimeout(kGrace, &result.exit_code)) {
+    ::TerminateJobObject(job.get(), 1);
+    process.WaitForExit(&result.exit_code);
+  }
+  return result;
+}
+
+}  // namespace meridian::ai
