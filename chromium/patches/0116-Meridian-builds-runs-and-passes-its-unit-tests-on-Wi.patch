@@ -0,0 +1,84 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/helper_modes.h"
+
+#include "chrome/browser/meridian/agent/mcp_bridge.h"
+#include "chrome/browser/meridian/mission/mission_hook.h"
+#include "chrome/browser/meridian/workbench/guard_hook.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+
+#include <fcntl.h>
+#include <io.h>
+#include <stdio.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/strings/utf_string_conversions.h"
+#endif
+
+namespace meridian {
+
+namespace {
+
+std::optional<int> Run(int argc, const char** argv) {
+  if (workbench::IsSecretGuard(argc, argv)) {
+    return workbench::RunSecretGuard(argc, argv);
+  }
+  if (mission::IsMissionHook(argc, argv)) {
+    return mission::RunMissionHook(argc, argv);
+  }
+  if (IsMcpBridge(argc, argv)) {
+    return RunMcpBridge(argc, argv);
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+#if BUILDFLAG(IS_WIN)
+std::optional<int> RunHelperMode() {
+  // Every process of the browser comes through here, the sandboxed ones
+  // too, and those may not load what splits a command line into arguments.
+  // So first the plain text: no helper's switch in it, nothing to do.
+  const std::wstring_view line(::GetCommandLineW());
+  if (line.find(L"--secret-guard") == std::wstring_view::npos &&
+      line.find(L"--mission-hook") == std::wstring_view::npos &&
+      line.find(L"--mcp-bridge") == std::wstring_view::npos) {
+    return std::nullopt;
+  }
+  // main()'s arguments, in UTF-8.
+  std::vector<std::string> args;
+  for (const std::wstring& arg :
+       base::CommandLine::FromString(std::wstring(line)).argv()) {
+    args.push_back(base::WideToUTF8(arg));
+  }
+  std::vector<const char*> argv;
+  for (const std::string& arg : args) {
+    argv.push_back(arg.c_str());
+  }
+  const int argc = static_cast<int>(argv.size());
+  if (!workbench::IsSecretGuard(argc, argv.data()) &&
+      !mission::IsMissionHook(argc, argv.data()) &&
+      !IsMcpBridge(argc, argv.data())) {
+    return std::nullopt;
+  }
+  // The lines these programs exchange are JSON with "\n" at the end: as they
+  // are, without the C runtime's text mode in between.
+  _setmode(_fileno(stdin), _O_BINARY);
+  _setmode(_fileno(stdout), _O_BINARY);
+  return Run(argc, argv.data());
+}
+#else
+std::optional<int> RunHelperMode(int argc, const char** argv) {
+  return Run(argc, argv);
+}
+#endif
+
+}  // namespace meridian
