From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 29 Oct 2026 18:33:33 +0400
Subject: [PATCH 42/58] Meridian: the URL pill knows tabs that loaded before
 the browser page; version 0.5.2

On a slow machine a tab could finish loading before chrome://webui-browser
subscribed to tab changes; no change came after, so the URL pill stayed empty.
The sidebar now reports every tab's current state once it has the snapshot.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/update_check.h                     | 2 +-
 chrome/browser/resources/webui_browser/meridian/sidebar.ts | 5 +++++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/meridian/update_check.h b/chrome/browser/meridian/update_check.h
index 29fd5043f4..bb4f379392 100644
--- a/chrome/browser/meridian/update_check.h
+++ b/chrome/browser/meridian/update_check.h
@@ -17,7 +17,7 @@
 namespace meridian::update {
 
 // This build's version (the release tag without "v").
-inline constexpr char kVersion[] = "0.5.1";
+inline constexpr char kVersion[] = "0.5.2";
 
 // GitHub's latest release of Meridian.
 inline constexpr char kFeed[] =
diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
index 333c9a741d..f452407eef 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
@@ -271,6 +271,11 @@ export class MeridianSidebarElement extends CrLitElement implements
     for (const tab of tabs.values()) {
       this.fire<TabAdded>('tab-added', {id: tab.id, isActive: tab.isActive});
     }
+    // The state they're already in (a tab may have loaded before this page
+    // did, and then no change comes): the URL pill and the active web view.
+    for (const tab of tabs.values()) {
+      this.fire<TabUpdated>('tab-updated', tab);
+    }
     observation.bind(snapshot.stream.handle);
   }
 
