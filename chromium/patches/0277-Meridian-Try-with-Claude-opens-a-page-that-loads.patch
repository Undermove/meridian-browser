new file mode 100644
index 0000000000..4076e38418
--- /dev/null
+++ b/chrome/browser/meridian/reachable.cc
@@ -0,0 +1,145 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/reachable.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/memory/ref_counted.h"
+#include "base/strings/string_split.h"
+#include "base/time/time.h"
+#include "chrome/browser/meridian/test_switches.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr base::TimeDelta kTimeout = base::Seconds(4);
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("meridian_reachable_page", R"(
+      semantics {
+        sender: "Meridian Try with Claude"
+        description:
+          "Before opening a sample page for a Try with Claude card (a plain "
+          "page to restyle or critique), checks that it loads, to open "
+          "another one if it doesn't."
+        trigger: "Clicking a Try with Claude card on an empty tab."
+        data: "None: a HEAD request without cookies."
+        destination: WEBSITE
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "None: only when the person clicks the card."
+        policy_exception_justification: "Person-initiated."
+      })");
+
+class Probe : public base::RefCounted<Probe> {
+ public:
+  Probe(std::vector<GURL> urls, base::OnceCallback<void(const GURL&)> done)
+      : urls_(std::move(urls)),
+        state_(urls_.size(), kPending),
+        done_(std::move(done)) {}
+
+  void Start(scoped_refptr<network::SharedURLLoaderFactory> factory) {
+    for (size_t i = 0; i < urls_.size(); ++i) {
+      auto request = std::make_unique<network::ResourceRequest>();
+      request->url = urls_[i];
+      request->method = "HEAD";
+      request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+      auto loader =
+          network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+      loader->SetTimeoutDuration(kTimeout);
+      network::SimpleURLLoader* raw = loader.get();
+      loaders_.push_back(std::move(loader));
+      raw->DownloadHeadersOnly(
+          factory.get(), base::BindOnce(&Probe::OnHeaders,
+                                        base::WrapRefCounted(this), i));
+    }
+    Decide();
+  }
+
+ private:
+  friend class base::RefCounted<Probe>;
+  enum State { kPending, kOk, kFailed };
+  ~Probe() = default;
+
+  void OnHeaders(size_t i, scoped_refptr<net::HttpResponseHeaders> headers) {
+    // Any answer short of a server error counts: some sites refuse HEAD
+    // (405) but load fine. No headers: no connection, a bad certificate or
+    // the timeout.
+    state_[i] = headers && headers->response_code() < 500 ? kOk : kFailed;
+    Decide();
+  }
+
+  // The first in order that answered, once the ones before it failed.
+  void Decide() {
+    if (!done_) {
+      return;
+    }
+    for (size_t i = 0; i < urls_.size(); ++i) {
+      if (state_[i] == kPending) {
+        return;
+      }
+      if (state_[i] == kOk) {
+        return Finish(urls_[i]);
+      }
+    }
+    Finish(urls_.empty() ? GURL() : urls_[0]);
+  }
+
+  void Finish(const GURL& url) {
+    std::move(done_).Run(url);
+    // The rest are cancelled (deleting a loader in its callback is fine).
+    loaders_.clear();
+  }
+
+  std::vector<GURL> urls_;
+  std::vector<State> state_;
+  std::vector<std::unique_ptr<network::SimpleURLLoader>> loaders_;
+  base::OnceCallback<void(const GURL&)> done_;
+};
+
+}  // namespace
+
+void FirstReachableUrl(Profile* profile,
+                       std::vector<GURL> urls,
+                       base::OnceCallback<void(const GURL&)> done) {
+  std::erase_if(urls, [](const GURL& u) { return !u.SchemeIs("https"); });
+  if (urls.empty()) {
+    std::move(done).Run(GURL());
+    return;
+  }
+  if (HasTestSwitch("meridian-reachable-urls")) {
+    std::vector<std::string> answer = base::SplitString(
+        TestSwitchValue("meridian-reachable-urls"), ",",
+        base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    for (const GURL& url : urls) {
+      if (std::ranges::find(answer, url.spec()) != answer.end()) {
+        std::move(done).Run(url);
+        return;
+      }
+    }
+    std::move(done).Run(urls[0]);
+    return;
+  }
+  if (!profile) {
+    std::move(done).Run(urls[0]);
+    return;
+  }
+  auto probe = base::MakeRefCounted<Probe>(std::move(urls), std::move(done));
+  probe->Start(profile->GetDefaultStoragePartition()
+                   ->GetURLLoaderFactoryForBrowserProcess());
+}
+
+}  // namespace meridian
