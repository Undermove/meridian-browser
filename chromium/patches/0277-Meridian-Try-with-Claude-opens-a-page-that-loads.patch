+
+#ifndef CHROME_BROWSER_MERIDIAN_REACHABLE_H_
+#define CHROME_BROWSER_MERIDIAN_REACHABLE_H_
+
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "url/gurl.h"
+
+class Profile;
+
+namespace meridian {
+
+// The first of `urls` (https) that answers within a few seconds with a valid
+// certificate and no server error, checked all at once with a HEAD request
+// and no cookies; the first one when none does. For pages Meridian opens by
+// itself ("Try with Claude"), so a site that's down or whose certificate
+// expired isn't what the person sees. Tests list the ones that "answer" in
+// --meridian-reachable-urls instead (no network).
+void FirstReachableUrl(Profile* profile,
+                       std::vector<GURL> urls,
+                       base::OnceCallback<void(const GURL&)> done);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_REACHABLE_H_
