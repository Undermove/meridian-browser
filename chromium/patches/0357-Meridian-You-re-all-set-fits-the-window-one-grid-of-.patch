+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The welcome tour's last page, «You're all set», lays out without overlaps
+// from a small laptop window to a big screen: the real onboarding.css and
+// icons in headless Google Chrome, with the page's markup as
+// onboarding.html.ts draws it for the 'done' step (keep the two in step).
+// Cases: an agent connected (three tiles, its check line), no agent (four
+// tiles with «Get Claude»), moved in with an agent (the owner's), and
+// everything at once (the move-in note, the passwords button, two check
+// lines, one with a button, the restart line, «Undo this setup»). At each
+// size: nothing overlaps, nothing is under the tour's button or outside the
+// window, the tiles are one grid (same width, same height in a row), the check
+// lines are as wide as the grid, and from 1024×640 up the page has room
+// without scrolling (everything at once: from 1075×810; smaller, it scrolls
+// under its own edge, still clear of the button).
+// No build needed. Run: node --test chrome/browser/resources/webui_browser/meridian/layout_tests/onboarding_done.test.mjs
+// Skipped without Google Chrome (CHROME=/path/to/chrome to pick one).
+// MERIDIAN_SHOTS=<dir> also writes a shot of each case there.
+
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+
+import {CHROME, launch} from './cdp.mjs';
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const MERIDIAN = process.env.MERIDIAN_ROOT || path.resolve(HERE, '..');
+const SHOTS = process.env.MERIDIAN_SHOTS;
+const read = (f) => fs.readFileSync(path.join(MERIDIAN, f), 'utf8');
+
+function icon(name, size) {
+  const m = read('icons.ts').match(
+      new RegExp(`case '${name}':\\s*return html\`([^\`]*)\``));
+  return m[1].replaceAll('${size}', String(size));
+}
+
+const tile = (ic, b, em, id = '') =>
+    `<button class="try"${id ? ` id="${id}"` : ''}><span class="try-ic">${
+        icon(ic, 17)}</span><b>${b}</b><em>${em}</em></button>`;
+
+const check = (state, name, message, fix = '') => `
+  <div class="check ${state}"><span class="check-ic">${
+    icon(state === 'ok' ? 'check' : 'info', 14)}</span>
+    <span class="check-text"><b>${name}</b><span class="check-msg">${
+    message}</span></span>${
+    fix ? `<button class="btn ghost check-fix">${fix}</button>` : ''}</div>`;
+
+const CASES = {
+  connected: {
+    getClaude: false,
+    checks: [check('ok', 'Claude Code', 'Claude Code is signed in and connected.')],
+  },
+  'no-agent': {getClaude: true, checks: []},
+  // The owner's window on 27.11: moved in from Chrome, Claude Code connected.
+  'moved-in': {
+    getClaude: false,
+    note: 'You’re still signed in to your sites (5,915 sign-ins, 682 ' +
+        'passwords, 1 card brought over). Your history and the rest came too.',
+    checks: [check('ok', 'Claude Code', 'Claude Code is signed in and connected.')],
+  },
+  everything: {
+    getClaude: false,
+    note: 'You’re still signed in to your sites (5,915 sign-ins, 682 ' +
+        'passwords, 1 card brought over). Your history and the rest came too.',
+    passwords: true,
+    restart: 'Close Claude and open it again, then ask it to do something ' +
+        'in Meridian.',
+    undo: true,
+    checks: [
+      check('ok', 'Claude Code', 'Claude Code is signed in and connected.'),
+      check('restart', 'Claude for Mac',
+            'Claude for Mac needs a restart to load Meridian.', 'Restart'),
+    ],
+    checkNote: 'Sign in to Claude Code in the Terminal, then come back.',
+  },
+};
+
+// onboarding.html.ts, step 'done'.
+function page(c) {
+  return `<!doctype html><html><head><meta charset="utf-8">
+<style>html, body { margin: 0; height: 100%; }</style></head>
+<body><div id="host" open></div><script>
+document.getElementById('host').attachShadow({mode: 'open'}).innerHTML =
+  ${JSON.stringify(`<style>${read('onboarding.css')}</style>
+<div id="root" data-step="done">
+  <div class="bg"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
+  <div class="top"><div class="grow"></div>
+    <button id="skip" class="skip" hidden>Skip</button></div>
+  <div class="stage">
+    <div class="page step-done">
+      <div class="hero">
+        <div class="mark done">${icon('check', 54)}</div>
+        <h1>You’re all set</h1>
+        <p class="whisper">Press <kbd>⌘</kbd><kbd>T</kbd> to open a new tab
+          or find anything you had open.</p>
+        ${c.note ? `<p class="whisper">${c.note}</p>` : ''}
+        ${c.passwords ? `<button id="passwordsFile" class="pill">${
+          icon('lock', 15)} Import passwords from a file</button>` : ''}
+        <div class="tries ${c.getClaude ? 'four' : ''}">
+          ${tile('sparkles', 'Ask about a page', 'Get an answer from what’s open')}
+          ${tile('sliders', 'Clean up a site', 'Remove what distracts you')}
+          ${tile('split', 'Two tabs side by side', 'Read and work at once')}
+          ${c.getClaude ? tile('external', 'Get Claude for Mac',
+              'Free; Meridian sets it up for you', 'getClaude') : ''}
+        </div>
+        ${c.restart ? `<div class="ai-done"><span>${c.restart}</span></div>` : ''}
+        ${c.undo ? '<button id="undoSetup" class="link">Undo this setup</button>' : ''}
+        ${c.checks.length ? `<div class="checks" id="checks">${c.checks.join('')}${
+          c.checkNote ? `<p id="checkNote" class="whisper">${c.checkNote}</p>` : ''}
+        </div>` : ''}
+      </div>
+    </div>
+  </div>
+  <div class="foot">
+    <button id="back" class="btn ghost" hidden>${icon('arrowLeft', 16)}</button>
+    <div class="dots">${[0, 1, 2, 3, 4].map((i) =>
+      `<button class="dot ${i < 4 ? 'past' : 'on'}"></button>`).join('')}</div>
+    <button id="next" class="btn primary">Start browsing</button>
+  </div>
+</div>`)};
+</script></body></html>`;
+}
+
+const MEASURE = `(() => {
+  const root = document.getElementById('host').shadowRoot;
+  const box = (el) => { const r = el.getBoundingClientRect();
+    return {l: r.left, t: r.top, r: r.right, b: r.bottom, w: r.width, h: r.height}; };
+  const pg = root.querySelector('.page');
+  const named = [];
+  const add = (sel, name) => root.querySelectorAll(sel).forEach((el, i) =>
+      named.push({name: name + (i ? ' ' + (i + 1) : ''), ...box(el)}));
+  add('.mark', 'mark'); add('h1', 'headline'); add('.hero > .whisper', 'line');
+  add('#passwordsFile', 'passwords'); add('.try', 'tile'); add('.ai-done', 'restart line');
+  add('#undoSetup', 'undo'); add('.check', 'check'); add('#checkNote', 'check note');
+  const foot = [];
+  root.querySelectorAll('#next, .dot').forEach((el) => foot.push(box(el)));
+  return {named, foot, page: box(pg), scroll: pg.scrollHeight - pg.clientHeight,
+          clips: getComputedStyle(pg).overflowY !== 'visible',
+          tries: box(root.querySelector('.tries')),
+          checks: root.querySelector('.checks') && box(root.querySelector('.checks')),
+          vw: innerWidth, vh: innerHeight};
+})()`;
+
+const SIZES = [[800, 600], [1024, 640], [1075, 810], [1280, 800], [1440, 900],
+               [1728, 1117], [2560, 1440]];
+const overlap = (a, b) => a.l < b.r - 0.5 && b.l < a.r - 0.5 &&
+                          a.t < b.b - 0.5 && b.t < a.b - 0.5;
+
+test('«You’re all set»: nothing overlaps, one tile grid, room for it all',
+    {skip: !CHROME && 'no Google Chrome'}, async () => {
+  const b = await launch();
+  const misses = [];
+  try {
+    const {s} = b;
+    await s('Page.enable');
+    const frameId = (await s('Page.getFrameTree')).frameTree.frame.id;
+    await s('Emulation.setEmulatedMedia',
+        {features: [{name: 'prefers-reduced-motion', value: 'reduce'}]});
+    for (const [name, c] of Object.entries(CASES)) {
+      for (const [w, h] of SIZES) {
+        await s('Emulation.setDeviceMetricsOverride',
+            {width: w, height: h, deviceScaleFactor: 1, mobile: false});
+        await s('Page.setDocumentContent', {frameId, html: page(c)});
+        // The page slides in (0.56 s); measure where it lands.
+        await new Promise((r) => setTimeout(r, 700));
+        const m = (await s('Runtime.evaluate',
+            {expression: MEASURE, returnByValue: true})).result.value;
+        const tag = `${name} ${w}×${h}`;
+        const miss = (what) => misses.push(`${tag}: ${what}`);
+        for (let i = 0; i < m.named.length; i++) {
+          const a = m.named[i];
+          if (a.l < 0 || a.r > m.vw) miss(`${a.name} outside the window`);
+          for (const f of m.foot) {
+            // Under the page's own edge (scrolled away) is fine; on top of
+            // the button is not.
+            const shown = m.clips ? {...a, t: Math.max(a.t, m.page.t), b: Math.min(a.b, m.page.b)} : a;
+            if (shown.b > shown.t && overlap(shown, f)) miss(`${a.name} over the tour's button`);
+          }
+          for (let j = i + 1; j < m.named.length; j++) {
+            if (overlap(a, m.named[j])) miss(`${a.name} overlaps ${m.named[j].name}`);
+          }
+        }
+        if (m.clips && m.page.b > Math.min(...m.foot.map((f) => f.t)) + 0.5) {
+          miss('the page runs under the tour\'s button');
+        }
+        const roomy = name === 'everything' ? w >= 1075 && h >= 800 : w >= 1024 && h >= 640;
+        if (roomy && m.scroll > 0) miss(`scrolls by ${m.scroll}px`);
+        const tiles = m.named.filter((n) => n.name.startsWith('tile'));
+        for (const t of tiles) {
+          if (Math.abs(t.w - tiles[0].w) > 0.5) miss(`${t.name} width ${t.w} vs ${tiles[0].w}`);
+          const row = tiles.filter((u) => Math.abs(u.t - t.t) < 0.5);
+          if (row.some((u) => Math.abs(u.h - t.h) > 0.5)) miss(`${t.name} height differs in its row`);
+        }
+        if (m.checks && Math.abs(m.checks.w - m.tries.w) > 0.5) {
+          miss(`check lines ${m.checks.w}px wide, tiles ${m.tries.w}px`);
+        }
+        if (SHOTS) {
+          fs.mkdirSync(SHOTS, {recursive: true});
+          const {data} = await s('Page.captureScreenshot', {format: 'png'});
+          fs.writeFileSync(path.join(SHOTS, `${name}-${w}x${h}.png`),
+                           Buffer.from(data, 'base64'));
+        }
+      }
+    }
+  } finally {
+    await b.close();
+  }
+  assert.deepEqual(misses, []);
+});
