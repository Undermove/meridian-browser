+bool IsRealHome(const base::FilePath& dir) {
+  if (dir.empty()) {
+    return false;
+  }
+  std::vector<base::FilePath> real = {base::GetHomeDir()};
+#if !BUILDFLAG(IS_WIN)
+  // getpwuid: the account's own folder (base::GetHomeDir() reads HOME on
+  // Linux).
+  if (const struct passwd* pw = getpwuid(getuid()); pw && pw->pw_dir) {
+    real.push_back(base::FilePath(pw->pw_dir));
+  }
+#endif
+  base::FilePath mine = RealFilePath(dir);
+  if (mine.empty()) {
+    mine = dir.StripTrailingSeparators();
+  }
+  for (const base::FilePath& home : real) {
+    if (home.empty()) {
+      continue;
+    }
+    base::FilePath theirs = RealFilePath(home);
+    if ((theirs.empty() ? home.StripTrailingSeparators() : theirs) == mine) {
+      return true;
+    }
+  }
+  return false;
+}
+
+base::FilePath CliHome() {
+#if BUILDFLAG(IS_WIN)
+  const std::string home = Env("USERPROFILE");
+#else
+  const std::string home = Env("HOME");
+#endif
+  if (!TestSwitchesAllowed()) {
+    return home.empty() ? base::GetHomeDir() : base::FilePath::FromUTF8Unsafe(home);
+  }
+  if (base::FilePath test = TestSwitchPath("meridian-test-home");
+      !test.empty()) {
+    return test;
+  }
+  base::FilePath given = base::FilePath::FromUTF8Unsafe(home);
+  if (!home.empty() && !IsRealHome(given)) {
+    return given;
+  }
+  // A test that left HOME as it was: never the person's real folder.
+  static base::NoDestructor<base::Lock> lock;
+  static base::NoDestructor<base::FilePath> made;
+  base::AutoLock hold(*lock);
+  if (made->empty()) {
+    base::FilePath dir;
+    if (base::CreateNewTempDirectory(FILE_PATH_LITERAL("meridian-home-"),
+                                     &dir)) {
+      *made = dir;
+    }
+  }
+  return *made;
+}
