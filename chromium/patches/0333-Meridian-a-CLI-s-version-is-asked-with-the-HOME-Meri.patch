+#if BUILDFLAG(IS_POSIX)
+namespace {
+
+// A stand-in CLI that says `version` and writes down the HOME and the
+// folder it was started with.
+void StandIn(const base::FilePath& dir,
+             const std::string& version,
+             const base::FilePath& log) {
+  ASSERT_TRUE(base::CreateDirectory(dir));
+  base::FilePath bin = dir.AppendASCII("claude");
+  ASSERT_TRUE(base::WriteFile(
+      bin, "#!/bin/sh\nprintf '%s|%s\\n' \"$HOME\" \"$(pwd -P)\" >> '" +
+               log.value() + "'\necho '" + version + " (Claude Code)'\n"));
+  ASSERT_TRUE(base::SetPosixFilePermissions(bin, 0755));
+}
+
+}  // namespace
+
+// The Workbench, Connect and Ask find a CLI the same way: the newest copy,
+// whichever the PATH lists first, asked its --version with the HOME this
+// process was given (base::GetHomeDir() ignores it on macOS) and never in
+// the home folder itself.
+TEST(CliVersionsTest, NewestCliIsAskedWithTheGivenHomeInAnEmptyFolder) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath root = base::MakeAbsoluteFilePath(temp.GetPath());
+  const base::FilePath home = root.AppendASCII("home");
+  ASSERT_TRUE(base::CreateDirectory(home));
+  const base::FilePath log = root.AppendASCII("runs.log");
+  const base::FilePath old_dir = root.AppendASCII("usr-local-bin");
+  const base::FilePath new_dir = home.AppendASCII(".local/bin");
+  StandIn(old_dir, "2.0.14", log);
+  StandIn(new_dir, "2.1.332", log);
+  const std::vector<std::string> none;
+  SetInstallerFoldersForTesting(&none);
+  base::ScopedEnvironmentVariableOverride given("HOME", home.value());
+  ASSERT_EQ(CliHome(), home);
+
+  std::vector<CliCopy> copies;
+  const std::string path = old_dir.value() + ":" + new_dir.value();
+  EXPECT_EQ(FindNewestCli("claude", path, &copies),
+            new_dir.AppendASCII("claude").value());
+  ASSERT_EQ(copies.size(), 2u);
+  EXPECT_EQ(copies[0].version, "2.1.332");
+  EXPECT_EQ(copies[1].version, "2.0.14");
+
+  std::string runs;
+  ASSERT_TRUE(base::ReadFileToString(log, &runs));
+  std::vector<std::string> lines = base::SplitString(
+      runs, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  ASSERT_EQ(lines.size(), 2u);
+  for (const std::string& line : lines) {
+    const size_t bar = line.find('|');
+    ASSERT_NE(bar, std::string::npos) << line;
+    EXPECT_EQ(line.substr(0, bar), home.value()) << "HOME as given";
+    const std::string cwd = line.substr(bar + 1);
+    EXPECT_NE(cwd, home.value()) << "asked in the home folder";
+    EXPECT_FALSE(base::FilePath(cwd).IsParent(base::GetHomeDir()) ||
+                 base::FilePath(cwd) == base::GetHomeDir())
+        << "asked in the real home: " << cwd;
+    EXPECT_FALSE(base::PathExists(base::FilePath(cwd)))
+        << "its empty folder is cleaned up";
+  }
+  SetInstallerFoldersForTesting(nullptr);
+}
+
+TEST(CliVersionsTest, RealHomeIsTheSystemsWhateverHomeSays) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  EXPECT_FALSE(IsRealHome(temp.GetPath()));
+  EXPECT_FALSE(IsRealHome(base::FilePath()));
+  base::ScopedEnvironmentVariableOverride given("HOME",
+                                               temp.GetPath().value());
+  // The account's own folder, which HOME no longer names.
+  const base::FilePath real = base::GetHomeDir();
+  if (real != temp.GetPath()) {
+    EXPECT_TRUE(IsRealHome(real));
+  }
+}
+#endif  // BUILDFLAG(IS_POSIX)
+
 }  // namespace meridian::ai
