+bool AgentConnectedForAccount(const std::string& vendor_id,
+                              const base::FilePath& dir,
+                              const base::FilePath& home) {
+  if (vendor_id == "claude") {
+    return JsonState(ClaudeJson(dir, home), "mcpServers") == "connected";
+  }
+  if (vendor_id == "codex") {
+    return CodexTomlHasMeridian(dir.AppendASCII("config.toml"));
+  }
+  if (vendor_id == "copilot") {
+    return JsonState(dir.AppendASCII("mcp-config.json"), "mcpServers") ==
+           "connected";
+  }
+  if (vendor_id == "gemini") {
+    return JsonState(dir.AppendASCII(".gemini/settings.json"), "mcpServers") ==
+           "connected";
+  }
+  return false;
+}
+
+bool ConnectAgentCliAs(const std::string& id,
+                       const std::map<std::string, std::string>& env,
+                       std::string* output) {
+  if (std::string unstable = UnstableProgram(); !unstable.empty()) {
+    *output = unstable;
+    return false;
+  }
+  const Known* cli = FindKnown(id);
+  if (!cli) {
+    *output = "unknown agent";
+    return false;
+  }
+  return RunCli(*cli, output, env);
+}
