diff --git a/chrome/browser/meridian/ai/cli_versions.cc b/chrome/browser/meridian/ai/cli_versions.cc
new file mode 100644
index 0000000000..c06a93f248
--- /dev/null
+++ b/chrome/browser/meridian/ai/cli_versions.cc
@@ -0,0 +1,164 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/ai/cli_versions.h"
+
+#include <algorithm>
+#include <set>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/synchronization/lock.h"
+#include "base/time/time.h"
+#include "build/build_config.h"
+#include "chrome/browser/meridian/ai/process_runner.h"
+#include "chrome/browser/meridian/test_switches.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace meridian::ai {
+
+namespace {
+
+#if BUILDFLAG(IS_WIN)
+constexpr char kSeparator[] = ";";
+#else
+constexpr char kSeparator[] = ":";
+#endif
+
+std::vector<std::string> Folders(const std::string& search_path,
+                                 const std::map<std::string, std::string>& env) {
+  std::vector<std::string> out =
+      base::SplitString(search_path, kSeparator, base::TRIM_WHITESPACE,
+                        base::SPLIT_WANT_NONEMPTY);
+#if !BUILDFLAG(IS_WIN)
+  // A test sees its stand-ins only, never the computer's real CLIs.
+  if (TestSwitchesAllowed()) {
+    return out;
+  }
+  auto home = env.find("HOME");
+  if (home != env.end() && !home->second.empty()) {
+    for (const char* dir :
+         {"/.local/bin", "/.claude/local", "/.npm-global/bin", "/.volta/bin",
+          "/.bun/bin"}) {
+      out.push_back(home->second + dir);
+    }
+  }
+  out.push_back("/opt/homebrew/bin");
+  out.push_back("/usr/local/bin");
+#endif
+  return out;
+}
+
+// What --version says, per file and its change time and size.
+std::string VersionOf(const std::string& path,
+                      const std::map<std::string, std::string>& env) {
+  static base::NoDestructor<base::Lock> lock;
+  static base::NoDestructor<std::map<std::string, std::string>> known;
+  base::File::Info info;
+  base::GetFileInfo(base::FilePath::FromUTF8Unsafe(path), &info);
+  const std::string key =
+      path + "|" +
+      base::NumberToString(info.last_modified.InMillisecondsSinceUnixEpoch()) +
+      "|" + base::NumberToString(info.size);
+  {
+    base::AutoLock hold(*lock);
+    if (auto it = known->find(key); it != known->end()) {
+      return it->second;
+    }
+  }
+  auto home = env.find("HOME");
+  int exit_code = -1;
+  const std::string out =
+      CaptureOutput({path, "--version"}, env,
+                    home != env.end() ? home->second : std::string(),
+                    base::Seconds(8), &exit_code);
+  const std::string version = ParseCliVersion(out);
+  if (!version.empty()) {
+    base::AutoLock hold(*lock);
+    (*known)[key] = version;
+  }
+  return version;
+}
+
+}  // namespace
+
+std::string ParseCliVersion(const std::string& output) {
+  std::string version;
+  RE2::PartialMatch(output, "(\\d+\\.\\d+(?:\\.\\d+)*)", &version);
+  return version;
+}
+
+int CompareCliVersions(const std::string& a, const std::string& b) {
+  if (a.empty() || b.empty()) {
+    return a.empty() == b.empty() ? 0 : a.empty() ? -1 : 1;
+  }
+  const std::vector<std::string> pa = base::SplitString(
+      a, ".", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  const std::vector<std::string> pb = base::SplitString(
+      b, ".", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  for (size_t i = 0; i < std::max(pa.size(), pb.size()); ++i) {
+    int x = 0;
+    int y = 0;
+    if (i < pa.size()) {
+      base::StringToInt(pa[i], &x);
+    }
+    if (i < pb.size()) {
+      base::StringToInt(pb[i], &y);
+    }
+    if (x != y) {
+      return x < y ? -1 : 1;
+    }
+  }
+  return 0;
+}
+
+std::vector<CliCopy> FindCliCopies(
+    const std::string& name,
+    const std::string& search_path,
+    const std::map<std::string, std::string>& env) {
+  std::vector<CliCopy> copies;
+  std::set<std::string> seen;
+  for (const std::string& dir : Folders(search_path, env)) {
+    const std::string found = FindProgram(name, dir);
+    if (found.empty()) {
+      continue;
+    }
+    base::FilePath real =
+        base::MakeAbsoluteFilePath(base::FilePath::FromUTF8Unsafe(found));
+    const std::string key = real.empty() ? found : real.AsUTF8Unsafe();
+    if (!seen.insert(key).second) {
+      continue;
+    }
+    copies.push_back({found, ""});
+  }
+  if (copies.size() < 2) {
+    return copies;
+  }
+  for (CliCopy& copy : copies) {
+    copy.version = VersionOf(copy.path, env);
+  }
+  // Newest first; the PATH's order among equals.
+  std::stable_sort(copies.begin(), copies.end(),
+                   [](const CliCopy& x, const CliCopy& y) {
+                     return CompareCliVersions(x.version, y.version) > 0;
+                   });
+  return copies;
+}
+
+std::string FindNewestProgram(const std::string& name,
+                              const std::string& search_path,
+                              const std::map<std::string, std::string>& env,
+                              std::vector<CliCopy>* copies) {
+  std::vector<CliCopy> found = FindCliCopies(name, search_path, env);
+  std::string newest = found.empty() ? std::string() : found.front().path;
+  if (copies) {
+    *copies = std::move(found);
+  }
+  return newest;
+}
+
+}  // namespace meridian::ai
