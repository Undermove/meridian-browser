+namespace {
+
+// Takes "meridian" out of `key` of a JSON config, keeping everything else.
+bool RemoveJsonEntry(const base::FilePath& file,
+                     const std::string& key,
+                     std::string* output) {
+  std::string text;
+  if (!base::PathExists(file)) {
+    *output = "not connected";
+    return true;
+  }
+  if (!base::ReadFileToString(file, &text)) {
+    *output = "couldn’t read " + file.AsUTF8Unsafe();
+    return false;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(text, base::JSON_ALLOW_TRAILING_COMMAS);
+  if (!root) {
+    *output = file.AsUTF8Unsafe() +
+              " isn’t plain JSON, so Meridian left it as it is. Take "
+              "\"meridian\" out of it yourself.";
+    return false;
+  }
+  base::DictValue* servers = root->FindDict(key);
+  if (!servers || !servers->Remove("meridian")) {
+    *output = "not connected";
+    return true;
+  }
+  std::string json;
+  base::JSONWriter::WriteWithOptions(
+      *root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json);
+  return WriteConfig(file, true, json, output);
+}
+
+}  // namespace
+
+bool DisconnectAgentCli(const std::string& id,
+                        const std::map<std::string, std::string>& env,
+                        std::string* output) {
+  if (id == kDesktopId) {
+    if (TestSwitchesAllowed() &&
+        !base::CommandLine::ForCurrentProcess()->HasSwitch(
+            kClaudeDesktopConfigSwitch)) {
+      *output = "no test config";
+      return false;
+    }
+    return RemoveJsonEntry(DesktopConfig(), "mcpServers", output);
+  }
+  if (const FileAgent* agent = FindFileAgent(id)) {
+    if (TestWithoutConfig(*agent) || id == "goose") {
+      *output = id == "goose" ? "Take meridian out of Goose’s extensions "
+                                "yourself."
+                              : "no test config";
+      return false;
+    }
+    const bool needs_xdg =
+        agent->xdg &&
+        !base::CommandLine::ForCurrentProcess()->HasSwitch(
+            agent->config_switch);
+    base::FilePath file =
+        ConfigDir(*agent, needs_xdg ? LoginVar("XDG_CONFIG_HOME") : "")
+            .AppendASCII(agent->file);
+    if (!FollowLink(&file, output)) {
+      return false;
+    }
+    return RemoveJsonEntry(file, EntryFor(id, Program()).key, output);
+  }
+  const Known* cli = FindKnown(id);
+  if (!cli || id == "vscode" || id == "copilot") {
+    *output = "Meridian can’t take itself out of this one; remove "
+              "\"meridian\" from its MCP servers there.";
+    return false;
+  }
+  std::vector<std::string> args = {"mcp", "remove"};
+  if (id == "claude" || id == "gemini" || id == "qwen") {
+    args.insert(args.end(), {"-s", "user"});
+  }
+  args.push_back("meridian");
+  return RunCli(*cli, output, env, args);
+}
+
 }  // namespace meridian
