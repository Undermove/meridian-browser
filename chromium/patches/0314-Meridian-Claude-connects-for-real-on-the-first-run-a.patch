+// Meridian started from a disk image or from a copy macOS made to run a
+// download (App Translocation): a path that is gone after the next restart,
+// so an agent given it would find nothing. Why, or "".
+std::string UnstableProgram() {
+#if BUILDFLAG(IS_MAC)
+  const std::string program =
+      HasTestSwitch("meridian-test-program")
+          ? TestSwitchValue("meridian-test-program")
+          : Program();
+  if (program.find("/AppTranslocation/") != std::string::npos ||
+      base::StartsWith(program, "/Volumes/")) {
+    return "Meridian is running from the download (or its disk image), not "
+           "from Applications, and that place goes away. Move Meridian to "
+           "Applications, open it from there, and connect again.";
+  }
+#endif
+  return std::string();
+}
