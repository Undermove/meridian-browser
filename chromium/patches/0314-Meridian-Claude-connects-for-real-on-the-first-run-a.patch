+#include "chrome/browser/meridian/ai/cli_versions.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::ai {
+
+TEST(CliVersionsTest, ParsesWhatCommonCliesSay) {
+  EXPECT_EQ(ParseCliVersion("2.1.332 (Claude Code)\n"), "2.1.332");
+  EXPECT_EQ(ParseCliVersion("codex-cli 0.46.0"), "0.46.0");
+  EXPECT_EQ(ParseCliVersion("v1.2"), "1.2");
+  EXPECT_EQ(ParseCliVersion("command not found"), "");
+}
+
+TEST(CliVersionsTest, ComparesPartByPartAsNumbers) {
+  EXPECT_GT(CompareCliVersions("2.1.332", "2.1.41"), 0);
+  EXPECT_LT(CompareCliVersions("2.1.41", "2.1.332"), 0);
+  EXPECT_EQ(CompareCliVersions("2.1.0", "2.1"), 0);
+  EXPECT_GT(CompareCliVersions("10.0", "9.9.9"), 0);
+  // A copy that didn't say is the oldest.
+  EXPECT_LT(CompareCliVersions("", "0.0.1"), 0);
+  EXPECT_EQ(CompareCliVersions("", ""), 0);
+}
+
+}  // namespace meridian::ai
