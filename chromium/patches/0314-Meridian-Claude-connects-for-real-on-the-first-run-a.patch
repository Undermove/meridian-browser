+void SidebarHandler::ConnectAgentCliAccount(
+    const std::string& id,
+    const std::string& account_id,
+    ConnectAgentCliAccountCallback callback) {
+  ai::ListAccountsAsync(
+      browser_->GetProfile(),
+      base::BindOnce(
+          [](std::string id, std::string account_id,
+             ConnectAgentCliAccountCallback callback,
+             std::vector<ai::Account> list) {
+            const ai::AccountVendor* vendor = ai::FindAccountVendor(id);
+            const ai::Account* a =
+                vendor ? FindAccount(list, vendor->id, account_id) : nullptr;
+            if (!a) {
+              std::move(callback).Run(false, "That account isn’t listed.");
+              return;
+            }
+            std::map<std::string, std::string> env =
+                ai::AccountEnv(*vendor, ai::AccountsHome(), a->dir);
+            base::ThreadPool::PostTaskAndReplyWithResult(
+                FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+                base::BindOnce(
+                    [](std::string id,
+                       std::map<std::string, std::string> env) {
+                      std::string output;
+                      bool ok = meridian::ConnectAgentCliAs(id, env, &output);
+                      return std::make_pair(ok, output);
+                    },
+                    id, env),
+                base::BindOnce(
+                    [](ConnectAgentCliAccountCallback callback,
+                       std::pair<bool, std::string> r) {
+                      std::move(callback).Run(r.first, r.second);
+                    },
+                    std::move(callback)));
+          },
+          id, account_id, std::move(callback)));
