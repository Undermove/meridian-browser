+void SidebarHandler::CheckAiConnections(CheckAiConnectionsCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(
+      MainProfileFor(browser_->GetProfile()));
+  base::FilePath user_data;
+  base::PathService::Get(chrome::DIR_USER_DATA, &user_data);
+  auto with_desktop = base::BindOnce(
+      [](base::FilePath user_data, CheckAiConnectionsCallback callback,
+         std::vector<ai::LocalAgents::Status> list) {
+        base::ThreadPool::PostTaskAndReplyWithResult(
+            FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+            base::BindOnce(
+                [](base::FilePath user_data) {
+                  DesktopFacts f = ReadDesktopFacts(user_data);
+                  std::string code_state;
+                  for (const AgentCli& cli : DetectAgentClis()) {
+                    if (cli.id == "claude" && !cli.path.empty()) {
+                      code_state = cli.state.empty() ? "unknown" : cli.state;
+                    }
+                  }
+                  return std::make_pair(f, code_state);
+                },
+                user_data),
+            base::BindOnce(
+                [](CheckAiConnectionsCallback callback,
+                   std::vector<ai::LocalAgents::Status> list,
+                   std::pair<DesktopFacts, std::string> found) {
+                  std::vector<mojom::AiConnectionCheckPtr> out;
+                  const DesktopFacts& f = found.first;
+                  if (f.installed) {
+                    out.push_back(DesktopCheck(
+                        f, ClaudeDesktopLaunchTime(),
+                        HasTestSwitch("meridian-test-claude-needs-restart")));
+                  }
+                  for (const ai::LocalAgents::Status& s : list) {
+                    if (s.id != "claude-code" || !s.installed) {
+                      continue;
+                    }
+                    const char kName[] = "Claude Code";
+                    if (s.needs_update) {
+                      out.push_back(Check(
+                          "claude-code", kName, "update",
+                          "This Claude Code is too old to tell whether "
+                          "you’re signed in.",
+                          "update", "Update Claude Code"));
+                    } else if (s.signed_in == false) {
+                      out.push_back(Check(
+                          "claude-code", kName, "sign-in",
+                          "Claude Code is installed but not signed in, so "
+                          "Meridian’s AI features can’t use it yet.",
+                          "sign-in", "Sign in to Claude"));
+                    } else if (found.second == "not-connected") {
+                      out.push_back(Check(
+                          "claude-code", kName, "failed",
+                          "Claude Code can answer, but Meridian isn’t in its "
+                          "MCP servers.",
+                          "connect", "Connect"));
+                    } else {
+                      out.push_back(Check(
+                          "claude-code", kName, "ok",
+                          s.signed_in ? "Claude Code is signed in and "
+                                        "connected."
+                                      : "Claude Code is connected."));
+                    }
+                  }
+                  std::move(callback).Run(std::move(out));
+                },
+                std::move(callback), std::move(list)));
+      },
+      user_data, std::move(callback));
+  if (!ai) {
+    std::move(with_desktop).Run({});
+    return;
+  }
+  ai->local().List(/*fresh=*/true, std::move(with_desktop));
+}
