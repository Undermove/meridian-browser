+
+#ifndef CHROME_BROWSER_MERIDIAN_AI_CLI_VERSIONS_H_
+#define CHROME_BROWSER_MERIDIAN_AI_CLI_VERSIONS_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+namespace meridian::ai {
+
+// One copy of a CLI on this computer.
+struct CliCopy {
+  std::string path;
+  // "2.1.332" from its --version; "" when it didn't say (or there was only
+  // one copy, which is then never asked).
+  std::string version;
+};
+
+// "2.1.332" out of "2.1.332 (Claude Code)", "codex-cli 0.46.0" and the like;
+// "" when there is no version in it.
+std::string ParseCliVersion(const std::string& output);
+
+// <0, 0, >0 as `a` is older than, the same as, newer than `b` (numerically,
+// part by part: 2.1.332 > 2.1.41). An empty version is the oldest.
+int CompareCliVersions(const std::string& a, const std::string& b);
+
+// Every copy of `name`: in the folders of `search_path` first (in order),
+// then where installers put agent CLIs (~/.local/bin, ~/.claude/local,
+// /opt/homebrew/bin, /usr/local/bin, npm, Volta and Bun folders; not in a
+// test, which sees only its PATH). A link to a copy already listed is left
+// out. With more than one, each is asked its --version (cached per file and
+// its change time), and `copies` lists them newest first. Blocking.
+std::vector<CliCopy> FindCliCopies(
+    const std::string& name,
+    const std::string& search_path,
+    const std::map<std::string, std::string>& env);
+
+// The newest copy of `name` (on a tie, the first on the PATH); "" when there
+// is none. A computer with an old Claude Code in /usr/local/bin and a new one
+// in ~/.local/bin runs the new one, whichever the PATH lists first. Blocking.
+std::string FindNewestProgram(const std::string& name,
+                              const std::string& search_path,
+                              const std::map<std::string, std::string>& env,
+                              std::vector<CliCopy>* copies = nullptr);
+
+}  // namespace meridian::ai
+
+#endif  // CHROME_BROWSER_MERIDIAN_AI_CLI_VERSIONS_H_
