+// ---- Whether Meridian is already in an agent's config (read only)
+
+// The home folder whose configs are read: the tests' own, never the real one.
+base::FilePath StateHome() {
+  if (TestSwitchesAllowed()) {
+    return TestSwitchPath("meridian-accounts-home");
+  }
+  return base::GetHomeDir();
+}
+
+// A variable of the person's login environment (CLAUDE_CONFIG_DIR, …).
+std::string LoginEnvVar(const std::string& name) {
+  const std::map<std::string, std::string> env = ai::LoginEnvironment();
+  auto it = env.find(name);
+  return it != env.end() ? it->second : std::string();
+}
