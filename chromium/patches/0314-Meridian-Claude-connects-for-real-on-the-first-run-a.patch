+// Claude Desktop as its files say (blocking): what CheckAiConnections tells.
+struct DesktopFacts {
+  bool installed = false;
+  bool connected = false;
+  // The program in its "meridian" entry is still there.
+  bool program_there = true;
+  base::Time config_changed;
+  // When a bridge Claude Desktop started last said hello ("claude-ai").
+  base::Time hello;
+  std::string unstable;  // Meridian runs from a place that goes away
+};
+
+DesktopFacts ReadDesktopFacts(base::FilePath user_data) {
+  DesktopFacts f;
+  ClaudeDesktopState state = GetClaudeDesktopState();
+  f.installed = state.installed;
+  f.connected = state.connected;
+  if (!f.installed) {
+    return f;
+  }
+  base::File::Info info;
+  if (base::GetFileInfo(state.config, &info)) {
+    f.config_changed = info.last_modified;
+  }
+  std::string text;
+  if (f.connected && base::ReadFileToString(state.config, &text)) {
+    std::optional<base::DictValue> root =
+        base::JSONReader::ReadDict(text, base::JSON_ALLOW_TRAILING_COMMAS);
+    const std::string* command =
+        root ? root->FindStringByDottedPath("mcpServers.meridian.command")
+             : nullptr;
+    f.program_there =
+        !command || base::PathExists(base::FilePath::FromUTF8Unsafe(*command));
+  }
+  std::string hello;
+  int64_t ms = 0;
+  if (base::ReadFileToString(
+          user_data.AppendASCII("Meridian MCP Clients").AppendASCII("claude-ai"),
+          &hello) &&
+      base::StringToInt64(base::TrimWhitespaceASCII(hello, base::TRIM_ALL),
+                          &ms)) {
+    f.hello = base::Time::FromMillisecondsSinceUnixEpoch(ms);
+  }
+#if BUILDFLAG(IS_MAC)
+  const std::string program =
+      HasTestSwitch("meridian-test-program")
+          ? TestSwitchValue("meridian-test-program")
+          : base::CommandLine::ForCurrentProcess()->GetProgram().AsUTF8Unsafe();
+  if (program.find("/AppTranslocation/") != std::string::npos ||
+      base::StartsWith(program, "/Volumes/")) {
+    f.unstable =
+        "Meridian is running from the download, not from Applications, so "
+        "Claude Desktop can’t start it later. Move Meridian to Applications, "
+        "open it from there, and connect again.";
+  }
+#endif
+  return f;
+}
+
+mojom::AiConnectionCheckPtr Check(std::string id,
+                                  std::string name,
+                                  std::string state,
+                                  std::string message,
+                                  std::string fix = std::string(),
+                                  std::string fix_label = std::string()) {
+  auto c = mojom::AiConnectionCheck::New();
+  c->id = std::move(id);
+  c->name = std::move(name);
+  c->state = std::move(state);
+  c->message = std::move(message);
+  c->fix = std::move(fix);
+  c->fix_label = std::move(fix_label);
+  return c;
+}
+
+// `launched`: when the running Claude Desktop started (null: not running).
+mojom::AiConnectionCheckPtr DesktopCheck(const DesktopFacts& f,
+                                         base::Time launched,
+                                         bool test_needs_restart) {
+  const char kName[] = "Claude Desktop";
+  if (!f.unstable.empty()) {
+    return Check("claude-desktop", kName, "failed", f.unstable);
+  }
+  if (!f.connected) {
+    return Check("claude-desktop", kName, "failed",
+                 "Meridian isn’t in Claude Desktop’s settings yet.", "connect",
+                 "Connect");
+  }
+  if (!f.program_there) {
+    return Check("claude-desktop", kName, "failed",
+                 "Claude Desktop’s settings point to a Meridian that isn’t "
+                 "there any more.",
+                 "connect", "Connect again");
+  }
+  // It said hello after the entry was last written: it really works.
+  if (!f.hello.is_null() &&
+      (f.config_changed.is_null() || f.hello >= f.config_changed)) {
+    return Check("claude-desktop", kName, "ok",
+                 "Claude Desktop is connected: it started Meridian’s tools.");
+  }
+  const bool started_before =
+      TestSwitchesAllowed() ? test_needs_restart
+                            : !launched.is_null() &&
+                                  launched < f.config_changed;
+  if (started_before) {
+    return Check("claude-desktop", kName, "restart",
+                 "Claude Desktop was open before Meridian was added, so it "
+                 "needs a restart to load it.",
+                 "restart-desktop", "Restart Claude");
+  }
+  if (launched.is_null()) {
+    return Check("claude-desktop", kName, "waiting",
+                 "Claude Desktop loads Meridian when it opens.",
+                 "open-desktop", "Open Claude");
+  }
+  if (base::Time::Now() - launched < base::Seconds(20)) {
+    return Check("claude-desktop", kName, "waiting",
+                 "Claude Desktop is starting and loading Meridian…");
+  }
+  return Check("claude-desktop", kName, "failed",
+               "Claude Desktop started but didn’t load Meridian. Restart it; "
+               "if it still doesn’t show up, Claude’s Settings › Developer "
+               "says why.",
+               "restart-desktop", "Restart Claude");
+}
