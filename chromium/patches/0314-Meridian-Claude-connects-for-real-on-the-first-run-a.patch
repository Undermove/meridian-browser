+std::optional<base::DictValue> ReadJsonFile(const base::FilePath& file) {
+  std::string text;
+  if (file.empty() || !base::ReadFileToString(file, &text)) {
+    return std::nullopt;
+  }
+  return base::JSONReader::ReadDict(text,
+                                    base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+}
+
+// "connected" when `servers_key` of the JSON file has "meridian"; a file that
+// isn't there: "not-connected"; one that can't be read: "".
+std::string JsonState(const base::FilePath& file, const std::string& key) {
+  if (file.empty()) {
+    return std::string();
+  }
+  if (!base::PathExists(file)) {
+    return "not-connected";
+  }
+  std::optional<base::DictValue> root = ReadJsonFile(file);
+  if (!root) {
+    return std::string();
+  }
+  const base::DictValue* servers = root->FindDict(key);
+  return servers && servers->FindDict("meridian") ? "connected"
+                                                  : "not-connected";
+}
+
+base::FilePath ClaudeJson(const base::FilePath& dir, const base::FilePath& home) {
+  // The CLI's own folder keeps its file next to it, in the home folder.
+  if (dir.StripTrailingSeparators() ==
+      home.AppendASCII(".claude").StripTrailingSeparators()) {
+    return home.AppendASCII(".claude.json");
+  }
+  return dir.AppendASCII(".claude.json");
+}
+
+bool CodexTomlHasMeridian(const base::FilePath& file) {
+  std::string text;
+  return base::ReadFileToString(file, &text) &&
+         RE2::PartialMatch(
+             text, "(?m)^\\s*\\[\\s*mcp_servers\\.\\\"?meridian\\\"?\\s*\\]");
+}
+
+// The default account's folder: the login environment's variable, else the
+// CLI's own folder.
+base::FilePath DefaultDir(const std::string& var, const char* folder,
+                          const base::FilePath& home) {
+  const std::string from_env =
+      TestSwitchesAllowed() ? ai::TestLoginEnv()[var] : LoginEnvVar(var);
+  return from_env.empty() ? home.AppendASCII(folder)
+                          : base::FilePath::FromUTF8Unsafe(from_env);
+}
+
+std::string CliState(const std::string& id) {
+  const base::FilePath home = StateHome();
+  if (home.empty()) {
+    return std::string();
+  }
+  if (id == "claude") {
+    return JsonState(
+        ClaudeJson(DefaultDir("CLAUDE_CONFIG_DIR", ".claude", home), home),
+        "mcpServers");
+  }
+  if (id == "codex") {
+    return CodexTomlHasMeridian(
+               DefaultDir("CODEX_HOME", ".codex", home)
+                   .AppendASCII("config.toml"))
+               ? "connected"
+               : "not-connected";
+  }
+  if (id == "copilot") {
+    return JsonState(DefaultDir("COPILOT_HOME", ".copilot", home)
+                         .AppendASCII("mcp-config.json"),
+                     "mcpServers");
+  }
+  if (id == "gemini") {
+    return JsonState(home.AppendASCII(".gemini/settings.json"), "mcpServers");
+  }
+  if (id == "qwen") {
+    return JsonState(home.AppendASCII(".qwen/settings.json"), "mcpServers");
+  }
+  if (id == "vscode") {
+#if BUILDFLAG(IS_MAC)
+    return JsonState(
+        home.AppendASCII("Library/Application Support/Code/User/mcp.json"),
+        "servers");
+#elif BUILDFLAG(IS_WIN)
+    base::FilePath roaming;
+    if (TestSwitchesAllowed() ||
+        !base::PathService::Get(base::DIR_ROAMING_APP_DATA, &roaming)) {
+      return JsonState(home.AppendASCII("Code/User/mcp.json"), "servers");
+    }
+    return JsonState(roaming.AppendASCII("Code/User/mcp.json"), "servers");
+#else
+    return JsonState(home.AppendASCII(".config/Code/User/mcp.json"),
+                     "servers");
+#endif
+  }
+  return std::string();
+}
