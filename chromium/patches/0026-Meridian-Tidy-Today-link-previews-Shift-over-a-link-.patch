+void SidebarHandler::ListChats(ListChatsCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!ai) {
+    std::move(callback).Run({});
+    return;
+  }
+  ai->chats().WhenLoaded(base::BindOnce(
+      [](base::WeakPtr<AiService> ai, ListChatsCallback callback) {
+        std::vector<mojom::ChatSummaryPtr> out;
+        if (ai) {
+          for (const base::Value& c : ai->chats().List()) {
+            const base::DictValue& d = c.GetDict();
+            out.push_back(mojom::ChatSummary::New(*d.FindString("id"),
+                                                  *d.FindString("title"),
+                                                  *d.FindDouble("updated")));
+          }
+        }
+        std::move(callback).Run(std::move(out));
+      },
+      ai->GetWeakPtr(), std::move(callback)));
+}
+
+void SidebarHandler::GetChat(const std::string& id, GetChatCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!ai) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  ai->chats().WhenLoaded(base::BindOnce(
+      [](base::WeakPtr<AiService> ai, std::string id,
+         GetChatCallback callback) {
+        const base::DictValue* d = ai ? ai->chats().Get(id) : nullptr;
+        if (!d) {
+          std::move(callback).Run(nullptr);
+          return;
+        }
+        auto chat = mojom::Chat::New();
+        chat->id = *d->FindString("id");
+        chat->title = *d->FindString("title");
+        chat->created = *d->FindDouble("created");
+        chat->updated = *d->FindDouble("updated");
+        for (const base::Value& v : *d->FindList("messages")) {
+          const base::DictValue& m = v.GetDict();
+          const std::string* provider = m.FindString("provider");
+          chat->messages.push_back(mojom::ChatMessage::New(
+              *m.FindString("role"), *m.FindString("text"),
+              *m.FindDouble("ts"), provider ? *provider : std::string(),
+              m.FindBool("stopped").value_or(false)));
+        }
+        std::move(callback).Run(std::move(chat));
+      },
+      ai->GetWeakPtr(), id, std::move(callback)));
+}
+
+void SidebarHandler::SaveChat(mojom::ChatPtr chat) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!ai || !chat) {
+    return;
+  }
+  base::ListValue messages;
+  for (const mojom::ChatMessagePtr& m : chat->messages) {
+    base::DictValue message;
+    message.Set("role", m->role);
+    message.Set("text", m->text);
+    message.Set("ts", m->ts);
+    if (!m->provider.empty()) {
+      message.Set("provider", m->provider);
+    }
+    if (m->stopped) {
+      message.Set("stopped", true);
+    }
+    messages.Append(std::move(message));
+  }
+  base::DictValue d;
+  d.Set("id", chat->id);
+  d.Set("title", chat->title);
+  d.Set("created", chat->created);
+  d.Set("updated", chat->updated);
+  d.Set("messages", std::move(messages));
+  ai->chats().WhenLoaded(base::BindOnce(
+      [](base::WeakPtr<AiService> ai, base::DictValue d) {
+        if (ai) {
+          ai->chats().Save(d);
+        }
+      },
+      ai->GetWeakPtr(), std::move(d)));
+}
+
+void SidebarHandler::DeleteChat(const std::string& id) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!ai) {
+    return;
+  }
+  ai->Reset("chat-" + id);
+  ai->chats().WhenLoaded(base::BindOnce(
+      [](base::WeakPtr<AiService> ai, std::string id) {
+        if (ai) {
+          ai->chats().Delete(id);
+        }
+      },
+      ai->GetWeakPtr(), id));
+}
+
+void SidebarHandler::TidyToday(std::vector<mojom::TidyTabPtr> tabs,
+                               TidyTodayCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!ai) {
+    std::move(callback).Run({}, {}, "AI isn’t available in a private window.");
+    return;
+  }
+  if (!browser_->GetProfile()->GetPrefs()->GetBoolean(prefs::kAiTidy)) {
+    std::move(callback).Run({}, {},
+                            "Tidy Today is off. Turn it on in Settings > AI.");
+    return;
+  }
+  std::vector<ai::TidyTab> list;
+  for (const mojom::TidyTabPtr& t : tabs) {
+    list.push_back({t->id, t->title, t->url});
+  }
+  ai->Tidy(std::move(list),
+           base::BindOnce(
+               [](TidyTodayCallback callback, std::optional<ai::TidyPlan> plan,
+                  std::string error) {
+                 std::vector<mojom::TidyFolderPtr> folders;
+                 std::vector<mojom::TidyRenamePtr> renames;
+                 if (plan) {
+                   for (ai::TidyFolder& f : plan->folders) {
+                     folders.push_back(mojom::TidyFolder::New(
+                         std::move(f.name), std::move(f.tab_ids)));
+                   }
+                   for (ai::TidyRename& r : plan->renames) {
+                     renames.push_back(mojom::TidyRename::New(
+                         std::move(r.tab_id), std::move(r.title)));
+                   }
+                 }
+                 std::move(callback).Run(std::move(folders), std::move(renames),
+                                         error);
+               },
+               std::move(callback)));
+}
