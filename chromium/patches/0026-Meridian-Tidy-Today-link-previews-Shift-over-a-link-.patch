+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AI_PAGE_FETCHER_H_
+#define CHROME_BROWSER_MERIDIAN_AI_PAGE_FETCHER_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "chrome/browser/meridian/ai/page_text.h"
+#include "url/gurl.h"
+
+class Profile;
+
+namespace meridian::ai {
+
+// Loads a public web page for a link preview. A hovered link is chosen by
+// the page, so the request carries no cookies or other credentials (a
+// credentialed GET would let a page act or read as the person), and only
+// public http(s) targets are loaded: every hop of a redirect chain is
+// checked, and loopback, private, link-local and similar addresses (literal
+// or resolved) are refused. Size and time are capped.
+//
+// `done` gets the page's text and the final URL, or a message.
+void FetchPublicPage(
+    Profile* profile,
+    const GURL& url,
+    base::OnceCallback<void(PageText page, GURL final_url, std::string error)>
+        done);
+
+}  // namespace meridian::ai
