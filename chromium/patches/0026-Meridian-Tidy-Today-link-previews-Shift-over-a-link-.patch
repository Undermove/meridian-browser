+
+TEST(PageTextTest, ReadableTextWithoutScripts) {
+  PageText page = ExtractPageText(
+      "<html><head><title>Khachapuri &amp; more</title>"
+      "<meta name=\"description\" content=\"Georgian &quot;cheese&quot; bread\">"
+      "<style>p{}</style></head><body><script>alert(1)</script>"
+      "<h1>Recipe</h1><p>Flour,&nbsp;cheese</p><!-- hidden --><p>Egg &#8212; "
+      "yolk</p></body></html>");
+  EXPECT_EQ(page.title, "Khachapuri & more");
+  EXPECT_EQ(page.description, "Georgian \"cheese\" bread");
+  EXPECT_EQ(page.text, "Recipe\nFlour, cheese\nEgg — yolk");
+}
+
+TEST(PageTextTest, LocalNames) {
+  EXPECT_TRUE(IsLocalHostName("localhost"));
+  EXPECT_TRUE(IsLocalHostName("printer.local"));
+  EXPECT_TRUE(IsLocalHostName("router"));
+  EXPECT_TRUE(IsLocalHostName("nas.home.arpa."));
+  EXPECT_FALSE(IsLocalHostName("example.com"));
+  EXPECT_FALSE(IsLocalHostName("93.184.216.34"));
+  EXPECT_FALSE(IsLocalHostName("[2606:2800:220:1::]"));
+}
