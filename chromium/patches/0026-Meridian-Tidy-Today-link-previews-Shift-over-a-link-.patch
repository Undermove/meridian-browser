@@ -0,0 +1,62 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AI_TIDY_H_
+#define CHROME_BROWSER_MERIDIAN_AI_TIDY_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+
+namespace meridian::ai {
+
+// Tidy Today (like Arc's Tidy Tabs): Claude proposes folders and shorter
+// titles for the Today tabs. Only a proposal: the person sees it and picks
+// what to apply. Tab titles and URLs are written by websites, so they go out
+// as untrusted data under short keys (t1, t2…), and the answer is checked
+// against the tabs that were sent.
+
+struct TidyTab {
+  std::string id;
+  std::string title;
+  std::string url;
+};
+
+struct TidyFolder {
+  std::string name;
+  std::vector<std::string> tab_ids;
+};
+
+struct TidyRename {
+  std::string tab_id;
+  std::string title;
+};
+
+struct TidyPlan {
+  std::vector<TidyFolder> folders;
+  std::vector<TidyRename> renames;
+};
+
+extern const char kTidySystem[];
+
+// The JSON schema the answer follows.
+base::DictValue TidySchema();
+
+// The question about `tabs` (at most 80; the rest are left out).
+std::string TidyPrompt(const std::vector<TidyTab>& tabs);
+
+// The plan in Claude's answer, keeping only what refers to tabs that were
+// sent: folders of at least two tabs (each tab in one folder, at most six
+// folders) and titles that actually change. nullopt if it isn't a plan.
+std::optional<TidyPlan> ParseTidyPlan(const std::string& answer,
+                                      const std::vector<TidyTab>& tabs);
+
+// One line, no control or bidi characters, at most `max` characters.
+std::string OneLine(const std::string& text, size_t max);
+
+}  // namespace meridian::ai
+
+#endif  // CHROME_BROWSER_MERIDIAN_AI_TIDY_H_
