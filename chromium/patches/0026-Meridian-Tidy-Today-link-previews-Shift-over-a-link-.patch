+bool StatusBubble::PreviewsOn() const {
+  Profile* profile = browser_->GetProfile();
+  if (profile->IsOffTheRecord() ||
+      !profile->GetPrefs()->GetBoolean(prefs::kAiLinkPreview)) {
+    return false;
+  }
+  AiService* ai = AiServiceFactory::GetForProfile(profile);
+  tabs::TabInterface* tab = browser_->GetActiveTabInterface();
+  // Not over Meridian's own pages.
+  return ai && ai->HasKey() && tab &&
+         tab->GetContents()->GetLastCommittedURL().SchemeIsHTTPOrHTTPS();
+}
+
+void StatusBubble::Watch() {
+  tabs::TabInterface* tab = browser_->GetActiveTabInterface();
+  if (!tab) {
+    return;
+  }
+  content::RenderWidgetHost* host =
+      tab->GetContents()->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  if (host->GetProcess()->GetDeprecatedID() == watched_process_ &&
+      host->GetRoutingID() == watched_routing_) {
+    return;
+  }
+  StopWatching();
+  host->AddInputEventObserver(this);
+  watched_process_ = host->GetProcess()->GetDeprecatedID();
+  watched_routing_ = host->GetRoutingID();
+  shift_ = false;
+}
+
+void StatusBubble::StopWatching() {
+  if (content::RenderWidgetHost* host = content::RenderWidgetHost::FromID(
+          watched_process_, watched_routing_)) {
+    host->RemoveInputEventObserver(this);
+  }
+  watched_process_ = watched_routing_ = -1;
+}
+
+void StatusBubble::OnInputEvent(const content::RenderWidgetHost& host,
+                                const blink::WebInputEvent& event,
+                                InputEventSource source) {
+  bool shift = event.GetModifiers() & blink::WebInputEvent::kShiftKey;
+  if (shift == shift_) {
+    return;
+  }
+  shift_ = shift;
+  if (shift) {
+    MaybePreview();
+  }
+}
+
+void StatusBubble::MaybePreview() {
+  if (!shift_ || !hovered_.SchemeIsHTTPOrHTTPS() || hovered_ == previewed_ ||
+      !PreviewsOn()) {
+    return;
+  }
+  previewed_ = hovered_;
+  SidebarHandler::ShowLinkPreview(browser_, "start", previewed_.spec(), "",
+                                  "", std::string(previewed_.host()), "");
+  AiServiceFactory::GetForProfile(browser_->GetProfile())
+      ->PreviewLink(
+          previewed_,
+          base::BindOnce(
+              [](base::WeakPtr<StatusBubble> self, GURL url,
+                 AiService::Preview preview) {
+                if (!self || url != self->previewed_) {
+                  return;
+                }
+                SidebarHandler::ShowLinkPreview(
+                    self->browser_, preview.error.empty() ? "result" : "error",
+                    url.spec(), preview.title, preview.summary, preview.host,
+                    preview.error);
+              },
+              weak_factory_.GetWeakPtr(), previewed_));
+}
+
+void StatusBubble::Leave() {
+  if (previewed_.is_valid()) {
+    SidebarHandler::ShowLinkPreview(browser_, "leave", previewed_.spec(), "",
+                                    "", "", "");
+    previewed_ = GURL();
+  }
+}
+
 }  // namespace meridian
