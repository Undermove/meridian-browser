index 0000000000..69d08420b7
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/tidy.css
@@ -0,0 +1,256 @@
+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  position: fixed;
+  inset: 0;
+  z-index: 50;
+  display: none;
+  color: var(--meridian-text);
+  font-size: 13px;
+}
+
+:host([open]) {
+  display: block;
+}
+
+button {
+  border: 0;
+  font: inherit;
+  color: inherit;
+  cursor: default;
+}
+
+#overlay {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  justify-content: center;
+  align-items: flex-start;
+  padding-top: 10vh;
+  background: var(--meridian-overlay);
+  app-region: no-drag;
+  -webkit-app-region: no-drag;
+}
+
+#card {
+  width: min(620px, 90vw);
+  max-height: 76vh;
+  display: flex;
+  flex-direction: column;
+  border-radius: 14px;
+  background: var(--meridian-surface);
+  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35),
+    0 0 0 0.5px var(--meridian-border);
+  overflow: hidden;
+  outline: none;
+}
+
+#head,
+#foot {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 0 14px;
+}
+
+#head {
+  height: 48px;
+  border-bottom: 1px solid var(--meridian-border);
+}
+
+#foot {
+  height: 54px;
+  border-top: 1px solid var(--meridian-border);
+}
+
+.title {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-weight: 600;
+}
+
+.title svg {
+  color: var(--meridian-space);
+}
+
+.grow {
+  flex: 1;
+}
+
+.hint {
+  font-size: 11.5px;
+  color: var(--meridian-text-muted);
+}
+
+#body {
+  flex: 1;
+  overflow-y: auto;
+  padding: 12px 14px;
+}
+
+.status {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8px;
+  padding: 36px 12px;
+  text-align: center;
+  color: var(--meridian-text-muted);
+}
+
+.status-title {
+  font-weight: 600;
+  color: var(--meridian-text);
+}
+
+.spark {
+  color: var(--meridian-space);
+  animation: pulse 1.2s ease-in-out infinite;
+}
+
+@keyframes pulse {
+  50% {
+    opacity: 0.35;
+  }
+}
+
+.ok {
+  color: #1e7b3a;
+}
+
+.note {
+  margin-bottom: 10px;
+  font-size: 12px;
+  color: var(--meridian-text-muted);
+}
+
+.group {
+  margin-bottom: 10px;
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--meridian-text) 4%, transparent);
+  overflow: hidden;
+}
+
+.group.off .row {
+  opacity: 0.45;
+}
+
+.group-head {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 9px 12px;
+  font-weight: 600;
+}
+
+.group-head .name {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.tag {
+  font-size: 11px;
+  font-weight: 500;
+  color: var(--meridian-text-muted);
+}
+
+.row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-height: 30px;
+  padding: 4px 12px 4px 36px;
+  border-top: 1px solid var(--meridian-border);
+}
+
+.rename {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-left: -24px;
+}
+
+.old,
+.same,
+.new {
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.same {
+  flex: 1;
+}
+
+.old {
+  flex: 1 1 50%;
+  color: var(--meridian-text-muted);
+  text-decoration: line-through;
+}
+
+.arrow {
+  flex: none;
+  color: var(--meridian-text-muted);
+}
+
+.new {
+  flex: 1 1 50%;
+  font-weight: 500;
+}
+
+.host {
+  flex: none;
+  max-width: 140px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 11px;
+  color: var(--meridian-text-muted);
+}
+
+.icon-btn {
+  width: 26px;
+  height: 26px;
+  border-radius: 7px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  background: none;
+  color: var(--meridian-text-muted);
+}
+
+.icon-btn:hover {
+  background: var(--meridian-row-hover);
+  color: var(--meridian-text);
+}
+
+.btn {
+  height: 28px;
+  padding: 0 12px;
+  border-radius: 8px;
+  font-weight: 550;
+  background: color-mix(in srgb, var(--meridian-text) 8%, transparent);
+}
+
+.btn.primary {
+  background: color-mix(in oklab, var(--meridian-space) 78%, #141420);
+  color: #fff;
+}
+
+.btn:disabled {
+  opacity: 0.5;
+}
