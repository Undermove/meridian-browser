+constexpr size_t kMaxChats = 200;
+constexpr size_t kMaxChatBytes = 200000;
+constexpr size_t kMaxMessages = 400;
+constexpr size_t kMaxText = 100000;
+
+std::string Str(const base::DictValue& d, const char* key, size_t max) {
+  const std::string* s = d.FindString(key);
+  if (!s) {
+    return std::string();
+  }
+  std::string out = *s;
+  if (out.size() > max) {
+    // Back to a character boundary.
+    size_t cut = max;
+    while (cut > 0 && (out[cut] & 0xc0) == 0x80) {
+      --cut;
+    }
+    out.resize(cut);
+  }
+  return out;
+}
+
+double Time(const base::DictValue& d, const char* key) {
+  std::optional<double> t = d.FindDouble(key);
+  return t && *t > 0 ? std::floor(*t)
+                     : base::Time::Now().InMillisecondsFSinceUnixEpoch();
+}
+
+std::optional<base::DictValue> CleanMessage(const base::Value& v) {
+  if (!v.is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& m = v.GetDict();
+  std::string role = Str(m, "role", 16);
+  std::string text = Str(m, "text", kMaxText);
+  if ((role != "user" && role != "assistant") || text.empty()) {
+    return std::nullopt;
+  }
+  base::DictValue out;
+  out.Set("role", role);
+  out.Set("text", text);
+  out.Set("ts", Time(m, "ts"));
+  if (role == "assistant") {
+    std::string provider = Str(m, "provider", 40);
+    if (!provider.empty() && RE2::FullMatch(provider, "[a-z0-9-]+")) {
+      out.Set("provider", provider);
+    }
+    if (m.FindBool("stopped").value_or(false)) {
+      out.Set("stopped", true);
+    }
+  }
+  return out;
+}
+
+size_t Bytes(const base::DictValue& message) {
+  return message.FindString("text")->size() + 64;
+}
+
+}  // namespace
+
+std::optional<base::DictValue> CleanChat(const base::DictValue& chat) {
+  std::string id = Str(chat, "id", 65);
+  if (!RE2::FullMatch(id, "[A-Za-z0-9_-]{1,64}")) {
+    return std::nullopt;
+  }
+  base::ListValue messages;
+  if (const base::ListValue* raw = chat.FindList("messages")) {
+    size_t from = raw->size() > kMaxMessages ? raw->size() - kMaxMessages : 0;
+    for (size_t i = from; i < raw->size(); ++i) {
+      if (std::optional<base::DictValue> m = CleanMessage((*raw)[i])) {
+        messages.Append(std::move(*m));
+      }
+    }
+  }
+  // About kMaxChatBytes: the oldest messages go first.
+  size_t total = 0;
+  for (const base::Value& m : messages) {
+    total += Bytes(m.GetDict());
+  }
+  while (total > kMaxChatBytes && messages.size() > 1) {
+    total -= Bytes(messages.front().GetDict());
+    messages.erase(messages.begin());
+  }
+  std::string title = OneLine(Str(chat, "title", 400), 120);
+  base::DictValue out;
+  out.Set("id", id);
+  out.Set("title", title.empty() ? std::string("New chat") : title);
+  out.Set("created", Time(chat, "created"));
+  out.Set("updated", Time(chat, "updated"));
+  out.Set("messages", std::move(messages));
+  return out;
+}
+
+ChatStore::ChatStore(const base::FilePath& file)
+    : file_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN})),
+      writer_(file, file_runner_, base::Seconds(1)) {
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath file) -> std::optional<std::string> {
+            std::string contents;
+            if (!base::ReadFileToString(file, &contents)) {
+              return std::nullopt;
+            }
+            return contents;
+          },
+          file),
+      base::BindOnce(&ChatStore::OnRead, weak_factory_.GetWeakPtr()));
+}
+
+ChatStore::~ChatStore() {
+  if (writer_.HasPendingWrite()) {
+    writer_.DoScheduledWrite();
+  }
+}
+
+void ChatStore::OnRead(std::optional<std::string> contents) {
+  if (contents) {
+    std::optional<base::Value> v = base::JSONReader::Read(*contents, 0);
+    const base::ListValue* list =
+        v && v->is_dict() ? v->GetDict().FindList("chats") : nullptr;
+    if (list) {
+      for (const base::Value& c : *list) {
+        if (c.is_dict()) {
+          if (std::optional<base::DictValue> clean = CleanChat(c.GetDict())) {
+            chats_.Append(std::move(*clean));
+          }
+        }
+      }
+    }
+  }
+  loaded_ = true;
+  for (base::OnceClosure& done : waiting_) {
+    std::move(done).Run();
+  }
+  waiting_.clear();
+}
+
+void ChatStore::WhenLoaded(base::OnceClosure done) {
+  if (loaded_) {
+    std::move(done).Run();
+    return;
+  }
+  waiting_.push_back(std::move(done));
+}
+
+base::ListValue ChatStore::List() const {
+  std::vector<const base::DictValue*> sorted;
+  for (const base::Value& c : chats_) {
+    sorted.push_back(&c.GetDict());
+  }
+  std::ranges::stable_sort(sorted, [](const base::DictValue* a,
+                                      const base::DictValue* b) {
+    return *a->FindDouble("updated") > *b->FindDouble("updated");
+  });
+  base::ListValue out;
+  for (const base::DictValue* c : sorted) {
+    out.Append(base::DictValue()
+                   .Set("id", *c->FindString("id"))
+                   .Set("title", *c->FindString("title"))
+                   .Set("updated", *c->FindDouble("updated")));
+  }
+  return out;
+}
+
+const base::DictValue* ChatStore::Get(const std::string& id) const {
+  for (const base::Value& c : chats_) {
+    if (*c.GetDict().FindString("id") == id) {
+      return &c.GetDict();
+    }
+  }
+  return nullptr;
+}
+
+void ChatStore::Save(const base::DictValue& chat) {
+  std::optional<base::DictValue> clean = CleanChat(chat);
+  if (!clean) {
+    return;
+  }
+  std::string id = *clean->FindString("id");
+  chats_.EraseIf([&](const base::Value& c) {
+    return *c.GetDict().FindString("id") == id;
+  });
+  chats_.Append(std::move(*clean));
+  while (chats_.size() > kMaxChats) {
+    chats_.erase(chats_.begin());
+  }
+  writer_.ScheduleWrite(this);
+}
+
+void ChatStore::Delete(const std::string& id) {
+  chats_.EraseIf([&](const base::Value& c) {
+    return *c.GetDict().FindString("id") == id;
+  });
+  writer_.ScheduleWrite(this);
+}
+
+std::optional<std::string> ChatStore::SerializeData() {
+  std::optional<std::string> json =
+      base::WriteJson(base::DictValue().Set("chats", chats_.Clone()));
+  // Readable by this user only (after the write, which replaces the file).
+  writer_.RegisterOnNextWriteCallbacks(
+      base::OnceClosure(),
+      base::BindOnce(
+          [](base::FilePath file, bool success) {
+            if (success) {
+              base::SetPosixFilePermissions(file, 0600);
+            }
+          },
+          writer_.path()));
+  return json;
+}
+
+}  // namespace meridian::ai
