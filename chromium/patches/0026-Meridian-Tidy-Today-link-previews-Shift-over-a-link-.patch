@@ -0,0 +1,86 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/ai/chats.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "base/run_loop.h"
+#include "base/test/task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::ai {
+namespace {
+
+base::DictValue Parse(const char* json) {
+  return std::move(base::JSONReader::Read(json, 0)->GetDict());
+}
+
+TEST(ChatsTest, CleanKeepsKnownFieldsOnly) {
+  std::optional<base::DictValue> chat = CleanChat(Parse(R"({
+    "id": "c1", "title": "  Trip\nplans ", "created": 5, "updated": 9,
+    "evil": "x",
+    "messages": [
+      {"role": "user", "text": "hi", "ts": 6},
+      {"role": "system", "text": "nope"},
+      {"role": "assistant", "text": "hello", "provider": "Bad Id!",
+       "stopped": true, "html": "<b>"},
+      {"role": "assistant", "text": ""}
+    ]})"));
+  ASSERT_TRUE(chat);
+  EXPECT_FALSE(chat->Find("evil"));
+  EXPECT_EQ(*chat->FindString("title"), "Trip plans");
+  const base::ListValue& messages = *chat->FindList("messages");
+  ASSERT_EQ(messages.size(), 2u);
+  EXPECT_FALSE(messages[1].GetDict().Find("provider"));
+  EXPECT_FALSE(messages[1].GetDict().Find("html"));
+  EXPECT_TRUE(*messages[1].GetDict().FindBool("stopped"));
+  EXPECT_FALSE(CleanChat(Parse(R"({"id": "../../etc"})")));
+}
+
+TEST(ChatsTest, LongChatsLoseTheOldestMessages) {
+  base::ListValue messages;
+  for (int i = 0; i < 10; ++i) {
+    messages.Append(base::DictValue()
+                        .Set("role", "user")
+                        .Set("text", std::string(50000, 'a' + i)));
+  }
+  std::optional<base::DictValue> chat = CleanChat(
+      base::DictValue().Set("id", "c").Set("messages", std::move(messages)));
+  const base::ListValue& kept = *chat->FindList("messages");
+  EXPECT_LT(kept.size(), 10u);
+  EXPECT_EQ((*kept.back().GetDict().FindString("text"))[0], 'j');
+}
+
+TEST(ChatsTest, StoreSavesListsAndReloads) {
+  base::test::TaskEnvironment env;
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::FilePath file = dir.GetPath().Append("chats.json");
+  {
+    ChatStore store(file);
+    base::RunLoop loaded;
+    store.WhenLoaded(loaded.QuitClosure());
+    loaded.Run();
+    store.Save(Parse(R"({"id": "a", "title": "A", "updated": 1,
+                         "messages": [{"role": "user", "text": "x"}]})"));
+    store.Save(Parse(R"({"id": "b", "title": "B", "updated": 2})"));
+    EXPECT_EQ(*store.List()[0].GetDict().FindString("id"), "b");
+    store.Delete("b");
+  }
+  env.RunUntilIdle();
+  int mode = 0;
+  ASSERT_TRUE(base::GetPosixFilePermissions(file, &mode));
+  EXPECT_EQ(mode, 0600);
+  ChatStore again(file);
+  base::RunLoop loaded;
+  again.WhenLoaded(loaded.QuitClosure());
+  loaded.Run();
+  ASSERT_EQ(again.List().size(), 1u);
+  EXPECT_EQ(*again.Get("a")->FindString("title"), "A");
+}
+
+}  // namespace
+}  // namespace meridian::ai
diff --git a/chrome/browser/meridian/ai/page_fetcher.cc b/chrome/browser/meridian/ai/page_fetcher.cc
new file mode 100644
index 0000000000..88adc52fe7
--- /dev/null
+++ b/chrome/browser/meridian/ai/page_fetcher.cc
@@ -0,0 +1,253 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/ai/page_fetcher.h"
+
+#include <memory>
+
+#include "base/command_line.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/storage_partition.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "net/base/address_list.h"
+#include "net/base/host_port_pair.h"
+#include "net/base/ip_address.h"
+#include "net/base/load_flags.h"
+#include "net/base/network_anonymization_key.h"
+#include "net/dns/public/host_resolver_results.h"
+#include "net/dns/public/resolve_error_info.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resolve_host_client_base.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/cpp/simple_url_loader_stream_consumer.h"
+#include "services/network/public/mojom/network_context.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace meridian::ai {
+
+namespace {
+
+constexpr size_t kMaxBody = 1500000;
+constexpr int kMaxHops = 5;
+
+constexpr char kLocal[] =
+    "Links to this computer or your local network aren’t previewed.";
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("meridian_link_preview", R"(
+      semantics {
+        sender: "Meridian link previews"
+        description:
+          "Loads the public page behind a link the person holds Shift over, "
+          "to summarize it."
+        trigger: "Holding Shift over a link, with link previews on."
+        data: "None: no cookies or other credentials are sent."
+        destination: WEBSITE
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Settings > AI > Link previews (off by default)."
+        policy_exception_justification: "Opt-in feature."
+      })");
+
+// Hosts tests may load ("127.0.0.1:port").
+bool Allowed(const GURL& url) {
+  std::string list = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      "meridian-preview-allow-hosts");
+  std::string host = url.GetHost() + ":" + url.GetPort();
+  for (const std::string& h : base::SplitString(
+           list, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (h == host) {
+      return true;
+    }
+  }
+  return false;
+}
+
+class Fetch : public network::ResolveHostClientBase,
+              public network::SimpleURLLoaderStreamConsumer {
+ public:
+  using Done =
+      base::OnceCallback<void(PageText page, GURL final_url, std::string error)>;
+
+  Fetch(Profile* profile, Done done)
+      : partition_(profile->GetDefaultStoragePartition()),
+        done_(std::move(done)) {}
+
+  void Start(const GURL& url) {
+    url_ = url;
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      return Fail("That link doesn’t lead to a web page.");
+    }
+    if (url.has_username() || url.has_password()) {
+      return Fail("Links with a user name or password aren’t previewed.");
+    }
+    if (Allowed(url)) {
+      return Load();
+    }
+    std::string host(url.HostNoBrackets());
+    net::IPAddress ip;
+    if (ip.AssignFromIPLiteral(host)) {
+      return ip.IsPubliclyRoutable() ? Load() : Fail(kLocal);
+    }
+    if (IsLocalHostName(host)) {
+      return Fail(kLocal);
+    }
+    receiver_.reset();
+    partition_->GetNetworkContext()->ResolveHost(
+        network::mojom::HostResolverHost::NewHostPortPair(
+            net::HostPortPair::FromURL(url)),
+        net::NetworkAnonymizationKey::CreateTransient(), nullptr,
+        receiver_.BindNewPipeAndPassRemote());
+    receiver_.set_disconnect_handler(
+        base::BindOnce(&Fetch::Fail, base::Unretained(this),
+                       std::string("Couldn’t find that site.")));
+  }
+
+  // network::mojom::ResolveHostClient:
+  void OnComplete(int32_t result,
+                  const net::ResolveErrorInfo& resolve_error_info,
+                  const net::AddressList& resolved_addresses,
+                  const net::HostResolverEndpointResults&) override {
+    receiver_.reset();
+    if (result != net::OK || resolved_addresses.empty()) {
+      return Fail("Couldn’t find that site.");
+    }
+    for (const net::IPEndPoint& endpoint : resolved_addresses) {
+      if (!endpoint.address().IsPubliclyRoutable()) {
+        return Fail(kLocal);
+      }
+    }
+    Load();
+  }
+
+  // network::SimpleURLLoaderStreamConsumer:
+  void OnDataReceived(std::string_view data,
+                      base::OnceClosure resume) override {
+    body_.append(data.substr(0, kMaxBody - std::min(kMaxBody, body_.size())));
+    if (body_.size() >= kMaxBody) {
+      // Enough to summarize.
+      loader_.reset();
+      return Finish();
+    }
+    std::move(resume).Run();
+  }
+
+  void OnComplete(bool success) override {
+    if (status_ != 200) {
+      return Fail(status_ ? "The page answered with an error (HTTP " +
+                                base::NumberToString(status_) + ")."
+                          : "Couldn’t load that page.");
+    }
+    if (!success && body_.empty()) {
+      return Fail("Couldn’t load that page.");
+    }
+    Finish();
+  }
+
+  void OnRetry(base::OnceClosure start_retry) override {}
+
+ private:
+  void Load() {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url_;
+    request->method = "GET";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->load_flags = net::LOAD_DISABLE_CACHE;
+    request->referrer_policy = net::ReferrerPolicy::NO_REFERRER;
+    request->headers.SetHeader(
+        "Accept", "text/html,application/xhtml+xml;q=0.9,text/plain;q=0.8");
+    body_.clear();
+    status_ = 0;
+    loader_ =
+        network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+    loader_->SetTimeoutDuration(base::Seconds(10));
+    loader_->SetAllowHttpErrorResults(true);
+    // Each hop is checked again: stop here and start over at the new URL.
+    loader_->SetOnRedirectCallback(base::BindRepeating(
+        [](Fetch* self, const GURL&, const net::RedirectInfo& info,
+           const network::mojom::URLResponseHead&, std::vector<std::string>*) {
+          GURL next = info.new_url;
+          base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+              FROM_HERE, base::BindOnce(&Fetch::Redirect,
+                                        self->weak_factory_.GetWeakPtr(),
+                                        next));
+          self->loader_.reset();
+        },
+        base::Unretained(this)));
+    loader_->SetOnResponseStartedCallback(base::BindOnce(
+        [](Fetch* self, const GURL&,
+           const network::mojom::URLResponseHead& head) {
+          self->status_ = head.headers ? head.headers->response_code() : 0;
+          std::string type;
+          if (head.headers) {
+            head.headers->GetMimeType(&type);
+          }
+          self->text_ = type.empty() || type == "text/html" ||
+                        type == "application/xhtml+xml" || type == "text/plain";
+          self->plain_ = type == "text/plain";
+        },
+        base::Unretained(this)));
+    loader_->DownloadAsStream(
+        partition_->GetURLLoaderFactoryForBrowserProcess().get(), this);
+  }
+
+  void Redirect(GURL next) {
+    if (++hops_ > kMaxHops) {
+      return Fail("That link redirects too many times.");
+    }
+    Start(next);
+  }
+
+  void Finish() {
+    if (!text_) {
+      return Fail("That link isn’t a web page.");
+    }
+    PageText page;
+    if (plain_) {
+      page.text = body_.substr(0, 20000);
+    } else {
+      page = ExtractPageText(body_);
+    }
+    Done done = std::move(done_);
+    GURL url = url_;
+    delete this;
+    std::move(done).Run(std::move(page), url, std::string());
+  }
+
+  void Fail(std::string error) {
+    Done done = std::move(done_);
+    delete this;
+    std::move(done).Run(PageText(), GURL(), error);
+  }
+
+  raw_ptr<content::StoragePartition> partition_;
+  Done done_;
+  GURL url_;
+  int hops_ = 0;
+  int status_ = 0;
+  bool text_ = false;
+  bool plain_ = false;
+  std::string body_;
+  mojo::Receiver<network::mojom::ResolveHostClient> receiver_{this};
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::WeakPtrFactory<Fetch> weak_factory_{this};
+};
+
+}  // namespace
+
+void FetchPublicPage(
+    Profile* profile,
+    const GURL& url,
+    base::OnceCallback<void(PageText, GURL, std::string)> done) {
+  (new Fetch(profile, std::move(done)))->Start(url);
+}
+
+}  // namespace meridian::ai
