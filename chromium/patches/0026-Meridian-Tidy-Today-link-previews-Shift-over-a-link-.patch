+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import type {MeridianTidyElement} from './tidy.js';
+
+export function getHtml(this: MeridianTidyElement) {
+  return html`<!--_html_template_start_-->
+<div id="overlay" @mousedown="${this.onOverlayMousedown_}"
+    @keydown="${this.onKeydown_}">
+  <div id="card" role="dialog" aria-label="Tidy Today" tabindex="-1">
+    <div id="head">
+      <span class="title">${icon('sparkles', 16)} Tidy Today</span>
+      <div class="grow"></div>
+      <button id="close" class="icon-btn" title="Close (Esc)"
+          @click="${this.onCloseClick_}">${icon('x', 14)}</button>
+    </div>
+    <div id="body">
+      ${this.phase_ === 'loading' ? html`
+        <div class="status">
+          <span class="spark">${icon('sparkles', 20)}</span>
+          <div>Claude is sorting ${this.count_} tabs…</div>
+        </div>` : ''}
+      ${this.phase_ === 'error' ? html`
+        <div class="status">
+          <div class="status-title">Couldn’t tidy</div>
+          <div id="error" class="status-sub">${this.error_}</div>
+        </div>` : ''}
+      ${this.phase_ === 'empty' ? html`
+        <div class="status">
+          <span class="ok">${icon('check', 20)}</span>
+          <div class="status-title">Already tidy</div>
+          <div class="status-sub">Claude found nothing worth grouping or
+            renaming.</div>
+        </div>` : ''}
+      ${this.phase_ === 'plan' ? html`
+        <div class="note">New folders go to Pinned in this space; tabs you
+          don’t group stay in Today. Untick anything you don’t want.</div>
+        ${this.groups_.map(g => html`
+          <div class="group ${g.checked ? '' : 'off'}">
+            <label class="group-head">
+              <input type="checkbox" data-index="${g.index}"
+                  .checked="${g.checked}" @change="${this.onFolderChange_}">
+              ${icon('folder', 15)}
+              <span class="name">${g.name}</span>
+              <span class="tag">New folder · ${g.count} tabs</span>
+            </label>
+            ${g.rows.map(r => html`
+              <div class="row">
+                ${r.renamed ? html`
+                  <label class="rename">
+                    <input type="checkbox" data-tab="${r.tabId}"
+                        .checked="${r.checked}"
+                        @change="${this.onRenameChange_}">
+                    <span class="old">${r.title}</span>
+                    <span class="arrow">→</span>
+                    <span class="new">${r.newTitle}</span>
+                  </label>` : html`<span class="same">${r.title}</span>`}
+                <span class="host">${r.host}</span>
+              </div>`)}
+          </div>`)}
+        ${this.hasLoose_ ? html`
+          <div class="group">
+            <div class="group-head">${icon('pencil', 14)}
+              <span class="name">Shorter titles</span></div>
+            ${this.loose_.map(r => html`
+              <div class="row">
+                <label class="rename">
+                  <input type="checkbox" data-tab="${r.tabId}"
+                      .checked="${r.checked}" @change="${this.onRenameChange_}">
+                  <span class="old">${r.title}</span>
+                  <span class="arrow">→</span>
+                  <span class="new">${r.newTitle}</span>
+                </label>
+                <span class="host">${r.host}</span>
+              </div>`)}
+          </div>` : ''}` : ''}
+    </div>
+    <div id="foot">
+      <span class="hint">Nothing changes until you apply it.</span>
+      <div class="grow"></div>
+      <button class="btn" @click="${this.onCloseClick_}">Cancel</button>
+      <button id="apply" class="btn primary" ?disabled="${this.phase_ !== 'plan'}"
+          @click="${this.onApplyClick_}">Apply</button>
+    </div>
+  </div>
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/tidy.ts b/chrome/browser/resources/webui_browser/meridian/tidy.ts
new file mode 100644
index 0000000000..00b5c12f9d
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/tidy.ts
@@ -0,0 +1,193 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Tidy Today: Claude's proposal (folders, shorter titles) for the active
+// space's Today tabs, shown as a preview. Nothing changes until Apply; the
+// person can untick any folder or title.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {SidebarHandlerInterface, TidyFolder, TidyRename, TidyTab} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './tidy.css.js';
+import {getHtml} from './tidy.html.js';
+
+export interface TidyRow {
+  tabId: string;
+  title: string;
+  newTitle: string;
+  renamed: boolean;
+  host: string;
+  // The new title is applied.
+  checked: boolean;
+}
+
+export interface TidyGroup {
+  index: number;
+  name: string;
+  checked: boolean;
+  count: number;
+  rows: TidyRow[];
+}
+
+export interface TidyApply {
+  folders: TidyFolder[];
+  renames: TidyRename[];
+}
+
+function hostOf(url: string): string {
+  try {
+    return new URL(url).host.replace(/^www\./, '');
+  } catch {
+    return '';
+  }
+}
+
+export class MeridianTidyElement extends CrLitElement {
+  static get is() {
+    return 'meridian-tidy';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      phase_: {state: true, type: String},
+      count_: {state: true, type: Number},
+      error_: {state: true, type: String},
+      groups_: {state: true, type: Array},
+      loose_: {state: true, type: Array},
+      hasLoose_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  // "loading", "error", "empty" or "plan".
+  protected accessor phase_: string = 'loading';
+  protected accessor count_: number = 0;
+  protected accessor error_: string = '';
+  protected accessor groups_: TidyGroup[] = [];
+  protected accessor loose_: TidyRow[] = [];
+  protected accessor hasLoose_: boolean = false;
+
+  private readonly handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  // A newer Tidy (or Cancel) makes an older answer moot.
+  private run_: number = 0;
+
+  async show(tabs: TidyTab[]) {
+    const run = ++this.run_;
+    this.open = true;
+    this.phase_ = 'loading';
+    this.count_ = tabs.length;
+    this.groups_ = [];
+    this.loose_ = [];
+    this.hasLoose_ = false;
+    const {folders, renames, error} = await this.handler_.tidyToday(tabs);
+    if (run !== this.run_) {
+      return;
+    }
+    if (error) {
+      this.error_ = error;
+      this.phase_ = 'error';
+      return;
+    }
+    if (!folders.length && !renames.length) {
+      this.phase_ = 'empty';
+      return;
+    }
+    const byId = new Map(tabs.map(t => [t.id, t]));
+    const titles = new Map(renames.map(r => [r.tabId, r.title]));
+    const row = (id: string): TidyRow => {
+      const tab = byId.get(id)!;
+      const newTitle = titles.get(id) || '';
+      return {
+        tabId: id,
+        title: tab.title || tab.url,
+        newTitle,
+        renamed: !!newTitle,
+        host: hostOf(tab.url),
+        checked: !!newTitle,
+      };
+    };
+    this.groups_ = folders.map((f, index) => ({
+                                 index,
+                                 name: f.name,
+                                 checked: true,
+                                 count: f.tabIds.length,
+                                 rows: f.tabIds.filter(id => byId.has(id))
+                                           .map(row),
+                               }));
+    const grouped = new Set(folders.flatMap(f => f.tabIds));
+    this.loose_ = renames.filter(r => !grouped.has(r.tabId) && byId.has(r.tabId))
+                      .map(r => row(r.tabId));
+    this.hasLoose_ = this.loose_.length > 0;
+    this.phase_ = 'plan';
+  }
+
+  hide() {
+    this.run_++;
+    this.open = false;
+  }
+
+  protected onFolderChange_(e: Event) {
+    const box = e.target as HTMLInputElement;
+    const index = Number(box.dataset['index']);
+    this.groups_ = this.groups_.map(
+        g => g.index === index ? {...g, checked: box.checked} : g);
+  }
+
+  protected onRenameChange_(e: Event) {
+    const box = e.target as HTMLInputElement;
+    const id = box.dataset['tab'];
+    const flip = (r: TidyRow) => r.tabId === id ? {...r, checked: box.checked} : r;
+    this.groups_ = this.groups_.map(g => ({...g, rows: g.rows.map(flip)}));
+    this.loose_ = this.loose_.map(flip);
+  }
+
+  protected onApplyClick_() {
+    const rows = [...this.groups_.flatMap(g => g.rows), ...this.loose_];
+    const apply: TidyApply = {
+      folders: this.groups_.filter(g => g.checked)
+                   .map(g => ({name: g.name, tabIds: g.rows.map(r => r.tabId)})),
+      renames: rows.filter(r => r.renamed && r.checked)
+                   .map(r => ({tabId: r.tabId, title: r.newTitle})),
+    };
+    this.hide();
+    this.fire('meridian-tidy-apply', apply);
+  }
+
+  protected onCloseClick_() {
+    this.hide();
+  }
+
+  protected onOverlayMousedown_(e: MouseEvent) {
+    if (e.target === e.currentTarget) {
+      this.hide();
+    }
+  }
+
+  protected onKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.hide();
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-tidy': MeridianTidyElement;
+  }
+}
+
+customElements.define(MeridianTidyElement.is, MeridianTidyElement);
