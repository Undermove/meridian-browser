+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AI_CHATS_H_
+#define CHROME_BROWSER_MERIDIAN_AI_CHATS_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+
+namespace base {
+class SequencedTaskRunner;
+}
+
+namespace meridian::ai {
+
+// Chat view conversations ({id, title, created, updated, messages: [{role,
+// text, ts, provider?, stopped?}]}), kept in "Meridian Chats.json" (0600) in
+// the profile. The page sends whole chats; everything is checked here: known
+// fields only, at most 200 chats (oldest dropped) and about 200 KB per chat
+// (oldest messages dropped).
+
+// A safe, size-limited copy of a chat the page sent, or nullopt.
+std::optional<base::DictValue> CleanChat(const base::DictValue& chat);
+
+class ChatStore : public base::ImportantFileWriter::DataSerializer {
+ public:
+  explicit ChatStore(const base::FilePath& file);
+  ChatStore(const ChatStore&) = delete;
+  ChatStore& operator=(const ChatStore&) = delete;
+  ~ChatStore() override;
+
+  // Runs `done` once the file has been read (at once if it was).
+  void WhenLoaded(base::OnceClosure done);
+  bool loaded() const { return loaded_; }
+
+  // Newest first: {id, title, updated}.
+  base::ListValue List() const;
+  const base::DictValue* Get(const std::string& id) const;
+  void Save(const base::DictValue& chat);
+  void Delete(const std::string& id);
+
+  // base::ImportantFileWriter::DataSerializer:
+  std::optional<std::string> SerializeData() override;
+
+ private:
+  void OnRead(std::optional<std::string> contents);
+
+  scoped_refptr<base::SequencedTaskRunner> file_runner_;
+  base::ImportantFileWriter writer_;
+  bool loaded_ = false;
+  std::vector<base::OnceClosure> waiting_;
+  // Oldest first.
+  base::ListValue chats_;
+  base::WeakPtrFactory<ChatStore> weak_factory_{this};
+};
+
+}  // namespace meridian::ai
+
+#endif  // CHROME_BROWSER_MERIDIAN_AI_CHATS_H_
