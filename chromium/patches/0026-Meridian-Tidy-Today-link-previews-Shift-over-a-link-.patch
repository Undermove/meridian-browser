diff --git a/chrome/browser/meridian/ai/page_text.cc b/chrome/browser/meridian/ai/page_text.cc
new file mode 100644
index 0000000000..3308fe0cc8
--- /dev/null
+++ b/chrome/browser/meridian/ai/page_text.cc
@@ -0,0 +1,114 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/ai/page_text.h"
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversion_utils.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/meridian/ai/tidy.h"
+#include "net/base/ip_address.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace meridian::ai {
+
+namespace {
+
+constexpr size_t kTextLimit = 20000;
+
+std::string Decode(std::string s) {
+  RE2::GlobalReplace(&s, "&nbsp;", " ");
+  RE2::GlobalReplace(&s, "&lt;", "<");
+  RE2::GlobalReplace(&s, "&gt;", ">");
+  RE2::GlobalReplace(&s, "&quot;", "\"");
+  RE2::GlobalReplace(&s, "&#39;|&apos;", "'");
+  // Numeric references.
+  std::string out;
+  re2::StringPiece input(s);
+  std::string number;
+  size_t last = 0;
+  re2::StringPiece match;
+  while (RE2::FindAndConsume(&input, "(&#(\\d{1,7});)", &match, &number)) {
+    size_t at = static_cast<size_t>(match.data() - s.data());
+    out.append(s, last, at - last);
+    uint32_t code = 0;
+    if (base::StringToUint(number, &code) && code < 0x110000 &&
+        (code < 0xd800 || code > 0xdfff)) {
+      base::WriteUnicodeCharacter(static_cast<int32_t>(code), &out);
+    } else {
+      out += ' ';
+    }
+    last = at + match.size();
+  }
+  out.append(s, last, std::string::npos);
+  RE2::GlobalReplace(&out, "&amp;", "&");
+  return out;
+}
+
+std::string First(const std::string& html, const char* pattern) {
+  std::string found;
+  RE2::PartialMatch(html, pattern, &found);
+  return found;
+}
+
+}  // namespace
+
+PageText ExtractPageText(const std::string& html) {
+  PageText page;
+  page.title = OneLine(
+      Decode(First(html, "(?is)<title[^>]*>(.*?)</title>")), 200);
+  page.description = OneLine(
+      Decode(First(html,
+                   "(?is)<meta[^>]+name=[\"']description[\"'][^>]*content=["
+                   "\"']([^\"']*)")),
+      300);
+  std::string body = html;
+  for (const char* tag :
+       {"script", "style", "noscript", "svg", "template", "iframe", "head"}) {
+    RE2::GlobalReplace(&body,
+                       std::string("(?is)<") + tag + "\\b.*?</" + tag + ">",
+                       " ");
+  }
+  RE2::GlobalReplace(&body, "(?s)<!--.*?-->", " ");
+  RE2::GlobalReplace(&body, "(?i)</(p|div|li|h[1-6]|tr|section|article)>|<br\\s*/?>",
+                     "\n");
+  RE2::GlobalReplace(&body, "(?s)<[^>]+>", " ");
+  body = Decode(body);
+  RE2::GlobalReplace(&body, "[ \\t\\x{a0}]+", " ");
+  RE2::GlobalReplace(&body, " ?\\n ?", "\n");
+  RE2::GlobalReplace(&body, "\\n\\n+", "\n");
+  body = std::string(base::TrimWhitespaceASCII(body, base::TRIM_ALL));
+  if (body.size() > kTextLimit * 2) {
+    body.resize(kTextLimit * 2);
+  }
+  std::u16string text = base::UTF8ToUTF16(body);
+  if (text.size() > kTextLimit) {
+    text.resize(kTextLimit);
+  }
+  page.text = base::UTF16ToUTF8(text);
+  return page;
+}
+
+bool IsLocalHostName(const std::string& raw) {
+  std::string host = base::ToLowerASCII(raw);
+  if (host.starts_with("[") && host.ends_with("]")) {
+    host = host.substr(1, host.size() - 2);
+  }
+  if (host.ends_with(".")) {
+    host.pop_back();
+  }
+  if (host.empty() || host == "localhost") {
+    return true;
+  }
+  if (RE2::PartialMatch(host,
+                        "\\.(localhost|local|internal|lan|home\\.arpa)$")) {
+    return true;
+  }
+  net::IPAddress ip;
+  return host.find('.') == std::string::npos &&
+         !ip.AssignFromIPLiteral(host);
+}
+
+}  // namespace meridian::ai
