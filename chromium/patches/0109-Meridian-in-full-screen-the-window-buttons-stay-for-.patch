From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 9 Nov 2026 14:32:00 +0400
Subject: [PATCH 110/110] Meridian: in full screen the window buttons stay for
 macOS's top bar, also with the sidebar hidden
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

With ⌘S the close/minimize/zoom buttons went with the sidebar, so the bar
macOS slides down at the top of a full screen came down without them.
TestWindowState says where they are, for tests.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/sidebar.mojom          | 5 ++++-
 chrome/browser/meridian/sidebar_handler.cc     | 2 +-
 chrome/browser/meridian/sidebar_handler_mac.mm | 8 ++++++--
 chrome/browser/resources/webui_browser/app.ts  | 8 ++++++--
 4 files changed, 17 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/meridian/sidebar.mojom b/chrome/browser/meridian/sidebar.mojom
index e4b297fccd..eed0be4cf4 100644
--- a/chrome/browser/meridian/sidebar.mojom
+++ b/chrome/browser/meridian/sidebar.mojom
@@ -568,7 +568,10 @@ interface SidebarHandler {
   TestCommand(int32 command_id);
   // Tests (--meridian-test-keys): where this window is. `order`: its place
   // among the app's windows, front to back (-1 if not ordered in).
-  TestWindowState() => (bool visible, bool on_active_space, int32 order);
+  // `controls`: the class of the window the close/minimize/zoom buttons are
+  // in, empty while they are hidden.
+  TestWindowState() => (bool visible, bool on_active_space, int32 order,
+                        string controls);
 
   // Split view: the active tab and `other` side by side (⌃⇧=), back to one
   // (⌃⇧-), and the divider position.
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index fac7616299..ddf718f236 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -2804,7 +2804,7 @@ void SidebarHandler::SetWindowControlsVisible(bool visible) {}
 void SidebarHandler::SwitchKeyboardLayout(const std::string& language) {}
 
 void SidebarHandler::TestWindowState(TestWindowStateCallback callback) {
-  std::move(callback).Run(false, false, -1);
+  std::move(callback).Run(false, false, -1, std::string());
 }
 
 std::string SystemUserFullName() {
diff --git a/chrome/browser/meridian/sidebar_handler_mac.mm b/chrome/browser/meridian/sidebar_handler_mac.mm
index cb3f8da20d..532ec20165 100644
--- a/chrome/browser/meridian/sidebar_handler_mac.mm
+++ b/chrome/browser/meridian/sidebar_handler_mac.mm
@@ -36,13 +36,17 @@ void SidebarHandler::TestWindowState(TestWindowStateCallback callback) {
   NSWindow* window =
       browser_->GetWindow()->GetNativeWindow().GetNativeNSWindow();
   if (!HasTestSwitch("meridian-test-keys") || !window) {
-    std::move(callback).Run(false, false, -1);
+    std::move(callback).Run(false, false, -1, std::string());
     return;
   }
   NSUInteger order = [NSApp.orderedWindows indexOfObject:window];
+  NSButton* close = [window standardWindowButton:NSWindowCloseButton];
   std::move(callback).Run(
       window.isVisible, window.isOnActiveSpace,
-      order == NSNotFound ? -1 : static_cast<int32_t>(order));
+      order == NSNotFound ? -1 : static_cast<int32_t>(order),
+      close && !close.hiddenOrHasHiddenAncestor && close.window
+          ? base::SysNSStringToUTF8(NSStringFromClass([close.window class]))
+          : std::string());
 }
 
 void SidebarHandler::SwitchKeyboardLayout(const std::string& language) {
diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index bb87b48fd9..887e4e53ed 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -514,9 +514,13 @@ export class WebuiBrowserAppElement extends CrLitElement {
     }
     if (changed.has('sidebarHidden_' as keyof WebuiBrowserAppElement) ||
         changed.has('sidebarPeek_' as keyof WebuiBrowserAppElement) ||
-        changed.has('little_' as keyof WebuiBrowserAppElement)) {
+        changed.has('little_' as keyof WebuiBrowserAppElement) ||
+        changed.has('fullscreenMode_' as keyof WebuiBrowserAppElement)) {
+      // In full screen they are macOS's, in the bar it slides down from the
+      // top of the screen: there whatever the sidebar does, as in Arc.
       this.$.tabstrip.setWindowControlsVisible(
-          this.little_ || !this.sidebarHidden_ || this.sidebarPeek_);
+          this.little_ || !this.sidebarHidden_ || this.sidebarPeek_ ||
+          this.fullscreenMode_ === 'browser');
     }
   }
 
