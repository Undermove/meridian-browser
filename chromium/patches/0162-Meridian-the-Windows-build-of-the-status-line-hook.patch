From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Wed, 18 Nov 2026 17:42:08 +0400
Subject: [PATCH 162/297] Meridian: the Windows build of the status line hook

OwnStatusLine() is used only where the person's own status line is
chained (POSIX). On Windows it was unused, and -Werror stopped the
build; it now sits in the POSIX block with RunShell.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/meridian/mission/mission_hook.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/chrome/browser/meridian/mission/mission_hook.cc b/chrome/browser/meridian/mission/mission_hook.cc
index 32c58ed83f..95ae4b8068 100644
--- a/chrome/browser/meridian/mission/mission_hook.cc
+++ b/chrome/browser/meridian/mission/mission_hook.cc
@@ -236,6 +236,7 @@ std::optional<std::string> CauseName(std::string_view s) {
   return std::string(s);
 }
 
+#if BUILDFLAG(IS_POSIX)  // Theirs runs through the shell, POSIX only.
 // The settings file a status line of the person's own comes from: the
 // project's (local first), then their user settings. The session's
 // --settings (Meridian's) outranks them all, so Meridian runs theirs.
@@ -275,7 +276,6 @@ std::optional<std::string> OwnStatusLine(const std::string& project_dir) {
   return std::nullopt;
 }
 
-#if BUILDFLAG(IS_POSIX)
 // Runs `command` in the shell with `input` on stdin; its stdout.
 std::string RunShell(const std::string& command, const std::string& input) {
   int in[2], out[2];
