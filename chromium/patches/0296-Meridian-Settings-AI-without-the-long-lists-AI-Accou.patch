index d7d02a9958..67d5ed1f86 100644
--- a/chrome/browser/resources/webui_browser/meridian/settings.ts
+++ b/chrome/browser/resources/webui_browser/meridian/settings.ts
@@ -90,8 +90,66 @@ export interface AiRow {
   // A cloud key's model picker.
   models: ModelChoice[];
   hasModels: boolean;
+  // Its CLI's accounts (several subscriptions), if it has any.
+  accounts?: AccountGroup|null;
 }
 
+// AI subscriptions side by side (GetAiAccounts, ai/account_prefs.h).
+export interface AiAccount {
+  id: string;
+  label: string;
+  default: boolean;
+  found: boolean;
+  // The spaces that use it (for the default: those that don't name one).
+  spaces: string[];
+  dir: string;
+}
+export interface AiAccountVendor {
+  id: string;
+  label: string;
+  short: string;
+  accounts: AiAccount[];
+}
+export interface AiAccounts {
+  vendors: AiAccountVendor[];
+  // space id -> vendor -> account id.
+  spaces: {[space: string]: {[vendor: string]: string}};
+  suggestion: {[space: string]: {[vendor: string]: string}};
+  hint: string;
+}
+// An account as Settings shows it.
+export interface AccountChip {
+  vendor: string;
+  id: string;
+  label: string;
+  // "Work space" / "All spaces" / "No space yet".
+  where: string;
+  dir: string;
+  isDefault: boolean;
+  editing: boolean;
+}
+// A vendor's accounts under its row in "Your AI".
+export interface AccountGroup {
+  vendor: string;
+  short: string;
+  chips: AccountChip[];
+  adding: boolean;
+}
+
+// A row of "Your AI" and its accounts; `row` null for a tool that only has
+// accounts here (Gemini CLI runs in Workbench, not Ask).
+export interface AiItem {
+  row: AiRow|null;
+  group: AccountGroup|null;
+}
+
+// The Ask providers that run a CLI with accounts.
+export const ACCOUNT_VENDOR_OF: {[provider: string]: string} = {
+  'claude-code': 'claude',
+  'codex': 'codex',
+  'copilot': 'copilot',
+};
+
 export interface ModelChoice {
   value: string;
   label: string;
