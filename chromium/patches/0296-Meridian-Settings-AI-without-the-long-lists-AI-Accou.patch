+
+/* Settings > AI: the one Ask picker, accounts, the folded tools. */
+#askWith {
+  max-width: 220px;
+}
+
+.row.radio.on {
+  background: color-mix(in srgb, var(--meridian-space, #5b6cff) 7%,
+                        transparent);
+}
+
+.tag.answers {
+  color: color-mix(in oklab, var(--meridian-space, #5b6cff) 80%,
+                   var(--meridian-text));
+  background: color-mix(in srgb, var(--meridian-space, #5b6cff) 14%,
+                        transparent);
+}
+
+.row.accounts {
+  min-height: 0;
+  padding: 0 12px 10px 46px;
+}
+
+.row.accounts::before,
+.row.account-add::before,
+.row.account-edit::before {
+  display: none;
+}
+
+.acc-list {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+  min-width: 0;
+}
+
+.acc-title {
+  font-size: 11px;
+  color: var(--meridian-text-muted);
+  margin-right: 2px;
+}
+
+.acc {
+  display: inline-flex;
+  align-items: baseline;
+  gap: 5px;
+  max-width: 100%;
+  padding: 3px 9px;
+  border-radius: 999px;
+  font-size: 12px;
+  background: var(--meridian-surface);
+  box-shadow: 0 0 0 0.5px var(--meridian-border);
+}
+
+.acc b {
+  font-weight: 500;
+}
+
+.acc small {
+  color: var(--meridian-text-muted);
+  font-size: 11px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.acc.on {
+  box-shadow: 0 0 0 1.5px var(--meridian-space, #5b6cff);
+}
+
+.acc.add {
+  align-items: center;
+  background: transparent;
+  color: var(--meridian-text-muted);
+  box-shadow: none;
+  border: 1px dashed var(--meridian-border);
+  padding: 2px 9px;
+}
+
+.row.account-add,
+.row.account-edit {
+  min-height: 0;
+  padding: 0 12px 10px 46px;
+}
+
+.row.account-edit .text {
+  width: 180px;
+}
+
+.row.account-edit .row-desc {
+  margin-top: 4px;
+}
+
+.hint-card {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin: 0 0 18px;
+  padding: 12px;
+  border-radius: 12px;
+  background: color-mix(in srgb, var(--meridian-space, #5b6cff) 10%,
+                        transparent);
+  box-shadow: 0 0 0 0.5px color-mix(in srgb, var(--meridian-space, #5b6cff)
+                                    35%, transparent);
+}
+
+details.more-ai summary,
+details.fold summary {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  cursor: default;
+  list-style: none;
+  min-width: 0;
+}
+
+details.more-ai summary::-webkit-details-marker,
+details.fold summary::-webkit-details-marker {
+  display: none;
+}
+
+details.more-ai summary h2 {
+  margin-bottom: 0;
+  flex: none;
+}
+
+details.more-ai summary h2::after {
+  content: ' ›';
+}
+
+details.more-ai[open] summary h2::after {
+  content: ' ⌄';
+}
+
+.more-names {
+  color: var(--meridian-text-muted);
+  font-size: 11.5px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  min-width: 0;
+}
+
+.more-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
+  gap: 6px;
+  margin-top: 8px;
+}
+
+.more-item {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+  padding: 7px 8px;
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--meridian-text) 4%, transparent);
+  box-shadow: 0 0 0 0.5px var(--meridian-border);
+}
+
+.more-item .mark {
+  width: 18px;
+  height: 18px;
+  font-size: 10.5px;
+  border-radius: 5px;
+}
+
+.more-label {
+  flex: 1;
+  min-width: 0;
+  font-size: 12px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+details.fold {
+  margin-top: 8px;
+}
+
+details.fold summary {
+  color: var(--meridian-text-muted);
+  font-size: 12px;
+  margin: 0 12px 6px;
+}
+
+details.fold summary::after {
+  content: '›';
+}
+
+details.fold[open] summary::after {
+  content: '⌄';
+}
