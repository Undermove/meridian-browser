From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 16 Nov 2026 19:27:26 +0400
Subject: [PATCH 149/202] Meridian: after a crash the tabs come back, as after
 a quit

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/ui/startup/startup_browser_creator.cc | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/ui/startup/startup_browser_creator.cc b/chrome/browser/ui/startup/startup_browser_creator.cc
index 0c7f221246..d635569fa2 100644
--- a/chrome/browser/ui/startup/startup_browser_creator.cc
+++ b/chrome/browser/ui/startup/startup_browser_creator.cc
@@ -1656,11 +1656,10 @@ bool StartupBrowserCreator::ActivatedProfile() {
 }
 
 bool HasPendingUncleanExit(Profile* profile) {
-  return ExitTypeService::GetLastSessionExitType(profile) ==
-             ExitType::kCrashed &&
-         !ProfileLaunchObserver::HasBeenLaunchedAndBrowserOpen(profile) &&
-         !base::CommandLine::ForCurrentProcess()->HasSwitch(
-             switches::kHideCrashRestoreBubble);
+  // Meridian: as in Arc, a crash (or a force quit) is a restart like any
+  // other: the spaces and tabs come back on the next launch, with no "Restore
+  // pages?" bubble and no crashed window left for ⇧⌘T.
+  return false;
 }
 
 StartupProfilePathInfo GetStartupProfilePath(
