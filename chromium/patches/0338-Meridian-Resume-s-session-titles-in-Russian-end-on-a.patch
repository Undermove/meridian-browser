From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 26 Nov 2026 18:02:41 +0400
Subject: [PATCH 1/2] Meridian: Resume's session titles in Russian end on a
 whole letter
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Resume's list across accounts cut a long title at 117 bytes. A Russian
title is two bytes a letter, so about every other one ended in half a
letter (shown as U+FFFD) before the "…". The cut is now at a whole
character.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../meridian/workbench/agent_insights.cc       |  6 ++++--
 .../workbench/agent_insights_unittest.cc       | 18 ++++++++++++++++++
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/meridian/workbench/agent_insights.cc b/chrome/browser/meridian/workbench/agent_insights.cc
index f4abfd45fc..1cc41a28f2 100644
--- a/chrome/browser/meridian/workbench/agent_insights.cc
+++ b/chrome/browser/meridian/workbench/agent_insights.cc
@@ -550,9 +550,11 @@ std::vector<ClaudeSessionFile> ClaudeSessionsIn(const base::FilePath& config,
         if (found.empty() || found.starts_with("<")) {
           continue;
         }
+        // Cut at a character, never inside one (a Russian title is two bytes
+        // a letter: a cut there showed as U+FFFD).
         if (found.size() > 120) {
-          found.resize(117);
-          found += "…";
+          found =
+              std::string(base::TruncateUTF8ToByteSize(found, 117)) + "…";
         }
         s.title = std::move(found);
         break;
diff --git a/chrome/browser/meridian/workbench/agent_insights_unittest.cc b/chrome/browser/meridian/workbench/agent_insights_unittest.cc
index 6ed9de27c3..2f9963e1cf 100644
--- a/chrome/browser/meridian/workbench/agent_insights_unittest.cc
+++ b/chrome/browser/meridian/workbench/agent_insights_unittest.cc
@@ -152,6 +152,24 @@ TEST(AgentInsightsTest, ClaudeSessionsPerAccountFolder) {
   EXPECT_EQ(list[1].id, "aaa-1");
   EXPECT_EQ(list[1].title, "Fix the checkout");
   EXPECT_EQ(ClaudeSessionsIn(personal, root, 1).size(), 1u);
+  // A long title in Russian is cut at a letter, never inside one.
+  std::string long_title;
+  for (int i = 0; i < 40; i++) {
+    long_title += "\xd0\xbf\xd1\x80\xd0\xb8";  // three letters, two bytes each
+  }
+  ASSERT_TRUE(base::WriteFile(
+      dir.AppendASCII("ccc-3.jsonl"),
+      "{\"type\":\"user\",\"message\":{\"content\":\"" + long_title +
+          "\"}}\n"));
+  base::TouchFile(dir.AppendASCII("ccc-3.jsonl"), now + base::Hours(1),
+                  now + base::Hours(1));
+  std::vector<ClaudeSessionFile> cut = ClaudeSessionsIn(personal, root, 1);
+  ASSERT_EQ(cut.size(), 1u);
+  EXPECT_EQ(cut[0].id, "ccc-3");
+  EXPECT_TRUE(base::IsStringUTF8(cut[0].title));
+  // 58 letters (116 bytes), then the ellipsis.
+  EXPECT_TRUE(cut[0].title.ends_with("\xd0\xbf\xe2\x80\xa6"));
+  EXPECT_LE(cut[0].title.size(), 120u);
   // Another account's folder: none of these.
   EXPECT_TRUE(
       ClaudeSessionsIn(temp.GetPath().AppendASCII(".claude"), root, 10).empty());
