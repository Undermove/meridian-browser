From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Thu, 26 Nov 2026 02:32:28 +0400
Subject: [PATCH 304/304] Meridian: "kiwi pear" searches the site with Chromium
 159's keyword chip

Chromium 159's field turns "kiwi " into its keyword chip, leaving only
"pear" typed: the command bar's Arc-style site search missed it, and
Return didn't search the site. The chip's keyword is used the same way,
and nothing below is picked for Return while it shows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../webui_browser/meridian/command_bar.ts       | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/resources/webui_browser/meridian/command_bar.ts b/chrome/browser/resources/webui_browser/meridian/command_bar.ts
index 04c3998134..8730f96dbc 100644
--- a/chrome/browser/resources/webui_browser/meridian/command_bar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/command_bar.ts
@@ -533,8 +533,13 @@ export class MeridianCommandBarElement extends CrLitElement {
       // tab that starts that way.
       // (A setting only when it is named in full: "privacy" and Return
       // still searches.)
+      // Nothing either for what follows a site's keyword chip ("kiwi pear"):
+      // Return searches that site.
       const top = features[0];
-      this.tabSel_ = this.bang_ ? -1 :
+      const chip =
+          this.address_ ? this.address_.keywordModeManager.isInKeywordMode :
+                          false;
+      this.tabSel_ = this.bang_ || chip ? -1 :
           top && (top.setting ? top.m === 3 : top.m >= 2) ? 0 :
           first                          ? this.featureRows_.length :
                                            -1;
@@ -798,8 +803,14 @@ export class MeridianCommandBarElement extends CrLitElement {
         this.address_?.selectedLine() <= 0 && !e.shiftKey && !e.altKey) {
       const typed = this.inputValue_().trim();
       const space = typed.indexOf(' ');
-      const word = space > 0 ? typed.slice(0, space).toLowerCase() : '';
-      const terms = space > 0 ? typed.slice(space + 1).trim() : '';
+      // Chromium 159's field takes "kiwi " as its keyword chip itself, leaving
+      // only "pear" typed: that keyword the same way.
+      const chip =
+          this.address_.keywordModeManager?.activeKeyword.toLowerCase() || '';
+      const word =
+          chip || (space > 0 ? typed.slice(0, space).toLowerCase() : '');
+      const terms =
+          chip ? typed : (space > 0 ? typed.slice(space + 1).trim() : '');
       if (word && terms && this.keywords_.has(word)) {
         own();
         this.mode_ = {label: word, keyword: word, withPage: false,
-- 
