+// A test run looks only at the stand-ins it gives (--meridian-agents-path):
+// never at the real agents of the computer the tests run on.
+bool PicksLocalAgents() {
+  return !TestSwitchesAllowed() ||
+         !TestSwitchValue("meridian-agents-path").empty();
+}
+
+}  // namespace
+
+std::string AiService::LabelOf(const std::string& provider) {
+  if (provider == "api") {
+    return "Claude";
+  }
+  const ai::Provider* p = ai::FindProvider(provider);
+  return p ? p->label : std::string("The AI");
+}
+
+std::string AiService::NotReadyMessage() const {
+  if (const ai::Provider* signed_out = ai::FindProvider(SignedOutProvider())) {
+    return signed_out->label +
+           " isn’t signed in yet. Open Settings › AI and sign in to it.";
+  }
+  return "Install Claude Code or connect an AI in Settings › AI.";
+}
+
+void AiService::Complete(Completion completion, CompletionCallback done) {
+  // "Automatic" with nothing looked for yet: the agents here first, as Ask.
+  if (CurrentProvider().empty() && PicksLocalAgents() && !local_->Found()) {
+    WhenDetected(base::BindOnce(
+        [](base::WeakPtr<AiService> self, Completion completion,
+           CompletionCallback done) {
+          if (!self) {
+            return;
+          }
+          if (!self->local_->Found()) {
+            // Looked, found nothing: don't look again.
+            std::move(done).Run(std::string(), std::string(),
+                                self->NotReadyMessage());
+            return;
+          }
+          self->Complete(std::move(completion), std::move(done));
+        },
+        weak_factory_.GetWeakPtr(), std::move(completion), std::move(done)));
+    return;
+  }
+  const std::string provider = CurrentProvider();
+  if (provider.empty()) {
+    std::move(done).Run(std::string(), std::string(), NotReadyMessage());
+    return;
+  }
+  // Nothing leaves before the person allowed it (for whoever answers).
+  if (!ConsentGiven(provider)) {
+    auto shared = std::make_shared<CompletionCallback>(std::move(done));
+    WhenAllowed(
+        provider,
+        base::BindOnce(
+            [](base::WeakPtr<AiService> self, Completion completion,
+               std::shared_ptr<CompletionCallback> done) {
+              if (self && *done) {
+                self->Complete(std::move(completion), std::move(*done));
+              }
+            },
+            weak_factory_.GetWeakPtr(), std::move(completion), shared),
+        base::BindOnce(
+            [](std::shared_ptr<CompletionCallback> done,
+               std::string provider, const std::string& why) {
+              if (*done) {
+                std::move(*done).Run(provider, std::string(), why);
+              }
+            },
+            shared, provider));
+    return;
+  }
+  if (provider == "api") {
+    WithKey(base::BindOnce(
+        [](base::WeakPtr<AiService> self, Completion completion,
+           CompletionCallback done, std::optional<std::string> key) {
+          if (!self) {
+            return;
+          }
+          if (!key || key->empty()) {
+            std::move(done).Run("api", std::string(),
+                                "Meridian couldn’t read your Anthropic API "
+                                "key. Add it again in Settings › AI.");
+            return;
+          }
+          self->ApiComplete(std::move(completion), *key, std::move(done));
+        },
+        weak_factory_.GetWeakPtr(), std::move(completion), std::move(done)));
+    return;
+  }
+  // The connected agent or model, as Ask runs it (no tools), with the
+  // space's account.
+  ai::Turn turn;
+  turn.prompt = std::move(completion.prompt);
+  turn.system = std::move(completion.system);
+  turn.account_env = ai::AccountEnvForProvider(profile_, completion.space_id,
+                                               provider, nullptr);
+  struct Answer {
+    std::string text;
+    CompletionCallback done;
+  };
+  auto answer = base::MakeRefCounted<base::RefCountedData<Answer>>();
+  answer->data.done = std::move(done);
+  local_->Chat(
+      "complete-" + base::NumberToString(++completions_), provider,
+      std::move(turn),
+      base::BindRepeating(
+          [](scoped_refptr<base::RefCountedData<Answer>> answer,
+             std::string provider, const std::string& type,
+             const std::string& text) {
+            if (answer->data.done.is_null()) {
+              return;
+            }
+            if (type == "text") {
+              answer->data.text += text;
+            } else if (type == "error") {
+              std::move(answer->data.done).Run(provider, std::string(), text);
+            } else if (type == "done") {
+              std::string all = std::move(answer->data.text);
+              std::move(answer->data.done)
+                  .Run(provider, all,
+                       text == "stopped"
+                           ? std::string("Stopped.")
+                           : all.empty() ? LabelOf(provider) +
+                                               " didn’t answer. Try again."
+                                         : std::string());
+            }
+          },
+          answer, provider));
+}
+
+void AiService::ApiComplete(Completion completion,
+                            std::string key,
+                            CompletionCallback done) {
+  base::ListValue messages;
+  messages.Append(base::DictValue().Set("role", "user").Set(
+      "content", std::move(completion.prompt)));
+  base::DictValue body;
+  body.Set("model", completion.api_model.empty() ? std::string(kModel)
+                                                 : completion.api_model);
+  body.Set("max_tokens", completion.api_max_tokens);
+  body.Set("system", std::move(completion.system));
+  body.Set("messages", std::move(messages));
+  if (completion.api_schema) {
+    body.Set("output_config",
+             base::DictValue().Set("effort", "low").Set(
+                 "format", base::DictValue()
+                               .Set("type", "json_schema")
+                               .Set("schema", std::move(*completion.api_schema))));
+  }
+  std::unique_ptr<network::SimpleURLLoader> loader = Post(body, key);
+  network::SimpleURLLoader* raw = loader.get();
+  raw->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(
+          [](std::unique_ptr<network::SimpleURLLoader> loader,
+             CompletionCallback done, std::optional<std::string> response) {
+            const network::mojom::URLResponseHead* head =
+                loader->ResponseInfo();
+            int status =
+                head && head->headers ? head->headers->response_code() : 0;
+            if (status != 200) {
+              std::move(done).Run(
+                  "api", std::string(),
+                  status ? Friendly(status, response.value_or(""))
+                         : "Couldn’t reach Anthropic. Check your connection.");
+              return;
+            }
+            std::optional<base::Value> v =
+                base::JSONReader::Read(response.value_or(""), 0);
+            const base::DictValue* message =
+                v && v->is_dict() ? &v->GetDict() : nullptr;
+            const std::string* stop =
+                message ? message->FindString("stop_reason") : nullptr;
+            if (stop && *stop == "refusal") {
+              std::move(done).Run("api", std::string(),
+                                  "Claude declined this request.");
+              return;
+            }
+            std::string text;
+            if (const base::ListValue* content =
+                    message ? message->FindList("content") : nullptr) {
+              for (const base::Value& block : *content) {
+                const std::string* type = block.GetDict().FindString("type");
+                const std::string* piece = block.GetDict().FindString("text");
+                if ((!type || *type == "text") && piece) {
+                  text += *piece;
+                }
+              }
+            }
+            std::move(done).Run("api", std::move(text), std::string());
+          },
+          std::move(loader), std::move(done)),
+      1 << 20);
+}
