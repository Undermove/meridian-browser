+  border: 1.6px solid color-mix(in srgb, var(--meridian-text-muted) 35%, transparent);
+  border-top-color: var(--meridian-text-muted);
+  animation: wb-spin 1.1s linear infinite;
+}
+
+@keyframes wb-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
