+std::string MissionControl::ChatState(const Node& root) const {
+  if (root.kind != "session" || !root.parent_id.empty() || root.ended_at ||
+      root.dormant || root.source != "claude") {
+    return std::string();
+  }
+  bool needs = root.status == "waiting";
+  for (const auto& [id, n] : nodes_) {
+    needs =
+        needs || (n.root_id == root.id && !n.ended_at && n.status == "waiting");
+  }
+  if (needs) {
+    return "needs";
+  }
+  // "starting" is before any hook: nothing told yet.
+  if (root.status == "thinking" || root.status == "tool") {
+    return "working";
+  }
+  return root.unseen ? "done" : "idle";
+}
+
+base::ListValue MissionControl::ChatsSummary() const {
+  base::ListValue out;
+  for (const auto& [tab, view] : chats_) {
+    int needs = 0, done = 0, working = 0;
+    std::string first;
+    size_t first_at = 0;
+    for (const auto& [id, n] : nodes_) {
+      if (n.owner_tab != tab) {
+        continue;
+      }
+      std::string state = ChatState(n);
+      if (state == "needs") {
+        needs++;
+        size_t at = static_cast<size_t>(
+            std::ranges::find(view.order, n.term_id) - view.order.begin());
+        if (first.empty() || at < first_at) {
+          first = n.id;
+          first_at = at;
+        }
+      }
+      done += state == "done";
+      working += state == "working";
+    }
+    out.Append(base::DictValue()
+                   .Set("tab", tab)
+                   .Set("onScreen", view.on_screen)
+                   .Set("needs", needs)
+                   .Set("done", done)
+                   .Set("working", working)
+                   .Set("first", first));
+  }
+  return out;
+}
+
+void MissionControl::SetChatsView(int owner_tab,
+                                  bool on,
+                                  const std::string& on_screen,
+                                  std::vector<std::string> order) {
+  if (!owner_tab) {
+    return;
+  }
+  if (!on) {
+    if (chats_.erase(owner_tab)) {
+      Changed();
+    }
+    return;
+  }
+  if (order.size() > 200) {
+    order.resize(200);
+  }
+  ChatsView& view = chats_[owner_tab];
+  view.on_screen = on_screen;
+  view.order = std::move(order);
+  // Shown: seen.
+  for (auto& [id, n] : nodes_) {
+    if (!on_screen.empty() && n.owner_tab == owner_tab && n.parent_id.empty() &&
+        n.term_id == on_screen) {
+      n.unseen = false;
+    }
+  }
+  Changed();
+}
