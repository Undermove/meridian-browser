+  // The chats list (a preview, only when the page lists them): each session's
+  // state from its hooks, by terminal.
+  if (chats_owner_) {
+    base::DictValue sessions;
+    const base::ListValue* asks = snapshot.FindList("asks");
+    if (const base::ListValue* nodes = snapshot.FindList("nodes")) {
+      for (const base::Value& v : *nodes) {
+        const base::DictValue& n = v.GetDict();
+        const std::string* term = n.FindString("termId");
+        const std::string* chat = n.FindString("chat");
+        const std::string* id = n.FindString("id");
+        if (n.FindInt("ownerTab").value_or(0) != self || !term || !chat ||
+            chat->empty() || !id || !terms_.contains(*term)) {
+          continue;
+        }
+        base::DictValue entry;
+        entry.Set("chat", *chat);
+        if (const std::string* text = n.FindString("statusText")) {
+          entry.Set("text", *text);
+        }
+        if (const base::DictValue* tool = n.FindDict("tool")) {
+          entry.Set("tool", tool->Clone());
+        }
+        // What it asks (the oldest question still open).
+        for (size_t i = 0; asks && i < asks->size(); ++i) {
+          const base::DictValue& a = (*asks)[i].GetDict();
+          const std::string* node = a.FindString("nodeId");
+          if (node && *node == *id) {
+            base::DictValue ask;
+            if (const std::string* t = a.FindString("tool")) {
+              ask.Set("tool", *t);
+            }
+            if (const std::string* sum = a.FindString("summary")) {
+              ask.Set("summary", *sum);
+            }
+            entry.Set("ask", std::move(ask));
+            break;
+          }
+        }
+        sessions.Set(*term, std::move(entry));
+      }
+    }
+    counts.Set("sessions", std::move(sessions));
+  }
   Emit("wb:command", base::Value(std::move(counts)));
 }
 
