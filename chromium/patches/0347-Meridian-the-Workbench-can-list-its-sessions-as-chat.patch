diff --git a/chrome/browser/resources/webui_browser/meridian/workbench_badge.ts b/chrome/browser/resources/webui_browser/meridian/workbench_badge.ts
new file mode 100644
index 0000000000..9d45d5a625
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/workbench_badge.ts
@@ -0,0 +1,82 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// One mark on a Workbench tab's row whose page lists its sessions as chats (a
+// preview the Workbench turns on): orange with a count when sessions need
+// you, else blue with a count when turns ended that you haven't seen, else a
+// calm spinner while any works, else nothing. From Mission Control's snapshot
+// ("chats": per Workbench tab, from the sessions' own hooks).
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+export interface WorkbenchBadge {
+  kind: 'needs'|'done'|'working';
+  count: number;
+  // The Mission Control node of the first session that needs you (in the
+  // Workbench's list order): a click on the row opens it.
+  first: string;
+}
+
+interface ChatsEntry {
+  tab: number;
+  needs: number;
+  done: number;
+  working: number;
+  first: string;
+}
+
+// Tab handle -> mark.
+let badges = new Map<string, WorkbenchBadge>();
+let key = '';
+const listeners = new Set<() => void>();
+
+export function setWorkbenchChats(chats: ChatsEntry[]|undefined) {
+  const next = new Map<string, WorkbenchBadge>();
+  for (const c of Array.isArray(chats) ? chats : []) {
+    const badge: WorkbenchBadge|null = c.needs > 0 ?
+        {kind: 'needs', count: c.needs, first: c.first || ''} :
+        c.done > 0    ? {kind: 'done', count: c.done, first: ''} :
+        c.working > 0 ? {kind: 'working', count: c.working, first: ''} :
+                        null;
+    if (badge) {
+      next.set(String(c.tab), badge);
+    }
+  }
+  const nextKey = JSON.stringify([...next]);
+  if (nextKey === key) {
+    return;
+  }
+  key = nextKey;
+  badges = next;
+  for (const fn of listeners) {
+    fn();
+  }
+}
+
+// `tabId`: the sidebar's tab id ("<handle>:<type>").
+export function workbenchBadge(tabId: string|undefined): WorkbenchBadge|null {
+  return tabId ? badges.get(tabId.split(':')[0]!) || null : null;
+}
+
+export function onWorkbenchBadges(fn: () => void): () => void {
+  listeners.add(fn);
+  return () => listeners.delete(fn);
+}
+
+export function workbenchBadgeHtml(badge: WorkbenchBadge|null) {
+  if (!badge) {
+    return '';
+  }
+  const title = badge.kind === 'needs' ?
+      `${badge.count} ${
+          badge.count === 1 ? 'session needs' : 'sessions need'} you` :
+      badge.kind === 'done' ?
+      `${badge.count} finished, not seen yet` :
+      `${badge.count} working`;
+  return html`<span class="wb-badge ${badge.kind}" title="${title}"
+      data-kind="${badge.kind}">${badge.kind === 'working' ?
+      html`<span class="wb-spin"></span>` :
+      html`<span class="wb-dot"></span><span class="wb-count">${
+          badge.count}</span>`}</span>`;
+}
