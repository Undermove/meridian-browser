+void SidebarHandler::OpenInMeridian() {
+  tabs::TabInterface* tab = model()->GetActiveTab();
+  if (!IsLittleWindow(browser_) || !tab) {
+    return;
+  }
+  Profile* profile = browser_->GetProfile();
+  BrowserWindowInterface* target = nullptr;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (browser != browser_ &&
+            browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+            !IsLittleWindow(browser)) {
+          target = browser;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  if (!target) {
+    BrowserWindowCreateParams params(*profile, /*from_user_gesture=*/true);
+    params.should_trigger_session_restore = false;
+    target = CreateBrowserWindow(std::move(params));
+    if (!target) {
+      return;
+    }
+  }
+  // The last tab leaving closes this window (and this handler), so nothing
+  // touches `this` after the detach.
+  std::unique_ptr<tabs::TabModel> detached =
+      model()->DetachTabAtForInsertion(model()->GetIndexOfTab(tab));
+  TabStripModel* to = target->GetTabStripModel();
+  to->InsertDetachedTabAt(to->count(), std::move(detached),
+                          AddTabTypes::ADD_ACTIVE);
+  target->GetWindow()->Show();
+}
