+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/little_window.h"
+
+#include <map>
+
+#include "base/callback_list.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/create_browser_window.h"
+#include "ui/base/base_window.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/display/screen.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr int kWidth = 980;
+constexpr int kHeight = 720;
+
+// Open Little windows, until they close.
+std::map<const BrowserWindowInterface*, base::CallbackListSubscription>&
+LittleWindows() {
+  static base::NoDestructor<
+      std::map<const BrowserWindowInterface*, base::CallbackListSubscription>>
+      windows;
+  return *windows;
+}
+
+}  // namespace
+
+BrowserWindowInterface* OpenLittleWindow(Profile* profile, const GURL& url) {
+  BrowserWindowCreateParams params(*profile, /*from_user_gesture=*/true);
+  gfx::Rect work_area =
+      display::Screen::Get()->GetDisplayForNewWindows().work_area();
+  params.initial_bounds = work_area;
+  params.initial_bounds.ClampToCenteredSize(gfx::Size(kWidth, kHeight));
+  params.initial_origin_specified =
+      BrowserWindowCreateParams::ValueSpecified::kSpecified;
+  params.omit_from_session_restore = true;
+  params.should_trigger_session_restore = false;
+  BrowserWindowInterface* browser = CreateBrowserWindow(std::move(params));
+  if (!browser) {
+    return nullptr;
+  }
+  LittleWindows()[browser] = browser->RegisterBrowserDidClose(
+      base::BindRepeating([](BrowserWindowInterface* closed) {
+        LittleWindows().erase(closed);
+      }));
+
+  NavigateParams nav(browser, url, ui::PAGE_TRANSITION_LINK);
+  nav.disposition = WindowOpenDisposition::kNewForegroundTab;
+  Navigate(&nav);
+  browser->GetWindow()->Show();
+  return browser;
+}
+
+bool IsLittleWindow(const BrowserWindowInterface* browser) {
+  return LittleWindows().contains(browser);
+}
+
+}  // namespace meridian
