+#ifndef CHROME_BROWSER_MERIDIAN_LITTLE_WINDOW_H_
+#define CHROME_BROWSER_MERIDIAN_LITTLE_WINDOW_H_
+
+class BrowserWindowInterface;
+class GURL;
+class Profile;
+
+namespace meridian {
+
+// Arc's Little window: a link opened from another app shows in a small window
+// without the sidebar, with "Open in Meridian" to move it into the main
