+#if BUILDFLAG(IS_POSIX)
+// A stand-in that says its version.
+base::FilePath StandIn(const base::FilePath& dir,
+                       const std::string& name,
+                       const std::string& version) {
+  EXPECT_TRUE(base::CreateDirectory(dir));
+  base::FilePath bin = dir.AppendASCII(name);
+  EXPECT_TRUE(
+      base::WriteFile(bin, "#!/bin/sh\necho '" + version + " (Claude Code)'\n"));
+  EXPECT_TRUE(base::SetPosixFilePermissions(bin, 0755));
+  return bin;
+}
+
+// An old Claude Code first on the PATH (/usr/local/bin) and the current one
+// in ~/.local/bin: its tab, Resume and Remote Control start the current one
+// by its full path; a shell tab finds it first on its PATH.
+TEST(WorkbenchAgentsTest, TabsRunTheNewestCopyWhateverThePathsOrder) {
+  OnlyTestFolders only;
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath root = base::MakeAbsoluteFilePath(temp.GetPath());
+  base::ScopedEnvironmentVariableOverride home("HOME", root.value());
+  const base::FilePath old_dir = root.AppendASCII("usr/local/bin");
+  const base::FilePath new_dir = root.AppendASCII(".local/bin");
+  StandIn(old_dir, "claude", "2.0.14");
+  const base::FilePath fresh = StandIn(new_dir, "claude", "2.1.332");
+  const std::string path =
+      old_dir.value() + ":" + new_dir.value() + ":/usr/bin:/bin";
+
+  EXPECT_EQ(FindAgentExecutable("claude", path), fresh.value());
+  EXPECT_EQ(*DetectAgents(path).FindStringByDottedPath("claude.path"),
+            fresh.value());
+  base::expected<LaunchSpec, std::string> tab =
+      MakeLaunchSpec("claude", path, "/bin/zsh", {});
+  ASSERT_TRUE(tab.has_value());
+  EXPECT_EQ(tab->argv[0], fresh.value());
+
+  // The shell tab: the newest one's folder first, for the shell and (zsh)
+  // again after the startup files, which may put /usr/local/bin first.
+  base::expected<LaunchSpec, std::string> shell =
+      MakeLaunchSpec("shell", path, "/bin/zsh", {});
+  ASSERT_TRUE(shell.has_value());
+  EXPECT_EQ(shell->env["PATH"], new_dir.value() + ":" + path);
+  EXPECT_EQ(shell->env["MERIDIAN_PATH_FIRST"], new_dir.value());
+  ASSERT_TRUE(shell->env.contains("ZDOTDIR"));
+  const base::FilePath zdotdir =
+      base::FilePath::FromUTF8Unsafe(shell->env["ZDOTDIR"]);
+  std::string zlogin;
+  ASSERT_TRUE(base::ReadFileToString(zdotdir.AppendASCII(".zlogin"), &zlogin));
+  EXPECT_NE(zlogin.find("MERIDIAN_PATH_FIRST:$PATH"), std::string::npos);
+  std::string zshrc;
+  ASSERT_TRUE(base::ReadFileToString(zdotdir.AppendASCII(".zshrc"), &zshrc));
+  // No Claude Code settings for this one: no claude() of Meridian's.
+  EXPECT_EQ(zshrc.find("claude()"), std::string::npos);
+  base::DeletePathRecursively(zdotdir);
+
+  // Already first: nothing changes.
+  base::expected<LaunchSpec, std::string> plain = MakeLaunchSpec(
+      "shell", new_dir.value() + ":" + old_dir.value(), "/bin/zsh", {});
+  ASSERT_TRUE(plain.has_value());
+  EXPECT_FALSE(plain->env.contains("PATH"));
+  EXPECT_FALSE(plain->env.contains("ZDOTDIR"));
+}
