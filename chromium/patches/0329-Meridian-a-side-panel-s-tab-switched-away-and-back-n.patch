 #include "content/public/common/content_features.h"
 #include "third_party/blink/public/common/associated_interfaces/associated_interface_provider.h"
 #include "third_party/blink/public/mojom/page/draggable_region.mojom.h"
@@ -359,7 +361,7 @@ void WebUIBrowserWindow::PaintAsActiveChanged() {
   } else {
     BrowserActiveStateManager::From(browser_)->DidBecomeInactive();
   }
-  if (webui_browser::mojom::Page* page = GetWebUIBrowserUI()->page()) {
+  if (webui_browser::mojom::Page* page = GetPage()) {
     page->OnPaintAsActiveChanged(widget_->ShouldPaintAsActive());
   }
 }
@@ -711,7 +713,7 @@ void WebUIBrowserWindow::SyncFullscreenMode() {
   }
   sent_fullscreen_context_ = context;
 
-  if (webui_browser::mojom::Page* page = GetWebUIBrowserUI()->page()) {
+  if (webui_browser::mojom::Page* page = GetPage()) {
     page->OnFullscreenModeChanged(fullscreen, context);
   }
   if (window_changed) {
@@ -723,7 +725,7 @@ void WebUIBrowserWindow::UpdateDevtoolsForContents(
     content::WebContents* inspected) {
   tabs::TabInterface* tab =
       inspected ? tabs::TabInterface::MaybeGetFromContents(inspected) : nullptr;
-  webui_browser::mojom::Page* page = GetWebUIBrowserUI()->page();
+  webui_browser::mojom::Page* page = GetPage();
   if (!tab || !page) {
     return;
   }
@@ -879,7 +881,9 @@ void WebUIBrowserWindow::UpdateTitleBar() {
 
 void WebUIBrowserWindow::OnBookmarkBarStateChanged(
     BookmarkBar::AnimateChangeType change_type) {
-  GetWebUIBrowserUI()->BookmarkBarStateChanged(change_type);
+  if (WebUIBrowserUI* ui = GetWebUIBrowserUI()) {
+    ui->BookmarkBarStateChanged(change_type);
+  }
 }
 
 void WebUIBrowserWindow::UpdateLoadingAnimations(bool is_visible) {
@@ -990,13 +994,13 @@ PinnedToolbarActions* WebUIBrowserWindow::GetPinnedToolbarActions() {
 }
 
 void WebUIBrowserWindow::SetFocusToLocationBar(bool is_user_initiated) {
-  if (webui_browser::mojom::Page* page = GetWebUIBrowserUI()->page()) {
+  if (webui_browser::mojom::Page* page = GetPage()) {
     page->SetFocusToLocationBar(is_user_initiated);
   }
 }
 
 void WebUIBrowserWindow::UpdateReloadStopState(bool is_loading, bool force) {
-  if (webui_browser::mojom::Page* page = GetWebUIBrowserUI()->page()) {
+  if (webui_browser::mojom::Page* page = GetPage()) {
     page->SetReloadStopState(is_loading);
   }
 }
@@ -1548,18 +1552,40 @@ bool WebUIBrowserWindow::WidgetDelegate::ShouldDescendIntoChildForEventHandling(
 }
 
 WebUIBrowserUI* WebUIBrowserWindow::GetWebUIBrowserUI() const {
-  return web_contents_delegate_->web_contents()
-      ->GetWebUI()
-      ->GetController()
-      ->GetAs<WebUIBrowserUI>();
+  // Meridian: null while the window's own WebUI isn't there: before its first
+  // commit (a window being made) and while the window closes. Callers that
+  // reached for it then (a side panel shown on a tab switch, say) crashed.
+  content::WebContents* contents =
+      web_contents_delegate_ ? web_contents_delegate_->web_contents() : nullptr;
+  content::WebUI* web_ui = contents ? contents->GetWebUI() : nullptr;
+  if (!web_ui || !web_ui->GetController()) {
+    return nullptr;
+  }
+  return web_ui->GetController()->GetAs<WebUIBrowserUI>();
+}
+
+webui_browser::mojom::Page* WebUIBrowserWindow::GetPage() const {
+  WebUIBrowserUI* ui = GetWebUIBrowserUI();
+  return ui ? ui->page() : nullptr;
 }
 
 void WebUIBrowserWindow::ShowSidePanel(SidePanelEntryKey side_panel_entry_key) {
-  GetWebUIBrowserUI()->ShowSidePanel(side_panel_entry_key);
+  if (WebUIBrowserUI* ui = GetWebUIBrowserUI()) {
+    ui->ShowSidePanel(side_panel_entry_key);
+  }
 }
 
 void WebUIBrowserWindow::CloseSidePanel() {
-  GetWebUIBrowserUI()->CloseSidePanel();
+  WebUIBrowserUI* ui = GetWebUIBrowserUI();
+  if (ui && ui->page()) {
+    ui->CloseSidePanel();
+    return;
+  }
+  // Meridian: no page to animate it away and call back (the window is being
+  // made or closing): closed now, so the side panel isn't left "showing".
+  if (WebUIBrowserSidePanelUI* side_panel_ui = GetWebUIBrowserSidePanelUI()) {
+    side_panel_ui->OnSidePanelClosed();
+  }
 }
 
 WebUIBrowserSidePanelUI* WebUIBrowserWindow::GetWebUIBrowserSidePanelUI() {
