@@ -239,6 +239,9 @@ class WebUIBrowserWindow : public BrowserWindow,
   void CloseSidePanel();
 
   WebUIBrowserUI* GetWebUIBrowserUI() const;
+  // The window's page, or null while it isn't bound (window being made or
+  // closing).
+  webui_browser::mojom::Page* GetPage() const;
   WebUIBrowserSidePanelUI* GetWebUIBrowserSidePanelUI();
 
   BrowserWindowInterface* browser() { return browser_.get(); }
