+void SidebarHandler::ShareTabInstead(const tabs_api::NodeId& tab_id) {
+  if (tabs::TabInterface* tab = TabFor(tab_id)) {
+    TabSharingUIViews::ShareInstead(tab->GetContents());
+  }
+}
