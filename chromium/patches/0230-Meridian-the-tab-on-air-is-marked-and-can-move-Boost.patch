+void SidebarHandler::CanShareTabInstead(const tabs_api::NodeId& tab_id,
+                                        CanShareTabInsteadCallback callback) {
+  tabs::TabInterface* tab = TabFor(tab_id);
+  std::move(callback).Run(tab &&
+                          TabSharingUIViews::CanShareInstead(tab->GetContents()));
+}
