diff --git a/chrome/browser/meridian/boosts/boost_tab_helper.cc b/chrome/browser/meridian/boosts/boost_tab_helper.cc
index f456642d9b..122149a87d 100644
--- a/chrome/browser/meridian/boosts/boost_tab_helper.cc
+++ b/chrome/browser/meridian/boosts/boost_tab_helper.cc
@@ -35,10 +35,60 @@ constexpr char kApplyCss[] = R"((css) => {
   const root = document.documentElement;
   if (!root) return false;
   let s = document.getElementById('meridian-boost-style');
-  if (!css) { s?.remove(); return true; }
+  if (!css) { s?.remove(); document.getElementById('meridian-boost-turn')?.remove(); return true; }
   if (!s) { s = document.createElement('style'); s.id = 'meridian-boost-style'; }
   if (s.textContent !== css) s.textContent = css;
   if (s.parentNode !== root || s.nextSibling) root.appendChild(s);
+  // The colour: how far to turn this site's main accent to reach it.
+  const style = getComputedStyle(root);
+  const tint = parseFloat(style.getPropertyValue('--meridian-boost-tint'));
+  const strength = parseFloat(style.getPropertyValue('--meridian-boost-strength'));
+  const accent = () => {
+    if (window.__meridianBoostAccent !== undefined) return window.__meridianBoostAccent;
+    const hsl = (c) => {
+      const m = c.match(/[\d.]+/g)?.map(Number);
+      if (!m || m.length < 3 || (m.length > 3 && m[3] < 0.5)) return null;
+      const [r, g, b] = m.map((v) => v / 255), hi = Math.max(r, g, b), lo = Math.min(r, g, b), d = hi - lo;
+      const l = (hi + lo) / 2;
+      if (!d) return null;
+      const sat = d / (1 - Math.abs(2 * l - 1));
+      const h = hi === r ? ((g - b) / d + 6) % 6 : hi === g ? (b - r) / d + 2 : (r - g) / d + 4;
+      return { h: h * 60, s: sat, l };
+    };
+    const buckets = new Array(36).fill(0), hues = new Array(36).fill(0);
+    const add = (c, weight, minS) => {
+      const x = hsl(c);
+      if (!x || x.s < minS || x.l < 0.14 || x.l > 0.88) return;
+      const n = Math.floor(x.h / 10) % 36;
+      buckets[n] += weight; hues[n] += x.h * weight;
+    };
+    const screen = innerWidth * innerHeight;
+    for (const el of [...document.querySelectorAll('body, body *')].slice(0, 1500)) {
+      if (el.closest('img,video,picture,canvas,svg,iframe')) continue;
+      const r = el.getBoundingClientRect();
+      if (!r.width || !r.height || r.bottom < 0 || r.top > innerHeight) continue;
+      const cs = getComputedStyle(el);
+      add(cs.backgroundColor, Math.min(r.width * r.height, screen / 4), 0.25);
+      if ([...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim())) add(cs.color, 900, 0.35);
+    }
+    const best = buckets.indexOf(Math.max(...buckets));
+    if (!buckets[best]) return null;
+    return window.__meridianBoostAccent = hues[best] / buckets[best];
+  };
+  let turn = document.getElementById('meridian-boost-turn');
+  if (Number.isNaN(tint)) { turn?.remove(); return true; }
+  if (!turn) { turn = document.createElement('style'); turn.id = 'meridian-boost-turn'; }
+  const from = accent();
+  const deg = from === null ? 0 : ((tint - from + 540) % 360 - 180) * Math.min(1, strength / 35);
+  turn.textContent = `html { --meridian-boost-turn: ${deg.toFixed(1)}deg; }`;
+  if (turn.nextSibling !== s) root.insertBefore(turn, s);
+  if (from === null && document.readyState !== 'complete' && !window.__meridianBoostLater) {
+    window.__meridianBoostLater = true;
+    addEventListener('load', () => {
+      const again = accent();
+      if (again !== null) turn.textContent = `html { --meridian-boost-turn: ${(((tint - again + 540) % 360 - 180) * Math.min(1, strength / 35)).toFixed(1)}deg; }`;
+    }, { once: true });
+  }
   return true;
 })";
 
