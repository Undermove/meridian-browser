From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Wed, 28 Oct 2026 23:27:15 +0400
Subject: [PATCH 38/52] Meridian: the updater reads SHA256SUMS.txt, like
 install.sh

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/update_check.cc          | 2 +-
 chrome/browser/meridian/update_check.h           | 2 +-
 chrome/browser/meridian/update_check_unittest.cc | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/meridian/update_check.cc b/chrome/browser/meridian/update_check.cc
index 00624b6c0c..0aa9cc4119 100644
--- a/chrome/browser/meridian/update_check.cc
+++ b/chrome/browser/meridian/update_check.cc
@@ -96,7 +96,7 @@ std::optional<Release> ParseRelease(std::string_view json,
       }
       if (*name == release.zip_name) {
         release.zip_url = *url;
-      } else if (*name == "SHA256SUMS") {
+      } else if (*name == "SHA256SUMS.txt" || *name == "SHA256SUMS") {
         release.sums_url = *url;
       }
     }
diff --git a/chrome/browser/meridian/update_check.h b/chrome/browser/meridian/update_check.h
index 4c7f98b5cd..ab3147a99a 100644
--- a/chrome/browser/meridian/update_check.h
+++ b/chrome/browser/meridian/update_check.h
@@ -38,7 +38,7 @@ struct Release {
 std::optional<Release> ParseRelease(std::string_view json,
                                     std::string_view arch);
 
-// The SHA-256 (lowercase hex) of `name` in a SHA256SUMS file
+// The SHA-256 (lowercase hex) of `name` in a SHA256SUMS.txt file
 // ("<hex>  <name>" lines), or nullopt.
 std::optional<std::string> FindSum(std::string_view sums,
                                    std::string_view name);
diff --git a/chrome/browser/meridian/update_check_unittest.cc b/chrome/browser/meridian/update_check_unittest.cc
index 98f0100ebb..20f51b0022 100644
--- a/chrome/browser/meridian/update_check_unittest.cc
+++ b/chrome/browser/meridian/update_check_unittest.cc
@@ -30,7 +30,7 @@ TEST(UpdateCheckTest, ParsesTheReleaseForThisMac) {
     "assets": [
       {"name": "Meridian-1.0.3-mac-arm64.dmg", "browser_download_url": "https://d/dmg"},
       {"name": "Meridian-1.0.3-mac-arm64.zip", "browser_download_url": "https://d/zip"},
-      {"name": "SHA256SUMS", "browser_download_url": "https://d/sums"}
+      {"name": "SHA256SUMS.txt", "browser_download_url": "https://d/sums"}
     ]})";
   std::optional<Release> r = ParseRelease(kJson, "arm64");
   ASSERT_TRUE(r);
