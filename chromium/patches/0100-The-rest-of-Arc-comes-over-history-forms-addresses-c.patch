+void ReadArchive(const base::FilePath& file, ArcDataRead& out) {
+  std::string json;
+  if (!base::ReadFileToString(file, &json)) {
+    return;
+  }
+  std::optional<base::Value> root = base::JSONReader::Read(json, 0);
+  const base::ListValue* items =
+      root && root->is_dict() ? root->GetDict().FindList("items") : nullptr;
+  if (!items) {
+    return;
+  }
+  // [id, item, id, item, ...]
+  for (const base::Value& v : *items) {
+    const base::DictValue* item = v.GetIfDict();
+    const base::DictValue* tab =
+        item ? item->FindDictByDottedPath("sidebarItem.data.tab") : nullptr;
+    std::optional<double> at = item ? item->FindDouble("archivedAt")
+                                    : std::nullopt;
+    if (!tab || !at) {
+      continue;
+    }
+    const std::string* url = tab->FindString("savedURL");
+    GURL gurl = url ? GURL(*url) : GURL();
+    if (!gurl.is_valid() || !gurl.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    ArchivedTab entry;
+    entry.url = gurl;
+    const std::string* title = item->FindStringByDottedPath("sidebarItem.title");
+    const std::string* saved_title = tab->FindString("savedTitle");
+    entry.title = title && !title->empty()               ? *title
+                  : saved_title && !saved_title->empty() ? *saved_title
+                                                         : gurl.spec();
+    entry.archived_at = FromAppleSeconds(*at);
+    const std::string* space = item->FindStringByDottedPath("source.space._0");
+    out.archive.emplace_back(std::move(entry), space ? *space : std::string());
+  }
+}
+
+// Arc's destination: {"littleArc": ...} or {"space": {"_0": {"mostRecent":
+// {}}}} or a space of its own (its id somewhere in "_0").
+std::string LinkTarget(const base::DictValue* destination) {
+  if (!destination || destination->Find("littleArc")) {
+    return "little";
+  }
+  const base::DictValue* space = destination->FindDictByDottedPath("space._0");
+  if (!space) {
+    return destination->Find("space") ? "main" : std::string();
+  }
+  for (const auto [kind, value] : *space) {
+    if (kind == "mostRecent") {
+      continue;
+    }
+    const std::string* id = value.is_string() ? &value.GetString()
+                            : value.is_dict() ? value.GetDict().FindString("_0")
+                                              : nullptr;
+    if (id && !id->empty()) {
+      return "arc-space:" + *id;
+    }
+  }
+  return "main";
+}
+
+// Arc's "URL contains / starts with / is / ends with" as Meridian's pattern.
+std::string LinkPattern(const base::DictValue& match) {
+  const base::DictValue* how = match.FindDict("_0");
+  const std::string* text = match.FindString("_1");
+  if (!how || !text || text->empty() || text->find('*') != std::string::npos) {
+    return std::string();
+  }
+  if (how->Find("contains")) {
+    return "*" + *text + "*";
+  }
+  if (how->Find("startsWith") || how->Find("hasPrefix") || how->Find("prefix")) {
+    return *text + "*";
+  }
+  if (how->Find("endsWith") || how->Find("hasSuffix") || how->Find("suffix")) {
+    return "*" + *text;
+  }
+  if (how->Find("is") || how->Find("equals") || how->Find("exact")) {
+    return *text;
+  }
+  return std::string();
+}
+
+void ReadLinkRules(const base::FilePath& file, ArcDataRead& out) {
+  std::string json;
+  if (!base::ReadFileToString(file, &json)) {
+    return;
+  }
+  std::optional<base::Value> root = base::JSONReader::Read(json, 0);
+  if (!root || !root->is_dict()) {
+    return;
+  }
+  std::string fallback = LinkTarget(root->GetDict().FindDict("defaultDestination"));
+  out.link_fallback = fallback == "little" ? "little" : "main";
+  const base::ListValue* rules = root->GetDict().FindList("rules");
+  if (!rules) {
+    return;
+  }
+  for (const base::Value& r : *rules) {
+    const base::DictValue* rule = r.GetIfDict();
+    const base::ListValue* sources =
+        rule ? rule->FindList("sourceComponents") : nullptr;
+    std::string target =
+        rule ? LinkTarget(rule->FindDict("destination")) : std::string();
+    if (!sources || target.empty()) {
+      continue;
+    }
+    // Every part must be a URL match: a rule about the app a link comes from
+    // can't be kept as it is.
+    std::vector<std::string> patterns;
+    bool all = true;
+    for (const base::Value& c : *sources) {
+      const base::DictValue* match =
+          c.is_dict() ? c.GetDict().FindDictByDottedPath("componentType.urlMatch")
+                      : nullptr;
+      std::string pattern = match ? LinkPattern(*match) : std::string();
+      if (pattern.empty()) {
+        all = false;
+        break;
+      }
+      patterns.push_back(std::move(pattern));
+    }
+    if (!all) {
+      continue;
+    }
+    for (std::string& pattern : patterns) {
+      out.link_rules.push_back({std::move(pattern), target});
+    }
+  }
+}
+
+ArcDataRead ReadArcData(base::FilePath main_profile, base::FilePath user_data) {
+  ArcDataRead out;
+  base::FilePath arc = ArcDataDir();
+  if (arc.empty() || !base::DirectoryExists(arc)) {
+    return out;
+  }
+  if (std::optional<ArcSidebar> sidebar = ReadArcSidebar()) {
+    out.arc_space_names = sidebar->arc_space_names;
+  }
+  ReadArchive(arc.Append("StorableArchiveItems.json"), out);
+  ReadLinkRules(arc.Append("StorableLinkRouting.json"), out);
+  out.found = !out.archive.empty() || !out.link_rules.empty();
+
+  base::FileEnumerator dirs(arc.Append("User Data"), false,
+                            base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath dir = dirs.Next(); !dir.empty(); dir = dirs.Next()) {
+    std::string name = dir.BaseName().value();
+    int n = 0;
+    if (name != "Default" && !(name.starts_with("Profile ") &&
+                               base::StringToInt(name.substr(8), &n))) {
+      continue;
+    }
+    std::string id = ProfileIdForArcDir(name);
+    ProfileRead& p = out.profiles[id];
+    ReadHistory(dir.Append("History"), p.history);
+    {
+      base::ScopedTempDir tmp;
+      sql::Database db(sql::Database::Tag("Web"));
+      if (OpenCopy(dir.Append("Web Data"), tmp, db)) {
+        ReadForms(db, p.forms);
+        ReadAddresses(db, p.addresses);
+        ReadEngines(db, p.engines);
+      }
+    }
+    ReadPermissions(dir.Append("Preferences"), p.permissions);
+    ReadLocalStorage(dir.Append("Local Storage").Append("leveldb"), p.storage);
+    p.site_databases = StageIndexedDB(
+        dir, id.empty() ? main_profile : user_data.Append(id));
+    if (p.history.empty() && p.forms.empty() && p.addresses.empty() &&
+        p.permissions.empty() && p.engines.empty() && p.storage.empty() &&
+        !p.site_databases) {
+      out.profiles.erase(id);
+      continue;
+    }
+    out.found = true;
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------- writing
+
+// Collects what was brought over; reports when the last part lets go of it.
+class Collector : public base::RefCounted<Collector> {
+ public:
+  explicit Collector(base::OnceCallback<void(ArcDataResult)> done)
+      : done_(std::move(done)) {}
+  ArcDataResult& result() { return result_; }
+
+ private:
+  friend class base::RefCounted<Collector>;
+  ~Collector() { std::move(done_).Run(result_); }
+
+  ArcDataResult result_;
+  base::OnceCallback<void(ArcDataResult)> done_;
+};
+
+// Adds Arc's addresses once the profile's are loaded, skipping ones it has.
+// Deletes itself.
+class AddressAdder : public autofill::PersonalDataManagerObserver {
+ public:
+  AddressAdder(autofill::PersonalDataManager* pdm,
+               std::vector<autofill::AutofillProfile> addresses,
+               scoped_refptr<Collector> collector)
+      : pdm_(pdm),
+        addresses_(std::move(addresses)),
+        collector_(std::move(collector)) {
+    if (pdm_->IsDataLoaded()) {
+      Add();
+      return;
+    }
+    observation_.Observe(pdm_);
+  }
+
+  void OnPersonalDataChanged() override {
+    if (pdm_->IsDataLoaded()) {
+      observation_.Reset();
+      Add();
+    }
+  }
+
+ private:
+  void Add() {
+    autofill::AddressDataManager& manager = pdm_->address_data_manager();
+    for (autofill::AutofillProfile& address : addresses_) {
+      bool known = std::ranges::any_of(
+          manager.GetProfiles(), [&](const autofill::AutofillProfile* p) {
+            for (autofill::FieldType type :
+                 autofill::AutofillProfile::kDatabaseStoredTypes) {
+              if (p->GetRawInfo(type) != address.GetRawInfo(type)) {
+                return false;
+              }
+            }
+            return true;
+          });
+      if (!known) {
+        manager.AddProfile(address);
+        ++collector_->result().addresses;
+      }
+    }
+    delete this;
+  }
+
+  raw_ptr<autofill::PersonalDataManager> pdm_;
+  std::vector<autofill::AutofillProfile> addresses_;
+  scoped_refptr<Collector> collector_;
+  base::ScopedObservation<autofill::PersonalDataManager,
+                          autofill::PersonalDataManagerObserver>
+      observation_{this};
+};
+
+// Adds Arc's site searches once the profile's search engines are loaded,
+// skipping keywords taken here. Deletes itself.
+class EngineAdder {
+ public:
+  EngineAdder(TemplateURLService* service,
+              std::vector<TemplateURLData> engines,
+              scoped_refptr<Collector> collector)
+      : service_(service),
+        engines_(std::move(engines)),
+        collector_(std::move(collector)) {
+    if (service_->loaded()) {
+      Add();
+      return;
+    }
+    loaded_ = service_->RegisterOnLoadedCallback(
+        base::BindOnce(&EngineAdder::Add, base::Unretained(this)));
+    service_->Load();
+  }
+
+ private:
+  void Add() {
+    for (TemplateURLData& data : engines_) {
+      if (service_->GetTemplateURLForKeyword(data.keyword())) {
+        continue;
+      }
+      if (service_->Add(std::make_unique<TemplateURL>(data))) {
+        ++collector_->result().search_engines;
+      }
+    }
+    engines_.clear();
+    collector_.reset();
+    // Not while the subscription runs this.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+
+  raw_ptr<TemplateURLService> service_;
+  std::vector<TemplateURLData> engines_;
+  scoped_refptr<Collector> collector_;
+  base::CallbackListSubscription loaded_;
+};
+
+// One site's localStorage: written only if the site has none here.
+class StorageWriter : public base::RefCounted<StorageWriter> {
+ public:
+  StorageWriter(SiteStorage site, scoped_refptr<Collector> collector)
+      : site_(std::move(site)), collector_(std::move(collector)) {}
+
+  void Start(content::StoragePartition* partition) {
+    partition->GetLocalStorageControl()->BindStorageArea(
+        blink::StorageKey::CreateFirstParty(site_.origin),
+        area_.BindNewPipeAndPassReceiver());
+    area_->GetAll(mojo::NullRemote(),
+                  base::BindOnce(&StorageWriter::OnHave,
+                                 base::WrapRefCounted(this)));
+  }
+
+ private:
+  friend class base::RefCounted<StorageWriter>;
+  ~StorageWriter() = default;
+
+  void OnHave(std::vector<blink::mojom::KeyValuePtr> have) {
+    if (!have.empty()) {
+      return;
+    }
+    ++collector_->result().sites;
+    for (auto& [key, value] : site_.entries) {
+      area_->Put(key, value, std::nullopt, /*source=*/nullptr,
+                 base::BindOnce([](scoped_refptr<StorageWriter>, bool) {},
+                                base::WrapRefCounted(this)));
+    }
+    site_.entries.clear();
+  }
+
+  SiteStorage site_;
+  scoped_refptr<Collector> collector_;
+  mojo::Remote<blink::mojom::StorageArea> area_;
+};
+
+void WriteProfile(scoped_refptr<Collector> collector,
+                  ProfileRead data,
+                  Profile* profile) {
+  if (!profile) {
+    return;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  // History and form entries newer than the last import (Arc may have been
+  // used since).
+  base::Time since = prefs->GetTime(prefs::kArcDataImportedAt);
+  base::Time now = base::Time::Now();
+  std::erase_if(data.history, [&](const history::URLRow& row) {
+    return row.last_visit() <= since;
+  });
+  std::erase_if(data.forms, [&](const autofill::AutocompleteEntry& e) {
+    return e.date_last_used() <= since;
+  });
+  prefs->SetTime(prefs::kArcDataImportedAt, now);
+
+  if (!data.history.empty()) {
+    if (history::HistoryService* history =
+            HistoryServiceFactory::GetForProfile(
+                profile, ServiceAccessType::EXPLICIT_ACCESS)) {
+      collector->result().history += data.history.size();
+      history->AddPagesWithDetails(data.history,
+                                   history::SOURCE_OS_MIGRATION_IMPORTED);
+    }
+  }
+  if (!data.forms.empty()) {
+    if (scoped_refptr<autofill::AutofillWebDataService> web_data =
+            WebDataServiceFactory::GetAutofillWebDataForProfile(
+                profile, ServiceAccessType::EXPLICIT_ACCESS)) {
+      collector->result().form_entries += data.forms.size();
+      web_data->UpdateAutocompleteEntries(data.forms);
+    }
+  }
+  if (!data.addresses.empty()) {
+    if (autofill::PersonalDataManager* pdm =
+            autofill::PersonalDataManagerFactory::GetForBrowserContext(
+                profile)) {
+      new AddressAdder(pdm, std::move(data.addresses), collector);
+    }
+  }
+  if (!data.permissions.empty()) {
+    HostContentSettingsMap* map =
+        HostContentSettingsMapFactory::GetForProfile(profile);
+    auto* websites = content_settings::WebsiteSettingsRegistry::GetInstance();
+    auto* registry = content_settings::ContentSettingsRegistry::GetInstance();
+    for (const Permission& p : data.permissions) {
+      const content_settings::WebsiteSettingsInfo* info =
+          websites->GetByName(p.type);
+      const content_settings::ContentSettingsInfo* content =
+          info ? registry->Get(info->type()) : nullptr;
+      ContentSetting setting = static_cast<ContentSetting>(p.setting);
+      ContentSettingsPattern primary = ContentSettingsPattern::FromString(p.primary);
+      ContentSettingsPattern secondary =
+          ContentSettingsPattern::FromString(p.secondary);
+      if (!content || !content->IsSettingValid(setting) || !primary.IsValid() ||
+          !secondary.IsValid()) {
+        continue;
+      }
+      bool set_here = std::ranges::any_of(
+          map->GetSettingsForOneType(info->type()),
+          [&](const ContentSettingPatternSource& s) {
+            return s.source == content_settings::ProviderType::kPrefProvider &&
+                   s.primary_pattern == primary &&
+                   s.secondary_pattern == secondary;
+          });
+      if (set_here) {
+        continue;
+      }
+      map->SetContentSettingCustomScope(primary, secondary, info->type(),
+                                        setting);
+      ++collector->result().permissions;
+    }
+  }
+  if (!data.engines.empty()) {
+    if (TemplateURLService* service =
+            TemplateURLServiceFactory::GetForProfile(profile)) {
+      new EngineAdder(service, std::move(data.engines), collector);
+    }
+  }
+  content::StoragePartition* partition = profile->GetDefaultStoragePartition();
+  for (SiteStorage& site : data.storage) {
+    base::MakeRefCounted<StorageWriter>(std::move(site), collector)
+        ->Start(partition);
+  }
+  collector->result().site_databases += data.site_databases;
+}
+
+// Arc's space id as the Meridian space of the same name ("main" if none).
+std::string MeridianTarget(const std::string& target,
+                           const ArcDataRead& read,
+                           const SidebarService* sidebar) {
+  if (!target.starts_with("arc-space:")) {
+    return target;
+  }
+  auto name = read.arc_space_names.find(target.substr(10));
+  if (sidebar && name != read.arc_space_names.end()) {
+    for (const Space& space : sidebar->spaces()) {
+      if (space.name == name->second) {
+        return "space:" + space.id;
+      }
+    }
+  }
+  return "main";
+}
+
+void WriteMain(scoped_refptr<Collector> collector,
+               ArcDataRead& read,
+               Profile* profile) {
+  SidebarService* sidebar = SidebarServiceFactory::GetForProfile(profile);
+  if (ArchiveService* archive = ArchiveServiceFactory::GetForProfile(profile);
+      archive && !read.archive.empty()) {
+    std::vector<ArchivedTab> tabs;
+    for (auto& [tab, arc_space] : read.archive) {
+      std::string target =
+          MeridianTarget("arc-space:" + arc_space, read, sidebar);
+      tab.space_id = target.starts_with("space:") ? target.substr(6)
+                                                  : std::string();
+      tabs.push_back(std::move(tab));
+    }
+    collector->result().archived += archive->Import(std::move(tabs));
+  }
+  if (!read.link_rules.empty()) {
+    ScopedDictPrefUpdate update(profile->GetPrefs(), prefs::kAtc);
+    base::ListValue* rules = update->EnsureList("rules");
+    bool had_rules = !rules->empty();
+    for (const LinkRule& rule : read.link_rules) {
+      bool known = std::ranges::any_of(*rules, [&](const base::Value& r) {
+        const std::string* p =
+            r.is_dict() ? r.GetDict().FindString("pattern") : nullptr;
+        return p && *p == rule.pattern;
+      });
+      if (known) {
+        continue;
+      }
+      rules->Append(base::DictValue()
+                        .Set("id", base::Uuid::GenerateRandomV4()
+                                       .AsLowercaseString())
+                        .Set("pattern", rule.pattern)
+                        .Set("target", MeridianTarget(rule.target, read,
+                                                      sidebar)));
+      ++collector->result().link_rules;
+    }
+    // Where other links go: Arc's choice, unless rules were made here.
+    if (!had_rules && !read.link_fallback.empty()) {
+      update->Set("fallback", read.link_fallback);
+    }
+  }
+}
+
+void Write(base::WeakPtr<Profile> profile,
+           base::OnceCallback<void(ArcDataResult)> done,
+           ArcDataRead read) {
+  if (!profile || !read.found) {
+    ArcDataResult result;
+    result.error = "no-data";
+    std::move(done).Run(result);
+    return;
+  }
+  auto collector = base::MakeRefCounted<Collector>(std::move(done));
+  WriteMain(collector, read, profile.get());
+  for (auto& [id, data] : read.profiles) {
+    if (id.empty()) {
+      WriteProfile(collector, std::move(data), profile.get());
+      continue;
+    }
+    g_browser_process->profile_manager()->CreateProfileAsync(
+        ProfilePathFor(id),
+        base::BindOnce(&WriteProfile, collector, std::move(data)));
+  }
+}
+
+}  // namespace
+
+bool ArcDataAvailable() {
+  base::FilePath arc = ArcDataDir();
+  return !arc.empty() && base::DirectoryExists(arc.Append("User Data"));
+}
+
+void ImportArcData(Profile* profile,
+                   base::OnceCallback<void(ArcDataResult)> done) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadArcData, profile->GetPath(),
+                     g_browser_process->profile_manager()->user_data_dir()),
+      base::BindOnce(&Write, profile->GetWeakPtr(), std::move(done)));
+}
+
+}  // namespace meridian
