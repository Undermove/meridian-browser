+// Arc's localStorage ("Local Storage/leveldb"), from a private copy: by site,
+// the entries as the page stored them.
+void ReadLocalStorage(const base::FilePath& dir, std::vector<SiteStorage>& out) {
+  if (!base::DirectoryExists(dir)) {
+    return;
+  }
+  base::ScopedTempDir tmp;
+  if (!tmp.CreateUniqueTempDir()) {
+    return;
+  }
+  base::FilePath copy = tmp.GetPath().Append("leveldb");
+  if (!base::CreateDirectory(copy)) {
+    return;
+  }
+  base::FileEnumerator files(dir, false, base::FileEnumerator::FILES);
+  for (base::FilePath f = files.Next(); !f.empty(); f = files.Next()) {
+    if (f.BaseName().value() != "LOCK") {
+      base::CopyFile(f, copy.Append(f.BaseName()));
+    }
+  }
+  leveldb_env::Options options;
+  options.create_if_missing = false;
+  options.paranoid_checks = false;
+  std::unique_ptr<leveldb::DB> db;
+  if (!leveldb_env::OpenDB(options, copy.AsUTF8Unsafe(), &db).ok()) {
+    return;
+  }
+  std::map<std::string, size_t> index;
+  std::unique_ptr<leveldb::Iterator> it(db->NewIterator(leveldb::ReadOptions()));
+  for (it->Seek("_"); it->Valid() && it->key().starts_with("_"); it->Next()) {
+    std::string_view key = leveldb_env::MakeStringView(it->key());
+    size_t sep = key.find('\0');
+    if (sep == std::string_view::npos) {
+      continue;
+    }
+    std::string site(key.substr(1, sep - 1));
+    auto found = index.find(site);
+    if (found == index.end()) {
+      // A partitioned (third-party) key has "^" parts: those stay behind.
+      GURL url(site);
+      if (site.find('^') != std::string::npos || !url.SchemeIsHTTPOrHTTPS()) {
+        index[site] = SIZE_MAX;
+        continue;
+      }
+      found = index.emplace(site, out.size()).first;
+      out.push_back({url::Origin::Create(url), {}});
+    }
+    if (found->second == SIZE_MAX) {
+      continue;
+    }
+    std::string_view script_key = key.substr(sep + 1);
+    out[found->second].entries.emplace_back(
+        std::vector<uint8_t>(script_key.begin(), script_key.end()),
+        base::ToVector(base::as_byte_span(leveldb_env::MakeStringView(it->value()))));
+  }
+  std::erase_if(out, [](const SiteStorage& s) { return s.entries.empty(); });
+}
