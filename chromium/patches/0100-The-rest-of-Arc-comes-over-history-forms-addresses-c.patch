+class CardAdder : public autofill::PersonalDataManagerObserver {
+ public:
+  CardAdder(autofill::PersonalDataManager* pdm,
+            std::vector<autofill::CreditCard> cards,
+            scoped_refptr<Writer> writer,
+            base::OnceClosure done)
+      : pdm_(pdm),
+        cards_(std::move(cards)),
+        writer_(std::move(writer)),
+        done_(std::move(done)) {
+    if (pdm_->IsDataLoaded()) {
+      Add();
+      return;
+    }
+    observation_.Observe(pdm_);
+  }
+
+  void OnPersonalDataChanged() override {
+    if (pdm_->IsDataLoaded()) {
+      observation_.Reset();
+      Add();
+    }
+  }
+
+ private:
+  void Add() {
+    autofill::PaymentsDataManager& payments = pdm_->payments_data_manager();
+    std::set<std::u16string> have;
+    for (const autofill::CreditCard* card : payments.GetLocalCreditCards()) {
+      have.insert(card->number());
+    }
+    int added = 0;
+    for (autofill::CreditCard& card : cards_) {
+      if (have.insert(card.number()).second) {
+        payments.AddCreditCard(card);
+        ++added;
+      }
+    }
+    cards_.clear();
+    writer_->AddedCards(added);
+    std::move(done_).Run();
+    delete this;
+  }
+
+  raw_ptr<autofill::PersonalDataManager> pdm_;
+  std::vector<autofill::CreditCard> cards_;
+  scoped_refptr<Writer> writer_;
+  base::OnceClosure done_;
+  base::ScopedObservation<autofill::PersonalDataManager,
+                          autofill::PersonalDataManagerObserver>
+      observation_{this};
+};
