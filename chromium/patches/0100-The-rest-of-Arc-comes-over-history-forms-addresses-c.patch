new file mode 100644
index 0000000000..75b36f16af
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/arc_summary.ts
@@ -0,0 +1,33 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import type {ArcDataResult} from '../sidebar.mojom-webui.js';
+
+function count(n: number, one: string, many: string = one + 's'): string {
+  return n ? `${n.toLocaleString()} ${n === 1 ? one : many}` : '';
+}
+
+// "Brought over: 1,204 pages of history, 31 form entries, …", or that it was
+// all here already.
+export function arcDataSummary(r: ArcDataResult): string {
+  const later = r.siteDatabases ?
+      ` (${count(r.siteDatabases, 'more site', 'more sites')} when Meridian ` +
+          'next opens)' :
+      '';
+  const sites = r.sites || r.siteDatabases ?
+      `data of ${count(r.sites, 'site') || 'no sites yet'}${later}` :
+      '';
+  const parts = [
+    count(r.history, 'page of history', 'pages of history'),
+    count(r.formEntries, 'form entry', 'form entries'),
+    count(r.addresses, 'address', 'addresses'),
+    count(r.permissions, 'site permission'),
+    count(r.searchEngines, 'site search', 'site searches'),
+    sites,
+    count(r.linkRules, 'Air Traffic Control rule'),
+    count(r.archived, 'archived tab'),
+  ].filter(x => x);
+  return parts.length ? `Brought over: ${parts.join(', ')}.` :
+                        'It’s all here already.';
+}
