+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/arc_staged.h"
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+
+namespace meridian {
+
+namespace {
+constexpr char kStaged[] = "Meridian Arc Staged";
+}  // namespace
+
+base::FilePath StagedArcIndexedDBDir(const base::FilePath& profile_path) {
+  return profile_path.Append(kStaged).Append("IndexedDB");
+}
+
+void MoveStagedArcSiteData(const base::FilePath& profile_path) {
+  base::FilePath staged = profile_path.Append(kStaged);
+  if (!base::DirectoryExists(staged)) {
+    return;
+  }
+  base::FilePath from = StagedArcIndexedDBDir(profile_path);
+  base::FilePath to = profile_path.Append("IndexedDB");
+  if (base::DirectoryExists(from) && base::CreateDirectory(to)) {
+    // "<site>.indexeddb.leveldb", with its files in "<site>.indexeddb.blob".
+    base::FileEnumerator sites(from, false, base::FileEnumerator::DIRECTORIES,
+                               FILE_PATH_LITERAL("*.indexeddb.leveldb"));
+    for (base::FilePath site = sites.Next(); !site.empty();
+         site = sites.Next()) {
+      base::FilePath blob = site.ReplaceExtension(FILE_PATH_LITERAL(".blob"));
+      base::FilePath dest = to.Append(site.BaseName());
+      base::FilePath dest_blob = to.Append(blob.BaseName());
+      if (base::PathExists(dest) || base::PathExists(dest_blob)) {
+        continue;
+      }
+      if (base::Move(site, dest) && base::PathExists(blob)) {
+        base::Move(blob, dest_blob);
+      }
+    }
+  }
+  base::DeletePathRecursively(staged);
+}
+
+}  // namespace meridian
