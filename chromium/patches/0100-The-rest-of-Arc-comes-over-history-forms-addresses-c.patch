+// Puts Arc's IndexedDB sites that `meridian_profile` doesn't have next to it,
+// to move in when it next opens. Returns how many.
+int StageIndexedDB(const base::FilePath& arc_dir,
+                   const base::FilePath& meridian_profile) {
+  base::FilePath from = arc_dir.Append("IndexedDB");
+  if (!base::DirectoryExists(from)) {
+    return 0;
+  }
+  base::FilePath staged = StagedArcIndexedDBDir(meridian_profile);
+  base::FilePath own = meridian_profile.Append("IndexedDB");
+  int n = 0;
+  base::FileEnumerator sites(from, false, base::FileEnumerator::DIRECTORIES,
+                             FILE_PATH_LITERAL("*.indexeddb.leveldb"));
+  for (base::FilePath site = sites.Next(); !site.empty(); site = sites.Next()) {
+    std::string id = site.BaseName().RemoveFinalExtension()
+                         .RemoveFinalExtension().MaybeAsASCII();
+    url::Origin origin = storage::GetOriginFromIdentifier(id);
+    if (origin.opaque() || (origin.scheme() != url::kHttpsScheme &&
+                            origin.scheme() != url::kHttpScheme)) {
+      continue;
+    }
+    base::FilePath blob = site.ReplaceExtension(FILE_PATH_LITERAL(".blob"));
+    if (base::PathExists(own.Append(site.BaseName())) ||
+        base::PathExists(own.Append(blob.BaseName())) ||
+        base::PathExists(staged.Append(site.BaseName()))) {
+      continue;
+    }
+    if (!base::CreateDirectory(staged) ||
+        !base::CopyDirectory(site, staged.Append(site.BaseName()), true)) {
+      continue;
+    }
+    if (base::DirectoryExists(blob)) {
+      base::CopyDirectory(blob, staged.Append(blob.BaseName()), true);
+    }
+    ++n;
+  }
+  return n;
+}
