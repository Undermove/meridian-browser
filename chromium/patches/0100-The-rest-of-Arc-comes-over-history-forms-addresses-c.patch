+void ReadPermissions(const base::FilePath& file,
+                     std::vector<Permission>& out) {
+  std::string json;
+  if (!base::ReadFileToString(file, &json)) {
+    return;
+  }
+  std::optional<base::Value> root = base::JSONReader::Read(json, 0);
+  const base::DictValue* exceptions =
+      root && root->is_dict() ? root->GetDict().FindDictByDottedPath(
+                                    "profile.content_settings.exceptions")
+                              : nullptr;
+  if (!exceptions) {
+    return;
+  }
+  for (const char* type : kPermissionTypes) {
+    const base::DictValue* entries = exceptions->FindDict(type);
+    if (!entries) {
+      continue;
+    }
+    for (const auto [patterns, value] : *entries) {
+      const base::DictValue* entry = value.GetIfDict();
+      std::optional<int> setting =
+          entry ? entry->FindInt("setting") : std::nullopt;
+      const std::string* expiration =
+          entry ? entry->FindString("expiration") : nullptr;
+      // Temporary grants (one time, or for a while) stay behind.
+      if (!setting || (expiration && *expiration != "0")) {
+        continue;
+      }
+      std::vector<std::string> parts = base::SplitString(
+          patterns, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+      if (parts.empty() || parts.size() > 2 || parts[0].empty()) {
+        continue;
+      }
+      out.push_back({type, parts[0], parts.size() == 2 ? parts[1] : "*",
+                     *setting});
+    }
+  }
+}
