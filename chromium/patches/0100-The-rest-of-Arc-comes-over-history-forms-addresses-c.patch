+// The site searches a person made (Arc's built-in engines and the ones sites
+// add by themselves stay behind).
+void ReadEngines(sql::Database& db, std::vector<TemplateURLData>& out) {
+  if (!db.DoesTableExist("keywords")) {
+    return;
+  }
+  static constexpr base::cstring_view kColumns[] = {
+      "short_name",     "keyword",         "favicon_url",
+      "url",            "suggest_url",     "date_created",
+      "last_modified",  "usage_count",     "input_encodings",
+      "alternate_urls", "prepopulate_id",  "safe_for_autoreplace",
+      "created_by_policy", "starter_pack_id", "last_visited"};
+  sql::Statement s(db.GetUniqueStatement(SelectOf(db, "keywords", kColumns)));
+  while (s.Step()) {
+    if (s.ColumnInt(10) != 0 || s.ColumnInt(11) != 0 || s.ColumnInt(12) != 0 ||
+        s.ColumnInt(13) != 0) {
+      continue;
+    }
+    TemplateURLData data;
+    data.SetShortName(s.ColumnString16(0));
+    data.SetKeyword(s.ColumnString16(1));
+    data.SetURL(s.ColumnString(3));
+    if (data.short_name().empty() || data.keyword().empty() ||
+        !GURL(data.url()).is_valid()) {
+      continue;
+    }
+    data.favicon_url = GURL(s.ColumnString(2));
+    data.suggestions_url = s.ColumnString(4);
+    data.date_created = internal::FromWindows(s.ColumnInt64(5));
+    data.last_modified = internal::FromWindows(s.ColumnInt64(6));
+    data.usage_count = s.ColumnInt(7);
+    data.input_encodings = base::SplitString(
+        s.ColumnString(8), ";", base::TRIM_WHITESPACE,
+        base::SPLIT_WANT_NONEMPTY);
+    if (std::optional<base::Value> alternates =
+            base::JSONReader::Read(s.ColumnString(9), 0);
+        alternates && alternates->is_list()) {
+      for (const base::Value& a : alternates->GetList()) {
+        if (a.is_string()) {
+          data.alternate_urls.push_back(a.GetString());
+        }
+      }
+    }
+    data.last_visited = internal::FromWindows(s.ColumnInt64(14));
+    data.safe_for_autoreplace = false;
+    data.is_active = TemplateURLData::ActiveStatus::kTrue;
+    data.sync_guid = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    out.push_back(std::move(data));
+  }
+}
