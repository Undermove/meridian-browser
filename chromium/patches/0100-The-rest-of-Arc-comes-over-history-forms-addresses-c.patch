+void ReadHistory(const base::FilePath& file, history::URLRows& out) {
+  base::ScopedTempDir tmp;
+  sql::Database db(sql::Database::Tag("History"));
+  if (!OpenCopy(file, tmp, db) || !db.DoesTableExist("urls")) {
+    return;
+  }
+  static constexpr base::cstring_view kColumns[] = {
+      "url", "title", "visit_count", "typed_count", "last_visit_time",
+      "hidden"};
+  sql::Statement s(db.GetUniqueStatement(SelectOf(db, "urls", kColumns)));
+  while (s.Step()) {
+    GURL url(s.ColumnString(0));
+    base::Time last = internal::FromWindows(s.ColumnInt64(4));
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || last.is_null()) {
+      continue;
+    }
+    history::URLRow row(url);
+    row.set_title(s.ColumnString16(1));
+    row.set_visit_count(std::max(1, s.ColumnInt(2)));
+    row.set_typed_count(std::max(0, s.ColumnInt(3)));
+    row.set_last_visit(last);
+    row.set_hidden(s.ColumnInt(5) != 0);
+    out.push_back(std::move(row));
+  }
+}
+
+void ReadForms(sql::Database& db,
+               std::vector<autofill::AutocompleteEntry>& out) {
+  if (!db.DoesTableExist("autofill")) {
+    return;
+  }
+  static constexpr base::cstring_view kColumns[] = {
+      "name", "value", "date_created", "date_last_used"};
+  sql::Statement s(db.GetUniqueStatement(SelectOf(db, "autofill", kColumns)));
+  while (s.Step()) {
+    std::u16string name = s.ColumnString16(0);
+    std::u16string value = s.ColumnString16(1);
+    if (name.empty() || value.empty()) {
+      continue;
+    }
+    base::Time created = base::Time::FromTimeT(s.ColumnInt64(2));
+    base::Time used = base::Time::FromTimeT(s.ColumnInt64(3));
+    out.emplace_back(autofill::AutocompleteKey(name, value), created,
+                     std::max(created, used));
+  }
+}
+
+void ReadAddresses(sql::Database& db,
+                   std::vector<autofill::AutofillProfile>& out) {
+  if (!db.DoesTableExist("addresses") ||
+      !db.DoesTableExist("address_type_tokens")) {
+    return;
+  }
+  sql::Statement s(db.GetUniqueStatement(
+      "SELECT guid, use_count, use_date, date_modified, language_code FROM "
+      "addresses WHERE record_type = 0"));
+  while (s.Step()) {
+    std::string guid = s.ColumnString(0);
+    sql::Statement t(db.GetUniqueStatement(
+        "SELECT type, value, verification_status FROM address_type_tokens "
+        "WHERE guid = ?"));
+    t.BindString(0, guid);
+    std::vector<std::tuple<autofill::FieldType, std::u16string, int>> tokens;
+    std::string country;
+    while (t.Step()) {
+      std::optional<autofill::FieldType> type =
+          autofill::ToSafeFieldType(t.ColumnInt(0));
+      if (!type ||
+          !autofill::AutofillProfile::kDatabaseStoredTypes.contains(*type)) {
+        continue;
+      }
+      std::u16string value = t.ColumnString16(1);
+      if (*type == autofill::ADDRESS_HOME_COUNTRY) {
+        country = base::UTF16ToUTF8(value);
+      }
+      tokens.emplace_back(*type, std::move(value), t.ColumnInt(2));
+    }
+    if (tokens.empty()) {
+      continue;
+    }
+    autofill::AutofillProfile profile(
+        base::Uuid::GenerateRandomV4().AsLowercaseString(),
+        autofill::AutofillProfile::RecordType::kLocalOrSyncable,
+        autofill::AddressCountryCode(country));
+    for (auto& [type, value, status] : tokens) {
+      if (status < 0 ||
+          status > static_cast<int>(autofill::VerificationStatus::kMaxValue)) {
+        status = 0;
+      }
+      profile.SetRawInfoWithVerificationStatus(
+          type, value, static_cast<autofill::VerificationStatus>(status));
+    }
+    profile.usage_history().set_use_count(std::max(0, s.ColumnInt(1)));
+    profile.usage_history().set_use_date(
+        base::Time::FromTimeT(s.ColumnInt64(2)));
+    profile.usage_history().set_modification_date(
+        base::Time::FromTimeT(s.ColumnInt64(3)));
+    profile.set_language_code(s.ColumnString(4));
+    profile.FinalizeAfterImport();
+    out.push_back(std::move(profile));
+  }
+}
