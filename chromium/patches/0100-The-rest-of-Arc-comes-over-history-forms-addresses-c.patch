+  std::set<GURL> have;
+  for (const ArchivedTab& e : entries_) {
+    have.insert(e.url);
+  }
+  int added = 0;
+  for (ArchivedTab& tab : tabs) {
+    if (!WorthKeeping(tab.url) || !have.insert(tab.url).second) {
+      continue;
+    }
+    tab.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    entries_.push_back(std::move(tab));
+    ++added;
+  }
+  if (!added) {
+    return 0;
+  }
+  std::ranges::stable_sort(entries_, std::ranges::greater(),
+                           &ArchivedTab::archived_at);
+  if (entries_.size() > kMaxEntries) {
+    entries_.resize(kMaxEntries);
+  }
+  Changed();
+  return added;
