+// Reads the payment cards saved in one Arc "Web Data" database (from a private
+// copy), with their security codes if Arc kept them.
+bool ReadCards(const base::FilePath& db_file,
+               base::span<const uint8_t> key,
+               std::set<std::u16string>& seen,
+               std::vector<autofill::CreditCard>& cards,
+               int& failed) {
+  base::ScopedTempDir tmp;
+  sql::Database db(sql::Database::Tag("Web"));
+  if (!OpenCopy(db_file, tmp, db) || !db.DoesTableExist("credit_cards")) {
+    return false;
+  }
+  std::map<std::string, std::u16string> cvcs;
+  if (db.DoesTableExist("local_stored_cvc")) {
+    sql::Statement c(db.GetUniqueStatement(
+        "SELECT guid, value_encrypted FROM local_stored_cvc"));
+    while (c.Step()) {
+      std::optional<std::string> cvc =
+          Decrypt(c.ColumnBlob(1), key, std::string(), 0);
+      if (cvc && !cvc->empty()) {
+        cvcs[c.ColumnString(0)] = base::UTF8ToUTF16(*cvc);
+        OPENSSL_cleanse(cvc->data(), cvc->size());
+      }
+    }
+  }
+  static constexpr base::cstring_view kColumns[] = {
+      "guid",       "name_on_card", "expiration_month", "expiration_year",
+      "card_number_encrypted", "date_modified", "use_count", "use_date",
+      "nickname"};
+  sql::Statement s(
+      db.GetUniqueStatement(SelectOf(db, "credit_cards", kColumns)));
+  while (s.Step()) {
+    std::optional<std::string> number =
+        Decrypt(s.ColumnBlob(4), key, std::string(), 0);
+    if (!number || number->empty()) {
+      if (!number) {
+        ++failed;
+      }
+      continue;
+    }
+    std::u16string number16 = base::UTF8ToUTF16(*number);
+    OPENSSL_cleanse(number->data(), number->size());
+    if (!seen.insert(number16).second) {
+      continue;
+    }
+    autofill::CreditCard card(
+        base::Uuid::GenerateRandomV4().AsLowercaseString());
+    card.SetRawInfo(autofill::CREDIT_CARD_NAME_FULL, s.ColumnString16(1));
+    card.SetNumber(std::move(number16));
+    card.SetExpirationMonth(s.ColumnInt(2));
+    card.SetExpirationYear(s.ColumnInt(3));
+    card.SetNickname(s.ColumnString16(8));
+    card.usage_history().set_modification_date(
+        base::Time::FromTimeT(s.ColumnInt64(5)));
+    card.usage_history().set_use_count(std::max(0, s.ColumnInt(6)));
+    card.usage_history().set_use_date(base::Time::FromTimeT(s.ColumnInt64(7)));
+    if (auto cvc = cvcs.find(s.ColumnString(0)); cvc != cvcs.end()) {
+      card.set_cvc(cvc->second);
+    }
+    cards.push_back(std::move(card));
+  }
+  for (auto& [guid, cvc] : cvcs) {
+    std::fill(cvc.begin(), cvc.end(), u'\0');
+  }
+  return true;
+}
