+bool OpenCopy(const base::FilePath& db_file,
+              base::ScopedTempDir& tmp,
+              sql::Database& db) {
+  if (!tmp.CreateUniqueTempDir()) {
+    return false;
+  }
+  base::FilePath copy = tmp.GetPath().Append(db_file.BaseName());
+  if (!base::CopyFile(db_file, copy)) {
+    return false;
+  }
+  for (const char* ext : {"-wal", "-journal"}) {
+    base::FilePath side(db_file.value() + ext);
+    if (base::PathExists(side)) {
+      base::CopyFile(side, base::FilePath(copy.value() + ext));
+    }
+  }
+  return db.Open(copy);
+}
+
+std::string SelectOf(sql::Database& db,
+                     base::cstring_view table,
+                     base::span<const base::cstring_view> columns) {
+  std::string select = "SELECT ";
+  bool first = true;
+  for (base::cstring_view column : columns) {
+    if (!first) {
+      select += ", ";
+    }
+    first = false;
+    select += db.DoesColumnExist(table, column) ? std::string(column)
+                                                : std::string("NULL");
+  }
+  return select + " FROM " + std::string(table);
+}
+
+base::Time FromWindows(int64_t us) {
+  return us ? base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(us))
+            : base::Time();
+}
