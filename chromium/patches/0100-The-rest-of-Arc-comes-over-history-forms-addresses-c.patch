+
+#ifndef CHROME_BROWSER_MERIDIAN_ARC_DATA_H_
+#define CHROME_BROWSER_MERIDIAN_ARC_DATA_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+
+class Profile;
+
+namespace meridian {
+
+// The rest of Arc, after the sidebar (arc_import.h) and the sign-ins
+// (arc_logins.h): browsing history, form entries and addresses, site
+// permissions, custom site searches, the sites' own storage, Air Traffic
+// Control's rules and the archive. None of it is encrypted, so macOS doesn't
+// ask.
+//
+// Like the rest of the import, Arc is only read (from private copies) and
+// nothing leaves the machine. Each Arc profile's data goes to its Meridian
+// profile (ProfileIdForArcDir), created if needed; the archive and the rules
+// go to `profile`. What Meridian already has wins: a permission set here, a
+// keyword taken, a site with storage of its own are left alone. Doing it again
+// adds nothing twice.
+//
+// Sites' databases (IndexedDB) can't be written while the profile runs: they
+// are put next to it and move in when it next opens (MoveStagedArcSiteData).
+struct ArcDataResult {
+  // Pages of history.
+  int history = 0;
+  // Things typed into forms (suggested again in the same fields).
+  int form_entries = 0;
+  int addresses = 0;
+  int permissions = 0;
+  int search_engines = 0;
+  // Sites whose storage came over now (localStorage), and those whose
+  // databases come over when Meridian next opens.
+  int sites = 0;
+  int site_databases = 0;
+  int link_rules = 0;
+  int archived = 0;
+  // Empty on success, else "no-data".
+  std::string error;
+};
+
+// Whether Arc's data folder is there (blocking: file IO).
+bool ArcDataAvailable();
+
+void ImportArcData(Profile* profile,
+                   base::OnceCallback<void(ArcDataResult)> done);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_ARC_DATA_H_
