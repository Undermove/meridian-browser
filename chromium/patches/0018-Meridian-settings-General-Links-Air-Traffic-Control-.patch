@@ -0,0 +1,302 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Meridian's settings (⌘,): General, Links (Air Traffic Control) and
+// Advanced. Passwords, privacy and site settings are Chromium's own, one click
+// away at chrome://settings.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {Atc, Settings, SidebarHandlerInterface, Space} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './settings.css.js';
+import {getHtml} from './settings.html.js';
+
+export type SectionId = 'general'|'links'|'advanced';
+
+export interface Choice {
+  value: string;
+  label: string;
+}
+
+export interface RuleRow {
+  index: number;
+  pattern: string;
+  target: string;
+  first: boolean;
+}
+
+const ARCHIVE_CHOICES: Choice[] = [
+  {value: '12', label: '12 hours'},
+  {value: '24', label: '1 day'},
+  {value: '168', label: '1 week'},
+  {value: '720', label: '30 days'},
+  {value: '0', label: 'Never'},
+];
+
+export class MeridianSettingsElement extends CrLitElement {
+  static get is() {
+    return 'meridian-settings';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      section_: {state: true, type: String},
+      settings_: {state: true, type: Object},
+      spaces_: {state: true, type: Array},
+      tryResult_: {state: true, type: String},
+      confirmClear_: {state: true, type: Boolean},
+      rules_: {state: true, type: Array},
+      targets_: {state: true, type: Array},
+      archiveChoices_: {state: true, type: Array},
+      archiveValue_: {state: true, type: String},
+      noRules_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  protected accessor section_: SectionId = 'general';
+  protected accessor settings_: Settings|null = null;
+  protected accessor spaces_: Space[] = [];
+  protected accessor tryResult_: string = '';
+  protected accessor confirmClear_: boolean = false;
+  // Derived in willUpdate().
+  protected accessor rules_: RuleRow[] = [];
+  protected accessor targets_: Choice[] = [];
+  protected accessor archiveChoices_: Choice[] = ARCHIVE_CHOICES;
+  protected accessor archiveValue_: string = '12';
+  protected accessor noRules_: boolean = true;
+
+  private readonly handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  private tryUrl_: string = '';
+
+  async show(spaces: Space[], section: SectionId = 'general') {
+    this.spaces_ = spaces;
+    this.section_ = section;
+    this.tryResult_ = '';
+    this.confirmClear_ = false;
+    const {settings} = await this.handler_.getSettings();
+    this.settings_ = settings;
+    this.open = true;
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    const rules = this.settings_?.atc.rules || [];
+    this.rules_ = rules.map((r, index) => ({
+                              index,
+                              pattern: r.pattern,
+                              target: r.target,
+                              first: index === 0,
+                            }));
+    this.noRules_ = rules.length === 0;
+    this.archiveValue_ = `${this.settings_?.archiveAfterHours ?? 12}`;
+    this.targets_ = [
+      {value: 'little', label: 'Little Window'},
+      {value: 'main', label: 'Current Space'},
+      ...this.spaces_.map(s => ({
+                            value: `space:${s.id}`,
+                            label: `${s.icon ? s.icon + ' ' : ''}${s.name}`,
+                          })),
+    ];
+  }
+
+  // Saves the whole settings object (the handler validates it).
+  private save_(change: Partial<Settings>) {
+    if (!this.settings_) {
+      return;
+    }
+    this.settings_ = {...this.settings_, ...change};
+    this.handler_.setSettings(this.settings_);
+  }
+
+  private saveAtc_(atc: Atc) {
+    this.save_({atc});
+    this.runTry_();
+  }
+
+  // ------------------------------------------------------------ events
+
+  protected onOverlayClick_(e: Event) {
+    if (e.target === e.currentTarget) {
+      this.hide();
+    }
+  }
+
+  protected onPanelKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      if (this.confirmClear_) {
+        this.confirmClear_ = false;
+      } else {
+        this.hide();
+      }
+    }
+  }
+
+  protected onCloseClick_() {
+    this.hide();
+  }
+
+  protected onTabClick_(e: Event) {
+    this.section_ =
+        (e.currentTarget as HTMLElement).dataset['id'] as SectionId;
+  }
+
+  protected onSegmentClick_(e: Event) {
+    const el = e.currentTarget as HTMLElement;
+    const name = el.dataset['name'];
+    const value = el.dataset['value']!;
+    if (name === 'appearance') {
+      this.save_({appearance: value});
+    } else if (name === 'sidebar') {
+      this.save_({sidebarRight: value === 'right'});
+    } else if (name === 'mode') {
+      this.save_({mode: value});
+    }
+  }
+
+  protected onArchiveChange_(e: Event) {
+    this.save_(
+        {archiveAfterHours: Number((e.target as HTMLSelectElement).value)});
+  }
+
+  protected async onMakeDefaultClick_() {
+    const {isDefault} = await this.handler_.setDefaultBrowser();
+    this.save_({isDefaultBrowser: isDefault});
+  }
+
+  protected onBrowserSettingsClick_(e: Event) {
+    this.handler_.openBrowserSettings(
+        (e.currentTarget as HTMLElement).dataset['page'] || '');
+    this.hide();
+  }
+
+  protected onImportArcClick_() {
+    this.hide();
+    this.fire('meridian-onboarding', 'arc');
+  }
+
+  protected onTourClick_() {
+    this.hide();
+    this.fire('meridian-onboarding', 'tour');
+  }
+
+  protected onClearArchiveClick_() {
+    this.confirmClear_ = true;
+  }
+
+  protected onConfirmCancelClick_() {
+    this.confirmClear_ = false;
+  }
+
+  protected onConfirmClearClick_() {
+    this.confirmClear_ = false;
+    this.handler_.clearArchive();
+  }
+
+  // Links: Air Traffic Control.
+
+  protected onAddRuleClick_() {
+    const atc = this.settings_!.atc;
+    const first = this.spaces_[0];
+    this.saveAtc_({
+      ...atc,
+      rules: [
+        ...atc.rules,
+        {
+          id: Math.random().toString(36).slice(2, 10),
+          pattern: '',
+          target: first ? `space:${first.id}` : 'main',
+        },
+      ],
+    });
+  }
+
+  private editRule_(index: number, change: {pattern?: string, target?: string}) {
+    const atc = this.settings_!.atc;
+    this.saveAtc_({
+      ...atc,
+      rules: atc.rules.map((r, i) => i === index ? {...r, ...change} : r),
+    });
+  }
+
+  protected onRulePatternChange_(e: Event) {
+    const el = e.target as HTMLInputElement;
+    this.editRule_(Number(el.dataset['index']), {pattern: el.value.trim()});
+  }
+
+  protected onRuleTargetChange_(e: Event) {
+    const el = e.target as HTMLSelectElement;
+    this.editRule_(Number(el.dataset['index']), {target: el.value});
+  }
+
+  protected onRuleUpClick_(e: Event) {
+    const i = Number((e.currentTarget as HTMLElement).dataset['index']);
+    const rules = [...this.settings_!.atc.rules];
+    if (i > 0) {
+      [rules[i - 1], rules[i]] = [rules[i]!, rules[i - 1]!];
+      this.saveAtc_({...this.settings_!.atc, rules});
+    }
+  }
+
+  protected onRuleDeleteClick_(e: Event) {
+    const i = Number((e.currentTarget as HTMLElement).dataset['index']);
+    const atc = this.settings_!.atc;
+    this.saveAtc_({...atc, rules: atc.rules.filter((_, j) => j !== i)});
+  }
+
+  protected onFallbackChange_(e: Event) {
+    this.saveAtc_({
+      ...this.settings_!.atc,
+      fallback: (e.target as HTMLSelectElement).value,
+    });
+  }
+
+  protected onTryInput_(e: Event) {
+    this.tryUrl_ = (e.target as HTMLInputElement).value.trim();
+    this.runTry_();
+  }
+
+  private async runTry_() {
+    const value = this.tryUrl_;
+    if (!value || !this.settings_) {
+      this.tryResult_ = '';
+      return;
+    }
+    const url = /^https?:\/\//i.test(value) ? value : `https://${value}`;
+    const {target, spaceId, pattern} =
+        await this.handler_.testLinkRoute(this.settings_.atc, url);
+    const space = this.spaces_.find(s => s.id === spaceId);
+    const where = target === 'little' ? 'Little Window' :
+        target === 'space'            ? space?.name || 'Space' :
+                                        'Current Space';
+    this.tryResult_ = `→ ${where} ${
+        pattern ? `(rule “${pattern}”)` : '(no rule matched)'}`;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-settings': MeridianSettingsElement;
+  }
+}
+
+customElements.define(MeridianSettingsElement.is, MeridianSettingsElement);
