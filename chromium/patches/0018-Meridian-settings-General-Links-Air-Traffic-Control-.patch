+std::optional<base::DictValue> SanitizeAtc(const base::DictValue& atc) {
+  auto valid_target = [](const std::string& t) {
+    if (t == "little" || t == "main") {
+      return true;
+    }
+    if (!t.starts_with("space:") || t.size() > 6 + 64 || t.size() == 6) {
+      return false;
+    }
+    return std::ranges::all_of(t.substr(6), [](char c) {
+      return base::IsAsciiAlphaNumeric(c) || c == '-' || c == '_';
+    });
+  };
+  base::DictValue out;
+  const std::string* fallback = atc.FindString("fallback");
+  out.Set("fallback", fallback && *fallback == "main" ? "main" : "little");
+  base::ListValue rules;
+  if (const base::ListValue* in = atc.FindList("rules")) {
+    for (const base::Value& rule : *in) {
+      const base::DictValue* dict = rule.GetIfDict();
+      const std::string* pattern = dict ? dict->FindString("pattern") : nullptr;
+      const std::string* target = dict ? dict->FindString("target") : nullptr;
+      if (!pattern || !target || !valid_target(*target) ||
+          NormalizePattern(*pattern).empty() || rules.size() >= 200) {
+        continue;
+      }
+      const std::string* id = dict->FindString("id");
+      base::DictValue clean;
+      clean.Set("id", id && !id->empty() && id->size() <= 64 ? *id : "rule");
+      clean.Set("pattern", std::string(base::TrimWhitespaceASCII(
+                               pattern->substr(0, 300), base::TRIM_ALL)));
+      clean.Set("target", *target);
+      rules.Append(std::move(clean));
+    }
+  }
+  out.Set("rules", std::move(rules));
+  return out;
+}
+
 }  // namespace meridian
