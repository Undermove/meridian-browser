+mojom::AtcPtr AtcToMojo(const base::DictValue& dict) {
+  auto atc = mojom::Atc::New();
+  const std::string* fallback = dict.FindString("fallback");
+  atc->fallback = fallback && *fallback == "main" ? "main" : "little";
+  if (const base::ListValue* rules = dict.FindList("rules")) {
+    for (const base::Value& rule : *rules) {
+      const base::DictValue* r = rule.GetIfDict();
+      if (!r) {
+        continue;
+      }
+      auto m = mojom::AtcRule::New();
+      const std::string* id = r->FindString("id");
+      const std::string* pattern = r->FindString("pattern");
+      const std::string* target = r->FindString("target");
+      m->id = id ? *id : std::string();
+      m->pattern = pattern ? *pattern : std::string();
+      m->target = target ? *target : std::string();
+      atc->rules.push_back(std::move(m));
+    }
+  }
+  return atc;
+}
+
+base::DictValue AtcFromMojo(const mojom::Atc& atc) {
+  base::DictValue dict;
+  dict.Set("fallback", atc.fallback);
+  base::ListValue rules;
+  for (const mojom::AtcRulePtr& rule : atc.rules) {
+    base::DictValue r;
+    r.Set("id", rule->id);
+    r.Set("pattern", rule->pattern);
+    r.Set("target", rule->target);
+    rules.Append(std::move(r));
+  }
+  dict.Set("rules", std::move(rules));
+  return dict;
+}
+
+}  // namespace
+
+void SidebarHandler::GetSettings(GetSettingsCallback callback) {
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  auto settings = mojom::Settings::New();
+  settings->mode = prefs->GetString(prefs::kMode);
+  settings->sidebar_right = prefs->GetBoolean(prefs::kSidebarRight);
+  using Scheme = ThemeService::BrowserColorScheme;
+  Scheme scheme = ThemeServiceFactory::GetForProfile(browser_->GetProfile())
+                      ->GetBrowserColorScheme();
+  settings->appearance = scheme == Scheme::kLight  ? "light"
+                         : scheme == Scheme::kDark ? "dark"
+                                                   : "system";
+  settings->archive_after_hours = prefs->GetInteger(prefs::kArchiveAfterHours);
+  settings->atc = AtcToMojo(prefs->GetDict(prefs::kAtc));
+  settings->version = std::string(version_info::GetVersionNumber());
+  IsDefaultBrowser(base::BindOnce(
+      [](GetSettingsCallback callback, mojom::SettingsPtr settings,
+         bool is_default) {
+        settings->is_default_browser = is_default;
+        std::move(callback).Run(std::move(settings));
+      },
+      std::move(callback), std::move(settings)));
+}
+
+void SidebarHandler::SetSettings(mojom::SettingsPtr settings) {
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  const std::string& mode = settings->mode;
+  if (mode == "everyday" || mode == "creative" || mode == "developer") {
+    prefs->SetString(prefs::kMode, mode);
+  }
+  using Scheme = ThemeService::BrowserColorScheme;
+  const std::string& appearance = settings->appearance;
+  if (appearance == "system" || appearance == "light" ||
+      appearance == "dark") {
+    Scheme scheme = appearance == "light"  ? Scheme::kLight
+                    : appearance == "dark" ? Scheme::kDark
+                                           : Scheme::kSystem;
+    ThemeService* themes =
+        ThemeServiceFactory::GetForProfile(browser_->GetProfile());
+    if (themes->GetBrowserColorScheme() != scheme) {
+      themes->SetBrowserColorScheme(scheme);
+    }
+  }
+  prefs->SetBoolean(prefs::kSidebarRight, settings->sidebar_right);
+  int hours = settings->archive_after_hours;
+  if (hours == 0 || hours == 12 || hours == 24 || hours == 168 ||
+      hours == 720) {
+    prefs->SetInteger(prefs::kArchiveAfterHours, hours);
+  }
+  if (settings->atc) {
+    if (std::optional<base::DictValue> atc =
+            SanitizeAtc(AtcFromMojo(*settings->atc))) {
+      prefs->SetDict(prefs::kAtc, std::move(*atc));
+    }
+  }
+}
+
+void SidebarHandler::TestLinkRoute(mojom::AtcPtr atc,
+                                   const std::string& url,
+                                   TestLinkRouteCallback callback) {
+  AtcRoute route =
+      RouteLink(SanitizeAtc(AtcFromMojo(*atc)).value_or(base::DictValue()),
+                GURL(url), SpaceIds());
+  const char* target = route.target == AtcRoute::Target::kSpace ? "space"
+                       : route.target == AtcRoute::Target::kMain ? "main"
+                                                                 : "little";
+  std::move(callback).Run(target, route.space_id, route.pattern);
+}
+
+void SidebarHandler::OpenBrowserSettings(const std::string& page) {
+  static constexpr const char* kPages[] = {
+      "", "passwords", "autofill", "privacy", "content", "search",
+      "clearBrowserData", "help"};
+  if (std::ranges::find(kPages, page) == std::end(kPages)) {
+    return;
+  }
+  GURL url(page == "passwords" ? std::string("chrome://password-manager/")
+                               : "chrome://settings/" + page);
+  NavigateParams params(browser_, url, ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  Navigate(&params);
+}
+
+void SidebarHandler::ClearArchive() {
+  archive_->Clear();
+}
