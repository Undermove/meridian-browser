   // ----------------------------------------------------------- commands
 
+  // The open tabs in sidebar order, for the command bar's Switch to Tab.
+  openTabsForCommandBar(): CommandBarTab[] {
+    const out: CommandBarTab[] = [];
+    for (const entry of this.navOrder_()) {
+      const tab = entry.tab || (entry.item ? this.liveTab(entry.item.id) : null);
+      if (tab && !tab.isActive && !tab.url.startsWith('chrome://newtab')) {
+        out.push({
+          id: tab.id,
+          title: (entry.item?.title) || this.customTitle_(tab.id) || tab.title,
+          url: tab.url,
+          favicon: this.faviconFor(entry.item || null, tab),
+        });
+      }
+    }
+    return out;
+  }
+
