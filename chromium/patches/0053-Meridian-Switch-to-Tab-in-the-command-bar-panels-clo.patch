+    // With nothing typed, the arrows go through the open tabs.
+    if (!this.query_.trim() && this.tabRows_.length &&
+        (e.key === 'ArrowDown' || e.key === 'ArrowUp' ||
+         (e.key === 'Enter' && this.tabSel_ >= 0))) {
+      e.preventDefault();
