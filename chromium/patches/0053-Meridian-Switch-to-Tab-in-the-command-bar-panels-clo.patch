+      this.tabSel_ = -1;
+    }
+  }
+
+  protected onTabRowClick_(e: Event) {
+    this.switchTo_((e.currentTarget as HTMLElement).dataset['id']!);
+  }
+
+  private switchTo_(id: string) {
+    this.hide();
+    this.fire('command-bar-switch-tab', id);
