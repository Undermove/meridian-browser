+#if !BUILDFLAG(IS_WIN)
+// zsh's startup files for a shell tab (ZDOTDIR): the person's own run as
+// always, then `claude` typed there gets what a Claude Code tab gets (the
+// hooks and status line in --settings, the browser tools). An alias or a
+// function of their own named claude keeps working, with these added.
+constexpr char kZshEnv[] = R"(# Meridian Workbench: your startup files, then Claude Code reports to Meridian.
+_meridian_zdotdir=$ZDOTDIR
+ZDOTDIR=${MERIDIAN_USER_ZDOTDIR:-$HOME}
+[[ -r $ZDOTDIR/.zshenv ]] && builtin source $ZDOTDIR/.zshenv
+MERIDIAN_USER_ZDOTDIR=$ZDOTDIR
+ZDOTDIR=$_meridian_zdotdir
+)";
+constexpr char kZshProfile[] = R"(ZDOTDIR=$MERIDIAN_USER_ZDOTDIR
+[[ -r $ZDOTDIR/.zprofile ]] && builtin source $ZDOTDIR/.zprofile
+MERIDIAN_USER_ZDOTDIR=$ZDOTDIR
+ZDOTDIR=$_meridian_zdotdir
+)";
+constexpr char kZshRc[] = R"(ZDOTDIR=$MERIDIAN_USER_ZDOTDIR
+[[ -r $ZDOTDIR/.zshrc ]] && builtin source $ZDOTDIR/.zshrc
+MERIDIAN_USER_ZDOTDIR=$ZDOTDIR
+ZDOTDIR=$_meridian_zdotdir
+if (( ${+aliases[claude]} )); then
+  _meridian_claude=${aliases[claude]}
+  unalias claude
+elif (( ${+functions[claude]} )); then
+  functions[_meridian_own_claude]=$functions[claude]
+  _meridian_claude=_meridian_own_claude
+else
+  _meridian_claude='command claude'
+fi
+claude() {
+  # Their alias or function calling claude again: the real one this time.
+  if [[ -n $_meridian_in_claude ]]; then
+    command claude "$@"
+    return
+  fi
+  local _meridian_in_claude=1
+  case "$1" in
+    mcp|config|doctor|update|upgrade|install|setup-token|plugin|plugins|migrate-installer|auth|login|logout|agents|-v|--version|-h|--help)
+      eval "$_meridian_claude" '"$@"' ;;
+    *)
+      eval "$_meridian_claude" '"$@"' --settings '"$MERIDIAN_CLAUDE_SETTINGS"' --mcp-config '"$MERIDIAN_CLAUDE_MCP"' ;;
+  esac
+}
+)";
+constexpr char kZshLogin[] = R"(ZDOTDIR=$MERIDIAN_USER_ZDOTDIR
+[[ -r $ZDOTDIR/.zlogin ]] && builtin source $ZDOTDIR/.zlogin
+unset _meridian_zdotdir
+)";
+
+void AddShellClaude(LaunchSpec& spec, const McpBridge& bridge) {
+  base::FilePath dir;
+  if (!base::CreateNewTempDirectory(FILE_PATH_LITERAL("meridian-zsh-"), &dir)) {
+    return;
+  }
+  MakePrivate(dir, 0700);
+  spec.cleanup.push_back(dir);
+  auto write = [&](const std::string& name, std::string_view content) {
+    base::FilePath file = dir.AppendUTF8(name);
+    if (!base::WriteFile(file, content)) {
+      return base::FilePath();
+    }
+    MakePrivate(file, 0600);
+    return file;
+  };
+  base::ListValue bridge_args;
+  for (const std::string& a : bridge.args) {
+    bridge_args.Append(a);
+  }
+  base::FilePath settings = write(
+      "settings.json", base::WriteJson(*bridge.claude_settings).value_or("{}"));
+  base::FilePath mcp = write(
+      "mcp.json",
+      base::WriteJson(
+          base::DictValue().Set(
+              "mcpServers",
+              base::DictValue().Set("meridian",
+                                    base::DictValue()
+                                        .Set("command", bridge.command)
+                                        .Set("args", std::move(bridge_args)))))
+          .value_or("{}"));
+  if (settings.empty() || mcp.empty() || write(".zshenv", kZshEnv).empty() ||
+      write(".zprofile", kZshProfile).empty() ||
+      write(".zshrc", kZshRc).empty() || write(".zlogin", kZshLogin).empty()) {
+    return;
+  }
+  spec.env["ZDOTDIR"] = dir.AsUTF8Unsafe();
+  spec.env["MERIDIAN_CLAUDE_SETTINGS"] = settings.AsUTF8Unsafe();
+  spec.env["MERIDIAN_CLAUDE_MCP"] = mcp.AsUTF8Unsafe();
+  spec.browser_tools = true;
+}
+#endif
+
 }  // namespace
 
 std::string FindExecutable(const std::string& name,
@@ -119,6 +212,10 @@ base::expected<LaunchSpec, std::string> MakeLaunchSpec(
     spec.argv = {shell};
 #else
     spec.argv = {shell, "-l"};
+    if (bridge.claude_settings &&
+        base::FilePath::FromUTF8Unsafe(shell).BaseName().value() == "zsh") {
+      AddShellClaude(spec, bridge);
+    }
 #endif
     return spec;
   }
