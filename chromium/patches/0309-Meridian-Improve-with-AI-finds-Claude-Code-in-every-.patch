+  if (local_->Found()) {
+    local_->RefreshFound();
+    std::move(done).Run();
+    return;
   }
-  std::vector<std::string> keys = local_->CloudKeyIds();
-  return keys.empty() ? std::string() : keys.front();
+  local_->List(/*fresh=*/false,
