-  std::string chosen = profile_->GetPrefs()->GetString(prefs::kAiProvider);
-  if (chosen == "api" || (!chosen.empty() && ai::FindProvider(chosen))) {
-    return chosen;
+  PrefService* prefs = profile_->GetPrefs();
+  std::optional<std::vector<ai::Detected>> found =
+      PicksLocalAgents() ? local_->Found() : std::nullopt;
+  return ai::PickProvider(prefs->GetString(prefs::kAiProvider), HasKey(),
+                          local_->CloudKeyIds(),
