+// A local agent or model server as LocalAgents::List last found it.
+struct Detected {
+  std::string id;
+  bool installed = false;
+  // nullopt = can't tell.
+  std::optional<bool> signed_in;
+  // Can't answer on this system ("macOS only for now").
+  bool unavailable = false;
+};
+
+// Who answers when nothing more specific is asked for: the one picked in
+// Settings > AI ("api" or a known provider id); else ("Automatic") Claude on
+// the key ("api"), the first saved cloud key, then the first coding agent
+// (a CLI) found on this computer that can answer, in Providers() order
+// (Claude Code first), the opt-in ones only with "Other agents" on. Local
+// model servers only when picked. "" when nothing is set up.
+std::string PickProvider(const std::string& chosen,
+                         bool has_key,
+                         const std::vector<std::string>& cloud_keys,
+                         const std::vector<Detected>& found,
+                         bool other_agents);
+
 // One CLI run.
 struct CommandSpec {
