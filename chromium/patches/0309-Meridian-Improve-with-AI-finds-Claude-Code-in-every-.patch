diff --git a/chrome/browser/meridian/ai/providers.cc b/chrome/browser/meridian/ai/providers.cc
index d1b627b5c9..96b6f60645 100644
--- a/chrome/browser/meridian/ai/providers.cc
+++ b/chrome/browser/meridian/ai/providers.cc
@@ -505,6 +505,35 @@ std::optional<bool> OpenCodeAuth(const std::string& out, std::string*) {
 
 }  // namespace
 
+std::string PickProvider(const std::string& chosen,
+                         bool has_key,
+                         const std::vector<std::string>& cloud_keys,
+                         const std::vector<Detected>& found,
+                         bool other_agents) {
+  if (chosen == "api" || (!chosen.empty() && FindProvider(chosen))) {
+    return chosen;
+  }
+  if (has_key) {
+    return "api";
+  }
+  if (!cloud_keys.empty()) {
+    return cloud_keys.front();
+  }
+  for (const Provider& p : Providers()) {
+    if (p.kind != Kind::kCli ||
+        (p.policy == Policy::kOptIn && !other_agents)) {
+      continue;
+    }
+    for (const Detected& d : found) {
+      if (d.id == p.id && d.installed && d.signed_in != false &&
+          !d.unavailable) {
+        return p.id;
+      }
+    }
+  }
+  return std::string();
+}
+
 const std::vector<Provider>& Providers() {
   static const base::NoDestructor<std::vector<Provider>> providers(
       MakeProviders());
