+std::optional<std::vector<Detected>> LocalAgents::Found() const {
+  if (!cache_) {
+    return std::nullopt;
+  }
+  std::vector<Detected> out;
+  for (const Status& s : cache_->second) {
+    out.push_back({s.id, s.installed, s.signed_in, !s.unavailable.empty()});
+  }
+  return out;
+}
+
+void LocalAgents::RefreshFound() {
+  if (refreshing_ || !cache_ ||
+      base::TimeTicks::Now() - cache_->first < kListCacheAge) {
+    return;
+  }
+  refreshing_ = true;
+  List(/*fresh=*/true,
+       base::BindOnce(
+           [](base::WeakPtr<LocalAgents> self, std::vector<Status>) {
+             if (self) {
+               self->refreshing_ = false;
+             }
+           },
+           weak_factory_.GetWeakPtr()));
+}
