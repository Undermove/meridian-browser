diff --git a/chrome/browser/meridian/ai/providers_unittest.cc b/chrome/browser/meridian/ai/providers_unittest.cc
index 9a88f8c1e4..09d8980634 100644
--- a/chrome/browser/meridian/ai/providers_unittest.cc
+++ b/chrome/browser/meridian/ai/providers_unittest.cc
@@ -152,5 +152,63 @@ TEST(ProvidersTest, FriendlyErrors) {
   EXPECT_EQ(FriendlyCliError(codex, "", "line 1\nboom"), "Codex: boom");
 }
 
+TEST(ProvidersTest, PickProviderChosenWins) {
+  std::vector<Detected> found = {{"claude-code", true, true, false}};
+  EXPECT_EQ(PickProvider("codex", false, {}, found, false), "codex");
+  EXPECT_EQ(PickProvider("api", false, {}, found, false), "api");
+  EXPECT_EQ(PickProvider("ollama", true, {"openai"}, found, false), "ollama");
+  // One that isn't known any more: Automatic.
+  EXPECT_EQ(PickProvider("gone", false, {}, found, false), "claude-code");
+}
+
+TEST(ProvidersTest, PickProviderAutomaticKeysFirst) {
+  std::vector<Detected> found = {{"claude-code", true, true, false}};
+  EXPECT_EQ(PickProvider("", true, {"openai"}, found, false), "api");
+  EXPECT_EQ(PickProvider("", false, {"openai", "gemini"}, found, false),
+            "openai");
+}
+
+TEST(ProvidersTest, PickProviderAutomaticFallsBackToAnAgentHere) {
+  // Nothing found yet, or nothing installed: nothing set up.
+  EXPECT_EQ(PickProvider("", false, {}, {}, false), "");
+  EXPECT_EQ(PickProvider("", false, {}, {{"claude-code", false, {}, false}},
+                         false),
+            "");
+  // Claude Code first, whatever order the list is in.
+  std::vector<Detected> both = {{"codex", true, true, false},
+                                {"claude-code", true, true, false}};
+  EXPECT_EQ(PickProvider("", false, {}, both, true), "claude-code");
+  // Signed out or unable to answer here: the next one.
+  EXPECT_EQ(PickProvider("", false, {},
+                         {{"claude-code", true, false, false},
+                          {"codex", true, true, false}},
+                         true),
+            "codex");
+  EXPECT_EQ(PickProvider("", false, {},
+                         {{"claude-code", true, {}, true},
+                          {"qwen", true, {}, false}},
+                         true),
+            "qwen");
+  // A local model server answers only when picked.
+  EXPECT_EQ(PickProvider("", false, {},
+                         {{"ollama", true, {}, false},
+                          {"lmstudio", true, {}, false}},
+                         true),
+            "");
+  // Can't tell whether it's signed in: it may answer.
+  EXPECT_EQ(PickProvider("", false, {}, {{"claude-code", true, {}, false}},
+                         false),
+            "claude-code");
+}
+
+TEST(ProvidersTest, PickProviderOptInAgentsOnlyWithOtherAgents) {
+  std::vector<Detected> codex = {{"codex", true, true, false}};
+  EXPECT_EQ(PickProvider("", false, {}, codex, false), "");
+  EXPECT_EQ(PickProvider("", false, {}, codex, true), "codex");
+  // Claude Code still before it.
+  codex.push_back({"claude-code", true, true, false});
+  EXPECT_EQ(PickProvider("", false, {}, codex, true), "claude-code");
+}
+
 }  // namespace
 }  // namespace meridian::ai
