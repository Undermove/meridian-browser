 namespace {
 
+// Where a bubble for `action_id` anchors: its toolbar icon, or (Meridian's
+// WebUI browser, without a toolbar) where page info would show.
+views::BubbleAnchor AnchorFor(BrowserWindowInterface* browser,
+                              ToolbarButtonProvider* toolbar_button_provider,
+                              std::optional<actions::ActionId> action_id) {
+  if (toolbar_button_provider) {
+    return toolbar_button_provider->GetBubbleAnchor(action_id);
+  }
+  return bubble_anchor_util::GetPageInfoAnchorConfiguration(browser).anchor;
+}
+
+// Meridian (WebUI browser): no toolbar icon to highlight; the bubble gets the
+// window as its parent and, without an anchor, the page info corner.
+void PlaceWithoutToolbar(views::BubbleDialogDelegateView* bubble,
+                         BrowserWindowInterface* browser) {
+  bubble_anchor_util::AnchorConfiguration page_info =
+      bubble_anchor_util::GetPageInfoAnchorConfiguration(browser);
+  if (views::View* view = page_info.anchor.GetIfView()) {
+    bubble->set_parent_window(view->GetWidget()->GetNativeView());
+  } else if (ui::TrackedElement* element = page_info.anchor.GetIfElement()) {
+    bubble->set_parent_window(element->GetNativeView());
+  } else {
+    bubble->set_parent_window(platform_util::GetViewForWindow(
+        browser->GetWindow()->GetNativeWindow()));
+    bubble->SetAnchorRect(bubble_anchor_util::GetPageInfoAnchorRect(browser));
+  }
+  bubble->SetArrow(page_info.bubble_arrow);
+}
