+void SidebarHandler::AddPinnedLink(mojom::ItemPositionPtr position,
+                                   const std::string& title,
+                                   const GURL& url,
+                                   AddPinnedLinkCallback callback) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    std::move(callback).Run(std::string());
+    return;
+  }
+  if (position->container == kFavorites) {
+    position->container = Favorites();
+  }
+  Item link;
+  link.title = title.empty() ? url.host() : title;
+  link.url = url;
+  std::move(callback).Run(service_->AddItem(
+      position->container, position->parent_id, position->index, link));
+}
