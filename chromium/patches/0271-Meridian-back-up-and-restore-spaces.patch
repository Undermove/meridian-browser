+++ b/chrome/browser/resources/webui_browser/meridian/space_backup.ts
@@ -0,0 +1,186 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Space backup: a space's look and its pinned tabs and folders as a file, and
+// back. Only what the sidebar shows: no cookies, passwords or history.
+
+import type {Item, SidebarHandlerInterface, Space} from '../sidebar.mojom-webui.js';
+
+export const BACKUP_KIND = 'meridian-spaces';
+export const BACKUP_VERSION = 1;
+
+export interface BackupItem {
+  title: string;
+  // A link's home address; none for a folder.
+  url?: string;
+  folder?: boolean;
+  open?: boolean;
+  children?: BackupItem[];
+}
+
+export interface BackupSpace {
+  name: string;
+  icon: string;
+  color: string;
+  color2: string;
+  grain: boolean;
+  pinned: BackupItem[];
+}
+
+export interface Backup {
+  kind: string;
+  version: number;
+  savedAt: string;
+  spaces: BackupSpace[];
+}
+
+function itemOf(item: Item): BackupItem {
+  if (item.isFolder) {
+    return {title: item.title, folder: true, open: item.open,
+            children: item.children.map(itemOf)};
+  }
+  return {title: item.title, url: item.url};
+}
+
+export function backupOf(spaces: Space[], now = new Date()): Backup {
+  return {
+    kind: BACKUP_KIND,
+    version: BACKUP_VERSION,
+    savedAt: now.toISOString(),
+    spaces: spaces.map(s => ({
+                         name: s.name,
+                         icon: s.icon,
+                         color: s.color,
+                         color2: s.color2,
+                         grain: s.grain,
+                         pinned: s.pinned.map(itemOf),
+                       })),
+  };
+}
+
+// "Work.meridian-space.json", "Meridian Spaces 2026-11-25.json".
+export function backupFileName(spaces: Space[], now = new Date()): string {
+  if (spaces.length === 1) {
+    const name = spaces[0]!.name.replace(/[\\/:*?"<>|]+/g, '').trim();
+    return `${name || 'Space'}.meridian-space.json`;
+  }
+  return `Meridian Spaces ${now.toISOString().slice(0, 10)}.json`;
+}
+
+// The backup in `text`, or why it isn't one.
+export function parseBackup(text: string): Backup|string {
+  let data: unknown;
+  try {
+    data = JSON.parse(text);
+  } catch {
+    return 'This file is not a Meridian space backup';
+  }
+  const b = data as Partial<Backup>;
+  if (!b || b.kind !== BACKUP_KIND || !Array.isArray(b.spaces)) {
+    return 'This file is not a Meridian space backup';
+  }
+  if ((b.version || 0) > BACKUP_VERSION) {
+    return 'This backup is from a newer Meridian: update to restore it';
+  }
+  const str = (v: unknown, max = 2048) =>
+      typeof v === 'string' ? v.slice(0, max) : '';
+  const items = (list: unknown, depth: number): BackupItem[] =>
+      !Array.isArray(list) || depth > 8 ?
+      [] :
+      list.slice(0, 2000).flatMap((x): BackupItem[] => {
+        if (!x || typeof x !== 'object') {
+          return [];
+        }
+        const i = x as BackupItem;
+        if (i.folder) {
+          return [{title: str(i.title, 200) || 'Folder', folder: true,
+                   open: i.open !== false,
+                   children: items(i.children, depth + 1)}];
+        }
+        const url = str(i.url);
+        return /^https?:\/\//i.test(url) ? [{title: str(i.title, 200), url}] :
+                                           [];
+      });
+  return {
+    kind: BACKUP_KIND,
+    version: BACKUP_VERSION,
+    savedAt: str(b.savedAt, 64),
+    spaces: b.spaces.slice(0, 100).map((s: Partial<BackupSpace>) => ({
+      name: str(s?.name, 100) || 'Space',
+      icon: str(s?.icon, 32),
+      color: str(s?.color, 64),
+      color2: str(s?.color2, 64),
+      grain: !!s?.grain,
+      pinned: items(s?.pinned, 0),
+    })),
+  };
+}
+
+// Each space of the backup as a new space (an existing one is never
+// touched), with its pinned tabs and folders unopened. Its id for each.
+export async function restoreBackup(
+    handler: SidebarHandlerInterface, backup: Backup): Promise<string[]> {
+  const ids: string[] = [];
+  for (const s of backup.spaces) {
+    const {spaceId} =
+        await handler.createSpace(s.name, s.icon, s.color, s.color2);
+    if (!spaceId) {
+      continue;
+    }
+    if (s.grain) {
+      handler.setSpaceGrain(spaceId, true);
+    }
+    const add = async (list: BackupItem[], parentId: string) => {
+      for (const [index, item] of list.entries()) {
+        const position = {container: spaceId, parentId, index};
+        if (item.folder) {
+          const {itemId} = await handler.addFolder(position, item.title);
+          if (itemId) {
+            await add(item.children || [], itemId);
+            if (item.open === false) {
+              handler.setFolderOpen(itemId, false);
+            }
+          }
+        } else if (item.url) {
+          await handler.addPinnedLink(position, item.title, item.url);
+        }
+      }
+    };
+    await add(s.pinned, '');
+    ids.push(spaceId);
+  }
+  return ids;
+}
+
+// Saves `backup` as a file in Downloads.
+export function saveBackup(backup: Backup, fileName: string) {
+  const blob = new Blob([JSON.stringify(backup, null, 2)],
+                        {type: 'application/json'});
+  const a = document.createElement('a');
+  a.href = URL.createObjectURL(blob);
+  a.download = fileName;
+  document.body.appendChild(a);
+  a.click();
+  a.remove();
+  setTimeout(() => URL.revokeObjectURL(a.href), 60000);
+}
+
+// The text of a backup file the person picks, or null.
+export function pickBackupFile(): Promise<string|null> {
+  return new Promise(resolve => {
+    const input = document.createElement('input');
+    input.type = 'file';
+    input.accept = '.json,application/json';
+    input.addEventListener('change', () => {
+      const file = input.files?.[0];
+      if (!file) {
+        resolve(null);
+        return;
+      }
+      file.text().then(resolve, () => resolve(null));
+    });
+    input.addEventListener('cancel', () => resolve(null));
+    input.click();
+  });
+}
