+void SidebarHandler::TestBubbles(const std::string& action,
+                                 TestBubblesCallback callback) {
+  std::vector<std::string> names;
+  views::Widget* window = views::Widget::GetWidgetForNativeWindow(
+      browser_->GetWindow()->GetNativeWindow());
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "meridian-test-bubbles") ||
+      !window) {
+    std::move(callback).Run(std::move(names));
+    return;
+  }
+  views::DialogDelegate* newest = nullptr;
+  for (views::Widget* widget :
+       views::Widget::GetAllOwnedWidgets(window->GetNativeView())) {
+    if (widget->IsClosed() || !widget->widget_delegate()) {
+      continue;
+    }
+    newest = widget->widget_delegate()->AsDialogDelegate();
+  }
+  if (newest && action == "accept") {
+    newest->AcceptDialog();
+  } else if (newest && action == "cancel") {
+    newest->CancelDialog();
+  }
+  for (views::Widget* widget :
+       views::Widget::GetAllOwnedWidgets(window->GetNativeView())) {
+    if (!widget->IsClosed() && widget->widget_delegate() &&
+        widget->widget_delegate()->GetContentsView()) {
+      names.emplace_back(
+          widget->widget_delegate()->GetContentsView()->GetClassName());
+    }
+  }
+  std::move(callback).Run(std::move(names));
+}
