+// static
+bool LocalAgents::OnLocalNetwork(const GURL& url) {
+  if (net::IsLocalhost(url) || url.host().ends_with(".local")) {
+    return true;
+  }
+  net::IPAddress ip;
+  return ip.AssignFromIPLiteral(url.HostNoBrackets()) &&
+         !ip.IsPubliclyRoutable();
+}
+
+// static
+std::optional<std::string> LocalAgents::CustomBase(const std::string& raw,
+                                                   std::string* error) {
+  std::string text(base::TrimWhitespaceASCII(raw, base::TRIM_ALL));
+  // The address people copy is often the whole endpoint.
+  for (const char* tail : {"/chat/completions", "/models", "/"}) {
+    while (text.ends_with(tail) && text.size() > strlen(tail)) {
+      text.resize(text.size() - strlen(tail));
+    }
+  }
+  GURL url(text);
+  if (!url.is_valid() || !url.has_host() ||
+      !(url.SchemeIs("https") || url.SchemeIs("http")) ||
+      url.has_username() || url.has_password() || url.has_query() ||
+      url.has_ref()) {
+    *error =
+        "That isn’t an API address. It looks like "
+        "“https://api.example.com/v1”: the part before /chat/completions.";
+    return std::nullopt;
+  }
+  // The key would travel in the clear: only to this computer or the local
+  // network.
+  if (url.SchemeIs("http") && !OnLocalNetwork(url)) {
+    *error =
+        "Use an https:// address. http:// is only for a server on this "
+        "computer or your local network: the key would be sent unencrypted.";
+    return std::nullopt;
+  }
+  return text;
+}
+
+void LocalAgents::AddCustom(
+    const std::string& raw_base,
+    const std::string& raw_key,
+    base::OnceCallback<void(bool, std::string)> done) {
+  std::string error;
+  std::optional<std::string> base = CustomBase(raw_base, &error);
+  if (!base) {
+    std::move(done).Run(false, error);
+    return;
+  }
+  std::string key(base::TrimWhitespaceASCII(raw_key, base::TRIM_ALL));
+  ListModels(
+      "custom", key,
+      base::BindOnce(
+          [](base::WeakPtr<LocalAgents> self, std::string base,
+             std::string key, base::OnceCallback<void(bool, std::string)> done,
+             int status, std::vector<std::string> models) {
+            if (!self) {
+              return;
+            }
+            if (status == 401 || status == 403) {
+              std::move(done).Run(false,
+                                  "The server didn’t accept this key.");
+              return;
+            }
+            if (status != 200) {
+              std::move(done).Run(
+                  false, status == 0
+                             ? "Couldn’t reach " + std::string(GURL(base).host()) +
+                                   ". Check the address and your connection."
+                             : "The server answered " +
+                                   base::NumberToString(status) +
+                                   " for " + base +
+                                   "/models: is this an OpenAI-compatible "
+                                   "API address?");
+              return;
+            }
+            if (models.empty()) {
+              std::move(done).Run(false,
+                                  "The server didn’t list any chat models.");
+              return;
+            }
+            self->models_["custom"] = {base::TimeTicks::Now(), models};
+            g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+                [](base::WeakPtr<LocalAgents> self, std::string base,
+                   std::string key,
+                   base::OnceCallback<void(bool, std::string)> done,
+                   scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+                  std::string sealed;
+                  if (!self || !encryptor ||
+                      !encryptor->EncryptString(key, &sealed)) {
+                    std::move(done).Run(
+                        false,
+                        "Meridian couldn’t reach the keychain to store the "
+                        "key safely.");
+                    return;
+                  }
+                  self->profile_->GetPrefs()->SetString(prefs::kAiCustomBase,
+                                                        base);
+                  ScopedDictPrefUpdate(self->profile_->GetPrefs(),
+                                       prefs::kAiCloudKeys)
+                      ->Set("custom", base::Base64Encode(sealed));
+                  std::move(done).Run(true, std::string());
+                },
+                self, base, key, std::move(done)));
+          },
+          weak_factory_.GetWeakPtr(), *base, key, std::move(done)),
+      *base);
+}
+
 }  // namespace meridian::ai
