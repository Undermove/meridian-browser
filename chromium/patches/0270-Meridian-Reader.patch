+void SidebarHandler::ToggleReader(ToggleReaderCallback callback) {
+  tabs::TabInterface* tab = model()->GetActiveTab();
+  if (!tab) {
+    std::move(callback).Run("none");
+    return;
+  }
+  content::WebContents* contents = tab->GetContents();
+  const GURL& url = contents->GetLastCommittedURL();
+  if (dom_distiller::url_utils::IsDistilledPage(url)) {
+    GURL original =
+        dom_distiller::url_utils::GetOriginalUrlFromDistillerUrl(url);
+    if (original.is_valid()) {
+      contents->GetController().LoadURL(original, content::Referrer(),
+                                        ui::PAGE_TRANSITION_AUTO_BOOKMARK,
+                                        std::string());
+    }
+    std::move(callback).Run("off");
+    return;
+  }
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    std::move(callback).Run("none");
+    return;
+  }
+  // Only a page that reads as an article (Chromium's readability check),
+  // so a home page or a form isn't turned into a blank sheet.
+  RunReadabilityHeuristicsOnWebContents(
+      contents,
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents,
+             ToggleReaderCallback callback, bool readable) {
+            if (!readable || !contents) {
+              std::move(callback).Run("none");
+              return;
+            }
+            DistillCurrentPageAndViewIfSuccessful(
+                contents.get(),
+                base::BindOnce(
+                    [](ToggleReaderCallback callback, bool ok) {
+                      std::move(callback).Run(ok ? "on" : "none");
+                    },
+                    std::move(callback)));
+          },
+          contents->GetWeakPtr(), std::move(callback)));
+}
