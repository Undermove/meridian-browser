From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Mon, 16 Nov 2026 00:23:28 +0400
Subject: [PATCH 137/202] Meridian: the command bar doesn't open under Settings

Settings covers the window, above the command bar: New Tab's shortcut with
Settings open put the bar behind it and gave it the keys. While Settings is
open the bar stays closed.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 chrome/browser/resources/webui_browser/app.ts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index 89f7bae08d..5dd52e421b 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -1010,6 +1010,11 @@ export class WebuiBrowserAppElement extends CrLitElement {
   }
 
   private showCommandBar_(newTab: boolean, text: string) {
+    // Not under Settings, which covers the window: the bar would open behind
+    // it and take the keys.
+    if (this.$.settings.open) {
+      return;
+    }
     this.closeSiteControl_();
     this.commandBarTabs_ = this.$.tabstrip.openTabsForCommandBar();
     this.$.commandBar.profileId = this.$.tabstrip.activeProfileId();
