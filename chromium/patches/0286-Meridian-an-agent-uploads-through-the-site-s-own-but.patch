+// upload_file on a page with no file field, nothing named: the site makes
+// its <input type=file> (or calls showOpenFilePicker) when its own button is
+// clicked. The approved file waits for this tab's next chooser on this site
+// for 30 seconds and the agent is told to click that button now; the chooser
+// then gets the file in place of the native dialog. Nothing is offered
+// without the person's approval (asked above, like any upload).
+void AgentService::OfferUpload(tabs::TabHandle handle,
+                               std::unique_ptr<Call> call,
+                               base::FilePath real,
+                               base::FilePath copy,
+                               std::string mb) {
+  tabs::TabInterface* tab = handle.Get();
+  if (!tab) {
+    return call->Fail("the tab is gone");
+  }
+  if (!call->StillOnSameDocument()) {
+    return call->Fail(
+        "The page changed while waiting for approval, so nothing was "
+        "uploaded. Look at it again.");
+  }
+  content::WebContents* contents = tab->GetContents();
+  const std::string host(contents->GetLastCommittedURL().host());
+  int seconds = 30;
+  if (int s = 0; base::StringToInt(
+                     meridian::TestSwitchValue("meridian-test-upload-offer-seconds"), &s) &&
+                 s > 0) {
+    seconds = s;
+  }
+  const base::TimeDelta ttl = base::Seconds(seconds);
+  int id = agent_input::OfferFile(contents, host, copy, real, ttl,
+                                  base::DoNothing());
+  // Gone after the time is up, used or not.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce([](const void* tab, int id) { agent_input::Withdraw(tab, id); },
+                     static_cast<const void*>(contents), id),
+      ttl);
+  call->Ok(base::Value(
+      base::DictValue()
+          .Set("offered", real.BaseName().AsUTF8Unsafe())
+          .Set("size", mb)
+          .Set("next",
+               "Click the site's upload button now (click with its "
+               "element_index, selector or text): the file chooser it opens "
+               "in this tab within " +
+                   base::NumberToString(seconds) +
+                   " seconds gets this file instead of a dialog. After that "
+                   "nothing is offered.")));
+}
