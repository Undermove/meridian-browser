   // the window has no Meridian sidebar (the caller opens a tab as usual).
   static bool ShowCommandBar(BrowserWindowInterface* browser);
+  static void ShowToast(BrowserWindowInterface* browser,
+                        const std::string& text);
 
   // Handles the tab / space / pin commands (IDC_*) for `browser` through its
   // sidebar. False if the command isn't one of them or the window has no
diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index 252f32e58b..c6ae2109df 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -681,8 +681,9 @@ export class WebuiBrowserAppElement extends CrLitElement {
     if (this.missionToastTimer_ !== null) {
       clearTimeout(this.missionToastTimer_);
     }
-    this.missionToastTimer_ =
-        setTimeout(() => this.missionToast_ = null, 8000);
+    // A plain confirmation ("Copied link") goes sooner than an agent's news.
+    this.missionToastTimer_ = setTimeout(
+        () => this.missionToast_ = null, e.detail.nodeId ? 8000 : 1800);
   }
 
   protected onMissionToastShowClick_() {
