Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/sidebar.mojom             |  2 ++
 chrome/browser/meridian/sidebar_handler.cc        | 15 +++++++++++++++
 chrome/browser/meridian/sidebar_handler.h         |  2 ++
 chrome/browser/resources/webui_browser/app.ts     |  5 +++--
 .../resources/webui_browser/meridian/sidebar.ts   |  6 ++++++
 5 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/meridian/sidebar.mojom b/chrome/browser/meridian/sidebar.mojom
index f6cbdc0d2c..b05484441c 100644
--- a/chrome/browser/meridian/sidebar.mojom
+++ b/chrome/browser/meridian/sidebar.mojom
@@ -406,6 +406,8 @@ interface SidebarPage {
   // ⌘T / File > New Tab: the command bar opens, and a tab opens only once
   // something is picked (like Arc).
   ShowCommandBar();
+  // A short confirmation at the bottom of the window ("Copied link").
+  ShowToast(string text);
 
   RunCommand(Command command, int32 arg);
 
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index bb70c46e4e..18197d3a5b 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -237,6 +237,15 @@ bool SidebarHandler::ShowCommandBar(BrowserWindowInterface* browser) {
   return true;
 }
 
+// static
+void SidebarHandler::ShowToast(BrowserWindowInterface* browser,
+                               const std::string& text) {
+  auto it = Handlers().find(browser);
+  if (it != Handlers().end() && it->second->page_.is_connected()) {
+    it->second->page_->ShowToast(text);
+  }
+}
+
 TabStripModel* SidebarHandler::model() {
   return browser_->GetTabStripModel();
 }
@@ -522,6 +531,11 @@ bool SidebarHandler::HandleCommand(BrowserWindowInterface* browser,
   if (id == IDC_NEW_TAB) {
     return ShowCommandBar(browser);
   }
+  // ⇧⌘C copies as Chrome does; Arc says so.
+  if (id == IDC_COPY_URL) {
+    ShowToast(browser, "Copied link");
+    return false;
+  }
   // ⇧⌥⌘C: "[title](url)" of the page (Arc's Copy URL as Markdown).
   if (id == IDC_MERIDIAN_COPY_MARKDOWN) {
     tabs::TabInterface* tab = browser->GetActiveTabInterface();
@@ -535,6 +549,7 @@ bool SidebarHandler::HandleCommand(BrowserWindowInterface* browser,
         .WriteText(u"[" + title + u"](" +
                    base::UTF8ToUTF16(contents->GetVisibleURL().spec()) +
                    u")");
+    ShowToast(browser, "Copied as Markdown");
     return true;
   }
   // ⌥⌘N: a Little Window (Arc's Little Arc) on a new tab page.
