From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Meridian <meridian@localhost>
Date: Tue, 24 Nov 2026 20:29:50 +0300
Subject: [PATCH] Meridian: Pi's model table told from its prose;
 JSONReader::Read options arg

---
 chrome/browser/meridian/ai/providers.cc          | 30 ++++++++++++++++++++----
 chrome/browser/meridian/ai/providers_unittest.cc |  2 +-
 2 files changed, 26 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/meridian/ai/providers.cc b/chrome/browser/meridian/ai/providers.cc
index bf31c5e948..8421c3f5eb 100644
--- a/chrome/browser/meridian/ai/providers.cc
+++ b/chrome/browser/meridian/ai/providers.cc
@@ -563,12 +563,27 @@ std::optional<bool> OpenCodeAuth(const std::string& out, std::string*) {
 
 std::optional<bool> PiAuth(const std::string& out, std::string*) {
   // Only the models of providers signed in to are listed; without any, Pi
-  // says how to sign in.
+  // says how to sign in. A row that parses into models means signed in; a row
+  // that doesn't (shorter columns) still does, as long as it sits under the
+  // table's header.
+  if (RE2::PartialMatch(out, "(?i)no models available")) {
+    return false;
+  }
   if (!CliListedModels("pi", out).empty()) {
     return true;
   }
-  if (RE2::PartialMatch(out, "(?i)no models available")) {
-    return false;
+  bool header = false;
+  for (const std::string& line :
+       base::SplitString(out, "\n", base::TRIM_WHITESPACE,
+                         base::SPLIT_WANT_NONEMPTY)) {
+    std::vector<std::string_view> fields =
+        base::SplitStringPiece(line, " \t", base::TRIM_WHITESPACE,
+                               base::SPLIT_WANT_NONEMPTY);
+    if (fields.size() >= 2 && fields[0] == "provider") {
+      header = true;
+    } else if (header && !fields.empty()) {
+      return true;
+    }
   }
   return std::nullopt;
 }
@@ -914,14 +929,19 @@ std::vector<std::string> CliListedModels(const std::string& provider_id,
   std::vector<std::string> out;
   if (provider_id == "pi") {
     // "provider  model  context  max-out  thinking  images", then a row per
-    // model of the providers signed in to.
+    // model of the providers signed in to. A row is told from prose ("No
+    // models available…") by its shape: six columns, a size in max-out and
+    // yes/no flags at the end.
     for (const std::string& line :
          base::SplitString(output, "\n", base::TRIM_WHITESPACE,
                            base::SPLIT_WANT_NONEMPTY)) {
       std::vector<std::string_view> fields =
           base::SplitStringPiece(line, " \t", base::TRIM_WHITESPACE,
                                  base::SPLIT_WANT_NONEMPTY);
-      if (fields.size() >= 2 && fields[0] != "provider") {
+      if (fields.size() == 6 && fields[0] != "provider" &&
+          RE2::FullMatch(fields[3], "[0-9]+[KkMm]?") &&
+          (fields[4] == "yes" || fields[4] == "no") &&
+          (fields[5] == "yes" || fields[5] == "no")) {
         out.push_back(base::StrCat({fields[0], "/", fields[1]}));
       }
     }
diff --git a/chrome/browser/meridian/ai/providers_unittest.cc b/chrome/browser/meridian/ai/providers_unittest.cc
index 27f4ada5b2..37e43eb5b5 100644
--- a/chrome/browser/meridian/ai/providers_unittest.cc
+++ b/chrome/browser/meridian/ai/providers_unittest.cc
@@ -133,7 +133,7 @@ TEST(ProvidersTest, OpenCode2AnswersAloneWithItsOwnConfiguration) {
   EXPECT_EQ(v2.stdin_text, turn.prompt);
   EXPECT_EQ(v2.env.at("OPENCODE_DISABLE_PROJECT_CONFIG"), "1");
   const std::string& config = v2.env.at("OPENCODE_CONFIG_CONTENT");
-  std::optional<base::Value> read = base::JSONReader::Read(config);
+  std::optional<base::Value> read = base::JSONReader::Read(config, 0);
   ASSERT_TRUE(read) << config;
   const base::DictValue& c = read->GetDict();
   // Denied everywhere: globally, and for Meridian's agent.
