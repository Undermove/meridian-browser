From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 26 Nov 2026 17:01:03 +0400
Subject: [PATCH] Meridian: a sleeping tab looks like any other tab, as in
 Arc

A tab put to sleep (by hand or on its own) no longer shows a moon, a
dimmed favicon or an "Asleep" tooltip in the sidebar: Today rows, pinned
rows and split halves look the same awake or asleep. Sleep itself, Put to
Sleep and Keep Awake are unchanged; TabInfo.asleep stays in the state
(sidebar.isAsleep) for tests and tools.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/sidebar.mojom         |  3 ++-
 chrome/browser/meridian/sidebar_handler.cc    |  4 +--
 .../webui_browser/meridian/item.html.ts       |  4 +--
 .../resources/webui_browser/meridian/item.ts  |  4 ---
 .../resources/webui_browser/meridian/rows.css | 26 -------------------
 .../webui_browser/meridian/sidebar.html.ts    |  3 ---
 .../webui_browser/meridian/sidebar.ts         |  3 ++-
 .../webui_browser/meridian/tab_row.html.ts    |  4 +--
 .../webui_browser/meridian/tab_row.ts         |  3 ---
 9 files changed, 8 insertions(+), 46 deletions(-)

diff --git a/chrome/browser/meridian/sidebar.mojom b/chrome/browser/meridian/sidebar.mojom
index 35fb19e7be..6c45d04859 100644
--- a/chrome/browser/meridian/sidebar.mojom
+++ b/chrome/browser/meridian/sidebar.mojom
@@ -101,7 +101,8 @@ struct TabInfo {
   // A Peek card over `opener_id` (see TabData::peek()).
   bool peek;
   tabs_api.mojom.NodeId? opener_id;
-  // Put to sleep (discarded) and not loaded again yet: the sidebar dims it.
+  // Put to sleep (discarded) and not loaded again yet. Not shown: a
+  // sleeping tab looks like any other in the sidebar, as in Arc.
   bool asleep;
 };
 
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index ddc75c991e..1346f23bdb 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -480,7 +480,7 @@ void SidebarHandler::OnTabChangedAt(tabs::TabInterface* tab,
   if (!peek_candidates_.empty()) {
     MaybePeek(tab);
   }
-  // Put to sleep, or loading again: the sidebar's sleeping look.
+  // Put to sleep, or loading again: TabInfo.asleep changes.
   if (IsAsleep(tab) != asleep_.contains(tab->GetHandle().raw_value())) {
     ScheduleNotify();
   }
@@ -583,7 +583,7 @@ void SidebarHandler::PutTabToSleep(const tabs_api::NodeId& tab_id,
       tab->GetContents());
   const bool slept =
       unit->DiscardTab(::mojom::LifecycleUnitDiscardReason::EXTERNAL);
-  // Its sleeping look in the sidebar (a discard may not change the row).
+  // TabInfo.asleep (a discard may not change the row).
   if (slept) {
     ScheduleNotify();
   }
