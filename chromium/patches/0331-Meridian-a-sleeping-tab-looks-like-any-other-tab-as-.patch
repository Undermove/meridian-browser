diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
index 336dc9e2ee..c81ded254c 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
@@ -577,7 +577,8 @@ export class MeridianSidebarElement extends CrLitElement implements
     }
   }
 
-  // Put to sleep and not loaded again: the row looks asleep.
+  // Put to sleep and not loaded again. Not shown: a sleeping tab looks
+  // like any other, as in Arc (it reloads when opened).
   isAsleep(tab: Tab|null): boolean {
     return !!tab && !!this.state_?.tabs.find(t => t.tabId === tab.id)?.asleep;
   }
