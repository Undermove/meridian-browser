From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 26 Nov 2026 15:12:49 +0400
Subject: [PATCH 327/330] Meridian: the report scrubber's test makes its fake
 keys at run time

GitHub's secret scanning took the Google API key shaped string in
ReportScrubTest.NoKeysOrTokens for a real one. Each fake key and token
there (sk-ant-, sk-proj-, ghp_, github_pat_, AIza, xoxb-, AKIA, a JWT, a
hex and a base64 secret) is now joined from two pieces, never written
whole: the same strings for the scrubber, nothing for a scanner to match.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/report_unittest.cc | 28 ++++++++++++----------
 1 file changed, 16 insertions(+), 12 deletions(-)

diff --git a/chrome/browser/meridian/report_unittest.cc b/chrome/browser/meridian/report_unittest.cc
index 4dfe42b8bb..6e0bf97097 100644
--- a/chrome/browser/meridian/report_unittest.cc
+++ b/chrome/browser/meridian/report_unittest.cc
@@ -60,19 +60,23 @@ TEST(ReportScrubTest, NoAddresses) {
 
 TEST(ReportScrubTest, NoKeysOrTokens) {
   const Private p = Mac();
-  const char* secrets[] = {
-      "sk-ant-api03-AbCdEf0123456789_xyz-QWERTY",
-      "sk-proj-1234567890abcdef",
-      "ghp_0123456789abcdefABCDEF0123456789abcd",
-      "github_pat_11ABCDEFG0123456789_abcdefghijklmnop",
-      "AIzaSyD-0123456789abcdefghijklmnopqrstu",
-      "xoxb-1234567890-abcdefghij",
-      "AKIAIOSFODNN7EXAMPLE",
-      "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0In0.c2lnbmF0dXJl",
-      "0123456789abcdef0123456789abcdef0123",
-      "dGhpcyBpcyBhIHNlY3JldCBrZXkgdGhhdCBpcyBsb25n+/x9==",
+  // Made from pieces at run time, never written whole, so that secret
+  // scanners don't take these fakes for real keys.
+  const std::string secrets[] = {
+      std::string("sk-") + "ant-api03-AbCdEf0123456789_xyz-QWERTY",
+      std::string("sk-") + "proj-1234567890abcdef",
+      std::string("ghp") + "_0123456789abcdefABCDEF0123456789abcd",
+      std::string("github") +
+          "_pat_11ABCDEFG0123456789_abcdefghijklmnop",
+      std::string("AI") + "zaSyD-0123456789abcdefghijklmnopqrstu",
+      std::string("xo") + "xb-1234567890-abcdefghij",
+      std::string("AK") + "IAIOSFODNN7EXAMPLE",
+      std::string("eyJhbGciOiJIUzI1NiJ9") +
+          ".eyJzdWIiOiIxMjM0In0.c2lnbmF0dXJl",
+      std::string("0123456789abcdef") + "0123456789abcdef0123",
+      std::string("dGhpcyBpcyBhIHNlY3JldCBr") + "ZXkgdGhhdCBpcyBsb25n+/x9==",
   };
-  for (const char* secret : secrets) {
+  for (const std::string& secret : secrets) {
     const std::string out = Scrub(std::string("key: ") + secret + " end", p);
     EXPECT_FALSE(Has(out, secret)) << out;
     EXPECT_TRUE(Has(out, "[hidden]")) << out;
