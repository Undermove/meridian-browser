   // opens in a new foreground tab instead of the current one.
   accessor newTab: boolean = false;
 
+  // Meridian (Arc): what Return opens stays first, then pages from history,
+  // bookmarks and open tabs, then at most three search suggestions. The
+  // browser knows the matches in its own order: `lines_` maps back.
+  private lines_: number[] = [];
+  private browserResult_: AutocompleteResult|null = null;
+
+  override onAutocompleteResultChanged(result: AutocompleteResult) {
+    const indexed = result.matches.map((match, line) => ({match, line}));
+    const [first, ...rest] = indexed;
+    const pages = rest.filter(m => !m.match.isSearchType);
+    const searches = rest.filter(m => m.match.isSearchType).slice(0, 3);
+    const order = first ? [first, ...pages, ...searches] : [];
+    this.lines_ = order.map(m => m.line);
+    this.browserResult_ = result;
+    return super.onAutocompleteResultChanged(
+        {...result, matches: order.map(m => m.match)});
+  }
+
   override navigateToMatch(matchIndex: number, e: KeyboardEvent|MouseEvent) {
+    const line = this.lines_[matchIndex];
+    if (line !== undefined && this.browserResult_ &&
+        this.result?.sequenceId === this.browserResult_.sequenceId) {
+      const shown = this.result;
+      this.result = this.browserResult_;
+      this.navigateToLine_(line, e);
+      this.result = shown;
+      return;
+    }
+    this.navigateToLine_(matchIndex, e);
+  }
+
+  private navigateToLine_(matchIndex: number, e: KeyboardEvent|MouseEvent) {
     if (!this.newTab) {
       super.navigateToMatch(matchIndex, e);
       this.fire('searchbox-navigated');
