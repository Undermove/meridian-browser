From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Meridian <meridian@localhost>
Date: Thu, 26 Nov 2026 18:17:19 +0400
Subject: [PATCH] Meridian: Windows: the site controls open in sight with the
 sidebar hidden

On Windows the URL pill and its site-controls button live in the top bar,
but the site controls stayed inside the sidebar. With the sidebar hidden
(see-through, slid away, not taking the pointer) the button opened them
unseen behind the page: no Boost, no permissions, nothing to click. They
move to the window's root with the pill, and a floating sidebar that goes
no longer takes them on Windows: they belong to the top bar there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/resources/webui_browser/app.ts | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index ca1ce9a641..c630f9c1a2 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -317,6 +317,11 @@ export class WebuiBrowserAppElement extends CrLitElement {
         const find = (id: string) => this.shadowRoot.getElementById(id)!;
         find('winTopLeft').appendChild(find('sidebarTop'));
         find('winTopCenter').appendChild(this.$.urlPill);
+        // The site controls open from the pill's button, now in the top bar:
+        // out of the sidebar too, or with the sidebar hidden (see-through,
+        // slid away, not taking the pointer) they opened unseen behind the
+        // page, Boost and all.
+        find('rootContainer').appendChild(this.$.siteControl);
       });
     }
     this.trackedElementManager_.startTracking(
@@ -749,7 +754,11 @@ export class WebuiBrowserAppElement extends CrLitElement {
       if (this.peekCloseTimer_ !== timer || !this.sidebarPeek_) {
         return;
       }
-      this.closeSiteControl_();
+      // (On Windows the site controls belong to the top bar, not to the
+      // floating sidebar: they stay.)
+      if (!isWindows) {
+        this.closeSiteControl_();
+      }
       this.sidebarPeek_ = false;
     }, 450);
     this.peekCloseTimer_ = timer;
-- 
