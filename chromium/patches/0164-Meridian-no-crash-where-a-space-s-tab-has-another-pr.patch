+// A link that came before the spaces loaded (Meridian started by it): opened
+// once they have. It used to be dropped.
+class PendingLink : public SidebarService::Observer {
+ public:
+  PendingLink(Profile* profile, SidebarService* service, GURL url)
+      : profile_(profile), service_(service), url_(std::move(url)) {
+    service_->AddObserver(this);
+  }
+
+  void OnSidebarChanged() override {
+    if (!service_->loaded()) {
+      return;
+    }
+    service_->RemoveObserver(this);
+    Profile* profile = profile_;
+    GURL url = url_;
+    delete this;
+    OpenExternalLink(profile, url);
+  }
+
+ private:
+  raw_ptr<Profile> profile_;
+  raw_ptr<SidebarService> service_;
+  GURL url_;
+};
+
+}  // namespace
+
+bool CanCreateWindow(Profile& profile) {
+  return GetBrowserWindowCreationStatusForProfile(profile) ==
+         BrowserWindowInterface::CreationStatus::kOk;
+}
