index 0000000000..c00fe97c14
--- /dev/null
+++ b/chrome/browser/meridian/workbench/project_fs.h
@@ -0,0 +1,73 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_PROJECT_FS_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_PROJECT_FS_H_
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+
+namespace meridian::workbench {
+
+// Workbench: file access scoped to one project folder. Blocking: use on a
+// sequence that may block.
+//
+// Every path from the workbench page is relative to the project root. It is
+// resolved and checked twice: lexically (no "..", no absolute paths) and by
+// real path, so a symlink inside the project that points elsewhere can't be
+// used to read or write outside it. Writes pin the file and verify the
+// opened handle before changing anything (no check-then-write race).
+class ProjectFs {
+ public:
+  // nullopt if `root` isn't a folder.
+  static std::optional<ProjectFs> Open(const base::FilePath& root);
+
+  const base::FilePath& root() const { return root_; }
+  std::string name() const;
+
+  // The absolute path of `rel` inside the project. `must_exist` false is for
+  // create/rename targets: the parent must exist inside, the name be plain.
+  base::expected<base::FilePath, std::string> Resolve(const std::string& rel,
+                                                      bool must_exist) const;
+  // `abs` relative to the root, with "/" separators.
+  std::string Rel(const base::FilePath& abs) const;
+
+  // {path, entries: [{name, path, type, link?, outside?, hidden?}], truncated}
+  base::expected<base::DictValue, std::string> List(const std::string& rel,
+                                                    bool show_hidden) const;
+  // {path, content | binary | tooLarge, size, mtimeMs}
+  base::expected<base::DictValue, std::string> Read(
+      const std::string& rel) const;
+  // {exists, mtimeMs?, size?, dir?}
+  base::DictValue Stat(const std::string& rel) const;
+  // {path, mtimeMs, size}
+  base::expected<base::DictValue, std::string> Write(
+      const std::string& rel,
+      const std::string& content) const;
+  base::expected<base::DictValue, std::string> Create(const std::string& rel,
+                                                      bool dir) const;
+  base::expected<base::DictValue, std::string> Rename(
+      const std::string& from,
+      const std::string& to) const;
+  // To the Trash, so a slip is recoverable.
+  base::expected<bool, std::string> Remove(const std::string& rel) const;
+
+ private:
+  explicit ProjectFs(base::FilePath root);
+  bool Inside(const base::FilePath& abs) const;
+
+  // The real path of the root.
+  base::FilePath root_;
+};
+
+// Moves `path` to the Trash (project_fs_mac.mm).
+bool MoveToTrash(const base::FilePath& path);
