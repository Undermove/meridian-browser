+  void Emit(const std::string& channel, base::Value payload);
+  void Dispatch(const std::string& method,
+                const base::ListValue& params,
+                Reply reply);
+
+  void Info(Reply reply);
+  void OpenProject(base::FilePath dir, Reply reply);
+  void OnProjectOpened(Reply reply, std::optional<ProjectFs> project);
+  void CloseProject();
+  void OnFileChanged(const base::FilePath& path, bool error);
+  void FlushChanges();
+  base::DictValue ProjectInfo() const;
+  // Runs `op` on the project, on the file sequence.
+  void OnProject(base::OnceCallback<Result(const ProjectFs&)> op, Reply reply);
+  void CreateTerminal(base::DictValue opts, Reply reply);
+  void OnTerminalData(std::string id, std::string data);
+  void OnTerminalExit(std::string id, int code, int signal);
+  base::DictValue TermInfo(const std::string& id, const Term& term) const;
+  void ToHost(const base::DictValue& message);
+
+  base::FilePath StorePath() const;
+
+  raw_ptr<Profile> profile_;
+  scoped_refptr<base::SequencedTaskRunner> files_;
+  std::optional<ProjectFs> project_;
+  // Remembered between calls: recents and preview URLs.
+  base::DictValue store_;
+  base::SequenceBound<base::FilePathWatcher> watcher_;
+  std::set<std::string> changed_;
+  base::OneShotTimer flush_;
+  std::map<std::string, Term> terms_;
+  int term_seq_ = 0;
+  scoped_refptr<ui::SelectFileDialog> dialog_;
+  Reply pick_reply_;
+  base::WeakPtrFactory<WorkbenchHandler> weak_factory_{this};
+};
