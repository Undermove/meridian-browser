+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/terminal.h"
+
+#include "base/functional/callback_helpers.h"
+#include "base/run_loop.h"
+#include "base/test/task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::workbench {
+namespace {
+
+TEST(TerminalTest, Utf8IsNeverSplit) {
+  std::string buffer = "ok \xd0\x9f\xd1";  // "ok П" and half of "р"
+  EXPECT_EQ(TakeCompleteUtf8(buffer), "ok \xd0\x9f");
+  EXPECT_EQ(buffer, "\xd1");
+  buffer += "\x80!";
+  EXPECT_EQ(TakeCompleteUtf8(buffer), "\xd1\x80!");
+  EXPECT_EQ(buffer, "");
+}
+
+TEST(TerminalTest, RunsOnAPtyWithItsSizeAndEnvironment) {
+  base::test::TaskEnvironment env;
+  Terminal::Spec spec;
+  spec.argv = {"/bin/sh", "-c",
+               "stty size; echo \"[$GREETING]\"; test -t 0 && echo tty; "
+               "read line; echo got:$line"};
+  spec.env = {{"GREETING", "hello"}, {"PATH", "/usr/bin:/bin"}};
+  spec.cols = 100;
+  spec.rows = 30;
+  std::string out;
+  int exit_code = -2;
+  base::RunLoop exited;
+  std::unique_ptr<Terminal> term = Terminal::Start(
+      spec,
+      base::BindRepeating([](std::string* out, std::string d) { *out += d; },
+                          &out),
+      base::BindOnce(
+          [](int* code, base::OnceClosure quit, int c, int) {
+            *code = c;
+            std::move(quit).Run();
+          },
+          &exit_code, exited.QuitClosure()));
+  ASSERT_TRUE(term);
+  term->Write("typed\n");
+  exited.Run();
+  EXPECT_NE(out.find("30 100"), std::string::npos) << out;
+  EXPECT_NE(out.find("[hello]"), std::string::npos);
+  EXPECT_NE(out.find("tty"), std::string::npos);
+  EXPECT_NE(out.find("got:typed"), std::string::npos);
+  EXPECT_EQ(exit_code, 0);
+}
+
+TEST(TerminalTest, KillEndsTheProcessGroup) {
+  base::test::TaskEnvironment env;
+  Terminal::Spec spec;
+  // It ignores SIGHUP (once it says so), so it takes the SIGKILL.
+  spec.argv = {"/bin/sh", "-c", "trap '' HUP; echo ready; sleep 60 & sleep 60"};
+  int signal = 0;
+  base::RunLoop ready;
+  base::RunLoop exited;
+  std::string out;
+  std::unique_ptr<Terminal> term = Terminal::Start(
+      spec,
+      base::BindRepeating(
+          [](std::string* out, base::RepeatingClosure ready, std::string d) {
+            *out += d;
+            if (out->find("ready") != std::string::npos) {
+              ready.Run();
+            }
+          },
+          &out, ready.QuitClosure()),
+      base::BindOnce(
+          [](int* sig, base::OnceClosure quit, int, int s) {
+            *sig = s;
+            std::move(quit).Run();
+          },
+          &signal, exited.QuitClosure()));
+  ASSERT_TRUE(term);
+  ready.Run();
+  term->Kill();
+  exited.Run();
+  EXPECT_EQ(signal, SIGKILL);
+}
+
+}  // namespace
+}  // namespace meridian::workbench
