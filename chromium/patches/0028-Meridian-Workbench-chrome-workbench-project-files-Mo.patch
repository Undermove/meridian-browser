index 0000000000..610e96f128
--- /dev/null
+++ b/chrome/browser/meridian/workbench/project_fs.cc
@@ -0,0 +1,383 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/project_fs.h"
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <set>
+
+#include "base/files/file.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#include "base/i18n/string_compare.h"
+#include "base/no_destructor.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/types/expected_macros.h"
+#include "build/build_config.h"
+#include "third_party/icu/source/i18n/unicode/coll.h"
+
+
+namespace meridian::workbench {
+
+namespace {
+
+constexpr int64_t kMaxOpenBytes = 5 * 1024 * 1024;
+constexpr size_t kMaxWriteBytes = 20 * 1024 * 1024;
+constexpr size_t kMaxEntries = 5000;
+
+const std::set<std::string>& HiddenByDefault() {
+  static const base::NoDestructor<std::set<std::string>> hidden(
+      std::set<std::string>{".git", "node_modules", ".DS_Store", ".hg", ".svn",
+                            "Thumbs.db"});
+  return *hidden;
+}
+
+std::optional<base::FilePath> RealPath(const base::FilePath& path) {
+  base::FilePath real = base::MakeAbsoluteFilePath(path);
+  if (real.empty()) {
+    return std::nullopt;
+  }
+  return real;
+}
+
+double MtimeMs(const base::File::Info& info) {
+  return info.last_modified.InMillisecondsFSinceUnixEpoch();
+}
+
+}  // namespace
+
+ProjectFs::ProjectFs(base::FilePath root) : root_(std::move(root)) {}
+
+// static
+std::optional<ProjectFs> ProjectFs::Open(const base::FilePath& root) {
+  std::optional<base::FilePath> real = RealPath(root);
+  if (!real || !base::DirectoryExists(*real)) {
+    return std::nullopt;
+  }
+  return ProjectFs(*real);
+}
+
+std::string ProjectFs::name() const {
+  std::string base = root_.BaseName().value();
+  return base.empty() ? root_.value() : base;
+}
+
+bool ProjectFs::Inside(const base::FilePath& abs) const {
+  return abs == root_ || root_.IsParent(abs);
+}
+
+base::expected<base::FilePath, std::string> ProjectFs::Resolve(
+    const std::string& rel,
+    bool must_exist) const {
+  if (rel.size() > 4096 || rel.find('\0') != std::string::npos) {
+    return base::unexpected("invalid path");
+  }
+  base::FilePath relative(rel.empty() ? "." : rel);
+  if (relative.IsAbsolute()) {
+    return base::unexpected("path must be relative to the project");
+  }
+  // Lexically: no ".." anywhere, so the joined path stays under the root.
+  for (const std::string& part : relative.GetComponents()) {
+    if (part == "..") {
+      return base::unexpected("path is outside the project");
+    }
+  }
+  base::FilePath abs = root_.Append(relative).StripTrailingSeparators();
+  if (abs.BaseName().value() == ".") {
+    abs = abs.DirName();
+  }
+  if (!Inside(abs)) {
+    return base::unexpected("path is outside the project");
+  }
+  if (must_exist) {
+    std::optional<base::FilePath> real = RealPath(abs);
+    if (!real) {
+      return base::unexpected("ENOENT: no such file or folder");
+    }
+    if (!Inside(*real)) {
+      return base::unexpected("path leads outside the project (symlink)");
+    }
+    return abs;
+  }
+  std::string base = abs.BaseName().value();
+  if (base.empty() || base == "." || base == ".." || abs == root_) {
+    return base::unexpected("invalid name");
+  }
+  std::optional<base::FilePath> parent = RealPath(abs.DirName());
+  if (!parent || !Inside(*parent)) {
+    return base::unexpected("path leads outside the project (symlink)");
+  }
+  return abs;
+}
+
+std::string ProjectFs::Rel(const base::FilePath& abs) const {
+  if (abs == root_) {
+    return std::string();
+  }
+  base::FilePath rel;
+  if (!root_.AppendRelativePath(abs, &rel)) {
+    return abs.value();
+  }
+  return rel.value();
+}
+
+base::expected<base::DictValue, std::string> ProjectFs::List(
+    const std::string& rel,
+    bool show_hidden) const {
+  ASSIGN_OR_RETURN(base::FilePath dir, Resolve(rel, true));
+  struct Entry {
+    std::string name;
+    base::DictValue value;
+    bool is_dir;
+  };
+  std::vector<Entry> entries;
+  size_t seen = 0;
+  base::FileEnumerator e(
+      dir, false,
+      base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES |
+          base::FileEnumerator::SHOW_SYM_LINKS);
+  for (base::FilePath path = e.Next(); !path.empty(); path = e.Next()) {
+    if (++seen > kMaxEntries) {
+      break;
+    }
+    std::string name = path.BaseName().value();
+    bool hidden = HiddenByDefault().contains(name);
+    if (hidden && !show_hidden) {
+      continue;
+    }
+    struct stat lst;
+    std::string type = "other";
+    bool link = false;
+    bool outside = false;
+    if (lstat(path.value().c_str(), &lst) == 0) {
+      link = S_ISLNK(lst.st_mode);
+      type = S_ISDIR(lst.st_mode) ? "dir" : S_ISREG(lst.st_mode) ? "file" : "other";
+    }
+    if (link) {
+      std::optional<base::FilePath> real = RealPath(path);
+      if (!real) {
+        type = "broken";
+      } else if (!Inside(*real)) {
+        outside = true;
+      } else {
+        type = base::DirectoryExists(*real) ? "dir" : "file";
+      }
+    }
+    base::DictValue v;
+    v.Set("name", name);
+    v.Set("path", Rel(path));
+    v.Set("type", type);
+    if (link) {
+      v.Set("link", true);
+    }
+    if (outside) {
+      v.Set("outside", true);
+    }
+    if (hidden) {
+      v.Set("hidden", true);
+    }
+    entries.push_back({name, std::move(v), type == "dir"});
+  }
+  UErrorCode status = U_ZERO_ERROR;
+  std::unique_ptr<icu::Collator> collator(icu::Collator::createInstance(status));
+  if (U_SUCCESS(status)) {
+    collator->setStrength(icu::Collator::SECONDARY);
+    collator->setAttribute(UCOL_NUMERIC_COLLATION, UCOL_ON, status);
+  }
+  std::ranges::stable_sort(entries, [&](const Entry& a, const Entry& b) {
+    if (a.is_dir != b.is_dir) {
+      return a.is_dir;
+    }
+    if (!U_SUCCESS(status)) {
+      return a.name < b.name;
+    }
+    return base::i18n::CompareString16WithCollator(
+               *collator, base::UTF8ToUTF16(a.name),
+               base::UTF8ToUTF16(b.name)) == UCOL_LESS;
+  });
+  base::ListValue list;
+  for (Entry& entry : entries) {
+    list.Append(std::move(entry.value));
+  }
+  return base::DictValue()
+      .Set("path", rel)
+      .Set("entries", std::move(list))
+      .Set("truncated", seen > kMaxEntries);
+}
+
+base::expected<base::DictValue, std::string> ProjectFs::Read(
+    const std::string& rel) const {
+  ASSIGN_OR_RETURN(base::FilePath abs, Resolve(rel, true));
+  base::File::Info info;
+  if (!base::GetFileInfo(abs, &info) || info.is_directory) {
+    return base::unexpected("not a file");
+  }
+  base::DictValue out;
+  out.Set("path", rel);
+  out.Set("size", static_cast<double>(info.size));
+  out.Set("mtimeMs", MtimeMs(info));
+  if (info.size > kMaxOpenBytes) {
+    out.Set("tooLarge", true);
+    return out;
+  }
+  std::string content;
+  if (!base::ReadFileToString(abs, &content)) {
+    return base::unexpected("couldn’t read the file");
+  }
+  // NUL bytes in the first 8 KB: binary.
+  if (std::string_view(content).substr(0, 8192).find('\0') !=
+      std::string_view::npos) {
+    out.Set("binary", true);
+    return out;
+  }
+  if (!base::IsStringUTF8(content)) {
+    // Shown with replacement characters, like Node's toString('utf8').
+    std::u16string wide;
+    base::UTF8ToUTF16(content.data(), content.size(), &wide);
+    content = base::UTF16ToUTF8(wide);
+  }
+  out.Set("content", content);
+  return out;
+}
+
+base::DictValue ProjectFs::Stat(const std::string& rel) const {
+  base::expected<base::FilePath, std::string> abs = Resolve(rel, true);
+  base::File::Info info;
+  if (!abs.has_value() || !base::GetFileInfo(*abs, &info)) {
+    return base::DictValue().Set("exists", false);
+  }
+  return base::DictValue()
+      .Set("exists", true)
+      .Set("mtimeMs", MtimeMs(info))
+      .Set("size", static_cast<double>(info.size))
+      .Set("dir", info.is_directory);
+}
+
+base::expected<base::DictValue, std::string> ProjectFs::Write(
+    const std::string& rel,
+    const std::string& content) const {
+  if (content.size() > kMaxWriteBytes) {
+    return base::unexpected("file is too large");
+  }
+  base::expected<base::FilePath, std::string> resolved = Resolve(rel, true);
+  if (!resolved.has_value()) {
+    resolved = Resolve(rel, false);
+  }
+  if (!resolved.has_value()) {
+    return base::unexpected(resolved.error());
+  }
+  // Pin the target to its real path; open without following a symlink at the
+  // last component and without truncating, verify, then write.
+  base::FilePath target;
+  bool exists = true;
+  if (std::optional<base::FilePath> real = RealPath(*resolved)) {
+    target = *real;
+  } else {
+    exists = false;
+    std::optional<base::FilePath> parent = RealPath(resolved->DirName());
+    if (!parent) {
+      return base::unexpected("the folder doesn’t exist");
+    }
+    target = parent->Append(resolved->BaseName());
+  }
+  if (!Inside(target)) {
+    return base::unexpected("path leads outside the project (symlink)");
+  }
+  int flags = O_WRONLY | O_NOFOLLOW | O_CLOEXEC | (exists ? 0 : O_CREAT | O_EXCL);
+  base::ScopedFD fd(HANDLE_EINTR(open(target.value().c_str(), flags, 0666)));
+  if (!fd.is_valid()) {
+    if (errno == ELOOP || errno == EMLINK) {
+      return base::unexpected("path leads outside the project (symlink)");
+    }
+    if (errno == EEXIST) {
+      return base::unexpected("the file appeared while saving — try again");
+    }
+    return base::unexpected("couldn’t open the file for writing");
+  }
+  struct stat opened;
+  if (fstat(fd.get(), &opened) != 0 || !S_ISREG(opened.st_mode)) {
+    return base::unexpected("not a file");
+  }
+  std::optional<base::FilePath> real_now = RealPath(target);
+  struct stat named;
+  if (!real_now || !Inside(*real_now) ||
+      stat(real_now->value().c_str(), &named) != 0 ||
+      named.st_ino != opened.st_ino || named.st_dev != opened.st_dev) {
+    return base::unexpected(
+        "the file moved while saving (symlink race) — nothing was written");
+  }
+  if (HANDLE_EINTR(ftruncate(fd.get(), 0)) != 0 ||
+      !base::WriteFileDescriptor(fd.get(), content)) {
+    return base::unexpected("couldn’t write the file");
+  }
+  struct stat after;
+  fstat(fd.get(), &after);
+  base::File::Info info;
+  info.FromStat(after);
+  return base::DictValue()
+      .Set("path", rel)
+      .Set("mtimeMs", MtimeMs(info))
+      .Set("size", static_cast<double>(info.size));
+}
+
+base::expected<base::DictValue, std::string> ProjectFs::Create(
+    const std::string& rel,
+    bool dir) const {
+  ASSIGN_OR_RETURN(base::FilePath abs, Resolve(rel, false));
+  if (dir) {
+    if (mkdir(abs.value().c_str(), 0777) != 0) {
+      return base::unexpected(errno == EEXIST ? "a file with that name already exists"
+                                              : "couldn’t create the folder");
+    }
+  } else {
+    // Never clobber an existing file.
+    base::ScopedFD fd(HANDLE_EINTR(open(abs.value().c_str(),
+                                        O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC,
+                                        0666)));
+    if (!fd.is_valid()) {
+      return base::unexpected(errno == EEXIST ? "a file with that name already exists"
+                                              : "couldn’t create the file");
+    }
+  }
+  return base::DictValue().Set("path", Rel(abs));
+}
+
+base::expected<base::DictValue, std::string> ProjectFs::Rename(
+    const std::string& from,
+    const std::string& to) const {
+  ASSIGN_OR_RETURN(base::FilePath src, Resolve(from, true));
+  if (src == root_) {
+    return base::unexpected("can’t rename the project folder");
+  }
+  ASSIGN_OR_RETURN(base::FilePath dst, Resolve(to, false));
+  struct stat st;
+  if (lstat(dst.value().c_str(), &st) == 0) {
+    return base::unexpected("a file with that name already exists");
+  }
+  if (rename(src.value().c_str(), dst.value().c_str()) != 0) {
+    return base::unexpected("couldn’t rename");
+  }
+  return base::DictValue().Set("path", Rel(dst));
+}
+
+base::expected<bool, std::string> ProjectFs::Remove(
+    const std::string& rel) const {
+  ASSIGN_OR_RETURN(base::FilePath abs, Resolve(rel, true));
+  if (abs == root_) {
+    return base::unexpected("can’t delete the project folder");
+  }
+  if (!MoveToTrash(abs)) {
+    return base::unexpected("couldn’t move it to the Trash");
+  }
+  return true;
+}
+
+}  // namespace meridian::workbench
