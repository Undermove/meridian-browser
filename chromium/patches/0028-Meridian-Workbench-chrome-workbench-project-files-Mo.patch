@@ -0,0 +1,271 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/terminal.h"
+
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <sys/ioctl.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <termios.h>
+
+#include <array>
+#include <atomic>
+
+#include "base/containers/span.h"
+#include "base/files/file_util.h"
+#include "base/memory/ptr_util.h"
+#include "base/memory/ref_counted.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/process/process.h"
+#include "base/synchronization/lock.h"
+#include "base/strings/string_view_util.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+
+// <util.h> (macOS) is shadowed by other util.h files on the include path.
+extern "C" int openpty(int* amaster,
+                       int* aslave,
+                       char* name,
+                       struct termios* termp,
+                       struct winsize* winp);
+
+namespace meridian::workbench {
+
+namespace {
+
+int Clamp(int v, int lo, int hi) {
+  return v < lo ? lo : v > hi ? hi : v;
+}
+
+}  // namespace
+
+std::string TakeCompleteUtf8(std::string& buffer) {
+  // Look back at most 3 bytes for the start of an incomplete character.
+  size_t end = buffer.size();
+  for (size_t back = 1; back <= 3 && back <= buffer.size(); ++back) {
+    unsigned char c = buffer[buffer.size() - back];
+    if ((c & 0xc0) == 0x80) {
+      continue;  // a continuation byte
+    }
+    size_t need = (c & 0xe0) == 0xc0   ? 2
+                  : (c & 0xf0) == 0xe0 ? 3
+                  : (c & 0xf8) == 0xf0 ? 4
+                                       : 1;
+    if (need > back) {
+      end = buffer.size() - back;
+    }
+    break;
+  }
+  std::string out = buffer.substr(0, end);
+  buffer.erase(0, end);
+  return out;
+}
+
+// Reads the pty until the child closes it, then reaps the child. Lives on a
+// blocking thread-pool task; the terminal can be gone by then.
+class Terminal::Io : public base::RefCountedThreadSafe<Terminal::Io> {
+ public:
+  Io(int pid, int master, DataCallback on_data, ExitCallback on_exit)
+      : pid_(pid),
+        master_(master),
+        on_data_(std::move(on_data)),
+        on_exit_(std::move(on_exit)) {}
+
+  void Stop() { stop_ = true; }
+
+  // Signals the child's process group while it hasn't been reaped (so the
+  // id can't belong to another process yet).
+  void Signal(int sig) {
+    base::AutoLock hold(lock_);
+    if (!exited_) {
+      kill(-pid_, sig);
+      kill(pid_, sig);
+    }
+  }
+
+  void Run() {
+    base::ScopedBlockingCall blocking(FROM_HERE,
+                                      base::BlockingType::WILL_BLOCK);
+    std::array<char, 65536> chunk;
+    std::string pending;
+    while (!stop_) {
+      pollfd fd = {master_, POLLIN, 0};
+      int ready = HANDLE_EINTR(poll(&fd, 1, 200));
+      if (ready <= 0) {
+        continue;
+      }
+      ssize_t n = HANDLE_EINTR(read(master_, chunk.data(), chunk.size()));
+      if (n <= 0) {
+        // EIO: the child side is closed.
+        if (n < 0 && errno == EAGAIN) {
+          continue;
+        }
+        break;
+      }
+      pending.append(base::as_string_view(
+          base::span(chunk).first(static_cast<size_t>(n))));
+      std::string text = TakeCompleteUtf8(pending);
+      if (!text.empty()) {
+        on_data_.Run(std::move(text));
+      }
+    }
+    // Wait for the exit without reaping, mark it, then reap.
+    siginfo_t info = {};
+    HANDLE_EINTR(waitid(P_PID, static_cast<id_t>(pid_), &info,
+                        WEXITED | WNOWAIT));
+    {
+      base::AutoLock hold(lock_);
+      exited_ = true;
+    }
+    int status = 0;
+    int code = -1;
+    int signal = 0;
+    if (HANDLE_EINTR(waitpid(pid_, &status, 0)) == pid_) {
+      if (WIFEXITED(status)) {
+        code = WEXITSTATUS(status);
+      } else if (WIFSIGNALED(status)) {
+        signal = WTERMSIG(status);
+      }
+    }
+    close(master_);
+    std::move(on_exit_).Run(code, signal);
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<Io>;
+  ~Io() = default;
+
+  const int pid_;
+  const int master_;
+  std::atomic<bool> stop_{false};
+  base::Lock lock_;
+  bool exited_ GUARDED_BY(lock_) = false;
+  DataCallback on_data_;
+  ExitCallback on_exit_;
+};
+
+// static
+std::unique_ptr<Terminal> Terminal::Start(const Spec& spec,
+                                          DataCallback on_data,
+                                          ExitCallback on_exit) {
+  if (spec.argv.empty()) {
+    return nullptr;
+  }
+  winsize size = {};
+  size.ws_col = static_cast<unsigned short>(Clamp(spec.cols, 2, 500));
+  size.ws_row = static_cast<unsigned short>(Clamp(spec.rows, 2, 300));
+  int master = -1;
+  int slave = -1;
+  if (openpty(&master, &slave, nullptr, nullptr, &size) != 0) {
+    return nullptr;
+  }
+  fcntl(master, F_SETFD, FD_CLOEXEC);
+  // Everything the child needs is prepared before fork: after it, only
+  // async-signal-safe calls until exec.
+  std::vector<std::string> env_strings;
+  for (const auto& [name, value] : spec.env) {
+    env_strings.push_back(name + "=" + value);
+  }
+  std::vector<char*> envp;
+  for (std::string& s : env_strings) {
+    envp.push_back(s.data());
+  }
+  envp.push_back(nullptr);
+  std::vector<std::string> args = spec.argv;
+  std::vector<char*> argv;
+  for (std::string& s : args) {
+    argv.push_back(s.data());
+  }
+  argv.push_back(nullptr);
+  std::string cwd = spec.cwd;
+  long max_fd = sysconf(_SC_OPEN_MAX);
+  if (max_fd < 0 || max_fd > 65536) {
+    max_fd = 65536;
+  }
+
+  pid_t pid = fork();
+  if (pid < 0) {
+    close(master);
+    close(slave);
+    return nullptr;
+  }
+  if (pid == 0) {
+    setsid();
+    ioctl(slave, TIOCSCTTY, 0);
+    dup2(slave, STDIN_FILENO);
+    dup2(slave, STDOUT_FILENO);
+    dup2(slave, STDERR_FILENO);
+    for (long fd = 3; fd < max_fd; ++fd) {
+      close(static_cast<int>(fd));
+    }
+    sigset_t none;
+    sigemptyset(&none);
+    sigprocmask(SIG_SETMASK, &none, nullptr);
+    struct sigaction dfl = {};
+    dfl.sa_handler = SIG_DFL;
+    for (int s = 1; s < NSIG; ++s) {
+      sigaction(s, &dfl, nullptr);
+    }
+    if (!cwd.empty()) {
+      chdir(cwd.c_str());
+    }
+    execve(argv[0], argv.data(), envp.data());
+    _exit(127);
+  }
+  close(slave);
+  auto terminal = base::WrapUnique(new Terminal(pid, master));
+  terminal->io_ = base::MakeRefCounted<Io>(pid, master, std::move(on_data),
+                                           std::move(on_exit));
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::WithBaseSyncPrimitives(),
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&Io::Run, terminal->io_));
+  return terminal;
+}
+
+Terminal::Terminal(int pid, int master)
+    : pid_(pid),
+      master_(master),
+      writer_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(),
+           base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN})) {}
+
+Terminal::~Terminal() {
+  Kill();
+}
+
+void Terminal::Write(std::string data) {
+  writer_->PostTask(FROM_HERE, base::BindOnce(
+                                   [](int fd, std::string data) {
+                                     base::WriteFileDescriptor(fd, data);
+                                   },
+                                   master_, std::move(data)));
+}
+
+void Terminal::Resize(int cols, int rows) {
+  winsize size = {};
+  size.ws_col = static_cast<unsigned short>(Clamp(cols, 2, 500));
+  size.ws_row = static_cast<unsigned short>(Clamp(rows, 2, 300));
+  ioctl(master_, TIOCSWINSZ, &size);
+}
+
+void Terminal::Kill() {
+  if (pid_ <= 0) {
+    return;
+  }
+  pid_ = -1;
+  io_->Stop();
+  io_->Signal(SIGHUP);
+  // Whatever ignores SIGHUP goes a moment later.
+  base::ThreadPool::PostDelayedTask(
+      FROM_HERE, {base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&Io::Signal, io_, SIGKILL), base::Milliseconds(1500));
+}
+
+}  // namespace meridian::workbench
