+
+namespace meridian::workbench {
+
+namespace {
+
+struct Agent {
+  const char* id;
+  const char* label;
+  const char* bin;
+  const char* install;
+  // Gets Meridian's browser tools for the session.
+  bool mcp;
+  // Listed once installed.
+  bool extra;
+};
+
+const std::vector<Agent>& Agents() {
+  static const base::NoDestructor<std::vector<Agent>> agents(
+      std::vector<Agent>{
+          {"claude", "Claude Code", "claude",
+           "npm install -g @anthropic-ai/claude-code", true, false},
+          {"codex", "Codex", "codex", "npm install -g @openai/codex", true,
+           false},
+          {"gemini", "Gemini", "gemini", "npm install -g @google/gemini-cli",
+           false, false},
+          {"copilot", "Copilot", "copilot", "npm install -g @github/copilot",
+           true, true},
+          {"opencode", "OpenCode", "opencode",
+           "curl -fsSL https://opencode.ai/install | bash", true, true},
+          {"cursor", "Cursor", "cursor-agent",
+           "curl https://cursor.com/install -fsS | bash", false, true},
+          {"qwen", "Qwen Code", "qwen",
+           "npm install -g @qwen-code/qwen-code@latest", false, true},
+          {"amp", "Amp", "amp", "npm install -g @sourcegraph/amp", false,
+           true},
+          {"goose", "Goose", "goose", "brew install block-goose-cli", false,
+           true},
+          {"droid", "Droid", "droid",
+           "curl -fsSL https://app.factory.ai/cli | sh", false, true},
+      });
+  return *agents;
+}
+
+// JSON string escaping is valid TOML basic-string escaping.
+std::string Toml(const std::string& s) {
+  return base::WriteJson(base::Value(s)).value_or("\"\"");
+}
+
+}  // namespace
+
+std::string FindExecutable(const std::string& name,
+                           const std::string& search_path) {
+  for (const std::string& dir : base::SplitString(
+           search_path, ":", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    base::FilePath candidate = base::FilePath(dir).Append(name);
+    if (!base::DirectoryExists(candidate) &&
+        access(candidate.value().c_str(), X_OK) == 0) {
+      return candidate.value();
+    }
+  }
+  return std::string();
+}
+
+base::DictValue DetectAgents(const std::string& search_path) {
+  base::DictValue out;
+  for (const Agent& a : Agents()) {
+    std::string path = FindExecutable(a.bin, search_path);
+    base::DictValue agent;
+    agent.Set("id", a.id);
+    agent.Set("label", a.label);
+    agent.Set("installed", !path.empty());
+    agent.Set("path", path.empty() ? base::Value() : base::Value(path));
+    agent.Set("install", a.install);
+    agent.Set("mcp", a.mcp);
+    agent.Set("extra", a.extra);
+    out.Set(a.id, std::move(agent));
+  }
+  return out;
+}
+
+base::expected<LaunchSpec, std::string> MakeLaunchSpec(
+    const std::string& kind,
+    const std::string& search_path,
+    const std::string& shell,
+    const McpBridge& bridge) {
+  LaunchSpec spec;
+  if (kind == "shell") {
+    spec.title = base::FilePath(shell).BaseName().value();
+    spec.argv = {shell, "-l"};
+    return spec;
+  }
+  const Agent* agent = nullptr;
+  for (const Agent& a : Agents()) {
+    if (kind == a.id) {
+      agent = &a;
+    }
+  }
+  if (!agent) {
+    return base::unexpected("unknown agent");
+  }
+  std::string bin = FindExecutable(agent->bin, search_path);
+  if (bin.empty()) {
+    return base::unexpected(std::string(agent->label) +
+                            " is not installed. Install it with: " +
+                            agent->install);
+  }
+  spec.title = agent->label;
+  spec.argv = {bin};
+  base::FilePath dir;
+  auto private_file = [&](const std::string& prefix,
+                          const base::DictValue& content)
+      -> std::optional<base::FilePath> {
+    if (dir.empty()) {
+      if (!base::CreateNewTempDirectory("meridian-mcp-", &dir)) {
+        return std::nullopt;
+      }
+      base::SetPosixFilePermissions(dir, 0700);
+      spec.cleanup.push_back(dir);
+    }
+    base::FilePath file = dir.Append(
+        prefix + "-" + base::HexEncodeLower(base::RandBytesAsVector(4)) +
+        ".json");
+    if (!base::WriteFile(file, base::WriteJsonWithOptions(
+                                   content, base::JSONWriter::OPTIONS_PRETTY_PRINT)
+                                   .value_or("{}"))) {
+      return std::nullopt;
+    }
+    base::SetPosixFilePermissions(file, 0600);
+    return file;
+  };
+  base::ListValue bridge_args;
+  for (const std::string& a : bridge.args) {
+    bridge_args.Append(a);
+  }
+  if (agent->mcp) {
+    spec.browser_tools = true;
+    if (kind == "claude") {
+      std::optional<base::FilePath> file = private_file(
+          "mcp", base::DictValue().Set(
+                     "mcpServers",
+                     base::DictValue().Set(
+                         "meridian", base::DictValue()
+                                         .Set("command", bridge.command)
+                                         .Set("args", bridge_args.Clone()))));
+      if (file) {
+        // A variadic flag: keep it last.
+        spec.argv.push_back("--mcp-config");
+        spec.argv.push_back(file->value());
+      }
+    } else if (kind == "codex") {
+      std::string args;
+      for (const std::string& a : bridge.args) {
+        args += (args.empty() ? "" : ", ") + Toml(a);
+      }
+      spec.argv.insert(spec.argv.end(),
+                       {"-c", "mcp_servers.meridian.command=" +
+                                  Toml(bridge.command),
+                        "-c", "mcp_servers.meridian.args=[" + args + "]"});
+    } else if (kind == "copilot") {
+      std::optional<base::FilePath> file = private_file(
+          "mcp",
+          base::DictValue().Set(
+              "mcpServers",
+              base::DictValue().Set(
+                  "meridian",
+                  base::DictValue()
+                      .Set("type", "local")
+                      .Set("command", bridge.command)
+                      .Set("args", bridge_args.Clone())
+                      .Set("tools", base::ListValue().Append("*")))));
+      if (file) {
+        spec.argv.push_back("--additional-mcp-config");
+        spec.argv.push_back("@" + file->value());
+      }
+    } else if (kind == "opencode") {
+      base::ListValue command;
+      command.Append(bridge.command);
+      for (const std::string& a : bridge.args) {
+        command.Append(a);
+      }
+      std::optional<base::FilePath> file = private_file(
+          "opencode",
+          base::DictValue()
+              .Set("$schema", "https://opencode.ai/config.json")
+              .Set("mcp", base::DictValue().Set(
+                              "meridian", base::DictValue()
+                                              .Set("type", "local")
+                                              .Set("command", std::move(command))
+                                              .Set("enabled", true))));
+      if (file) {
+        spec.env["OPENCODE_CONFIG"] = file->value();
+      }
+    }
+  } else {
+    spec.notes.push_back(std::string(agent->label) +
+                         " is started without Meridian browser tools (it only "
+                         "reads MCP servers from its settings files).");
+  }
+  return spec;
+}
+
+}  // namespace meridian::workbench
