+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_TERMINAL_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_TERMINAL_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+
+namespace meridian::workbench {
+
+// A terminal: a process on a pseudo-terminal (shell or coding agent). A pty is
+// arbitrary code execution, so terminals are only reachable through the
+// workbench page's handler, and every terminal dies with the page that made
+// it. The child gets its own session and process group, nothing but the pty
+// on fds 0-2, default signal handling, and exactly the environment given.
+class Terminal {
+ public:
+  struct Spec {
+    // argv[0] is an absolute path.
+    std::vector<std::string> argv;
+    std::map<std::string, std::string> env;
+    std::string cwd;
+    int cols = 80;
+    int rows = 24;
+  };
+
+  // Output (valid UTF-8, never split inside a character) and the exit.
+  using DataCallback = base::RepeatingCallback<void(std::string)>;
+  using ExitCallback = base::OnceCallback<void(int code, int signal)>;
+
+  // nullptr if the process couldn't start.
+  static std::unique_ptr<Terminal> Start(const Spec& spec,
+                                         DataCallback on_data,
+                                         ExitCallback on_exit);
+  Terminal(const Terminal&) = delete;
+  Terminal& operator=(const Terminal&) = delete;
+  // Kills the process group if it still runs.
+  ~Terminal();
+
+  void Write(std::string data);
+  void Resize(int cols, int rows);
+  // SIGHUP to the process group, SIGKILL a moment later if it stays.
+  void Kill();
+  int pid() const { return pid_; }
+
+ private:
+  class Io;
+  Terminal(int pid, int master);
+
+  int pid_;
+  int master_;
+  scoped_refptr<Io> io_;
+  scoped_refptr<base::SequencedTaskRunner> writer_;
+};
+
+// The longest prefix of `buffer` that ends on a UTF-8 character boundary; the
+// rest stays in `buffer` for the next read.
+std::string TakeCompleteUtf8(std::string& buffer);
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_TERMINAL_H_
