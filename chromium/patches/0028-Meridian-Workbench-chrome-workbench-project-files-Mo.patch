+
+void WorkbenchHandler::HandleInvoke(const base::ListValue& args) {
+  AllowJavascript();
+  if (args.size() < 3 || !args[0].is_string() || !args[1].is_string() ||
+      !args[2].is_list()) {
+    return;
+  }
+  Dispatch(args[1].GetString(), args[2].GetList(),
+           base::BindOnce(&WorkbenchHandler::Respond,
+                          weak_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void WorkbenchHandler::Respond(std::string callback_id, Result result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  if (result.has_value()) {
+    ResolveJavascriptCallback(base::Value(callback_id), *result);
+  } else {
+    RejectJavascriptCallback(base::Value(callback_id),
+                             base::Value(result.error()));
+  }
+}
+
+void WorkbenchHandler::Emit(const std::string& channel, base::Value payload) {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener(channel, payload);
+  }
+}
+
+void WorkbenchHandler::HandleSend(const base::ListValue& args) {
+  AllowJavascript();
+  if (args.size() < 2 || !args[0].is_string() || !args[1].is_list()) {
+    return;
+  }
+  const std::string& method = args[0].GetString();
+  const base::ListValue& params = args[1].GetList();
+  if (method == "ptyWrite") {
+    auto it = terms_.find(StringParam(params, 0));
+    std::string data = StringParam(params, 1);
+    if (it != terms_.end() && it->second.terminal && data.size() <= 1000000) {
+      it->second.terminal->Write(std::move(data));
+    }
+  } else if (method == "ptyResize") {
+    auto it = terms_.find(StringParam(params, 0));
+    if (it != terms_.end() && it->second.terminal && params.size() >= 3 &&
+        params[1].is_int() && params[2].is_int()) {
+      it->second.terminal->Resize(params[1].GetInt(), params[2].GetInt());
+    }
+  } else if (method == "toHost" && !params.empty() && params[0].is_dict()) {
+    ToHost(params[0].GetDict());
+  }
+}
+
+void WorkbenchHandler::Dispatch(const std::string& method,
+                                const base::ListValue& params,
+                                Reply reply) {
+  std::string a = StringParam(params, 0);
+  std::string b = StringParam(params, 1);
+  if (method == "info") {
+    return Info(std::move(reply));
+  }
+  if (method == "pickProject") {
+    const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+    if (cl->HasSwitch("meridian-test-project")) {
+      return OpenProject(cl->GetSwitchValuePath("meridian-test-project"),
+                         std::move(reply));
+    }
+    if (dialog_) {
+      return std::move(reply).Run(base::Value());
+    }
+    pick_reply_ = std::move(reply);
+    dialog_ = ui::SelectFileDialog::Create(
+        this, std::make_unique<ChromeSelectFilePolicy>(
+                  web_ui()->GetWebContents()));
+    dialog_->SelectFile(ui::SelectFileDialog::SELECT_FOLDER,
+                        u"Open a project folder", base::FilePath(), nullptr, 0,
+                        base::FilePath::StringType(),
+                        web_ui()->GetWebContents()->GetTopLevelNativeWindow());
+    return;
+  }
+  if (method == "openProject") {
+    // Only folders the person picked before in the native dialog.
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE, base::BindOnce(&LoadStore, StorePath()),
+        base::BindOnce(
+            [](base::WeakPtr<WorkbenchHandler> self, std::string path,
+               Reply reply, base::DictValue store) {
+              if (!self) {
+                return;
+              }
+              for (const base::Value& r : *store.FindList("recents")) {
+                const std::string* p = r.GetDict().FindString("path");
+                if (p && *p == path) {
+                  return self->OpenProject(base::FilePath(path),
+                                           std::move(reply));
+                }
+              }
+              std::move(reply).Run(base::unexpected(
+                  "Pick this folder with “Open folder…” first"));
+            },
+            weak_factory_.GetWeakPtr(), a, std::move(reply)));
+    return;
+  }
+  if (method == "forgetRecent") {
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::FilePath file, std::string path) -> Result {
+              base::DictValue store = LoadStore(file);
+              store.FindList("recents")->EraseIf([&](const base::Value& r) {
+                const std::string* p = r.GetDict().FindString("path");
+                return p && *p == path;
+              });
+              SaveStore(file, store);
+              return base::Value(LiveRecents(store));
+            },
+            StorePath(), a),
+        std::move(reply));
+    return;
+  }
+  if (method == "closeProject") {
+    CloseProject();
+    return std::move(reply).Run(base::Value(true));
+  }
+  if (method == "setPreviewUrl") {
+    if (!project_ || a.size() > 2000 ||
+        !RE2::FullMatch(a, "(?i)https?://[^\\s]+")) {
+      return std::move(reply).Run(
+          base::unexpected("Preview must be an http(s) URL"));
+    }
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::FilePath file, std::string root, std::string url) -> Result {
+              base::DictValue store = LoadStore(file);
+              store.FindDict("previews")->Set(root, url);
+              SaveStore(file, store);
+              return base::Value(true);
+            },
+            StorePath(), project_->root().value(), a),
+        std::move(reply));
+    return;
+  }
+  bool hidden = params.size() > 1 && params[1].is_dict() &&
+                params[1].GetDict().FindBool("showHidden").value_or(false);
+  if (method == "list") {
+    return OnProject(base::BindOnce(
+                         [](std::string rel, bool hidden, const ProjectFs& p) {
+                           return Wrap(p.List(rel, hidden));
+                         },
+                         a, hidden),
+                     std::move(reply));
+  }
+  if (method == "read") {
+    return OnProject(base::BindOnce(
+                         [](std::string rel, const ProjectFs& p) {
+                           return Wrap(p.Read(rel));
+                         },
+                         a),
+                     std::move(reply));
+  }
+  if (method == "stat") {
+    return OnProject(base::BindOnce(
+                         [](std::string rel, const ProjectFs& p) -> Result {
+                           return base::Value(p.Stat(rel));
+                         },
+                         a),
+                     std::move(reply));
+  }
+  if (method == "write") {
+    return OnProject(base::BindOnce(
+                         [](std::string rel, std::string content,
+                            const ProjectFs& p) {
+                           return Wrap(p.Write(rel, content));
+                         },
+                         a, b),
+                     std::move(reply));
+  }
+  if (method == "create") {
+    return OnProject(base::BindOnce(
+                         [](std::string rel, bool dir, const ProjectFs& p) {
+                           return Wrap(p.Create(rel, dir));
+                         },
+                         a, b == "dir"),
+                     std::move(reply));
+  }
+  if (method == "rename") {
+    return OnProject(base::BindOnce(
+                         [](std::string from, std::string to,
+                            const ProjectFs& p) {
+                           return Wrap(p.Rename(from, to));
+                         },
+                         a, b),
+                     std::move(reply));
+  }
+  if (method == "remove") {
+    return OnProject(base::BindOnce(
+                         [](std::string rel, const ProjectFs& p) {
+                           return Wrap(p.Remove(rel));
+                         },
+                         a),
+                     std::move(reply));
+  }
+  if (method == "reveal") {
+    return OnProject(
+        base::BindOnce(
+            [](std::string rel, const ProjectFs& p) -> Result {
+              base::expected<base::FilePath, std::string> abs =
+                  p.Resolve(rel, true);
+              if (!abs.has_value()) {
+                return base::unexpected(abs.error());
+              }
+              return base::Value(abs->value());
+            },
+            a),
+        base::BindOnce(
+            [](base::WeakPtr<WorkbenchHandler> self, Reply reply,
+               Result path) {
+              if (self && path.has_value()) {
+                platform_util::ShowItemInFolder(
+                    self->profile_, base::FilePath(path->GetString()));
+                return std::move(reply).Run(base::Value(true));
+              }
+              std::move(reply).Run(std::move(path));
+            },
+            weak_factory_.GetWeakPtr(), std::move(reply)));
+  }
+  if (method == "ptyCreate") {
+    return CreateTerminal(params.size() && params[0].is_dict()
+                              ? params[0].GetDict().Clone()
+                              : base::DictValue(),
+                          std::move(reply));
+  }
+  if (method == "ptyList") {
+    base::ListValue list;
+    for (const auto& [id, term] : terms_) {
+      list.Append(TermInfo(id, term));
+    }
+    return std::move(reply).Run(base::Value(std::move(list)));
+  }
+  if (method == "ptyKill") {
+    auto it = terms_.find(a);
+    if (it == terms_.end()) {
+      return std::move(reply).Run(base::unexpected("no such terminal"));
+    }
+    std::vector<base::FilePath> cleanup = std::move(it->second.cleanup);
+    terms_.erase(it);
+    files_->PostTask(FROM_HERE, base::BindOnce(
+                                    [](std::vector<base::FilePath> paths) {
+                                      for (const base::FilePath& p : paths) {
+                                        base::DeletePathRecursively(p);
+                                      }
+                                    },
+                                    std::move(cleanup)));
+    return std::move(reply).Run(base::Value(true));
+  }
+  std::move(reply).Run(base::unexpected(
+      "This Workbench feature isn’t available in this version yet."));
+}
+
+void WorkbenchHandler::Info(Reply reply) {
+  std::string access =
+      profile_->GetPrefs()->GetString(prefs::kAgentAccess);
+  base::DictValue project =
+      project_ ? ProjectInfo() : base::DictValue();
+  bool has_project = project_.has_value();
+  std::string root = project_ ? project_->root().value() : std::string();
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath store_file, std::string access, bool has_project,
+             std::string root, base::DictValue project) -> Result {
+            base::DictValue store = LoadStore(store_file);
+            std::map<std::string, std::string> env = TerminalEnv();
+            base::DictValue agents = DetectAgents(env["PATH"]);
+            agents.Set("node", base::DictValue().Set(
+                                   "installed",
+                                   !FindExecutable("node", env["PATH"]).empty()));
+            if (has_project) {
+              const std::string* preview =
+                  store.FindDict("previews")->FindString(root);
+              project.Set("preview",
+                          preview ? *preview : "http://localhost:3000");
+            }
+            return base::Value(
+                base::DictValue()
+                    .Set("platform", "darwin")
+                    .Set("project", has_project ? base::Value(std::move(project))
+                                                : base::Value())
+                    .Set("recents", LiveRecents(store))
+                    .Set("agents", std::move(agents))
+                    .Set("agentAccess", access)
+                    .Set("terminals", true)
+                    .Set("terminalError", base::Value())
+                    .Set("safeMode", true)
+                    .Set("customRoot", base::Value())
+                    .Set("vaultUnavailable", base::Value())
+                    .Set("sandboxNetwork", true)
+                    .Set("hubTemplates", base::ListValue()));
+          },
+          StorePath(), access, has_project, root, std::move(project)),
+      std::move(reply));
+}
