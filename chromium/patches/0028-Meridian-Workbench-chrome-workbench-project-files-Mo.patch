+
+class ProjectFsTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    base_ = base::MakeAbsoluteFilePath(dir_.GetPath());
+    root_ = base_.Append("proj");
+    ASSERT_TRUE(base::CreateDirectory(root_.Append("src")));
+    ASSERT_TRUE(base::WriteFile(root_.Append("src/app.js"), "hi"));
+    ASSERT_TRUE(base::CreateDirectory(root_.Append("node_modules")));
+    ASSERT_TRUE(base::WriteFile(base_.Append("secret.txt"), "SECRET"));
+    ASSERT_TRUE(base::CreateSymbolicLink(base_.Append("secret.txt"),
+                                         root_.Append("link.txt")));
+    ASSERT_TRUE(base::CreateSymbolicLink(base_, root_.Append("up")));
+    fs_ = ProjectFs::Open(root_);
+    ASSERT_TRUE(fs_);
+  }
+
+  base::ScopedTempDir dir_;
+  base::FilePath base_;
+  base::FilePath root_;
+  std::optional<ProjectFs> fs_;
+};
+
+TEST_F(ProjectFsTest, ListsFoldersFirstAndHidesNoise) {
+  base::DictValue list = *fs_->List("", false);
+  std::vector<std::string> names;
+  for (const base::Value& e : *list.FindList("entries")) {
+    names.push_back(*e.GetDict().FindString("name") + ":" +
+                    *e.GetDict().FindString("type"));
+  }
+  // Links that lead outside stay unresolved (and are marked).
+  EXPECT_EQ(names, (std::vector<std::string>{"src:dir", "link.txt:other",
+                                             "up:other"}));
+  const base::Value& up = (*list.FindList("entries"))[2];
+  EXPECT_TRUE(up.GetDict().FindBool("outside").value_or(false));
+  EXPECT_EQ(fs_->List("", true)->FindList("entries")->size(), 4u);
+}
+
+TEST_F(ProjectFsTest, RefusesEverythingOutside) {
+  EXPECT_FALSE(fs_->Read("../secret.txt").has_value());
+  EXPECT_FALSE(fs_->Read(base_.Append("secret.txt").value()).has_value());
+  EXPECT_NE(fs_->Read("link.txt").error().find("symlink"), std::string::npos);
+  EXPECT_FALSE(fs_->Read("up/secret.txt").has_value());
+  EXPECT_FALSE(fs_->Write("up/new.txt", "x").has_value());
+  EXPECT_FALSE(fs_->Write("link.txt", "x").has_value());
+  EXPECT_FALSE(fs_->Create("up/evil", false).has_value());
+  EXPECT_FALSE(fs_->Rename("src/app.js", "../moved.js").has_value());
+  std::string secret;
+  ASSERT_TRUE(base::ReadFileToString(base_.Append("secret.txt"), &secret));
+  EXPECT_EQ(secret, "SECRET");
+  EXPECT_FALSE(base::PathExists(base_.Append("new.txt")));
+}
+
+TEST_F(ProjectFsTest, ReadsWritesCreatesRenames) {
+  EXPECT_EQ(*fs_->Read("src/app.js")->FindString("content"), "hi");
+  EXPECT_TRUE(fs_->Write("src/app.js", "bye").has_value());
+  EXPECT_TRUE(fs_->Write("src/new.txt", "fresh").has_value());
+  EXPECT_TRUE(fs_->Create("docs", true).has_value());
+  EXPECT_FALSE(fs_->Create("src/app.js", false).has_value());
+  EXPECT_TRUE(fs_->Rename("src/new.txt", "docs/new.txt").has_value());
+  std::string content;
+  ASSERT_TRUE(base::ReadFileToString(root_.Append("docs/new.txt"), &content));
+  EXPECT_EQ(content, "fresh");
+  ASSERT_TRUE(base::WriteFile(root_.Append("bin.dat"), std::string("a\0b", 3)));
+  EXPECT_TRUE(fs_->Read("bin.dat")->FindBool("binary").value_or(false));
+  EXPECT_FALSE(fs_->Remove("").has_value());
+}
+
