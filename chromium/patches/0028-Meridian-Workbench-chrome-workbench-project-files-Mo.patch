+#if BUILDFLAG(IS_MAC)
+#include "base/apple/bundle_locations.h"
+#endif
+
+namespace meridian::workbench {
+
+namespace {
+
+std::string Path(const GURL& url) {
+  std::string path(url.path());
+  if (path.starts_with("/")) {
+    path.erase(0, 1);
+  }
+  return path.empty() ? "workbench.html" : path;
+}
+
+scoped_refptr<base::RefCountedMemory> ReadInside(base::FilePath folder,
+                                                 std::string path) {
+  if (path.find('\0') != std::string::npos ||
+      path.find('\\') != std::string::npos) {
+    return nullptr;
+  }
+  base::FilePath rel(path);
+  for (const std::string& part : rel.GetComponents()) {
+    if (part == ".." || part == ".") {
+      return nullptr;
+    }
+  }
+  base::FilePath root = base::MakeAbsoluteFilePath(folder);
+  base::FilePath file = base::MakeAbsoluteFilePath(root.Append(rel));
+  if (root.empty() || file.empty() || !root.IsParent(file)) {
+    return nullptr;
+  }
+  std::string data;
+  if (!base::ReadFileToString(file, &data)) {
+    return nullptr;
+  }
+  return base::MakeRefCounted<base::RefCountedString>(std::move(data));
+}
+
+}  // namespace
+
+// static
+base::FilePath WorkbenchSource::Folder() {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (cl->HasSwitch("meridian-workbench-dir")) {
+    return cl->GetSwitchValuePath("meridian-workbench-dir");
+  }
+#if BUILDFLAG(IS_MAC)
+  return base::apple::OuterBundlePath().Append("Contents/Resources/workbench");
+#else
+  return base::FilePath();
+#endif
+}
+
+WorkbenchSource::WorkbenchSource() : folder_(Folder()) {}
+
+WorkbenchSource::~WorkbenchSource() = default;
+
+std::string WorkbenchSource::GetSource() {
+  return "workbench";
+}
+
+void WorkbenchSource::StartDataRequest(
+    const GURL& url,
+    const content::WebContents::Getter& wc_getter,
+    GotDataCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&ReadInside, folder_, Path(url)), std::move(callback));
+}
+
+std::string WorkbenchSource::GetMimeType(const GURL& url) {
+  std::string path = base::ToLowerASCII(Path(url));
+  struct {
+    const char* ext;
+    const char* type;
+  } const kTypes[] = {
+      {".html", "text/html"},       {".js", "text/javascript"},
+      {".css", "text/css"},         {".json", "application/json"},
+      {".svg", "image/svg+xml"},    {".png", "image/png"},
+      {".ttf", "font/ttf"},         {".woff2", "font/woff2"},
+      {".woff", "font/woff"},
+  };
+  for (const auto& t : kTypes) {
+    if (path.ends_with(t.ext)) {
+      return t.type;
+    }
+  }
+  return "application/octet-stream";
+}
+
+bool WorkbenchSource::ShouldServeMimeTypeAsContentTypeHeader() {
+  return true;
+}
+
+// Local scripts only; Monaco needs inline styles and blob: workers (which
+// load its local worker files).
+std::string WorkbenchSource::GetContentSecurityPolicy(
+    network::mojom::CSPDirectiveName directive) {
+  using Directive = network::mojom::CSPDirectiveName;
+  switch (directive) {
+    case Directive::ScriptSrc:
+      return "script-src 'self';";
+    case Directive::WorkerSrc:
+      return "worker-src blob: 'self';";
+    case Directive::StyleSrc:
+      return "style-src 'self' 'unsafe-inline';";
+    case Directive::FontSrc:
+      return "font-src 'self' data:;";
+    case Directive::ImgSrc:
+      return "img-src 'self' data:;";
+    case Directive::RequireTrustedTypesFor:
+    case Directive::TrustedTypes:
+      return std::string();
+    default:
+      return content::URLDataSource::GetContentSecurityPolicy(directive);
+  }
+}
+
+}  // namespace meridian::workbench
