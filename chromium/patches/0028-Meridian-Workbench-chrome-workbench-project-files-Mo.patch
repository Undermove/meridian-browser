+void WorkbenchHandler::OpenProject(base::FilePath dir, Reply reply) {
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath dir, base::FilePath store_file) {
+            std::optional<ProjectFs> project = ProjectFs::Open(dir);
+            if (project) {
+              base::DictValue store = LoadStore(store_file);
+              base::ListValue recents;
+              recents.Append(
+                  base::DictValue()
+                      .Set("path", project->root().value())
+                      .Set("name", project->name())
+                      .Set("openedAt",
+                           base::Time::Now().InMillisecondsFSinceUnixEpoch()));
+              for (const base::Value& r : *store.FindList("recents")) {
+                const std::string* p = r.GetDict().FindString("path");
+                if (p && *p != project->root().value() && *p != dir.value() &&
+                    recents.size() < kMaxRecents) {
+                  recents.Append(r.Clone());
+                }
+              }
+              store.Set("recents", std::move(recents));
+              SaveStore(store_file, store);
+            }
+            return project;
+          },
+          dir, StorePath()),
+      base::BindOnce(&WorkbenchHandler::OnProjectOpened,
+                     weak_factory_.GetWeakPtr(), std::move(reply)));
+}
+
+void WorkbenchHandler::OnProjectOpened(Reply reply,
+                                       std::optional<ProjectFs> project) {
+  if (!project) {
+    return std::move(reply).Run(base::unexpected("not a folder"));
+  }
+  CloseProject();
+  project_ = std::move(project);
+  // Agents edit files: changes outside the editor refresh the tree.
+  watcher_ = base::SequenceBound<base::FilePathWatcher>(files_);
+  watcher_.AsyncCall(base::IgnoreResult(&base::FilePathWatcher::Watch))
+      .WithArgs(project_->root(), base::FilePathWatcher::Type::kRecursive,
+                base::BindPostTaskToCurrentDefault(base::BindRepeating(
+                    &WorkbenchHandler::OnFileChanged,
+                    weak_factory_.GetWeakPtr())));
+  base::DictValue info = ProjectInfo();
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath store_file, std::string root,
+             base::DictValue info) -> Result {
+            base::DictValue store = LoadStore(store_file);
+            if (const std::string* preview =
+                    store.FindDict("previews")->FindString(root)) {
+              info.Set("preview", *preview);
+            }
+            return base::Value(std::move(info));
+          },
+          StorePath(), project_->root().value(), std::move(info)),
+      std::move(reply));
+}
+
+void WorkbenchHandler::CloseProject() {
+  project_.reset();
+  watcher_.Reset();
+  changed_.clear();
+  flush_.Stop();
+}
+
+void WorkbenchHandler::OnFileChanged(const base::FilePath& path, bool error) {
+  if (!project_) {
+    return;
+  }
+  std::string rel = project_->Rel(path);
+  // Changes inside .git / node_modules are noise: refresh their folder only.
+  static const base::NoDestructor<RE2> noisy(
+      "^(.*?(?:^|/)(?:\\.git|node_modules|\\.hg|\\.svn))(?:/|$)");
+  std::string folder;
+  if (RE2::PartialMatch(rel, *noisy, &folder)) {
+    rel = folder;
+  }
+  if (changed_.size() < 500) {
+    changed_.insert(rel);
+  }
+  if (!flush_.IsRunning()) {
+    flush_.Start(FROM_HERE, base::Milliseconds(150),
+                 base::BindOnce(&WorkbenchHandler::FlushChanges,
+                                base::Unretained(this)));
+  }
+}
+
+void WorkbenchHandler::FlushChanges() {
+  base::ListValue paths;
+  for (const std::string& p : changed_) {
+    paths.Append(p);
+  }
+  changed_.clear();
+  Emit("wb:fs-change", base::Value(base::DictValue().Set("paths", std::move(paths))));
+}
+
+void WorkbenchHandler::OnProject(
+    base::OnceCallback<Result(const ProjectFs&)> op,
+    Reply reply) {
+  if (!project_) {
+    return std::move(reply).Run(base::unexpected("no project is open"));
+  }
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::OnceCallback<Result(const ProjectFs&)> op,
+             ProjectFs project) { return std::move(op).Run(project); },
+          std::move(op), *project_),
+      std::move(reply));
+}
+
+void WorkbenchHandler::CreateTerminal(base::DictValue opts, Reply reply) {
+  if (!project_) {
+    return std::move(reply).Run(base::unexpected("no project is open"));
+  }
+  size_t running = 0;
+  for (const auto& [id, term] : terms_) {
+    running += term.exited.is_none();
+  }
+  if (running >= kMaxTerminals) {
+    return std::move(reply).Run(
+        base::unexpected("At most 12 terminals per workbench"));
+  }
+  const std::string* kind_param = opts.FindString("kind");
+  std::string kind = kind_param ? *kind_param : "shell";
+  int cols = opts.FindInt("cols").value_or(80);
+  int rows = opts.FindInt("rows").value_or(24);
+  McpBridge bridge;
+  bridge.command = base::CommandLine::ForCurrentProcess()->GetProgram().value();
+  bridge.args = {"--mcp-bridge",
+                 "--user-data-dir=" + profile_->GetPath().DirName().value()};
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](std::string kind, McpBridge bridge)
+              -> std::pair<base::expected<LaunchSpec, std::string>,
+                           std::map<std::string, std::string>> {
+            std::map<std::string, std::string> env = TerminalEnv();
+            std::string shell = env.contains("SHELL") && !env["SHELL"].empty()
+                                    ? env["SHELL"]
+                                    : "/bin/zsh";
+            return {MakeLaunchSpec(kind, env["PATH"], shell, bridge), env};
+          },
+          kind, bridge),
+      base::BindOnce(
+          [](base::WeakPtr<WorkbenchHandler> self, std::string kind, int cols,
+             int rows, Reply reply,
+             std::pair<base::expected<LaunchSpec, std::string>,
+                       std::map<std::string, std::string>> made) {
+            if (!self || !self->project_) {
+              return;
+            }
+            auto& [spec, env] = made;
+            if (!spec.has_value()) {
+              return std::move(reply).Run(base::unexpected(spec.error()));
+            }
+            for (const auto& [name, value] : spec->env) {
+              env[name] = value;
+            }
+            std::string id = "t" + base::NumberToString(++self->term_seq_);
+            Terminal::Spec run;
+            run.argv = spec->argv;
+            run.env = env;
+            run.cwd = self->project_->root().value();
+            run.cols = cols;
+            run.rows = rows;
+            std::unique_ptr<Terminal> terminal = Terminal::Start(
+                run,
+                base::BindPostTaskToCurrentDefault(base::BindRepeating(
+                    &WorkbenchHandler::OnTerminalData, self, id)),
+                base::BindPostTaskToCurrentDefault(base::BindOnce(
+                    &WorkbenchHandler::OnTerminalExit, self, id)));
+            if (!terminal) {
+              return std::move(reply).Run(
+                  base::unexpected("Couldn’t start the terminal."));
+            }
+            Term term;
+            term.terminal = std::move(terminal);
+            term.kind = kind;
+            term.title = spec->title;
+            term.cleanup = spec->cleanup;
+            base::DictValue info = self->TermInfo(id, term);
+            base::ListValue notes;
+            for (const std::string& n : spec->notes) {
+              notes.Append(n);
+            }
+            info.Set("notes", std::move(notes));
+            info.Set("browserTools", spec->browser_tools);
+            self->terms_[id] = std::move(term);
+            std::move(reply).Run(base::Value(std::move(info)));
+          },
+          weak_factory_.GetWeakPtr(), kind, cols, rows, std::move(reply)));
+}
+
+base::DictValue WorkbenchHandler::TermInfo(const std::string& id,
+                                           const Term& term) const {
+  return base::DictValue()
+      .Set("id", id)
+      .Set("kind", term.kind)
+      .Set("title", term.title)
+      .Set("exited", term.exited.Clone())
+      .Set("scrollback", term.scrollback)
+      .Set("secrets", base::ListValue())
+      .Set("guard", false)
+      .Set("sandbox", false)
+      .Set("then", base::Value())
+      .Set("missionNode", base::Value());
+}
+
+void WorkbenchHandler::OnTerminalData(std::string id, std::string data) {
+  auto it = terms_.find(id);
+  if (it == terms_.end()) {
+    return;
+  }
+  std::string& scrollback = it->second.scrollback;
+  scrollback += data;
+  if (scrollback.size() > kScrollbackBytes) {
+    size_t cut = scrollback.size() - kScrollbackBytes;
+    while (cut < scrollback.size() && (scrollback[cut] & 0xc0) == 0x80) {
+      ++cut;
+    }
+    scrollback.erase(0, cut);
+  }
+  Emit("wb:pty-data",
+       base::Value(base::DictValue().Set("id", id).Set("data", std::move(data))));
+}
+
+void WorkbenchHandler::OnTerminalExit(std::string id, int code, int signal) {
+  auto it = terms_.find(id);
+  if (it == terms_.end()) {
+    return;
+  }
+  base::DictValue exited;
+  exited.Set("code", code);
+  exited.Set("signal", signal ? base::Value(signal) : base::Value());
+  it->second.exited = base::Value(exited.Clone());
+  std::vector<base::FilePath> cleanup = std::move(it->second.cleanup);
+  files_->PostTask(FROM_HERE, base::BindOnce(
+                                  [](std::vector<base::FilePath> paths) {
+                                    for (const base::FilePath& p : paths) {
+                                      base::DeletePathRecursively(p);
+                                    }
+                                  },
+                                  std::move(cleanup)));
+  exited.Set("id", id);
+  Emit("wb:pty-exit", base::Value(std::move(exited)));
+}
+
+void WorkbenchHandler::ToHost(const base::DictValue& message) {
+  const std::string* type = message.FindString("type");
+  const std::string* url = message.FindString("url");
+  if (!type || !url) {
+    return;
+  }
+  GURL target(*url);
+  if (!target.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(web_ui()->GetWebContents());
+  BrowserWindowInterface* browser = tab ? tab->GetBrowserWindowInterface()
+                                        : nullptr;
+  if (!browser) {
+    return;
+  }
+  NavigateParams params(browser, target, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  Navigate(&params);
+  // A preview opens next to the workbench, side by side.
+  if (*type == "preview" && params.navigated_or_inserted_contents) {
+    TabStripModel* model = browser->GetTabStripModel();
+    int workbench = model->GetIndexOfWebContents(web_ui()->GetWebContents());
+    int preview =
+        model->GetIndexOfWebContents(params.navigated_or_inserted_contents);
+    if (workbench != TabStripModel::kNoTab && preview != TabStripModel::kNoTab) {
+      model->AddToNewSplit(
+          {workbench, preview},
+          split_tabs::SplitTabVisualData(
+              split_tabs::SplitTabLayout::kSideBySide),
+          split_tabs::SplitTabCreatedSource::kTabContextMenu);
+    }
+  }
+}
+
+}  // namespace meridian::workbench
