+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_AGENTS_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_AGENTS_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+
+namespace meridian::workbench {
+
+// Coding agents and the shell, as the Workbench starts them.
+//
+// When Claude Code, Codex, Copilot or OpenCode is started from the
+// Workbench, Meridian's MCP server is wired in for that one session through
+// command-line flags or a private temp file; the person's global CLI configs
+// are never touched. The browser still enforces the agent access level from
+// Settings > AI on every tool call.
+
+// {claude: {id, label, installed, path, install, mcp, extra}, …}
+base::DictValue DetectAgents(const std::string& search_path);
+
+struct LaunchSpec {
+  std::string title;
+  std::vector<std::string> argv;
+  std::map<std::string, std::string> env;
+  // Removed when the terminal ends (private temp files).
+  std::vector<base::FilePath> cleanup;
+  std::vector<std::string> notes;
+  bool browser_tools = false;
+};
+
+struct McpBridge {
+  // The Meridian executable and its arguments for `--mcp-bridge`.
+  std::string command;
+  std::vector<std::string> args;
+};
+
+// `kind`: "shell" or an agent id. Blocking (writes temp files).
+base::expected<LaunchSpec, std::string> MakeLaunchSpec(
+    const std::string& kind,
+    const std::string& search_path,
+    const std::string& shell,
+    const McpBridge& bridge);
+
+std::string FindExecutable(const std::string& name,
+                           const std::string& search_path);
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_AGENTS_H_
