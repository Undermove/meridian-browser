+TEST(WorkbenchAgentsTest, ClaudeGetsMeridianForThisSessionOnly) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::FilePath claude = dir.GetPath().Append("claude");
+  ASSERT_TRUE(base::WriteFile(claude, "#!/bin/sh\n"));
+  ASSERT_TRUE(base::SetPosixFilePermissions(claude, 0755));
+  McpBridge bridge{"/Applications/Meridian.app/Contents/MacOS/Meridian",
+                   {"--mcp-bridge", "--user-data-dir=/u"}};
+  base::expected<LaunchSpec, std::string> spec =
+      MakeLaunchSpec("claude", dir.GetPath().value(), "/bin/zsh", bridge);
+  ASSERT_TRUE(spec.has_value());
+  ASSERT_EQ(spec->argv.size(), 3u);
+  EXPECT_EQ(spec->argv[1], "--mcp-config");
+  std::string json;
+  ASSERT_TRUE(base::ReadFileToString(base::FilePath(spec->argv[2]), &json));
+  std::optional<base::Value> config = base::JSONReader::Read(json, 0);
+  EXPECT_EQ(*config->GetDict().FindStringByDottedPath(
+                "mcpServers.meridian.command"),
+            bridge.command);
+  int mode = 0;
+  ASSERT_TRUE(base::GetPosixFilePermissions(base::FilePath(spec->argv[2]), &mode));
+  EXPECT_EQ(mode, 0600);
+  EXPECT_TRUE(spec->browser_tools);
+  for (const base::FilePath& p : spec->cleanup) {
+    base::DeletePathRecursively(p);
+  }
+}
+
+TEST(WorkbenchAgentsTest, MissingAgentSaysHowToInstall) {
+  base::expected<LaunchSpec, std::string> spec =
+      MakeLaunchSpec("codex", "/nonexistent", "/bin/zsh", {});
+  ASSERT_FALSE(spec.has_value());
+  EXPECT_NE(spec.error().find("npm install -g @openai/codex"),
+            std::string::npos);
+  EXPECT_EQ(MakeLaunchSpec("shell", "", "/bin/zsh", {})->argv,
+            (std::vector<std::string>{"/bin/zsh", "-l"}));
+}
+
+}  // namespace
