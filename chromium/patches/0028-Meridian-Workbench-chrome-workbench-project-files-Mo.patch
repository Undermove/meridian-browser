+constexpr size_t kMaxTerminals = 12;
+constexpr size_t kScrollbackBytes = 256 * 1024;
+constexpr size_t kMaxRecents = 12;
+
+base::DictValue LoadStore(const base::FilePath& file) {
+  std::string json;
+  std::optional<base::Value> v;
+  if (base::ReadFileToString(file, &json)) {
+    v = base::JSONReader::Read(json, 0);
+  }
+  base::DictValue store = v && v->is_dict() ? std::move(v->GetDict())
+                                            : base::DictValue();
+  if (!store.FindList("recents")) {
+    store.Set("recents", base::ListValue());
+  }
+  if (!store.FindDict("previews")) {
+    store.Set("previews", base::DictValue());
+  }
+  return store;
+}
+
+void SaveStore(const base::FilePath& file, const base::DictValue& store) {
+  if (base::WriteFile(file, base::WriteJson(store).value_or("{}"))) {
+    base::SetPosixFilePermissions(file, 0600);
+  }
+}
+
+// Recents whose folders still exist.
+base::ListValue LiveRecents(const base::DictValue& store) {
+  base::ListValue out;
+  for (const base::Value& r : *store.FindList("recents")) {
+    const std::string* path = r.is_dict() ? r.GetDict().FindString("path")
+                                          : nullptr;
+    if (path && base::DirectoryExists(base::FilePath(*path))) {
+      out.Append(r.Clone());
+    }
+  }
+  return out;
+}
+
+std::string StringParam(const base::ListValue& params, size_t i) {
+  return i < params.size() && params[i].is_string() ? params[i].GetString()
+                                                    : std::string();
+}
+
+template <typename T>
+WorkbenchHandler::Result Wrap(base::expected<T, std::string> r) {
+  if (!r.has_value()) {
+    return base::unexpected(r.error());
+  }
+  return base::Value(std::move(*r));
+}
+
+// The terminal environment: the login environment, a colour terminal.
+std::map<std::string, std::string> TerminalEnv() {
+  std::map<std::string, std::string> env = ai::LoginEnvironment();
+  env["TERM"] = "xterm-256color";
+  env["COLORTERM"] = "truecolor";
+  env["TERM_PROGRAM"] = "Meridian";
+  if (!env.contains("LANG")) {
+    env["LANG"] = "en_US.UTF-8";
+  }
+  return env;
+}
