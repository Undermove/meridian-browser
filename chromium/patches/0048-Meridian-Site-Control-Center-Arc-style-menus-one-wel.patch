+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_SITE_CONTROL_H_
+#define CHROME_BROWSER_MERIDIAN_SITE_CONTROL_H_
+
+#include <string>
+
+#include "base/functional/callback_forward.h"
+#include "chrome/browser/meridian/sidebar.mojom.h"
+
+class Profile;
+
+namespace content {
+class WebContents;
+}
+
+namespace meridian {
+
+// The Site Control Center (the sliders in the URL pill): what the site in
+// `contents` may do, and the controls for it. Settings are Chromium's own
+// site settings, so chrome://settings shows the same.
+mojom::SiteInfoPtr GetSiteInfo(Profile* profile,
+                               content::WebContents* contents);
+
+// `type` is a SitePermission type; `setting` is "allow", "block" or "ask"
+// (back to the default).
+void SetSitePermission(Profile* profile,
+                       content::WebContents* contents,
+                       const std::string& type,
+                       const std::string& setting);
+
+// `step`: +1 zooms in, -1 out, 0 back to 100%.
+void ZoomSite(content::WebContents* contents, int step);
+
+// Removes the site's cookies, storage and cache, then reloads the page.
+void ClearSiteData(Profile* profile,
+                   content::WebContents* contents,
+                   base::OnceClosure done);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_SITE_CONTROL_H_
