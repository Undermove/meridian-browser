+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import type {MeridianSiteControlElement} from './site_control.js';
+
+export function getHtml(this: MeridianSiteControlElement) {
+  return html`<!--_html_template_start_-->
+<div id="card" role="dialog" aria-label="Site controls">
+  <div class="quick">
+    <button class="q" data-action="copy" @click="${this.onQuickClick_}">
+      ${icon(this.copyIcon_(), 18)}<span>${this.copyLabel_()}</span>
+    </button>
+    <button class="q" data-action="pin" @click="${this.onQuickClick_}">
+      ${icon('pin', 18)}<span>Pin</span>
+    </button>
+    <button class="q" data-action="split" @click="${this.onQuickClick_}">
+      ${icon('split', 18)}<span>Split</span>
+    </button>
+    <button class="q" data-action="ask" @click="${this.onQuickClick_}">
+      ${icon('sparkles', 18)}<span>Ask AI</span>
+    </button>
+  </div>
+
+  <div class="sec">Extensions</div>
+  <div class="ext">
+    <slot name="extensions"></slot>
+    <button id="addExtension" class="ext-add" title="Get extensions"
+        @click="${this.onAddExtensionClick_}">${icon('plus', 16)}</button>
+  </div>
+
+  ${this.info_?.origin ? html`
+    <div class="sec">${this.info_.host}</div>
+    <button id="adsRow" class="row ${this.info_.adblock ? 'on' : ''}"
+        @click="${this.onAdsClick_}">
+      <span class="row-ic">${icon('shield', 16)}</span>
+      <span class="row-text">
+        <span class="row-label">Block ads and trackers</span>
+        <span class="row-sub">${this.adsState_()}</span>
+      </span>
+      <span class="switch"><i></i></span>
+    </button>
+    ${this.rows_.map(r => html`
+      <button class="row permission ${r.allowed ? 'on' : ''}"
+          data-type="${r.type}" @click="${this.onPermissionClick_}">
+        <span class="row-ic">${icon(r.icon, 16)}</span>
+        <span class="row-text">
+          <span class="row-label">${r.label}</span>
+          <span class="row-sub">${r.state}</span>
+        </span>
+        <span class="switch"><i></i></span>
+      </button>`)}
+    <div class="row zoom">
+      <span class="row-ic">${icon('search', 16)}</span>
+      <span class="row-text">
+        <span class="row-label">Zoom</span>
+      </span>
+      <button class="zoom-btn" data-step="-1" title="Zoom out"
+          @click="${this.onZoomClick_}">${icon('minus', 14)}</button>
+      <button class="zoom-value" data-step="0" title="Reset to 100%"
+          @click="${this.onZoomClick_}">${this.info_.zoom}%</button>
+      <button class="zoom-btn" data-step="1" title="Zoom in"
+          @click="${this.onZoomClick_}">${icon('plus', 14)}</button>
+    </div>
+    <button id="clearRow" class="row ${this.confirmClear_ ? 'confirm' : ''}"
+        @click="${this.onClearClick_}">
+      <span class="row-ic">${icon('trash', 16)}</span>
+      <span class="row-text">
+        <span class="row-label">${this.clearLabel_()}</span>
+        <span class="row-sub">You’ll be signed out of this site</span>
+      </span>
+    </button>
+  ` : ''}
+
+  <div class="foot">
+    <button id="security" class="security ${this.info_?.security || ''}"
+        @click="${this.onSecurityClick_}">
+      ${icon(this.securityIcon_(), 14)}<span>${this.securityLabel_()}</span>
+    </button>
+    <div class="grow"></div>
+    ${this.info_?.origin ? html`
+      <button id="more" class="more" title="All site settings"
+          @click="${this.onMoreClick_}">${icon('more', 16)}</button>` : ''}
+  </div>
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/site_control.ts b/chrome/browser/resources/webui_browser/meridian/site_control.ts
new file mode 100644
index 0000000000..637ee8f2b8
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/site_control.ts
@@ -0,0 +1,208 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The Site Control Center: the sliders at the end of the URL pill open it.
+// Quick actions for the page, the extensions, and what the site may do (ads
+// and trackers, permissions, zoom, its cookies), like Arc's, over Chromium's
+// own site settings.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {SidebarHandlerInterface, SiteInfo} from '../sidebar.mojom-webui.js';
+
+import type {IconName} from './icons.js';
+import {getCss} from './site_control.css.js';
+import {getHtml} from './site_control.html.js';
+
+// A permission row as the template draws it.
+export interface SiteRow {
+  type: string;
+  label: string;
+  icon: IconName;
+  state: string;
+  allowed: boolean;
+}
+
+const ICONS: Record<string, IconName> = {
+  camera: 'eye',
+  microphone: 'speaker',
+  location: 'globe',
+  notifications: 'bolt',
+  popups: 'window',
+  sound: 'speaker',
+  clipboard: 'copy',
+  downloads: 'download',
+  pip: 'littleWindow',
+};
+
+const STATES: Record<string, string> = {
+  allow: 'Allowed',
+  block: 'Blocked',
+  ask: 'Ask',
+};
+
+export class MeridianSiteControlElement extends CrLitElement {
+  static get is() {
+    return 'meridian-site-control';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      url: {type: String},
+      hasExtensions: {type: Boolean},
+      info_: {state: true, type: Object},
+      rows_: {state: true, type: Array},
+      copied_: {state: true, type: Boolean},
+      confirmClear_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  // The page's address (Copy Link).
+  accessor url: string = '';
+  accessor hasExtensions: boolean = false;
+  protected accessor info_: SiteInfo|null = null;
+  protected accessor rows_: SiteRow[] = [];
+  protected accessor copied_: boolean = false;
+  // "Clear cookies and site data" asks once more.
+  protected accessor confirmClear_: boolean = false;
+
+  private handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    if (changed.has('open') && this.open) {
+      this.copied_ = false;
+      this.confirmClear_ = false;
+      this.refresh_();
+    }
+    this.rows_ = (this.info_?.permissions || []).map(p => ({
+      type: p.type,
+      label: p.label,
+      icon: ICONS[p.type] || 'settings',
+      state: (STATES[p.setting] || p.setting) + (p.isDefault ? ' (default)' : ''),
+      allowed: p.setting === 'allow',
+    }));
+  }
+
+  private async refresh_() {
+    const {info} = await this.handler_.getSiteInfo();
+    this.info_ = info;
+  }
+
+  protected copyIcon_(): IconName {
+    return this.copied_ ? 'check' : 'link';
+  }
+
+  protected copyLabel_(): string {
+    return this.copied_ ? 'Copied' : 'Copy Link';
+  }
+
+  protected clearLabel_(): string {
+    return this.confirmClear_ ? 'Click again to clear and reload' :
+                                'Clear cookies and site data';
+  }
+
+  protected securityLabel_(): string {
+    switch (this.info_?.security) {
+      case 'secure':
+        return 'Secure';
+      case 'insecure':
+        return 'Not secure';
+      case 'dangerous':
+        return 'Dangerous';
+      default:
+        return 'Meridian page';
+    }
+  }
+
+  protected securityIcon_(): IconName {
+    return this.info_?.security === 'secure' ? 'lock' : 'info';
+  }
+
+  protected adsState_(): string {
+    if (!this.info_?.adblockEverywhere) {
+      return 'Off in Settings';
+    }
+    return this.info_.adblock ? 'On' : 'Off for this site';
+  }
+
+  protected onQuickClick_(e: Event) {
+    const action = (e.currentTarget as HTMLElement).dataset['action'];
+    if (action === 'copy') {
+      navigator.clipboard.writeText(this.url);
+      this.copied_ = true;
+      setTimeout(() => this.copied_ = false, 1400);
+      return;
+    }
+    this.fire('site-control-action', action);
+  }
+
+  protected async onAdsClick_() {
+    if (!this.info_?.adblockEverywhere) {
+      this.fire('site-control-action', 'settings');
+      return;
+    }
+    // Allowed here, or back to the default (blocked).
+    await this.handler_.setSitePermission(
+        'ads', this.info_.adblock ? 'allow' : 'ask');
+    this.refresh_();
+  }
+
+  protected async onPermissionClick_(e: Event) {
+    const type = (e.currentTarget as HTMLElement).dataset['type']!;
+    const row = this.rows_.find(r => r.type === type);
+    await this.handler_.setSitePermission(type, row?.allowed ? 'block' : 'allow');
+    this.refresh_();
+  }
+
+  protected async onZoomClick_(e: Event) {
+    const step = Number((e.currentTarget as HTMLElement).dataset['step']);
+    await this.handler_.zoomSite(step);
+    this.refresh_();
+  }
+
+  protected async onClearClick_() {
+    if (!this.confirmClear_) {
+      this.confirmClear_ = true;
+      return;
+    }
+    this.confirmClear_ = false;
+    await this.handler_.clearSiteData();
+    this.refresh_();
+  }
+
+  protected onSecurityClick_() {
+    this.fire('site-control-action', 'page-info');
+  }
+
+  protected onMoreClick_() {
+    this.fire('site-control-action', 'site-settings');
+  }
+
+  protected onAddExtensionClick_() {
+    this.fire('site-control-action', 'web-store');
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-site-control': MeridianSiteControlElement;
+  }
+}
+
+customElements.define(
+    MeridianSiteControlElement.is, MeridianSiteControlElement);
