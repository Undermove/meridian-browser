@@ -0,0 +1,125 @@
+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  display: block;
+}
+
+svg {
+  display: block;
+}
+
+.menu-item {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  height: 26px;
+  padding: 0 8px 0 6px;
+  border-radius: 6px;
+  white-space: nowrap;
+  cursor: default;
+}
+
+.menu-item.sel,
+.menu-item.open {
+  background: var(--meridian-space);
+  color: white;
+}
+
+.menu-item.sel .menu-keys,
+.menu-item.sel .menu-lead,
+.menu-item.sel .menu-chev,
+.menu-item.open .menu-keys,
+.menu-item.open .menu-lead,
+.menu-item.open .menu-chev,
+.menu-item.sel .menu-check {
+  color: rgba(255, 255, 255, 0.85);
+}
+
+.menu-item.disabled {
+  opacity: 0.38;
+}
+
+.menu-item.disabled.sel {
+  background: none;
+  color: var(--meridian-text);
+}
+
+.menu-item.danger {
+  color: #e5484d;
+}
+
+.menu-item.danger.sel {
+  background: #e5484d;
+  color: white;
+}
+
+.menu-item.danger .menu-lead {
+  color: inherit;
+}
+
+.menu-lead {
+  width: 18px;
+  display: inline-flex;
+  justify-content: center;
+  color: var(--meridian-text-muted);
+  flex: none;
+}
+
+.menu-label {
+  flex: 1;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.menu-keys {
+  color: var(--meridian-text-muted);
+  font-size: 12px;
+  letter-spacing: 0.04em;
+  padding-left: 14px;
+}
+
+.menu-check {
+  display: inline-flex;
+  color: var(--meridian-space);
+}
+
+.menu-chev {
+  display: inline-flex;
+  color: var(--meridian-text-muted);
+  margin-right: -2px;
+}
+
+.menu-sep {
+  height: 1px;
+  margin: 4px 8px;
+  background: var(--meridian-border);
+}
+
+.menu-header {
+  padding: 4px 8px 3px;
+  font-size: 11px;
+  font-weight: 600;
+  color: var(--meridian-text-muted);
+  letter-spacing: 0.02em;
+}
+
+.menu-swatch {
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  background: var(--c);
+  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
+}
+
+.menu-emoji {
+  font-size: 13px;
+  line-height: 1;
+}
+
diff --git a/chrome/browser/resources/webui_browser/meridian/menu.html.ts b/chrome/browser/resources/webui_browser/meridian/menu.html.ts
new file mode 100644
index 0000000000..35c80a177c
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/menu.html.ts
@@ -0,0 +1,33 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import type {MeridianMenuElement} from './menu.js';
+
+export function getHtml(this: MeridianMenuElement) {
+  return html`<!--_html_template_start_-->
+${this.rows_.map(r => html`
+  ${r.separator ? html`<div class="menu-sep"></div>` : ''}
+  ${r.entry.header ? html`<div class="menu-header">${r.entry.label}</div>` : html`
+    <div role="menuitem" class="${r.classes}"
+        aria-disabled="${r.entry.enabled === false}" data-index="${r.index}"
+        @mousemove="${this.onRowMousemove_}" @click="${this.onRowClick_}">
+      <span class="menu-lead">
+        ${r.entry.swatch ? html`
+          <span class="menu-swatch" style="--c:${r.entry.swatch}"></span>` : ''}
+        ${r.entry.emoji ? html`
+          <span class="menu-emoji">${r.entry.emoji}</span>` : ''}
+        ${r.entry.icon ? html`${icon(r.entry.icon, 15)}` : ''}
+      </span>
+      <span class="menu-label">${r.entry.label}</span>
+      ${r.entry.checked ? html`
+        <span class="menu-check">${icon('check', 13)}</span>` : ''}
+      ${r.entry.keys ? html`<span class="menu-keys">${r.entry.keys}</span>` : ''}
+      ${r.entry.submenu ? html`
+        <span class="menu-chev">${icon('chevronRight', 12)}</span>` : ''}
+    </div>`}`)}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/menu.ts b/chrome/browser/resources/webui_browser/meridian/menu.ts
new file mode 100644
index 0000000000..84a5720803
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/menu.ts
@@ -0,0 +1,132 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The rows of one of the sidebar's right-click menus, drawn like Arc's: an
+// icon, the label, its shortcut, a check, a submenu arrow or a colour swatch.
+// The sidebar keeps which row is highlighted and places the menus.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {IconName} from './icons.js';
+import {getCss} from './menu.css.js';
+import {getHtml} from './menu.html.js';
+
+// A row of a menu.
+export interface MenuEntry {
+  label: string;
+  action?: () => void;
+  icon?: IconName;
+  emoji?: string;
+  swatch?: string;
+  keys?: string;
+  checked?: boolean;
+  // False shows it greyed out.
+  enabled?: boolean;
+  danger?: boolean;
+  separatorBefore?: boolean;
+  // A heading (the space's name), not a choice.
+  header?: boolean;
+  submenu?: MenuEntry[];
+}
+
+// A row as the template draws it.
+export interface MenuRow {
+  index: number;
+  entry: MenuEntry;
+  separator: boolean;
+  classes: string;
+}
+
+// Sent on pointer moves and clicks over a row.
+export interface MenuRowEvent {
+  level: number;
+  index: number;
+}
+
+export class MeridianMenuElement extends CrLitElement {
+  static get is() {
+    return 'meridian-menu';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      entries: {type: Array},
+      level: {type: Number},
+      sel: {type: Number},
+      openIndex: {type: Number},
+      rows_: {state: true, type: Array},
+    };
+  }
+
+  accessor entries: MenuEntry[] = [];
+  // 0: a menu, 1: the submenu beside it.
+  accessor level: number = 0;
+  // The highlighted row, and the row whose submenu is open.
+  accessor sel: number = -1;
+  accessor openIndex: number = -1;
+  protected accessor rows_: MenuRow[] = [];
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    this.rows_ = this.entries.map((entry, index) => {
+      const classes = ['menu-item'];
+      if (index === this.sel) {
+        classes.push('sel');
+      }
+      if (entry.enabled === false) {
+        classes.push('disabled');
+      }
+      if (entry.danger) {
+        classes.push('danger');
+      }
+      if (index === this.openIndex) {
+        classes.push('open');
+      }
+      return {
+        index,
+        entry,
+        separator: !!entry.separatorBefore && index > 0,
+        classes: classes.join(' '),
+      };
+    });
+  }
+
+  // Where a row is, to place its submenu beside it.
+  rowRect(index: number): DOMRect|null {
+    return this.shadowRoot
+               .querySelector<HTMLElement>(`.menu-item[data-index="${index}"]`)
+               ?.getBoundingClientRect() ||
+        null;
+  }
+
+  private rowEvent_(e: Event): MenuRowEvent {
+    const row = e.currentTarget as HTMLElement;
+    return {level: this.level, index: Number(row.dataset['index'])};
+  }
+
+  protected onRowMousemove_(e: Event) {
+    this.fire('menu-row-move', this.rowEvent_(e));
+  }
+
+  protected onRowClick_(e: Event) {
+    this.fire('menu-row-click', this.rowEvent_(e));
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-menu': MeridianMenuElement;
+  }
+}
+
+customElements.define(MeridianMenuElement.is, MeridianMenuElement);
