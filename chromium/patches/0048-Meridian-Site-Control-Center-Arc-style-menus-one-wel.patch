diff --git a/chrome/browser/meridian/site_control.cc b/chrome/browser/meridian/site_control.cc
new file mode 100644
index 0000000000..3b41709014
--- /dev/null
+++ b/chrome/browser/meridian/site_control.cc
@@ -0,0 +1,238 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/site_control.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/content_settings/core/common/content_settings_utils.h"
+#include "components/zoom/page_zoom.h"
+#include "components/zoom/zoom_controller.h"
+#include "content/public/browser/browsing_data_filter_builder.h"
+#include "content/public/browser/browsing_data_remover.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/ssl_status.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/common/page_zoom.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "net/cert/cert_status_flags.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace meridian {
+
+namespace {
+
+struct Kind {
+  const char* type;
+  const char* label;
+  ContentSettingsType setting;
+  // Shown even when it's at the default.
+  bool always;
+};
+
+// The site settings the Control Center offers, in its order.
+constexpr Kind kKinds[] = {
+    {"camera", "Camera", ContentSettingsType::MEDIASTREAM_CAMERA, false},
+    {"microphone", "Microphone", ContentSettingsType::MEDIASTREAM_MIC, false},
+    {"location", "Location", ContentSettingsType::GEOLOCATION, false},
+    {"notifications", "Notifications", ContentSettingsType::NOTIFICATIONS,
+     false},
+    {"popups", "Pop-ups and redirects", ContentSettingsType::POPUPS, true},
+    {"sound", "Sound", ContentSettingsType::SOUND, false},
+    {"clipboard", "Clipboard", ContentSettingsType::CLIPBOARD_READ_WRITE,
+     false},
+    {"downloads", "Automatic downloads",
+     ContentSettingsType::AUTOMATIC_DOWNLOADS, false},
+    {"pip", "Automatic picture-in-picture",
+     ContentSettingsType::AUTO_PICTURE_IN_PICTURE, false},
+};
+
+const Kind* KindOf(const std::string& type) {
+  for (const Kind& kind : kKinds) {
+    if (type == kind.type) {
+      return &kind;
+    }
+  }
+  return nullptr;
+}
+
+std::string SettingName(ContentSetting setting) {
+  switch (setting) {
+    case CONTENT_SETTING_ALLOW:
+      return "allow";
+    case CONTENT_SETTING_BLOCK:
+      return "block";
+    default:
+      return "ask";
+  }
+}
+
+// Only real web pages have site settings.
+bool IsWebSite(const GURL& url) {
+  return url.SchemeIsHTTPOrHTTPS();
+}
+
+std::string Security(content::WebContents* contents, const GURL& url) {
+  if (!IsWebSite(url)) {
+    return "internal";
+  }
+  if (!url.SchemeIs(url::kHttpsScheme)) {
+    return "insecure";
+  }
+  content::NavigationEntry* entry =
+      contents->GetController().GetLastCommittedEntry();
+  if (!entry || !entry->GetSSL().certificate ||
+      net::IsCertStatusError(entry->GetSSL().cert_status)) {
+    return "dangerous";
+  }
+  return "secure";
+}
+
+// Reloads the page once its site's data is gone (it deletes itself).
+class ClearObserver : public content::BrowsingDataRemover::Observer,
+                      public content::WebContentsObserver {
+ public:
+  ClearObserver(content::WebContents* contents, base::OnceClosure done)
+      : content::WebContentsObserver(contents), done_(std::move(done)) {}
+
+  void OnBrowsingDataRemoverDone(uint64_t failed_data_types) override {
+    if (web_contents()) {
+      web_contents()->GetController().Reload(content::ReloadType::NORMAL,
+                                             /*check_for_repost=*/true);
+    }
+    std::move(done_).Run();
+    delete this;
+  }
+
+ private:
+  base::OnceClosure done_;
+};
+
+}  // namespace
+
+mojom::SiteInfoPtr GetSiteInfo(Profile* profile,
+                               content::WebContents* contents) {
+  auto info = mojom::SiteInfo::New();
+  if (!contents) {
+    return info;
+  }
+  const GURL url = contents->GetLastCommittedURL();
+  info->security = Security(contents, url);
+  if (zoom::ZoomController* zoom =
+          zoom::ZoomController::FromWebContents(contents)) {
+    info->zoom = zoom->GetZoomPercent();
+  } else {
+    info->zoom = 100;
+  }
+  if (!IsWebSite(url)) {
+    return info;
+  }
+  info->origin = url::Origin::Create(url).Serialize();
+  info->host = url.host();
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(profile);
+  // Ads: blocked unless the person allowed them here (or everywhere).
+  info->adblock = map->GetContentSetting(url, url, ContentSettingsType::ADS) ==
+                  CONTENT_SETTING_BLOCK;
+  info->adblock_everywhere =
+      map->GetDefaultContentSetting(ContentSettingsType::ADS) ==
+      CONTENT_SETTING_BLOCK;
+  for (const Kind& kind : kKinds) {
+    content_settings::SettingInfo setting_info;
+    const ContentSetting setting = content_settings::ValueToContentSetting(
+        map->GetWebsiteSetting(url, url, kind.setting, &setting_info));
+    const bool is_default =
+        setting_info.primary_pattern == ContentSettingsPattern::Wildcard() &&
+        setting_info.secondary_pattern == ContentSettingsPattern::Wildcard();
+    if (is_default && !kind.always) {
+      continue;
+    }
+    auto permission = mojom::SitePermission::New();
+    permission->type = kind.type;
+    permission->label = kind.label;
+    permission->setting = SettingName(setting);
+    permission->is_default = is_default;
+    info->permissions.push_back(std::move(permission));
+  }
+  return info;
+}
+
+void SetSitePermission(Profile* profile,
+                       content::WebContents* contents,
+                       const std::string& type,
+                       const std::string& setting) {
+  if (!contents) {
+    return;
+  }
+  const GURL url = contents->GetLastCommittedURL();
+  if (!IsWebSite(url)) {
+    return;
+  }
+  ContentSetting value = CONTENT_SETTING_DEFAULT;
+  if (setting == "allow") {
+    value = CONTENT_SETTING_ALLOW;
+  } else if (setting == "block") {
+    value = CONTENT_SETTING_BLOCK;
+  }
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(profile);
+  if (type == "ads") {
+    map->SetContentSettingDefaultScope(url, url, ContentSettingsType::ADS,
+                                       value);
+    return;
+  }
+  const Kind* kind = KindOf(type);
+  if (!kind) {
+    return;
+  }
+  map->SetContentSettingDefaultScope(url, url, kind->setting, value);
+}
+
+void ZoomSite(content::WebContents* contents, int step) {
+  if (!contents) {
+    return;
+  }
+  zoom::PageZoom::Zoom(contents, step > 0   ? content::PAGE_ZOOM_IN
+                                 : step < 0 ? content::PAGE_ZOOM_OUT
+                                            : content::PAGE_ZOOM_RESET);
+}
+
+void ClearSiteData(Profile* profile,
+                   content::WebContents* contents,
+                   base::OnceClosure done) {
+  const GURL url = contents ? contents->GetLastCommittedURL() : GURL();
+  if (!IsWebSite(url)) {
+    std::move(done).Run();
+    return;
+  }
+  // The whole site (example.com and its subdomains), as Chromium's
+  // "Delete data" for a site does.
+  std::string domain = net::registry_controlled_domains::GetDomainAndRegistry(
+      url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  if (domain.empty()) {
+    domain = url.host();
+  }
+  auto filter = content::BrowsingDataFilterBuilder::Create(
+      content::BrowsingDataFilterBuilder::Mode::kDelete);
+  filter->AddRegisterableDomain(domain);
+  profile->GetBrowsingDataRemover()->RemoveWithFilterAndReply(
+      base::Time(), base::Time::Max(),
+      content::BrowsingDataRemover::DATA_TYPE_COOKIES |
+          content::BrowsingDataRemover::DATA_TYPE_DOM_STORAGE |
+          content::BrowsingDataRemover::DATA_TYPE_CACHE,
+      content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB,
+      std::move(filter), new ClearObserver(contents, std::move(done)));
+}
+
+}  // namespace meridian
