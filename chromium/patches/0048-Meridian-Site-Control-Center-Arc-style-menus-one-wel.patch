@@ -0,0 +1,273 @@
+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  position: fixed;
+  left: var(--x, 0);
+  top: var(--y, 0);
+  z-index: 95;
+  display: none;
+  color: var(--meridian-text);
+  font-size: 13px;
+}
+
+:host([open]) {
+  display: block;
+}
+
+button {
+  border: 0;
+  background: none;
+  font: inherit;
+  color: inherit;
+  padding: 0;
+  cursor: default;
+  text-align: left;
+}
+
+svg {
+  display: block;
+}
+
+#card {
+  width: 300px;
+  max-height: calc(100vh - var(--y, 0px) - 16px);
+  overflow-y: auto;
+  padding: 10px;
+  box-sizing: border-box;
+  border-radius: 16px;
+  background: color-mix(in srgb, var(--meridian-surface) 97%, var(--meridian-space));
+  backdrop-filter: blur(24px) saturate(1.6);
+  box-shadow: 0 0 0 0.5px var(--meridian-border),
+      0 16px 48px rgba(0, 0, 0, 0.22), 0 2px 8px rgba(0, 0, 0, 0.08);
+  animation: pop 0.14s cubic-bezier(0.2, 0.8, 0.2, 1);
+  transform-origin: top center;
+  user-select: none;
+}
+
+@keyframes pop {
+  from {
+    opacity: 0;
+    transform: translateY(-4px) scale(0.98);
+  }
+}
+
+.quick {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 6px;
+}
+
+.q {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  height: 52px;
+  border-radius: 11px;
+  background: var(--meridian-surface);
+  box-shadow: 0 0 0 0.5px var(--meridian-border), 0 1px 2px rgba(0, 0, 0, 0.06);
+  font-size: 10.5px;
+  font-weight: 500;
+  color: var(--meridian-text-muted);
+  transition: transform 0.1s, color 0.1s;
+}
+
+.q svg {
+  color: var(--meridian-text);
+}
+
+.q:hover {
+  color: var(--meridian-text);
+}
+
+.q:active {
+  transform: scale(0.97);
+}
+
+.sec {
+  margin: 14px 4px 6px;
+  font-size: 12px;
+  font-weight: 650;
+  color: var(--meridian-text);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.ext {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+}
+
+.ext-add {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 40px;
+  height: 32px;
+  border-radius: 9px;
+  background: color-mix(in srgb, var(--meridian-text) 6%, transparent);
+  color: var(--meridian-text-muted);
+}
+
+.ext-add:hover {
+  color: var(--meridian-text);
+}
+
+.row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  width: 100%;
+  min-height: 44px;
+  padding: 4px 6px;
+  box-sizing: border-box;
+  border-radius: 10px;
+}
+
+button.row:hover {
+  background: color-mix(in srgb, var(--meridian-text) 5%, transparent);
+}
+
+.row-ic {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 32px;
+  height: 32px;
+  flex: none;
+  border-radius: 50%;
+  background: color-mix(in srgb, var(--meridian-text) 8%, transparent);
+  color: var(--meridian-text-muted);
+}
+
+.row.on .row-ic {
+  background: color-mix(in srgb, var(--meridian-space) 22%, transparent);
+  color: var(--meridian-space);
+}
+
+.row-text {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  min-width: 0;
+}
+
+.row-label {
+  font-weight: 600;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.row-sub {
+  font-size: 12px;
+  color: var(--meridian-text-muted);
+}
+
+.row.confirm .row-label {
+  color: #e5484d;
+}
+
+.switch {
+  position: relative;
+  width: 30px;
+  height: 18px;
+  flex: none;
+  border-radius: 9px;
+  background: color-mix(in srgb, var(--meridian-text) 18%, transparent);
+  transition: background 0.15s;
+}
+
+.switch i {
+  position: absolute;
+  top: 2px;
+  left: 2px;
+  width: 14px;
+  height: 14px;
+  border-radius: 50%;
+  background: white;
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
+  transition: transform 0.15s;
+}
+
+.row.on .switch {
+  background: var(--meridian-space);
+}
+
+.row.on .switch i {
+  transform: translateX(12px);
+}
+
+.zoom-btn,
+.zoom-value {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  height: 26px;
+  border-radius: 7px;
+  background: color-mix(in srgb, var(--meridian-text) 6%, transparent);
+}
+
+.zoom-btn {
+  width: 26px;
+}
+
+.zoom-value {
+  min-width: 48px;
+  font-variant-numeric: tabular-nums;
+  font-weight: 500;
+}
+
+.zoom-btn:hover,
+.zoom-value:hover {
+  background: color-mix(in srgb, var(--meridian-text) 11%, transparent);
+}
+
+.foot {
+  display: flex;
+  align-items: center;
+  margin-top: 10px;
+  padding-top: 10px;
+  border-top: 1px solid var(--meridian-border);
+}
+
+.grow {
+  flex: 1;
+}
+
+.security {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  height: 30px;
+  padding: 0 10px;
+  border-radius: 9px;
+  background: color-mix(in srgb, var(--meridian-text) 6%, transparent);
+  font-weight: 600;
+}
+
+.security.insecure,
+.security.dangerous {
+  color: #e5484d;
+}
+
+.more {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 30px;
+  height: 30px;
+  border-radius: 50%;
+  background: color-mix(in srgb, var(--meridian-text) 6%, transparent);
+}
