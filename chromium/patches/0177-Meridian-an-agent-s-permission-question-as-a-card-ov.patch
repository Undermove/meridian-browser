+// One request to Meridian over the guard's socket; its answer ("" when it
+// can't be reached or doesn't answer within `wait_ms`).
+std::string AskMeridian(base::DictValue request, int wait_ms) {
+  const char* socket_path = getenv("MERIDIAN_GUARD_SOCKET");
+  const char* token = getenv("MERIDIAN_GUARD_TOKEN");
+  sockaddr_un addr = {};
+  if (!socket_path || !token || strlen(socket_path) >= sizeof(addr.sun_path)) {
+    return std::string();
+  }
+  request.Set("token", token);
+  std::string line = base::WriteJson(request).value_or("{}") + "\n";
+  int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  addr.sun_family = AF_UNIX;
+  base::span(addr.sun_path)
+      .copy_prefix_from(base::span(std::string_view(socket_path)));
+  std::string answer;
+  if (fd >= 0 &&
+      connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) == 0 &&
+      WriteSocket(fd, line)) {
+    // The person may take a while to decide.
+    pollfd p = {fd, POLLIN, 0};
+    std::array<char, 4096> chunk;
+    while (poll(&p, 1, wait_ms) > 0) {
+      ssize_t n = read(fd, chunk.data(), chunk.size());
+      if (n <= 0) {
+        break;
+      }
+      answer.append(base::as_string_view(
+          base::span(chunk).first(static_cast<size_t>(n))));
+    }
+  }
+  if (fd >= 0) {
+    close(fd);
+  }
+  return answer;
+}
+
+
+// What a permission question is about, in one line: the command, the file,
+// the address, or the input itself.
+std::string Summary(const base::DictValue& input) {
+  for (const char* key : {"command", "file_path", "notebook_path", "url",
+                          "pattern", "path", "query", "description"}) {
+    if (const std::string* v = input.FindString(key); v && !v->empty()) {
+      return v->substr(0, 2000);
+    }
+  }
+  std::string all = base::WriteJson(input).value_or("");
+  return all == "{}" ? std::string() : all.substr(0, 500);
+}
+
+// `Meridian --secret-guard --permission`: Claude Code's PermissionRequest
+// hook. Claude Code asks in the terminal as always; Meridian shows the same
+// question over whatever page the person is on, and whichever answers first
+// counts. stdout: nothing (the terminal decides) or a decision.
+int RunPermissionHook(const base::DictValue& ev) {
+  const std::string* tool = ev.FindString("tool_name");
+  const base::DictValue* raw = ev.FindDict("tool_input");
+  base::DictValue empty;
+  const base::DictValue& input = raw ? *raw : empty;
+  const base::ListValue* suggestions = ev.FindList("permission_suggestions");
+  // A question to the person or a plan to approve needs its answer typed in
+  // the terminal: the card only says so.
+  const bool answerable = !tool || (*tool != "AskUserQuestion" &&
+                                    *tool != "ExitPlanMode");
+  std::string answer = AskMeridian(
+      base::DictValue()
+          .Set("kind", "permission")
+          .Set("tool", tool ? tool->substr(0, 64) : std::string())
+          .Set("summary", Summary(input))
+          .Set("answerable", answerable)
+          .Set("can_always", answerable && suggestions && !suggestions->empty()),
+      590000);
+  std::optional<base::Value> reply = base::JSONReader::Read(
+      base::TrimWhitespaceASCII(answer, base::TRIM_ALL), 0);
+  const std::string* decision =
+      reply && reply->is_dict() ? reply->GetDict().FindString("decision")
+                                : nullptr;
+  if (!answerable || !decision) {
+    return 0;
+  }
+  base::DictValue out;
+  if (*decision == "allow" || *decision == "always") {
+    out.Set("behavior", "allow");
+    if (*decision == "always" && suggestions) {
+      out.Set("updatedPermissions", suggestions->Clone());
+    }
+  } else if (*decision == "deny") {
+    out.Set("behavior", "deny");
+    out.Set("message", "The person denied this in Meridian.");
+  } else {
+    return 0;
+  }
+  std::cout << base::WriteJson(
+                   base::DictValue().Set(
+                       "hookSpecificOutput",
+                       base::DictValue()
+                           .Set("hookEventName", "PermissionRequest")
+                           .Set("decision", std::move(out))))
+                   .value_or("")
+            << std::flush;
+  return 0;
+}
+
