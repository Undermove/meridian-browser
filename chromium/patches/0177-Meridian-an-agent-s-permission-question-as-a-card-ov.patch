+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianAgentAsksElement} from './agent_asks.js';
+import {icon} from './icons.js';
+
+export function getHtml(this: MeridianAgentAsksElement) {
+  return html`<!--_html_template_start_-->
+${this.cards_().map(c => html`
+  <div class="card" role="alertdialog" data-id="${c.ask.id}"
+      aria-label="${c.title} needs you">
+    <header>
+      <span class="mark">C</span>
+      <div class="who">
+        <div class="title">${c.title}</div>
+        ${c.where ? html`<div class="where">${c.where}</div>` : ''}
+      </div>
+      <button class="close" title="Hide (the terminal still asks)"
+          @click="${this.onCloseClick_}">${icon('x', 12)}</button>
+    </header>
+    <div class="what">${c.what}</div>
+    ${c.ask.summary ? html`<div class="summary">${c.ask.summary}</div>` : ''}
+    <div class="actions">
+      ${c.ask.answerable ? html`
+        <button class="allow primary" ?disabled="${this.busy_ === c.ask.id}"
+            @click="${this.onAllowClick_}">Allow</button>
+        <button class="deny" ?disabled="${this.busy_ === c.ask.id}"
+            @click="${this.onDenyClick_}">Deny</button>
+        ${c.ask.canAlways ? html`
+          <button class="always" ?disabled="${this.busy_ === c.ask.id}"
+              @click="${this.onAlwaysClick_}">Always allow</button>` : ''}
+      ` : ''}
+      <button class="open ${c.ask.answerable ? 'quiet' : 'primary'}"
+          @click="${this.onOpenClick_}">Open</button>
+    </div>
+  </div>`)}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/agent_asks.ts b/chrome/browser/resources/webui_browser/meridian/agent_asks.ts
new file mode 100644
index 0000000000..7349eaafcc
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/agent_asks.ts
@@ -0,0 +1,145 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// An agent working in any space needs the person (Claude Code asks for a
+// permission): a small card over whatever page is open says which session,
+// in which space, wants what. Allow / Deny / Always allow answer right here;
+// Open goes to its terminal. The terminal still asks too: whichever answers
+// first counts, and the card goes away.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './agent_asks.css.js';
+import {getHtml} from './agent_asks.html.js';
+import type {MissionAsk, MissionNode, MissionSnapshot} from './mission.js';
+
+export interface AskCard {
+  ask: MissionAsk;
+  title: string;
+  where: string;
+  what: string;
+}
+
+// What the tool is about to do, in words.
+function toolText(tool: string): string {
+  switch (tool) {
+    case 'Bash':
+    case 'PowerShell':
+    case 'Monitor':
+      return 'Run a command';
+    case 'Edit':
+    case 'MultiEdit':
+    case 'Write':
+    case 'NotebookEdit':
+      return 'Change a file';
+    case 'Read':
+    case 'NotebookRead':
+      return 'Read a file';
+    case 'WebFetch':
+      return 'Open a web page';
+    case 'WebSearch':
+      return 'Search the web';
+    case 'AskUserQuestion':
+      return 'Has a question for you';
+    case 'ExitPlanMode':
+      return 'Has a plan for you to approve';
+    default:
+      if (tool.startsWith('mcp__')) {
+        const parts = tool.split('__');
+        return `Use ${parts.slice(2).join(' ').replace(/_/g, ' ')} (${
+            parts[1]})`;
+      }
+      return tool ? `Use ${tool}` : 'Needs your permission';
+  }
+}
+
+export class MeridianAgentAsksElement extends CrLitElement {
+  static get is() {
+    return 'meridian-agent-asks';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      snapshot: {type: Object},
+      hidden_: {state: true, type: Object},
+      busy_: {state: true, type: String},
+    };
+  }
+
+  accessor snapshot: MissionSnapshot|null = null;
+  // Cards closed with ×: the question stays in the terminal.
+  protected accessor hidden_: Set<string> = new Set();
+  protected accessor busy_: string = '';
+
+  protected cards_(): AskCard[] {
+    const s = this.snapshot;
+    const asks: MissionAsk[] = s?.asks || [];
+    const nodes = new Map<string, MissionNode>(
+        (s?.nodes || []).map(n => [n.id, n]));
+    return asks.filter(a => !this.hidden_.has(a.id)).map(ask => {
+      const node = nodes.get(ask.nodeId);
+      const space = node?.spaceId ?
+          (s?.spaces || []).find(sp => sp.id === node.spaceId) :
+          undefined;
+      const agent = node?.source === 'claude' ? 'Claude Code' : 'An agent';
+      const name = node?.label && node.label !== 'Claude Code' ? node.label : '';
+      return {
+        ask,
+        title: name ? `${agent} · ${name}` : agent,
+        where: [space?.name, node?.project].filter(Boolean).join(' · '),
+        what: toolText(ask.tool),
+      };
+    });
+  }
+
+  protected answer_(ask: MissionAsk, choice: string) {
+    this.busy_ = ask.id;
+    this.fire('meridian-ask-answer', {id: ask.id, choice});
+  }
+
+  protected onAllowClick_(e: Event) {
+    this.answer_(this.askOf_(e), 'allow');
+  }
+
+  protected onDenyClick_(e: Event) {
+    this.answer_(this.askOf_(e), 'deny');
+  }
+
+  protected onAlwaysClick_(e: Event) {
+    this.answer_(this.askOf_(e), 'always');
+  }
+
+  protected onOpenClick_(e: Event) {
+    const ask = this.askOf_(e);
+    this.fire('meridian-mission-reveal', {id: ask.nodeId, assistant: false});
+  }
+
+  protected onCloseClick_(e: Event) {
+    const ask = this.askOf_(e);
+    this.hidden_ = new Set([...this.hidden_, ask.id]);
+  }
+
+  private askOf_(e: Event): MissionAsk {
+    const id = (e.currentTarget as HTMLElement).closest<HTMLElement>(
+                                                     '.card')!.dataset['id']!;
+    return this.cards_().find(c => c.ask.id === id)!.ask;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-agent-asks': MeridianAgentAsksElement;
+  }
+}
+
+customElements.define(
+    MeridianAgentAsksElement.is, MeridianAgentAsksElement);
