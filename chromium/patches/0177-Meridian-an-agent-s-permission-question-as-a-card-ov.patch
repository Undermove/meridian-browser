+
+void MissionControl::AskPermission(int owner_tab,
+                                   const std::string& term_id,
+                                   const std::string& tool,
+                                   const std::string& summary,
+                                   bool answerable,
+                                   bool can_always,
+                                   AskDone done) {
+  const Node* session = nullptr;
+  for (const auto& [id, n] : nodes_) {
+    if (n.kind == "session" && n.owner_tab == owner_tab &&
+        n.term_id == term_id && !n.ended_at) {
+      session = &n;
+    }
+  }
+  if (!session) {
+    std::move(done).Run("none");
+    return;
+  }
+  std::string id = "ask-" + RandomId(6);
+  Ask ask;
+  ask.root_id = session->root_id.empty() ? session->id : session->root_id;
+  ask.tool = tool;
+  ask.summary = summary;
+  ask.answerable = answerable;
+  ask.can_always = answerable && can_always;
+  ask.since = Now();
+  ask.done = std::move(done);
+  asks_.emplace(id, std::move(ask));
+  ask_order_.push_back(id);
+  Changed();
+}
+
+bool MissionControl::AnswerPermission(const std::string& id,
+                                      const std::string& choice) {
+  auto it = asks_.find(id);
+  if (it == asks_.end()) {
+    return false;
+  }
+  const Ask& ask = it->second;
+  if (!ask.answerable ||
+      !(choice == "allow" || choice == "deny" ||
+        (choice == "always" && ask.can_always))) {
+    return false;
+  }
+  AskDone done = std::move(it->second.done);
+  asks_.erase(it);
+  std::erase(ask_order_, id);
+  Changed();
+  std::move(done).Run(choice);
+  return true;
+}
+
+void MissionControl::CloseAsks(const std::string& root_id) {
+  std::vector<AskDone> closed;
+  for (auto it = asks_.begin(); it != asks_.end();) {
+    if (it->second.root_id == root_id) {
+      closed.push_back(std::move(it->second.done));
+      std::erase(ask_order_, it->first);
+      it = asks_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  if (closed.empty()) {
+    return;
+  }
+  Changed();
+  for (AskDone& done : closed) {
+    std::move(done).Run("none");
   }
 }
 
