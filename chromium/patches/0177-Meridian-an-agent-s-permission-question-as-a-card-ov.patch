+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  position: fixed;
+  top: 12px;
+  right: 14px;
+  z-index: 65;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  width: min(340px, calc(100vw - 28px));
+  color: var(--meridian-text);
+  font-size: 12.5px;
+  pointer-events: none;
+}
+
+.card {
+  pointer-events: auto;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 11px 12px 10px;
+  border-radius: 12px;
+  background: var(--meridian-surface);
+  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.22),
+    0 0 0 0.5px var(--meridian-border);
+  animation: card-in 160ms ease-out;
+  app-region: no-drag;
+  -webkit-app-region: no-drag;
+}
+
+@keyframes card-in {
+  from {
+    opacity: 0;
+    transform: translateY(-6px);
+  }
+}
+
+header {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+}
+
+.mark {
+  width: 22px;
+  height: 22px;
+  flex: none;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 6px;
+  background: #d97757;
+  color: white;
+  font-size: 12px;
+  font-weight: 700;
+}
+
+.who {
+  flex: 1;
+  min-width: 0;
+}
+
+.title {
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.where {
+  color: var(--meridian-text-muted);
+  font-size: 11.5px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.close {
+  width: 22px;
+  height: 22px;
+  border: 0;
+  border-radius: 6px;
+  background: none;
+  color: var(--meridian-text-muted);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+}
+
+.close:hover {
+  background: var(--meridian-row-hover);
+}
+
+.what {
+  font-weight: 550;
+}
+
+.summary {
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 11.5px;
+  padding: 6px 8px;
+  border-radius: 7px;
+  background: var(--meridian-row-hover);
+  max-height: 4.5em;
+  overflow: hidden;
+  overflow-wrap: anywhere;
+  white-space: pre-wrap;
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 2px;
+}
+
+.actions button {
+  height: 26px;
+  padding: 0 10px;
+  border-radius: 7px;
+  border: 0.5px solid var(--meridian-border);
+  background: var(--meridian-surface);
+  color: var(--meridian-text);
+  font: inherit;
+  font-weight: 550;
+  cursor: pointer;
+}
+
+.actions button:hover {
+  background: var(--meridian-row-hover);
+}
+
+.actions button.primary {
+  background: var(--meridian-space, #6b6fd6);
+  border-color: transparent;
+  color: white;
+}
+
+.actions button.quiet {
+  margin-left: auto;
+  border-color: transparent;
+  background: none;
+}
+
+.actions button:disabled {
+  opacity: 0.6;
+}
