       <img class="player-icon" src="${this.playerFavicon_}" width="16"
diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
index 76c2e195da..392ce38a28 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
@@ -1190,9 +1190,40 @@ export class MeridianSidebarElement extends CrLitElement implements
 
   private async refreshNowPlaying_() {
     const {now} = await this.handler_.getNowPlaying();
+    // Closed with its ×: hidden until that tab plays again (after the pause
+    // the close asked for).
+    const closed = this.playerClosed_;
+    if (now && closed && JSON.stringify(now.tabId) === closed.tab) {
+      if (!now.playing) {
+        closed.paused = true;
+      }
+      if (!now.playing || !closed.paused) {
+        this.nowPlaying_ = null;
+        return;
+      }
+    }
+    if (now) {
+      this.playerClosed_ = null;
+    }
     this.nowPlaying_ = now ?? null;
   }
 
+  // The tab whose player was closed, and whether it has paused since.
+  private playerClosed_: {tab: string, paused: boolean}|null = null;
+
+  protected onPlayerCloseClick_(e: Event) {
+    e.stopPropagation();
+    const now = this.nowPlaying_;
+    if (!now) {
+      return;
+    }
+    if (now.playing) {
+      this.handler_.controlMedia(now.tabId, 'pause');
+    }
+    this.playerClosed_ = {tab: JSON.stringify(now.tabId), paused: !now.playing};
+    this.nowPlaying_ = null;
+  }
+
   protected onPlayerClick_() {
     if (this.nowPlaying_) {
       this.tabStripService_.activateTab(this.nowPlaying_.tabId);
