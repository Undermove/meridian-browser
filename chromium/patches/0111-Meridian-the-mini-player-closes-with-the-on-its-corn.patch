diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.css b/chrome/browser/resources/webui_browser/meridian/sidebar.css
index 55239ac174..b3e1e65a5b 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.css
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.css
@@ -156,6 +156,7 @@ button {
 /* Arc's mini player: what plays in another tab, above the bottom bar. */
 
 .player {
+  position: relative;
   display: flex;
   align-items: center;
   gap: 4px;
@@ -174,6 +175,33 @@ button {
   }
 }
 
+/* Arc: a small × on its corner while the pointer is over it. */
+.player-close {
+  position: absolute;
+  top: -6px;
+  left: -6px;
+  width: 18px;
+  height: 18px;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  background: var(--meridian-surface);
+  color: var(--meridian-text-muted);
+  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
+  opacity: 0;
+  transition: opacity 0.12s ease;
+  cursor: pointer;
+}
+
+.player:hover .player-close,
+.player-close:focus-visible {
+  opacity: 1;
+}
+
+.player-close:hover {
+  color: var(--meridian-text);
+}
+
 .player-main {
   flex: 1;
   min-width: 0;
