From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 19 Nov 2026 23:05:18 +0400
Subject: [PATCH 191/193] Meridian: site searches work in the command bar again
 ("kiwi pear")

The command bar's searchbox enters keyword mode when a keyword and a space
are typed, but its handler (the New Tab page's) said it has no keyword mode,
so the matches came without their keyword and the page left keyword mode at
once: the search went to the default engine. With like_omnibox the handler
supports keyword mode, as the omnibox does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/ui/webui/searchbox/realbox_handler.cc | 7 ++++++-
 chrome/browser/ui/webui/searchbox/realbox_handler.h  | 5 +++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/ui/webui/searchbox/realbox_handler.cc b/chrome/browser/ui/webui/searchbox/realbox_handler.cc
index 17c93d331d..e385294e91 100644
--- a/chrome/browser/ui/webui/searchbox/realbox_handler.cc
+++ b/chrome/browser/ui/webui/searchbox/realbox_handler.cc
@@ -137,7 +137,8 @@ RealboxHandler::RealboxHandler(
           web_contents,
           std::make_unique<RealboxOmniboxClient>(profile, web_contents,
                                                  like_omnibox),
-          std::move(get_session_callback)) {
+          std::move(get_session_callback)),
+      like_omnibox_(like_omnibox) {
   // Set the callback for getting suggest inputs from the session.
   // The session is owned by WebUI controller and accessed via callback.
   // It is safe to use Unretained because omnibox client is owned by `this`.
@@ -147,6 +148,10 @@ RealboxHandler::RealboxHandler(
   autocomplete_controller_observation_.Observe(autocomplete_controller());
 }
 
+bool RealboxHandler::SupportsKeywordMode() const {
+  return like_omnibox_;
+}
+
 std::string RealboxHandler::AutocompleteIconToResourceName(
     const gfx::VectorIcon& icon) const {
   // The default icon for contextual suggestions is the subdirectory arrow right
diff --git a/chrome/browser/ui/webui/searchbox/realbox_handler.h b/chrome/browser/ui/webui/searchbox/realbox_handler.h
index a2498a508e..904e6f0555 100644
--- a/chrome/browser/ui/webui/searchbox/realbox_handler.h
+++ b/chrome/browser/ui/webui/searchbox/realbox_handler.h
@@ -45,8 +45,13 @@ class RealboxHandler : public ContextualSearchboxHandler {
   // SearchboxHandler:
   std::string AutocompleteIconToResourceName(
       const gfx::VectorIcon& icon) const override;
+  // Meridian: the command bar has the omnibox's keyword mode ("kiwi pear"
+  // searches the site "kiwi" is for): matches say which keyword they are
+  // for, or the page leaves keyword mode as soon as it enters it.
+  bool SupportsKeywordMode() const override;
 
  private:
+  const bool like_omnibox_;
   base::WeakPtrFactory<RealboxHandler> weak_ptr_factory_{this};
 };
 
