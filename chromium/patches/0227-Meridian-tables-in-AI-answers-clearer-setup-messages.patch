     }
+    if (startsTable(lines, i)) {
+      const head = cells(line);
+      const aligns = cells(lines[i + 1]!).map(alignOf);
+      i += 2;
+      const rows: string[][] = [];
+      while (i < lines.length && lines[i]!.trim() && lines[i]!.includes('|')) {
+        rows.push(cells(lines[i]!));
+        i++;
+      }
+      const style = (c: number) =>
+          aligns[c] ? `text-align:${aligns[c]}` : '';
+      blocks.push(html`<div class="table-wrap"><table>
+        <thead><tr>${head.map((h, c) => html`<th style="${style(c)}">${
+          inline(h)}</th>`)}</tr></thead>
+        <tbody>${rows.map(r => html`<tr>${head.map((_, c) => html`
+          <td style="${style(c)}">${inline(r[c] || '')}</td>`)}</tr>`)}</tbody>
+      </table></div>`);
+      continue;
+    }
     if (/^\s*([-*•]|\d+[.)])\s+/.test(line)) {
       const ordered = /^\s*\d+[.)]\s+/.test(line);
       const items: Array<Array<TemplateResult|string>> = [];
@@ -110,7 +152,8 @@ export function renderMarkdown(source: string): TemplateResult[] {
