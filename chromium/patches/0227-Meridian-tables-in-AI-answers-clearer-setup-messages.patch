 // A small Markdown renderer for AI answers: paragraphs, headings, lists,
-// code blocks, and inline code, bold, italics and links. It builds Lit
+// tables, code blocks, and inline code, bold, italics and links. It builds Lit
 // templates (never innerHTML), so model output can't inject markup. Links
 // carry data-href and open in a new tab from the panel's click handler.
 // A link whose text isn't its own address also shows the real host, so an
@@ -68,6 +68,29 @@ function inline(text: string): Array<TemplateResult|string> {
   return out;
 }
 
+// A table row's cells; `\|` is a pipe in a cell.
+function cells(line: string): string[] {
+  const row = line.trim().replace(/^\|/, '').replace(/(?<!\\)\|$/, '');
+  return row.split(/(?<!\\)\|/).map(c => c.trim().replace(/\\\|/g, '|'));
+}
+
+function isTableRule(line: string|undefined): boolean {
+  return !!line && line.includes('-') && line.includes('|') &&
+      /^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$/.test(line);
+}
+
+// A header row followed by its |---|---| line.
+function startsTable(lines: string[], i: number): boolean {
+  return lines[i]!.includes('|') && isTableRule(lines[i + 1]) &&
+      cells(lines[i]!).length === cells(lines[i + 1]!).length;
+}
+
+function alignOf(rule: string): string {
+  const left = rule.startsWith(':');
+  const right = rule.endsWith(':');
+  return left && right ? 'center' : right ? 'right' : left ? 'left' : '';
+}
+
 export function renderMarkdown(source: string): TemplateResult[] {
   const lines = source.replace(/\r\n/g, '\n').split('\n');
   const blocks: TemplateResult[] = [];
@@ -91,6 +114,25 @@ export function renderMarkdown(source: string): TemplateResult[] {
       i++;
