diff --git a/chrome/browser/meridian/crash_watcher_mac.cc b/chrome/browser/meridian/crash_watcher_mac.cc
new file mode 100644
index 0000000000..6c1201038d
--- /dev/null
+++ b/chrome/browser/meridian/crash_watcher_mac.cc
@@ -0,0 +1,218 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/crash_watcher_mac.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdlib.h>
+#include <sys/event.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+
+extern char** environ;
+
+namespace meridian {
+
+namespace {
+
+constexpr std::string_view kWatcher = "--meridian-crash-watcher=";
+constexpr std::string_view kUserDataDir = "--user-data-dir=";
+constexpr int kLoopSeconds = 120;
+
+bool StartsWith(std::string_view s, std::string_view prefix) {
+  return s.substr(0, prefix.size()) == prefix;
+}
+
+base::span<const char*> Args(int argc, const char** argv) {
+  // main()'s own arguments.
+  return UNSAFE_BUFFERS(base::span(argv, static_cast<size_t>(argc)));
+}
+
+std::string ValueOf(int argc, const char** argv, std::string_view sw) {
+  for (const char* a : Args(argc, argv).subspan(1u)) {
+    if (a && StartsWith(a, sw)) {
+      return std::string(std::string_view(a).substr(sw.size()));
+    }
+  }
+  return {};
+}
+
+bool Has(int argc, const char** argv, std::string_view prefix) {
+  for (const char* a : Args(argc, argv).subspan(1u)) {
+    if (a && StartsWith(a, prefix)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::string DefaultUserDataDir() {
+  const char* home = getenv("HOME");
+  return std::string(home ? home : "") +
+         "/Library/Application Support/Meridian Browser";
+}
+
+std::string ReadFile(const std::string& path) {
+  std::ifstream in(path, std::ios::binary);
+  std::stringstream s;
+  s << in.rdbuf();
+  return s.str();
+}
+
+// The profile's exit_type: "Crashed" from start until a clean exit writes
+// "Normal" (Chrome's own "restore pages?" signal).
+bool EndedWithoutCleanExit(const std::string& user_data_dir) {
+  std::string prefs = ReadFile(user_data_dir + "/Default/Preferences");
+  return prefs.find("\"exit_type\":\"Crashed\"") != std::string::npos;
+}
+
+// A browser runs on this profile: its SingletonLock points to a live pid.
+bool ProfileInUse(const std::string& user_data_dir) {
+  char target[512];
+  ssize_t n = readlink((user_data_dir + "/SingletonLock").c_str(), target,
+                       sizeof(target) - 1);
+  if (n <= 0) {
+    return false;
+  }
+  std::string lock(target, static_cast<size_t>(n));  // host-pid
+  size_t dash = lock.rfind('-');
+  if (dash == std::string::npos) {
+    return false;
+  }
+  pid_t pid = static_cast<pid_t>(atoi(lock.substr(dash + 1).c_str()));
+  return pid > 0 && (kill(pid, 0) == 0 || errno == EPERM);
+}
+
+// Too soon after the last relaunch: a crash at startup must not loop.
+bool RelaunchedRecently(const std::string& user_data_dir) {
+  struct stat st;
+  std::string mark = user_data_dir + "/Meridian Crash Relaunch";
+  if (stat(mark.c_str(), &st) == 0 &&
+      time(nullptr) - st.st_mtime < kLoopSeconds) {
+    return true;
+  }
+  std::ofstream(mark, std::ios::trunc) << time(nullptr);
+  return false;
+}
+
+pid_t Spawn(const std::vector<std::string>& args, bool detach) {
+  std::vector<char*> argv;
+  for (const std::string& a : args) {
+    argv.push_back(const_cast<char*>(a.c_str()));
+  }
+  argv.push_back(nullptr);
+  posix_spawn_file_actions_t files;
+  posix_spawn_file_actions_init(&files);
+  for (int fd = 0; fd < 3; ++fd) {
+    posix_spawn_file_actions_addopen(&files, fd, "/dev/null",
+                                     fd == 0 ? O_RDONLY : O_WRONLY, 0);
+  }
+  posix_spawnattr_t attr;
+  posix_spawnattr_init(&attr);
+  // Nothing of the browser's (sockets, files) goes along; its own session, so
+  // it outlives the browser.
+  short flags = POSIX_SPAWN_CLOEXEC_DEFAULT;
+  if (detach) {
+    flags |= POSIX_SPAWN_SETSID;
+  }
+  posix_spawnattr_setflags(&attr, flags);
+  pid_t pid = 0;
+  int rv = posix_spawn(&pid, argv[0], &files, &attr, argv.data(), environ);
+  posix_spawnattr_destroy(&attr);
+  posix_spawn_file_actions_destroy(&files);
+  return rv == 0 ? pid : 0;
+}
+
+}  // namespace
+
+void MaybeStartCrashWatcher(int argc, const char** argv) {
+  if (argc < 1 || !Args(argc, argv)[0] || Has(argc, argv, "--type=")) {
+    return;
+  }
+  const bool forced = Has(argc, argv, "--meridian-crash-relaunch");
+  if (!forced && (Has(argc, argv, "--remote-debugging-") ||
+                  Has(argc, argv, "--meridian-no-crash-relaunch") ||
+                  Has(argc, argv, "--headless") ||
+                  Has(argc, argv, "--meridian-test-"))) {
+    return;
+  }
+  // Only the app as installed (…/Meridian.app/Contents/MacOS/Meridian).
+  std::string exe = Args(argc, argv)[0];
+  if (exe.find(".app/Contents/MacOS/") == std::string::npos) {
+    return;
+  }
+  std::vector<std::string> args = {
+      exe, std::string(kWatcher) + std::to_string(getpid())};
+  std::string dir = ValueOf(argc, argv, kUserDataDir);
+  if (!dir.empty()) {
+    args.push_back(std::string(kUserDataDir) + dir);
+  }
+  // Tests: the watcher only leaves its mark (no window on the screen).
+  if (Has(argc, argv, "--meridian-crash-relaunch=dry")) {
+    args.push_back("--meridian-crash-relaunch=dry");
+  }
+  Spawn(args, true);
+}
+
+bool IsCrashWatcher(int argc, const char** argv) {
+  return Has(argc, argv, kWatcher);
+}
+
+int RunCrashWatcher(int argc, const char** argv) {
+  pid_t browser = static_cast<pid_t>(atoi(ValueOf(argc, argv, kWatcher).c_str()));
+  if (browser <= 0) {
+    return 2;
+  }
+  std::string explicit_dir = ValueOf(argc, argv, kUserDataDir);
+  std::string dir = explicit_dir.empty() ? DefaultUserDataDir() : explicit_dir;
+
+  // Until the browser ends.
+  int kq = kqueue();
+  struct kevent change;
+  EV_SET(&change, browser, EVFILT_PROC, EV_ADD | EV_ONESHOT, NOTE_EXIT, 0,
+         nullptr);
+  if (kq < 0 || kevent(kq, &change, 1, nullptr, 0, nullptr) < 0) {
+    return 0;  // Already gone (or not ours to watch).
+  }
+  struct kevent event;
+  while (kevent(kq, nullptr, 0, &event, 1, nullptr) < 0 && errno == EINTR) {
+  }
+  close(kq);
+
+  // Its helpers and the crash reporter finish first.
+  sleep(2);
+  if (!EndedWithoutCleanExit(dir) || ProfileInUse(dir) ||
+      RelaunchedRecently(dir)) {
+    return 0;
+  }
+  if (Has(argc, argv, "--meridian-crash-relaunch=dry")) {
+    std::ofstream(dir + "/Meridian Crash Relaunch", std::ios::trunc)
+        << "would relaunch";
+    return 0;
+  }
+  // The .app, through Launch Services (as from the Dock).
+  std::string exe = Args(argc, argv)[0];
+  std::string app = exe.substr(0, exe.find(".app/Contents/MacOS/") + 4);
+  std::vector<std::string> open = {"/usr/bin/open", "-a", app};
+  if (!explicit_dir.empty()) {
+    open.insert(open.end(), {"-n", "--args", std::string(kUserDataDir) + dir});
+  }
+  pid_t pid = Spawn(open, false);
+  return pid ? 0 : 1;
+}
+
+}  // namespace meridian
