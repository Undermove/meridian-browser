@@ -5,6 +5,9 @@
 #include "chrome/browser/meridian/helper_modes.h"
 
 #include "chrome/browser/meridian/agent/mcp_bridge.h"
+#if BUILDFLAG(IS_MAC)
+#include "chrome/browser/meridian/crash_watcher_mac.h"
+#endif
 #include "chrome/browser/meridian/mission/mission_hook.h"
 #include "chrome/browser/meridian/workbench/guard_hook.h"
 
@@ -37,6 +40,13 @@ std::optional<int> Run(int argc, const char** argv) {
   if (IsMcpBridge(argc, argv)) {
     return RunMcpBridge(argc, argv);
   }
+#if BUILDFLAG(IS_MAC)
+  if (IsCrashWatcher(argc, argv)) {
+    return RunCrashWatcher(argc, argv);
+  }
+  // The browser itself: a watcher reopens it if it crashes.
+  MaybeStartCrashWatcher(argc, argv);
+#endif
   return std::nullopt;
 }
 
