+++ b/chrome/browser/meridian/crash_watcher_mac.h
@@ -0,0 +1,27 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_CRASH_WATCHER_MAC_H_
+#define CHROME_BROWSER_MERIDIAN_CRASH_WATCHER_MAC_H_
+
+namespace meridian {
+
+// If the browser process crashes, everything in it goes: the windows, and the
+// agents working in them. A small watcher (the browser's own binary with
+// `--meridian-crash-watcher=<pid>`, no windows) waits for the browser to end;
+// if it ended without a clean exit (the profile's exit_type is still
+// "Crashed"), it opens Meridian again, which restores the tabs and the
+// agents' sessions. Not when another Meridian already runs on that profile,
+// not twice within two minutes (a crash at startup), and not under tests
+// (--remote-debugging-*), unless --meridian-crash-relaunch asks for it.
+
+// Called for the browser process before it starts: launches the watcher.
+void MaybeStartCrashWatcher(int argc, const char** argv);
+
+bool IsCrashWatcher(int argc, const char** argv);
+int RunCrashWatcher(int argc, const char** argv);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_CRASH_WATCHER_MAC_H_
