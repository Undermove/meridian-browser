 // Agents in the window: a bar naming the agent and what it's doing, with
 // Stop (agents pause until Resume), and, at access level "ask", the
-// question for each action.
+// question for each action: Allow once, Allow for this task (this agent's
+// connection, every site, until it disconnects or for 30 minutes), Always
+// allow (full access), or Deny.
 
 import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
 
@@ -14,10 +16,16 @@ import type {AgentActivity, SidebarHandlerInterface} from '../sidebar.mojom-webu
 import {getCss} from './agent.css.js';
 import {getHtml} from './agent.html.js';
 
+// "once", "task", "always" or "deny".
+export type AgentChoice = 'once'|'task'|'always'|'deny';
+
 interface Question {
   client: string;
   summary: string;
-  answer: (allowed: boolean) => void;
+  // The agent's connection, for an action; '' for the question whether it
+  // may connect at all.
+  task: string;
+  answer: (choice: AgentChoice) => void;
 }
 
 // The bar stays this long after the last action.
@@ -77,7 +85,20 @@ export class MeridianAgentElement extends CrLitElement {
                 this.queue_.push({
                   client,
                   summary,
-                  answer: (allowed: boolean) => resolve({allowed}),
+                  task: '',
+                  answer: (choice: AgentChoice) =>
+                      resolve({allowed: choice !== 'deny'}),
+                });
+                this.next_();
+              })),
+      router.askAgentAction.addListener(
+          (client: string, summary: string, task: string) =>
+              new Promise<{choice: string}>(resolve => {
+                this.queue_.push({
+                  client,
+                  summary,
+                  task,
+                  answer: (choice: AgentChoice) => resolve({choice}),
                 });
                 this.next_();
               })),
@@ -125,10 +146,16 @@ export class MeridianAgentElement extends CrLitElement {
     }
   }
 
-  private answer_(allowed: boolean) {
+  private answer_(choice: AgentChoice) {
     const q = this.question_;
     this.question_ = null;
-    q?.answer(allowed);
+    q?.answer(choice);
+    if (q && choice === 'task' && q.task) {
+      // The same agent's other waiting actions are part of the task too.
+      const same = this.queue_.filter(o => o.task === q.task);
+      this.queue_ = this.queue_.filter(o => o.task !== q.task);
+      same.forEach(o => o.answer('task'));
+    }
     this.next_();
   }
 
@@ -136,7 +163,7 @@ export class MeridianAgentElement extends CrLitElement {
     // Pending questions are denied too.
     this.handler_.setAgentsPaused(true);
     while (this.question_) {
-      this.answer_(false);
+      this.answer_('deny');
     }
   }
 
@@ -148,11 +175,21 @@ export class MeridianAgentElement extends CrLitElement {
     if (performance.now() - this.shownAt_ < ALLOW_DELAY_MS) {
       return;
     }
-    this.answer_(true);
+    this.answer_('once');
+  }
+
+  // This agent's connection acts without asking (on every site, signed-in
+  // ones too) until it disconnects or for 30 minutes (agent_service.cc); its waiting actions
+  // are allowed.
+  protected onTaskClick_() {
+    if (performance.now() - this.shownAt_ < ALLOW_DELAY_MS) {
+      return;
+    }
+    this.answer_('task');
   }
 
   protected onDenyClick_() {
-    this.answer_(false);
+    this.answer_('deny');
   }
 
   // Don't ask again: agents get full control (Settings > AI > Agent access
@@ -165,14 +202,14 @@ export class MeridianAgentElement extends CrLitElement {
     const {settings} = await this.handler_.getSettings();
     this.handler_.setSettings({...settings, agentAccess: 'full'});
     while (this.question_) {
-      this.answer_(true);
+      this.answer_(this.question_.task ? 'always' : 'once');
     }
   }
 
   protected onCardKeydown_(e: KeyboardEvent) {
     if (e.key === 'Escape') {
       e.preventDefault();
-      this.answer_(false);
+      this.answer_('deny');
     }
   }
 }
