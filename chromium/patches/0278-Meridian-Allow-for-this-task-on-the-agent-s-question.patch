+  std::map<std::string, base::TimeTicks> task_grants_;
   // Each client's current tab (the last it opened or used).
   std::map<std::string, tabs::TabHandle> current_tab_;
   // Tabs an agent works in stay awake (not frozen or throttled in the
diff --git a/chrome/browser/meridian/sidebar.mojom b/chrome/browser/meridian/sidebar.mojom
index 748c1c2c61..ebd3e27b07 100644
--- a/chrome/browser/meridian/sidebar.mojom
+++ b/chrome/browser/meridian/sidebar.mojom
@@ -570,6 +570,13 @@ interface SidebarPage {
   // "leave" when the pointer leaves the link.
   OnLinkPreview(string phase, string url, string title, string summary,
                 string host, string error);
+
+  // Access level "ask": the person answers one action. `task` names the
+  // agent's connection (an app, until it disconnects): "once", "task" (this
+  // connection may act without asking for 30 minutes), "always" (agent
+  // access set to full) or "deny".
+  AskAgentAction(string client, string summary, string task)
+      => (string choice);
 };
 
 interface SidebarHandler {
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index 7e9878db6d..e129d3af33 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -1123,6 +1123,23 @@ void SidebarHandler::AskAgent(BrowserWindowInterface* browser,
       mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(done), false));
 }
 
+void SidebarHandler::AskAgentAction(
+    BrowserWindowInterface* browser,
+    const std::string& client,
+    const std::string& summary,
+    const std::string& task,
+    base::OnceCallback<void(const std::string&)> done) {
+  SidebarHandler* handler = For(browser);
+  if (!handler || !handler->page_.is_connected()) {
+    std::move(done).Run("deny");
+    return;
+  }
+  handler->page_->AskAgentAction(
+      client, summary, task,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(done),
+                                                  std::string("deny")));
+}
+
 namespace {
 
 // The AI features' question goes to the frontmost Meridian window of the
diff --git a/chrome/browser/meridian/sidebar_handler.h b/chrome/browser/meridian/sidebar_handler.h
