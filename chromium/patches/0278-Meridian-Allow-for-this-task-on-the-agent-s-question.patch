diff --git a/chrome/browser/meridian/agent/agent_service.cc b/chrome/browser/meridian/agent/agent_service.cc
index 0519a4756f..c90e350cb9 100644
--- a/chrome/browser/meridian/agent/agent_service.cc
+++ b/chrome/browser/meridian/agent/agent_service.cc
@@ -92,6 +92,9 @@ namespace {
 
 constexpr int kRead = 1, kAsk = 2, kFull = 3;
 
+// How long "Allow for this task" lasts at most.
+constexpr base::TimeDelta kTaskGrant = base::Minutes(30);
+
 int Rank(const std::string& access) {
   return access == "full"   ? kFull
          : access == "ask"  ? kAsk
@@ -780,6 +783,7 @@ const base::ListValue& AgentService::Tools() {
 }
 
 void AgentService::OnAccessChanged() {
+  task_grants_.clear();
   // Off by the person's decision: nothing listens. Not decided yet: the
   // private socket is there so that a connected agent can ask.
   bool on = Rank(profile_->GetPrefs()->GetString(prefs::kAgentAccess)) > 0 ||
@@ -796,6 +800,9 @@ void AgentService::OnAccessChanged() {
 
 void AgentService::SetPaused(bool paused) {
   paused_ = paused;
+  if (paused) {
+    task_grants_.clear();
+  }
   if (BrowserWindowInterface* window = Window()) {
     SidebarHandler::AgentActivity(window, std::string(), std::string(),
                                   std::string(), std::string(), paused_);
@@ -1113,15 +1120,30 @@ void AgentService::Confirm(
   if (!call->StillOnSameDocument()) {
     return call->Fail("The page changed, so nothing was done. Look at it again.");
   }
-  SidebarHandler::AskAgent(
-      window, client, summary,
+  // The agent's connection: its name and its bridge process (a new one
+  // when it reconnects).
+  std::string task = client + " · " + call->caller.client_id;
+  if (auto it = task_grants_.find(task); it != task_grants_.end()) {
+    if (base::TimeTicks::Now() < it->second) {
+      std::move(then).Run(std::move(call));
+      return;
+    }
+    task_grants_.erase(it);
+  }
+  SidebarHandler::AskAgentAction(
+      window, client, summary, task,
       base::BindOnce(
-          [](std::unique_ptr<Call> call,
+          [](base::WeakPtr<AgentService> self, std::string task,
+             std::unique_ptr<Call> call,
              base::OnceCallback<void(std::unique_ptr<Call>)> then,
-             bool allowed) {
-            if (!allowed) {
+             const std::string& choice) {
+            if (choice != "once" && choice != "task" && choice != "always") {
               return call->Fail("The person declined this action.");
             }
+            if (choice == "task" && self) {
+              self->task_grants_[task] =
+                  base::TimeTicks::Now() + kTaskGrant;
+            }
             if (!call->StillOnSameDocument()) {
               return call->Fail(
                   "The page changed while waiting for approval, so nothing "
@@ -1129,7 +1151,8 @@ void AgentService::Confirm(
             }
             std::move(then).Run(std::move(call));
           },
-          std::move(call), std::move(then)));
+          weak_factory_.GetWeakPtr(), task, std::move(call),
+          std::move(then)));
 }
 
 void AgentService::RunInPage(content::WebContents* contents,
