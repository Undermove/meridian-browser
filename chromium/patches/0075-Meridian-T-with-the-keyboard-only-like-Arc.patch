-  protected onOverlayKeydown_(e: KeyboardEvent) {
-    if (e.key === 'Enter' && e.metaKey) {
+  // Before the field sees the key (capture): the arrows go through one list,
+  // the suggestions and then the open tabs, like Arc's; with nothing typed,
+  // just the tabs (the field would fetch suggestions nobody asked for).
+  private onKeydownCapture_ = (e: KeyboardEvent) => {
+    if (!this.open) {
+      return;
+    }
+    const own = () => {
       e.preventDefault();
       e.stopPropagation();
+    };
+    if (e.key === 'Enter' && e.metaKey) {
+      own();
       this.ask_();
       return;
     }
     if (e.key === 'Escape') {
-      e.preventDefault();
-      e.stopPropagation();
+      own();
       this.hide();
       return;
     }
     // ⇥ takes the other layout's reading.
     if (e.key === 'Tab' && !e.shiftKey && this.layoutFix_) {
-      e.preventDefault();
-      e.stopPropagation();
+      own();
       this.applyLayoutFix_();
       return;
     }
-    // With nothing typed, the arrows go through the open tabs.
-    if (!this.query_.trim() && this.tabRows_.length &&
-        (e.key === 'ArrowDown' || e.key === 'ArrowUp' ||
-         (e.key === 'Enter' && this.tabSel_ >= 0))) {
-      e.preventDefault();
-      e.stopPropagation();
-      if (e.key === 'Enter') {
-        this.switchTo_(this.tabRows_[this.tabSel_]!.id);
-        return;
+    if (e.key === 'Enter' && this.tabSel_ >= 0 &&
+        this.tabSel_ < this.tabRows_.length) {
+      own();
+      this.switchTo_(this.tabRows_[this.tabSel_]!.id);
+      return;
+    }
+    if ((e.key !== 'ArrowDown' && e.key !== 'ArrowUp') || e.altKey ||
+        e.ctrlKey || e.metaKey || e.shiftKey) {
+      return;
+    }
+    own();
+    const box = this.$.address;
+    const matches = this.query_.trim() ? box.matchCount() : 0;
+    const total = matches + this.tabRows_.length;
+    if (!total) {
+      return;
+    }
+    const at = this.tabSel_ >= 0 ? matches + this.tabSel_ : box.selectedLine();
+    const next = e.key === 'ArrowDown' ? (at + 1) % total :
+                                         (at < 0 ? total - 1 :
+                                                   (at - 1 + total) % total);
+    if (next < matches) {
+      this.tabSel_ = -1;
+      box.selectLine(next);
+    } else {
+      this.tabSel_ = next - matches;
+      if (matches) {
+        box.selectLine(-1);
       }
-      const n = this.tabRows_.length;
-      this.tabSel_ = e.key === 'ArrowDown' ? (this.tabSel_ + 1) % n :
-                                             (this.tabSel_ - 1 + n) % n;
     }
-  }
+  };
 
