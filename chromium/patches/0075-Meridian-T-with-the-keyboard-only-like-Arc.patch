+  // Meridian: the command bar's own rows share the arrows with the
+  // suggestions, so it moves the selection itself.
+  matchCount(): number {
+    return this.dropdownIsVisible ?
+        this.getDropdownElement().selectableMatchElements.length :
+        0;
+  }
+
+  selectedLine(): number {
+    return this.dropdownIsVisible ? this.selectedMatchIndex : -1;
+  }
+
+  // -1: none (the field shows what was typed). Like an arrow in the
+  // omnibox, it stops the suggestions coming, so they stay where they are.
+  async selectLine(line: number) {
+    this.pageHandler().stopAutocomplete(/*clearResult=*/ false);
+    const dropdown = this.getDropdownElement();
+    if (line < 0) {
+      dropdown.unselect();
+    } else {
+      dropdown.selectIndex(line);
+    }
+    await dropdown.updateComplete;
+    await this.updateComplete;
+    this.fillInputForSelection({line, state: SelectionLineState.kNormal,
+                                actionIndex: 0});
+  }
+
   // Meridian: the command bar draws the suggestions inside its own card
