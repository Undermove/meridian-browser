 WebUIBrowserWebContentsDelegate::PreHandleKeyboardEvent(
     content::WebContents* source,
     const input::NativeWebKeyboardEvent& event) {
+  // Meridian: Escape typed in this page itself (not in a tab it shows, nor a
+  // full-screen tab's Escape passed up) is this page's: it closes the command
+  // bar and the other overlays. Before, a tab still loading took it
+  // (IDC_CLOSE_FIND_OR_STOP).
+  content::RenderFrameHost* focused = source->GetFocusedFrame();
+  if (event.windows_key_code == ui::VKEY_ESCAPE &&
+      !(event.GetModifiers() & blink::WebInputEvent::kKeyModifiers) &&
+      focused && content::WebContents::FromRenderFrameHost(focused) == source) {
+    return content::KeyboardEventProcessingResult::NOT_HANDLED;
+  }
   return window_->PreHandleKeyboardEvent(event);
 }
 
