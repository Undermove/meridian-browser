Subject: [PATCH 210/210] Meridian: an adopted Claude Code session draws itself
 again (a resize, not a bare SIGWINCH)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/workbench/terminal.cc    | 16 ++++++++++++++++
 chrome/browser/meridian/workbench/terminal.h     |  4 ++++
 .../browser/meridian/workbench/terminal_win.cc   |  2 ++
 .../meridian/workbench/workbench_handler.cc      |  4 ++--
 4 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/meridian/workbench/terminal.cc b/chrome/browser/meridian/workbench/terminal.cc
index ed3a5f5692..d7e064589f 100644
--- a/chrome/browser/meridian/workbench/terminal.cc
+++ b/chrome/browser/meridian/workbench/terminal.cc
@@ -311,6 +311,22 @@ std::unique_ptr<Terminal> Terminal::Adopt(int pid,
   return terminal;
 }
 
+void Terminal::Redraw() {
+  if (pid_ <= 0 || !io_) {
+    return;
+  }
+  winsize size = {};
+  if (ioctl(io_->master(), TIOCGWINSZ, &size) != 0 || size.ws_col < 3) {
+    return;
+  }
+  winsize narrower = size;
+  --narrower.ws_col;
+  io_->Resize(narrower);
+  base::ThreadPool::PostDelayedTask(
+      FROM_HERE, {base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&Io::Resize, io_, size), base::Milliseconds(200));
+}
+
 int Terminal::DupMaster() const {
   if (pid_ <= 0 || !io_) {
     return -1;
diff --git a/chrome/browser/meridian/workbench/terminal.h b/chrome/browser/meridian/workbench/terminal.h
index 04d44d8cef..48c3c41162 100644
--- a/chrome/browser/meridian/workbench/terminal.h
+++ b/chrome/browser/meridian/workbench/terminal.h
@@ -64,6 +64,10 @@ class Terminal {
   // the process outlives a crash of the browser), or -1.
   int DupMaster() const;
 
+  // A full-screen program (Claude Code) draws itself again: one column
+  // narrower for a moment, then back (the same size again changes nothing).
+  void Redraw();
+
  private:
   class Io;
   explicit Terminal(int pid);
diff --git a/chrome/browser/meridian/workbench/terminal_win.cc b/chrome/browser/meridian/workbench/terminal_win.cc
index 416832421c..d01fadc6d2 100644
--- a/chrome/browser/meridian/workbench/terminal_win.cc
+++ b/chrome/browser/meridian/workbench/terminal_win.cc
@@ -323,6 +323,8 @@ std::unique_ptr<Terminal> Terminal::Adopt(int, int, DataCallback, ExitCallback)
   return nullptr;
 }
 
+void Terminal::Redraw() {}
+
 int Terminal::DupMaster() const {
   return -1;
 }
diff --git a/chrome/browser/meridian/workbench/workbench_handler.cc b/chrome/browser/meridian/workbench/workbench_handler.cc
index 26cc508f4d..2a7030198e 100644
--- a/chrome/browser/meridian/workbench/workbench_handler.cc
+++ b/chrome/browser/meridian/workbench/workbench_handler.cc
@@ -2464,11 +2464,11 @@ void WorkbenchHandler::OnAdopted(
         mission->AttachTerminal(registration.node_id, id);
       }
     }
-    const int pid = term.terminal->pid();
+    Terminal* adopted = term.terminal.get();
     terms_[id] = std::move(term);
     KeepInHost(id);
     // A full-screen program (Claude Code) draws itself again.
-    kill(-pid, SIGWINCH);
+    adopted->Redraw();
   }
 #endif
   base::ListValue list;
