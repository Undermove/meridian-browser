+std::string SpaceNameKey(std::string_view name) {
+  const std::u16string folded =
+      base::i18n::FoldCase(base::UTF8ToUTF16(name));
+  std::u16string key;
+  bool gap = false;
+  size_t i = 0;
+  while (i < folded.size()) {
+    base_icu::UChar32 c;
+    CBU16_NEXT(folded, i, folded.size(), c);
+    if (u_isalnum(c)) {
+      if (gap && !key.empty()) {
+        key.push_back(u' ');
+      }
+      gap = false;
+      if (c > 0xFFFF) {
+        key.push_back(static_cast<char16_t>(((c - 0x10000) >> 10) + 0xD800));
+        key.push_back(static_cast<char16_t>(((c - 0x10000) & 0x3FF) + 0xDC00));
+      } else {
+        key.push_back(static_cast<char16_t>(c));
+      }
+    } else {
+      // Emoji, punctuation, spaces: between words at most.
+      gap = true;
+    }
+  }
+  return base::UTF16ToUTF8(key);
+}
+
+void LeaveOutKnownSpaces(std::vector<Space>& proposed,
+                         const std::vector<Space>& existing) {
+  std::set<std::string> taken;
+  const bool replaced = existing.size() == 1 && existing[0].pinned.empty();
+  if (!replaced) {
+    for (const Space& space : existing) {
+      taken.insert(SpaceNameKey(space.name));
+    }
+  }
+  std::erase_if(proposed, [&](const Space& space) {
+    const std::string key = SpaceNameKey(space.name);
+    // A name of emoji alone is compared as it is.
+    return !taken.insert(key.empty() ? space.name : key).second;
+  });
+}
+
 }  // namespace meridian
diff --git a/chrome/browser/meridian/setup_profile.h b/chrome/browser/meridian/setup_profile.h
index 04a678c89e..357bad8904 100644
--- a/chrome/browser/meridian/setup_profile.h
+++ b/chrome/browser/meridian/setup_profile.h
@@ -53,6 +53,19 @@ SetupProposal ProposeSetup(const std::vector<std::string>& apps,
                            std::string_view persona = {},
                            bool strong_dev = false);
 
+// A space's name as two names are compared: letters and digits only, in
+// lower case, words one space apart ("💼 Work", "work" and "WORK!" are the
+// same name; "Работа" and "работа" too).
+std::string SpaceNameKey(std::string_view name);
+
+// The tour's suggested spaces (from the apps or the AI) without those the
+// person already has by that name (SpaceNameKey), or that come twice: moving
+// in from Arc brought "Work", so the tour's "Work" is the same space, not a
+// second one. A lone empty first space, which the setup replaces, doesn't
+// count. A space the person makes themselves later may share a name.
+void LeaveOutKnownSpaces(std::vector<Space>& proposed,
+                         const std::vector<Space>& existing);
+
 }  // namespace meridian
 
 #endif  // CHROME_BROWSER_MERIDIAN_SETUP_PROFILE_H_
diff --git a/chrome/browser/meridian/setup_profile_unittest.cc b/chrome/browser/meridian/setup_profile_unittest.cc
index ca6654a237..f823af63b9 100644
--- a/chrome/browser/meridian/setup_profile_unittest.cc
+++ b/chrome/browser/meridian/setup_profile_unittest.cc
@@ -62,5 +62,58 @@ TEST(SetupProfileTest, PersonaOverridesTheGuess) {
   EXPECT_EQ(ProposeSetup({"Xcode"}, "en", "bogus").persona, "developer");
 }
 
+Space Named(const std::string& name, bool with_tab = true) {
+  Space space;
+  space.name = name;
+  if (with_tab) {
+    Item tab;
+    tab.title = "A tab";
+    space.pinned.push_back(tab);
+  }
+  return space;
+}
+
+std::vector<std::string> Names(const std::vector<Space>& spaces) {
+  std::vector<std::string> out;
+  for (const Space& space : spaces) {
+    out.push_back(space.name);
+  }
+  return out;
+}
+
+TEST(SetupProfileTest, SpaceNamesCompareWithoutCaseOrEmoji) {
+  EXPECT_EQ(SpaceNameKey("Work"), "work");
+  EXPECT_EQ(SpaceNameKey("💼 Work"), SpaceNameKey("work"));
+  EXPECT_EQ(SpaceNameKey("WORK!"), "work");
+  EXPECT_EQ(SpaceNameKey("  Side   project 🚀"), "side project");
+  EXPECT_EQ(SpaceNameKey("Работа"), SpaceNameKey("работа"));
+  EXPECT_NE(SpaceNameKey("Work"), SpaceNameKey("Home"));
+}
+
+// Arc brought "Work" and "Home"; the tour's setup (the apps' or the AI's)
+// suggests "Work" and "Personal": the result is Work, Home, Personal.
+TEST(SetupProfileTest, SuggestedSpacesMergeWithTheOnesThePersonHas) {
+  std::vector<Space> arc = {Named("Work"), Named("🏠 Home")};
+  std::vector<Space> proposed = {Named("💼 work", false), Named("Personal", false),
+                                 Named("HOME", false), Named("personal", false)};
+  LeaveOutKnownSpaces(proposed, arc);
+  EXPECT_EQ(Names(proposed), (std::vector<std::string>{"Personal"}));
+
+  SetupProposal dev =
+      ProposeSetup({"Visual Studio Code"}, "en", "developer", true);
+  ASSERT_EQ(Names(dev.spaces), (std::vector<std::string>{"Work", "Personal"}));
+  LeaveOutKnownSpaces(dev.spaces, arc);
+  EXPECT_EQ(Names(dev.spaces), (std::vector<std::string>{"Personal"}));
+}
+
+// The lone empty space of a new profile is replaced by the setup, so its
+// name is free.
+TEST(SetupProfileTest, TheUntouchedFirstSpaceDoesNotTakeAName) {
+  std::vector<Space> fresh = {Named("Personal", false)};
+  std::vector<Space> proposed = {Named("Work", false), Named("Personal", false)};
+  LeaveOutKnownSpaces(proposed, fresh);
+  EXPECT_EQ(Names(proposed), (std::vector<std::string>{"Work", "Personal"}));
+}
+
 }  // namespace
 }  // namespace meridian
