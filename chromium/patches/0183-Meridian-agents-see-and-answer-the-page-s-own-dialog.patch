+// The page's own dialog (alert, confirm, prompt, or "Leave site?") that the
+// tab shows or waits to show: the renderer stands still until it's answered.
+// Permission prompts, file pickers and sign-in dialogs aren't these.
+struct PageDialog {
+  std::string type;  // alert, confirm, prompt, beforeunload
+  std::string message;
+  std::string default_prompt;
+};
+
+std::optional<PageDialog> PageDialogOf(content::WebContents* contents) {
+  if (!contents) {
+    return std::nullopt;
+  }
+  if (auto* manager =
+          javascript_dialogs::TabModalDialogManager::FromWebContents(contents)) {
+    if (auto open = manager->GetOpenDialog()) {
+      PageDialog d;
+      d.type = open->type == content::JAVASCRIPT_DIALOG_TYPE_CONFIRM ? "confirm"
+               : open->type == content::JAVASCRIPT_DIALOG_TYPE_PROMPT
+                   ? "prompt"
+                   : "alert";
+      d.message = base::UTF16ToUTF8(open->message);
+      d.default_prompt = base::UTF16ToUTF8(open->default_prompt);
+      return d;
+    }
+  }
+  // "Leave site?" and others the app-modal queue shows for this tab.
+  javascript_dialogs::AppModalDialogQueue* queue =
+      javascript_dialogs::AppModalDialogQueue::GetInstance();
+  std::vector<javascript_dialogs::AppModalDialogController*> dialogs;
+  if (queue->active_dialog()) {
+    dialogs.push_back(queue->active_dialog());
+  }
+  for (auto& d : *queue) {
+    dialogs.push_back(d.get());
+  }
+  for (auto* d : dialogs) {
+    if (d->web_contents() != contents) {
+      continue;
+    }
+    PageDialog out;
+    out.type = d->is_before_unload_dialog() ? "beforeunload"
+               : d->javascript_dialog_type() ==
+                       content::JAVASCRIPT_DIALOG_TYPE_CONFIRM
+                   ? "confirm"
+               : d->javascript_dialog_type() ==
+                       content::JAVASCRIPT_DIALOG_TYPE_PROMPT
+                   ? "prompt"
+                   : "alert";
+    out.message = d->is_before_unload_dialog()
+                      ? std::string("Leave site? Changes you made may not be saved.")
+                      : base::UTF16ToUTF8(d->message_text());
+    out.default_prompt = base::UTF16ToUTF8(d->default_prompt_text());
+    return out;
+  }
+  return std::nullopt;
+}
+
+base::ListValue DialogButtons(const PageDialog& d) {
+  base::ListValue b;
+  if (d.type == "beforeunload") {
+    b.Append("Leave (accept)");
+    b.Append("Cancel (dismiss)");
+  } else if (d.type == "alert") {
+    b.Append("OK (accept)");
+  } else {
+    b.Append("OK (accept)");
+    b.Append("Cancel (dismiss)");
+  }
+  return b;
+}
+
+base::DictValue DialogValue(const PageDialog& d) {
+  base::DictValue v;
+  v.Set("type", d.type);
+  v.Set("message", d.message);
+  v.Set("buttons", DialogButtons(d));
+  if (d.type == "prompt") {
+    v.Set("default_text", d.default_prompt);
+  }
+  return v;
+}
+
+std::string DialogError(const PageDialog& d) {
+  std::string message = d.message.size() > 200 ? d.message.substr(0, 200) + "…"
+                                                : d.message;
+  return "The tab has an open " + d.type + " dialog: \"" + message +
+         "\". The page waits for it: answer it with handle_dialog (accept or "
+         "dismiss).";
+}
