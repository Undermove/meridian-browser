+// ------------------------------------------------------------------ dialogs
+
+void AgentService::HandleDialog(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail(kNoTab);
+  }
+  Activity(*call, tab);
+  std::optional<PageDialog> dialog = PageDialogOf(tab->GetContents());
+  if (!dialog) {
+    return call->Fail("The tab has no open dialog.");
+  }
+  const std::string action = call->StrOr("action", "");
+  if (action != "accept" && action != "dismiss") {
+    return call->Fail("action is \"accept\" or \"dismiss\".");
+  }
+  const bool accept = action == "accept";
+  std::string what =
+      dialog->type == "beforeunload"
+          ? (accept ? "leave the page (unsaved changes there are lost)"
+                    : "stay on the page")
+          : (accept ? "answer OK to the page's " + dialog->type
+                    : "answer Cancel to the page's " + dialog->type);
+  Confirm(std::move(call), what + ": \"" + dialog->message.substr(0, 160) + "\"",
+          base::BindOnce(
+              [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+                 bool accept, std::unique_ptr<Call> call) {
+                tabs::TabInterface* tab = handle.Get();
+                if (!self || !tab) {
+                  return call->Fail("the tab is gone");
+                }
+                content::WebContents* contents = tab->GetContents();
+                std::optional<PageDialog> dialog = PageDialogOf(contents);
+                if (!dialog) {
+                  return call->Fail("The dialog was already closed.");
+                }
+                std::u16string text = base::UTF8ToUTF16(
+                    call->StrOr("prompt_text", dialog->default_prompt));
+                auto* manager =
+                    javascript_dialogs::TabModalDialogManager::FromWebContents(
+                        contents);
+                bool handled = false;
+                if (manager) {
+                  handled =
+                      manager->HandleJavaScriptDialog(contents, accept, &text);
+                } else {
+                  handled = javascript_dialogs::AppModalDialogManager::
+                                GetInstance()
+                                    ->HandleJavaScriptDialog(contents, accept,
+                                                             &text);
+                }
+                if (!handled) {
+                  return call->Fail("Meridian couldn't answer that dialog.");
+                }
+                base::DictValue out;
+                out.Set("handled", true);
+                out.Set("type", dialog->type);
+                out.Set("accepted", accept);
+                if (dialog->type == "prompt" && accept) {
+                  out.Set("text", base::UTF16ToUTF8(text));
+                }
+                call->Ok(base::Value(std::move(out)));
+              },
+              weak_factory_.GetWeakPtr(), tab->GetHandle(), accept));
+}
