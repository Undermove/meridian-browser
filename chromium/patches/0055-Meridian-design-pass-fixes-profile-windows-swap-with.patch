@@ -18,6 +18,9 @@ void SetOverFullscreen(BrowserWindowInterface* browser, bool over);
 // Runs `exited` once, when `browser` has left full screen.
 void OnFullscreenExit(BrowserWindowInterface* browser,
                       base::OnceClosure exited);
+// Shows `target` right behind `front`, without macOS's window animation, so
+// it can paint before `front` goes away (a swap with no blank frame).
+void ShowBehind(BrowserWindowInterface* target, BrowserWindowInterface* front);
 
 }  // namespace meridian
 
diff --git a/chrome/browser/meridian/profile_windows_mac.mm b/chrome/browser/meridian/profile_windows_mac.mm
index cc1ce477f4..6f4a5472a9 100644
--- a/chrome/browser/meridian/profile_windows_mac.mm
+++ b/chrome/browser/meridian/profile_windows_mac.mm
@@ -58,4 +58,17 @@ void OnFullscreenExit(BrowserWindowInterface* browser,
               }];
 }
 
+void ShowBehind(BrowserWindowInterface* target, BrowserWindowInterface* front) {
+  NSWindow* window = WindowOf(target);
+  NSWindow* over = WindowOf(front);
+  if (!window || !over) {
+    target->GetWindow()->Show();
+    return;
+  }
+  window.animationBehavior = NSWindowAnimationBehaviorNone;
+  over.animationBehavior = NSWindowAnimationBehaviorNone;
+  target->GetWindow()->ShowInactive();
+  [window orderWindow:NSWindowBelow relativeTo:over.windowNumber];
+}
+
 }  // namespace meridian
