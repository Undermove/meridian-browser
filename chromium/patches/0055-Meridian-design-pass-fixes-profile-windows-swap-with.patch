+// Brings `target` (already showing behind `current`) to the front and hides
+// `current` once it has had time to paint: a new window needs its first
+// frame, a hidden one a fresh one. Either may have closed meanwhile.
+void SwapSoon(int frame,
+              BrowserWindowInterface* target,
+              BrowserWindowInterface* current,
+              bool fresh) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](int frame, BrowserWindowInterface* target,
+             BrowserWindowInterface* current) {
+            Frames& f = F();
+            auto in_frame = [&](BrowserWindowInterface* b) {
+              auto it = f.frame_of.find(b);
+              return it != f.frame_of.end() && it->second == frame;
+            };
+            if (!in_frame(target) || f.visible_of[frame] != target) {
+              return;
+            }
+            target->GetWindow()->Activate();
+            if (current && in_frame(current)) {
+              current->GetWindow()->Hide();
+            }
+          },
+          frame, target, current),
+      fresh ? base::Milliseconds(350) : base::Milliseconds(120));
+}
+
 void Open(BrowserWindowInterface* target,
           const std::string& space_id,
           const std::vector<GURL>& urls) {
