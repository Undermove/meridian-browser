+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianMemberCardElement} from './member_card.js';
+
+export function getHtml(this: MeridianMemberCardElement) {
+  return html`<!--_html_template_start_-->
+<div id="card" style="${this.colors_}" @pointermove="${this.onPointermove_}"
+    @pointerleave="${this.onPointerleave_}">
+  <div class="sheen"></div>
+  <div class="top">
+    <svg class="mark" viewBox="230 400 564 330" aria-hidden="true">
+      <path d="M260 680 A252 252 0 0 1 764 680" fill="none"
+          stroke="currentColor" stroke-width="84" stroke-linecap="round"></path>
+      <circle cx="512" cy="680" r="46" fill="currentColor"></circle>
+    </svg>
+    <span class="word">Meridian</span>
+    <span class="no">No. ${this.number_}</span>
+  </div>
+  <div class="bottom">
+    <div class="who">
+      ${this.editing_ ? html`
+        <input class="name-input" .value="${this.shownName_}" maxlength="40"
+            spellcheck="false" aria-label="Name on your card"
+            @keydown="${this.onNameKeydown_}" @blur="${this.onNameBlur_}">` : html`
+        <button id="name" class="name" title="Change name"
+            @click="${this.onNameClick_}">${this.shownName_}</button>`}
+      <div class="since">Member since ${this.sinceText_}</div>
+    </div>
+    <div class="stats">
+      ${this.stats_.map(s => html`
+        <div class="stat"><b>${s.value}</b><span>${s.label}</span></div>`)}
+    </div>
+  </div>
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/member_card.ts b/chrome/browser/resources/webui_browser/meridian/member_card.ts
new file mode 100644
index 0000000000..fa06d00f12
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/member_card.ts
@@ -0,0 +1,150 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The member card at the top of Settings, like Arc's: your name, since when
+// you've used Meridian, in your space's colours. It tilts toward the pointer
+// with a holographic sheen; click the name to change it.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {Space} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './member_card.css.js';
+import {getHtml} from './member_card.html.js';
+
+export interface MemberStat {
+  value: string;
+  label: string;
+}
+
+export class MeridianMemberCardElement extends CrLitElement {
+  static get is() {
+    return 'meridian-member-card';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      name: {type: String},
+      defaultName: {type: String},
+      since: {type: Number},
+      spaces: {type: Array},
+      editing_: {state: true, type: Boolean},
+      shownName_: {state: true, type: String},
+      sinceText_: {state: true, type: String},
+      number_: {state: true, type: String},
+      stats_: {state: true, type: Array},
+      colors_: {state: true, type: String},
+    };
+  }
+
+  accessor name: string = '';
+  accessor defaultName: string = '';
+  // Milliseconds since the epoch.
+  accessor since: number = 0;
+  accessor spaces: Space[] = [];
+  protected accessor editing_: boolean = false;
+  protected accessor shownName_: string = '';
+  protected accessor sinceText_: string = '';
+  protected accessor number_: string = '';
+  protected accessor stats_: MemberStat[] = [];
+  protected accessor colors_: string = '';
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    this.shownName_ = this.name || this.defaultName || 'Meridian Member';
+    const since = this.since || Date.now();
+    this.sinceText_ = new Date(since).toLocaleDateString(
+        undefined, {month: 'long', year: 'numeric'});
+    // A stable member number from when the profile began.
+    this.number_ = String(Math.floor(since / 1000) % 100000000)
+                       .padStart(8, '0')
+                       .replace(/(\d{4})(\d{4})/, '$1 $2');
+    const first = this.spaces[0];
+    const c1 = first?.color || '#8a8fe0';
+    const c2 = this.spaces.find(s => s.color && s.color !== c1)?.color ||
+        first?.color2 || '#e48aa5';
+    this.colors_ = `--c1:${c1};--c2:${c2 === c1 ? '#e48aa5' : c2}`;
+    const pinned = this.spaces.reduce((n, s) => n + s.pinned.length, 0);
+    const days = Math.max(1, Math.round((Date.now() - since) / 86400000));
+    const fmt = (n: number) => n.toLocaleString();
+    this.stats_ = [
+      {value: fmt(this.spaces.length),
+       label: this.spaces.length === 1 ? 'space' : 'spaces'},
+      {value: fmt(pinned), label: 'pinned'},
+      {value: fmt(days), label: days === 1 ? 'day' : 'days'},
+    ];
+  }
+
+  override updated(changed: PropertyValues<this>) {
+    super.updated(changed);
+    if (changed.has('editing_' as keyof MeridianMemberCardElement) &&
+        this.editing_) {
+      const input = this.shadowRoot.querySelector<HTMLInputElement>('input');
+      input?.focus();
+      input?.select();
+    }
+  }
+
+  protected onPointermove_(e: PointerEvent) {
+    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      return;
+    }
+    const card = e.currentTarget as HTMLElement;
+    const r = card.getBoundingClientRect();
+    const x = (e.clientX - r.left) / r.width;
+    const y = (e.clientY - r.top) / r.height;
+    card.style.setProperty('--rx', `${(0.5 - y) * 14}deg`);
+    card.style.setProperty('--ry', `${(x - 0.5) * 18}deg`);
+    card.style.setProperty('--mx', `${x * 100}%`);
+    card.style.setProperty('--my', `${y * 100}%`);
+    card.classList.add('tilt');
+  }
+
+  protected onPointerleave_(e: PointerEvent) {
+    const card = e.currentTarget as HTMLElement;
+    card.classList.remove('tilt');
+    card.style.setProperty('--rx', '0deg');
+    card.style.setProperty('--ry', '0deg');
+  }
+
+  protected onNameClick_() {
+    this.editing_ = true;
+  }
+
+  protected onNameKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      (e.target as HTMLInputElement).blur();
+    } else if (e.key === 'Escape') {
+      e.stopPropagation();
+      this.editing_ = false;
+    }
+  }
+
