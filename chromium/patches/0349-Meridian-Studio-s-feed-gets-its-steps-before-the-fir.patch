diff --git a/chrome/browser/meridian/mission/mission_hook_unittest.cc b/chrome/browser/meridian/mission/mission_hook_unittest.cc
index f0fe94de3a..ba158115e3 100644
--- a/chrome/browser/meridian/mission/mission_hook_unittest.cc
+++ b/chrome/browser/meridian/mission/mission_hook_unittest.cc
@@ -50,6 +50,20 @@ TEST(MissionHookTest, SummarizesWithoutInputs) {
   EXPECT_EQ(*line.FindString("summary"), "meridian › navigate · example.com");
 }
 
+// Every hook event names the session's transcript; Mission Control keeps it
+// from the first one (Studio's feed reads the steps from it before any status
+// line).
+TEST(MissionHookTest, HookEventsCarryTheTranscript) {
+  base::DictValue line = FromClaudeEvent(Parse(R"({
+    "hook_event_name": "SessionStart", "session_id": "s1", "source": "startup",
+    "transcript_path": "/Users/me/.claude/projects/p/s1.jsonl"})"));
+  EXPECT_EQ(*line.FindString("transcript_path"),
+            "/Users/me/.claude/projects/p/s1.jsonl");
+  line = FromClaudeEvent(Parse(R"({"hook_event_name": "PreToolUse",
+    "tool_name": "Read", "tool_input": {}})"));
+  EXPECT_FALSE(line.Find("transcript_path"));
+}
