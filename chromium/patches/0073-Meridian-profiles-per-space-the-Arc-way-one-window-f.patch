+// static
+void TabData::Save(content::WebContents* contents) {
+  if (TabData* data = FromWebContents(contents)) {
+    data->Persist();
+  }
+}
+
+// static
+std::map<std::string, std::string> TabData::ExtraDataFor(
+    const std::string& space_id,
+    const std::string& profile_id) {
+  return {{kSpaceKey, space_id}, {kProfileKey, profile_id}};
+}
+
+// static
+std::map<std::string, std::string> TabData::ExtraDataOf(
+    content::WebContents* contents) {
+  const TabData* data = Get(contents);
+  if (!data) {
+    return {};
+  }
+  std::map<std::string, std::string> extra = ExtraDataFor(
+      data->space_id(), meridian::ProfileIdOf(Profile::FromBrowserContext(
+                            contents->GetBrowserContext())));
+  extra[kItemKey] = data->item_id();
+  return extra;
+}
+
+// static
+std::string TabData::ProfileIdOf(
+    const std::map<std::string, std::string>& extra_data) {
+  auto profile = extra_data.find(kProfileKey);
+  return profile == extra_data.end() ? std::string() : profile->second;
+}
