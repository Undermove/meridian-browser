@@ -0,0 +1,305 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/space_profiles.h"
+
+#include <map>
+#include <memory>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/meridian/little_window.h"
+#include "chrome/browser/meridian/prefs.h"
+#include "chrome/browser/meridian/sidebar_service.h"
+#include "chrome/browser/meridian/sidebar_service_factory.h"
+#include "chrome/browser/meridian/tab_data.h"
+#include "chrome/browser/profiles/keep_alive/profile_keep_alive_types.h"
+#include "chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/tab_contents/tab_util.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/browser_window/public/create_browser_window.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/base_window.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr char kPrefix[] = "Meridian Profile ";
+
+// Space profiles kept loaded: their tabs are in the main profile's windows,
+// which keep only that one alive.
+std::map<Profile*, std::unique_ptr<ScopedProfileKeepAlive>>& KeptAlive() {
+  static base::NoDestructor<
+      std::map<Profile*, std::unique_ptr<ScopedProfileKeepAlive>>>
+      kept;
+  return *kept;
+}
+
+void KeepAlive(Profile* profile) {
+  if (!KeptAlive().contains(profile)) {
+    KeptAlive()[profile] = std::make_unique<ScopedProfileKeepAlive>(
+        profile, ProfileKeepAliveOrigin::kBrowserWindow);
+  }
+}
+
+// The active space of `browser`'s sidebar, if it has loaded.
+const Space* ActiveSpace(BrowserWindowInterface* browser) {
+  SidebarService* service =
+      SidebarServiceFactory::GetForProfile(browser->GetProfile());
+  return service ? service->FindSpace(service->active_space_id()) : nullptr;
+}
+
+}  // namespace
+
+std::string ProfileIdOf(Profile* profile) {
+  std::string base = profile->GetOriginalProfile()->GetPath().BaseName().value();
+  return base.starts_with(kPrefix) ? base : std::string();
+}
+
+bool IsSpaceProfile(Profile* profile) {
+  return !ProfileIdOf(profile).empty();
+}
+
+base::FilePath ProfilePathFor(const std::string& profile_id) {
+  const base::FilePath& dir = g_browser_process->profile_manager()->user_data_dir();
+  return profile_id.empty()
+             ? dir.Append(ProfileManager::GetInitialProfileDir())
+             : dir.Append(profile_id);
+}
+
+Profile* MainProfileFor(Profile* profile) {
+  if (!IsSpaceProfile(profile)) {
+    return profile;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  base::FilePath main = ProfilePathFor(std::string());
+  if (Profile* loaded = manager->GetProfileByPath(main)) {
+    return loaded;
+  }
+  // Only after a restart with just another profile's windows open (loads
+  // synchronously; ProfileImpl allows its own blocking).
+  return manager->GetProfile(main);
+}
+
+std::string NewProfileId(const std::vector<std::string>& taken) {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  ProfileAttributesStorage& known = manager->GetProfileAttributesStorage();
+  for (int n = 1;; ++n) {
+    std::string id = kPrefix + base::NumberToString(n);
+    if (std::ranges::find(taken, id) == taken.end() &&
+        !known.GetProfileAttributesWithPath(
+            manager->user_data_dir().Append(id))) {
+      return id;
+    }
+  }
+}
+
+Profile* LoadSpaceProfile(Profile* main, const std::string& profile_id) {
+  if (profile_id.empty()) {
+    return main;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  base::FilePath path = ProfilePathFor(profile_id);
+  Profile* profile = manager->GetProfileByPath(path);
+  if (!profile) {
+    // Loads synchronously; ProfileImpl allows its own blocking. Rare: the
+    // space profiles load in the background at startup.
+    profile = manager->GetProfile(path);
+  }
+  if (profile) {
+    KeepAlive(profile);
+  }
+  return profile;
+}
+
+void PreloadSpaceProfiles(Profile* main) {
+  SidebarService* service = SidebarServiceFactory::GetForProfile(main);
+  if (!service) {
+    return;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  for (const Space& space : service->spaces()) {
+    if (space.profile.empty()) {
+      continue;
+    }
+    if (Profile* loaded =
+            manager->GetProfileByPath(ProfilePathFor(space.profile))) {
+      KeepAlive(loaded);
+      continue;
+    }
+    manager->CreateProfileAsync(ProfilePathFor(space.profile),
+                                base::BindOnce([](Profile* profile) {
+                                  if (profile) {
+                                    KeepAlive(profile);
+                                  }
+                                }));
+  }
+}
+
+bool HoldsSpaceTabs(BrowserWindowInterface* browser) {
+  return browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         !IsLittleWindow(browser) && !browser->GetProfile()->IsOffTheRecord() &&
+         !IsSpaceProfile(browser->GetProfile());
+}
+
+Profile* ProfileForNewTab(BrowserWindowInterface* browser, Profile* source) {
+  Profile* own = browser->GetProfile();
+  if (!HoldsSpaceTabs(browser)) {
+    return own;
+  }
+  if (source && source != own && !source->IsOffTheRecord() &&
+      IsSpaceProfile(source)) {
+    return source;
+  }
+  if (source == own) {
+    return own;
+  }
+  const Space* space = ActiveSpace(browser);
+  Profile* profile = space ? LoadSpaceProfile(own, space->profile) : nullptr;
+  return profile ? profile : own;
+}
+
+content::WebContents* OpenInSpace(BrowserWindowInterface* browser,
+                                  const std::string& space_id,
+                                  const GURL& url,
+                                  bool active,
+                                  const std::string& item_id) {
+  Profile* profile = browser->GetProfile();
+  SidebarService* service = SidebarServiceFactory::GetForProfile(profile);
+  const Space* space = service ? service->FindSpace(space_id) : nullptr;
+  if (space && HoldsSpaceTabs(browser)) {
+    if (Profile* own = LoadSpaceProfile(profile, space->profile)) {
+      profile = own;
+    }
+  }
+  content::WebContents::CreateParams params(
+      profile, tab_util::GetSiteInstanceForNewTab(profile, url));
+  params.initially_hidden = !active;
+  std::unique_ptr<content::WebContents> created =
+      content::WebContents::Create(params);
+  content::WebContents* contents = created.get();
+  // Its space before the sidebar sees it; saved with the session once it is
+  // in the window.
+  TabData::Set(contents, space_id, item_id);
+  TabStripModel* model = browser->GetTabStripModel();
+  model->InsertWebContentsAt(model->count(), std::move(created),
+                             active ? AddTabTypes::ADD_ACTIVE
+                                    : AddTabTypes::ADD_NONE);
+  contents->GetController().LoadURL(url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                    std::string());
+  TabData::Save(contents);
+  return contents;
+}
+
+Profile* ProfileForRestoredTab(
+    BrowserWindowInterface* browser,
+    const std::map<std::string, std::string>& extra_data) {
+  Profile* own = browser->GetProfile();
+  std::string profile_id = TabData::ProfileIdOf(extra_data);
+  if (!HoldsSpaceTabs(browser) || profile_id.empty()) {
+    return own;
+  }
+  // Never a profile deleted meanwhile (loading it would make it again).
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+          ProfilePathFor(profile_id))) {
+    return own;
+  }
+  Profile* profile = LoadSpaceProfile(own, profile_id);
+  return profile ? profile : own;
+}
+
+void GatherSpaceWindows() {
+  BrowserWindowInterface* into = nullptr;
+  std::vector<BrowserWindowInterface*> strays;
+  std::vector<BrowserWindowInterface*> mains;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* b) {
+        if (b->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+            IsLittleWindow(b) || b->GetProfile()->IsOffTheRecord()) {
+          return true;
+        }
+        if (IsSpaceProfile(b->GetProfile())) {
+          strays.push_back(b);
+        } else if (!into) {
+          into = b;
+        } else {
+          mains.push_back(b);
+        }
+        return true;
+      });
+  Profile* main = into ? into->GetProfile()
+                 : strays.empty()
+                     ? nullptr
+                     : MainProfileFor(strays.front()->GetProfile());
+  if (!main) {
+    return;
+  }
+  // Once, right after the first start with this model (the restored
+  // windows): the old window swapping left the main profile's windows
+  // scattered too. Windows opened later stay.
+  static bool first_call = true;
+  if (first_call && !main->GetPrefs()->GetBoolean(prefs::kWindowsGathered)) {
+    strays.insert(strays.end(), mains.begin(), mains.end());
+  }
+  first_call = false;
+  main->GetPrefs()->SetBoolean(prefs::kWindowsGathered, true);
+  if (strays.empty()) {
+    return;
+  }
+  if (!into) {
+    BrowserWindowCreateParams params(*main, /*from_user_gesture=*/false);
+    params.initial_bounds = strays.front()->GetWindow()->GetBounds();
+    params.should_trigger_session_restore = false;
+    into = CreateBrowserWindow(std::move(params));
+    if (!into) {
+      return;
+    }
+    into->GetWindow()->Show();
+  }
+  TabStripModel* to = into->GetTabStripModel();
+  for (BrowserWindowInterface* stray : strays) {
+    // Its tabs outlive its window.
+    if (IsSpaceProfile(stray->GetProfile())) {
+      KeepAlive(stray->GetProfile());
+    }
+    TabStripModel* from = stray->GetTabStripModel();
+    for (int i = 0; i < from->count(); ++i) {
+      if (std::optional<split_tabs::SplitTabId> split =
+              from->GetTabAtIndex(i)->GetSplit()) {
+        from->RemoveSplit(*split);
+      }
+    }
+    while (from->count()) {
+      std::unique_ptr<tabs::TabModel> tab = from->DetachTabAtForInsertion(0);
+      // Pinned tabs of the old windows were Chromium's, not the sidebar's.
+      tab->SetPinned(false);
+      to->InsertDetachedTabAt(to->count(), std::move(tab), AddTabTypes::ADD_NONE);
+    }
+    stray->GetWindow()->Close();
+  }
+  // The moved tabs' pages were recorded in their old window's session (another
+  // profile's, maybe): this one's records them all again.
+  if (SessionService* session =
+          SessionServiceFactory::GetForProfile(into->GetProfile())) {
+    session->ResetFromCurrentBrowsers();
+  }
+}
+
+}  // namespace meridian
