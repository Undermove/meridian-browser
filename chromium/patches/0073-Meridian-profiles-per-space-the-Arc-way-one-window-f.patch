-struct Frames {
-  int next = 1;
-  std::map<BrowserWindowInterface*, int> frame_of;
-  std::map<int, BrowserWindowInterface*> visible_of;
-  std::map<BrowserWindowInterface*, base::CallbackListSubscription> closing;
-};
-
-Frames& F() {
-  static base::NoDestructor<Frames> frames;
-  return *frames;
-}
-
-void OnClosed(BrowserWindowInterface* browser) {
-  Frames& f = F();
-  f.closing.erase(browser);
-  auto it = f.frame_of.find(browser);
-  if (it == f.frame_of.end()) {
-    return;
-  }
-  int id = it->second;
-  f.frame_of.erase(it);
-  if (f.visible_of[id] != browser) {
-    return;
-  }
-  f.visible_of.erase(id);
-  // The frame closes with its visible window.
-  std::vector<BrowserWindowInterface*> hidden;
-  for (auto& [b, frame] : f.frame_of) {
-    if (frame == id) {
-      hidden.push_back(b);
-    }
-  }
-  for (BrowserWindowInterface* b : hidden) {
-    f.frame_of.erase(b);
-    b->GetWindow()->Close();
-  }
-}
