@@ -0,0 +1,77 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_SPACE_PROFILES_H_
+#define CHROME_BROWSER_MERIDIAN_SPACE_PROFILES_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+
+class BrowserWindowInterface;
+class GURL;
+class Profile;
+
+namespace content {
+class WebContents;
+}
+
+namespace meridian {
+
+// Spaces with their own profile, Arc's model on Chromium: every Meridian
+// profile is a Chromium profile ("Meridian Profile N" next to the main one)
+// with its own cookies, history and logins. A Meridian window is the main
+// profile's and holds the tabs of every space, whatever their profile: a
+// space's tabs are made in its profile, so switching spaces never changes
+// windows. The sidebar model is the main profile's (SidebarServiceFactory).
+
+// "" for the main profile (or any profile Meridian didn't create), else the
+// profile's folder name.
+std::string ProfileIdOf(Profile* profile);
+bool IsSpaceProfile(Profile* profile);
+// The folder of a Meridian profile id.
+base::FilePath ProfilePathFor(const std::string& profile_id);
+// The main profile, loaded if it isn't yet (blocking then).
+Profile* MainProfileFor(Profile* profile);
+// A folder name for a new profile, unused on disk and in `taken`.
+std::string NewProfileId(const std::vector<std::string>& taken);
+
+// The profile of a Meridian profile id, loaded if it isn't yet (blocking
+// then) and kept loaded while the app runs: its tabs live in windows of the
+// main profile, which don't keep it alive. nullptr if it can't be loaded.
+Profile* LoadSpaceProfile(Profile* main, const std::string& profile_id);
+// Loads the profiles of all spaces in the background, so a switch to one
+// doesn't wait for it.
+void PreloadSpaceProfiles(Profile* main);
+
+// Whether `browser` holds tabs of every profile: a normal window of the main
+// profile, not a Little Window or a private one.
+bool HoldsSpaceTabs(BrowserWindowInterface* browser);
+// The profile for a new tab in `browser`: the profile of `source` (the page it
+// is opened from) if it has one, else the active space's. The browser's own
+// for any other window.
+Profile* ProfileForNewTab(BrowserWindowInterface* browser, Profile* source);
+// Opens `url` as a new tab of `space_id` (the live tab of `item_id`, if not
+// empty) at the end of `browser`, made in the space's profile.
+content::WebContents* OpenInSpace(BrowserWindowInterface* browser,
+                                  const std::string& space_id,
+                                  const GURL& url,
+                                  bool active,
+                                  const std::string& item_id = std::string());
+// The profile for a tab of `browser` restored from the session, by its saved
+// space (`extra_data`).
+Profile* ProfileForRestoredTab(
+    BrowserWindowInterface* browser,
+    const std::map<std::string, std::string>& extra_data);
+// Windows of space profiles (left from when every profile had its own
+// window) give their tabs to a window that holds space tabs, and close. The
+// first run with this also gathers the main profile's extra windows: the old
+// window swapping left many behind.
+void GatherSpaceWindows();
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_SPACE_PROFILES_H_
