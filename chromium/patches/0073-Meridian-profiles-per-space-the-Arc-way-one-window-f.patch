-    : profile_(profile),
-      changed_(std::move(changed)),
-      notifier_(profile->GetDownloadManager(), this) {}
+    : profile_(profile), changed_(std::move(changed)) {
+  Watch(profile);
+}
 
 DownloadsTracker::~DownloadsTracker() = default;
 
+void DownloadsTracker::Watch(Profile* profile) {
+  content::DownloadManager* manager = profile->GetDownloadManager();
+  if (std::ranges::none_of(notifiers_, [&](const auto& notifier) {
+        return notifier->GetManager() == manager;
+      })) {
+    notifiers_.push_back(
+        std::make_unique<download::AllDownloadItemNotifier>(manager, this));
+  }
+}
+
 download::DownloadItem* DownloadsTracker::Find(const std::string& id) {
-  content::DownloadManager* manager = notifier_.GetManager();
-  return manager ? manager->GetDownloadByGuid(id) : nullptr;
+  for (const auto& notifier : notifiers_) {
+    content::DownloadManager* manager = notifier->GetManager();
+    if (download::DownloadItem* item =
+            manager ? manager->GetDownloadByGuid(id) : nullptr) {
+      return item;
+    }
+  }
+  return nullptr;
 }
 
 std::vector<mojom::DownloadPtr> DownloadsTracker::List() {
