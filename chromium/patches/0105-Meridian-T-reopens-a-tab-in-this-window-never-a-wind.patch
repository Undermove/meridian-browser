@@ -21,6 +23,8 @@ constexpr char kItemKey[] = "meridian.item";
 // The tab's Meridian profile: it comes back in it (session restore runs
 // before the sidebar model, which knows the spaces' profiles, has loaded).
 constexpr char kProfileKey[] = "meridian.profile";
+// A closed Peek's pinned item.
+constexpr char kPeekKey[] = "meridian.peek";
 }  // namespace
 
 TabData::TabData(content::WebContents* contents)
@@ -53,6 +57,25 @@ void TabData::SetPeek(content::WebContents* contents, bool peek) {
   FromWebContents(contents)->peek_ = peek;
 }
 
+// static
+std::map<std::string, std::string> TabData::PeekExtraDataOf(
+    content::WebContents* contents,
+    content::WebContents* opener) {
+  const TabData* data = Get(contents);
+  const TabData* over = opener ? Get(opener) : nullptr;
+  if (!data || !data->peek() || !over || over->item_id().empty()) {
+    return {};
+  }
+  return {{kPeekKey, over->item_id()}};
+}
+
+// static
+std::string TabData::TakeRestoredPeek(content::WebContents* contents) {
+  TabData* data = FromWebContents(contents);
+  return data ? std::exchange(data->restored_peek_, std::string())
+              : std::string();
+}
+
 // static
 void TabData::RestoreFromExtraData(
     content::WebContents* contents,
@@ -66,6 +89,9 @@ void TabData::RestoreFromExtraData(
   data->space_id_ = space->second;
   auto item = extra_data.find(kItemKey);
   data->item_id_ = item == extra_data.end() ? std::string() : item->second;
+  auto peek = extra_data.find(kPeekKey);
+  data->restored_peek_ =
+      peek == extra_data.end() ? std::string() : peek->second;
 }
 
 // static
