diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index af21cea527..fac7616299 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -1968,6 +1968,16 @@ void SidebarHandler::OnTabStripModelChanged(
       // With this window's session (it may come from another window).
       TabData::Save(inserted.tab->GetContents());
       MaybePeek(inserted.tab);
+      // A Peek reopened by ⇧⌘T: a Peek again, over its pinned tab if that is
+      // open (Arc); otherwise an ordinary Today tab.
+      std::string peek_over =
+          TabData::TakeRestoredPeek(inserted.tab->GetContents());
+      if (tabs::TabInterface* over =
+              peek_over.empty() ? nullptr : LiveTabOf(peek_over)) {
+        model()->SetOpenerOfTabAt(model()->GetIndexOfTab(inserted.tab),
+                                  over);
+        TabData::SetPeek(inserted.tab->GetContents(), true);
+      }
     }
   }
   // A closed Today tab goes to the archive (not when the window closes).
