 namespace chrome {
 namespace {
@@ -112,6 +115,28 @@ void RestoreTab(BrowserWindowInterface* browser) {
     sessions::LiveTabContext* const live_tab_context =
         BrowserLiveTabContext::From(browser);
     CHECK(live_tab_context);
+    // Meridian (Arc): ⇧⌘T reopens a tab, not a window. The windows an earlier
+    // run closed as it quit came back with the session at launch: skip them.
+    // A window closed with a single tab (a Little window) gives back its tab,
+    // here.
+    while (!service->entries().empty()) {
+      const sessions::tab_restore::Entry& entry = *service->entries().front();
+      if (entry.type != sessions::tab_restore::Type::WINDOW) {
+        break;
+      }
+      const auto& window =
+          static_cast<const sessions::tab_restore::Window&>(entry);
+      if (window.timestamp < base::Process::Current().CreationTime()) {
+        service->RemoveEntryById(window.id);
+        continue;
+      }
+      if (window.tabs.size() == 1u) {
+        service->RestoreEntryById(live_tab_context, window.tabs.front()->id,
+                                  WindowOpenDisposition::kUnknown);
+        return;
+      }
+      break;
+    }
     service->RestoreMostRecentEntry(live_tab_context);
     return;
   }
