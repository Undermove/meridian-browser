+- (BOOL)undoWithoutTextInput:(id)sender {
+  // Arc: ⌘Z outside a text field reopens the last closed tab, like ⇧⌘T. Sent
+  // the way the menu sends ⇧⌘T, to this view's browser window.
+  NSWindow* window = self.nsView.window;
+  if (!window) {
+    return NO;
+  }
+  NSMenuItem* item = [[NSMenuItem alloc] init];
+  item.tag = IDC_RESTORE_TAB;
+  return [NSApp sendAction:@selector(commandDispatch:) to:window from:item];
+}
