+namespace {
+
+// Arc's extensions being added to one profile. The person granted their
+// permissions in Arc, so they are granted here too, and each is turned on
+// when it arrives (an extension added by sync waits for its permissions
+// otherwise). Deletes itself once all arrived, or with the profile.
+class ArcExtensionsArrival : public extensions::ExtensionRegistryObserver {
+ public:
+  ArcExtensionsArrival(Profile* profile, std::set<std::string> ids)
+      : profile_(profile), ids_(std::move(ids)) {
+    observation_.Observe(extensions::ExtensionRegistry::Get(profile));
+  }
+
+  void OnExtensionInstalled(content::BrowserContext* browser_context,
+                            const extensions::Extension* extension,
+                            bool is_update) override {
+    if (!ids_.erase(extension->id())) {
+      return;
+    }
+    // After the install's own permission check.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<Profile> profile, std::string id) {
+              if (!profile) {
+                return;
+              }
+              const extensions::Extension* extension =
+                  extensions::ExtensionRegistry::Get(profile.get())
+                      ->GetInstalledExtension(id);
+              if (!extension) {
+                return;
+              }
+              extensions::PermissionsUpdater(profile.get())
+                  .GrantActivePermissions(extension);
+              extensions::ExtensionPrefs::Get(profile.get())
+                  ->RemoveDisableReason(
+                      id, extensions::disable_reason::
+                              DISABLE_PERMISSIONS_INCREASE);
+              extensions::ExtensionRegistrar::Get(profile.get())
+                  ->EnableExtension(id);
+            },
+            profile_->GetWeakPtr(), extension->id()));
+    if (ids_.empty()) {
+      delete this;
+    }
+  }
+
+  void OnShutdown(extensions::ExtensionRegistry* registry) override {
+    delete this;
+  }
+
+ private:
+  raw_ptr<Profile> profile_;
+  std::set<std::string> ids_;
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      observation_{this};
+};
+
+}  // namespace
