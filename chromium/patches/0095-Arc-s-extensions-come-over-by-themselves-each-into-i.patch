+Profile* SidebarHandler::ActiveSpaceProfile() {
+  Profile* main = MainProfileFor(browser_->GetProfile());
+  const Space* space = service_->FindSpace(service_->active_space_id());
+  return space ? LoadSpaceProfile(main, space->profile) : main;
+}
+
+void SidebarHandler::AddArcExtensions() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadArcExtensions),
+      base::BindOnce(&SidebarHandler::OnArcExtensionsRead,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SidebarHandler::OnArcExtensionsRead(std::vector<ArcExtension> found) {
+  // Tests serve their own extensions, not signed by the Web Store (with
+  // --apps-gallery-update-url).
+  if (HasTestSwitch("meridian-test-unsigned-store")) {
+    static base::NoDestructor<base::AutoReset<bool>> unsigned_store(
+        extensions::DisablePublisherKeyVerificationForTests());
+  }
+  Profile* main = MainProfileFor(browser_->GetProfile());
+  PrefService* prefs = main->GetPrefs();
+  std::set<std::string> done;
+  for (const base::Value& id : prefs->GetList(prefs::kArcExtensionsAdded)) {
+    if (id.is_string()) {
+      done.insert(id.GetString());
+    }
+  }
+  std::map<Profile*, std::set<std::string>> added;
+  std::set<std::string> now_done;
+  for (const ArcExtension& e : found) {
+    // Only into Meridian's own profiles: the main one and the spaces'.
+    if (done.contains(e.profile) ||
+        (!e.profile.empty() && !service_->FindProfile(e.profile))) {
+      continue;
+    }
+    Profile* profile = LoadSpaceProfile(main, e.profile);
+    if (!profile) {
+      continue;
+    }
+    now_done.insert(e.profile);
+    if (extensions::ExtensionRegistry::Get(profile)->GetExtensionById(
+            e.id, extensions::ExtensionRegistry::EVERYTHING)) {
+      continue;
+    }
+    if (extensions::PendingExtensionManager::Get(profile)->AddFromSync(
+            e.id, extension_urls::GetWebstoreUpdateUrl(), base::Version(),
+            [](const extensions::Extension* extension,
+               content::BrowserContext*) { return !extension->is_theme(); },
+            /*remote_install=*/false)) {
+      added[profile].insert(e.id);
+    }
+  }
+  for (auto& [profile, ids] : added) {
+    new ArcExtensionsArrival(profile, std::move(ids));
+    extensions::ExtensionSystem::Get(profile)
+        ->extension_service()
+        ->CheckForUpdatesSoon();
+  }
+  if (!now_done.empty()) {
+    ScopedListPrefUpdate update(prefs, prefs::kArcExtensionsAdded);
+    for (const std::string& id : now_done) {
+      update->Append(id);
+    }
+  }
+}
