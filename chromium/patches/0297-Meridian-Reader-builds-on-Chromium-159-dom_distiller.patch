From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Wed, 25 Nov 2026 21:52:07 +0400
Subject: [PATCH] Meridian: Reader builds on Chromium 159 (dom_distiller is
 web_distiller and reader_mode now)

Chromium 159 renamed components/dom_distiller to components/web_distiller and
chrome/browser/dom_distiller to chrome/browser/reader_mode; the readability
check is RunHeuristicsOnWebContents there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/sidebar_handler.cc | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index f9d73280b7..30af781d99 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -144,9 +144,9 @@
 #include "components/sessions/content/content_serialized_navigation_builder.h"
 #include "components/sessions/core/serialized_navigation_entry.h"
 #include "content/public/browser/navigation_entry.h"
-#include "chrome/browser/dom_distiller/tab_utils.h"
+#include "chrome/browser/reader_mode/tab_utils.h"
 #include "chrome/browser/meridian/live_folders.h"
-#include "components/dom_distiller/core/url_utils.h"
+#include "components/web_distiller/core/url_utils.h"
 #include "chrome/browser/resource_coordinator/tab_lifecycle_unit_external.h"
 #include "chrome/browser/resource_coordinator/lifecycle_unit_state.mojom.h"
 #include "chrome/browser/media/webrtc/media_capture_devices_dispatcher.h"
@@ -579,12 +579,12 @@ void SidebarHandler::ToggleReader(ToggleReaderCallback callback) {
   content::WebContents* contents = tab->GetContents();
   // The reading view still on its way in (Exit pressed at once) counts too.
   const GURL url =
-      dom_distiller::url_utils::IsDistilledPage(contents->GetVisibleURL())
+      web_distiller::url_utils::IsDistilledPage(contents->GetVisibleURL())
           ? contents->GetVisibleURL()
           : contents->GetLastCommittedURL();
-  if (dom_distiller::url_utils::IsDistilledPage(url)) {
+  if (web_distiller::url_utils::IsDistilledPage(url)) {
     GURL original =
-        dom_distiller::url_utils::GetOriginalUrlFromDistillerUrl(url);
+        web_distiller::url_utils::GetOriginalUrlFromDistillerUrl(url);
     content::NavigationController& controller = contents->GetController();
     // Back to the page itself (its scroll position, no reload) when it's the
     // entry before; else loaded again.
@@ -602,7 +602,7 @@ void SidebarHandler::ToggleReader(ToggleReaderCallback callback) {
     // reading view there a second later is that one).
     const int entry_id =
         controller.GetLastCommittedEntry() &&
-                dom_distiller::url_utils::IsDistilledPage(
+                web_distiller::url_utils::IsDistilledPage(
                     controller.GetLastCommittedEntry()->GetURL())
             ? controller.GetLastCommittedEntry()->GetUniqueID()
             : 0;
@@ -630,7 +630,7 @@ void SidebarHandler::ToggleReader(ToggleReaderCallback callback) {
                   contents ? contents->GetController().GetLastCommittedEntry()
                            : nullptr;
               if (!now || (entry_id && now->GetUniqueID() != entry_id) ||
-                  !dom_distiller::url_utils::IsDistilledPage(now->GetURL())) {
+                  !web_distiller::url_utils::IsDistilledPage(now->GetURL())) {
                 return;
               }
               // A slow page still on its way there is left to arrive.
@@ -654,7 +654,7 @@ void SidebarHandler::ToggleReader(ToggleReaderCallback callback) {
   }
   // Only a page that reads as an article (Chromium's readability check),
   // so a home page or a form isn't turned into a blank sheet.
-  RunReadabilityHeuristicsOnWebContents(
+  RunHeuristicsOnWebContents(
       contents,
       base::BindOnce(
           [](base::WeakPtr<content::WebContents> contents,
