+// ---- Claude Desktop
+
+constexpr char kDesktopId[] = "claude-desktop";
+
+base::FilePath DesktopConfig() {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (cl->HasSwitch(kClaudeDesktopConfigSwitch)) {
+    return cl->GetSwitchValuePath(kClaudeDesktopConfigSwitch);
+  }
+#if BUILDFLAG(IS_WIN)
+  base::FilePath roaming;
+  base::PathService::Get(base::DIR_ROAMING_APP_DATA, &roaming);
+  return roaming.Append(L"Claude").Append(L"claude_desktop_config.json");
+#else
+  return base::GetHomeDir()
+      .Append("Library/Application Support/Claude")
+      .Append("claude_desktop_config.json");
+#endif
+}
+
+// Installed: Claude Desktop made its folder (on its first start), or the app
+// is there.
+bool DesktopInstalled() {
+  if (base::DirectoryExists(DesktopConfig().DirName())) {
+    return true;
+  }
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kClaudeDesktopConfigSwitch)) {
+    return false;
+  }
+#if BUILDFLAG(IS_WIN)
+  base::FilePath local;
+  return base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local) &&
+         base::DirectoryExists(local.Append(L"AnthropicClaude"));
+#else
+  return base::DirectoryExists(base::FilePath("/Applications/Claude.app")) ||
+         base::DirectoryExists(
+             base::GetHomeDir().Append("Applications/Claude.app"));
+#endif
+}
+
+base::DictValue DesktopServer() {
+  return base::DictValue()
+      .Set("command",
+           base::CommandLine::ForCurrentProcess()->GetProgram().AsUTF8Unsafe())
+      .Set("args", base::ListValue().Append("--mcp-bridge"));
+}
+
+// What Connect adds, the way the file will read.
+std::string DesktopCommand() {
+  std::string program;
+  base::JSONWriter::Write(
+      base::Value(
+          base::CommandLine::ForCurrentProcess()->GetProgram().AsUTF8Unsafe()),
+      &program);
+  return "\"meridian\": {\n  \"command\": " + program +
+         ",\n  \"args\": [\"--mcp-bridge\"]\n}";
+}
+
+// The config file as the person knows it: ~/Library/...
+std::string DisplayPath(const base::FilePath& file) {
+  const std::string home = base::GetHomeDir().AsUTF8Unsafe();
+  const std::string path = file.AsUTF8Unsafe();
+  if (!home.empty() && base::StartsWith(path, home + "/")) {
+    return "~" + path.substr(home.size());
+  }
+  return path;
+}
+
+base::FilePath DesktopBackup(const base::FilePath& config) {
+  return config.AddExtensionASCII("meridian-backup");
+}
+
+bool ConnectDesktop(std::string* output) {
+  const base::FilePath config = DesktopConfig();
+  base::DictValue root;
+  std::string text;
+  const bool existed = base::PathExists(config);
+  if (existed) {
+    if (!base::ReadFileToString(config, &text)) {
+      *output = "couldn\u2019t read " + config.AsUTF8Unsafe();
+      return false;
+    }
+    if (!base::TrimWhitespaceASCII(text, base::TRIM_ALL).empty()) {
+      std::optional<base::DictValue> parsed = base::JSONReader::ReadDict(
+          text, base::JSON_ALLOW_TRAILING_COMMAS);
+      if (!parsed) {
+        // Never overwrite a file we can't read back.
+        *output = config.AsUTF8Unsafe() +
+                  " isn\u2019t valid JSON; fix it (or move it away) and "
+                  "try again";
+        return false;
+      }
+      root = std::move(*parsed);
+    }
+  }
+  base::Value* servers = root.Find("mcpServers");
+  if (servers && !servers->is_dict()) {
+    *output = "\"mcpServers\" in " + config.AsUTF8Unsafe() +
+              " isn\u2019t an object; nothing was changed";
+    return false;
+  }
+  base::DictValue server = DesktopServer();
+  if (servers) {
+    const base::DictValue* current = servers->GetDict().FindDict("meridian");
+    if (current && *current == server) {
+      *output = "already connected";
+      return true;
+    }
+  }
+  if (existed && !base::CopyFile(config, DesktopBackup(config))) {
+    *output = "couldn\u2019t back up " + config.AsUTF8Unsafe();
+    return false;
+  }
+  if (!servers) {
+    servers = root.Set("mcpServers", base::DictValue());
+  }
+  servers->GetDict().Set("meridian", std::move(server));
+  std::string json;
+  base::JSONWriter::WriteWithOptions(
+      root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json);
+  if (!base::CreateDirectory(config.DirName()) ||
+      !base::ImportantFileWriter::WriteFileAtomically(config, json)) {
+    *output = "couldn\u2019t write " + config.AsUTF8Unsafe();
+    return false;
+  }
+  *output = existed ? "the old file is saved as " +
+                          DesktopBackup(config).BaseName().AsUTF8Unsafe()
+                    : "a new config file";
+  return true;
+}
+
 }  // namespace
 
 std::vector<AgentCli> DetectAgentClis() {
   std::string path = LoginPath();
   std::vector<AgentCli> out;
   for (const Known& cli : KnownClis()) {
-    out.push_back({cli.id, cli.name, Which(cli.id, path), CommandOf(cli)});
+    out.push_back({cli.id, cli.name, Which(cli.id, path), CommandOf(cli), ""});
   }
+  out.push_back({kDesktopId, "Claude Desktop",
+                 DesktopInstalled() ? DesktopConfig().AsUTF8Unsafe() : "",
+                 DesktopCommand(), DisplayPath(DesktopConfig())});
   return out;
 }
 
