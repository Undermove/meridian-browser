From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Wed, 25 Nov 2026 07:39:35 +0400
Subject: [PATCH] Meridian: 1.2.0's unit tests build and pass on Windows

The self-install, agent input and Insights tests made paths from string
literals with base::FilePath("..."), which takes wide strings on Windows;
they use FilePath::FromASCII now. Insights' session finder returns paths
that mix / and \ there, so the test compares them with one separator.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../meridian/agent/agent_input_unittest.cc    | 24 +++++++-------
 .../browser/meridian/self_install_unittest.cc | 16 +++++-----
 .../workbench/agent_insights_unittest.cc      | 32 ++++++++++++-------
 3 files changed, 40 insertions(+), 32 deletions(-)

diff --git a/chrome/browser/meridian/agent/agent_input_unittest.cc b/chrome/browser/meridian/agent/agent_input_unittest.cc
index e8ffd57ed6..c6056411df 100644
--- a/chrome/browser/meridian/agent/agent_input_unittest.cc
+++ b/chrome/browser/meridian/agent/agent_input_unittest.cc
@@ -96,8 +96,8 @@ TEST(AgentInputTest, OfferedFileGoesToTheNextChooserOnce) {
   base::test::SingleThreadTaskEnvironment env;
   int tab = 0;
   std::string heard = "-";
-  OfferFile(&tab, "studio.example.com", base::FilePath("/copy/a.png"),
-            base::FilePath("/real/a.png"), base::Seconds(5),
+  OfferFile(&tab, "studio.example.com", base::FilePath::FromASCII("/copy/a.png"),
+            base::FilePath::FromASCII("/real/a.png"), base::Seconds(5),
             base::BindOnce([](std::string* out, std::string e) { *out = e; },
                            &heard));
   // Another tab has nothing.
@@ -106,15 +106,15 @@ TEST(AgentInputTest, OfferedFileGoesToTheNextChooserOnce) {
   auto file = TakeFile(&tab, "upload.studio.example.com", Chooser::kOpen,
                        false);
   ASSERT_TRUE(file.has_value());
-  EXPECT_EQ(*file, base::FilePath("/copy/a.png"));
+  EXPECT_EQ(*file, base::FilePath::FromASCII("/copy/a.png"));
   base::RunLoop().RunUntilIdle();
   EXPECT_EQ(heard, "");
   // Once.
   EXPECT_FALSE(TakeFile(&tab, "studio.example.com", Chooser::kOpen, false));
 
   // Another site's frame, or a folder: cancelled, and said why.
-  OfferFile(&tab, "example.com", base::FilePath("/copy/a.png"),
-            base::FilePath("/real/a.png"), base::Seconds(5),
+  OfferFile(&tab, "example.com", base::FilePath::FromASCII("/copy/a.png"),
+            base::FilePath::FromASCII("/real/a.png"), base::Seconds(5),
             base::BindOnce([](std::string* out, std::string e) { *out = e; },
                            &heard));
   auto cancel = TakeFile(&tab, "evil.test", Chooser::kOpen, false);
@@ -122,22 +122,22 @@ TEST(AgentInputTest, OfferedFileGoesToTheNextChooserOnce) {
   EXPECT_TRUE(cancel->empty());
   base::RunLoop().RunUntilIdle();
   EXPECT_NE(heard.find("evil.test"), std::string::npos);
-  OfferFile(&tab, "example.com", base::FilePath("/copy/a.png"),
-            base::FilePath("/real/a.png"), base::Seconds(5),
+  OfferFile(&tab, "example.com", base::FilePath::FromASCII("/copy/a.png"),
+            base::FilePath::FromASCII("/real/a.png"), base::Seconds(5),
             base::BindOnce([](std::string* out, std::string e) { *out = e; },
                            &heard));
   EXPECT_TRUE(TakeFile(&tab, "example.com", Chooser::kOther, true)->empty());
   base::RunLoop().RunUntilIdle();
   EXPECT_NE(heard.find("folder"), std::string::npos);
   // The picker gets the approved file itself.
-  OfferFile(&tab, "example.com", base::FilePath("/copy/a.png"),
-            base::FilePath("/real/a.png"), base::Seconds(5),
+  OfferFile(&tab, "example.com", base::FilePath::FromASCII("/copy/a.png"),
+            base::FilePath::FromASCII("/real/a.png"), base::Seconds(5),
             base::DoNothing());
   EXPECT_EQ(*TakeFile(&tab, "example.com", Chooser::kOpenMultiple, true),
-            base::FilePath("/real/a.png"));
+            base::FilePath::FromASCII("/real/a.png"));
   // Withdrawn: the native chooser again.
-  OfferFile(&tab, "example.com", base::FilePath("/copy/a.png"),
-            base::FilePath("/real/a.png"), base::Seconds(5),
+  OfferFile(&tab, "example.com", base::FilePath::FromASCII("/copy/a.png"),
+            base::FilePath::FromASCII("/real/a.png"), base::Seconds(5),
             base::BindOnce([](std::string* out, std::string e) { *out = e; },
                            &heard));
   Withdraw(&tab);
diff --git a/chrome/browser/meridian/self_install_unittest.cc b/chrome/browser/meridian/self_install_unittest.cc
index 5ef3f15fcd..904e298522 100644
--- a/chrome/browser/meridian/self_install_unittest.cc
+++ b/chrome/browser/meridian/self_install_unittest.cc
@@ -11,10 +11,10 @@ namespace {
 
 SelfInstallFacts FromDownloads() {
   SelfInstallFacts f;
-  f.app = base::FilePath("/Users/ada/Downloads/Meridian.app");
-  f.downloads = base::FilePath("/Users/ada/Downloads");
-  f.applications = base::FilePath("/Applications");
-  f.user_applications = base::FilePath("/Users/ada/Applications");
+  f.app = base::FilePath::FromASCII("/Users/ada/Downloads/Meridian.app");
+  f.downloads = base::FilePath::FromASCII("/Users/ada/Downloads");
+  f.applications = base::FilePath::FromASCII("/Applications");
+  f.user_applications = base::FilePath::FromASCII("/Users/ada/Applications");
   f.bundle_id = "dev.meridian.browser";
   f.version = "158.0.8127.42";
   return f;
@@ -26,7 +26,7 @@ TEST(SelfInstallTest, FromDownloadsOffersToMove) {
 
 TEST(SelfInstallTest, UnzippedElsewhereOnlyWhenDownloaded) {
   SelfInstallFacts f = FromDownloads();
-  f.app = base::FilePath("/Users/ada/Desktop/Meridian.app");
+  f.app = base::FilePath::FromASCII("/Users/ada/Desktop/Meridian.app");
   // A build made on this Mac (no quarantine): stays where it is.
   EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kNone);
   f.quarantined = true;
@@ -35,7 +35,7 @@ TEST(SelfInstallTest, UnzippedElsewhereOnlyWhenDownloaded) {
 
 TEST(SelfInstallTest, DiskImage) {
   SelfInstallFacts f = FromDownloads();
-  f.app = base::FilePath("/Volumes/Meridian/Meridian.app");
+  f.app = base::FilePath::FromASCII("/Volumes/Meridian/Meridian.app");
   f.on_disk_image = true;
   EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kInstall);
 }
@@ -43,9 +43,9 @@ TEST(SelfInstallTest, DiskImage) {
 TEST(SelfInstallTest, AlreadyInApplications) {
   SelfInstallFacts f = FromDownloads();
   f.quarantined = true;
-  f.app = base::FilePath("/Applications/Meridian.app");
+  f.app = base::FilePath::FromASCII("/Applications/Meridian.app");
   EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kNone);
-  f.app = base::FilePath("/Users/ada/Applications/Meridian.app");
+  f.app = base::FilePath::FromASCII("/Users/ada/Applications/Meridian.app");
   EXPECT_EQ(DecideSelfInstall(f), SelfInstallOffer::kNone);
 }
 
diff --git a/chrome/browser/meridian/workbench/agent_insights_unittest.cc b/chrome/browser/meridian/workbench/agent_insights_unittest.cc
index 11055f6681..df41eb1440 100644
--- a/chrome/browser/meridian/workbench/agent_insights_unittest.cc
+++ b/chrome/browser/meridian/workbench/agent_insights_unittest.cc
@@ -333,14 +333,21 @@ class AgentSessionsTest : public testing::Test {
     EXPECT_TRUE(base::WriteFile(p, s));
     // Written to until a little after it began.
     EXPECT_TRUE(base::TouchFile(p, T(start + 30), T(start + 30)));
-    return p;
+    // Paths compare with one kind of separator (Windows mixes / and \).
+    return p.NormalizePathSeparators();
   }
 
   std::optional<AgentSession> Find(AgentFormat f,
                                    base::Time since,
                                    base::Time until = base::Time()) {
-    return FindAgentSession(f, home_.GetPath(), /*hermetic=*/true,
-                            base::FilePath("/work/shop"), since, until);
+    std::optional<AgentSession> s =
+        FindAgentSession(f, home_.GetPath(), /*hermetic=*/true,
+                         base::FilePath::FromASCII("/work/shop"), since, until);
+    if (s) {
+      s->path = s->path.NormalizePathSeparators();
+      s->models = s->models.NormalizePathSeparators();
+    }
+    return s;
   }
 
   base::ScopedTempDir home_;
@@ -349,7 +356,7 @@ class AgentSessionsTest : public testing::Test {
 base::FilePath CodexDay() {
   base::Time::Exploded x;
   base::Time::Now().LocalExplode(&x);
-  return base::FilePath(".codex/sessions")
+  return base::FilePath::FromASCII(".codex/sessions")
       .AppendASCII(base::StringPrintf("%04d/%02d/%02d", x.year, x.month,
                                       x.day_of_month));
 }
@@ -378,7 +385,7 @@ TEST_F(AgentSessionsTest, CodexByProjectAndTime) {
 TEST_F(AgentSessionsTest, QwenGeminiCopilot) {
   const base::FilePath q = Put(
       "qwen-chat.jsonl",
-      base::FilePath(".qwen/projects/-work-shop/chats/q1.jsonl"), 0);
+      base::FilePath::FromASCII(".qwen/projects/-work-shop/chats/q1.jsonl"), 0);
   EXPECT_EQ(Find(AgentFormat::kQwen, T(-1))->path, q);
 
   ASSERT_TRUE(base::CreateDirectory(home_.GetPath().AppendASCII(".gemini")));
@@ -387,19 +394,19 @@ TEST_F(AgentSessionsTest, QwenGeminiCopilot) {
       R"({"projects":{"/work/shop":"shop","/work/other":"other"}})"));
   const base::FilePath g = Put(
       "gemini-session.jsonl",
-      base::FilePath(".gemini/tmp/shop/chats/session-2026-11-25T08-26-g1.jsonl"),
+      base::FilePath::FromASCII(".gemini/tmp/shop/chats/session-2026-11-25T08-26-g1.jsonl"),
       0);
   Put("gemini-session.jsonl",
-      base::FilePath(
+      base::FilePath::FromASCII(
           ".gemini/tmp/other/chats/session-2026-11-25T08-30-g2.jsonl"),
       200);
   EXPECT_EQ(Find(AgentFormat::kGemini, T(-1))->path, g);
 
   const base::FilePath c = Put(
       "copilot-events.jsonl",
-      base::FilePath(".copilot/session-state/1111/events.jsonl"), 0);
+      base::FilePath::FromASCII(".copilot/session-state/1111/events.jsonl"), 0);
   Put("copilot-events.jsonl",
-      base::FilePath(".copilot/session-state/2222/events.jsonl"), 300,
+      base::FilePath::FromASCII(".copilot/session-state/2222/events.jsonl"), 300,
       "/work/other");
   EXPECT_EQ(Find(AgentFormat::kCopilot, T(-1))->path, c);
 }
@@ -414,9 +421,10 @@ TEST_F(AgentSessionsTest, OpenCodeSessionInTheDatabase) {
   std::optional<AgentSession> s = Find(AgentFormat::kOpenCode, T(-1));
   ASSERT_TRUE(s.has_value());
   EXPECT_EQ(s->session_id, "ses_df07b488fffe3rYjjLr4sRVdkQ");
-  EXPECT_EQ(s->path, dir.AppendASCII("opencode.db"));
-  EXPECT_EQ(s->models, home_.GetPath().AppendASCII(
-                           ".cache/opencode/models.json"));
+  EXPECT_EQ(s->path, dir.AppendASCII("opencode.db").NormalizePathSeparators());
+  EXPECT_EQ(s->models, home_.GetPath()
+                           .AppendASCII(".cache/opencode/models.json")
+                           .NormalizePathSeparators());
 }
 
 TEST(AgentInsightsTest, WhichAgentsHaveInsights) {
