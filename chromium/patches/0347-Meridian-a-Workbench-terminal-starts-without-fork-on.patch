 chrome/browser/meridian/workbench/terminal.cc | 112 +++++++++++++++++
 chrome/browser/meridian/workbench/terminal.h  |   7 ++
 .../meridian/workbench/terminal_unittest.cc   | 116 ++++++++++++++++++
