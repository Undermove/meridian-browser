+
+#if BUILDFLAG(IS_MAC)
+// This test binary is the terminals' trampoline here, as the browser's
+// binary is in Meridian (helper_modes.cc): before any test runs.
+__attribute__((constructor)) static void MaybePtyExec(int argc,
+                                                      const char** argv) {
+  if (meridian::workbench::IsPtyExec(argc, argv)) {
+    _exit(meridian::workbench::RunPtyExec(argc, argv));
+  }
+}
 #endif
 
 namespace meridian::workbench {
@@ -124,5 +145,100 @@ TEST(TerminalTest, KillEndsTheProcessGroup) {
 #endif
 }
 
+#if !BUILDFLAG(IS_WIN)
+// Runs `script` in /bin/sh on a terminal in `cwd`; what it printed and its exit code.
+std::pair<std::string, int> RunScript(const std::string& script,
+                                      const std::string& cwd = "") {
+  Terminal::Spec spec;
+  spec.argv = {"/bin/sh", "-c", script};
+  spec.env = {{"PATH", "/usr/bin:/bin"}};
+  spec.cwd = cwd;
+  std::string out;
+  int exit_code = -2;
+  base::RunLoop exited;
+  std::unique_ptr<Terminal> term = Terminal::Start(
+      spec,
+      base::BindRepeating([](std::string* out, std::string d) { *out += d; },
+                          &out),
+      base::BindOnce(
+          [](int* code, base::OnceClosure quit, int c, int) {
+            *code = c;
+            std::move(quit).Run();
+          },
+          &exit_code, exited.QuitClosure()));
+  if (!term) {
+    return {"<not started>", -3};
+  }
+  exited.Run();
+  return {out, exit_code};
+}
+
+// The shell's own session, with the pty as its controlling terminal (job
+// control, Ctrl+C), in the folder asked for, with none of Meridian's open
+// files and no signal blocked or ignored.
+TEST(TerminalTest, ANewSessionWithThePtyAsItsTerminalInItsFolder) {
+  base::test::TaskEnvironment env;
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath real = base::MakeAbsoluteFilePath(dir.GetPath());
+  // A file Meridian has open, not close-on-exec: the shell must not get it.
+  const int leaked = open(real.AppendASCII("open").value().c_str(),
+                          O_CREAT | O_RDWR, 0600);
+  ASSERT_GE(leaked, 3);
+  auto [out, code] = RunScript(
+      "pwd -P; [ \"$(ps -o sess= -p $$ | tr -d ' ')\" = \"$(ps -o pid= -p $$ | "
+      "tr -d ' ')\" ] || [ \"$(ps -o pgid= -p $$ | tr -d ' ')\" = \"$$\" ] && "
+      "echo leader; (exec 3</dev/tty) 2>/dev/null && echo ctty; "
+      "[ -e /dev/fd/" + base::NumberToString(leaked) + " ] && echo leaked; "
+      "trap -p INT; (exec 3</dev/tty && ps -o tpgid=,pgid= -p $$ | awk '$1==$2{print \"fg\"}'); echo done",
+      real.value());
+  close(leaked);
+  EXPECT_EQ(code, 0) << out;
+  EXPECT_NE(out.find(real.value()), std::string::npos) << out;
+  EXPECT_NE(out.find("leader"), std::string::npos) << out;
+  EXPECT_NE(out.find("ctty"), std::string::npos) << out;
+  EXPECT_EQ(out.find("leaked"), std::string::npos) << out;
+  EXPECT_NE(out.find("fg"), std::string::npos) << out;
+  EXPECT_NE(out.find("done"), std::string::npos) << out;
+}
+
+// The project folder was removed: the shell still starts (where Meridian is).
+TEST(TerminalTest, AFolderThatIsGoneStillStartsTheShell) {
+  base::test::TaskEnvironment env;
+  auto [out, code] = RunScript("echo started", "/nonexistent/meridian-gone");
+  EXPECT_EQ(code, 0) << out;
+  EXPECT_NE(out.find("started"), std::string::npos) << out;
+}
+
+// Many terminals opened and ended one after another while other threads of
+// the browser allocate and free Objective-C and other objects: none takes the
+// process down (27.11: fork() crashed in libxpc's atfork handler).
+TEST(TerminalTest, ManyTerminalsWhileOtherThreadsAreBusy) {
+  base::test::TaskEnvironment env;
+  std::atomic<bool> stop{false};
+  std::vector<std::thread> busy;
+  for (int i = 0; i < 4; ++i) {
+    busy.emplace_back([&stop] {
+      while (!stop) {
+        std::vector<std::string> junk(64, std::string(256, 'x'));
+        junk.clear();
+      }
+    });
+  }
+  int ok = 0;
+  for (int i = 0; i < 60; ++i) {
+    auto [out, code] = RunScript("echo hi");
+    if (code == 0 && out.find("hi") != std::string::npos) {
+      ++ok;
+    }
+  }
+  stop = true;
+  for (std::thread& t : busy) {
+    t.join();
+  }
+  EXPECT_EQ(ok, 60);
+}
+#endif
+
 }  // namespace
 }  // namespace meridian::workbench
