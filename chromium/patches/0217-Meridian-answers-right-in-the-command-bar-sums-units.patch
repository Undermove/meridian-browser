diff --git a/chrome/browser/resources/webui_browser/meridian/quick_answers.ts b/chrome/browser/resources/webui_browser/meridian/quick_answers.ts
new file mode 100644
index 0000000000..aed2be5f12
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/quick_answers.ts
@@ -0,0 +1,422 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Answers right in the command bar as you type, like Raycast's or Brk's:
+// arithmetic ("2+2*3", "15% of 240", "sqrt 9"), units ("5 km in miles",
+// "100 f to c"), currencies ("100 usd in eur", rates from the European
+// Central Bank) and the time somewhere ("time in tokyo", "5pm london in
+// new york"). Return copies the answer.
+
+export interface QuickAnswer {
+  kind: 'calc'|'unit'|'currency'|'time';
+  // What is shown and copied.
+  value: string;
+  // A line under it: what was understood, where a rate is from.
+  detail: string;
+}
+
+export interface CurrencyRates {
+  // Per euro, e.g. {USD: 1.08}; EUR itself is 1.
+  rates: {[code: string]: number};
+  date: string;
+}
+
+const MAX_LENGTH = 160;
+
+function format(n: number): string {
+  if (!isFinite(n)) {
+    return '';
+  }
+  if (Number.isInteger(n) && Math.abs(n) < 1e15) {
+    return n.toLocaleString('en-US', {maximumFractionDigits: 0});
+  }
+  const precise = Number(n.toPrecision(12));
+  return Math.abs(precise) >= 1e15 || (precise !== 0 && Math.abs(precise) < 1e-6) ?
+      precise.toExponential(6).replace(/\.?0+e/, 'e') :
+      precise.toLocaleString('en-US', {maximumFractionDigits: 10});
+}
+
+// ------------------------------------------------------------- arithmetic
+
+// A recursive-descent reader: + - * / × ÷ ^ % ( ), unary minus, sqrt.
+function evaluate(text: string): number|null {
+  const src = text.replace(/×/g, '*').replace(/÷/g, '/').replace(/,/g, '')
+                  .replace(/\s+/g, '');
+  let at = 0;
+  const peek = () => src[at];
+  const number = (): number|null => {
+    const m = /^\d*\.?\d+(e[+-]?\d+)?/i.exec(src.slice(at));
+    if (!m) {
+      return null;
+    }
+    at += m[0].length;
+    return Number(m[0]);
+  };
+  const factor = (): number|null => {
+    if (peek() === '-') {
+      at++;
+      const v = factor();
+      return v === null ? null : -v;
+    }
+    if (peek() === '+') {
+      at++;
+      return factor();
+    }
+    if (src.slice(at, at + 4).toLowerCase() === 'sqrt') {
+      at += 4;
+      const v = factor();
+      return v === null ? null : Math.sqrt(v);
+    }
+    let v: number|null;
+    if (peek() === '(') {
+      at++;
+      v = sum();
+      if (peek() !== ')') {
+        return null;
+      }
+      at++;
+    } else {
+      v = number();
+    }
+    if (v === null) {
+      return null;
+    }
+    // A trailing % is a hundredth (in "200 * 15%").
+    while (peek() === '%' && !/[\d(]/.test(src[at + 1] || '')) {
+      at++;
+      v /= 100;
+    }
+    if (peek() === '^') {
+      at++;
+      const e = factor();
+      return e === null ? null : Math.pow(v, e);
+    }
+    return v;
+  };
+  const product = (): number|null => {
+    let v = factor();
+    while (v !== null && (peek() === '*' || peek() === '/' || peek() === '%')) {
+      const op = src[at++];
+      const r = factor();
+      if (r === null) {
+        return null;
+      }
+      v = op === '*' ? v * r : op === '/' ? v / r : v % r;
+    }
+    return v;
+  };
+  const sum = (): number|null => {
+    let v = product();
+    while (v !== null && (peek() === '+' || peek() === '-')) {
+      const op = src[at++];
+      const r = product();
+      if (r === null) {
+        return null;
+      }
+      v = op === '+' ? v + r : v - r;
+    }
+    return v;
+  };
+  const v = sum();
+  return v !== null && at === src.length && isFinite(v) ? v : null;
+}
+
+function calc(text: string): QuickAnswer|null {
+  let m = /^(-?[\d.,]+)\s*(%|percent)\s+of\s+(-?[\d.,]+)$/i.exec(text);
+  if (m) {
+    const v = Number(m[1]!.replace(/,/g, '')) / 100 *
+        Number(m[3]!.replace(/,/g, ''));
+    return isFinite(v) ? {kind: 'calc', value: format(v), detail: text} : null;
+  }
+  m = /^(?:square root of|sqrt)\s*\(?\s*([\d.,]+)\s*\)?$/i.exec(text);
+  if (m) {
+    const v = Math.sqrt(Number(m[1]!.replace(/,/g, '')));
+    return isFinite(v) ? {kind: 'calc', value: format(v), detail: text} : null;
+  }
+  // Only something with an operator between two numbers is a sum ("2024"
+  // or "-5" alone are searches).
+  if (!/^[\d\s.,+\-*/×÷^%()]+$/i.test(text) ||
+      !/[\d)]\s*[+\-*/×÷^%]\s*[\d(.-]/.test(text)) {
+    return null;
+  }
+  const v = evaluate(text);
+  return v === null ? null : {kind: 'calc', value: format(v), detail: text};
+}
+
+// ------------------------------------------------------------------ units
+
+interface Unit {
+  dim: string;
+  // In the dimension's base unit (temperature: see TEMPERATURE).
+  factor: number;
+  symbol: string;
+}
+
+const UNITS: {[name: string]: Unit} = {};
+function units(dim: string, symbol: string, factor: number, ...names: string[]) {
+  for (const n of [symbol, ...names]) {
+    UNITS[n.toLowerCase()] = {dim, factor, symbol};
+  }
+}
+// Length (metres).
+units('length', 'mm', 0.001, 'millimeter', 'millimeters', 'millimetre', 'millimetres');
+units('length', 'cm', 0.01, 'centimeter', 'centimeters', 'centimetre', 'centimetres');
+units('length', 'm', 1, 'meter', 'meters', 'metre', 'metres');
+units('length', 'km', 1000, 'kilometer', 'kilometers', 'kilometre', 'kilometres');
+units('length', 'in', 0.0254, 'inch', 'inches', '"');
+units('length', 'ft', 0.3048, 'foot', 'feet', "'");
+units('length', 'yd', 0.9144, 'yard', 'yards');
+units('length', 'mi', 1609.344, 'mile', 'miles');
+units('length', 'nmi', 1852, 'nautical mile', 'nautical miles');
+// Mass (grams).
+units('mass', 'mg', 0.001, 'milligram', 'milligrams');
+units('mass', 'g', 1, 'gram', 'grams');
+units('mass', 'kg', 1000, 'kilogram', 'kilograms', 'kilo', 'kilos');
+units('mass', 't', 1e6, 'tonne', 'tonnes', 'ton', 'tons');
+units('mass', 'oz', 28.349523125, 'ounce', 'ounces');
+units('mass', 'lb', 453.59237, 'lbs', 'pound', 'pounds');
+units('mass', 'st', 6350.29318, 'stone', 'stones');
+// Volume (litres).
+units('volume', 'ml', 0.001, 'milliliter', 'milliliters', 'millilitre', 'millilitres');
+units('volume', 'l', 1, 'liter', 'liters', 'litre', 'litres');
+units('volume', 'tsp', 0.00492892159, 'teaspoon', 'teaspoons');
+units('volume', 'tbsp', 0.0147867648, 'tablespoon', 'tablespoons');
+units('volume', 'fl oz', 0.0295735296, 'floz', 'fluid ounce', 'fluid ounces');
+units('volume', 'cup', 0.2365882365, 'cups');
+units('volume', 'pt', 0.473176473, 'pint', 'pints');
+units('volume', 'qt', 0.946352946, 'quart', 'quarts');
+units('volume', 'gal', 3.785411784, 'gallon', 'gallons');
+// Area (square metres).
+units('area', 'm²', 1, 'm2', 'sq m', 'square meter', 'square meters', 'square metre', 'square metres');
+units('area', 'km²', 1e6, 'km2', 'sq km', 'square kilometer', 'square kilometers');
+units('area', 'ft²', 0.09290304, 'ft2', 'sq ft', 'square foot', 'square feet');
+units('area', 'ac', 4046.8564224, 'acre', 'acres');
+units('area', 'ha', 10000, 'hectare', 'hectares');
+// Speed (metres a second).
+units('speed', 'm/s', 1, 'mps');
+units('speed', 'km/h', 1 / 3.6, 'kmh', 'kph', 'kmph');
+units('speed', 'mph', 0.44704, 'miles per hour');
+units('speed', 'kn', 0.514444, 'knot', 'knots', 'kt');
+// Data (bytes).
+units('data', 'B', 1, 'byte', 'bytes');
+units('data', 'KB', 1e3, 'kilobyte', 'kilobytes');
+units('data', 'MB', 1e6, 'megabyte', 'megabytes');
+units('data', 'GB', 1e9, 'gigabyte', 'gigabytes');
+units('data', 'TB', 1e12, 'terabyte', 'terabytes');
+units('data', 'KiB', 1024, 'kibibyte', 'kibibytes');
+units('data', 'MiB', 1024 ** 2, 'mebibyte', 'mebibytes');
+units('data', 'GiB', 1024 ** 3, 'gibibyte', 'gibibytes');
+units('data', 'TiB', 1024 ** 4, 'tebibyte', 'tebibytes');
+// Time (seconds).
+units('time', 'ms', 0.001, 'millisecond', 'milliseconds');
+units('time', 's', 1, 'sec', 'secs', 'second', 'seconds');
+units('time', 'min', 60, 'mins', 'minute', 'minutes');
+units('time', 'h', 3600, 'hr', 'hrs', 'hour', 'hours');
+units('time', 'd', 86400, 'day', 'days');
+units('time', 'wk', 604800, 'week', 'weeks');
+
+// Temperature: to and from kelvin.
+const TEMPERATURE: {[name: string]: {symbol: string, toK: (v: number) => number,
+                                     fromK: (k: number) => number}} = {};
+for (const [symbol, names, toK, fromK] of [
+         ['°C', ['c', '°c', 'celsius', 'centigrade'], (v: number) => v + 273.15,
+          (k: number) => k - 273.15],
+         ['°F', ['f', '°f', 'fahrenheit'], (v: number) => (v - 32) * 5 / 9 + 273.15,
+          (k: number) => (k - 273.15) * 9 / 5 + 32],
+         ['K', ['k', 'kelvin', 'kelvins'], (v: number) => v, (k: number) => k],
+     ] as Array<[string, string[], (v: number) => number, (k: number) => number]>) {
+  for (const n of names) {
+    TEMPERATURE[n] = {symbol, toK, fromK};
+  }
+}
+
+const CONVERT = /^(-?[\d.,]+)\s*([a-z°"'²/ ]+?)\s+(?:in|to|as|into|=)\s+([a-z°"'²/ ]+)$/i;
+
+function unit(text: string): QuickAnswer|null {
+  const m = CONVERT.exec(text);
+  if (!m) {
+    return null;
+  }
+  const amount = Number(m[1]!.replace(/,/g, ''));
+  const from = m[2]!.trim().toLowerCase();
+  const to = m[3]!.trim().toLowerCase();
+  if (!isFinite(amount)) {
+    return null;
+  }
+  const tf = TEMPERATURE[from];
+  const tt = TEMPERATURE[to];
+  if (tf && tt) {
+    const v = tt.fromK(tf.toK(amount));
+    return {kind: 'unit', value: `${format(Number(v.toFixed(2)))} ${tt.symbol}`,
+            detail: `${format(amount)} ${tf.symbol}`};
+  }
+  const uf = UNITS[from];
+  const ut = UNITS[to];
+  if (!uf || !ut || uf.dim !== ut.dim) {
+    return null;
+  }
+  const v = amount * uf.factor / ut.factor;
+  return {kind: 'unit', value: `${format(Number(v.toPrecision(6)))} ${ut.symbol}`,
+          detail: `${format(amount)} ${uf.symbol}`};
+}
+
+// -------------------------------------------------------------- currency
+
+// The ECB's daily reference rates (and the euro).
+const CURRENCIES = new Set([
+  'EUR', 'USD', 'JPY', 'BGN', 'CZK', 'DKK', 'GBP', 'HUF', 'PLN', 'RON', 'SEK',
+  'CHF', 'ISK', 'NOK', 'TRY', 'AUD', 'BRL', 'CAD', 'CNY', 'HKD', 'IDR', 'ILS',
+  'INR', 'KRW', 'MXN', 'MYR', 'NZD', 'PHP', 'SGD', 'THB', 'ZAR',
+]);
+const SIGNS: {[sign: string]: string} =
+    {'$': 'USD', '€': 'EUR', '£': 'GBP', '¥': 'JPY', '₹': 'INR'};
+
+// Whether the text asks for a currency (the bar fetches the rates then).
+export function wantsCurrency(text: string): boolean {
+  return currencyQuery(text) !== null;
+}
+
+function currencyQuery(text: string):
+    {amount: number, from: string, to: string}|null {
+  const m = /^([$€£¥₹])?\s*([\d.,]+)\s*([a-z]{3}|[$€£¥₹])?\s+(?:in|to|as|into|=)\s+([a-z]{3}|[$€£¥₹])$/i
+                .exec(text.trim());
+  if (!m) {
+    return null;
+  }
+  const code = (s: string|undefined) =>
+      s ? (SIGNS[s] || s.toUpperCase()) : '';
+  const from = code(m[1]) || code(m[3]);
+  const to = code(m[4]);
+  const amount = Number(m[2]!.replace(/,/g, ''));
+  if (!CURRENCIES.has(from) || !CURRENCIES.has(to) || from === to ||
+      !isFinite(amount)) {
+    return null;
+  }
+  return {amount, from, to};
+}
+
+function currency(text: string, rates: CurrencyRates|null): QuickAnswer|null {
+  const q = currencyQuery(text);
+  if (!q || !rates) {
+    return null;
+  }
+  const per = (c: string) => c === 'EUR' ? 1 : rates.rates[c];
+  const a = per(q.from);
+  const b = per(q.to);
+  if (!a || !b) {
+    return null;
+  }
+  const v = q.amount / a * b;
+  return {kind: 'currency', value: `${v.toLocaleString('en-US', {
+            minimumFractionDigits: 2, maximumFractionDigits: 2})} ${q.to}`,
+          detail: `${format(q.amount)} ${q.from} · ECB rate of ${rates.date}`};
+}
+
+// ------------------------------------------------------------------ time
+
+const ZONES: {[name: string]: string} = {
+  'london': 'Europe/London', 'ldn': 'Europe/London', 'uk': 'Europe/London',
+  'paris': 'Europe/Paris', 'berlin': 'Europe/Berlin',
+  'madrid': 'Europe/Madrid', 'rome': 'Europe/Rome',
+  'amsterdam': 'Europe/Amsterdam', 'lisbon': 'Europe/Lisbon',
+  'moscow': 'Europe/Moscow', 'msk': 'Europe/Moscow',
+  'kyiv': 'Europe/Kyiv', 'istanbul': 'Europe/Istanbul',
+  'tbilisi': 'Asia/Tbilisi', 'batumi': 'Asia/Tbilisi',
+  'georgia': 'Asia/Tbilisi', 'yerevan': 'Asia/Yerevan',
+  'dubai': 'Asia/Dubai', 'almaty': 'Asia/Almaty',
+  'delhi': 'Asia/Kolkata', 'mumbai': 'Asia/Kolkata', 'india': 'Asia/Kolkata',
+  'bangkok': 'Asia/Bangkok', 'singapore': 'Asia/Singapore', 'sg': 'Asia/Singapore',
+  'hong kong': 'Asia/Hong_Kong', 'hk': 'Asia/Hong_Kong',
+  'beijing': 'Asia/Shanghai', 'shanghai': 'Asia/Shanghai',
+  'tokyo': 'Asia/Tokyo', 'japan': 'Asia/Tokyo', 'seoul': 'Asia/Seoul',
+  'sydney': 'Australia/Sydney', 'melbourne': 'Australia/Melbourne',
+  'auckland': 'Pacific/Auckland',
+  'new york': 'America/New_York', 'nyc': 'America/New_York', 'ny': 'America/New_York',
+  'boston': 'America/New_York', 'miami': 'America/New_York',
+  'toronto': 'America/Toronto', 'chicago': 'America/Chicago',
+  'denver': 'America/Denver', 'austin': 'America/Chicago',
+  'san francisco': 'America/Los_Angeles', 'sf': 'America/Los_Angeles',
+  'la': 'America/Los_Angeles', 'los angeles': 'America/Los_Angeles',
+  'seattle': 'America/Los_Angeles', 'vancouver': 'America/Vancouver',
+  'mexico city': 'America/Mexico_City', 'sao paulo': 'America/Sao_Paulo',
+  'buenos aires': 'America/Argentina/Buenos_Aires',
+  'utc': 'UTC', 'gmt': 'UTC',
+};
+
+function zoneOf(name: string): string|null {
+  const key = name.trim().toLowerCase();
+  if (ZONES[key]) {
+    return ZONES[key];
+  }
+  // Any zone by its city ("asia/kathmandu" → "kathmandu").
+  const all = (Intl as unknown as {supportedValuesOf?: (k: string) => string[]})
+                  .supportedValuesOf?.('timeZone') || [];
+  return all.find(z => z.split('/').pop()!.replace(/_/g, ' ').toLowerCase() ===
+                       key) || null;
+}
+
+function clock(date: Date, zone: string): string {
+  return new Intl.DateTimeFormat('en-US', {
+    timeZone: zone, hour: 'numeric', minute: '2-digit',
+    weekday: 'short',
+  }).format(date);
+}
+
+// The offset of `zone` from UTC at `date`, in minutes.
+function offsetOf(date: Date, zone: string): number {
+  const parts = new Intl.DateTimeFormat('en-US', {
+    timeZone: zone, hourCycle: 'h23', year: 'numeric', month: 'numeric',
+    day: 'numeric', hour: 'numeric', minute: 'numeric',
+  }).formatToParts(date);
+  const get = (t: string) => Number(parts.find(p => p.type === t)!.value);
+  const asUtc = Date.UTC(get('year'), get('month') - 1, get('day'),
+                         get('hour'), get('minute'));
+  return Math.round((asUtc - date.getTime()) / 60000);
+}
+
+function time(text: string, now: Date): QuickAnswer|null {
+  let m = /^(?:time|now|what time is it)\s+in\s+(.+)$/i.exec(text);
+  if (m) {
+    const zone = zoneOf(m[1]!);
+    return zone ? {kind: 'time', value: clock(now, zone),
+                   detail: `Now in ${m[1]!.trim()} (${zone})`} :
+                  null;
+  }
+  // "5pm london in new york", "17:30 tokyo to sf".
+  m = /^(\d{1,2})(?::(\d{2}))?\s*(am|pm)?\s+(.+?)\s+(?:in|to)\s+(.+)$/i.exec(text);
+  if (!m || (!m[2] && !m[3])) {
+    return null;
+  }
+  const from = zoneOf(m[4]!);
+  const to = zoneOf(m[5]!);
+  if (!from || !to) {
+    return null;
+  }
+  let hour = Number(m[1]);
+  const minute = Number(m[2] || 0);
+  if (m[3]) {
+    hour = hour % 12 + (m[3].toLowerCase() === 'pm' ? 12 : 0);
+  }
+  if (hour > 23 || minute > 59) {
+    return null;
+  }
+  // That time today where it was said, as an instant.
+  const day = new Intl.DateTimeFormat('en-CA', {timeZone: from}).format(now);
+  const [y, mo, d] = day.split('-').map(Number) as [number, number, number];
+  const guess = new Date(Date.UTC(y, mo - 1, d, hour, minute));
+  const instant = new Date(guess.getTime() - offsetOf(guess, from) * 60000);
+  return {kind: 'time', value: clock(instant, to),
+          detail: `${clock(instant, from)} in ${m[4]!.trim()}`};
+}
+
+// ---------------------------------------------------------------- answer
+
+export function quickAnswer(typed: string, now: Date,
+                            rates: CurrencyRates|null): QuickAnswer|null {
+  const text = typed.trim();
+  if (!text || text.length > MAX_LENGTH || /^[a-z][\w+.-]*:\/\//i.test(text)) {
+    return null;
+  }
+  return currency(text, rates) || unit(text) || time(text, now) || calc(text);
+}
