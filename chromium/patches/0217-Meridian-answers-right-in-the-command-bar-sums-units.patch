+
+#ifndef CHROME_BROWSER_MERIDIAN_CURRENCY_RATES_H_
+#define CHROME_BROWSER_MERIDIAN_CURRENCY_RATES_H_
+
+#include <map>
+#include <string>
+
+#include "base/functional/callback.h"
+
+class Profile;
+
+namespace meridian {
+
+// The European Central Bank's daily reference rates (per euro), for the
+// command bar's "100 usd in eur". Fetched when someone first asks, at most
+// once a day (after a failure: the last ones kept, again after an hour),
+// without cookies. `date` is the rates' own day; empty rates: none yet.
+using CurrencyRatesCallback =
+    base::OnceCallback<void(std::map<std::string, double> rates,
+                            std::string date)>;
+void GetCurrencyRates(Profile* profile, CurrencyRatesCallback callback);
+
+// The ECB file's rates (`<Cube currency='USD' rate='1.08'/>`) and day.
+std::map<std::string, double> ParseEcbRates(const std::string& xml,
+                                            std::string* date);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_CURRENCY_RATES_H_
