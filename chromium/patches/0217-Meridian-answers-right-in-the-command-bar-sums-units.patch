new file mode 100644
index 0000000000..464f48ed89
--- /dev/null
+++ b/chrome/browser/meridian/currency_rates.cc
@@ -0,0 +1,140 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/currency_rates.h"
+
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/meridian/test_switches.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/base/load_flags.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "third_party/re2/src/re2/re2.h"
+#include "url/gurl.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr char kEcbUrl[] =
+    "https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml";
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("meridian_currency_rates", R"(
+      semantics {
+        sender: "Meridian command bar"
+        description: "The European Central Bank's daily currency reference "
+          "rates, to answer a conversion typed in the command bar."
+        trigger: "The person types a currency conversion, at most once a day."
+        data: "None."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Not typing currency conversions."
+        policy_exception_justification: "Not implemented."
+      })");
+
+struct Cache {
+  std::map<std::string, double> rates;
+  std::string date;
+  base::Time fetched;
+  base::Time failed;
+  std::unique_ptr<network::SimpleURLLoader> loader;
+  std::vector<CurrencyRatesCallback> waiting;
+};
+
+Cache& TheCache() {
+  static base::NoDestructor<Cache> cache;
+  return *cache;
+}
+
+void Answer() {
+  Cache& c = TheCache();
+  std::vector<CurrencyRatesCallback> waiting = std::move(c.waiting);
+  c.waiting.clear();
+  for (CurrencyRatesCallback& cb : waiting) {
+    std::move(cb).Run(c.rates, c.date);
+  }
+}
+
+void OnLoaded(std::optional<std::string> body) {
+  Cache& c = TheCache();
+  c.loader.reset();
+  std::string date;
+  std::map<std::string, double> rates =
+      body ? ParseEcbRates(*body, &date) : std::map<std::string, double>();
+  if (rates.empty()) {
+    c.failed = base::Time::Now();
+  } else {
+    c.rates = std::move(rates);
+    c.date = date;
+    c.fetched = base::Time::Now();
+  }
+  Answer();
+}
+
+}  // namespace
+
+std::map<std::string, double> ParseEcbRates(const std::string& xml,
+                                            std::string* date) {
+  std::map<std::string, double> out;
+  re2::StringPiece input(xml);
+  std::string code;
+  std::string rate;
+  static const base::NoDestructor<re2::RE2> kRate(
+      R"(currency\s*=\s*['"]([A-Z]{3})['"]\s+rate\s*=\s*['"]([0-9.]+)['"])");
+  while (re2::RE2::FindAndConsume(&input, *kRate, &code, &rate)) {
+    double value = 0;
+    if (base::StringToDouble(rate, &value) && value > 0) {
+      out[code] = value;
+    }
+  }
+  std::string day;
+  if (re2::RE2::PartialMatch(xml, R"(time\s*=\s*['"](\d{4}-\d{2}-\d{2})['"])",
+                             &day)) {
+    *date = day;
+  }
+  return out;
+}
+
+void GetCurrencyRates(Profile* profile, CurrencyRatesCallback callback) {
+  Cache& c = TheCache();
+  const base::Time now = base::Time::Now();
+  const bool fresh = !c.rates.empty() && now - c.fetched < base::Hours(24);
+  const bool resting = !c.failed.is_null() && now - c.failed < base::Hours(1);
+  if (fresh || resting || !profile) {
+    std::move(callback).Run(c.rates, c.date);
+    return;
+  }
+  c.waiting.push_back(std::move(callback));
+  if (c.loader) {
+    return;
+  }
+  // Tests point it at their own server.
+  std::string test_url = TestSwitchValue("meridian-test-ecb-url");
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(test_url.empty() ? kEcbUrl : test_url);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  c.loader = network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+  c.loader->SetTimeoutDuration(base::Seconds(10));
+  c.loader->DownloadToString(
+      profile->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&OnLoaded),
+      256 * 1024);
+}
+
+}  // namespace meridian
