 void SidebarHandler::OpenInClaude(const std::string& request,
                                   OpenInClaudeCallback callback) {
+  // Claude's link for a new chat with `request` typed in (not sent), as on
+  // macOS (sidebar_handler_mac.mm).
+  const std::string link =
+      request.empty() ? std::string("claude://")
+                      : "claude://claude.ai/new?q=" +
+                            base::EscapeQueryParamValue(request,
+                                                        /*use_plus=*/false);
+  const std::string ready =
+      request.empty()
+          ? std::string("Claude is ready for Meridian.")
+          : std::string("Claude is open with your request. Press Enter there, "
+                        "then Allow. If the box is empty, paste it with "
+                        "Ctrl+V.");
+  // A test never touches a real Claude: it gets the link instead.
+  if (TestSwitchesAllowed()) {
+    base::FilePath log = TestSwitchPath("meridian-test-claude-log");
+    if (!log.empty()) {
+      base::ThreadPool::PostTask(
+          FROM_HERE, {base::MayBlock()},
+          base::BindOnce(
+              [](base::FilePath log, std::string line) {
+                line += "\n";
+                if (!base::PathExists(log)) {
+                  base::WriteFile(log, line);
+                } else {
+                  base::AppendToFile(log, line);
+                }
+              },
+              log, link));
+    }
+    std::move(callback).Run(true, ready + " [" + link + "]");
+    return;
+  }
+#if BUILDFLAG(IS_WIN)
+  // Claude for Windows opens claude:// links. The request is on the clipboard
+  // too, in case its box comes up empty.
+  if (!request.empty()) {
+    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+        .WriteText(base::UTF8ToUTF16(request));
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(
+          [](std::string link) {
+            base::win::RegKey key(HKEY_CLASSES_ROOT, L"claude", KEY_READ);
+            if (!key.Valid() || !key.HasValue(L"URL Protocol")) {
+              return false;
+            }
+            std::wstring wide = base::UTF8ToWide(link);
+            SHELLEXECUTEINFOW info = {sizeof(info)};
+            info.fMask = SEE_MASK_NOASYNC | SEE_MASK_FLAG_NO_UI;
+            info.lpVerb = L"open";
+            info.lpFile = wide.c_str();
+            info.nShow = SW_SHOWNORMAL;
+            return ::ShellExecuteExW(&info) != FALSE;
+          },
+          link),
+      base::BindOnce(
+          [](OpenInClaudeCallback callback, std::string ready, bool ok) {
+            std::move(callback).Run(
+                ok, ok ? ready : "Claude isn’t on this computer yet.");
+          },
+          std::move(callback), ready));
+#else
   std::move(callback).Run(false, "Open Claude and ask it there.");
+#endif
 }
 
