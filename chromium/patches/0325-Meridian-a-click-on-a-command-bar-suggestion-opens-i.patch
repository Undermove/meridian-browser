 .../webui_browser/meridian/command_bar.ts     |  13 ++
 .../webui_browser/webui_browser_searchbox.ts  | 118 +++++++++++++++++-
 3 files changed, 132 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/resources/webui_browser/meridian/command_bar.html.ts b/chrome/browser/resources/webui_browser/meridian/command_bar.html.ts
index b232644eab..ad21e39e55 100644
--- a/chrome/browser/resources/webui_browser/meridian/command_bar.html.ts
+++ b/chrome/browser/resources/webui_browser/meridian/command_bar.html.ts
@@ -27,7 +27,8 @@ export function getHtml(this: MeridianCommandBarElement) {
         .newTab="${this.newTab}" .inlineDropdown="${true}"
         .placeholderText="${'Search or Enter URL…'}"
         @keyup="${this.onAddressKeyup_}"
-        @searchbox-navigated="${this.onAddressSearchboxNavigated_}">
+        @searchbox-navigated="${this.onAddressSearchboxNavigated_}"
+        @searchbox-keyword="${this.onAddressSearchboxKeyword_}">
       ${this.quick_ ? html`
         <button id="quick" class="tab-row quick ${this.tabSel_ < 0 &&
                 this.quick_.action !== 'none' ? 'sel' : ''}"
diff --git a/chrome/browser/resources/webui_browser/meridian/command_bar.ts b/chrome/browser/resources/webui_browser/meridian/command_bar.ts
index f6e536a343..b6dc19e3b8 100644
--- a/chrome/browser/resources/webui_browser/meridian/command_bar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/command_bar.ts
@@ -905,6 +905,19 @@ export class MeridianCommandBarElement extends CrLitElement {
   protected onAddressSearchboxNavigated_() {
     this.hide();
   }
+
+  // "Search YouTube" clicked on a suggestion: that site's search, the way
+  // "youtube ⇥" enters it (the field's own keyword chip if Meridian has no
+  // mode for it).
+  protected onAddressSearchboxKeyword_(e: CustomEvent<{keyword: string}>) {
+    const mode = this.siteFor_(e.detail.keyword.toLowerCase());
+    if (!mode) {
+      return;
+    }
+    e.preventDefault();
+    this.tabSel_ = -1;
+    this.enterMode_(mode);
+  }
 }
 
