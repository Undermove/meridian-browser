 import {getCss} from './webui_browser_searchbox.css.js';
 import {getHtml} from './webui_browser_searchbox.html.js';
@@ -154,7 +156,113 @@ export class WebuiBrowserSearchboxElement extends
     this.navigateToLine_(matchIndex, e);
   }
 
+  // Meridian: a middle click or ⌘-click (Ctrl elsewhere) opens the match in
+  // a background tab and leaves the bar as it is, to open more (Arc).
+  override isBackgroundTabNavigation(e: KeyboardEvent|MouseEvent): boolean {
+    return e instanceof MouseEvent && !e.shiftKey &&
+        (e.button === 1 ||
+         (navigator.userAgent.includes('Mac') ? e.metaKey : e.ctrlKey));
+  }
+
+  // The browser's line of the match shown at `matchIndex` (the shown order is
+  // Meridian's, see `onAutocompleteResultChanged()`).
+  private browserLine_(matchIndex: number): number {
+    const line = this.lines_[matchIndex];
+    return line !== undefined && this.browserResult_ &&
+            this.result?.sequenceId === this.browserResult_.sequenceId ?
+        line :
+        matchIndex;
+  }
+
+  // Meridian: the press keeps the focus in the field (the row would take it,
+  // and fill the field with its text before the click).
+  private onMatchesMousedownCapture_ = (e: MouseEvent) => {
+    if (this.matchOf_(e)) {
+      e.preventDefault();
+    }
+  };
+
+  private matchOf_(e: Event): SearchboxMatchElement|null {
+    return (e.composedPath().find(
+               n => n instanceof HTMLElement &&
+                   n.localName === 'cr-searchbox-match') as
+            SearchboxMatchElement | undefined) ??
+        null;
+  }
+
+  // Meridian: a click on a suggestion acts like Return on it. The rows would
+  // tell the browser their place in the shown order, which isn't the
+  // browser's (it then does nothing: the line and the URL don't agree), and
+  // nothing would close the command bar or open a new tab for ⌘T.
+  private onMatchesClickCapture_ = (e: MouseEvent) => {
+    if (e.button > 1) {
+      return;
+    }
+    const row = this.matchOf_(e);
+    const match = row?.match;
+    if (!row || !match || row.matchIndex < 0) {
+      return;
+    }
+    e.preventDefault();
+    e.stopPropagation();
+    const path = e.composedPath();
+    const hit = (id: string) =>
+        path.find(n => n instanceof HTMLElement && n.id === id) as
+            HTMLElement |
+        undefined;
+    const line = this.browserLine_(row.matchIndex);
+    if (hit('remove')) {
+      if (e.button === 0) {
+        this.pageHandler().deleteAutocompleteMatch(line, match.destinationUrl);
+      }
+      return;
+    }
+    const action = hit('action');
+    if (action) {
+      this.pageHandler().executeAction(
+          line, Number(action.getAttribute('action-index')) || 0,
+          match.destinationUrl, mojoTimeTicks(Date.now()), e.button || 0,
+          e.altKey, e.ctrlKey, e.metaKey, e.shiftKey);
+      this.fire('searchbox-navigated');
+      return;
+    }
+    // "Search YouTube" on the row (or a row that is that search itself):
+    // that site's search, like Tab.
+    if (match.keywordModel &&
+        (hit('keyword') || match.keywordModel.type === KeywordType.kInstant)) {
+      // The command bar takes it into its own site search (the pill).
+      const taken = !this.dispatchEvent(new CustomEvent('searchbox-keyword', {
+        bubbles: true,
+        composed: true,
+        cancelable: true,
+        detail: {keyword: match.keywordModel.keyword},
+      }));
+      if (!taken) {
+        this.enterKeywordOf_(row.matchIndex, line);
+      }
+      return;
+    }
+    this.navigateToMatch(row.matchIndex, e);
+  };
+
+  // Chromium's keyword mode for the match (the chip in the field).
+  private enterKeywordOf_(matchIndex: number, line: number) {
+    const match = this.result?.matches[matchIndex];
+    if (!match?.keywordModel) {
+      return;
+    }
+    this.pageHandler().activateKeyword(
+        line, match.destinationUrl, mojoTimeTicks(Date.now()),
+        KeywordActivationMethod.kClick);
+    this.onKeywordClick(new CustomEvent(
+        'keyword-click', {detail: {match, matchIndex}}));
+  }
+
   private navigateToLine_(matchIndex: number, e: KeyboardEvent|MouseEvent) {
+    if (this.isBackgroundTabNavigation(e)) {
+      super.navigateToMatch(matchIndex, e);
+      return;
+    }
     if (!this.newTab) {
       super.navigateToMatch(matchIndex, e);
       this.fire('searchbox-navigated');
@@ -316,6 +424,14 @@ export class WebuiBrowserSearchboxElement extends
 
   override firstUpdated(changedProperties: PropertyValues<this>) {
     super.firstUpdated(changedProperties);
+    // Before the rows' own handlers (see `onMatchesClickCapture_()`).
+    const matches = this.$.matches;
+    matches.addEventListener(
+        'mousedown', this.onMatchesMousedownCapture_, {capture: true});
+    matches.addEventListener(
+        'click', this.onMatchesClickCapture_, {capture: true});
+    matches.addEventListener(
+        'auxclick', this.onMatchesClickCapture_, {capture: true});
     this.initialInputScrollHeight = this.$.input.scrollHeight;
   }
 
