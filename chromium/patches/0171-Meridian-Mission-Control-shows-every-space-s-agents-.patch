+  margin-right: 6px;
+  vertical-align: middle;
+  border-radius: 3px;
+  overflow: hidden;
+  background: color-mix(in srgb, var(--meridian-text) 10%, transparent);
+}
+
+.ctx-bar i {
+  display: block;
+  width: var(--p);
+  height: 100%;
+  background: var(--c);
+}
+
+.other-spaces {
+  display: block;
+  margin: 10px 12px;
+  font-size: 12px;
+}
