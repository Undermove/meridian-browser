+void MissionControl::SetTerminalNames(
+    int owner_tab,
+    const std::map<std::string, std::string>& names) {
+  bool changed = false;
+  for (auto& [id, node] : nodes_) {
+    if (node.owner_tab != owner_tab || node.term_id.empty()) {
+      continue;
+    }
+    auto it = names.find(node.term_id);
+    if (it == names.end()) {
+      continue;
+    }
+    std::string name = Clean(it->second, 80);
+    if (name != node.display_name) {
+      node.display_name = std::move(name);
+      changed = true;
+    }
+  }
+  if (changed) {
+    Changed();
+  }
