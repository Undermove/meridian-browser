+std::string SidebarHandler::MissionJson(base::DictValue snapshot) {
+  // The space each session's Workbench tab is in, and the spaces, so Mission
+  // Control can show where every agent runs and filter by space.
+  if (base::ListValue* nodes = snapshot.FindList("nodes")) {
+    for (base::Value& v : *nodes) {
+      base::DictValue& n = v.GetDict();
+      std::optional<int> owner = n.FindInt("ownerTab");
+      tabs::TabInterface* tab =
+          owner && *owner ? tabs::TabHandle(*owner).Get() : nullptr;
+      const TabData* data =
+          tab && tab->GetContents() ? TabData::Get(tab->GetContents()) : nullptr;
+      if (data && !data->space_id().empty()) {
+        n.Set("spaceId", data->space_id());
+      }
+    }
+  }
+  base::ListValue spaces;
+  for (const Space& s : service_->spaces()) {
+    spaces.Append(base::DictValue()
+                      .Set("id", s.id)
+                      .Set("name", s.name)
+                      .Set("icon", s.icon)
+                      .Set("color", s.color));
+  }
+  snapshot.Set("spaces", std::move(spaces));
+  snapshot.Set("activeSpace", service_->active_space_id());
+  return base::WriteJson(snapshot).value_or("{}");
+}
+
 void SidebarHandler::OnMissionChanged(const base::DictValue& snapshot) {
   if (page_.is_connected()) {
-    page_->OnMissionState(base::WriteJson(snapshot).value_or("{}"));
+    page_->OnMissionState(MissionJson(snapshot.Clone()));
   }
 }
 
