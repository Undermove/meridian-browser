From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Fri, 20 Nov 2026 00:08:01 +0400
Subject: [PATCH 196/196] Meridian: background tests: no alpha comes back, no
 fade-in

A window's alpha stays 0 whatever it is set to (fade-in animations set it
back), and macOS's own appear animation is off, in --meridian-test-background.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/app_controller_mac.mm | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/chrome/browser/app_controller_mac.mm b/chrome/browser/app_controller_mac.mm
index 6a19fb3e6a..b67fa1fb69 100644
--- a/chrome/browser/app_controller_mac.mm
+++ b/chrome/browser/app_controller_mac.mm
@@ -4,6 +4,8 @@
 
 #import "chrome/browser/app_controller_mac.h"
 
+#include <objc/runtime.h>
+
 #include <AppKit/AppKit.h>
 #include <dispatch/dispatch.h>
 #include <stddef.h>
@@ -950,6 +952,29 @@ class AppControllerProfileObserver : public ProfileAttributesStorage::Observer,
         }
       }
     };
+    // Fade-ins animate the alpha back up: whatever alpha a window is given,
+    // it stays see-through.
+    {
+      Method set_alpha = class_getInstanceMethod(NSWindow.class,
+                                                 @selector(setAlphaValue:));
+      using SetAlpha = void (*)(id, SEL, CGFloat);
+      static SetAlpha original_set_alpha =
+          reinterpret_cast<SetAlpha>(method_getImplementation(set_alpha));
+      method_setImplementation(
+          set_alpha, imp_implementationWithBlock(^(id window, CGFloat) {
+            original_set_alpha(window, @selector(setAlphaValue:), 0);
+          }));
+    }
+    // Nor does macOS fade a window in as it appears (that animation is the
+    // window server's, past the alpha above).
+    {
+      Method behavior = class_getInstanceMethod(NSWindow.class,
+                                                @selector(animationBehavior));
+      method_setImplementation(
+          behavior, imp_implementationWithBlock(^NSWindowAnimationBehavior(id) {
+            return NSWindowAnimationBehaviorNone;
+          }));
+    }
     [NSNotificationCenter.defaultCenter
         addObserverForName:NSWindowDidUpdateNotification
                     object:nil
