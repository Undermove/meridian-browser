+// Whether a folder or file named by the person's environment may be opened in
+// the sandbox: never the home folder or above it, nor anything holding, or
+// inside, what the sandbox protects.
+bool MayOpen(const base::FilePath& path,
+             const base::FilePath& home,
+             const std::vector<base::FilePath>& protected_paths) {
+  if (!path.IsAbsolute() || path.ReferencesParent()) {
+    return false;
+  }
+  const auto real = [](const base::FilePath& p) {
+    base::FilePath resolved = RealFilePath(p);
+    return resolved.empty() ? p : resolved;
+  };
+  const base::FilePath target = real(path);
+  const base::FilePath real_home = real(home);
+  if (target == real_home || target.IsParent(real_home)) {
+    return false;
+  }
+  for (const base::FilePath& p : protected_paths) {
+    const base::FilePath guarded = real(p);
+    if (target == guarded || guarded.IsParent(target) ||
+        target.IsParent(guarded)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// OpenCode's folders where the person's environment moved them.
+std::vector<base::FilePath> OpenCodeMovedFolders(
+    const base::FilePath& home,
+    const std::map<std::string, std::string>& env,
+    const std::vector<base::FilePath>& protected_paths) {
+  std::vector<base::FilePath> out;
+  const auto add = [&](const base::FilePath& path) {
+    if (MayOpen(path, home, protected_paths)) {
+      out.push_back(path);
+    }
+  };
+  for (const char* name : {"XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME",
+                           "XDG_CACHE_HOME"}) {
+    if (auto it = env.find(name); it != env.end() && !it->second.empty()) {
+      add(base::FilePath::FromUTF8Unsafe(it->second).AppendASCII("opencode"));
+    }
+  }
+  if (auto it = env.find("OPENCODE_CONFIG_DIR");
+      it != env.end() && !it->second.empty()) {
+    add(base::FilePath::FromUTF8Unsafe(it->second));
+  }
+  return out;
+}
+
+// The global config files, read only, wherever they really are: people keep
+// them in a dotfiles repository and link them here.
+std::vector<base::FilePath> OpenCodeConfigFiles(
+    const base::FilePath& home,
+    const std::map<std::string, std::string>& env,
+    const std::vector<base::FilePath>& protected_paths) {
+  std::vector<base::FilePath> dirs = {home.AppendASCII(".config/opencode")};
+  for (const char* name : {"XDG_CONFIG_HOME", "OPENCODE_CONFIG_DIR"}) {
+    if (auto it = env.find(name); it != env.end() && !it->second.empty()) {
+      base::FilePath dir = base::FilePath::FromUTF8Unsafe(it->second);
+      dirs.push_back(std::string_view(name) == "XDG_CONFIG_HOME"
+                         ? dir.AppendASCII("opencode")
+                         : dir);
+    }
+  }
+  std::vector<base::FilePath> files;
+  for (const base::FilePath& dir : dirs) {
+    files.push_back(dir.AppendASCII("opencode.json"));
+    files.push_back(dir.AppendASCII("opencode.jsonc"));
+  }
+  if (auto it = env.find("OPENCODE_CONFIG");
+      it != env.end() && !it->second.empty()) {
+    files.push_back(base::FilePath::FromUTF8Unsafe(it->second));
+  }
+  std::vector<base::FilePath> out;
+  for (const base::FilePath& file : files) {
+    const base::FilePath real = RealFilePath(file);
+    if (!real.empty() && base::PathExists(real) &&
+        !base::DirectoryExists(real) &&
+        MayOpen(real, home, protected_paths)) {
+      out.push_back(real);
+    }
+  }
+  return out;
+}
+
+// Asks this OpenCode, in the same sandbox, whether it has a background
+// service to stay away from. Remembered per installed binary.
+bool OpenCodeWantsPrivateServer(const std::string& bin,
+                                std::vector<std::string> argv,
+                                const std::map<std::string, std::string>& env,
+                                const std::string& cwd,
+                                scoped_refptr<CancelFlag> cancel) {
+  static base::NoDestructor<base::Lock> lock;
+  static base::NoDestructor<std::map<std::string, bool>> known;
+  base::File::Info info;
+  base::GetFileInfo(RealFilePath(base::FilePath::FromUTF8Unsafe(bin)), &info);
+  const std::string key =
+      bin + "|" +
+      base::NumberToString(info.last_modified.InMillisecondsSinceUnixEpoch()) +
+      "|" + base::NumberToString(info.size);
+  {
+    base::AutoLock hold(*lock);
+    if (auto it = known->find(key); it != known->end()) {
+      return it->second;
+    }
+  }
+  ProcessSpec probe;
+  probe.argv = std::move(argv);
+  probe.env = env;
+  probe.cwd = cwd;
+  probe.stdin_text = "";
+  probe.timeout = base::Seconds(15);
+  probe.max_output = 256u << 10;
+  std::string help;
+  const ProcessResult result = RunProcess(
+      probe, cancel,
+      base::BindRepeating(
+          [](std::string* out, std::string_view chunk) { out->append(chunk); },
+          base::Unretained(&help)));
+  help += result.stderr_text;
+  const bool wants = OpenCodeNeedsPrivateServer(help);
+  if (result.started && result.exit_code == 0 && !result.killed) {
+    base::AutoLock hold(*lock);
+    (*known)[key] = wants;
+  }
+  return wants;
+}
