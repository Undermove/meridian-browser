+/* Before the first question: what the panel can do here. */
+.starters {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin-top: auto;
+}
+
+.starters-title {
+  margin: 0 0 4px 2px;
+  font-size: 12px;
+  font-weight: 550;
+  color: var(--meridian-text-muted);
+}
+
+.starter {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 9px 11px;
+  border-radius: 10px;
+  text-align: start;
+  background: color-mix(in srgb, var(--meridian-text) 4%, transparent);
+  transition: background 120ms ease, transform 120ms ease;
+}
+
+.starter:hover {
+  background: color-mix(in srgb, var(--meridian-space) 18%, transparent);
+}
+
+.starter:active {
+  transform: scale(0.985);
+}
+
+.starter-label {
+  font-weight: 550;
+  overflow-wrap: anywhere;
+}
+
+.starter-hint {
+  font-size: 11.5px;
+  color: var(--meridian-text-muted);
+}
+
+/* The AI at work: dots until the first word, then a caret after the last. */
+.thinking {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  min-height: 20px;
+  color: var(--meridian-text-muted);
+  font-size: 12.5px;
+}
+
+.thinking i {
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: var(--meridian-space);
+  animation: ask-dot 1.1s ease-in-out infinite;
+}
+
+.thinking i:nth-child(2) {
+  animation-delay: 0.15s;
+}
+
+.thinking i:nth-child(3) {
+  animation-delay: 0.3s;
+}
+
+.thinking span {
+  margin-left: 4px;
+}
+
+@keyframes ask-dot {
+  0%,
+  70%,
+  100% {
+    opacity: 0.3;
+    transform: translateY(0);
+  }
+
+  35% {
+    opacity: 1;
+    transform: translateY(-3px);
+  }
+}
+
+.answer.streaming > :last-child:not(ul, ol, pre)::after,
+.answer.streaming > :is(ul, ol):last-child > li:last-child::after {
+  content: '';
+  display: inline-block;
+  width: 2px;
+  height: 1em;
+  margin-left: 2px;
+  vertical-align: -2px;
+  background: var(--meridian-space);
+  animation: ask-caret 1s steps(2, jump-none) infinite;
+}
+
+@keyframes ask-caret {
+  from {
+    opacity: 1;
+  }
+
+  to {
+    opacity: 0;
+  }
+}
+
+.boost-note {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: 2px;
+  color: var(--meridian-text-muted);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .thinking i,
+  .answer.streaming > :last-child::after,
+  .answer.streaming > :is(ul, ol):last-child > li:last-child::after {
+    animation: none;
+  }
+
+  .starter {
+    transition: none;
+  }
+}
+
+/* Who answers this chat: a menu in the header. */
+button.who {
+  display: inline-flex;
+  align-items: center;
+  gap: 3px;
+  height: 20px;
+}
+
+button.who:hover {
+  color: var(--meridian-text);
+  background: color-mix(in srgb, var(--meridian-text) 13%, transparent);
+}
+
+#whoMenu {
+  position: absolute;
+  z-index: 5;
+  top: 36px;
+  left: 54px;
+  display: flex;
+  flex-direction: column;
+  min-width: 190px;
+  max-height: 320px;
+  overflow-y: auto;
+  padding: 4px;
+  border-radius: 10px;
+  background: var(--meridian-surface);
+  box-shadow: 0 0 0 0.5px var(--meridian-border), 0 6px 22px rgba(0, 0, 0, 0.16);
+}
+
+.who-item {
+  padding: 6px 9px;
+  border-radius: 7px;
+  text-align: start;
+}
+
+.who-item:hover {
+  background: var(--meridian-row-hover);
+}
+
+.who-item.more {
+  margin-top: 3px;
+  color: var(--meridian-text-muted);
+}
