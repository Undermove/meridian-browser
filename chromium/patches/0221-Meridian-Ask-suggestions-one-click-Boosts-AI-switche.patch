-  if (consent_waiting_.size() > 1) {
-    return;  // one question for all of them
+  consent_waiting_.push_back({provider, std::move(go), std::move(refuse)});
+  if (consent_asking_.empty()) {
+    AskNextConsent();  // else one question at a time
+  }
+}
+
+void AiService::AskNextConsent() {
+  if (consent_waiting_.empty()) {
+    return;
   }
-  Asker().Run(profile_, to,
+  const std::string provider = consent_waiting_.front().provider;
+  consent_asking_ = ConsentId(provider);
+  Asker().Run(profile_, DestinationOf(provider),
               base::BindOnce(&AiService::OnConsent,
                              weak_factory_.GetWeakPtr()));
 }
 
 void AiService::OnConsent(const std::string& choice) {
-  if (choice == "always") {
-    profile_->GetPrefs()->SetString(prefs::kAiConsent, "always");
-  } else if (choice == "off") {
-    profile_->GetPrefs()->SetString(prefs::kAiConsent, "off");
-  }
+  const std::string asked = std::exchange(consent_asking_, std::string());
   const bool yes = choice == "send" || choice == "always";
-  if (yes) {
-    consent_this_run_ = true;
+  const bool off = choice == "off";
+  if (off) {
+    profile_->GetPrefs()->SetString(prefs::kAiConsent, "off");
+  } else if (yes) {
+    AllowProvider(asked, choice == "always");
   }
   const std::string why =
-      choice == "off"     ? "AI features are off. Turn them on in Settings › AI."
+      off                 ? "AI features are off. Turn them on in Settings › AI."
       : choice == "other" ? "Pick the AI to use in Settings › AI."
                           : "Not sent: you didn’t allow it.";
-  auto waiting = std::move(consent_waiting_);
-  consent_waiting_.clear();
-  for (auto& [go, refuse] : waiting) {
+  // The answer is about this AI; a request for another one gets its own
+  // question (with AI off, none goes).
+  std::vector<ConsentWait> answered;
+  std::vector<ConsentWait> others;
+  for (ConsentWait& wait : consent_waiting_) {
+    (off || ConsentId(wait.provider) == asked ? answered : others)
+        .push_back(std::move(wait));
+  }
+  consent_waiting_ = std::move(others);
+  for (ConsentWait& wait : answered) {
     if (yes) {
-      std::move(go).Run();
+      std::move(wait.go).Run();
     } else {
-      std::move(refuse).Run(why);
+      std::move(wait.refuse).Run(why);
     }
   }
+  if (consent_asking_.empty()) {
+    AskNextConsent();
+  }
 }
 
