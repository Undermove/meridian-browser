+namespace {
+
+// Claude on a key and Claude Code go to the same company and are one answer.
+std::string ConsentId(const std::string& provider) {
+  return provider == "api" || provider == "claude" ? "claude-code" : provider;
+}
+
+}  // namespace
+
 bool AiService::ConsentGiven(const std::string& provider) const {
   const std::string consent =
       profile_->GetPrefs()->GetString(prefs::kAiConsent);
   if (consent == "off") {
     return false;
   }
+  const std::string id = ConsentId(provider);
   // On this computer, said yes already, or a test that doesn't ask about it.
   return DestinationOf(provider).empty() || consent == "always" ||
-         consent_this_run_ ||
+         consent_this_run_.contains(id) ||
+         std::ranges::contains(
+             profile_->GetPrefs()->GetList(prefs::kAiConsentAllowed),
+             base::Value(id)) ||
          (TestSwitchesAllowed() && !HasTestSwitch("meridian-test-ai-consent")) ||
          Asker().is_null();
 }
 
+void AiService::AllowProvider(const std::string& provider, bool always) {
+  const std::string id = ConsentId(provider);
+  consent_this_run_.insert(id);
+  if (always) {
+    ScopedListPrefUpdate update(profile_->GetPrefs(),
+                                prefs::kAiConsentAllowed);
+    if (!std::ranges::contains(*update, base::Value(id))) {
+      update->Append(id);
+    }
+  }
+}
+
+std::vector<std::pair<std::string, std::string>> AiService::AlwaysAllowed()
+    const {
+  std::vector<std::pair<std::string, std::string>> out;
+  for (const base::Value& v :
+       profile_->GetPrefs()->GetList(prefs::kAiConsentAllowed)) {
+    if (v.is_string()) {
+      std::string to = DestinationOf(v.GetString());
+      out.emplace_back(v.GetString(), to.empty() ? v.GetString() : to);
+    }
+  }
+  return out;
+}
+
+void AiService::ForgetConsent(const std::string& provider) {
+  const std::string id = ConsentId(provider);
+  consent_this_run_.erase(id);
+  ScopedListPrefUpdate update(profile_->GetPrefs(), prefs::kAiConsentAllowed);
+  update->EraseValue(base::Value(id));
+}
+
