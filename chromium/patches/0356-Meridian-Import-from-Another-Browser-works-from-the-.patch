diff --git a/chrome/browser/meridian/commands.h b/chrome/browser/meridian/commands.h
new file mode 100644
index 0000000000..069a4295f8
--- /dev/null
+++ b/chrome/browser/meridian/commands.h
@@ -0,0 +1,23 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_COMMANDS_H_
+#define CHROME_BROWSER_MERIDIAN_COMMANDS_H_
+
+#include "chrome/app/chrome_command_ids.h"
+
+namespace meridian {
+
+// Meridian's own browser commands: every IDC_MERIDIAN_* in
+// chrome_command_ids.h. BrowserCommandController supports and enables them
+// itself (they have no ActionItem); one outside this range is dead in the
+// menu and for its shortcut, as Import from Another Browser (39729) was in
+// 1.5.2 and 1.5.3 while the range ended at Ask (39728).
+constexpr bool IsMeridianCommand(int id) {
+  return id >= IDC_MERIDIAN_FIRST && id <= IDC_MERIDIAN_LAST;
+}
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_COMMANDS_H_
diff --git a/chrome/browser/meridian/commands_unittest.cc b/chrome/browser/meridian/commands_unittest.cc
new file mode 100644
index 0000000000..6cd17bb90b
--- /dev/null
+++ b/chrome/browser/meridian/commands_unittest.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/commands.h"
+
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/path_service.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+static_assert(IsMeridianCommand(IDC_MERIDIAN_TOGGLE_SIDEBAR));
+static_assert(IsMeridianCommand(IDC_MERIDIAN_ASK_PAGE));
+static_assert(IsMeridianCommand(IDC_MERIDIAN_IMPORT_OTHER));
+static_assert(IsMeridianCommand(IDC_MERIDIAN_SPACE_9));
+
+// Every `#define IDC_MERIDIAN_<NAME> <number>` in chrome_command_ids.h, as
+// the file says it (a new command needs no change here).
+std::vector<std::pair<std::string, int>> MeridianCommandIds() {
+  base::FilePath src;
+  base::PathService::Get(base::DIR_SRC_TEST_DATA_ROOT, &src);
+  std::string text;
+  EXPECT_TRUE(base::ReadFileToString(
+      src.AppendASCII("chrome/app/chrome_command_ids.h"), &text));
+  std::vector<std::pair<std::string, int>> ids;
+  for (std::string_view line : base::SplitStringPiece(
+           text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    std::vector<std::string_view> parts = base::SplitStringPiece(
+        line, " \t", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    int id = 0;
+    if (parts.size() >= 3 && parts[0] == "#define" &&
+        base::StartsWith(parts[1], "IDC_MERIDIAN_") &&
+        base::StringToInt(parts[2], &id)) {
+      ids.emplace_back(std::string(parts[1]), id);
+    }
+  }
+  return ids;
+}
+
+TEST(MeridianCommandsTest, EveryMeridianCommandIsInTheRange) {
+  const auto ids = MeridianCommandIds();
+  ASSERT_GE(ids.size(), 20u) << "chrome_command_ids.h not read";
+  for (const auto& [name, id] : ids) {
+    EXPECT_TRUE(IsMeridianCommand(id))
+        << name << " (" << id << ") is outside [IDC_MERIDIAN_FIRST, "
+        << "IDC_MERIDIAN_LAST]: its menu item and shortcut would be dead";
+  }
+}
+
+TEST(MeridianCommandsTest, NothingElseIsInTheRange) {
+  // The range holds Meridian's ids only, without gaps a Chromium id could
+  // take.
+  const auto ids = MeridianCommandIds();
+  for (int id = IDC_MERIDIAN_FIRST; id <= IDC_MERIDIAN_LAST; ++id) {
+    // Spaces 2-8 are IDC_MERIDIAN_SPACE_1 + n, without a #define of their own.
+    bool known = id >= IDC_MERIDIAN_SPACE_1 && id <= IDC_MERIDIAN_SPACE_9;
+    for (const auto& entry : ids) {
+      known |= entry.second == id;
+    }
+    EXPECT_TRUE(known) << id << " is in Meridian's range but no IDC_MERIDIAN_*";
+  }
+  EXPECT_FALSE(IsMeridianCommand(IDC_MERIDIAN_FIRST - 1));
+  EXPECT_FALSE(IsMeridianCommand(IDC_MERIDIAN_LAST + 1));
+}
+
+}  // namespace
+}  // namespace meridian
