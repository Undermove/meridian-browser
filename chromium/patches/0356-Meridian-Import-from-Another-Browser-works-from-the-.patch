diff --git a/chrome/app/chrome_command_ids.h b/chrome/app/chrome_command_ids.h
index b1775f5874..7b5401d047 100644
--- a/chrome/app/chrome_command_ids.h
+++ b/chrome/app/chrome_command_ids.h
@@ -139,6 +139,12 @@
 // Spaces 1-9: IDC_MERIDIAN_SPACE_1 + n.
 #define IDC_MERIDIAN_SPACE_1          39710
 #define IDC_MERIDIAN_SPACE_9          39718
+// Every IDC_MERIDIAN_* above lies in [IDC_MERIDIAN_FIRST, IDC_MERIDIAN_LAST]
+// (meridian::IsMeridianCommand, which keeps them alive without an ActionItem).
+// A new Meridian command after the last one moves IDC_MERIDIAN_LAST to it;
+// meridian_unittests (MeridianCommandsTest) fails until it does.
+#define IDC_MERIDIAN_FIRST            IDC_MERIDIAN_TOGGLE_SIDEBAR
+#define IDC_MERIDIAN_LAST             IDC_MERIDIAN_IMPORT_OTHER
 
 #define IDC_ADD_NEW_TAB_TO_GROUP      34100
 #define IDC_CREATE_NEW_TAB_GROUP      34101
