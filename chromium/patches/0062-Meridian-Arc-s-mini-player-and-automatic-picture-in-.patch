@@ -0,0 +1,96 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/now_playing.h"
+
+#include <algorithm>
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/browser_apis/tab_strip/types/node_id.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/media_session.h"
+#include "content/public/browser/web_contents.h"
+#include "services/media_session/public/cpp/media_metadata.h"
+#include "services/media_session/public/mojom/media_session.mojom.h"
+
+namespace meridian {
+
+namespace {
+
+using media_session::mojom::MediaPlaybackState;
+using media_session::mojom::MediaSessionAction;
+using media_session::mojom::MediaSessionInfo;
+
+bool Can(const std::vector<MediaSessionAction>& actions,
+         MediaSessionAction action) {
+  return std::ranges::find(actions, action) != actions.end();
+}
+
+}  // namespace
+
+mojom::NowPlayingPtr FindNowPlaying(TabStripModel* model) {
+  tabs::TabInterface* active = model->GetActiveTab();
+  mojom::NowPlayingPtr best;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (tab == active) {
+      continue;
+    }
+    content::WebContents* contents = tab->GetContents();
+    content::MediaSession* session = content::MediaSession::GetIfExists(contents);
+    if (!session) {
+      continue;
+    }
+    media_session::mojom::MediaSessionInfoPtr info =
+        session->GetMediaSessionInfoSync();
+    if (!info || !info->is_controllable ||
+        info->state == MediaSessionInfo::SessionState::kInactive) {
+      continue;
+    }
+    bool playing = info->playback_state == MediaPlaybackState::kPlaying;
+    if (best && (best->playing || !playing)) {
+      continue;
+    }
+    const media_session::MediaMetadata& metadata =
+        session->GetMediaSessionMetadata();
+    std::vector<MediaSessionAction> actions =
+        session->GetMediaSessionActionsSync();
+    auto now = mojom::NowPlaying::New();
+    now->tab_id = tabs_api::NodeId::FromTabHandle(tab->GetHandle());
+    now->title = base::UTF16ToUTF8(metadata.title);
+    if (now->title.empty()) {
+      now->title = base::UTF16ToUTF8(contents->GetTitle());
+    }
+    now->artist = base::UTF16ToUTF8(metadata.artist);
+    now->source = contents->GetLastCommittedURL().host();
+    now->playing = playing;
+    now->can_previous = Can(actions, MediaSessionAction::kPreviousTrack);
+    now->can_next = Can(actions, MediaSessionAction::kNextTrack);
+    now->can_pip = Can(actions, MediaSessionAction::kEnterPictureInPicture);
+    best = std::move(now);
+  }
+  return best;
+}
+
+void ControlMedia(content::WebContents* contents, const std::string& action) {
+  content::MediaSession* session = content::MediaSession::GetIfExists(contents);
+  if (!session) {
+    return;
+  }
+  using SuspendType = media_session::mojom::MediaSession::SuspendType;
+  if (action == "play") {
+    session->Resume(SuspendType::kUI);
+  } else if (action == "pause") {
+    session->Suspend(SuspendType::kUI);
+  } else if (action == "next") {
+    session->NextTrack();
+  } else if (action == "previous") {
+    session->PreviousTrack();
+  } else if (action == "pip") {
+    session->EnterPictureInPicture();
+  }
+}
+
+}  // namespace meridian
