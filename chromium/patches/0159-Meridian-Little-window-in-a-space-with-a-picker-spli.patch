+void SidebarHandler::SplitTabs(const tabs_api::NodeId& onto,
+                               const tabs_api::NodeId& dropped) {
+  tabs::TabInterface* left = TabFor(onto);
+  tabs::TabInterface* right = TabFor(dropped);
+  if (!left || !right || left == right || left->GetSplit() ||
+      right->GetSplit()) {
+    return;
+  }
+  // The dropped tab right after the one it joins: the split keeps the strip's
+  // order, so it shows on the right.
+  int from = model()->GetIndexOfTab(right);
+  int to = model()->GetIndexOfTab(left) + 1;
+  if (from < to) {
+    --to;
+  }
+  if (from != to) {
+    model()->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+  }
+  model()->ActivateTabAt(model()->GetIndexOfTab(right));
+  model()->AddToNewSplit(
+      {model()->GetIndexOfTab(left)},
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kSideBySide),
+      split_tabs::SplitTabCreatedSource::kDragAndDropTab);
+}
+
+void SidebarHandler::UnsplitTab(const tabs_api::NodeId& tab_id) {
+  tabs::TabInterface* tab = TabFor(tab_id);
+  if (tab && tab->GetSplit()) {
+    model()->RemoveSplit(*tab->GetSplit());
+  }
+}
