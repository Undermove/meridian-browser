+
+void SetLittleSpace(BrowserWindowInterface* browser,
+                    const std::string& space_id) {
+  auto it = LittleWindows().find(browser);
+  SidebarService* service =
+      SidebarServiceFactory::GetForProfile(browser->GetProfile());
+  TabStripModel* model = browser->GetTabStripModel();
+  tabs::TabInterface* old = model->GetActiveTab();
+  if (it == LittleWindows().end() || !service ||
+      !service->FindSpace(space_id) || it->second.space_id == space_id ||
+      !old) {
+    return;
+  }
+  content::WebContents* contents = old->GetContents();
+  GURL url = contents->GetLastCommittedURL().is_empty()
+                 ? contents->GetVisibleURL()
+                 : contents->GetLastCommittedURL();
+  it->second.space_id = space_id;
+  // The new page first: the window closes with its last tab.
+  OpenInSpace(browser, space_id, url, /*active=*/true);
+  model->CloseWebContentsAt(model->GetIndexOfTab(old),
+                            TabCloseTypes::CLOSE_NONE);
+}
