+
+// Polling the page's queue: fast while a tool is up, slow otherwise; never
+// for a tab that isn't visible.
+constexpr base::TimeDelta kBusy = base::Milliseconds(60);
+constexpr base::TimeDelta kIdle = base::Milliseconds(400);
+
+constexpr char16_t kTake[] =
+    u"window.__meridianToolkit ? window.__meridianToolkit.take() : null";
+
+}  // namespace
+
+bool Enabled(Profile* profile) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "enable-meridian-toolkit") ||
+      HasTestSwitch("meridian-toolkit")) {
+    return true;
+  }
+  return profile &&
+         MainProfileFor(profile)->GetPrefs()->GetBoolean(
+             prefs::kToolkitEnabled);
+}
+
+ToolkitTabHelper::ToolkitTabHelper(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<ToolkitTabHelper>(*contents) {}
+
+ToolkitTabHelper::~ToolkitTabHelper() = default;
+
+bool ToolkitTabHelper::On() const {
+  return Enabled(
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext()));
+}
+
+bool ToolkitTabHelper::Injectable() const {
+  const GURL& url = web_contents()->GetLastCommittedURL();
+  return url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile();
+}
+
+void ToolkitTabHelper::Run(const std::string& script) {
+  web_contents()->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(script), base::NullCallback(),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void ToolkitTabHelper::Inject() {
+  if (!On() || !Injectable()) {
+    return;
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+  base::DictValue config;
+  config.Set("store",
+             MainProfileFor(profile)->GetPrefs()->GetDict(prefs::kToolkitStore)
+                 .Clone());
+#if BUILDFLAG(IS_MAC)
+  config.Set("platform", "mac");
+#else
+  config.Set("platform", "other");
+#endif
+  Run(std::string(kToolkitCoreJs) + "\nwindow.__meridianToolkitConfig = " +
+      base::WriteJson(config).value_or("{}") + ";\n" + kToolkitMeridianJs);
+  Schedule(false);
+}
+
+void ToolkitTabHelper::DOMContentLoaded(content::RenderFrameHost* frame) {
+  if (frame == web_contents()->GetPrimaryMainFrame()) {
+    Inject();
+  }
+}
+
+void ToolkitTabHelper::OnVisibilityChanged(content::Visibility visibility) {
+  if (visibility == content::Visibility::VISIBLE) {
+    Schedule(false);
+  } else {
+    timer_.Stop();
+  }
+}
+
+void ToolkitTabHelper::Schedule(bool busy) {
+  busy_ = busy;
+  if (!On() || !Injectable() ||
+      web_contents()->GetVisibility() != content::Visibility::VISIBLE) {
+    timer_.Stop();
+    return;
+  }
+  timer_.Start(FROM_HERE, busy ? kBusy : kIdle,
+               base::BindOnce(&ToolkitTabHelper::Poll,
+                              weak_factory_.GetWeakPtr()));
+}
+
+void ToolkitTabHelper::Poll() {
+  web_contents()->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      kTake,
+      base::BindOnce(&ToolkitTabHelper::OnPolled, weak_factory_.GetWeakPtr()),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void ToolkitTabHelper::OnPolled(base::Value result) {
+  if (!result.is_dict()) {
+    // A document without the toolkit yet (or the flag went off).
+    Schedule(false);
+    return;
+  }
+  const base::DictValue& dict = result.GetDict();
+  if (const base::ListValue* ops = dict.FindList("ops")) {
+    for (const base::Value& op : *ops) {
+      if (!op.is_dict()) {
+        continue;
+      }
+      const base::DictValue& o = op.GetDict();
+      const std::string* name = o.FindString("op");
+      const base::DictValue* args = o.FindDict("args");
+      const int id = o.FindInt("id").value_or(0);
+      if (!name || !args) {
+        continue;
+      }
+      if (*name == "copy") {
+        Copy(id, *args);
+      } else if (*name == "capture") {
+        Capture(id, *args);
+      } else if (*name == "store") {
+        Store(*args);
+      }
+    }
+  }
+  Schedule(dict.FindBool("busy").value_or(false));
+}
+
+void ToolkitTabHelper::Answer(int id, base::Value value) {
+  Run("window.__meridianToolkit && window.__meridianToolkit.answer(" +
+      base::NumberToString(id) + ", " +
+      base::WriteJson(value).value_or("null") + ");");
+}
+
+void ToolkitTabHelper::Copy(int id, const base::DictValue& args) {
+  const std::string* text = args.FindString("text");
+  const std::string* html = args.FindString("html");
+  const std::string* png = args.FindString("png");
+  bool wrote = false;
+  {
+    ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+    if (text && !text->empty()) {
+      writer.WriteText(base::UTF8ToUTF16(*text));
+      wrote = true;
+    }
+    if (html && !html->empty()) {
+      writer.WriteHTML(base::UTF8ToUTF16(*html),
+                       web_contents()->GetLastCommittedURL().spec());
+      wrote = true;
+    }
+    if (png && !png->empty()) {
+      std::optional<std::vector<uint8_t>> bytes = base::Base64Decode(*png);
+      if (bytes) {
+        SkBitmap bitmap = gfx::PNGCodec::Decode(*bytes);
+        if (!bitmap.drawsNothing()) {
+          writer.WriteImage(bitmap);
+          wrote = true;
+        }
+      }
+    }
+  }
+  Answer(id, base::Value(wrote));
+}
+
+double ToolkitTabHelper::Zoom() const {
+  return blink::ZoomLevelToZoomFactor(
+      content::HostZoomMap::GetZoomLevel(web_contents()));
+}
+
+void ToolkitTabHelper::Capture(int id, const base::DictValue& args) {
+  content::RenderWidgetHostView* view =
+      web_contents()->GetRenderWidgetHostView();
+  if (!view) {
+    return Answer(id, base::Value());
+  }
+  // The page speaks CSS pixels; the view, DIP (CSS × zoom).
+  const double zoom = Zoom();
+  gfx::RectF css(args.FindDouble("x").value_or(0),
+                 args.FindDouble("y").value_or(0),
+                 args.FindDouble("width").value_or(0),
+                 args.FindDouble("height").value_or(0));
+  css.Scale(zoom);
+  gfx::Rect src = gfx::ToEnclosingRect(css);
+  src.Intersect(gfx::Rect(view->GetViewBounds().size()));
+  if (src.IsEmpty()) {
+    return Answer(id, base::Value());
+  }
+  const gfx::Size out =
+      gfx::ScaleToCeiledSize(src.size(), view->GetDeviceScaleFactor());
+  view->CopyFromSurface(
+      src, out, base::Seconds(5),
+      base::BindOnce(
+          [](base::WeakPtr<ToolkitTabHelper> self, int id,
+             const content::CopyFromSurfaceResult& result) {
+            if (!self) {
+              return;
+            }
+            if (!result.has_value() || result->bitmap.drawsNothing()) {
+              return self->Answer(id, base::Value());
+            }
+            std::optional<std::vector<uint8_t>> png =
+                gfx::PNGCodec::EncodeBGRASkBitmap(result->bitmap,
+                                                  /*discard_transparency=*/
+                                                  false);
+            self->Answer(id, png ? base::Value(base::Base64Encode(*png))
+                                 : base::Value());
+          },
+          weak_factory_.GetWeakPtr(), id));
+}
+
+void ToolkitTabHelper::Store(const base::DictValue& args) {
+  const std::string* key = args.FindString("key");
+  const base::Value* value = args.Find("value");
+  // Only the toolkit's own keys, small.
+  if (!key || !value || (*key != "brand" && *key != "prefs")) {
+    return;
+  }
+  if (base::WriteJson(*value).value_or("").size() > 64 * 1024) {
+    return;
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+  ScopedDictPrefUpdate update(MainProfileFor(profile)->GetPrefs(),
+                              prefs::kToolkitStore);
+  update->Set(*key, value->Clone());
+}
+
+void ToolkitTabHelper::ContextAction(const std::string& kind, int x, int y) {
+  if (!On() || !Injectable()) {
+    return;
+  }
+  const double zoom = Zoom();
+  Run("window.__meridianToolkit && window.__meridianToolkit.ctx(" +
+      base::WriteJson(base::Value(kind)).value_or("\"\"") + ", " +
+      base::NumberToString(x / zoom) + ", " + base::NumberToString(y / zoom) +
+      ");");
+  Schedule(true);
+}
+
+bool HasToolkit(content::WebContents* contents) {
+  ToolkitTabHelper* helper =
+      contents ? ToolkitTabHelper::FromWebContents(contents) : nullptr;
+  return helper && helper->On() && helper->Injectable();
+}
+
+bool ContextAction(content::WebContents* contents,
+                   const std::string& kind,
+                   int x,
+                   int y) {
+  if (!HasToolkit(contents)) {
+    return false;
+  }
+  ToolkitTabHelper::FromWebContents(contents)->ContextAction(kind, x, y);
+  return true;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ToolkitTabHelper);
+
+}  // namespace meridian::toolkit
