@@ -0,0 +1,1377 @@
+// Meridian designer toolkit — portable core.
+// Plain page-level JS (content-script style): no Meridian-only APIs here. Everything the host
+// browser does better (clipboard without a gesture, real pixels, Brand storage per Space, the
+// agent) comes through an adapter passed to create(). The same file can ship in an MV3 extension.
+//
+//   const tk = window.__meridianToolkitCore.create(adapter);
+//   adapter = {
+//     copy(items) -> Promise<bool>        items: {text?, html?, png?: Blob}; default: navigator.clipboard
+//     capture(rect) -> Promise<Blob|null>  rect in CSS px, viewport-relative; null = no pixels (preview only)
+//     fetchImage(url) -> Promise<Blob|null> bytes of a cross-origin image (CORS-free fetch)
+//     store: {get(key) -> Promise<any>, set(key, value) -> Promise}
+//     sendToAgent?(payload), sendTo?(target, payload), connectedTargets?() -> string[]
+//     extraTools?: [{id, label, icon, key, run()}]   e.g. Meridian's "Телефон"
+//     ownContextMenu?: bool   true = right-click on the page shows the toolkit menu (prototype/extension)
+//     platform?: 'mac'|'win'|'linux'
+//   }
+(() => {
+'use strict';
+if (window.__meridianToolkitCore) return;
+
+// ------------------------------------------------------------------ colour maths
+const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
+function parseColor(s) {
+  if (!s) return null;
+  let m = s.match(/rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:\s*[,/]\s*([\d.]+%?))?\s*\)/);
+  if (m) {
+    let a = m[4] === undefined ? 1 : m[4].endsWith('%') ? parseFloat(m[4]) / 100 : +m[4];
+    return { r: +m[1], g: +m[2], b: +m[3], a };
+  }
+  m = s.match(/^#([0-9a-f]{3,8})$/i);
+  if (m) {
+    let h = m[1]; if (h.length <= 4) h = [...h].map(c => c + c).join('');
+    return { r: parseInt(h.slice(0, 2), 16), g: parseInt(h.slice(2, 4), 16), b: parseInt(h.slice(4, 6), 16), a: h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1 };
+  }
+  // colour() / oklch() etc: let the browser normalise through a canvas
+  try {
+    const c = parseColor.ctx || (parseColor.ctx = document.createElement('canvas').getContext('2d', { willReadFrequently: true }));
+    c.clearRect(0, 0, 1, 1); c.fillStyle = '#000'; c.fillStyle = s; c.fillRect(0, 0, 1, 1);
+    const d = c.getImageData(0, 0, 1, 1).data; return { r: d[0], g: d[1], b: d[2], a: d[3] / 255 };
+  } catch { return null; }
+}
+const hex2 = v => Math.round(clamp(v, 0, 255)).toString(16).padStart(2, '0');
+const toHex = c => ('#' + hex2(c.r) + hex2(c.g) + hex2(c.b) + (c.a < 1 ? hex2(c.a * 255) : '')).toUpperCase();
+const over = (top, bot) => { const a = top.a + bot.a * (1 - top.a); if (!a) return { r: 0, g: 0, b: 0, a: 0 };
+  return { r: (top.r * top.a + bot.r * bot.a * (1 - top.a)) / a, g: (top.g * top.a + bot.g * bot.a * (1 - top.a)) / a, b: (top.b * top.a + bot.b * bot.a * (1 - top.a)) / a, a }; };
+const lin = v => { v /= 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; };
+const lum = c => 0.2126 * lin(c.r) + 0.7152 * lin(c.g) + 0.0722 * lin(c.b);
+const contrast = (a, b) => { const x = lum(a), y = lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); };
+function oklab(c) {
+  const r = lin(c.r), g = lin(c.g), b = lin(c.b);
+  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
+  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
+  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
+  return { L: 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s, a: 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s, b: 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s };
+}
+const oklch = c => { const o = oklab(c); return { L: o.L, C: Math.hypot(o.a, o.b), h: (Math.atan2(o.b, o.a) * 180 / Math.PI + 360) % 360 }; };
+const dE = (x, y) => { const a = oklab(x), b = oklab(y); return Math.hypot(a.L - b.L, a.a - b.a, a.b - b.b); };
+function fromOklch(L, C, h) {
+  const a = C * Math.cos(h * Math.PI / 180), b = C * Math.sin(h * Math.PI / 180);
+  const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3, m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3, s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3;
+  const g = v => 255 * (v <= 0.0031308 ? 12.92 * v : 1.055 * v ** (1 / 2.4) - 0.055);
+  return { r: clamp(g(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s), 0, 255), g: clamp(g(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s), 0, 255), b: clamp(g(-0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s), 0, 255), a: 1 };
+}
+// Names without AI: hue/lightness words.
+function colorName(c) {
+  const { L, C, h } = oklch(c);
+  if (C < 0.03) {
+    if (L > 0.97) return 'Белый'; if (L < 0.2) return 'Чёрный';
+    if (L > 0.86 && h > 40 && h < 110 && C > 0.008) return 'Сливочный';
+    return L > 0.75 ? 'Светло-серый' : L > 0.5 ? 'Серый' : 'Тёмно-серый';
+  }
+  if (C < 0.07 && L > 0.8 && h > 40 && h < 100) return 'Бежевый';
+  if (C < 0.09 && L < 0.55 && h > 30 && h < 90) return 'Коричневый';
+  const names = [[20, 'Розовый'], [40, 'Красный'], [70, 'Оранжевый'], [100, 'Охра'], [115, 'Жёлтый'], [140, 'Лаймовый'], [165, 'Зелёный'], [200, 'Бирюзовый'], [235, 'Голубой'], [275, 'Синий'], [305, 'Фиолетовый'], [335, 'Пурпурный'], [361, 'Розовый']];
+  let n = names.find(([lim]) => h < lim)[1];
+  if (L > 0.82) n = 'Светло-' + n.toLowerCase(); else if (L < 0.4) n = 'Тёмно-' + n.toLowerCase();
+  return n;
+}
+// Tailwind v3 palette (subset of hues used most often), shade 50..950.
+const TW_SHADES = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
+const TW = {
+  slate: 'f8fafc f1f5f9 e2e8f0 cbd5e1 94a3b8 64748b 475569 334155 1e293b 0f172a 020617', gray: 'f9fafb f3f4f6 e5e7eb d1d5db 9ca3af 6b7280 4b5563 374151 1f2937 111827 030712',
+  stone: 'fafaf9 f5f5f4 e7e5e4 d6d3d1 a8a29e 78716c 57534e 44403c 292524 1c1917 0c0a09', red: 'fef2f2 fee2e2 fecaca fca5a5 f87171 ef4444 dc2626 b91c1c 991b1b 7f1d1d 450a0a',
+  orange: 'fff7ed ffedd5 fed7aa fdba74 fb923c f97316 ea580c c2410c 9a3412 7c2d12 431407', amber: 'fffbeb fef3c7 fde68a fcd34d fbbf24 f59e0b d97706 b45309 92400e 78350f 451a03',
+  yellow: 'fefce8 fef9c3 fef08a fde047 facc15 eab308 ca8a04 a16207 854d0e 713f12 422006', green: 'f0fdf4 dcfce7 bbf7d0 86efac 4ade80 22c55e 16a34a 15803d 166534 14532d 052e16',
+  emerald: 'ecfdf5 d1fae5 a7f3d0 6ee7b7 34d399 10b981 059669 047857 065f46 064e3b 022c22', teal: 'f0fdfa ccfbf1 99f6e4 5eead4 2dd4bf 14b8a6 0d9488 0f766e 115e59 134e4a 042f2e',
+  sky: 'f0f9ff e0f2fe bae6fd 7dd3fc 38bdf8 0ea5e9 0284c7 0369a1 075985 0c4a6e 082f49', blue: 'eff6ff dbeafe bfdbfe 93c5fd 60a5fa 3b82f6 2563eb 1d4ed8 1e40af 1e3a8a 172554',
+  indigo: 'eef2ff e0e7ff c7d2fe a5b4fc 818cf8 6366f1 4f46e5 4338ca 3730a3 312e81 1e1b4b', violet: 'f5f3ff ede9fe ddd6fe c4b5fd a78bfa 8b5cf6 7c3aed 6d28d9 5b21b6 4c1d95 2e1065',
+  purple: 'faf5ff f3e8ff e9d5ff d8b4fe c084fc a855f7 9333ea 7e22ce 6b21a8 581c87 3b0764', pink: 'fdf2f8 fce7f3 fbcfe8 f9a8d4 f472b6 ec4899 db2777 be185d 9d174d 831843 500724',
+  rose: 'fff1f2 ffe4e6 fecdd3 fda4af fb7185 f43f5e e11d48 be123c 9f1239 881337 4c0519',
+};
+function nearestTailwind(c) {
+  if (c.r > 250 && c.g > 250 && c.b > 250) return { name: 'white', d: 0 };
+  if (c.r < 5 && c.g < 5 && c.b < 5) return { name: 'black', d: 0 };
+  let best = null;
+  for (const [hue, list] of Object.entries(TW)) list.split(' ').forEach((h, i) => {
+    const d = dE(c, parseColor('#' + h)); if (!best || d < best.d) best = { name: hue + '-' + TW_SHADES[i], d };
+  });
+  return best;
+}
+
+// ------------------------------------------------------------------ DOM helpers
+const cssPath = el => {
+  if (!(el instanceof Element)) return '';
+  if (el.id && /^[a-zA-Z][\w-]*$/.test(el.id) && document.querySelectorAll('#' + el.id).length === 1) return '#' + el.id;
+  const parts = [];
+  for (let e = el; e && e.nodeType === 1 && e !== document.documentElement && parts.length < 5; e = e.parentElement) {
+    if (e.id && /^[a-zA-Z][\w-]*$/.test(e.id)) { parts.unshift('#' + e.id); break; }
+    let p = e.tagName.toLowerCase();
+    const cls = [...e.classList].filter(c => /^[a-zA-Z][\w-]{1,30}$/.test(c) && !/^(is-|has-|js-)/.test(c)).slice(0, 2);
+    if (cls.length) p += '.' + cls.join('.');
+    const par = e.parentElement;
+    if (par) { const same = [...par.children].filter(x => x.tagName === e.tagName); if (same.length > 1) p += `:nth-of-type(${same.indexOf(e) + 1})`; }
+    parts.unshift(p);
+  }
+  return parts.join(' > ');
+};
+const isEditable = el => !!el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));
+const ownText = el => [...el.childNodes].filter(n => n.nodeType === 3).map(n => n.nodeValue).join('').trim();
+function effectiveBg(el) {
+  const stack = [];
+  for (let e = el; e && e.nodeType === 1; e = e.parentElement) {
+    const cs = getComputedStyle(e);
+    if (cs.backgroundImage && cs.backgroundImage !== 'none') return { color: null, image: true, el: e, stack };
+    const c = parseColor(cs.backgroundColor);
+    if (c && c.a > 0) { stack.push(c); if (c.a >= 1) break; }
+  }
+  let res = { r: 255, g: 255, b: 255, a: 1 };
+  for (let i = stack.length - 1; i >= 0; i--) res = over(stack[i], res);
+  return { color: res, image: false };
+}
+function textColor(el) {
+  const cs = getComputedStyle(el); let c = parseColor(cs.color) || { r: 0, g: 0, b: 0, a: 1 };
+  let op = 1; for (let e = el; e && e.nodeType === 1; e = e.parentElement) op *= +getComputedStyle(e).opacity || 1;
+  return { ...c, a: c.a * op };
+}
+const fontAvail = (() => { const cache = new Map(); let ctx;
+  return fam => {
+    if (cache.has(fam)) return cache.get(fam);
+    ctx = ctx || document.createElement('canvas').getContext('2d');
+    const t = 'mmmmmmmmmlliWWW Аа Жж 0123'; let ok = false;
+    for (const g of ['monospace', 'serif', 'sans-serif']) { ctx.font = `40px ${g}`; const w0 = ctx.measureText(t).width; ctx.font = `40px "${fam}", ${g}`; if (ctx.measureText(t).width !== w0) { ok = true; break; } }
+    cache.set(fam, ok); return ok;
+  }; })();
+function renderedFont(cs) {
+  const fams = cs.fontFamily.split(',').map(f => f.trim().replace(/^["']|["']$/g, ''));
+  for (const f of fams) {
+    if (/^(-apple-system|BlinkMacSystemFont|system-ui)$/i.test(f)) return { family: /Mac/.test(navigator.platform) ? 'SF Pro' : /Win/.test(navigator.platform) ? 'Segoe UI' : 'системный', source: 'системный' };
+    if (/^(serif|sans-serif|monospace|cursive|fantasy|ui-\w+)$/i.test(f)) return { family: f, source: 'по умолчанию' };
+    if (fontAvail(f)) {
+      let source = 'установлен';
+      try { for (const ff of document.fonts) if (ff.family.replace(/["']/g, '') === f) { source = 'веб-шрифт'; break; } } catch {}
+      if (source === 'веб-шрифт') {
+        const links = [...document.querySelectorAll('link[rel=stylesheet]')].map(l => l.href).join(' ');
+        if (/fonts\.googleapis/.test(links)) source = 'Google Fonts'; else if (/typekit|use\.adobe/.test(links)) source = 'Adobe Fonts';
+      }
+      return { family: f, source };
+    }
+  }
+  return { family: fams[0], source: '?' };
+}
+const WEIGHTS = { 100: 'Thin', 200: 'ExtraLight', 300: 'Light', 400: 'Regular', 500: 'Medium', 600: 'Semibold', 700: 'Bold', 800: 'ExtraBold', 900: 'Black' };
+const px = v => Math.round(parseFloat(v) * 10) / 10;
+const fmtNum = v => (Math.round(v * 10) / 10).toString().replace('.', ',');
+
+// ------------------------------------------------------------------ styles of the UI
+// Craft tokens (S/toolkit/craft/craft-tokens.css): one accent = the Space colour, red only for
+// measurements, radii 4/6/8/12/16/pill, hairline rings instead of borders, 120/160/240 ms.
+const CSS = `
+:host { all: initial; }
+* { box-sizing: border-box; }
+.root { position: fixed; inset: 0; pointer-events: none; z-index: 2147483647;
+  font: 12px/1.35 -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", system-ui, sans-serif; color: var(--m-text);
+  --m-space: #6d6fd6; --m-space-ink: #4b4db8; --m-space-wash: color-mix(in srgb, var(--m-space) 14%, transparent);
+  --m-measure: #f24822; --m-danger: #e5484d; --m-ok: #30a46c; --m-warn: #e0a400;
+  --m-text: #1d1d22; --m-text-2: rgba(29,29,34,.62); --m-text-3: rgba(29,29,34,.42); --m-surface: #fff; --m-surface-2: #f4f4f6;
