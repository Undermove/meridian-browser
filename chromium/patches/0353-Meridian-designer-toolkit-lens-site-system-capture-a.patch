+// Meridian: the designer toolkit's items (its flag on, a web page in a tab):
+// the lens on this element, it as a bug-ready shot, the image as PNG (WebP,
+// AVIF…), every image under the cursor (CSS backgrounds, srcset's largest).
+void RenderViewContextMenu::AppendMeridianToolkitItems() {
+  if (!meridian::toolkit::Enabled(GetProfile()) ||
+      !tabs::TabInterface::MaybeGetFromContents(embedder_web_contents_) ||
+      !meridian::toolkit::HasToolkit(embedder_web_contents_) ||
+      !(params_.page_url.SchemeIsHTTPOrHTTPS() ||
+        params_.page_url.SchemeIsFile())) {
+    return;
+  }
+  const bool ru = g_browser_process->GetApplicationLocale().starts_with("ru");
+  const bool image =
+      params_.media_type == ContextMenuDataMediaType::kImage;
+  if (image) {
+    menu_model_.AddItem(IDC_MERIDIAN_TOOLKIT_PNG,
+                        ru ? u"Сохранить картинку как PNG"
+                           : u"Save Image as PNG");
+  }
+  menu_model_.AddItem(IDC_MERIDIAN_TOOLKIT_IMAGES,
+                      ru ? u"Картинки под курсором…" : u"Images Under Cursor…");
+  menu_model_.AddItem(IDC_MERIDIAN_TOOLKIT_SHOT,
+                      ru ? u"Снимок элемента → как баг"
+                         : u"Capture Element as a Bug");
+  menu_model_.AddItem(IDC_MERIDIAN_TOOLKIT_LENS,
+                      ru ? u"Линза: этот элемент" : u"Inspect with Lens");
+  menu_model_.AddSeparator(ui::NORMAL_SEPARATOR);
+}
+
+void RenderViewContextMenu::ExecMeridianToolkit(int id) {
+  const char* kind = id == IDC_MERIDIAN_TOOLKIT_PNG      ? "png"
+                     : id == IDC_MERIDIAN_TOOLKIT_IMAGES ? "imgs"
+                     : id == IDC_MERIDIAN_TOOLKIT_SHOT   ? "shot"
+                                                         : "lens";
+  meridian::toolkit::ContextAction(embedder_web_contents_, kind, params_.x,
+                                   params_.y);
+}
