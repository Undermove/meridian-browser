+
+#include <string>
+
+class Profile;
+
+namespace content {
+class WebContents;
+}
+
+// What the page's context menu needs of the designer toolkit (declared in
+// :model, which the menu depends on; defined in toolkit_tab_helper.cc).
+namespace meridian::toolkit {
+
+// The toolkit's flag: the pref meridian.toolkit.enabled of the main profile,
+// --enable-meridian-toolkit, or the test switch --meridian-test-meridian-toolkit.
+bool Enabled(Profile* profile);
+
+// The page in `contents` has the toolkit: a context menu item at (x, y)
+// (DIP of the main frame's view) runs `kind` ("lens", "shot", "png", "imgs").
+// False when the tab has no toolkit (flag off, not a web page).
+bool HasToolkit(content::WebContents* contents);
+bool ContextAction(content::WebContents* contents,
+                   const std::string& kind,
+                   int x,
+                   int y);
+
+}  // namespace meridian::toolkit
+
+#endif  // CHROME_BROWSER_MERIDIAN_TOOLKIT_TOOLKIT_MENU_H_
diff --git a/chrome/browser/meridian/toolkit/toolkit_meridian.js b/chrome/browser/meridian/toolkit/toolkit_meridian.js
new file mode 100644
index 0000000000..46577374bd
--- /dev/null
+++ b/chrome/browser/meridian/toolkit/toolkit_meridian.js
@@ -0,0 +1,84 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The designer toolkit's Meridian adapter (runs in an isolated world after
+// toolkit_core.js, which stays portable). What only the browser can do goes
+// through a queue the browser polls (ToolkitTabHelper): the clipboard without
+// a gesture and for images, real pixels of the tab, the toolkit's store.
+// Config comes in window.__meridianToolkitConfig: {store, platform, accent}.
+(() => {
+  'use strict';
+  if (window.__meridianToolkit || !window.__meridianToolkitCore) return;
+  const cfg = window.__meridianToolkitConfig || {};
+  const out = [];
+  const waits = new Map();
+  let seq = 0;
+  const call = (op, args) => new Promise(resolve => {
+    const id = ++seq;
+    waits.set(id, resolve);
+    out.push({id, op, args});
+    setTimeout(() => { if (waits.has(id)) { waits.delete(id); resolve(null); } }, 10000);
+  });
+  const toB64 = blob => new Promise(resolve => {
+    const r = new FileReader();
+    r.onload = () => resolve(String(r.result).replace(/^data:[^,]*,/, ''));
+    r.onerror = () => resolve(null);
+    r.readAsDataURL(blob);
+  });
+  const fromB64 = (b64, type = 'image/png') => {
+    const bin = atob(b64);
+    const bytes = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+    return new Blob([bytes], {type});
+  };
+  const store = cfg.store || {};
+  let active = false;
+  const adapter = {
+    platform: cfg.platform,
+    trustedOnly: true,  // the page can't drive the toolkit with synthetic events
+    accent: cfg.accent,
+    browserName: cfg.browserName || 'Meridian',
+    async copy(items) {
+      const png = items.png ? await toB64(items.png) : '';
+      return !!(await call('copy', {text: items.text || '', html: items.html || '', png}));
+    },
+    async capture(r) {
+      const b64 = await call('capture', {x: r.x, y: r.y, width: r.width, height: r.height});
+      return b64 ? fromB64(b64) : null;
+    },
+    async snapshot() {
+      const b64 = await call('capture', {x: 0, y: 0, width: innerWidth, height: innerHeight});
+      if (!b64) return null;
+      const bmp = await createImageBitmap(fromB64(b64));
+      const canvas = document.createElement('canvas');
+      canvas.width = bmp.width;
+      canvas.height = bmp.height;
+      const ctx = canvas.getContext('2d', {willReadFrequently: true});
+      ctx.drawImage(bmp, 0, 0);
+      return {canvas, ctx, scale: bmp.width / innerWidth};
+    },
+    store: {
+      async get(key) { return store[key]; },
+      async set(key, value) { store[key] = value; call('store', {key, value}); },
+    },
+  };
+  const tk = window.__meridianToolkitCore.create(adapter);
+  window.__meridianToolkit = {
+    tk,
+    // The browser takes the queue; `busy` makes it poll faster while a tool
+    // is up.
+    take() {
+      const st = tk.state;
+      active = !!(st.active || st.mode || st.peek || waits.size);
+      return {ops: out.splice(0), busy: active};
+    },
+    answer(id, value) {
+      const f = waits.get(id);
+      waits.delete(id);
+      if (f) f(value);
+    },
+    ctx(kind, x, y) { tk.contextAction(kind, x, y); },
+    toggle() { tk.toggle(); },
+  };
+})();
