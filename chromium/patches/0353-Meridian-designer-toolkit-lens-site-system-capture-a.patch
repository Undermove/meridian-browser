+
+#ifndef CHROME_BROWSER_MERIDIAN_TOOLKIT_TOOLKIT_TAB_HELPER_H_
+#define CHROME_BROWSER_MERIDIAN_TOOLKIT_TOOLKIT_TAB_HELPER_H_
+
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "chrome/browser/meridian/toolkit/toolkit_menu.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+class Profile;
+
+namespace meridian::toolkit {
+
+// The designer toolkit (behind a flag, off): the lens, the site's system,
+// capture as a bug, images under the cursor, stress text, contrast, brand
+// check. One portable page script (toolkit_core.js) plus Meridian's adapter
+// (toolkit_meridian.js), both in an isolated world of the tab's main frame.
+// The page asks the browser through a queue this helper polls: the clipboard
+// (text, HTML, PNG), real pixels of the tab, the toolkit's store.
+// Enabled(): toolkit_menu.h.
+
+class ToolkitTabHelper : public content::WebContentsObserver,
+                         public content::WebContentsUserData<ToolkitTabHelper> {
+ public:
+  ToolkitTabHelper(const ToolkitTabHelper&) = delete;
+  ToolkitTabHelper& operator=(const ToolkitTabHelper&) = delete;
+  ~ToolkitTabHelper() override;
+
+  // A toolkit item of the page's context menu, at (x, y) in the main frame's
+  // view (DIP): "lens", "shot", "png", "imgs", "color".
+  void ContextAction(const std::string& kind, int x, int y);
+
+  bool On() const;
+  bool Injectable() const;
+
+ private:
+  explicit ToolkitTabHelper(content::WebContents* contents);
+  friend class content::WebContentsUserData<ToolkitTabHelper>;
+
+  // content::WebContentsObserver:
+  void DOMContentLoaded(content::RenderFrameHost* frame) override;
+  void OnVisibilityChanged(content::Visibility visibility) override;
+
+  void Inject();
+  void Run(const std::string& script);
+  void Schedule(bool busy);
+  void Poll();
+  void OnPolled(base::Value result);
+  void Answer(int id, base::Value value);
+  void Copy(int id, const base::DictValue& args);
+  void Capture(int id, const base::DictValue& args);
+  void Store(const base::DictValue& args);
+  double Zoom() const;
+
+  bool busy_ = false;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<ToolkitTabHelper> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace meridian::toolkit
+
+#endif  // CHROME_BROWSER_MERIDIAN_TOOLKIT_TOOLKIT_TAB_HELPER_H_
