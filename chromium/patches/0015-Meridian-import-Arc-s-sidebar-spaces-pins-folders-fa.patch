+void SidebarHandler::GetArcPreview(GetArcPreviewCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadArcSidebar),
+      base::BindOnce(
+          [](GetArcPreviewCallback callback, std::optional<ArcSidebar> arc) {
+            if (!arc || arc->spaces.empty()) {
+              std::move(callback).Run(nullptr);
+              return;
+            }
+            auto preview = mojom::ArcPreview::New();
+            preview->space_count = arc->spaces.size();
+            preview->favorite_count = arc->favorites.size();
+            std::function<int(const std::vector<Item>&)> count =
+                [&](const std::vector<Item>& items) {
+                  int n = 0;
+                  for (const Item& item : items) {
+                    n += item.is_folder ? count(item.children) : 1;
+                  }
+                  return n;
+                };
+            for (size_t i = 0; i < arc->spaces.size(); ++i) {
+              const Space& space = arc->spaces[i];
+              preview->pinned_count += count(space.pinned);
+              preview->today_count += arc->today[i].size();
+              if (i < 8) {
+                auto s = mojom::Space::New();
+                s->name = space.name;
+                s->icon = space.icon;
+                s->color = space.color;
+                s->color2 = space.color2;
+                preview->spaces.push_back(std::move(s));
+              }
+            }
+            std::move(callback).Run(std::move(preview));
+          },
+          std::move(callback)));
+}
+
+void SidebarHandler::ImportArc(ImportArcCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadArcSidebar),
+      base::BindOnce(&SidebarHandler::OnArcRead, weak_factory_.GetWeakPtr(),
+                     std::move(callback)));
+}
+
+void SidebarHandler::OnArcRead(ImportArcCallback callback,
+                               std::optional<ArcSidebar> arc) {
+  if (!arc || arc->spaces.empty()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  service_->Import(arc->spaces, std::move(arc->favorites));
+  // Arc's open tabs: Today tabs of their space, loaded when first opened.
+  for (size_t i = 0; i < arc->spaces.size(); ++i) {
+    for (const ArcSidebar::Tab& tab : arc->today[i]) {
+      sessions::SerializedNavigationEntry entry;
+      entry.set_index(0);
+      entry.set_virtual_url(tab.url);
+      entry.set_original_request_url(tab.url);
+      entry.set_title(base::UTF8ToUTF16(tab.title));
+      entry.set_transition_type(ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+      entry.set_timestamp(base::Time::Now());
+      content::WebContents* contents = chrome::AddRestoredTab(
+          browser_, base::span_from_ref(entry), model()->count(),
+          /*selected_navigation=*/0, /*extension_app_id=*/std::string(),
+          /*group=*/std::nullopt, /*select=*/false, /*pin=*/false,
+          base::TimeTicks::Now(), base::Time::Now(),
+          /*session_storage_namespace=*/nullptr,
+          sessions::SerializedUserAgentOverride(),
+          /*extra_data=*/{}, /*from_session_restore=*/false,
+          /*is_active_browser=*/std::nullopt);
+      if (contents) {
+        TabData::Set(contents, arc->spaces[i].id, std::string());
+      }
+    }
+  }
+  ActivateSpace(service_->active_space_id());
+  ScheduleNotify();
+  std::move(callback).Run(true);
+}
