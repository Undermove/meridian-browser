+void SidebarService::Import(std::vector<Space>& spaces,
+                            std::vector<Item> favorites) {
+  for (Space& space : spaces) {
+    space.id = NewId();
+    if (space.color.empty()) {
+      space.color = kDefaultColor;
+    }
+    if (space.color2.empty()) {
+      space.color2 = space.color;
+    }
+    AssignIds(space.pinned);
+  }
+  bool pristine = spaces_.size() == 1 && spaces_[0].pinned.empty();
+  if (pristine && !spaces.empty()) {
+    spaces_.clear();
+    active_space_id_ = spaces[0].id;
+  }
+  spaces_.insert(spaces_.end(), spaces.begin(), spaces.end());
+  for (Item& favorite : favorites) {
+    bool known = std::ranges::any_of(
+        favorites_, [&](const Item& f) { return f.url == favorite.url; });
+    if (!known && !favorite.is_folder) {
+      favorite.id = NewId();
+      favorites_.push_back(std::move(favorite));
+    }
+  }
+  EnsureDefaultSpace();
+  Changed();
+}
