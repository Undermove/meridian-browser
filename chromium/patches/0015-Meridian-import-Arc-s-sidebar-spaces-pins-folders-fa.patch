@@ -0,0 +1,50 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_ARC_IMPORT_H_
+#define CHROME_BROWSER_MERIDIAN_ARC_IMPORT_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/values.h"
+#include "chrome/browser/meridian/sidebar_service.h"
+#include "url/gurl.h"
+
+namespace meridian {
+
+// Arc's sidebar, read from its local StorableSidebar.json: spaces with their
+// pinned tabs and folders, each space's open (Today) tabs, and the favorites.
+// Nothing leaves the machine, and Arc's files are only read.
+struct ArcSidebar {
+  ArcSidebar();
+  ArcSidebar(ArcSidebar&&);
+  ArcSidebar& operator=(ArcSidebar&&);
+  ~ArcSidebar();
+
+  struct Tab {
+    GURL url;
+    std::string title;
+  };
+  // `spaces[i]` has no id yet; `today[i]` are its open tabs.
+  std::vector<Space> spaces;
+  std::vector<std::vector<Tab>> today;
+  std::vector<Item> favorites;
+};
+
+// Arc's data folder (~/Library/Application Support/Arc), or the one given
+// with --meridian-arc-dir (tests).
+base::FilePath ArcDataDir();
+
+// Parses StorableSidebar.json; nullopt if it isn't Arc's format.
+std::optional<ArcSidebar> ParseArcSidebar(const base::DictValue& root);
+
+// Reads and parses Arc's sidebar; blocking (file IO).
+std::optional<ArcSidebar> ReadArcSidebar();
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_ARC_IMPORT_H_
