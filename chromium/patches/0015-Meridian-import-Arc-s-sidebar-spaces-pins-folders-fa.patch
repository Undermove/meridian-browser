+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/arc_import.h"
+
+#include "base/json/json_reader.h"
+#include "base/test/task_environment.h"
+#include "chrome/browser/meridian/sidebar_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+// A trimmed StorableSidebar.json in Arc's shape (same as the E2E fixture).
+constexpr char kArc[] = R"({"sidebar": {"containers": [{"global": {}}, {
+  "topAppsContainerIDs": [{"default": true}, "top1", {"custom": {}}, "top2"],
+  "spaces": [
+    "s-work", {"title": "Work",
+      "customInfo": {"iconType": {"emoji_v2": "W"}, "windowTheme":
+        {"primaryColorPalette": {"midTone": {"red": 1, "green": 0.5, "blue": 0}}}},
+      "containerIDs": ["unpinned", "wu", "pinned", "wp"]},
+    "s-home", {"title": "Home", "containerIDs": ["pinned", "hp"]}
+  ],
+  "items": [
+    "top1", {"childrenIds": ["gmail"]},
+    "gmail", {"data": {"tab": {"savedURL": "https://mail.google.com/", "savedTitle": "Gmail"}}},
+    "top2", {"childrenIds": ["gmail2", "yt"]},
+    "gmail2", {"data": {"tab": {"savedURL": "https://mail.google.com/"}}},
+    "yt", {"data": {"tab": {"savedURL": "https://youtube.com/", "savedTitle": "YouTube"}}},
+    "wp", {"childrenIds": ["linear", "design", "broken"]},
+    "linear", {"title": "Linear", "data": {"tab": {"savedURL": "https://linear.app/", "savedTitle": "Inbox"}}},
+    "design", {"title": "Design", "data": {"list": {}}, "childrenIds": ["figma", "split"]},
+    "figma", {"data": {"tab": {"savedURL": "https://figma.com/", "savedTitle": "Figma"}}},
+    "split", {"data": {"splitView": {}}, "childrenIds": ["docs"]},
+    "docs", {"data": {"tab": {"savedURL": "https://docs.google.com/", "savedTitle": "Docs"}}},
+    "broken", {"data": {"tab": {"savedURL": "nope"}}},
+    "wu", {"childrenIds": ["t1"]},
+    "t1", {"data": {"tab": {"savedURL": "https://news.ycombinator.com/", "savedTitle": "HN"}}},
+    "hp", {"childrenIds": []}
+  ]}]}})";
+
+ArcSidebar Parse() {
+  std::optional<base::Value> root = base::JSONReader::Read(kArc, 0);
+  std::optional<ArcSidebar> arc = ParseArcSidebar(root->GetDict());
+  EXPECT_TRUE(arc);
+  return std::move(*arc);
+}
+
+TEST(ArcImportTest, ReadsSpacesPinsFoldersTodayAndFavorites) {
+  ArcSidebar arc = Parse();
+  ASSERT_EQ(arc.spaces.size(), 2u);
+  const Space& work = arc.spaces[0];
+  EXPECT_EQ(work.name, "Work");
+  EXPECT_EQ(work.icon, "W");
+  EXPECT_EQ(work.color, "#ff8000");
+  ASSERT_EQ(work.pinned.size(), 2u);  // the broken tab is left out
+  EXPECT_EQ(work.pinned[0].title, "Linear");
+  EXPECT_EQ(work.pinned[0].url, GURL("https://linear.app/"));
+  const Item& design = work.pinned[1];
+  EXPECT_TRUE(design.is_folder);
+  EXPECT_EQ(design.title, "Design");
+  ASSERT_EQ(design.children.size(), 2u);
+  EXPECT_EQ(design.children[0].title, "Figma");
+  // A split view comes in as a folder of its tabs.
+  EXPECT_TRUE(design.children[1].is_folder);
+  EXPECT_EQ(design.children[1].children[0].title, "Docs");
+  ASSERT_EQ(arc.today[0].size(), 1u);
+  EXPECT_EQ(arc.today[0][0].title, "HN");
+  EXPECT_TRUE(arc.today[1].empty());
+  // Favorites of every Arc profile, without duplicates.
+  ASSERT_EQ(arc.favorites.size(), 2u);
+  EXPECT_EQ(arc.favorites[0].title, "Gmail");
+  EXPECT_EQ(arc.favorites[1].title, "YouTube");
+}
+
+TEST(ArcImportTest, RejectsOtherFiles) {
+  std::optional<base::Value> root = base::JSONReader::Read(R"({"a": 1})", 0);
+  EXPECT_FALSE(ParseArcSidebar(root->GetDict()));
+}
+
+TEST(ArcImportTest, ImportReplacesTheUntouchedFirstSpace) {
+  base::test::TaskEnvironment env;
+  SidebarService service{base::FilePath()};
+  ArcSidebar arc = Parse();
+  service.Import(arc.spaces, std::move(arc.favorites));
+  ASSERT_EQ(service.spaces().size(), 2u);
+  EXPECT_EQ(service.spaces()[0].name, "Work");
+  EXPECT_EQ(service.active_space_id(), arc.spaces[0].id);
+  EXPECT_FALSE(service.spaces()[0].pinned[1].children[0].id.empty());
+  EXPECT_EQ(service.favorites().size(), 2u);
+
+  // A second import adds the spaces again but not the same favorites.
+  ArcSidebar again = Parse();
+  service.Import(again.spaces, std::move(again.favorites));
+  EXPECT_EQ(service.spaces().size(), 4u);
+  EXPECT_EQ(service.favorites().size(), 2u);
+}
+
+}  // namespace
+}  // namespace meridian
