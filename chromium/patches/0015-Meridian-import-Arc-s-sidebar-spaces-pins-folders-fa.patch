diff --git a/chrome/browser/meridian/arc_import.cc b/chrome/browser/meridian/arc_import.cc
new file mode 100644
index 0000000000..f9d4eb1922
--- /dev/null
+++ b/chrome/browser/meridian/arc_import.cc
@@ -0,0 +1,276 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/arc_import.h"
+
+#include <algorithm>
+#include <cmath>
+#include <map>
+
+#include "base/base_paths.h"
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/path_service.h"
+#include "base/strings/stringprintf.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr char kArcDirSwitch[] = "meridian-arc-dir";
+
+// Arc keeps maps as flat lists: [key, value, key, value, ...].
+std::vector<std::pair<std::string, const base::Value*>> Pairs(
+    const base::ListValue* list) {
+  std::vector<std::pair<std::string, const base::Value*>> out;
+  if (!list) {
+    return out;
+  }
+  for (size_t i = 0; i + 1 < list->size(); i += 2) {
+    if ((*list)[i].is_string()) {
+      out.emplace_back((*list)[i].GetString(), &(*list)[i + 1]);
+    }
+  }
+  return out;
+}
+
+std::string ToHex(const base::DictValue* color) {
+  if (!color) {
+    return std::string();
+  }
+  auto channel = [&](const char* key) {
+    double v = std::clamp(color->FindDouble(key).value_or(0), 0.0, 1.0);
+    return static_cast<int>(std::lround(v * 255));
+  };
+  return base::StringPrintf("#%02x%02x%02x", channel("red"), channel("green"),
+                            channel("blue"));
+}
+
+std::string SpaceColor(const base::DictValue* custom_info) {
+  const base::DictValue* theme =
+      custom_info ? custom_info->FindDict("windowTheme") : nullptr;
+  if (!theme) {
+    return std::string();
+  }
+  if (const base::DictValue* mid =
+          theme->FindDictByDottedPath("primaryColorPalette.midTone")) {
+    return ToHex(mid);
+  }
+  // Newer themes: background.single._0.style.color._0.blendedGradient._0
+  const base::DictValue* grad = theme->FindDictByDottedPath(
+      "background.single._0.style.color._0.blendedGradient._0");
+  const base::ListValue* overlays =
+      grad ? grad->FindList("overlayColors") : nullptr;
+  if (overlays) {
+    for (const base::Value& c : *overlays) {
+      const base::DictValue* dict = c.GetIfDict();
+      if (dict && dict->FindDouble("alpha").value_or(0) > 0.2) {
+        return ToHex(dict);
+      }
+    }
+  }
+  return std::string();
+}
+
+class Converter {
+ public:
+  explicit Converter(const base::ListValue* items) {
+    for (const auto& [id, value] : Pairs(items)) {
+      if (const base::DictValue* dict = value->GetIfDict()) {
+        items_[id] = dict;
+      }
+    }
+  }
+
+  std::optional<Item> Convert(const std::string& id, int depth = 0) const {
+    auto it = items_.find(id);
+    if (it == items_.end() || depth > 32) {
+      return std::nullopt;
+    }
+    const base::DictValue& node = *it->second;
+    const std::string* title = node.FindString("title");
+    Item item;
+    if (const base::DictValue* tab = node.FindDictByDottedPath("data.tab")) {
+      const std::string* url = tab->FindString("savedURL");
+      GURL gurl = url ? GURL(*url) : GURL();
+      if (!gurl.is_valid()) {
+        return std::nullopt;
+      }
+      const std::string* saved_title = tab->FindString("savedTitle");
+      item.url = gurl;
+      item.title = title && !title->empty()               ? *title
+                   : saved_title && !saved_title->empty() ? *saved_title
+                                                          : gurl.spec();
+      return item;
+    }
+    // Folders, and Arc's split views and easels (their tabs, as a folder).
+    std::vector<Item> children = ChildrenOf(id, depth + 1);
+    if (!node.FindDictByDottedPath("data.list") && children.empty()) {
+      return std::nullopt;
+    }
+    item.is_folder = true;
+    item.open = false;
+    item.title = title && !title->empty()
+                     ? *title
+                     : (node.FindDictByDottedPath("data.list") ? "Folder"
+                                                               : "Group");
+    item.children = std::move(children);
+    return item;
+  }
+
+  std::vector<Item> ChildrenOf(const std::string& id, int depth = 0) const {
+    std::vector<Item> out;
+    auto it = items_.find(id);
+    const base::ListValue* ids =
+        it == items_.end() ? nullptr : it->second->FindList("childrenIds");
+    if (!ids) {
+      return out;
+    }
+    for (const base::Value& child : *ids) {
+      if (child.is_string()) {
+        if (std::optional<Item> item = Convert(child.GetString(), depth)) {
+          out.push_back(std::move(*item));
+        }
+      }
+    }
+    return out;
+  }
+
+ private:
+  std::map<std::string, const base::DictValue*> items_;
+};
+
+void Flatten(std::vector<Item> items, std::vector<Item>& out) {
+  for (Item& item : items) {
+    if (item.is_folder) {
+      Flatten(std::move(item.children), out);
+    } else {
+      out.push_back(std::move(item));
+    }
+  }
+}
+
+// The id after `key` in a space's containerIDs: ["pinned", id, ...].
+std::string ContainerId(const base::ListValue* ids, const char* key) {
+  if (!ids) {
+    return std::string();
+  }
+  for (size_t i = 0; i + 1 < ids->size(); ++i) {
+    if ((*ids)[i].is_string() && (*ids)[i].GetString() == key &&
+        (*ids)[i + 1].is_string()) {
+      return (*ids)[i + 1].GetString();
+    }
+  }
+  return std::string();
+}
+
+}  // namespace
+
+ArcSidebar::ArcSidebar() = default;
+ArcSidebar::ArcSidebar(ArcSidebar&&) = default;
+ArcSidebar& ArcSidebar::operator=(ArcSidebar&&) = default;
+ArcSidebar::~ArcSidebar() = default;
+
+base::FilePath ArcDataDir() {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (cl->HasSwitch(kArcDirSwitch)) {
+    return cl->GetSwitchValuePath(kArcDirSwitch);
+  }
+  base::FilePath home;
+  if (!base::PathService::Get(base::DIR_HOME, &home)) {
+    return base::FilePath();
+  }
+  return home.Append("Library/Application Support/Arc");
+}
+
+std::optional<ArcSidebar> ParseArcSidebar(const base::DictValue& root) {
+  const base::ListValue* containers =
+      root.FindListByDottedPath("sidebar.containers");
+  const base::DictValue* container = nullptr;
+  if (containers) {
+    for (const base::Value& c : *containers) {
+      if (c.is_dict() && c.GetDict().FindList("items")) {
+        container = &c.GetDict();
+        break;
+      }
+    }
+  }
+  if (!container) {
+    return std::nullopt;
+  }
+  Converter converter(container->FindList("items"));
+  ArcSidebar out;
+
+  // Favorites ("top apps"), one list per Arc profile; Meridian has one.
+  // [profile, containerId, ...]: the key is an object, so not Pairs().
+  if (const base::ListValue* top = container->FindList("topAppsContainerIDs")) {
+    for (size_t i = 0; i + 1 < top->size(); i += 2) {
+      if (!(*top)[i + 1].is_string()) {
+        continue;
+      }
+      std::vector<Item> tabs;
+      Flatten(converter.ChildrenOf((*top)[i + 1].GetString()), tabs);
+      for (Item& tab : tabs) {
+        bool known = std::ranges::any_of(
+            out.favorites, [&](const Item& f) { return f.url == tab.url; });
+        if (!known) {
+          out.favorites.push_back(std::move(tab));
+        }
+      }
+    }
+  }
+
+  for (const auto& [arc_id, value] : Pairs(container->FindList("spaces"))) {
+    const base::DictValue* s = value->GetIfDict();
+    if (!s) {
+      continue;
+    }
+    const base::ListValue* ids = s->FindList("containerIDs");
+    Space space;
+    const std::string* title = s->FindString("title");
+    space.name = title && !title->empty() ? *title : "Space";
+    const base::DictValue* custom_info = s->FindDict("customInfo");
+    if (const std::string* emoji =
+            custom_info ? custom_info->FindStringByDottedPath(
+                              "iconType.emoji_v2")
+                        : nullptr) {
+      space.icon = *emoji;
+    }
+    space.color = SpaceColor(custom_info);
+    space.color2 = space.color;
+    std::string pinned = ContainerId(ids, "pinned");
+    if (!pinned.empty()) {
+      space.pinned = converter.ChildrenOf(pinned);
+    }
+    std::vector<ArcSidebar::Tab> today;
+    std::string unpinned = ContainerId(ids, "unpinned");
+    if (!unpinned.empty()) {
+      std::vector<Item> tabs;
+      Flatten(converter.ChildrenOf(unpinned), tabs);
+      for (Item& tab : tabs) {
+        today.push_back({tab.url, tab.title});
+      }
+    }
+    out.spaces.push_back(std::move(space));
+    out.today.push_back(std::move(today));
+  }
+  return out;
+}
+
+std::optional<ArcSidebar> ReadArcSidebar() {
+  base::FilePath dir = ArcDataDir();
+  std::string json;
+  if (dir.empty() ||
+      !base::ReadFileToString(dir.Append("StorableSidebar.json"), &json)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> root = base::JSONReader::Read(json, 0);
+  if (!root || !root->is_dict()) {
+    return std::nullopt;
+  }
+  return ParseArcSidebar(root->GetDict());
+}
+
+}  // namespace meridian
