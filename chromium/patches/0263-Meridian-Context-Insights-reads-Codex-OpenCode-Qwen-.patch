+// Codex before per-request records: a token_count after each request,
+// sometimes twice.
+TEST(AgentInsightsTest, CodexTokenCountOnly) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  std::string out;
+  for (std::string_view line :
+       base::SplitStringPiece(Read(Fixture("codex-rollout.jsonl")), "\n",
+                              base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (line.find("\"type\":\"token_usage_record\"") != std::string::npos) {
+      continue;
+    }
+    out += std::string(line) + "\n";
+    if (line.find("\"token_count\"") != std::string::npos) {
+      out += std::string(line) + "\n";
+    }
+  }
+  const base::FilePath p = dir.GetPath().AppendASCII("old.jsonl");
+  ASSERT_TRUE(base::WriteFile(p, out));
+  ContextInsights ci(AgentFormat::kCodex);
+  ci.ReadMore(p);
+  base::DictValue r = ci.Result(std::nullopt);
+  EXPECT_EQ(r.FindInt("requests"), 9);
+  EXPECT_EQ(Causes(r)[1], "file");
+}
