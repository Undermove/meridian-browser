+// ---------------------------------------------------------------- other agents
+
+ContextInsights::ToolKind ContextInsights::KindOf(
+    const std::string& name,
+    const base::DictValue* input) const {
+  if (name.starts_with("mcp__")) {
+    return ToolKind::kMcp;
+  }
+  switch (format_) {
+    case AgentFormat::kClaude:
+      return name == "Read"   ? ToolKind::kFile
+             : name == "Bash" ? ToolKind::kCommand
+                              : ToolKind::kOther;
+    case AgentFormat::kCodex: {
+      if (name != "exec_command" && name != "shell" && name != "local_shell" &&
+          name != "shell_command") {
+        return ToolKind::kOther;
+      }
+      // Codex reads files with commands: cat, sed -n, head…
+      const std::string* cmd = input ? input->FindString("cmd") : nullptr;
+      if (cmd) {
+        std::string_view c =
+            base::TrimWhitespaceASCII(*cmd, base::TRIM_LEADING);
+        for (std::string_view verb :
+             {"cat ", "sed -n", "head ", "tail ", "nl ", "less ", "bat "}) {
+          if (c.starts_with(verb) && c.find('|') == std::string_view::npos) {
+            return ToolKind::kFile;
+          }
+        }
+      }
+      return ToolKind::kCommand;
+    }
+    case AgentFormat::kQwen:
+    case AgentFormat::kGemini:
+      return name == "read_file" || name == "read_many_files"
+                 ? ToolKind::kFile
+             : name == "run_shell_command" ? ToolKind::kCommand
+                                           : ToolKind::kOther;
+    case AgentFormat::kCopilot:
+      return name == "view" ? ToolKind::kFile
+             : name == "bash" || name == "powershell" || name == "shell"
+                 ? ToolKind::kCommand
+                 : ToolKind::kOther;
+    case AgentFormat::kOpenCode:
+      return name == "read"   ? ToolKind::kFile
+             : name == "bash" ? ToolKind::kCommand
+                              : ToolKind::kOther;
+  }
+  return ToolKind::kOther;
+}
+
+void ContextInsights::AddRequest(Request r, const std::string& key) {
+  if (!key.empty() && !seen_requests_.insert(key).second) {
+    return;
+  }
+  r.input = std::max(0.0, r.input);
+  requests_.push_back(r);
+}
+
+void ContextInsights::AddCall(const std::string& id,
+                              const std::string& name,
+                              const base::DictValue* input,
+                              ToolKind kind) {
+  if (id.empty() || name.empty() || calls_.contains(id)) {
+    return;
+  }
+  ToolCall call;
+  call.name = Short(name, 80);
+  call.target = input ? TargetOf(call.name, *input) : std::string();
+  call.kind = kind;
+  call.prompt = static_cast<int>(prompts_.size()) - 1;
+  calls_[id] = std::move(call);
+  call_order_.push_back(id);
+}
+
+void ContextInsights::AddResult(const std::string& id,
+                                double chars,
+                                int images) {
+  auto it = calls_.find(id);
+  if (it == calls_.end()) {
+    return;
+  }
+  it->second.tokens = Tokens(chars) + images * kImageTokens;
+  it->second.images = images > 0;
+  // It goes with the next request (OpenCode: the one after the step it ran
+  // in, whose usage is recorded after it).
+  it->second.entered =
+      static_cast<int>(requests_.size()) + (step_open_ ? 1 : 0);
+}
+
+void ContextInsights::AddPrompt(double ts, std::string_view text) {
+  text = base::TrimWhitespaceASCII(text, base::TRIM_ALL);
+  if (text.empty() || text.starts_with("<")) {
+    return;
+  }
+  Prompt p;
+  p.ts = ts;
+  p.text = Short(text, 120);
+  p.first_request = static_cast<int>(requests_.size());
+  prompts_.push_back(std::move(p));
+}
+
+void ContextInsights::AddCompaction(double ts,
+                                    double pre,
+                                    double post,
+                                    std::string trigger) {
+  const int at = static_cast<int>(requests_.size());
+  // The same compaction told twice (an event and a record).
+  if (!compactions_.empty() && compactions_.back().at == at) {
+    return;
+  }
+  Compaction c;
+  c.ts = ts;
+  c.pre = pre;
+  c.post = post;
+  c.trigger = std::move(trigger);
+  c.at = at;
+  compactions_.push_back(std::move(c));
+}
