+TEST(AgentInsightsTest, OpenCodeDatabase) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath db = dir.GetPath().AppendASCII("opencode.db");
+  MakeOpenCodeDb(db);
+  // OpenCode's models.dev cache: the window and the prices.
+  const base::FilePath models = dir.GetPath().AppendASCII("models.json");
+  ASSERT_TRUE(base::WriteFile(
+      models,
+      R"({"mock":{"models":{"mock-model":{"limit":{"context":128000},)"
+      R"("cost":{"input":3,"output":15,"cache_read":0.3,"cache_write":3.75}}}}})"));
+  ContextInsights ci(AgentFormat::kOpenCode);
+  ci.ReadOpenCode(db, "ses_df07b488fffe3rYjjLr4sRVdkQ", models);
+  base::DictValue r = ci.Result(std::nullopt);
+  EXPECT_EQ(*r.FindString("agent"), "OpenCode");
+  EXPECT_EQ(*r.FindString("model"), "mock-model");
+  EXPECT_EQ(r.FindInt("requests"), 3);
+  EXPECT_EQ(r.FindDouble("contextSize"), 128000);
+  // Each step's own cost: dollars, and the bars add up to them (subagent
+  // included).
+  EXPECT_EQ(*r.FindString("unit"), "usd");
+  EXPECT_NEAR(*r.FindDouble("costUsd"), 0.0492, 1e-9);
+  EXPECT_NEAR(SeriesTotal(r), 0.0492, 1e-9);
+  EXPECT_EQ(r.FindDictByDottedPath("spend")->FindInt("subagentRequests"), 1);
+  // The read's result went with the step after the one that ran it.
+  EXPECT_EQ(Causes(r),
+            (std::vector<std::string>{"cold", "file", "compaction"}));
+  EXPECT_NE(Why(r, 2).find("/work/shop/notes.txt"), std::string::npos);
+  const base::ListValue& prompts = *r.FindList("prompts");
+  ASSERT_EQ(prompts.size(), 1u);
+  EXPECT_EQ(*prompts[0].GetDict().FindString("text"), "read notes");
+
+  // Read again (rows change in place): the same, not twice as much.
+  ci.ReadOpenCode(db, "ses_df07b488fffe3rYjjLr4sRVdkQ", models);
+  EXPECT_EQ(ci.Result(std::nullopt).FindInt("requests"), 3);
+}
