+TEST(AgentInsightsTest, WhichAgentsHaveInsights) {
+  for (const char* kind : {"codex", "qwen", "gemini", "copilot", "opencode"}) {
+    EXPECT_TRUE(InsightsFormatOf(kind).has_value()) << kind;
+    EXPECT_EQ(InsightsUnavailableReason(kind), "") << kind;
+  }
+  for (const char* kind :
+       {"amp", "cursor", "droid", "goose", "sandbox-codex", "shell"}) {
+    EXPECT_FALSE(InsightsFormatOf(kind).has_value()) << kind;
+    EXPECT_NE(InsightsUnavailableReason(kind), "") << kind;
+  }
+  EXPECT_EQ(InsightsUnavailableReason("claude"), "");
+}
