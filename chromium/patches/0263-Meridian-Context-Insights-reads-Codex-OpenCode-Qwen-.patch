+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/agent_insights.h"
+
+#include <algorithm>
+#include <memory>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/environment.h"
+#include "base/files/file.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/cstring_view.h"
+#include "base/strings/string_view_util.h"
+#include "base/strings/stringprintf.h"
+#include "crypto/hash.h"
+#include "sql/database.h"
+#include "sql/statement.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+// A session file that may be the terminal's.
+struct Candidate {
+  base::FilePath path;
+  std::string session_id;
+  // When the session began (its record says), and when it was last written.
+  base::Time start;
+  base::Time modified;
+};
+
+// Sessions begin a moment after their terminal; clocks are coarse.
+constexpr base::TimeDelta kSlack = base::Seconds(2);
+
+std::optional<Candidate> Pick(const std::vector<Candidate>& all,
+                              base::Time since,
+                              base::Time until) {
+  const Candidate* best = nullptr;
+  for (const Candidate& c : all) {
+    if ((since.is_null() || c.start >= since - kSlack) &&
+        (until.is_null() || c.start < until - kSlack) &&
+        (!best || c.start > best->start)) {
+      best = &c;
+    }
+  }
+  if (best) {
+    return *best;
+  }
+  // A session resumed in this terminal began before it.
+  for (const Candidate& c : all) {
+    if ((since.is_null() || c.modified >= since - kSlack) &&
+        (!best || c.modified > best->modified)) {
+      best = &c;
+    }
+  }
+  return best ? std::optional<Candidate>(*best) : std::nullopt;
+}
+
+// The file's first line (a session's header), at most 4 MB.
+std::optional<base::DictValue> FirstLine(const base::FilePath& path) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return std::nullopt;
+  }
+  std::string line;
+  std::vector<char> buf(64 << 10);
+  while (line.size() < (4u << 20)) {
+    std::optional<size_t> n =
+        file.ReadAtCurrentPos(base::as_writable_byte_span(buf));
+    if (!n || *n == 0) {
+      break;
+    }
+    std::string_view chunk = base::as_string_view(base::span(buf).first(*n));
+    const size_t nl = chunk.find('\n');
+    line.append(chunk.substr(0, nl));
+    if (nl != std::string_view::npos) {
+      break;
+    }
+  }
+  std::optional<base::Value> v = base::JSONReader::Read(line, 0);
+  if (!v || !v->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(*v).TakeDict();
+}
+
+base::Time Parse(const std::string* ts) {
+  base::Time t;
+  if (!ts || !base::Time::FromUTCString(ts->c_str(), &t)) {
+    return base::Time();
+  }
+  return t;
+}
+
+base::Time ModifiedTime(const base::FilePath& path) {
+  base::File::Info info;
+  return base::GetFileInfo(path, &info) ? info.last_modified : base::Time();
+}
+
+// The same folder, however it's written (/tmp and /private/tmp on a Mac).
+bool SameDir(const base::FilePath& a, const std::string& b) {
+  if (b.empty()) {
+    return false;
+  }
+  const base::FilePath other = base::FilePath::FromUTF8Unsafe(b);
+  if (a == other) {
+    return true;
+  }
+  const base::FilePath ra = base::MakeAbsoluteFilePath(a);
+  const base::FilePath rb = base::MakeAbsoluteFilePath(other);
+  return !ra.empty() && ra == rb;
+}
+
+// An agent's own folder: its variable, else the default under home.
+base::FilePath AgentDir(const base::FilePath& home,
+                        bool hermetic,
+                        base::cstring_view var,
+                        const char* fallback) {
+  if (!hermetic) {
+    std::optional<std::string> v = base::Environment::Create()->GetVar(var);
+    if (v && !v->empty()) {
+      return base::FilePath::FromUTF8Unsafe(*v);
+    }
+  }
+  return home.AppendASCII(fallback);
+}
+
+// Files matching `pattern` in `dir` written to since `since`.
+std::vector<base::FilePath> RecentFiles(
+    const base::FilePath& dir,
+    const base::FilePath::StringType& pattern,
+    base::Time since) {
+  std::vector<base::FilePath> out;
+  base::FileEnumerator e(dir, false, base::FileEnumerator::FILES, pattern);
+  for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+    if (since.is_null() || e.GetInfo().GetLastModifiedTime() >= since - kSlack) {
+      out.push_back(p);
+    }
+  }
+  return out;
+}
+
+// ---- Codex: <CODEX_HOME>/sessions/YYYY/MM/DD/rollout-<time>-<id>.jsonl ----
+std::vector<Candidate> Codex(const base::FilePath& home,
+                             bool hermetic,
+                             const base::FilePath& root,
+                             base::Time since) {
+  const base::FilePath sessions =
+      AgentDir(home, hermetic, "CODEX_HOME", ".codex").AppendASCII("sessions");
+  // The day folders (local dates) from the day before the terminal started.
+  const base::Time now = base::Time::Now();
+  base::Time from = since.is_null() ? now - base::Days(7) : since - base::Days(1);
+  from = std::clamp(from, now - base::Days(31), now - base::Days(1));
+  std::vector<Candidate> out;
+  for (base::Time day = from; day <= now + base::Days(1); day += base::Days(1)) {
+    base::Time::Exploded x;
+    day.LocalExplode(&x);
+    const base::FilePath dir = sessions.AppendASCII(
+        base::StringPrintf("%04d/%02d/%02d", x.year, x.month, x.day_of_month));
+    for (const base::FilePath& p :
+         RecentFiles(dir, FILE_PATH_LITERAL("rollout-*.jsonl"), since)) {
+      std::optional<base::DictValue> first = FirstLine(p);
+      const base::DictValue* meta = first ? first->FindDict("payload") : nullptr;
+      const std::string* type = first ? first->FindString("type") : nullptr;
+      if (!meta || !type || *type != "session_meta") {
+        continue;
+      }
+      const std::string* cwd = meta->FindString("cwd");
+      if (!cwd || !SameDir(root, *cwd)) {
+        continue;
+      }
+      Candidate c;
+      c.path = p;
+      c.start = Parse(meta->FindString("timestamp"));
+      if (c.start.is_null()) {
+        c.start = Parse(first->FindString("timestamp"));
+      }
+      c.modified = ModifiedTime(p);
+      out.push_back(std::move(c));
+    }
+  }
+  return out;
+}
+
+// ---- Qwen Code: ~/.qwen/projects/<root, non-alphanumerics as ->/chats/*.jsonl
+std::string QwenProjectName(const base::FilePath& root) {
+  std::string name = root.AsUTF8Unsafe();
+  for (char& c : name) {
+    if (!base::IsAsciiAlphaNumeric(c)) {
+      c = '-';
+    }
+  }
+  return name;
+}
+
+std::vector<Candidate> Qwen(const base::FilePath& home,
+                            const base::FilePath& root,
+                            base::Time since) {
+  const base::FilePath projects = home.AppendASCII(".qwen").AppendASCII("projects");
+  std::vector<base::FilePath> dirs;
+  for (const base::FilePath& r : {root, base::MakeAbsoluteFilePath(root)}) {
+    if (r.empty()) {
+      continue;
+    }
+    base::FilePath dir = projects.AppendASCII(QwenProjectName(r)).AppendASCII("chats");
+    if (base::DirectoryExists(dir) &&
+        std::ranges::find(dirs, dir) == dirs.end()) {
+      dirs.push_back(dir);
+    }
+  }
+  std::vector<Candidate> out;
+  for (const base::FilePath& dir : dirs) {
+    for (const base::FilePath& p : RecentFiles(dir, FILE_PATH_LITERAL("*.jsonl"), since)) {
+      std::optional<base::DictValue> first = FirstLine(p);
+      if (!first) {
+        continue;
+      }
+      const std::string* cwd = first->FindString("cwd");
+      if (cwd && !SameDir(root, *cwd)) {
+        continue;
+      }
+      Candidate c;
+      c.path = p;
+      c.start = Parse(first->FindString("timestamp"));
+      c.modified = ModifiedTime(p);
+      out.push_back(std::move(c));
+    }
+  }
+  return out;
+}
+
+// ---- Gemini CLI: ~/.gemini/tmp/<name from projects.json, or the root's
+// SHA-256>/chats/session-*.jsonl, a metadata line first ----
+std::vector<Candidate> Gemini(const base::FilePath& home,
+                              const base::FilePath& root,
+                              base::Time since) {
+  const base::FilePath gemini = home.AppendASCII(".gemini");
+  std::vector<std::string> names;
+  std::string json;
+  if (base::ReadFileToStringWithMaxSize(gemini.AppendASCII("projects.json"),
+                                        &json, 4 << 20)) {
+    std::optional<base::Value> v = base::JSONReader::Read(json, 0);
+    const base::DictValue* projects =
+        v && v->is_dict() ? v->GetDict().FindDict("projects") : nullptr;
+    if (projects) {
+      for (const auto [path, name] : *projects) {
+        if (name.is_string() && SameDir(root, path) &&
+            name.GetString().find('/') == std::string::npos &&
+            name.GetString() != ".." && !name.GetString().empty()) {
+          names.push_back(name.GetString());
+        }
+      }
+    }
+  }
+  names.push_back(base::ToLowerASCII(base::HexEncode(
+      crypto::hash::Sha256(base::as_byte_span(root.AsUTF8Unsafe())))));
+  std::vector<Candidate> out;
+  for (const std::string& name : names) {
+    const base::FilePath dir =
+        gemini.AppendASCII("tmp").AppendASCII(name).AppendASCII("chats");
+    for (const base::FilePath& p :
+         RecentFiles(dir, FILE_PATH_LITERAL("session-*.jsonl"), since)) {
+      std::optional<base::DictValue> first = FirstLine(p);
+      const std::string* kind = first ? first->FindString("kind") : nullptr;
+      // A subagent's own chat isn't the session.
+      if (!first || (kind && *kind != "main")) {
+        continue;
+      }
+      Candidate c;
+      c.path = p;
+      c.start = Parse(first->FindString("startTime"));
+      c.modified = ModifiedTime(p);
+      out.push_back(std::move(c));
+    }
+  }
+  return out;
+}
+
+// ---- Copilot CLI: <COPILOT_HOME>/session-state/<id>/events.jsonl ----
+std::vector<Candidate> Copilot(const base::FilePath& home,
+                               bool hermetic,
+                               const base::FilePath& root,
+                               base::Time since) {
+  const base::FilePath state =
+      AgentDir(home, hermetic, "COPILOT_HOME", ".copilot")
+          .AppendASCII("session-state");
+  std::vector<Candidate> out;
+  base::FileEnumerator e(state, false, base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath dir = e.Next(); !dir.empty(); dir = e.Next()) {
+    const base::FilePath p = dir.AppendASCII("events.jsonl");
+    const base::Time modified = ModifiedTime(p);
+    if (modified.is_null() || (!since.is_null() && modified < since - kSlack)) {
+      continue;
+    }
+    std::optional<base::DictValue> first = FirstLine(p);
+    const base::DictValue* data = first ? first->FindDict("data") : nullptr;
+    const std::string* cwd =
+        data ? data->FindStringByDottedPath("context.cwd") : nullptr;
+    if (!cwd || !SameDir(root, *cwd)) {
+      continue;
+    }
+    Candidate c;
+    c.path = p;
+    c.start = Parse(data->FindString("startTime"));
+    c.modified = modified;
+    out.push_back(std::move(c));
+  }
+  return out;
+}
+
+// ---- OpenCode 1.x: <XDG_DATA_HOME>/opencode/opencode.db ----
+std::vector<Candidate> OpenCode(const base::FilePath& db_path,
+                                const base::FilePath& root) {
+  std::vector<Candidate> out;
+  if (!base::PathExists(db_path)) {
+    return out;
+  }
+  sql::Database db(sql::DatabaseOptions()
+                       .set_read_only(true)
+                       .set_exclusive_locking(false)
+                       .set_mmap_enabled(false),
+                   sql::Database::Tag("FirefoxImporter"));
+  if (!db.Open(db_path) || !db.DoesTableExist("session")) {
+    return out;
+  }
+  std::vector<std::string> dirs = {root.AsUTF8Unsafe()};
+  const base::FilePath real = base::MakeAbsoluteFilePath(root);
+  if (!real.empty() && real != root) {
+    dirs.push_back(real.AsUTF8Unsafe());
+  }
+  for (const std::string& dir : dirs) {
+    sql::Statement s(db.GetUniqueStatement(
+        "SELECT id, time_created, time_updated FROM session "
+        "WHERE directory = ? AND parent_id IS NULL"));
+    s.BindString(0, dir);
+    while (s.Step()) {
+      Candidate c;
+      c.path = db_path;
+      c.session_id = s.ColumnString(0);
+      c.start = base::Time::FromMillisecondsSinceUnixEpoch(s.ColumnInt64(1));
+      c.modified =
+          base::Time::FromMillisecondsSinceUnixEpoch(s.ColumnInt64(2));
+      out.push_back(std::move(c));
+    }
+  }
+  return out;
+}
+
+}  // namespace
+
+std::optional<AgentFormat> InsightsFormatOf(std::string_view kind) {
+  if (kind == "codex") {
+    return AgentFormat::kCodex;
+  }
+  if (kind == "qwen") {
+    return AgentFormat::kQwen;
+  }
+  if (kind == "gemini") {
+    return AgentFormat::kGemini;
+  }
+  if (kind == "copilot") {
+    return AgentFormat::kCopilot;
+  }
+  if (kind == "opencode") {
+    return AgentFormat::kOpenCode;
+  }
+  return std::nullopt;
+}
+
+std::string InsightsUnavailableReason(std::string_view kind) {
+  if (kind.starts_with("sandbox-")) {
+    return "This session runs in a sandbox: its record stays inside the "
+           "container, where Meridian doesn’t read.";
+  }
+  if (kind == "amp") {
+    return "Amp keeps its threads on Sourcegraph’s servers, not on this "
+           "computer, so there is nothing here to read.";
+  }
+  if (kind == "cursor") {
+    return "Cursor’s CLI keeps its sessions in an undocumented database and "
+           "shows its numbers only in its own status line, which Meridian "
+           "would have to change in your settings. Not read for now.";
+  }
+  if (kind == "droid") {
+    return "Droid’s session files couldn’t be checked against a real "
+           "session yet, so Meridian doesn’t guess at them.";
+  }
+  if (kind == "goose") {
+    return "Goose stores only each session’s running total, not each "
+           "request, and its database couldn’t be checked yet. Not read for "
+           "now.";
+  }
+  if (kind == "shell") {
+    return "A shell uses no tokens. Pick an agent’s tab to see its session.";
+  }
+  if (kind == "claude" || InsightsFormatOf(kind)) {
+    return std::string();
+  }
+  return "This agent’s sessions aren’t readable by Meridian.";
+}
+
+std::optional<AgentSession> FindAgentSession(AgentFormat format,
+                                             const base::FilePath& home,
+                                             bool hermetic,
+                                             const base::FilePath& root,
+                                             base::Time since,
+                                             base::Time until) {
+  std::vector<Candidate> all;
+  base::FilePath models;
+  switch (format) {
+    case AgentFormat::kCodex:
+      all = Codex(home, hermetic, root, since);
+      break;
+    case AgentFormat::kQwen:
+      all = Qwen(home, root, since);
+      break;
+    case AgentFormat::kGemini:
+      all = Gemini(home, root, since);
+      break;
+    case AgentFormat::kCopilot:
+      all = Copilot(home, hermetic, root, since);
+      break;
+    case AgentFormat::kOpenCode: {
+      const base::FilePath data =
+          AgentDir(home, hermetic, "XDG_DATA_HOME", ".local/share");
+      const base::FilePath cache =
+          AgentDir(home, hermetic, "XDG_CACHE_HOME", ".cache");
+      all = OpenCode(data.AppendASCII("opencode").AppendASCII("opencode.db"),
+                     root);
+      models = cache.AppendASCII("opencode").AppendASCII("models.json");
+      break;
+    }
+    case AgentFormat::kClaude:
+      return std::nullopt;
+  }
+  std::optional<Candidate> c = Pick(all, since, until);
+  if (!c) {
+    return std::nullopt;
+  }
+  AgentSession s;
+  s.format = format;
+  s.path = c->path;
+  s.session_id = c->session_id;
+  s.models = models;
+  return s;
+}
+
+}  // namespace meridian::workbench
