+class AgentSessionsTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(home_.CreateUniqueTempDir()); }
+
+  // A fixture copied into the home, its start time and folder changed.
+  base::FilePath Put(const char* fixture,
+                     const base::FilePath& rel,
+                     double start,
+                     const char* root = "/work/shop") {
+    std::string s = Read(Fixture(fixture));
+    base::ReplaceSubstringsAfterOffset(&s, 0, Iso(T(0)), Iso(T(start)));
+    base::ReplaceSubstringsAfterOffset(&s, 0, "/work/shop", root);
+    const base::FilePath p = home_.GetPath().Append(rel);
+    EXPECT_TRUE(base::CreateDirectory(p.DirName()));
+    EXPECT_TRUE(base::WriteFile(p, s));
+    // Written to until a little after it began.
+    EXPECT_TRUE(base::TouchFile(p, T(start + 30), T(start + 30)));
+    return p;
+  }
+
+  std::optional<AgentSession> Find(AgentFormat f,
+                                   base::Time since,
+                                   base::Time until = base::Time()) {
+    return FindAgentSession(f, home_.GetPath(), /*hermetic=*/true,
+                            base::FilePath("/work/shop"), since, until);
+  }
+
+  base::ScopedTempDir home_;
+};
