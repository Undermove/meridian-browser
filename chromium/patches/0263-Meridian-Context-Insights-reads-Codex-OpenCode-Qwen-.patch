+// The turns, in order, from the money series.
+std::vector<const base::DictValue*> Turns(const base::DictValue& r) {
+  std::vector<const base::DictValue*> out;
+  const base::ListValue* series = r.FindList("moneySeries");
+  if (!series) {
+    return out;
+  }
+  for (const base::Value& bar : *series) {
+    for (const base::Value& t : *bar.GetDict().FindList("turns")) {
+      out.push_back(&t.GetDict());
+    }
+  }
+  std::ranges::sort(out, {}, [](const base::DictValue* t) {
+    return *t->FindInt("index");
+  });
+  return out;
+}
+
+std::vector<std::string> Causes(const base::DictValue& r) {
+  std::vector<std::string> out;
+  for (const base::DictValue* t : Turns(r)) {
+    out.push_back(*t->FindString("cause"));
+  }
+  return out;
+}
+
+std::string Why(const base::DictValue& r, int index) {
+  for (const base::DictValue* t : Turns(r)) {
+    if (*t->FindInt("index") == index) {
+      return *t->FindString("why");
+    }
+  }
+  return std::string();
+}
+
+double SeriesTotal(const base::DictValue& r) {
+  double sum = 0;
+  for (const base::Value& bar : *r.FindList("moneySeries")) {
+    for (const char* k :
+         {"cacheRead", "cacheWrite", "input", "output", "subagents"}) {
+      sum += bar.GetDict().FindDouble(k).value_or(0);
+    }
+  }
+  return sum;
+}
+
+std::vector<std::string> InsightTitles(const base::DictValue& r) {
+  std::vector<std::string> out;
+  for (const base::Value& i : *r.FindList("insights")) {
+    out.push_back(*i.GetDict().FindString("title"));
+  }
+  return out;
+}
+
+bool AnyContains(const std::vector<std::string>& list, std::string_view s) {
+  return std::ranges::any_of(
+      list, [&](const std::string& x) { return x.find(s) != std::string::npos; });
+}
