+TEST_F(AgentSessionsTest, CodexByProjectAndTime) {
+  const base::FilePath a =
+      Put("codex-rollout.jsonl", CodexDay().AppendASCII("rollout-a.jsonl"), 0);
+  const base::FilePath b =
+      Put("codex-rollout.jsonl", CodexDay().AppendASCII("rollout-b.jsonl"), 100);
+  // Another project's session, newer: never this terminal's.
+  Put("codex-rollout.jsonl", CodexDay().AppendASCII("rollout-c.jsonl"), 200,
+      "/work/other");
+  // Two terminals: the first one (until the second started) and the second.
+  EXPECT_EQ(Find(AgentFormat::kCodex, T(-1), T(50))->path, a);
+  EXPECT_EQ(Find(AgentFormat::kCodex, T(50))->path, b);
+  // A terminal from before a restart: the newest session.
+  EXPECT_EQ(Find(AgentFormat::kCodex, base::Time())->path, b);
+  // Started after every session: none of them, until one is resumed in it
+  // (written to again).
+  EXPECT_FALSE(Find(AgentFormat::kCodex, T(10000)).has_value());
+  ASSERT_TRUE(base::TouchFile(a, T(20000), T(20000)));
+  EXPECT_EQ(Find(AgentFormat::kCodex, T(10000))->path, a);
+  EXPECT_FALSE(Find(AgentFormat::kQwen, base::Time()).has_value());
+}
