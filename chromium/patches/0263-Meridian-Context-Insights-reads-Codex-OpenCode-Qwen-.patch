+TEST(AgentInsightsTest, CodexRollout) {
+  ContextInsights ci(AgentFormat::kCodex);
+  ci.ReadMore(Fixture("codex-rollout.jsonl"));
+  base::DictValue r = ci.Result(std::nullopt);
+  EXPECT_EQ(*r.FindString("agent"), "Codex");
+  EXPECT_EQ(*r.FindString("model"), "gpt-5.5-codex");
+  EXPECT_EQ(*r.FindString("unit"), "tokens");
+  EXPECT_EQ(r.FindInt("requests"), 9);
+  // The window the record states, the context the last request sent.
+  EXPECT_EQ(r.FindDouble("contextSize"), 258400);
+  EXPECT_FALSE(*r.FindBool("contextSizeGuessed"));
+  EXPECT_EQ(r.FindDouble("contextTokens"), 6000);
+  // The system prompt from session_meta (8000 characters, a few of them
+  // two bytes).
+  EXPECT_NEAR(
+      *r.FindDictByDottedPath("breakdown")->FindDouble("systemPrompt"), 2000,
+      50);
+  // A cat read, a test run's output, a cold cache after 11 minutes, a
+  // compaction (told twice in the record, counted once).
+  EXPECT_EQ(Causes(r),
+            (std::vector<std::string>{"cold", "file", "tool", "normal",
+                                      "normal", "normal", "normal", "cold",
+                                      "compaction"}));
+  EXPECT_NE(Why(r, 2).find("cat src/cart.js"), std::string::npos);
+  EXPECT_NE(Why(r, 3).find("npm test"), std::string::npos);
+  EXPECT_NE(Why(r, 8).find("11 min pause"), std::string::npos);
+  EXPECT_NE(Why(r, 9).find("Compacted from 31.5k to 6k"), std::string::npos);
+  EXPECT_EQ(r.FindList("compactions")->size(), 1u);
+  // The plan's limits: 5 hours and a week.
+  const base::ListValue& limits = *r.FindList("limits");
+  ASSERT_EQ(limits.size(), 2u);
+  EXPECT_EQ(limits[0].GetDict().FindDouble("minutes"), 300);
+  EXPECT_EQ(limits[0].GetDict().FindDouble("pct"), 34);
+  EXPECT_EQ(limits[1].GetDict().FindDouble("minutes"), 10080);
+  // Tokens, not money: the bars add up to every token sent and written.
+  double tokens = 0;
+  for (double in : {11060., 21380., 29590., 29920., 30220., 30520., 30820., 31650.,
+                    6200.}) {
+    tokens += in;
+  }
+  EXPECT_NEAR(SeriesTotal(r), tokens, 0.5);
+  EXPECT_EQ(r.FindList("prompts")->size(), 2u);
+  EXPECT_TRUE(AnyContains(InsightTitles(r), "The cache went cold 1 time"));
+}
