+base::FilePath CodexDay() {
+  base::Time::Exploded x;
+  base::Time::Now().LocalExplode(&x);
+  return base::FilePath(".codex/sessions")
+      .AppendASCII(base::StringPrintf("%04d/%02d/%02d", x.year, x.month,
+                                      x.day_of_month));
+}
