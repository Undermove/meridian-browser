+namespace meridian::workbench {
+
+// Where an agent session started from a Workbench terminal keeps its record.
+struct AgentSession {
+  AgentFormat format = AgentFormat::kCodex;
+  // The session's file (JSONL), or OpenCode's database.
+  base::FilePath path;
+  // OpenCode: the session in the database.
+  std::string session_id;
+  // OpenCode: its models.dev cache, for the window and prices.
+  base::FilePath models;
+};
+
+// The reader for a Workbench terminal kind (codex, opencode…). Claude Code is
+// read through its status line instead; nullopt for kinds without one.
+std::optional<AgentFormat> InsightsFormatOf(std::string_view kind);
+
+// Why a kind has no Context Insights, for the panel ("" when it has).
+std::string InsightsUnavailableReason(std::string_view kind);
+
+// Blocking. The session of agent `format` run in `root` by a terminal that
+// started at `since` (null: unknown), when the next terminal of the same
+// agent in that project started at `until` (null: none): the newest session
+// that began in between, else (a resumed one) the newest one written to since
+// then. `home`: the person's home; the agents' own variables (CODEX_HOME,
+// COPILOT_HOME, XDG_*) count unless `hermetic` (tests).
+std::optional<AgentSession> FindAgentSession(AgentFormat format,
+                                             const base::FilePath& home,
+                                             bool hermetic,
+                                             const base::FilePath& root,
+                                             base::Time since,
+                                             base::Time until);
+
