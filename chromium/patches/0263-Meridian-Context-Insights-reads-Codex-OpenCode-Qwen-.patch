+// Text of a content list's first text block ({"text": …} or
+// {"type": "input_text", "text": …}).
+std::string FirstText(const base::ListValue* blocks) {
+  if (!blocks) {
+    return std::string();
+  }
+  for (const base::Value& b : *blocks) {
+    if (b.is_dict()) {
+      if (const std::string* t = b.GetDict().FindString("text")) {
+        return *t;
+      }
+    }
+  }
+  return std::string();
+}
+
+// The size of a tool's output, however the agent stores it.
+double OutputChars(const base::Value* output) {
+  if (!output) {
+    return 0;
+  }
+  if (output->is_string()) {
+    return static_cast<double>(output->GetString().size());
+  }
+  if (output->is_dict()) {
+    for (const char* key : {"content", "output", "text"}) {
+      if (const base::Value* inner = output->GetDict().Find(key)) {
+        return OutputChars(inner);
+      }
+    }
+  }
+  if (output->is_list()) {
+    auto [chars, images] = ContentSize(output);
+    if (chars || images) {
+      return chars;
+    }
+  }
+  return static_cast<double>(base::WriteJson(*output).value_or("").size());
+}
