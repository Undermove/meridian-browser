+// Codex: rollout-*.jsonl. Each line {timestamp, type, payload}.
+void ContextInsights::FeedCodex(const base::DictValue& entry) {
+  const std::string* type = entry.FindString("type");
+  const base::DictValue* p = entry.FindDict("payload");
+  if (!type || !p) {
+    return;
+  }
+  const double ts = Ts(entry);
+  if (*type == "session_meta") {
+    const base::DictValue* base = p->FindDict("base_instructions");
+    const std::string* text = base ? base->FindString("text") : nullptr;
+    if (text) {
+      system_chars_ = static_cast<double>(text->size());
+    }
+    return;
+  }
+  if (*type == "turn_context") {
+    if (const std::string* model = p->FindString("model")) {
+      model_ = Short(*model, 60);
+    }
+    return;
+  }
+  if (*type == "compacted") {
+    AddCompaction(ts, 0, 0, std::string());
+    return;
+  }
+  auto request = [&](const base::DictValue* usage, const std::string& key) {
+    if (!usage) {
+      return;
+    }
+    Request r;
+    r.ts = ts;
+    r.cache_read = Num(usage, "cached_input_tokens");
+    r.cache_write = Num(usage, "cache_write_input_tokens");
+    // OpenAI counts cached input in the input.
+    r.input = Num(usage, "input_tokens") - r.cache_read - r.cache_write;
+    r.output = Num(usage, "output_tokens");
+    AddRequest(r, key);
+  };
+  if (*type == "token_usage_record") {
+    codex_records_ = true;
+    const std::string* id = p->FindString("response_id");
+    request(p->FindDict("usage"),
+            id ? *id : "t" + base::NumberToString(requests_.size()));
+    return;
+  }
+  const std::string* ptype = p->FindString("type");
+  if (!ptype) {
+    return;
+  }
+  if (*type == "event_msg") {
+    if (*ptype == "token_count") {
+      if (const base::DictValue* info = p->FindDict("info")) {
+        if (double window = Num(info, "model_context_window")) {
+          window_ = window;
+        }
+        // Older Codex: no per-request records, a token_count after each
+        // request (sometimes twice).
+        const double total =
+            Num(info->FindDict("total_token_usage"), "total_tokens");
+        if (!codex_records_ && total > codex_total_) {
+          codex_total_ = total;
+          request(info->FindDict("last_token_usage"), std::string());
+        }
+      }
+      if (const base::DictValue* rl = p->FindDict("rate_limits")) {
+        std::vector<Limit> limits;
+        for (const char* which : {"primary", "secondary"}) {
+          const base::DictValue* l = rl->FindDict(which);
+          if (!l || !l->Find("used_percent")) {
+            continue;
+          }
+          Limit limit;
+          limit.pct = Num(l, "used_percent");
+          limit.minutes = Num(l, "window_minutes");
+          limit.resets_at = Num(l, "resets_at");
+          if (!limit.resets_at && Num(l, "resets_in_seconds") && ts) {
+            limit.resets_at = ts + Num(l, "resets_in_seconds");
+          }
+          limits.push_back(limit);
+        }
+        // An empty report (an API key has no plan limits) keeps the last.
+        if (!limits.empty()) {
+          limits_ = std::move(limits);
+        }
+      }
+    } else if (*ptype == "context_compacted") {
+      AddCompaction(ts, 0, 0, std::string());
+    }
+    return;
+  }
+  if (*type != "response_item") {
+    return;
+  }
+  if (*ptype == "message") {
+    const std::string* role = p->FindString("role");
+    if (role && *role == "user") {
+      AddPrompt(ts, FirstText(p->FindList("content")));
+    }
+  } else if (*ptype == "function_call" || *ptype == "custom_tool_call") {
+    const std::string* id = p->FindString("call_id");
+    const std::string* name = p->FindString("name");
+    const std::string* args = p->FindString("arguments");
+    std::optional<base::Value> input =
+        args ? base::JSONReader::Read(*args, 0) : std::nullopt;
+    const base::DictValue* dict =
+        input && input->is_dict() ? &input->GetDict() : nullptr;
+    if (id && name) {
+      AddCall(*id, *name, dict, KindOf(*name, dict));
+    }
+  } else if (*ptype == "function_call_output" ||
+             *ptype == "custom_tool_call_output") {
+    if (const std::string* id = p->FindString("call_id")) {
+      AddResult(*id, OutputChars(p->Find("output")), 0);
+    }
+  }
+}
+
+// Qwen Code: chats/<session>.jsonl. Gemini-style messages, a record a line.
+void ContextInsights::FeedQwen(const base::DictValue& entry) {
+  const std::string* type = entry.FindString("type");
+  if (!type) {
+    return;
+  }
+  const double ts = Ts(entry);
+  const base::DictValue* message = entry.FindDict("message");
+  const base::ListValue* parts = message ? message->FindList("parts") : nullptr;
+  if (*type == "user") {
+    const std::string* provenance = entry.FindString("provenance");
+    if (!provenance || *provenance == "real_user") {
+      AddPrompt(ts, FirstText(parts));
+    }
+  } else if (*type == "assistant") {
+    if (const std::string* model = entry.FindString("model")) {
+      model_ = Short(*model, 60);
+    }
+    if (double window = Num(&entry, "contextWindowSize")) {
+      window_ = window;
+    }
+    if (const base::DictValue* usage = entry.FindDict("usageMetadata")) {
+      Request r;
+      r.ts = ts;
+      r.cache_read = Num(usage, "cachedContentTokenCount");
+      r.input = Num(usage, "promptTokenCount") - r.cache_read;
+      r.output = Num(usage, "candidatesTokenCount");
+      const std::string* uuid = entry.FindString("uuid");
+      AddRequest(r, uuid ? *uuid : std::string());
+    }
+    if (parts) {
+      for (const base::Value& part : *parts) {
+        const base::DictValue* call =
+            part.is_dict() ? part.GetDict().FindDict("functionCall") : nullptr;
+        const std::string* id = call ? call->FindString("id") : nullptr;
+        const std::string* name = call ? call->FindString("name") : nullptr;
+        if (id && name) {
+          const base::DictValue* args = call->FindDict("args");
+          AddCall(*id, *name, args, KindOf(*name, args));
+        }
+      }
+    }
+  } else if (*type == "tool_result" && parts) {
+    for (const base::Value& part : *parts) {
+      const base::DictValue* response =
+          part.is_dict() ? part.GetDict().FindDict("functionResponse")
+                         : nullptr;
+      const std::string* id = response ? response->FindString("id") : nullptr;
+      if (id) {
+        AddResult(*id, OutputChars(response->Find("response")), 0);
+      }
+    }
+  } else if (*type == "system") {
+    const std::string* subtype = entry.FindString("subtype");
+    const base::DictValue* payload = entry.FindDict("systemPayload");
+    if (subtype && *subtype == "chat_compression" && payload) {
+      const base::DictValue* info = payload->FindDict("info");
+      AddCompaction(ts, Num(info, "originalTokenCount"),
+                    Num(info, "newTokenCount"), std::string());
+    }
+  }
+}
+
+// Gemini CLI: chats/session-*.jsonl. A metadata line, then records by id; a
+// record written again replaces the old one, {"$rewindTo": id} drops that
+// record and the ones after it, {"$set": …} changes metadata.
+void ContextInsights::FeedGemini(const base::DictValue& entry) {
+  if (const std::string* rewind = entry.FindString("$rewindTo")) {
+    auto it = std::ranges::find(gemini_, *rewind, &GeminiRecord::id);
+    gemini_.erase(it == gemini_.end() ? gemini_.begin() : it, gemini_.end());
+    return;
+  }
+  const std::string* id = entry.FindString("id");
+  const std::string* type = entry.FindString("type");
+  if (!id || !type || (*type != "user" && *type != "gemini")) {
+    return;
+  }
+  GeminiRecord r;
+  r.id = *id;
+  r.type = *type;
+  r.ts = Ts(entry);
+  if (const std::string* text = entry.FindString("content")) {
+    r.text = *text;
+  } else {
+    r.text = FirstText(entry.FindList("content"));
+  }
+  if (const std::string* model = entry.FindString("model")) {
+    r.model = Short(*model, 60);
+  }
+  if (const base::DictValue* tokens = entry.FindDict("tokens")) {
+    r.has_tokens = true;
+    r.cached = Num(tokens, "cached");
+    r.input = Num(tokens, "input");
+    r.output = Num(tokens, "output") + Num(tokens, "thoughts");
+  }
+  if (const base::ListValue* calls = entry.FindList("toolCalls")) {
+    for (const base::Value& c : *calls) {
+      if (!c.is_dict()) {
+        continue;
+      }
+      const base::DictValue& d = c.GetDict();
+      const std::string* cid = d.FindString("id");
+      const std::string* name = d.FindString("name");
+      if (!cid || !name) {
+        continue;
+      }
+      GeminiRecord::Call call;
+      call.id = *cid;
+      call.name = *name;
+      const base::DictValue* args = d.FindDict("args");
+      call.target = args ? TargetOf(*name, *args) : std::string();
+      if (const base::ListValue* result = d.FindList("result")) {
+        call.chars = 0;
+        for (const base::Value& part : *result) {
+          const base::DictValue* response =
+              part.is_dict() ? part.GetDict().FindDict("functionResponse")
+                             : nullptr;
+          call.chars += response ? OutputChars(response->Find("response"))
+                                 : OutputChars(&part);
+        }
+      }
+      r.calls.push_back(std::move(call));
+    }
+  }
+  auto it = std::ranges::find(gemini_, r.id, &GeminiRecord::id);
+  if (it != gemini_.end()) {
+    *it = std::move(r);
+  } else {
+    gemini_.push_back(std::move(r));
+  }
+}
+
+void ContextInsights::RebuildGemini() {
+  requests_.clear();
+  seen_requests_.clear();
+  calls_.clear();
+  call_order_.clear();
+  prompts_.clear();
+  compactions_.clear();
+  for (const GeminiRecord& r : gemini_) {
+    if (r.type == "user") {
+      AddPrompt(r.ts, r.text);
+      continue;
+    }
+    if (!r.model.empty()) {
+      model_ = r.model;
+    }
+    if (r.has_tokens) {
+      Request q;
+      q.ts = r.ts;
+      q.cache_read = r.cached;
+      q.input = r.input - r.cached;
+      q.output = r.output;
+      AddRequest(q, r.id);
+    }
+    for (const GeminiRecord::Call& c : r.calls) {
+      ToolKind kind = KindOf(c.name, nullptr);
+      AddCall(c.id, c.name, nullptr, kind);
+      if (auto call = calls_.find(c.id); call != calls_.end()) {
+        call->second.target = c.target;
+      }
+      if (c.chars >= 0) {
+        AddResult(c.id, c.chars, 0);
+      }
+    }
+  }
+  // The CLI's own table (tokenLimits.js): Gemma 4 has 256k, the rest 1M.
+  window_ = model_.starts_with("gemma-4") ? 256000 : 1048576;
+}
+
+// Copilot CLI: session-state/<id>/events.jsonl, {type, data, timestamp}.
+void ContextInsights::FeedCopilot(const base::DictValue& entry) {
+  const std::string* type = entry.FindString("type");
+  const base::DictValue* d = entry.FindDict("data");
+  if (!type || !d) {
+    return;
+  }
+  const double ts = Ts(entry);
+  if (*type == "session.start") {
+    if (const std::string* model = d->FindString("selectedModel")) {
+      model_ = Short(*model, 60);
+    }
+  } else if (*type == "user.message") {
+    if (const std::string* text = d->FindString("content")) {
+      AddPrompt(ts, *text);
+    }
+  } else if (*type == "session.usage_record") {
+    const base::DictValue* usage = d->FindDict("usage");
+    if (!usage) {
+      return;
+    }
+    Request r;
+    r.ts = ts;
+    r.cache_read = Num(usage, "cacheReadTokens");
+    r.cache_write = Num(usage, "cacheWriteTokens");
+    r.input = Num(usage, "inputTokens") - r.cache_read - r.cache_write;
+    r.output = Num(usage, "outputTokens");
+    if (const std::string* model = usage->FindString("model")) {
+      model_ = Short(*model, 60);
+    }
+    if (double window = Num(usage, "maxPromptTokens")) {
+      window_ = window;
+    }
+    const std::string* id = usage->FindString("apiCallId");
+    const std::string* event = entry.FindString("id");
+    AddRequest(r, id ? *id : event ? *event : std::string());
+  } else if (*type == "tool.execution_start") {
+    const std::string* id = d->FindString("toolCallId");
+    const std::string* name = d->FindString("toolName");
+    if (id && name) {
+      const base::DictValue* args = d->FindDict("arguments");
+      AddCall(*id, *name, args, KindOf(*name, args));
+    }
+  } else if (*type == "tool.execution_complete") {
+    if (const std::string* id = d->FindString("toolCallId")) {
+      const base::DictValue* result = d->FindDict("result");
+      AddResult(*id, result ? OutputChars(result->Find("content")) : 0, 0);
+    }
+  } else if (*type == "session.compaction_complete") {
+    AddCompaction(ts, Num(d, "preCompactionTokens"),
+                  Num(d, "postCompactionTokens"), std::string());
+  }
+}
+
+// OpenCode 1.x: opencode.db. session(id, directory, parent_id…),
+// message(id, session_id, data: {role, modelID, providerID, mode}),
+// part(message_id, session_id, time_created, data: {type…}). A request is a
+// step: its "step-finish" part has the tokens and the cost.
+void ContextInsights::ReadOpenCode(const base::FilePath& db_path,
+                                   const std::string& session_id,
+                                   const base::FilePath& models) {
+  // Rows change in place (a tool's state): read the session again.
+  auto cache = std::move(opencode_models_);
+  const bool cache_read = opencode_models_read_;
+  *this = ContextInsights(AgentFormat::kOpenCode);
+  opencode_models_ = std::move(cache);
+  opencode_models_read_ = cache_read;
+
+  sql::Database db(sql::DatabaseOptions()
+                       .set_read_only(true)
+                       .set_exclusive_locking(false)
+                       .set_mmap_enabled(false),
+                   sql::Database::Tag("FirefoxImporter"));
+  if (!db.Open(db_path)) {
+    return;
+  }
+  struct Message {
+    bool user = false;
+    std::string model;
+  };
+  std::map<std::string, Message> messages;
+  {
+    sql::Statement s(db.GetUniqueStatement(
+        "SELECT id, data FROM message WHERE session_id = ?"));
+    s.BindString(0, session_id);
+    while (s.Step()) {
+      std::optional<base::Value> v = base::JSONReader::Read(s.ColumnString(1), 0);
+      if (!v || !v->is_dict()) {
+        continue;
+      }
+      Message m;
+      const std::string* role = v->GetDict().FindString("role");
+      m.user = role && *role == "user";
+      const std::string* provider = v->GetDict().FindString("providerID");
+      const std::string* model = v->GetDict().FindString("modelID");
+      if (provider && model) {
+        m.model = *provider + "/" + *model;
+      }
+      messages[s.ColumnString(0)] = std::move(m);
+    }
+  }
+  std::string last_model;
+  std::set<std::string> prompted;
+  double total_cost = 0;
+  {
+    sql::Statement s(db.GetUniqueStatement(
+        "SELECT message_id, time_created, data, id FROM part "
+        "WHERE session_id = ? ORDER BY time_created, id"));
+    s.BindString(0, session_id);
+    while (s.Step()) {
+      const std::string message_id = s.ColumnString(0);
+      const double ts = static_cast<double>(s.ColumnInt64(1)) / 1000;
+      std::optional<base::Value> v = base::JSONReader::Read(s.ColumnString(2), 0);
+      if (!v || !v->is_dict()) {
+        continue;
+      }
+      const base::DictValue& part = v->GetDict();
+      const std::string* type = part.FindString("type");
+      if (!type) {
+        continue;
+      }
+      const Message& m = messages[message_id];
+      if (*type == "text") {
+        const std::string* text = part.FindString("text");
+        if (m.user && text && !part.FindBool("synthetic").value_or(false) &&
+            prompted.insert(message_id).second) {
+          std::string_view t = base::TrimWhitespaceASCII(*text, base::TRIM_ALL);
+          // `opencode run` quotes the message.
+          if (t.size() >= 2 && t.front() == '"' && t.back() == '"') {
+            t = t.substr(1, t.size() - 2);
+          }
+          AddPrompt(ts, t);
+        }
+      } else if (*type == "step-start") {
+        step_open_ = true;
+      } else if (*type == "tool") {
+        const std::string* id = part.FindString("callID");
+        const std::string* name = part.FindString("tool");
+        const base::DictValue* state = part.FindDict("state");
+        if (!id || !name || !state) {
+          continue;
+        }
+        const base::DictValue* input = state->FindDict("input");
+        AddCall(*id, *name, input, KindOf(*name, input));
+        const std::string* status = state->FindString("status");
+        if (status && (*status == "completed" || *status == "error")) {
+          const base::Value* output = state->Find("output");
+          if (!output) {
+            output = state->Find("error");
+          }
+          int images = 0;
+          if (const base::ListValue* files = state->FindList("attachments")) {
+            images = static_cast<int>(files->size());
+          }
+          AddResult(*id, OutputChars(output), images);
+        }
+      } else if (*type == "step-finish") {
+        step_open_ = false;
+        const base::DictValue* tokens = part.FindDict("tokens");
+        if (!tokens) {
+          continue;
+        }
+        Request r;
+        r.ts = ts;
+        r.input = Num(tokens, "input");
+        r.output = Num(tokens, "output");
+        r.cache_read = Num(tokens->FindDict("cache"), "read");
+        r.cache_write = Num(tokens->FindDict("cache"), "write");
+        r.cost = Num(&part, "cost");
+        total_cost += r.cost;
+        AddRequest(r, s.ColumnString(3));
+        if (!m.model.empty()) {
+          last_model = m.model;
+          model_ = Short(m.model.substr(m.model.find('/') + 1), 60);
+        }
+      } else if (*type == "compaction") {
+        AddCompaction(ts, 0, 0,
+                      part.FindBool("auto").value_or(false) ? "auto"
+                                                            : "manual");
+      }
+    }
+  }
+  // Subagents (the task tool) run as child sessions.
+  {
+    sql::Statement s(db.GetUniqueStatement(
+        "SELECT p.time_created, p.data FROM part p JOIN session c "
+        "ON p.session_id = c.id WHERE c.parent_id = ? "
+        "ORDER BY p.time_created"));
+    s.BindString(0, session_id);
+    while (s.Step()) {
+      std::optional<base::Value> v = base::JSONReader::Read(s.ColumnString(1), 0);
+      if (!v || !v->is_dict()) {
+        continue;
+      }
+      const std::string* type = v->GetDict().FindString("type");
+      const base::DictValue* tokens = v->GetDict().FindDict("tokens");
+      if (!type || *type != "step-finish" || !tokens) {
+        continue;
+      }
+      Request r;
+      r.ts = static_cast<double>(s.ColumnInt64(0)) / 1000;
+      r.input = Num(tokens, "input");
+      r.output = Num(tokens, "output");
+      r.cache_read = Num(tokens->FindDict("cache"), "read");
+      r.cache_write = Num(tokens->FindDict("cache"), "write");
+      r.cost = Num(&v->GetDict(), "cost");
+      total_cost += r.cost;
+      subagents_.input += r.input;
+      subagents_.cache_read += r.cache_read;
+      subagents_.cache_write += r.cache_write;
+      subagents_.output += r.output;
+      subagent_requests_++;
+      subagent_spend_.push_back({r.ts, r});
+    }
+  }
+
+  // The model's window and prices: OpenCode's models.dev cache.
+  if (!opencode_models_read_ && !models.empty()) {
+    opencode_models_read_ = true;
+    std::string json;
+    if (base::ReadFileToStringWithMaxSize(models, &json, 64 << 20)) {
+      std::optional<base::Value> v = base::JSONReader::Read(json, 0);
+      if (v && v->is_dict()) {
+        for (const auto [provider, p] : v->GetDict()) {
+          const base::DictValue* list =
+              p.is_dict() ? p.GetDict().FindDict("models") : nullptr;
+          if (!list) {
+            continue;
+          }
+          for (const auto [id, model] : *list) {
+            if (!model.is_dict()) {
+              continue;
+            }
+            const base::DictValue& m = model.GetDict();
+            Weights w = {0, 0, 0, 0};
+            if (const base::DictValue* cost = m.FindDict("cost");
+                cost && Num(cost, "input") > 0) {
+              const double in = Num(cost, "input");
+              w.read = cost->Find("cache_read") ? Num(cost, "cache_read") / in
+                                                : 1;
+              w.write5m = cost->Find("cache_write")
+                              ? Num(cost, "cache_write") / in
+                              : 1;
+              w.write1h = w.write5m;
+              w.output = Num(cost, "output") / in;
+            }
+            opencode_models_[provider + "/" + id] = {
+                Num(m.FindDict("limit"), "context"), w};
+          }
+        }
+      }
+    }
+  }
+  if (auto it = opencode_models_.find(last_model);
+      it != opencode_models_.end()) {
+    window_ = it->second.first;
+    if (total_cost > 0 && it->second.second.output > 0) {
+      weights_ = it->second.second;
+    }
+  }
+  if (total_cost > 0) {
+    total_cost_ = total_cost;
+    priced_by_request_ = true;
+    // A price without a price list: split each request's cost the usual way.
+    if (weights_.output == 1 && weights_.read == 1) {
+      weights_ = Weights();
+    }
+  }
+}
+
 }  // namespace meridian::workbench
