+// A Gemini file read in two goes: a rewind in the second part still drops
+// what the first part had.
+TEST(AgentInsightsTest, GeminiReadInParts) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const std::string all = Read(Fixture("gemini-session.jsonl"));
+  const size_t cut = all.find("{\"$rewindTo\"");
+  ASSERT_NE(cut, std::string::npos);
+  const base::FilePath p = dir.GetPath().AppendASCII("s.jsonl");
+  ASSERT_TRUE(base::WriteFile(p, all.substr(0, cut)));
+  ContextInsights ci(AgentFormat::kGemini);
+  ci.ReadMore(p);
+  // So far the attempt that gets rewound is the last request.
+  EXPECT_EQ(ci.Result(std::nullopt).FindDouble("contextTokens"), 99999);
+  ASSERT_TRUE(base::AppendToFile(p, all.substr(cut)));
+  ci.ReadMore(p);
+  EXPECT_EQ(ci.Result(std::nullopt).FindInt("requests"), 6);
+  EXPECT_EQ(ci.Result(std::nullopt).FindDouble("contextTokens"), 28000);
+}
