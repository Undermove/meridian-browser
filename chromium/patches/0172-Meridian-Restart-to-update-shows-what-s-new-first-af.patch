diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index 7350873236..c5e7b74638 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -2268,6 +2268,34 @@ void SidebarHandler::Notify() {
 
 void SidebarHandler::GetState(GetStateCallback callback) {
   std::move(callback).Run(BuildState());
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SidebarHandler::MaybeShowWhatsNew,
+                                weak_factory_.GetWeakPtr()));
+}
+
+// What's new: the first window after an update opens the changelog at the
+// new version's entry (not on a new install, which is onboarded instead).
+void SidebarHandler::MaybeShowWhatsNew() {
+  static bool checked = false;
+  if (checked || !HoldsSpaceTabs(browser_.get())) {
+    return;
+  }
+  checked = true;
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  const std::string last = prefs->GetString(prefs::kLastVersion);
+  prefs->SetString(prefs::kLastVersion, update::kVersion);
+  const bool updated = last.empty() ? prefs->GetBoolean(prefs::kOnboarded)
+                                    : update::IsNewer(update::kVersion, last);
+  std::string page = "https://undermove.github.io/meridian-browser/changelog.html";
+  if (TestSwitchesAllowed()) {
+    // Tests: only one that asks for it.
+    page = TestSwitchValue("meridian-test-changelog-url");
+  }
+  if (!updated || page.empty()) {
+    return;
+  }
+  OpenInSpace(browser_.get(), service_->active_space_id(),
+              GURL(page + "#v" + update::kVersion), /*active=*/true);
 }
 
 void SidebarHandler::CreateSpace(const std::string& name,
