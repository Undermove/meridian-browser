+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import {renderMarkdown} from './markdown.js';
+import type {MeridianUpdateSheetElement} from './update_sheet.js';
+
+export function getHtml(this: MeridianUpdateSheetElement) {
+  return html`<!--_html_template_start_-->
+<div id="overlay" @mousedown="${this.onOverlayMousedown_}"
+    @keydown="${this.onKeydown_}">
+  <div id="card" role="dialog" aria-labelledby="title" tabindex="-1">
+    <header>
+      <span class="badge">${icon('sparkles', 18)}</span>
+      <div>
+        <div id="title">Meridian ${this.state_?.version} is ready</div>
+        <div class="sub">You have ${this.state_?.current}. Meridian quits and
+          opens again with your tabs.</div>
+      </div>
+    </header>
+    <div id="notes" class="notes">
+      ${!this.notes_() ? html`
+        <p class="muted">Fixes and improvements.</p>` :
+        html`${renderMarkdown(this.notes_())}`}
+    </div>
+    <footer>
+      <a id="changelog" href="#" @click="${this.onChangelogClick_}">
+        Full changelog</a>
+      <div class="grow"></div>
+      <button id="later" class="btn" @click="${this.onLaterClick_}">
+        Later</button>
+      <button id="restart" class="btn primary" ?disabled="${this.restarting_}"
+          @click="${this.onRestartClick_}">
+        ${this.restarting_ ? 'Restarting…' : 'Restart now'}</button>
+    </footer>
+  </div>
+</div>
+<!--_html_template_end_-->`;
+}
