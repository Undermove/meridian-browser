+++ b/chrome/browser/resources/webui_browser/meridian/update_sheet.ts
@@ -0,0 +1,101 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// "Restart to update" asks first: what's new in the version (its release
+// notes), then Restart now or Later.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {UpdateState} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './update_sheet.css.js';
+import {getHtml} from './update_sheet.html.js';
+
+// The public changelog; a version's entry is #v<version>.
+export const CHANGELOG_URL =
+    'https://undermove.github.io/meridian-browser/changelog.html';
+
+export class MeridianUpdateSheetElement extends CrLitElement {
+  static get is() {
+    return 'meridian-update-sheet';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      state_: {state: true, type: Object},
+      restarting_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  protected accessor state_: UpdateState|null = null;
+  protected accessor restarting_: boolean = false;
+
+  async show(update: UpdateState) {
+    this.state_ = update;
+    this.restarting_ = false;
+    this.open = true;
+    await this.updateComplete;
+    this.shadowRoot.querySelector<HTMLElement>('#restart')?.focus();
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  protected notes_(): string {
+    // GitHub's release notes; the first heading repeats the version.
+    return (this.state_?.notes || '')
+        .replace(/^\s*#\s*Meridian[^\n]*\n/i, '')
+        .trim();
+  }
+
+  protected onRestartClick_() {
+    this.restarting_ = true;
+    browserProxyFactory.getInstance().handler.installUpdate();
+  }
+
+  protected onLaterClick_() {
+    this.hide();
+  }
+
+  protected onChangelogClick_(e: Event) {
+    e.preventDefault();
+    this.fire('meridian-open-url',
+              `${CHANGELOG_URL}#v${this.state_?.version || ''}`);
+    this.hide();
+  }
+
+  protected onOverlayMousedown_(e: MouseEvent) {
+    if (e.target === e.currentTarget) {
+      this.hide();
+    }
+  }
+
+  protected onKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.hide();
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-update-sheet': MeridianUpdateSheetElement;
+  }
+}
+
+customElements.define(MeridianUpdateSheetElement.is,
+                      MeridianUpdateSheetElement);
