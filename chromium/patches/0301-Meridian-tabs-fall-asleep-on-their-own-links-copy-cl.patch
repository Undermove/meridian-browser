@@ -0,0 +1,58 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_COOKIE_LIST_H_
+#define CHROME_BROWSER_MERIDIAN_COOKIE_LIST_H_
+
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace meridian {
+
+// The element hiding rules of a filter list in Adblock Plus syntax (the
+// EasyList Cookie List), as CSS for a site: "##sel" everywhere,
+// "a.com,b.com##sel" on those sites, "a.com#@#sel" and "~a.com" not there,
+// "@@||a.com^$elemhide" (or $generichide) nothing (or only the site's own
+// rules) there. Network rules, scriptlets and extended selectors
+// (:has-text and the like) are left out: only what CSS itself can match.
+class CookieList {
+ public:
+  // Null when `text` has no element hiding rules at all.
+  static std::unique_ptr<CookieList> Parse(std::string_view text);
+
+  CookieList();
+  CookieList(const CookieList&) = delete;
+  CookieList& operator=(const CookieList&) = delete;
+  ~CookieList();
+
+  // CSS hiding the notices on `host` ("" when nothing applies): one rule per
+  // selector, so a selector this Chromium doesn't know drops only itself.
+  std::string CssFor(std::string_view host) const;
+
+  size_t generic_count() const { return generic_.size(); }
+  size_t site_count() const { return by_site_.size(); }
+
+ private:
+  // `host` and the sites it is under: www.a.co.uk, a.co.uk, co.uk, uk, and
+  // the "www.a.*", "a.*" forms lists use for any public suffix.
+  static std::vector<std::string> SitesOf(std::string_view host);
+  bool AnyIn(const std::set<std::string>& sites,
+             const std::vector<std::string>& of) const;
+
+  std::vector<std::string> generic_;
+  std::string generic_css_;
+  std::map<std::string, std::vector<std::string>> by_site_;
+  // Site -> selectors not used there.
+  std::map<std::string, std::set<std::string>> exceptions_;
+  std::set<std::string> no_generic_;
+  std::set<std::string> no_hiding_;
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_COOKIE_LIST_H_
diff --git a/chrome/browser/meridian/cookie_list_unittest.cc b/chrome/browser/meridian/cookie_list_unittest.cc
new file mode 100644
index 0000000000..aafa89a16b
--- /dev/null
+++ b/chrome/browser/meridian/cookie_list_unittest.cc
@@ -0,0 +1,89 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/cookie_list.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+constexpr char kList[] = R"([Adblock Plus 2.0]
+! Title: test
+||cookie-cdn.example^$script
+##.cookie-notice
+###consent-banner
+##.cookie-notice
+news.com,~sport.news.com##.gdpr-wall
+shop.*##.shop-cookies
+##.dup-free
+news.com#@#.dup-free
+#@#.never
+##.never
+##.bad:has-text(Accept)
+##.evil{} body
+example.org#?#.x:-abp-has(.y)
+example.org##+js(cookie-remover)
+@@||quiet.com^$elemhide
+@@||own.com^$generichide
+own.com##.own-banner
+)";
+
+TEST(CookieListTest, GenericRulesEverywhere) {
+  auto list = CookieList::Parse(kList);
+  ASSERT_TRUE(list);
+  EXPECT_EQ(list->generic_count(), 3u);  // .cookie-notice, #consent-banner,
+                                         // .dup-free (once each)
+  const std::string css = list->CssFor("www.any.net");
+  EXPECT_EQ(css,
+            ".cookie-notice{display:none!important}\n"
+            "#consent-banner{display:none!important}\n"
+            ".dup-free{display:none!important}\n");
+}
+
+TEST(CookieListTest, SiteRulesAndExceptions) {
+  auto list = CookieList::Parse(kList);
+  ASSERT_TRUE(list);
+  std::string css = list->CssFor("www.news.com");
+  EXPECT_NE(css.find(".gdpr-wall{"), std::string::npos);
+  EXPECT_EQ(css.find(".dup-free"), std::string::npos);  // news.com#@#
+  EXPECT_NE(css.find(".cookie-notice{"), std::string::npos);
+  // ~sport.news.com
+  EXPECT_EQ(list->CssFor("sport.news.com").find(".gdpr-wall"),
+            std::string::npos);
+  // shop.* on any top-level domain.
+  EXPECT_NE(list->CssFor("shop.de").find(".shop-cookies"), std::string::npos);
+  EXPECT_NE(list->CssFor("www.shop.co.uk").find(".shop-cookies"),
+            std::string::npos);
+  EXPECT_EQ(list->CssFor("shop.example.de").find(".shop-cookies"),
+            std::string::npos);
+}
+
+TEST(CookieListTest, LeavesOutWhatIsNotCss) {
+  auto list = CookieList::Parse(kList);
+  ASSERT_TRUE(list);
+  const std::string css = list->CssFor("example.org");
+  EXPECT_EQ(css.find("never"), std::string::npos);
+  EXPECT_EQ(css.find("has-text"), std::string::npos);
+  EXPECT_EQ(css.find("evil"), std::string::npos);
+  EXPECT_EQ(css.find("abp"), std::string::npos);
+  EXPECT_EQ(css.find("js("), std::string::npos);
+  EXPECT_EQ(css.find("cookie-cdn"), std::string::npos);
+}
+
+TEST(CookieListTest, ElemhideAndGenerichide) {
+  auto list = CookieList::Parse(kList);
+  ASSERT_TRUE(list);
+  EXPECT_EQ(list->CssFor("quiet.com"), "");
+  EXPECT_EQ(list->CssFor("www.quiet.com"), "");
+  EXPECT_EQ(list->CssFor("own.com"), ".own-banner{display:none!important}\n");
+}
+
+TEST(CookieListTest, NothingToHide) {
+  EXPECT_FALSE(CookieList::Parse(""));
+  EXPECT_FALSE(CookieList::Parse("! only\n||a.com^\n"));
+}
+
+}  // namespace
+}  // namespace meridian
