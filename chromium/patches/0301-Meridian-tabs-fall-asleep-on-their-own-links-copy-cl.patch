+
+void SidebarHandler::CopyLinks(const std::vector<std::string>& urls,
+                               CopyLinksCallback callback) {
+  const bool clean =
+      browser_->GetProfile()->GetPrefs()->GetBoolean(prefs::kCleanLinks);
+  std::vector<std::string> out;
+  for (const std::string& url : urls) {
+    GURL gurl(url);
+    out.push_back(clean && gurl.is_valid() ? WithoutTracking(gurl).spec()
+                                           : url);
+  }
+  std::string text = base::JoinString(out, "\n");
+  if (!text.empty()) {
+    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+        .WriteText(base::UTF8ToUTF16(text));
+  }
+  std::move(callback).Run(text);
+}
