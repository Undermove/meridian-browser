+    return;
+  }
+  // The tabs used last stay awake however long ago that was.
+  size_t keep = 5;
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (cl->HasSwitch("meridian-sleep-keep-recent")) {
+    base::StringToSizeT(cl->GetSwitchValueASCII("meridian-sleep-keep-recent"),
+                        &keep);
+  }
+  std::vector<tabs::TabInterface*> tabs;
+  for (int i = 0; i < model()->count(); ++i) {
+    tabs.push_back(model()->GetTabAtIndex(i));
+  }
+  std::sort(tabs.begin(), tabs.end(),
+            [](tabs::TabInterface* a, tabs::TabInterface* b) {
+              return a->GetContents()->GetLastActiveTime() >
+                     b->GetContents()->GetLastActiveTime();
+            });
+  const base::Time cutoff = base::Time::Now() - after;
+  bool slept = false;
+  for (size_t i = keep; i < tabs.size(); ++i) {
+    tabs::TabInterface* tab = tabs[i];
+    content::WebContents* contents = tab->GetContents();
+    if (contents->GetLastActiveTime() >= cutoff || KeptAwake(tab) ||
+        !WhyAwake(tab).empty()) {
+      continue;
+    }
+    auto* unit =
+        resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+            contents);
+    if (unit &&
+        unit->DiscardTab(::mojom::LifecycleUnitDiscardReason::EXTERNAL)) {
+      slept = true;
+    }
+  }
+  if (slept) {
+    ScheduleNotify();
+  }
+}
+
+// A pinned tab whose item is marked "Keep Awake".
+bool SidebarHandler::KeptAwake(tabs::TabInterface* tab) {
+  const TabData* data = TabData::Get(tab->GetContents());
+  if (!data || data->item_id().empty()) {
+    return false;
+  }
+  const Item* item = service_->FindItem(data->item_id());
+  return item && item->keep_awake;
+}
