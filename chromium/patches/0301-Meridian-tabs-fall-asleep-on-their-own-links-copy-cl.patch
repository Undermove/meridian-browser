+++ b/chrome/browser/meridian/cookie_list.cc
@@ -0,0 +1,224 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/cookie_list.h"
+
+#include <utility>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr char kHide[] = "{display:none!important}\n";
+
+// A selector CSS can match on its own, and that can't break out of its rule.
+bool PlainSelector(std::string_view selector) {
+  if (selector.empty() || selector.size() > 1000) {
+    return false;
+  }
+  for (std::string_view bad :
+       {"{", "}", "/*", "<", ":-abp-", ":has-text(", ":contains(", ":style(",
+        ":xpath(", ":matches-css", ":matches-attr(", ":matches-path(",
+        ":upward(", ":remove(", ":watch-attr(", ":min-text-length(",
+        ":others(", ":if(", ":if-not(", ":nth-ancestor(", ":remove-attr(",
+        ":remove-class(", ":matches-media(", ":matches-prop("}) {
+    if (selector.find(bad) != std::string_view::npos) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// "a.com,~b.com": the sites a rule is for, and those it isn't.
+void SplitSites(std::string_view list,
+                std::vector<std::string>* in,
+                std::vector<std::string>* out) {
+  for (std::string_view site : base::SplitStringPiece(
+           list, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (site.front() == '~') {
+      site.remove_prefix(1);
+      if (!site.empty()) {
+        out->push_back(base::ToLowerASCII(site));
+      }
+    } else {
+      in->push_back(base::ToLowerASCII(site));
+    }
+  }
+}
+
+}  // namespace
+
+CookieList::CookieList() = default;
+CookieList::~CookieList() = default;
+
+// static
+std::unique_ptr<CookieList> CookieList::Parse(std::string_view text) {
+  auto list = std::make_unique<CookieList>();
+  std::set<std::string> everywhere_not;
+  std::set<std::string> seen;
+  std::vector<std::string> generic;
+  for (std::string_view line : base::SplitStringPiece(
+           text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (line.front() == '!' || line.front() == '[') {
+      continue;
+    }
+    // "@@||a.com^$elemhide": no hiding there; $generichide: only its own.
+    if (base::StartsWith(line, "@@||")) {
+      const size_t dollar = line.find('$');
+      if (dollar == std::string_view::npos) {
+        continue;
+      }
+      std::string_view site = line.substr(4, dollar - 4);
+      site = site.substr(0, site.find_first_of("^/*"));
+      std::string_view options = line.substr(dollar + 1);
+      if (site.empty()) {
+        continue;
+      }
+      for (std::string_view option : base::SplitStringPiece(
+               options, ",", base::TRIM_WHITESPACE,
+               base::SPLIT_WANT_NONEMPTY)) {
+        if (option == "elemhide" || option == "ehide") {
+          list->no_hiding_.insert(base::ToLowerASCII(site));
+        } else if (option == "generichide" || option == "ghide") {
+          list->no_generic_.insert(base::ToLowerASCII(site));
+        }
+      }
+      continue;
+    }
+    // Extended and scriptlet rules (#?#, #$#, #@?#, #@$#, ##+js) aren't CSS.
+    if (line.find("#?#") != std::string_view::npos ||
+        line.find("#$#") != std::string_view::npos ||
+        line.find("#@?#") != std::string_view::npos ||
+        line.find("#@$#") != std::string_view::npos ||
+        line.find("##+js") != std::string_view::npos ||
+        line.find("##^") != std::string_view::npos) {
+      continue;
+    }
+    if (const size_t at = line.find("#@#"); at != std::string_view::npos) {
+      std::string selector(line.substr(at + 3));
+      std::vector<std::string> in, out;
+      SplitSites(line.substr(0, at), &in, &out);
+      if (in.empty()) {
+        everywhere_not.insert(selector);
+      }
+      for (const std::string& site : in) {
+        list->exceptions_[site].insert(selector);
+      }
+      continue;
+    }
+    const size_t at = line.find("##");
+    if (at == std::string_view::npos) {
+      continue;  // A network rule: the ad blocker's business.
+    }
+    std::string_view selector = line.substr(at + 2);
+    if (!PlainSelector(selector)) {
+      continue;
+    }
+    std::vector<std::string> in, out;
+    SplitSites(line.substr(0, at), &in, &out);
+    for (const std::string& site : out) {
+      list->exceptions_[site].insert(std::string(selector));
+    }
+    if (in.empty()) {
+      if (seen.insert(std::string(selector)).second) {
+        generic.emplace_back(selector);
+      }
+      continue;
+    }
+    for (const std::string& site : in) {
+      list->by_site_[site].emplace_back(selector);
+    }
+  }
+  for (std::string& selector : generic) {
+    if (!everywhere_not.contains(selector)) {
+      list->generic_css_ += selector + kHide;
+      list->generic_.push_back(std::move(selector));
+    }
+  }
+  if (list->generic_.empty() && list->by_site_.empty()) {
+    return nullptr;
+  }
+  return list;
+}
+
+// static
+std::vector<std::string> CookieList::SitesOf(std::string_view host) {
+  std::vector<std::string> sites;
+  std::string h = base::ToLowerASCII(host);
+  if (!h.empty() && h.back() == '.') {
+    h.pop_back();
+  }
+  std::vector<std::string_view> labels = base::SplitStringPiece(
+      h, ".", base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  // "a.*": the same name under any public suffix (a.de, a.co.uk).
+  const size_t registry =
+      net::registry_controlled_domains::GetCanonicalHostRegistry(
+          h, net::registry_controlled_domains::INCLUDE_UNKNOWN_REGISTRIES,
+          net::registry_controlled_domains::EXCLUDE_PRIVATE_REGISTRIES)
+          .value_or(std::string_view())
+          .size();
+  for (size_t i = 0; i < labels.size(); ++i) {
+    std::vector<std::string_view> rest(labels.begin() + i, labels.end());
+    std::string site = base::JoinString(rest, ".");
+    if (registry > 0 && site.size() > registry + 1) {
+      sites.push_back(site.substr(0, site.size() - registry - 1) + ".*");
+    }
+    sites.push_back(std::move(site));
+  }
+  return sites;
+}
+
+bool CookieList::AnyIn(const std::set<std::string>& sites,
+                       const std::vector<std::string>& of) const {
+  for (const std::string& site : of) {
+    if (sites.contains(site)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::string CookieList::CssFor(std::string_view host) const {
+  const std::vector<std::string> sites = SitesOf(host);
+  if (sites.empty() || AnyIn(no_hiding_, sites)) {
+    return std::string();
+  }
+  std::set<std::string> skip;
+  for (const std::string& site : sites) {
+    auto it = exceptions_.find(site);
+    if (it != exceptions_.end()) {
+      skip.insert(it->second.begin(), it->second.end());
+    }
+  }
+  std::string css;
+  if (!AnyIn(no_generic_, sites)) {
+    if (skip.empty()) {
+      css = generic_css_;
+    } else {
+      for (const std::string& selector : generic_) {
+        if (!skip.contains(selector)) {
+          css += selector + kHide;
+        }
+      }
+    }
+  }
+  for (const std::string& site : sites) {
+    auto it = by_site_.find(site);
+    if (it == by_site_.end()) {
+      continue;
+    }
+    for (const std::string& selector : it->second) {
+      if (!skip.contains(selector)) {
+        css += selector + kHide;
+      }
+    }
+  }
+  return css;
+}
+
+}  // namespace meridian
