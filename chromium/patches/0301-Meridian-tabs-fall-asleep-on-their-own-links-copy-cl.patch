+
+#ifndef CHROME_BROWSER_MERIDIAN_COOKIE_BANNERS_H_
+#define CHROME_BROWSER_MERIDIAN_COOKIE_BANNERS_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+class GURL;
+
+namespace network {
+class SimpleURLLoader;
+}
+
+namespace meridian {
+
+class CookieList;
+
+// Hide cookie banners (Settings > Advanced): the EasyList Cookie List
+// (https://easylist.to, by the EasyList authors, CC BY 3.0), downloaded at
+// run time to the user data folder and refreshed every few days. Only its
+// element hiding rules are used (cookie_list.h). Tests give a list of their
+// own with --meridian-cookie-list=<file> (then nothing is downloaded).
+class CookieBanners {
+ public:
+  static CookieBanners& Get();
+
+  CookieBanners(const CookieBanners&) = delete;
+  CookieBanners& operator=(const CookieBanners&) = delete;
+
+  // Loads the list the first time (from disk, else the internet).
+  void Start();
+  // The CSS hiding the notices on `url` ("" before the list is in, or when
+  // nothing applies).
+  std::string CssFor(const GURL& url) const;
+
+ private:
+  friend class base::NoDestructor<CookieBanners>;
+  CookieBanners();
+  ~CookieBanners();
+
+  void OnRead(bool from_switch,
+              std::optional<base::Time> modified,
+              std::unique_ptr<CookieList> list);
+  void MaybeDownload();
+  void OnDownloaded(std::optional<std::string> body);
+
+  bool started_ = false;
+  std::unique_ptr<CookieList> list_;
+  base::Time downloaded_at_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::RepeatingTimer refresh_timer_;
+  base::WeakPtrFactory<CookieBanners> weak_factory_{this};
+};
+
+// Puts the hiding CSS on a tab's pages (every frame) while the setting is on.
+class CookieBannerTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<CookieBannerTabHelper> {
+ public:
+  CookieBannerTabHelper(const CookieBannerTabHelper&) = delete;
+  CookieBannerTabHelper& operator=(const CookieBannerTabHelper&) = delete;
+  ~CookieBannerTabHelper() override;
+
+ private:
+  friend class content::WebContentsUserData<CookieBannerTabHelper>;
+  explicit CookieBannerTabHelper(content::WebContents* contents);
+
+  // content::WebContentsObserver:
+  void PrimaryMainDocumentElementAvailable() override;
+  void DOMContentLoaded(content::RenderFrameHost* frame) override;
+
+  // `changed`: the setting changed (the CSS goes when it's off).
+  void Apply(content::RenderFrameHost* frame, bool changed);
+  void OnPrefChanged();
+
+  PrefChangeRegistrar prefs_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_COOKIE_BANNERS_H_
diff --git a/chrome/browser/meridian/cookie_list.cc b/chrome/browser/meridian/cookie_list.cc
