index 1962df51ca..ddc68409a8 100644
--- a/chrome/browser/meridian/clean_url.cc
+++ b/chrome/browser/meridian/clean_url.cc
@@ -18,14 +18,27 @@ namespace {
 
 bool IsTracking(std::string_view key) {
   static constexpr auto kKeys = base::MakeFixedFlatSet<std::string_view>({
-      "_hsenc", "_hsmi", "dclid", "fbclid", "gbraid", "gclid", "gclsrc",
-      "igsh", "igshid", "mc_cid", "mc_eid", "mkt_tok", "msclkid", "oly_anon_id",
-      "oly_enc_id", "rb_clickid", "s_cid", "twclid", "vero_id", "wbraid",
-      "yclid",
+      "_hsenc", "_hsmi", "dclid", "epik", "fbclid", "gbraid", "gclid",
+      "gclsrc", "igsh", "igshid", "li_fat_id", "mc_cid", "mc_eid", "mkt_tok",
+      "msclkid", "oly_anon_id", "oly_enc_id", "rb_clickid", "s_cid",
+      "srsltid", "ttclid", "twclid", "vero_id", "wbraid", "yclid",
   });
   return base::StartsWith(key, "utm_") || kKeys.contains(key);
 }
 
+// Parameters that track only on their own sites: YouTube's and Spotify's
+// share id ("si" says who shared the link), X's "ref_src"/"ref_url".
+bool IsSiteTracking(const GURL& url, std::string_view key) {
+  if (key == "si") {
+    return url.DomainIs("youtube.com") || url.DomainIs("youtu.be") ||
+           url.DomainIs("spotify.com");
+  }
+  if (key == "ref_src" || key == "ref_url") {
+    return url.DomainIs("twitter.com") || url.DomainIs("x.com");
+  }
+  return false;
+}
+
 }  // namespace
 
