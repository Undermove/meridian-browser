     std::string_view key = it.GetKey();
-    // YouTube's share id ("si") says who shared the link.
-    if (IsTracking(key) ||
-        (key == "si" && (url.DomainIs("youtube.com") ||
-                         url.DomainIs("youtu.be")))) {
+    if (IsTracking(key) || IsSiteTracking(url, key)) {
       removed = true;
       continue;
     }
diff --git a/chrome/browser/meridian/clean_url_unittest.cc b/chrome/browser/meridian/clean_url_unittest.cc
index fbb2f8ce3b..adb4ef0b63 100644
--- a/chrome/browser/meridian/clean_url_unittest.cc
+++ b/chrome/browser/meridian/clean_url_unittest.cc
@@ -29,5 +29,46 @@ TEST(CleanUrlTest, DropsTrackingKeepsTheRest) {
             "chrome://settings/?utm_source=x");
 }
 
+TEST(CleanUrlTest, EveryKnownTracker) {
+  for (const char* key :
+       {"utm_source", "utm_campaign", "utm_content", "fbclid", "gclid",
+        "dclid", "msclkid", "mc_eid", "igshid", "yclid", "_hsenc", "_hsmi",
+        "mkt_tok", "ttclid", "srsltid", "li_fat_id"}) {
+    EXPECT_EQ(Clean((std::string("https://example.com/p?") + key +
+                     "=v&keep=1#frag")
+                        .c_str()),
+              "https://example.com/p?keep=1#frag")
+        << key;
+  }
+}
+
+TEST(CleanUrlTest, SiteOnlyTrackers) {
+  EXPECT_EQ(Clean("https://open.spotify.com/track/abc?si=123"),
+            "https://open.spotify.com/track/abc");
+  EXPECT_EQ(Clean("https://www.youtube.com/watch?v=abc&si=x&t=10s"),
+            "https://www.youtube.com/watch?v=abc&t=10s");
+  EXPECT_EQ(Clean("https://twitter.com/a/status/1?ref_src=twsrc%5Etfw"),
+            "https://twitter.com/a/status/1");
+  EXPECT_EQ(Clean("https://x.com/a/status/1?ref_src=x&ref_url=y&lang=en"),
+            "https://x.com/a/status/1?lang=en");
+  // Elsewhere they may mean something.
+  EXPECT_EQ(Clean("https://example.com/?ref_src=1"),
+            "https://example.com/?ref_src=1");
+}
+
+TEST(CleanUrlTest, LeavesTheRestAlone) {
+  // Nothing to take: the very same URL, its order and encoding.
+  EXPECT_EQ(Clean("https://example.com/?b=2&a=%2F&c"),
+            "https://example.com/?b=2&a=%2F&c");
+  // Only the fragment after a cleaned query.
+  EXPECT_EQ(Clean("https://example.com/?utm_medium=x#a?utm_source=y"),
+            "https://example.com/#a?utm_source=y");
+  // A key that only starts like one.
+  EXPECT_EQ(Clean("https://example.com/?utmost=1&gclidx=2"),
+            "https://example.com/?utmost=1&gclidx=2");
+  EXPECT_EQ(Clean("http://example.com/?UTM_SOURCE=x"),
+            "http://example.com/?UTM_SOURCE=x");
+}
+
 }  // namespace
 }  // namespace meridian
diff --git a/chrome/browser/meridian/cookie_banners.cc b/chrome/browser/meridian/cookie_banners.cc
new file mode 100644
index 0000000000..97a594477c
--- /dev/null
+++ b/chrome/browser/meridian/cookie_banners.cc
@@ -0,0 +1,263 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/cookie_banners.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/meridian/cookie_list.h"
+#include "chrome/browser/meridian/prefs.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "chrome/common/chrome_paths.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/load_flags.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "url/gurl.h"
+
+namespace meridian {
+
+namespace {
+
+// The EasyList Cookie List (https://easylist.to): CC BY 3.0, by the EasyList
+// authors. Its own header says to look again after 9 days at most.
+constexpr char kListUrl[] =
+    "https://secure.fanboy.co.nz/fanboy-cookiemonster.txt";
+constexpr base::TimeDelta kRefreshAfter = base::Days(4);
+constexpr char kFileName[] = "Meridian Cookie List.txt";
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("meridian_cookie_list", R"(
+      semantics {
+        sender: "Meridian cookie banners"
+        description: "The EasyList Cookie List, the rules Meridian hides "
+          "cookie notices on pages with."
+        trigger: "Once the browser has started when the copy on disk is "
+          "missing or older than 4 days."
+        data: "None."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Settings > Advanced > Hide cookie banners."
+        policy_exception_justification: "Not implemented."
+      })");
+
+base::FilePath ListPath(bool* from_switch) {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  *from_switch = cl->HasSwitch("meridian-cookie-list");
+  if (*from_switch) {
+    return cl->GetSwitchValuePath("meridian-cookie-list");
+  }
+  base::FilePath dir;
+  base::PathService::Get(chrome::DIR_USER_DATA, &dir);
+  return dir.AppendASCII(kFileName);
+}
+
+struct Read {
+  std::optional<base::Time> modified;
+  std::unique_ptr<CookieList> list;
+};
+
+Read ReadList(base::FilePath path) {
+  Read read;
+  base::File::Info info;
+  std::string text;
+  if (base::GetFileInfo(path, &info) && !info.is_directory &&
+      base::ReadFileToStringWithMaxSize(path, &text, 16 * 1024 * 1024)) {
+    read.modified = info.last_modified;
+    read.list = CookieList::Parse(text);
+  }
+  return read;
+}
+
+// Puts `css` (a JSON string) in the frame's own style element; "" takes it
+// away.
+constexpr char kApply[] = R"((css) => {
+  let s = document.getElementById('meridian-cookie-banners');
+  if (!css) { s?.remove(); return; }
+  if (!s) {
+    s = document.createElement('style');
+    s.id = 'meridian-cookie-banners';
+  }
+  if (s.textContent !== css) s.textContent = css;
+  if (!s.isConnected) (document.head || document.documentElement)?.appendChild(s);
+})";
+
+}  // namespace
+
+// static
+CookieBanners& CookieBanners::Get() {
+  static base::NoDestructor<CookieBanners> instance;
+  return *instance;
+}
+
+CookieBanners::CookieBanners() = default;
+CookieBanners::~CookieBanners() = default;
+
+void CookieBanners::Start() {
+  if (started_) {
+    return;
+  }
+  started_ = true;
+  bool from_switch = false;
+  base::FilePath path = ListPath(&from_switch);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadList, path),
+      base::BindOnce(
+          [](base::WeakPtr<CookieBanners> self, bool from_switch, Read read) {
+            if (self) {
+              self->OnRead(from_switch, read.modified, std::move(read.list));
+            }
+          },
+          weak_factory_.GetWeakPtr(), from_switch));
+}
+
+void CookieBanners::OnRead(bool from_switch,
+                           std::optional<base::Time> modified,
+                           std::unique_ptr<CookieList> list) {
+  if (list) {
+    list_ = std::move(list);
+  }
+  if (from_switch) {
+    return;  // A test's own list: never the internet.
+  }
+  downloaded_at_ = list_ && modified ? *modified : base::Time();
+  // Out of the way of the first pages, then twice a day to see whether it
+  // has grown old (the browser may stay open for weeks).
+  refresh_timer_.Start(FROM_HERE, base::Hours(12), this,
+                       &CookieBanners::MaybeDownload);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&CookieBanners::MaybeDownload,
+                     weak_factory_.GetWeakPtr()),
+      base::Seconds(20));
+}
+
+void CookieBanners::MaybeDownload() {
+  if (loader_ || !g_browser_process ||
+      !g_browser_process->shared_url_loader_factory() ||
+      base::Time::Now() - downloaded_at_ < kRefreshAfter) {
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(kListUrl);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  loader_ = network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+  loader_->SetTimeoutDuration(base::Seconds(60));
+  loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&CookieBanners::OnDownloaded,
+                     weak_factory_.GetWeakPtr()),
+      16 * 1024 * 1024);
+}
+
+void CookieBanners::OnDownloaded(std::optional<std::string> body) {
+  loader_.reset();
+  if (!body) {
+    return;  // Offline: again in 12 hours.
+  }
+  bool from_switch = false;
+  base::FilePath path = ListPath(&from_switch);
+  // Parsed and saved off the UI thread; only a list with rules in it
+  // replaces the one there is.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](base::FilePath path, std::string body) {
+            std::unique_ptr<CookieList> list = CookieList::Parse(body);
+            if (list) {
+              base::ImportantFileWriter::WriteFileAtomically(path, body);
+            }
+            return list;
+          },
+          path, std::move(*body)),
+      base::BindOnce(
+          [](base::WeakPtr<CookieBanners> self,
+             std::unique_ptr<CookieList> list) {
+            if (self && list) {
+              self->list_ = std::move(list);
+              self->downloaded_at_ = base::Time::Now();
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+std::string CookieBanners::CssFor(const GURL& url) const {
+  if (!list_ || !url.SchemeIsHTTPOrHTTPS()) {
+    return std::string();
+  }
+  return list_->CssFor(url.host());
+}
+
+CookieBannerTabHelper::CookieBannerTabHelper(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<CookieBannerTabHelper>(*contents) {
+  CookieBanners::Get().Start();
+  prefs_.Init(
+      Profile::FromBrowserContext(contents->GetBrowserContext())->GetPrefs());
+  prefs_.Add(prefs::kHideCookieBanners,
+             base::BindRepeating(&CookieBannerTabHelper::OnPrefChanged,
+                                 base::Unretained(this)));
+}
+
+CookieBannerTabHelper::~CookieBannerTabHelper() = default;
+
+void CookieBannerTabHelper::PrimaryMainDocumentElementAvailable() {
+  Apply(web_contents()->GetPrimaryMainFrame(), false);
+}
+
+void CookieBannerTabHelper::DOMContentLoaded(content::RenderFrameHost* frame) {
+  Apply(frame, false);
+}
+
+void CookieBannerTabHelper::OnPrefChanged() {
+  web_contents()->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+      [this](content::RenderFrameHost* frame) { Apply(frame, true); });
+}
+
+void CookieBannerTabHelper::Apply(content::RenderFrameHost* frame,
+                                  bool changed) {
+  if (!frame || !frame->IsRenderFrameLive()) {
+    return;
+  }
+  const GURL& url = frame->GetLastCommittedURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  const bool on = prefs_.prefs()->GetBoolean(prefs::kHideCookieBanners);
+  const std::string css = on ? CookieBanners::Get().CssFor(url) : std::string();
+  if (css.empty() && !changed) {
+    return;  // Nothing to put, nothing put before.
+  }
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(std::string("(") + kApply + ")(" +
+                        base::WriteJson(base::Value(css)).value_or("\"\"") +
+                        ")"),
+      base::NullCallback(), ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(CookieBannerTabHelper);
+
+}  // namespace meridian
