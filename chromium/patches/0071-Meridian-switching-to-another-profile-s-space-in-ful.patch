@@ -303,6 +306,10 @@ void ShowSpaceInProfile(
             Open(target, space_id, urls);
             if (show && target != current) {
               f.visible_of[frame] = target;
+#if BUILDFLAG(IS_MAC)
+              // Where the person is now, not where the window was made.
+              ShowOnActiveSpace(target, true);
+#endif
 #if BUILDFLAG(IS_MAC)
               // In full screen the full-screen window stays put and the
               // others show over it, in its Space: hiding it would close the
diff --git a/chrome/browser/meridian/profile_windows_mac.h b/chrome/browser/meridian/profile_windows_mac.h
index 645119add1..daaca7a151 100644
--- a/chrome/browser/meridian/profile_windows_mac.h
+++ b/chrome/browser/meridian/profile_windows_mac.h
@@ -18,6 +18,10 @@ void SetOverFullscreen(BrowserWindowInterface* browser, bool over);
 // Runs `exited` once, when `browser` has left full screen.
 void OnFullscreenExit(BrowserWindowInterface* browser,
                       base::OnceClosure exited);
+// While `on`, showing `browser` brings it to the Space on screen (a full
+// screen one too) instead of the one it was last on: a profile's window made
+// on the desktop and hidden would otherwise come back there.
+void ShowOnActiveSpace(BrowserWindowInterface* browser, bool on);
 // Shows `target` right behind `front`, without macOS's window animation, so
 // it can paint before `front` goes away (a swap with no blank frame).
 void ShowBehind(BrowserWindowInterface* target, BrowserWindowInterface* front);
diff --git a/chrome/browser/meridian/profile_windows_mac.mm b/chrome/browser/meridian/profile_windows_mac.mm
index 6f4a5472a9..bd43a844d5 100644
--- a/chrome/browser/meridian/profile_windows_mac.mm
+++ b/chrome/browser/meridian/profile_windows_mac.mm
@@ -30,10 +30,20 @@ void SetOverFullscreen(BrowserWindowInterface* browser, bool over) {
   if (!window) {
     return;
   }
+  // Over it, not full screen itself: macOS puts a window that can be
+  // full screen into a full screen Space of its own when its app is in full
+  // screen (that was a "new window" on every switch).
   if (over) {
-    window.collectionBehavior |= NSWindowCollectionBehaviorFullScreenAuxiliary;
+    window.collectionBehavior =
+        (window.collectionBehavior &
+         ~NSWindowCollectionBehaviorFullScreenPrimary) |
+        NSWindowCollectionBehaviorFullScreenAuxiliary;
+    window.tabbingMode = NSWindowTabbingModeDisallowed;
   } else {
-    window.collectionBehavior &= ~NSWindowCollectionBehaviorFullScreenAuxiliary;
+    window.collectionBehavior =
+        (window.collectionBehavior &
+         ~NSWindowCollectionBehaviorFullScreenAuxiliary) |
+        NSWindowCollectionBehaviorFullScreenPrimary;
   }
 }
 
@@ -58,6 +68,22 @@ void OnFullscreenExit(BrowserWindowInterface* browser,
               }];
 }
 
+void ShowOnActiveSpace(BrowserWindowInterface* browser, bool on) {
+  NSWindow* window = WindowOf(browser);
+  if (!window) {
+    return;
+  }
+  // A full-screen window owns its Space.
+  if (on && (window.styleMask & NSWindowStyleMaskFullScreen)) {
+    return;
+  }
+  if (on) {
+    window.collectionBehavior |= NSWindowCollectionBehaviorMoveToActiveSpace;
+  } else {
+    window.collectionBehavior &= ~NSWindowCollectionBehaviorMoveToActiveSpace;
+  }
+}
+
 void ShowBehind(BrowserWindowInterface* target, BrowserWindowInterface* front) {
   NSWindow* window = WindowOf(target);
   NSWindow* over = WindowOf(front);
