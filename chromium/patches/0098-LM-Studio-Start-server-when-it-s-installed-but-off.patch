diff --git a/chrome/browser/meridian/ai/local_agents.cc b/chrome/browser/meridian/ai/local_agents.cc
index 32808744fd..f8fc7da890 100644
--- a/chrome/browser/meridian/ai/local_agents.cc
+++ b/chrome/browser/meridian/ai/local_agents.cc
@@ -132,6 +132,17 @@ std::pair<std::string, std::string> InstallFor(const Provider& p,
   return {std::string(), missing};
 }
 
+// LM Studio's CLI, which starts its server (LM Studio installs it in
+// ~/.lmstudio/bin). Tests set their own or get none.
+std::string LmsPath(const std::string& home) {
+  std::string test = TestSwitchValue("meridian-lms-path");
+  if (!test.empty() || !TestPath().empty()) {
+    return test;
+  }
+  base::FilePath lms = base::FilePath(home).Append(".lmstudio/bin/lms");
+  return base::PathExists(lms) ? lms.value() : std::string();
+}
+
 // Blocking: what's installed and signed in, and how to install the rest.
 std::vector<LocalAgents::Status> ListBlocking() {
   std::map<std::string, std::string> env = ChildEnv();
@@ -145,6 +156,9 @@ std::vector<LocalAgents::Status> ListBlocking() {
     status.id = p.id;
     std::tie(status.install_command, status.install_missing) =
         InstallFor(p, path);
+    if (p.id == "lmstudio") {
+      status.start_with = LmsPath(env["HOME"]);
+    }
     if (p.kind == Kind::kCli) {
       std::string bin = FindBin(p, path);
       status.installed = !bin.empty();
@@ -366,6 +380,15 @@ class LocalAgents::LineStream : public network::SimpleURLLoaderStreamConsumer {
   int status_ = 0;
 };
 
+// static
+bool LocalAgents::StartServerBlocking(const std::string& start_with) {
+  std::map<std::string, std::string> env = ChildEnv();
+  int code = -1;
+  CaptureOutput({start_with, "server", "start"}, env, env["HOME"],
+                base::Seconds(30), &code);
+  return code == 0;
+}
+
 LocalAgents::LocalAgents(Profile* profile)
     : profile_(profile), workdir_(profile->GetPath().Append("Agent Chat")) {}
 
