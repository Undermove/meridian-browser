             weak_factory_.GetWeakPtr(), path, std::move(reply)));
     return;
   }
+  // The project's Claude Code sessions to reopen after a restart. Written
+  // to disk right away: the browser may quit (an update) a moment later.
+  if (method == "claudeSessions" || method == "saveClaudeSessions") {
+    if (!project_) {
+      return std::move(reply).Run(base::Value(base::ListValue()));
+    }
+    std::string root = project_->root().AsUTF8Unsafe();
+    PrefService* prefs = profile_->GetPrefs();
+    if (method == "claudeSessions") {
+      const base::ListValue* list =
+          prefs->GetDict(prefs::kWorkbenchClaudeSessions).FindList(root);
+      return std::move(reply).Run(
+          base::Value(list ? list->Clone() : base::ListValue()));
+    }
+    base::ListValue list;
+    if (params.size() > 0 && params[0].is_list()) {
+      for (const base::Value& v : params[0].GetList()) {
+        const std::string* id = v.is_dict() ? v.GetDict().FindString("id")
+                                            : nullptr;
+        if (!id || !mission::IsSessionId(*id) || list.size() >= 20) {
+          continue;
+        }
+        const std::string* name = v.GetDict().FindString("name");
+        std::string short_name;
+        if (name) {
+          base::TruncateUTF8ToByteSize(*name, 240, &short_name);
+        }
+        list.Append(base::DictValue().Set("id", *id).Set("name", short_name));
+      }
+    }
+    {
+      ScopedDictPrefUpdate update(prefs, prefs::kWorkbenchClaudeSessions);
+      if (list.empty()) {
+        update->Remove(root);
+      } else {
+        update->Set(root, std::move(list));
+      }
+    }
+    prefs->CommitPendingWrite();
+    return std::move(reply).Run(base::Value(true));
+  }
   if (method == "ptyList") {
