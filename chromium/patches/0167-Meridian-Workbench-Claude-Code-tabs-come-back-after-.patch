From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 19 Nov 2026 00:22:28 +0400
Subject: [PATCH 167/297] Meridian: Workbench Claude Code tabs come back after
 a restart

The status line's session id reaches the Workbench; each project's open
Claude sessions (id and a name given by hand) are kept in the profile's
prefs, written at once; ptyCreate takes resumeId for claude --resume <id>.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../meridian/mission/mission_control.cc       | 18 ++++++
 .../meridian/mission/mission_control.h        |  5 ++
 chrome/browser/meridian/prefs.cc              |  1 +
 chrome/browser/meridian/prefs.h               |  4 ++
 .../meridian/workbench/workbench_handler.cc   | 60 ++++++++++++++++++-
 5 files changed, 85 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/meridian/mission/mission_control.cc b/chrome/browser/meridian/mission/mission_control.cc
index d1554f8c9d..499a80fdd1 100644
--- a/chrome/browser/meridian/mission/mission_control.cc
+++ b/chrome/browser/meridian/mission/mission_control.cc
@@ -15,6 +15,7 @@
 #include "base/json/json_writer.h"
 #include "base/rand_util.h"
 #include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
 #include "base/strings/utf_string_conversions.h"
 #include "base/task/thread_pool.h"
 #include "chrome/browser/meridian/mission/event_channel.h"
@@ -134,6 +135,18 @@ base::Value OptString(const std::string& s) {
 
 }  // namespace
 
+bool IsSessionId(std::string_view id) {
+  if (id.empty() || id.size() > 80) {
+    return false;
+  }
+  for (char c : id) {
+    if (!base::IsAsciiAlphaNumeric(c) && c != '-' && c != '_') {
+      return false;
+    }
+  }
+  return true;
+}
+
 MissionControl::Node::Node() = default;
 MissionControl::Node::Node(const Node&) = default;
 MissionControl::Node& MissionControl::Node::operator=(const Node&) = default;
@@ -478,6 +491,11 @@ void MissionControl::OnHookEvent(const std::string& node_id,
     if (!name.empty()) {
       usage.Set("session_name", name);
     }
+    // The session's id, so the Workbench can resume it after a restart.
+    if (const std::string* sid = raw.FindString("session_id");
+        sid && IsSessionId(*sid)) {
+      usage.Set("session_id", *sid);
+    }
     if (!model.empty()) {
       usage.Set("model", model);
     }
