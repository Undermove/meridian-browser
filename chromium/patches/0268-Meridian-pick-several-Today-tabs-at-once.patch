+  // The menu for several picked tabs: everything acts on all of them.
+  private selectionMenu_(group: NodeId[], space: Space): MenuEntry[] {
+    const n = group.length;
+    const done = () => this.clearSelection();
+    const pinAt = (container: string, parentId: string, index: number) => {
+      group.forEach((id, i) => this.handler_.pinTab(
+          id, {container, parentId, index: index < 0 ? -1 : index + i},
+          this.customTitle_(id)));
+      done();
+    };
+    const folders: MenuEntry[] = [];
+    const walk = (items: Item[], depth: number) => {
+      for (const it of items) {
+        if (it.isFolder) {
+          folders.push({label: '\u2003'.repeat(depth) + (it.title || 'Folder'),
+                        icon: 'folder',
+                        action: () => pinAt(space.id, it.id, -1)});
+          walk(it.children, depth + 1);
+        }
+      }
+    };
+    walk(space.pinned, 0);
+    folders.push({
+      label: 'New Folder',
+      icon: 'plus',
+      separatorBefore: folders.length > 0,
+      action: async () => {
+        const {itemId} = await this.handler_.addFolder(
+            {container: space.id, parentId: '', index: 0}, 'New Folder');
+        if (itemId) {
+          pinAt(space.id, itemId, 0);
+          this.renaming_ = itemId;
+        }
+      },
+    });
+    const move = this.moveToSpaceMenu_(id => {
+      group.forEach(t => this.handler_.moveTabToSpace(t, id));
+      done();
+    });
+    return [
+      {label: `${n} Tabs`, header: true},
+      {
+        label: 'Copy Links',
+        icon: 'link',
+        action: () => {
+          navigator.clipboard.writeText(
+              group.map(id => this.tabs_.get(id)?.url || '').join('\n'));
+          done();
+        },
+      },
+      {
+        label: 'Add to Favorites',
+        icon: 'star',
+        separatorBefore: true,
+        action: () => pinAt(FAVORITES, '', -1),
+      },
+      {label: `Pin ${n} Tabs`, icon: 'pin',
+       action: () => pinAt(space.id, '', -1)},
+      {label: 'Add to Folder', icon: 'folder', submenu: folders},
+      {label: 'Move to Space', icon: 'moveTo', enabled: move.length > 0,
+       submenu: move},
+      // Closed Today tabs go to the Archive, as in Arc.
+      {
+        label: `Archive ${n} Tabs`,
+        icon: 'archive',
+        separatorBefore: true,
+        action: () => {
+          this.tabStripService_.closeNodes(group);
+          done();
+        },
+      },
+      {
+        label: `Close ${n} Tabs`,
+        icon: 'x',
+        danger: true,
+        action: () => {
+          this.tabStripService_.closeNodes(group);
+          done();
+        },
+      },
+    ];
+  }
+
   // Mute Tab / Unmute Tab, for a tab that plays sound or is muted.
   private muteMenu_(tab: Tab): MenuEntry[] {
     const alerts = tab.alertStates || [];
