+  // ⌘-click adds or takes away one tab (the open one joins the first
+  // time, as in Arc); ⇧-click picks every Today tab from the last one picked.
+  private extendSelection_(id: NodeId, range: boolean) {
+    const order = this.today_.map(t => t.id);
+    const active = this.today_.find(t => t.isActive)?.id;
+    let sel = [...this.selected_];
+    if (!sel.length && active && active !== id) {
+      sel.push(active);
+      this.selAnchor_ = active;
+    }
+    if (range) {
+      const from = order.indexOf(this.selAnchor_ ?? active ?? id);
+      const to = order.indexOf(id);
+      if (from >= 0 && to >= 0) {
+        const [a, b] = from < to ? [from, to] : [to, from];
+        sel = [...new Set([...sel, ...order.slice(a, b + 1)])];
+      } else {
+        sel.push(id);
+      }
+    } else {
+      sel = sel.includes(id) ? sel.filter(x => x !== id) : [...sel, id];
+      this.selAnchor_ = id;
+    }
+    // Top to bottom, as Today shows them.
+    this.selected_ = order.filter(x => sel.includes(x));
+  }
+
+  clearSelection() {
+    if (this.selected_.length) {
+      this.selected_ = [];
+    }
+    this.selAnchor_ = null;
+  }
+
+  selectedTabs(): NodeId[] {
+    return this.selected_;
+  }
+
+  // The tabs a drag or a menu acts on: the group when `id` is in it.
+  private groupOf_(id: NodeId): NodeId[] {
+    return this.selected_.length > 1 && this.selected_.includes(id) ?
+        this.selected_.filter(x => this.tabs_.has(x)) :
+        [id];
+  }
+
+  private onSelectionKeydown_ = (e: KeyboardEvent) => {
+    if (e.key === 'Escape' && this.selected_.length && !this.menu_) {
+      this.clearSelection();
+    }
+  };
