+
+// A secret file as the opt-out list keeps it: relative to the project's root
+// when inside it, else its absolute path.
+std::string OptOutPath(const std::string& root, const std::string& abs) {
+  base::FilePath rel;
+  return base::FilePath::FromUTF8Unsafe(root).AppendRelativePath(
+             base::FilePath::FromUTF8Unsafe(abs), &rel)
+             ? SlashPath(rel)
+             : abs;
+}
+
+// The person chose not to be asked about each of `paths` in this project.
+bool AllOptedOut(PrefService* prefs,
+                 const std::string& root,
+                 const std::vector<std::string>& paths) {
+  if (paths.empty() || root.empty()) {
+    return false;
+  }
+  const base::ListValue& list = prefs->GetList(prefs::kWorkbenchSecretOptOuts);
+  return std::ranges::all_of(paths, [&](const std::string& abs) {
+    std::string path = OptOutPath(root, abs);
+    return std::ranges::any_of(list, [&](const base::Value& v) {
+      const base::DictValue* d = v.GetIfDict();
+      const std::string* project = d ? d->FindString("project") : nullptr;
+      const std::string* p = d ? d->FindString("path") : nullptr;
+      return project && p && *project == root && *p == path;
+    });
+  });
+}
+
+void AddOptOuts(PrefService* prefs,
+                const std::string& root,
+                const std::vector<std::string>& paths) {
+  if (root.empty() || AllOptedOut(prefs, root, paths)) {
+    return;
+  }
+  ScopedListPrefUpdate update(prefs, prefs::kWorkbenchSecretOptOuts);
+  for (const std::string& abs : paths) {
+    if (AllOptedOut(prefs, root, {abs})) {
+      continue;
+    }
+    update->Append(base::DictValue()
+                       .Set("project", root)
+                       .Set("path", OptOutPath(root, abs))
+                       .Set("added", base::Time::Now()
+                                         .InMillisecondsFSinceUnixEpoch()));
+  }
+}
