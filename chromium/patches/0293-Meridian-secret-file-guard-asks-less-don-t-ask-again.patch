+// A command that only loads a secret file into the environment is a hit
+// (Meridian notes it) that isn't held; a name the file defines, echoed,
+// makes it a read again.
+TEST(GuardHookTest, LoadingIntoTheEnvironmentIsNotHeld) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::FilePath root = RealFilePath(dir.GetPath());
+  ASSERT_TRUE(base::WriteFile(root.AppendASCII(".env.local"),
+                              "KAITEN_TOKEN=abc\nKAITEN_HOST=x.kaiten.ru\n"));
+  std::string cwd = "\"cwd\": \"" +
+                    root.NormalizePathSeparatorsTo('/').AsUTF8Unsafe() + "\"";
+  auto bash = [&](const std::string& command) {
+    return CheckToolCall(
+        base::JSONReader::Read("{\"tool_name\": \"Bash\", " + cwd +
+                                   ", \"tool_input\": {\"command\": \"" +
+                                   command + "\"}}",
+                               0)
+            ->GetDict());
+  };
+  std::optional<GuardHit> hit =
+      bash("set -a; source .env.local 2>/dev/null; set +a; curl -H "
+           "\\\"Authorization: Bearer $KAITEN_TOKEN\\\" https://x/api");
+  ASSERT_TRUE(hit);
+  EXPECT_TRUE(hit->only_loaded);
+  ASSERT_EQ(hit->paths.size(), 1u);
+  EXPECT_EQ(hit->paths[0], root.AppendASCII(".env.local").AsUTF8Unsafe());
+  hit = bash("source .env.local; echo $KAITEN_HOST");
+  ASSERT_TRUE(hit);
+  EXPECT_FALSE(hit->only_loaded);
+  hit = bash("source .env.local && env");
+  ASSERT_TRUE(hit);
+  EXPECT_FALSE(hit->only_loaded);
+  hit = bash("cat .env.local");
+  ASSERT_TRUE(hit);
+  EXPECT_FALSE(hit->only_loaded);
+  hit = bash("docker run --env-file .env.local image");
+  ASSERT_TRUE(hit);
+  EXPECT_TRUE(hit->only_loaded);
+}
+
 }  // namespace
 }  // namespace meridian::workbench
