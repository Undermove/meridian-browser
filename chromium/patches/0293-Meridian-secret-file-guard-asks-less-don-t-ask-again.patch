+void MissionControl::NoteSecretsLoaded(int owner_tab,
+                                       const std::string& term_id,
+                                       const std::string& agent_id,
+                                       const std::vector<std::string>& files) {
+  Node* row = nullptr;
+  for (auto& [id, n] : nodes_) {
+    if (n.kind == "session" && n.owner_tab == owner_tab &&
+        n.term_id == term_id && !n.ended_at) {
+      row = &n;
+    }
+  }
+  if (!row || files.empty()) {
+    return;
+  }
+  if (!agent_id.empty()) {
+    const std::string root = row->root_id.empty() ? row->id : row->root_id;
+    if (Node* sub = FindChild(root, [&](const Node& n) {
+          return n.agent_id == agent_id && !n.ended_at;
+        })) {
+      row = sub;
+    }
+  }
+  std::vector<std::string> names;
+  for (const std::string& f : files) {
+    names.push_back(f.substr(0, 200));
+  }
+  Log(*row, "env-" + RandomId(6), "Environment",
+      "Loaded " + base::JoinString(names, ", ") + " into the environment",
+      true);
+  Changed();
+}
