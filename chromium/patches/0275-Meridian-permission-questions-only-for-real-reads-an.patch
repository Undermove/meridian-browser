+    }
+    while (i_ < s_.size() && (s_[i_] == ' ' || s_[i_] == '\t')) {
+      ++i_;
+    }
+    std::string delimiter;
+    while (i_ < s_.size()) {
+      char c = s_[i_];
+      if (c == '\'' || c == '"') {
+        size_t end = s_.find(c, i_ + 1);
+        end = end == std::string_view::npos ? s_.size() : end;
+        delimiter += s_.substr(i_ + 1, end - i_ - 1);
+        i_ = end + 1;
+      } else if (c == '\\') {
+        ++i_;
+      } else if (base::IsAsciiAlphaNumeric(c) || c == '_' || c == '-' ||
+                 c == '.' || c == '!' || c == '+' || c == '@' || c == '%') {
+        delimiter += c;
+        ++i_;
+      } else {
+        break;
+      }
+    }
+    if (!delimiter.empty()) {
+      heredocs_.push_back({delimiter, strip_tabs});
+    }
+  }
+
+  // At the start of a line: drops the pending heredocs' bodies, each up to
+  // its delimiter line (or the end).
+  void SkipHeredocBodies() {
+    for (const auto& [delimiter, strip_tabs] : heredocs_) {
+      while (i_ < s_.size()) {
+        size_t end = s_.find('\n', i_);
+        end = end == std::string_view::npos ? s_.size() : end;
+        std::string_view line = s_.substr(i_, end - i_);
+        i_ = std::min(end + 1, s_.size());
+        if (line.ends_with('\r')) {
+          line.remove_suffix(1);
+        }
+        std::string_view trimmed = base::TrimWhitespaceASCII(
+            line, strip_tabs ? base::TRIM_ALL : base::TRIM_TRAILING);
+        if (trimmed == delimiter || (!strip_tabs && base::TrimWhitespaceASCII(
+                                                        line, base::TRIM_ALL) ==
+                                                        delimiter)) {
+          break;
+        }
+      }
+    }
+    heredocs_.clear();
+  }
+
+  std::string_view s_;
+  int depth_;
+  size_t i_ = 0;
+  std::string word_;
+  bool in_word_ = false;
+  Next next_ = Next::kWord;
+  SimpleCommand current_;
+  std::vector<SimpleCommand> commands_;
+  std::vector<std::pair<std::string, bool>> heredocs_;
+  std::vector<std::string> nested_;
+};
