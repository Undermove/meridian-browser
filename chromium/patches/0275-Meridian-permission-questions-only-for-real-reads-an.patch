+void MissionControl::CheckSubagentTranscripts() {
+  // (node id, its transcript) of quiet live subagents.
+  std::vector<std::pair<std::string, base::FilePath>> quiet;
+  double t = Now();
+  for (auto& [id, n] : nodes_) {
+    if (n.kind != "subagent" || n.ended_at || n.agent_id.empty() ||
+        !RE2::FullMatch(n.agent_id, "[\\w-]{1,80}") ||
+        t - n.last_event_at < kSubagentQuietMs ||
+        t - n.transcript_checked_at < kTranscriptRecheckMs) {
+      continue;
+    }
+    const Node* root = nullptr;
+    if (auto it = nodes_.find(n.root_id); it != nodes_.end()) {
+      root = &it->second;
+    }
+    if (!root || root->transcript.empty() || !root->transcript.ends_with(".jsonl")) {
+      continue;
+    }
+    n.transcript_checked_at = t;
+    // <session>.jsonl -> <session>/subagents/agent-<id>.jsonl
+    std::string dir = root->transcript.substr(0, root->transcript.size() - 6);
+    quiet.emplace_back(id, base::FilePath::FromUTF8Unsafe(dir)
+                               .AppendASCII("subagents")
+                               .AppendASCII("agent-" + n.agent_id + ".jsonl"));
+  }
+  if (quiet.empty()) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](std::vector<std::pair<std::string, base::FilePath>> quiet) {
+            std::vector<std::pair<std::string, std::string>> ended;
+            for (const auto& [id, path] : quiet) {
+              std::string how = TranscriptEnding(path);
+              if (!how.empty()) {
+                ended.emplace_back(id, how);
+              }
+            }
+            return ended;
+          },
+          std::move(quiet)),
+      base::BindOnce(&MissionControl::OnSubagentTranscripts,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void MissionControl::OnSubagentTranscripts(
+    std::vector<std::pair<std::string, std::string>> ended) {
+  double t = Now();
+  for (const auto& [id, how] : ended) {
+    Node* n = Get(id);
+    // Nothing came from it since the check started.
+    if (n && !n->ended_at && t - n->last_event_at >= kSubagentQuietMs &&
+        n->status != "waiting") {
+      Finish(*n, "done", how);
+    }
+  }
+}
