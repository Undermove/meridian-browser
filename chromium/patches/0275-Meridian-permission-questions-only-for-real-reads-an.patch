+// How a subagent's transcript ends: "Done" (its final answer), "Stopped"
+// (interrupted or stopped by its parent), or "" (still at work, unknown).
+std::string TranscriptEnding(const base::FilePath& path) {
+  std::optional<int64_t> size = base::GetFileSize(path);
+  if (!size || *size <= 0) {
+    return std::string();
+  }
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return std::string();
+  }
+  int64_t want = std::min<int64_t>(*size, 256 * 1024);
+  std::vector<uint8_t> buf(static_cast<size_t>(want));
+  if (!file.ReadAndCheck(*size - want, buf)) {
+    return std::string();
+  }
+  std::string_view text = base::as_string_view(buf);
+  text = base::TrimWhitespaceASCII(text, base::TRIM_TRAILING);
+  size_t nl = text.rfind('\n');
+  std::string_view last = nl == std::string_view::npos ? text : text.substr(nl + 1);
+  std::optional<base::Value> v = base::JSONReader::Read(last, 0);
+  if (!v || !v->is_dict()) {
+    return std::string();
+  }
+  const std::string* type = v->GetDict().FindString("type");
+  const base::DictValue* message = v->GetDict().FindDict("message");
+  if (!type || !message) {
+    return std::string();
+  }
+  if (*type == "assistant") {
+    const std::string* stop = message->FindString("stop_reason");
+    return stop && *stop == "end_turn" ? "Done" : std::string();
+  }
+  if (*type == "user") {
+    if (const base::ListValue* content = message->FindList("content")) {
+      for (const base::Value& c : *content) {
+        const std::string* t =
+            c.is_dict() ? c.GetDict().FindString("text") : nullptr;
+        if (t && t->starts_with("[Request interrupted")) {
+          return "Stopped";
+        }
+      }
+    }
+  }
+  return std::string();
+}
 
