+std::string ProgramName(const std::string& word) {
+  return base::ToLowerASCII(BaseName(word));
+}
+
+// Programs whose file arguments are read (shown, searched, copied, sent or
+// loaded into the environment).
+bool ReadsFileArgs(const std::string& p) {
+  static const base::NoDestructor<std::set<std::string>> readers(
+      std::set<std::string>{
+          "cat", "tac", "nl", "less", "more", "most", "head", "tail", "bat",
+          "batcat", "view", "source", ".", "strings", "od", "xxd", "hexdump",
+          "base64", "base32", "openssl", "ssh-add", "ssh-keygen", "gpg",
+          "grep", "egrep", "fgrep", "zgrep", "rg", "ag", "ack", "awk", "gawk",
+          "sed", "cut", "sort", "uniq", "paste", "column", "fold", "jq", "yq",
+          "diff", "cmp", "comm", "sdiff", "dotenv", "dotenvx",
+          "direnv", "env-cmd", "curl", "wget", "http", "nc", "tar", "zip",
+          "7z", "gzip", "bzip2", "xz", "pbcopy", "xclip", "md5", "md5sum",
+          "sha1sum", "sha256sum", "shasum",
+          // PowerShell / cmd.
+          "get-content", "gc", "type", "select-string", "sls",
+          "copy-item"});
+  return readers->contains(p);
+}
+
+// Copies: the last argument is where it goes.
+bool CopiesFiles(const std::string& p) {
+  return p == "cp" || p == "scp" || p == "rsync" || p == "install" ||
+         p == "ditto";
+}
+
+bool IsInterpreter(const std::string& p) {
+  return RE2::FullMatch(p, "(python[0-9.]*|node|nodejs|bun|deno|ruby|perl|"
+                           "php|osascript|pwsh|powershell)");
+}
+
+bool IsShell(const std::string& p) {
+  return p == "sh" || p == "bash" || p == "zsh" || p == "dash" || p == "ksh" ||
+         p == "fish";
+}
+
+// Code given to an interpreter (`python -c`, `node -e`) that opens a secret
+// file: a read call and a secret file's name in it.
+void CodeReadsSecret(const std::string& code, std::vector<std::string>& out) {
+  static const base::NoDestructor<RE2> read_call(
+      "(?i)open\\s*\\(|read_?file|readFileSync|read_text|read_bytes|"
+      "load_dotenv|dotenv|File\\.read|IO\\.read|fopen|file_get_contents|"
+      "Get-Content|createReadStream|Deno\\.read|Bun\\.file|\\bcat\\b");
+  if (!RE2::PartialMatch(code, *read_call)) {
+    return;
+  }
+  static const base::NoDestructor<RE2> name(
+      "([\\w./~@-]*(?:\\.env(?:\\.[\\w-]+)?|\\.envrc|credentials(?:\\.json)?|"
+      "\\.pem|id_(?:rsa|dsa|ecdsa|ed25519)|\\.npmrc|\\.netrc|"
+      "\\.git-credentials))(?:$|[^\\w.-])");
+  std::string_view input(code);
+  std::string match;
+  while (RE2::FindAndConsume(&input, *name, &match)) {
+    if (WordIsSecretFile(match)) {
+      out.push_back(match);
+    }
+  }
+}
+
+void CheckCommand(const SimpleCommand& cmd,
+                  int depth,
+                  std::vector<std::string>& out) {
+  for (const std::string& in : cmd.inputs) {
+    if (WordIsSecretFile(in)) {
+      out.push_back(in);
+    }
+  }
+  const std::vector<std::string>& w = cmd.words;
+  size_t k = 0;
+  // Variables set for the command, wrappers that run the next word.
+  // `--env-file` loads a file into the environment, whatever the program.
+  for (size_t j = 0; j < w.size(); ++j) {
+    if (w[j].starts_with("--env-file=") &&
+        WordIsSecretFile(w[j].substr(11))) {
+      out.push_back(w[j].substr(11));
+    } else if (w[j] == "--env-file" && j + 1 < w.size() &&
+               WordIsSecretFile(w[j + 1])) {
+      out.push_back(w[j + 1]);
+    }
+  }
+  while (k < w.size()) {
+    const std::string p = ProgramName(w[k]);
+    if (RE2::FullMatch(w[k], "[A-Za-z_][A-Za-z0-9_]*=.*")) {
+      ++k;
+    } else if (p == "sudo" || p == "env" || p == "command" || p == "exec" ||
+               p == "time" || p == "nice" || p == "nohup" || p == "xargs" ||
+               p == "npx" || p == "bunx" || p == "builtin" || p == "doas") {
+      ++k;
+      while (k < w.size() && w[k].starts_with("-")) {
+        ++k;
+      }
+    } else if (p == "timeout" && k + 1 < w.size()) {
+      k += 2;
+    } else {
+      break;
+    }
+  }
+  if (k >= w.size()) {
+    return;
+  }
+  const std::string program = ProgramName(w[k]);
+  std::vector<std::string> args(w.begin() + k + 1, w.end());
+  if (IsShell(program) || IsInterpreter(program)) {
+    for (size_t j = 0; j < args.size(); ++j) {
+      const std::string& a = args[j];
+      bool code_flag = a == "-c" || a == "-e" || a == "--eval" || a == "-p" ||
+                       a == "--print" || a == "-E" || a == "-r" ||
+                       a == "-Command" || a == "-command";
+      if (code_flag && j + 1 < args.size()) {
+        if (IsShell(program) && depth < 4) {
+          for (std::string& f : SecretFilesIn(args[j + 1], depth + 1)) {
+            out.push_back(std::move(f));
+          }
+        } else {
+          CodeReadsSecret(args[j + 1], out);
+        }
+        return;
+      }
+      if (!a.starts_with("-")) {
+        // The script it runs (`bash .envrc`).
+        if (IsShell(program) && WordIsSecretFile(a)) {
+          out.push_back(a);
+        }
+        return;
+      }
+    }
+    return;
+  }
+  if (program == "git") {
+    // Commands that print a file's contents.
+    static const base::NoDestructor<std::set<std::string>> printing(
+        std::set<std::string>{"show", "diff", "blame", "grep", "cat-file",
+                              "log", "archive", "annotate"});
+    if (args.empty() || !printing->contains(args[0])) {
+      return;
+    }
+  } else if (CopiesFiles(program)) {
+    std::vector<std::string> sources;
+    for (const std::string& a : args) {
+      if (!a.starts_with("-")) {
+        sources.push_back(a);
+      }
+    }
+    if (!sources.empty()) {
+      sources.pop_back();
+    }
+    for (const std::string& a : sources) {
+      if (WordIsSecretFile(a)) {
+        out.push_back(a);
+      }
+    }
+    return;
+  } else if (!ReadsFileArgs(program)) {
+    return;
+  }
+  // The first argument of a search or an editing script is its pattern or
+  // program (`grep credentials src/`), unless given with -e.
+  static const base::NoDestructor<RE2> pattern_first(
+      "e?grep|fgrep|zgrep|rg|ag|ack|awk|gawk|sed|jq|yq|select-string|sls");
+  bool skip_pattern = RE2::FullMatch(program, *pattern_first);
+  for (size_t j = 0; j < args.size(); ++j) {
+    const std::string& a = args[j];
+    if (skip_pattern && (a == "-e" || a == "--regexp" || a == "-Pattern" ||
+                         a == "-pattern" || a == "--expression")) {
+      skip_pattern = false;
+      ++j;
       continue;
     }
-    return true;
+    if (skip_pattern && !a.starts_with("-")) {
+      skip_pattern = false;
+      continue;
+    }
+    // -fkey.pem, --file=.env: the value after the flag.
+    std::string v = a;
+    if (v.starts_with("-")) {
+      size_t eq = v.find('=');
+      if (eq == std::string::npos) {
+        continue;
+      }
+      v = v.substr(eq + 1);
+    }
+    if (WordIsSecretFile(v)) {
+      out.push_back(v);
+    }
+  }
+}
+
+std::vector<std::string> SecretFilesIn(std::string_view command, int depth) {
+  ShellReader reader(command, depth);
+  std::vector<SimpleCommand> commands = reader.Read();
+  std::vector<std::string> out = std::move(reader.nested());
+  for (const SimpleCommand& c : commands) {
+    CheckCommand(c, depth, out);
+  }
+  return out;
+}
