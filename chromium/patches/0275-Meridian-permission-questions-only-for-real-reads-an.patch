+std::vector<std::string> SecretFilesReadBy(const std::string& command) {
+  std::vector<std::string> found = SecretFilesIn(command, 0);
+  std::vector<std::string> out;
+  for (std::string& word : found) {
+    std::string f = FileOfWord(word);
+    if (std::ranges::find(out, f) == out.end()) {
+      out.push_back(std::move(f));
+    }
   }
-  return false;
+  return out;
+}
+
+bool CommandNamesSecretFile(const std::string& command) {
+  return !SecretFilesReadBy(command).empty();
 }
 
