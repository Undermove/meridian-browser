+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/ai/accounts.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::ai {
+namespace {
+
+class AccountsTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    home_ = base::MakeAbsoluteFilePath(dir_.GetPath());
+  }
+  // A config folder with a file of that name (never read).
+  base::FilePath Make(const std::string& path, const std::string& marker) {
+    base::FilePath p = home_.AppendASCII(path);
+    base::CreateDirectory(p);
+    base::WriteFile(p.AppendASCII(marker), "");
+    return p;
+  }
+  std::vector<Account> Of(const std::vector<Account>& all,
+                          const std::string& vendor) {
+    std::vector<Account> out;
+    for (const Account& a : all) {
+      if (a.vendor == vendor) {
+        out.push_back(a);
+      }
+    }
+    return out;
+  }
+  base::ScopedTempDir dir_;
+  base::FilePath home_;
+};
+
+TEST_F(AccountsTest, FindsDefaultAndSiblingsByNamesOnly) {
+  Make(".claude", "settings.json");
+  Make(".claude-work", "projects");
+  // A folder named like one but without anything Claude Code keeps: no.
+  base::CreateDirectory(home_.AppendASCII(".claude-empty"));
+  Make(".codex", "config.toml");
+  Make(".gemini-home/.gemini", "settings.json");
+  std::vector<Account> all = ListAccounts(home_, {}, base::DictValue());
+  std::vector<Account> claude = Of(all, "claude");
+  ASSERT_EQ(claude.size(), 2u);
+  EXPECT_EQ(claude[0].label, "Default");
+  EXPECT_TRUE(claude[0].is_default);
+  EXPECT_EQ(claude[1].label, "Work");
+  EXPECT_FALSE(claude[1].is_default);
+  EXPECT_EQ(Of(all, "codex").size(), 1u);
+  std::vector<Account> gemini = Of(all, "gemini");
+  // The default (the home itself) has no .gemini: still listed, as what runs
+  // when a space doesn't say.
+  ASSERT_EQ(gemini.size(), 2u);
+  EXPECT_TRUE(gemini[0].is_default);
+  EXPECT_FALSE(gemini[0].found);
+  EXPECT_EQ(gemini[1].label, "Home");
+}
+
+TEST_F(AccountsTest, LoginEnvironmentNamesTheDefault) {
+  Make(".claude", "settings.json");
+  base::FilePath personal = Make(".claude-personal", "settings.json");
+  std::vector<Account> claude = Of(
+      ListAccounts(home_, {{"CLAUDE_CONFIG_DIR", personal.AsUTF8Unsafe()}},
+                   base::DictValue()),
+      "claude");
+  ASSERT_EQ(claude.size(), 2u);
+  EXPECT_EQ(claude[0].label, "Personal");
+  EXPECT_TRUE(claude[0].is_default);
+  EXPECT_EQ(claude[1].label, "Default");
+}
+
+TEST_F(AccountsTest, SavedLabelsAddedAndHidden) {
+  Make(".claude", "settings.json");
+  base::FilePath work = Make(".claude-work", "settings.json");
+  base::FilePath client = home_.AppendASCII("acme/claude");
+  base::DictValue saved;
+  base::ListValue list;
+  list.Append(base::DictValue()
+                  .Set("dir", work.AsUTF8Unsafe())
+                  .Set("hidden", true));
+  list.Append(base::DictValue()
+                  .Set("dir", client.AsUTF8Unsafe())
+                  .Set("label", "Acme"));
+  saved.Set("claude", std::move(list));
+  std::vector<Account> claude =
+      Of(ListAccounts(home_, {}, saved), "claude");
+  ASSERT_EQ(claude.size(), 2u);
+  EXPECT_EQ(claude[1].label, "Acme");
+  EXPECT_TRUE(claude[1].saved);
+  EXPECT_FALSE(claude[1].found);
+  EXPECT_EQ(claude[1].id, AccountId(client));
+}
+
+TEST_F(AccountsTest, EnvSetsTheVariableOrTakesItAway) {
+  const AccountVendor& claude = *FindAccountVendor("claude");
+  auto env = AccountEnv(claude, home_, home_.AppendASCII(".claude-work"));
+  EXPECT_EQ(env["CLAUDE_CONFIG_DIR"],
+            home_.AppendASCII(".claude-work").AsUTF8Unsafe());
+  // Its own folder: the variable goes (the Keychain entry is keyed by it).
+  env = AccountEnv(claude, home_, home_.AppendASCII(".claude"));
+  ASSERT_TRUE(env.contains("CLAUDE_CONFIG_DIR"));
+  std::map<std::string, std::string> run = {{"CLAUDE_CONFIG_DIR", "/x"},
+                                            {"PATH", "/bin"}};
+  ApplyAccountEnv(env, run);
+  EXPECT_FALSE(run.contains("CLAUDE_CONFIG_DIR"));
+  EXPECT_EQ(run["PATH"], "/bin");
+  const AccountVendor& gemini = *FindAccountVendor("gemini");
+  env = AccountEnv(gemini, home_, home_.AppendASCII(".gemini-work"));
+  EXPECT_EQ(env["GEMINI_CLI_HOME"],
+            home_.AppendASCII(".gemini-work").AsUTF8Unsafe());
+  EXPECT_EQ(AccountLoginCommand(claude, home_,
+                                base::FilePath("/Users/me/.claude-o'k")),
+            "CLAUDE_CONFIG_DIR='/Users/me/.claude-o'\\''k' claude");
+  EXPECT_EQ(AccountLoginCommand(claude, home_, home_.AppendASCII(".claude")),
+            "env -u CLAUDE_CONFIG_DIR claude");
+}
+
+TEST_F(AccountsTest, NewAccountDirFromANameOrAFolder) {
+  const AccountVendor& codex = *FindAccountVendor("codex");
+  std::string error;
+  EXPECT_EQ(NewAccountDir(codex, home_, " My Work ", &error),
+            home_.AppendASCII(".codex-my-work"));
+  EXPECT_EQ(NewAccountDir(codex, home_, "~/plans/codex/", &error),
+            home_.AppendASCII("plans/codex"));
+  EXPECT_FALSE(NewAccountDir(codex, home_, "/etc/codex", &error));
+  EXPECT_FALSE(NewAccountDir(codex, home_, "~/../x", &error));
+  EXPECT_FALSE(NewAccountDir(codex, home_, "", &error));
+  EXPECT_FALSE(NewAccountDir(codex, home_, "!!!", &error));
+}
+
+TEST_F(AccountsTest, SuggestsBySpaceNames) {
+  Make(".claude", "settings.json");
+  Make(".claude-work", "settings.json");
+  Make(".claude-personal", "settings.json");
+  Make(".codex", "config.toml");
+  std::vector<Account> all = ListAccounts(home_, {}, base::DictValue());
+  base::DictValue s = SuggestAccounts(
+      all, {{"s1", "Work"}, {"s2", "Home 🏠"}, {"s3", "Reading"}});
+  ASSERT_TRUE(s.FindDict("s1"));
+  EXPECT_EQ(*s.FindDict("s1")->FindString("claude"),
+            AccountId(home_.AppendASCII(".claude-work")));
+  ASSERT_TRUE(s.FindDict("s2"));
+  EXPECT_EQ(*s.FindDict("s2")->FindString("claude"),
+            AccountId(home_.AppendASCII(".claude-personal")));
+  EXPECT_FALSE(s.FindDict("s3"));
+  // One Codex account: nothing to choose.
+  EXPECT_FALSE(s.FindDict("s1")->FindString("codex"));
+}
+
+}  // namespace
+}  // namespace meridian::ai
