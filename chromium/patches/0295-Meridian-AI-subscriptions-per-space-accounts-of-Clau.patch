+// ------------------------------------------------------------- AI accounts
+
+namespace {
+
+// The account `id` of `vendor` in `list`, or null.
+const ai::Account* FindAccount(const std::vector<ai::Account>& list,
+                               const std::string& vendor,
+                               const std::string& id) {
+  for (const ai::Account& a : list) {
+    if (a.vendor == vendor && a.id == id) {
+      return &a;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+void SidebarHandler::GetAiAccounts(GetAiAccountsCallback callback) {
+  Profile* profile = browser_->GetProfile();
+  ai::ListAccountsAsync(
+      profile, base::BindOnce(
+                   [](base::WeakPtr<SidebarHandler> self,
+                      GetAiAccountsCallback callback,
+                      std::vector<ai::Account> list) {
+                     if (!self) {
+                       return;
+                     }
+                     std::move(callback).Run(
+                         base::WriteJson(ai::AccountsToDict(
+                                             self->browser_->GetProfile(),
+                                             list, /*paths=*/true))
+                             .value_or("{}"));
+                   },
+                   weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void SidebarHandler::AddAiAccount(const std::string& vendor_id,
+                                  const std::string& typed,
+                                  AddAiAccountCallback callback) {
+  const ai::AccountVendor* vendor = ai::FindAccountVendor(vendor_id);
+  if (!vendor) {
+    std::move(callback).Run("", "Unknown AI.");
+    return;
+  }
+  std::string error;
+  std::optional<base::FilePath> dir =
+      ai::NewAccountDir(*vendor, ai::AccountsHome(), typed, &error);
+  if (!dir) {
+    std::move(callback).Run("", error);
+    return;
+  }
+  // A name typed becomes the label; a folder gets one from its name.
+  std::string label(base::TrimWhitespaceASCII(typed, base::TRIM_ALL));
+  if (label.starts_with("/") || label.starts_with("~")) {
+    label.clear();
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(
+          [](base::FilePath dir) {
+            // The CLI fills it at its first sign-in; private like its own.
+            if (base::DirectoryExists(dir)) {
+              return true;
+            }
+            return base::CreateDirectory(dir) &&
+                   base::SetPosixFilePermissions(dir, 0700);
+          },
+          *dir),
+      base::BindOnce(
+          [](base::WeakPtr<SidebarHandler> self, std::string vendor,
+             base::FilePath dir, std::string label,
+             AddAiAccountCallback callback, bool ok) {
+            if (!self || !ok) {
+              std::move(callback).Run("", "Couldn’t make the folder " +
+                                              dir.AsUTF8Unsafe() + ".");
+              return;
+            }
+            ai::SaveAccount(self->browser_->GetProfile(), vendor, dir, label);
+            std::move(callback).Run(ai::AccountId(dir), "");
+          },
+          weak_factory_.GetWeakPtr(), vendor_id, *dir, label,
+          std::move(callback)));
+}
+
+void SidebarHandler::RenameAiAccount(const std::string& vendor,
+                                     const std::string& id,
+                                     const std::string& raw,
+                                     RenameAiAccountCallback callback) {
+  std::string label(base::TrimWhitespaceASCII(raw, base::TRIM_ALL));
+  if (label.size() > 40) {
+    label.resize(40);
+  }
+  ai::ListAccountsAsync(
+      browser_->GetProfile(),
+      base::BindOnce(
+          [](base::WeakPtr<SidebarHandler> self, std::string vendor,
+             std::string id, std::string label,
+             RenameAiAccountCallback callback, std::vector<ai::Account> list) {
+            if (self && !label.empty()) {
+              if (const ai::Account* a = FindAccount(list, vendor, id)) {
+                ai::SaveAccount(self->browser_->GetProfile(), vendor, a->dir,
+                                label);
+              }
+            }
+            std::move(callback).Run();
+          },
+          weak_factory_.GetWeakPtr(), vendor, id, label, std::move(callback)));
+}
+
+void SidebarHandler::RemoveAiAccount(const std::string& vendor,
+                                     const std::string& id,
+                                     RemoveAiAccountCallback callback) {
+  ai::ListAccountsAsync(
+      browser_->GetProfile(),
+      base::BindOnce(
+          [](base::WeakPtr<SidebarHandler> self, std::string vendor,
+             std::string id, RemoveAiAccountCallback callback,
+             std::vector<ai::Account> list) {
+            if (self) {
+              if (const ai::Account* a = FindAccount(list, vendor, id)) {
+                ai::HideAccount(self->browser_->GetProfile(), vendor, a->dir);
+              }
+            }
+            std::move(callback).Run();
+          },
+          weak_factory_.GetWeakPtr(), vendor, id, std::move(callback)));
+}
+
+void SidebarHandler::SetSpaceAiAccount(const std::string& space_id,
+                                       const std::string& vendor,
+                                       const std::string& account_id,
+                                       SetSpaceAiAccountCallback callback) {
+  if (!service_->FindSpace(space_id) || !ai::FindAccountVendor(vendor)) {
+    std::move(callback).Run();
+    return;
+  }
+  ai::ListAccountsAsync(
+      browser_->GetProfile(),
+      base::BindOnce(
+          [](base::WeakPtr<SidebarHandler> self, std::string space_id,
+             std::string vendor, std::string account_id,
+             SetSpaceAiAccountCallback callback,
+             std::vector<ai::Account> list) {
+            if (self) {
+              const ai::Account* a = FindAccount(list, vendor, account_id);
+              if (a || account_id.empty()) {
+                ai::SetSpaceAccount(self->browser_->GetProfile(), space_id,
+                                    vendor, a);
+              }
+            }
+            std::move(callback).Run();
+          },
+          weak_factory_.GetWeakPtr(), space_id, vendor, account_id,
+          std::move(callback)));
+}
+
+void SidebarHandler::SignInAiAccount(const std::string& vendor_id,
+                                     const std::string& id,
+                                     SignInAiAccountCallback callback) {
+  ai::ListAccountsAsync(
+      browser_->GetProfile(),
+      base::BindOnce(
+          [](std::string vendor_id, std::string id,
+             SignInAiAccountCallback callback, std::vector<ai::Account> list) {
+            const ai::AccountVendor* vendor =
+                ai::FindAccountVendor(vendor_id);
+            const ai::Account* a = FindAccount(list, vendor_id, id);
+            if (!vendor || !a) {
+              std::move(callback).Run(false, "That account isn’t listed.");
+              return;
+            }
+            const std::string command =
+                ai::AccountLoginCommand(*vendor, ai::AccountsHome(), a->dir);
+            const std::string title =
+                "Sign in to " + vendor->short_label + " (" + a->label + ")";
+            // Tests: what would run, written down (no Terminal window).
+            base::FilePath log = TestSwitchPath("meridian-test-signin-log");
+            base::ThreadPool::PostTaskAndReplyWithResult(
+                FROM_HERE, {base::MayBlock()},
+                base::BindOnce(
+                    [](std::string command, std::string title,
+                       base::FilePath log) {
+                      if (!log.empty()) {
+                        return base::AppendToFile(log, command + "\n");
+                      }
+                      return OpenInTerminal(command, title);
+                    },
+                    command, title, log),
+                base::BindOnce(
+                    [](SignInAiAccountCallback callback, bool ok) {
+                      std::move(callback).Run(
+                          ok, ok ? "" : "Couldn’t open Terminal.");
+                    },
+                    std::move(callback)));
+          },
+          vendor_id, id, std::move(callback)));
+}
+
+void SidebarHandler::AnswerAiAccountsHint(
+    const std::string& answer,
+    AnswerAiAccountsHintCallback callback) {
+  Profile* main = MainProfileFor(browser_->GetProfile());
+  PrefService* prefs = (main ? main : browser_->GetProfile())->GetPrefs();
+  if (answer == "dismiss") {
+    prefs->SetString(prefs::kAiAccountsHint, "dismissed");
+    std::move(callback).Run();
+    return;
+  }
+  if (answer != "apply") {
+    std::move(callback).Run();
+    return;
+  }
+  ai::ListAccountsAsync(
+      browser_->GetProfile(),
+      base::BindOnce(
+          [](base::WeakPtr<SidebarHandler> self,
+             AnswerAiAccountsHintCallback callback,
+             std::vector<ai::Account> list) {
+            if (self) {
+              Profile* profile = self->browser_->GetProfile();
+              base::DictValue all =
+                  ai::AccountsToDict(profile, list, /*paths=*/false);
+              if (const base::DictValue* s = all.FindDict("suggestion")) {
+                for (auto [space_id, per] : *s) {
+                  for (auto [vendor, id] : per.GetDict()) {
+                    if (const ai::Account* a =
+                            FindAccount(list, vendor, id.GetString())) {
+                      ai::SetSpaceAccount(profile, space_id, vendor, a);
+                    }
+                  }
+                }
+              }
+              Profile* main = MainProfileFor(profile);
+              (main ? main : profile)
+                  ->GetPrefs()
+                  ->SetString(prefs::kAiAccountsHint, "applied");
+            }
+            std::move(callback).Run();
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
 }  // namespace meridian
