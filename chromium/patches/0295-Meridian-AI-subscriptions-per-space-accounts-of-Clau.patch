+void AgentService::ListAiAccounts(std::unique_ptr<Call> call) {
+  ai::ListAccountsAsync(
+      profile_,
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, std::unique_ptr<Call> call,
+             std::vector<ai::Account> list) {
+            if (!self) {
+              return;
+            }
+            // Names and spaces only: no folders, never a sign-in.
+            base::DictValue all =
+                ai::AccountsToDict(self->profile_, list, /*paths=*/false);
+            base::ListValue vendors;
+            if (base::ListValue* v = all.FindList("vendors")) {
+              for (base::Value& vendor : *v) {
+                if (base::ListValue* accounts =
+                        vendor.GetDict().FindList("accounts")) {
+                  for (base::Value& a : *accounts) {
+                    a.GetDict().Remove("found");
+                    if (base::ListValue* spaces =
+                            a.GetDict().FindList("spaces")) {
+                      spaces->EraseIf([&](const base::Value& id) {
+                        return !id.is_string() ||
+                               !self->SpaceAllowed(id.GetString());
+                      });
+                    }
+                  }
+                }
+                vendor.GetDict().Remove("short");
+                vendors.Append(std::move(vendor));
+              }
+            }
+            call->Ok(base::Value(
+                base::DictValue().Set("vendors", std::move(vendors))));
+          },
+          weak_factory_.GetWeakPtr(), std::move(call)));
+}
+
+void AgentService::SetSpaceAiAccount(std::unique_ptr<Call> call) {
+  const std::string space_id = call->StrOr("space_id", "");
+  const std::string vendor_id = call->StrOr("vendor", "");
+  const std::string account_id = call->StrOr("account_id", "");
+  SidebarService* service = SidebarServiceFactory::GetForProfile(profile_);
+  const Space* space = service->FindSpace(space_id);
+  if (!space || !SpaceAllowed(space_id)) {
+    return call->Fail("no such space (list_spaces shows the ones you can use)");
+  }
+  const ai::AccountVendor* vendor = ai::FindAccountVendor(vendor_id);
+  if (!vendor) {
+    return call->Fail(
+        "vendor is one of \"claude\", \"codex\", \"copilot\", \"gemini\"");
+  }
+  const std::string space_name = space->name;
+  ai::ListAccountsAsync(
+      profile_,
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, std::string space_id,
+             std::string space_name, std::string vendor_id,
+             std::string account_id, std::unique_ptr<Call> call,
+             std::vector<ai::Account> list) {
+            if (!self) {
+              return;
+            }
+            const ai::AccountVendor* vendor =
+                ai::FindAccountVendor(vendor_id);
+            std::optional<ai::Account> account;
+            for (const ai::Account& a : list) {
+              if (a.vendor == vendor_id &&
+                  (account_id.empty() ? a.is_default : a.id == account_id)) {
+                account = a;
+              }
+            }
+            if (!account_id.empty() && !account) {
+              return call->Fail(
+                  "no such account (list_ai_accounts shows them)");
+            }
+            const std::string label =
+                account ? account->label : std::string("the default");
+            self->Confirm(
+                std::move(call),
+                "use " + vendor->short_label + " account “" + label +
+                    "” in the space “" + space_name + "”",
+                base::BindOnce(
+                    [](base::WeakPtr<AgentService> self, std::string space_id,
+                       std::string vendor_id,
+                       std::optional<ai::Account> account,
+                       std::unique_ptr<Call> call) {
+                      if (!self) {
+                        return;
+                      }
+                      ai::SetSpaceAccount(self->profile_, space_id, vendor_id,
+                                          account ? &*account : nullptr);
+                      call->Ok(base::Value(
+                          base::DictValue()
+                              .Set("space_id", space_id)
+                              .Set("vendor", vendor_id)
+                              .Set("account_id",
+                                   account && !account->is_default
+                                       ? account->id
+                                       : std::string())
+                              .Set("label", account ? account->label
+                                                    : std::string("Default"))));
+                    },
+                    self, space_id, vendor_id, std::move(account)));
+          },
+          weak_factory_.GetWeakPtr(), space_id, space_name, vendor_id,
+          account_id, std::move(call)));
+}
