+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/ai/account_prefs.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/meridian/ai/process_runner.h"
+#include "chrome/browser/meridian/prefs.h"
+#include "chrome/browser/meridian/sidebar_service.h"
+#include "chrome/browser/meridian/sidebar_service_factory.h"
+#include "chrome/browser/meridian/space_profiles.h"
+#include "chrome/browser/meridian/test_switches.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace meridian::ai {
+
+namespace {
+
+PrefService* Prefs(Profile* profile) {
+  Profile* main = MainProfileFor(profile);
+  return (main ? main : profile)->GetPrefs();
+}
+
+// The label kept for `dir`, else one from its name.
+std::string LabelOf(PrefService* prefs,
+                    const AccountVendor& vendor,
+                    const base::FilePath& dir) {
+  if (const base::ListValue* list =
+          prefs->GetDict(prefs::kAiAccounts).FindList(vendor.id)) {
+    for (const base::Value& entry : *list) {
+      if (!entry.is_dict()) {
+        continue;
+      }
+      const std::string* d = entry.GetDict().FindString("dir");
+      const std::string* label = entry.GetDict().FindString("label");
+      if (d && label && !label->empty() &&
+          base::FilePath::FromUTF8Unsafe(*d) == dir) {
+        return *label;
+      }
+    }
+  }
+  return AccountLabelFromDir(vendor, AccountsHome(), dir);
+}
+
+// The saved entry for `dir` (made if missing).
+base::DictValue* EntryFor(base::DictValue& accounts,
+                          const std::string& vendor_id,
+                          const base::FilePath& dir) {
+  base::ListValue* list = accounts.EnsureList(vendor_id);
+  const std::string path = dir.StripTrailingSeparators().AsUTF8Unsafe();
+  for (base::Value& entry : *list) {
+    if (entry.is_dict()) {
+      if (const std::string* d = entry.GetDict().FindString("dir");
+          d && *d == path) {
+        return &entry.GetDict();
+      }
+    }
+  }
+  list->Append(base::DictValue().Set("dir", path));
+  return &list->back().GetDict();
+}
+
+}  // namespace
+
+base::FilePath AccountsHome() {
+  base::FilePath test = TestSwitchPath("meridian-accounts-home");
+  return test.empty() ? base::GetHomeDir() : test;
+}
+
+void ListAccountsAsync(Profile* profile,
+                       base::OnceCallback<void(std::vector<Account>)> done) {
+  base::DictValue saved = Prefs(profile)->GetDict(prefs::kAiAccounts).Clone();
+  const bool test = HasTestSwitch("meridian-accounts-home");
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::WithBaseSyncPrimitives(),
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(
+          [](base::DictValue saved, bool test) {
+            // Tests: only their own home counts, not the variables of the
+            // computer running them.
+            std::map<std::string, std::string> env;
+            if (!test) {
+              env = LoginEnvironment();
+            }
+            return ListAccounts(AccountsHome(), env, saved);
+          },
+          std::move(saved), test),
+      std::move(done));
+}
+
+std::optional<SpaceAccount> SpaceAccountFor(Profile* profile,
+                                            const std::string& space_id,
+                                            const std::string& vendor_id) {
+  const AccountVendor* vendor = FindAccountVendor(vendor_id);
+  if (!vendor || space_id.empty()) {
+    return std::nullopt;
+  }
+  PrefService* prefs = Prefs(profile);
+  const base::DictValue* space =
+      prefs->GetDict(prefs::kAiSpaceAccounts).FindDict(space_id);
+  const base::DictValue* entry = space ? space->FindDict(vendor_id) : nullptr;
+  const std::string* id = entry ? entry->FindString("id") : nullptr;
+  const std::string* dir = entry ? entry->FindString("dir") : nullptr;
+  if (!id || !dir || dir->empty()) {
+    return std::nullopt;
+  }
+  SpaceAccount out;
+  out.id = *id;
+  out.dir = base::FilePath::FromUTF8Unsafe(*dir);
+  out.label = LabelOf(prefs, *vendor, out.dir);
+  return out;
+}
+
+std::map<std::string, std::string> AccountEnvForProvider(
+    Profile* profile,
+    const std::string& space_id,
+    const std::string& provider_id,
+    std::string* label) {
+  const AccountVendor* vendor = AccountVendorForProvider(provider_id);
+  if (!vendor) {
+    return {};
+  }
+  std::optional<SpaceAccount> account =
+      SpaceAccountFor(profile, space_id, vendor->id);
+  if (!account) {
+    return {};
+  }
+  if (label) {
+    *label = account->label;
+  }
+  return AccountEnv(*vendor, AccountsHome(), account->dir);
+}
+
+std::map<std::string, std::string> AccountEnvForKind(
+    Profile* profile,
+    const std::string& space_id,
+    const std::string& kind,
+    std::string* label) {
+  std::map<std::string, std::string> out;
+  const bool shell = kind == "shell";
+  for (const AccountVendor& vendor : AccountVendors()) {
+    if (!shell &&
+        std::ranges::find(vendor.kinds, kind) == vendor.kinds.end()) {
+      continue;
+    }
+    std::optional<SpaceAccount> account =
+        SpaceAccountFor(profile, space_id, vendor.id);
+    if (!account) {
+      continue;
+    }
+    if (label && !shell) {
+      *label = account->label;
+    }
+    for (auto& [name, value] :
+         AccountEnv(vendor, AccountsHome(), account->dir)) {
+      out[name] = value;
+    }
+  }
+  return out;
+}
+
+void SetSpaceAccount(Profile* profile,
+                     const std::string& space_id,
+                     const std::string& vendor_id,
+                     const Account* account) {
+  ScopedDictPrefUpdate update(Prefs(profile), prefs::kAiSpaceAccounts);
+  base::DictValue* space = update->EnsureDict(space_id);
+  if (!account || account->is_default) {
+    space->Remove(vendor_id);
+  } else {
+    space->Set(vendor_id,
+               base::DictValue()
+                   .Set("id", account->id)
+                   .Set("dir", account->dir.AsUTF8Unsafe()));
+  }
+  if (space->empty()) {
+    update->Remove(space_id);
+  }
+}
+
+void SaveAccount(Profile* profile,
+                 const std::string& vendor_id,
+                 const base::FilePath& dir,
+                 const std::string& label) {
+  ScopedDictPrefUpdate update(Prefs(profile), prefs::kAiAccounts);
+  base::DictValue* entry = EntryFor(*update, vendor_id, dir);
+  entry->Remove("hidden");
+  if (!label.empty()) {
+    entry->Set("label", label);
+  }
+}
+
+void HideAccount(Profile* profile,
+                 const std::string& vendor_id,
+                 const base::FilePath& dir) {
+  {
+    ScopedDictPrefUpdate update(Prefs(profile), prefs::kAiAccounts);
+    base::DictValue* entry = EntryFor(*update, vendor_id, dir);
+    entry->Set("hidden", true);
+    entry->Remove("label");
+  }
+  // Spaces that used it go back to the default.
+  ScopedDictPrefUpdate spaces(Prefs(profile), prefs::kAiSpaceAccounts);
+  const std::string id = AccountId(dir);
+  std::vector<std::string> empty;
+  for (auto [space_id, value] : *spaces) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    const base::DictValue* entry = value.GetDict().FindDict(vendor_id);
+    const std::string* used = entry ? entry->FindString("id") : nullptr;
+    if (used && *used == id) {
+      value.GetDict().Remove(vendor_id);
+    }
+    if (value.GetDict().empty()) {
+      empty.push_back(space_id);
+    }
+  }
+  for (const std::string& space_id : empty) {
+    spaces->Remove(space_id);
+  }
+}
+
+base::DictValue AccountsToDict(Profile* profile,
+                               const std::vector<Account>& accounts,
+                               bool paths) {
+  PrefService* prefs = Prefs(profile);
+  SidebarService* sidebar = SidebarServiceFactory::GetForProfile(profile);
+  std::vector<std::pair<std::string, std::string>> spaces;
+  if (sidebar) {
+    for (const Space& s : sidebar->spaces()) {
+      spaces.emplace_back(s.id, s.name);
+    }
+  }
+  // Each space's choice, for the accounts still listed.
+  base::DictValue chosen;
+  for (const auto& [space_id, name] : spaces) {
+    base::DictValue per;
+    for (const AccountVendor& vendor : AccountVendors()) {
+      std::optional<SpaceAccount> a =
+          SpaceAccountFor(profile, space_id, vendor.id);
+      if (a && std::ranges::any_of(accounts, [&](const Account& x) {
+            return x.vendor == vendor.id && x.id == a->id;
+          })) {
+        per.Set(vendor.id, a->id);
+      }
+    }
+    if (!per.empty()) {
+      chosen.Set(space_id, std::move(per));
+    }
+  }
+  base::ListValue vendors;
+  for (const AccountVendor& vendor : AccountVendors()) {
+    base::ListValue list;
+    for (const Account& a : accounts) {
+      if (a.vendor != vendor.id) {
+        continue;
+      }
+      base::ListValue used_by;
+      for (const auto& [space_id, name] : spaces) {
+        const base::DictValue* per = chosen.FindDict(space_id);
+        const std::string* id = per ? per->FindString(vendor.id) : nullptr;
+        if (id ? *id == a.id : a.is_default) {
+          used_by.Append(space_id);
+        }
+      }
+      base::DictValue entry;
+      entry.Set("id", a.id);
+      entry.Set("label", a.label);
+      entry.Set("default", a.is_default);
+      entry.Set("found", a.found);
+      entry.Set("spaces", std::move(used_by));
+      if (paths) {
+        const base::FilePath home = AccountsHome();
+        std::string shown = a.dir.AsUTF8Unsafe();
+        if (home.IsParent(a.dir)) {
+          base::FilePath relative;
+          home.AppendRelativePath(a.dir, &relative);
+          shown = "~/" + relative.AsUTF8Unsafe();
+        }
+        entry.Set("dir", shown);
+      }
+      list.Append(std::move(entry));
+    }
+    if (list.empty()) {
+      continue;
+    }
+    vendors.Append(base::DictValue()
+                       .Set("id", vendor.id)
+                       .Set("label", vendor.label)
+                       .Set("short", vendor.short_label)
+                       .Set("accounts", std::move(list)));
+  }
+  base::DictValue suggestion = SuggestAccounts(accounts, spaces);
+  // Only what would change something.
+  base::DictValue useful;
+  for (auto [space_id, value] : suggestion) {
+    base::DictValue per;
+    for (auto [vendor_id, id] : value.GetDict()) {
+      const base::DictValue* now = chosen.FindDict(space_id);
+      const std::string* current = now ? now->FindString(vendor_id) : nullptr;
+      const bool is_default = std::ranges::any_of(accounts, [&](const Account& a) {
+        return a.vendor == vendor_id && a.id == id.GetString() && a.is_default;
+      });
+      if (current ? *current != id.GetString() : !is_default) {
+        per.Set(vendor_id, id.GetString());
+      }
+    }
+    if (!per.empty()) {
+      useful.Set(space_id, std::move(per));
+    }
+  }
+  base::DictValue out;
+  out.Set("vendors", std::move(vendors));
+  out.Set("spaces", std::move(chosen));
+  out.Set("suggestion", std::move(useful));
+  out.Set("hint", prefs->GetString(prefs::kAiAccountsHint));
+  return out;
+}
+
+}  // namespace meridian::ai
