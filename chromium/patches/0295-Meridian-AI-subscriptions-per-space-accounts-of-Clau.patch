+
+class Profile;
+
+namespace meridian::ai {
+
+// The accounts of ai/accounts.h as Meridian keeps them, in the main
+// profile's prefs (every space's profile shares them):
+//  - prefs::kAiAccounts: what the person added, renamed or took off the list;
+//  - prefs::kAiSpaceAccounts: space id -> vendor -> {id, dir}.
+// A space that doesn't name an account for a vendor uses that CLI's default.
+
+// Where account folders are looked for: the home folder, or the tests' own
+// (--meridian-accounts-home).
+base::FilePath AccountsHome();
+
+// Lists them (blocking work off the UI thread).
+void ListAccountsAsync(Profile* profile,
+                       base::OnceCallback<void(std::vector<Account>)> done);
+
+// What space `space_id` uses for `vendor_id`: nullopt = the default.
+struct SpaceAccount {
+  std::string id;
+  std::string label;
+  base::FilePath dir;
+};
+std::optional<SpaceAccount> SpaceAccountFor(Profile* profile,
+                                            const std::string& space_id,
+                                            const std::string& vendor_id);
+
+// The environment changes (ApplyAccountEnv) to run, in space `space_id`, an
+// Ask provider or a Workbench terminal kind; `label` gets the account's name
+// ("" for the default). A plain shell gets every vendor's (what it starts
+// there runs as the space says).
+std::map<std::string, std::string> AccountEnvForProvider(
+    Profile* profile,
+    const std::string& space_id,
+    const std::string& provider_id,
+    std::string* label);
+std::map<std::string, std::string> AccountEnvForKind(
+    Profile* profile,
+    const std::string& space_id,
+    const std::string& kind,
+    std::string* label);
+
+// Space `space_id` uses `account` for its vendor (null: the default).
+void SetSpaceAccount(Profile* profile,
+                     const std::string& space_id,
+                     const std::string& vendor_id,
+                     const Account* account);
+
+// Adding, renaming and taking an account off the list (its folder stays).
+void SaveAccount(Profile* profile,
+                 const std::string& vendor_id,
+                 const base::FilePath& dir,
+                 const std::string& label);
+void HideAccount(Profile* profile,
+                 const std::string& vendor_id,
+                 const base::FilePath& dir);
+
+// For Settings, the space menu and MCP: {vendors: [{id, label, accounts:
+// [{id, label, default, found, spaces: [space ids]}]}], spaces: {space id:
+// {vendor: account id}}, suggestion: {space id: {vendor: account id}},
+// hint: "" | "dismissed" | "applied"}. With `paths`, each account's folder
+// too (Settings only; never MCP).
+base::DictValue AccountsToDict(Profile* profile,
+                               const std::vector<Account>& accounts,
+                               bool paths);
+
+}  // namespace meridian::ai
+
+#endif  // CHROME_BROWSER_MERIDIAN_AI_ACCOUNT_PREFS_H_
diff --git a/chrome/browser/meridian/ai/accounts.cc b/chrome/browser/meridian/ai/accounts.cc
new file mode 100644
index 0000000000..09fb7b3e25
--- /dev/null
+++ b/chrome/browser/meridian/ai/accounts.cc
@@ -0,0 +1,461 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/ai/accounts.h"
+
+#include <algorithm>
+#include <set>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/hash/hash.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace meridian::ai {
+
+namespace {
+
+// A space's name and an account's label that go together.
+const std::vector<std::vector<std::string>>& Synonyms() {
+  static const base::NoDestructor<std::vector<std::vector<std::string>>> kSets(
+      std::vector<std::vector<std::string>>{
+          {"work", "job", "office", "company", "corp", "business", "team",
+           "client"},
+          {"personal", "home", "private", "me", "mine", "own", "life",
+           "family", "side"},
+      });
+  return *kSets;
+}
+
+std::string Lower(std::string s) {
+  return base::ToLowerASCII(s);
+}
+
+// Words of a name, lower case ("Work 🏢" -> {"work"}).
+std::set<std::string> Words(const std::string& name) {
+  std::set<std::string> out;
+  std::string word;
+  for (char c : Lower(name) + " ") {
+    if (base::IsAsciiAlphaNumeric(c)) {
+      word += c;
+    } else if (!word.empty()) {
+      out.insert(word);
+      word.clear();
+    }
+  }
+  return out;
+}
+
+// How well a space's name goes with an account's label: 2 = the same word,
+// 1 = words that mean the same, 0 = no.
+int Match(const std::string& space, const std::string& label) {
+  const std::set<std::string> a = Words(space);
+  const std::set<std::string> b = Words(label);
+  for (const std::string& w : a) {
+    if (b.contains(w)) {
+      return 2;
+    }
+  }
+  for (const std::vector<std::string>& set : Synonyms()) {
+    const auto in = [&](const std::set<std::string>& words) {
+      return std::ranges::any_of(words, [&](const std::string& w) {
+        return std::ranges::find(set, w) != set.end();
+      });
+    };
+    if (in(a) && in(b)) {
+      return 1;
+    }
+  }
+  return 0;
+}
+
+bool SameDir(const base::FilePath& a, const base::FilePath& b) {
+  return a.StripTrailingSeparators() == b.StripTrailingSeparators();
+}
+
+// A single-quoted shell word.
+std::string Quote(const std::string& s) {
+  std::string out = "'";
+  for (char c : s) {
+    if (c == '\'') {
+      out += "'\\''";
+    } else {
+      out += c;
+    }
+  }
+  return out + "'";
+}
+
+}  // namespace
+
+const std::vector<AccountVendor>& AccountVendors() {
+  static const base::NoDestructor<std::vector<AccountVendor>> kVendors(
+      std::vector<AccountVendor>{
+          {"claude",
+           "Claude Code",
+           "Claude",
+           "CLAUDE_CONFIG_DIR",
+           ".claude",
+           "",
+           {"settings.json", "projects", ".claude.json", "history.jsonl"},
+           "claude",
+           {"claude-code"},
+           {"claude"}},
+          {"codex",
+           "Codex",
+           "Codex",
+           "CODEX_HOME",
+           ".codex",
+           "",
+           {"config.toml", "sessions", "history.jsonl"},
+           "codex login",
+           {"codex"},
+           {"codex"}},
+          {"copilot",
+           "GitHub Copilot CLI",
+           "Copilot",
+           "COPILOT_HOME",
+           ".copilot",
+           "",
+           {"settings.json", "session-state", "mcp-config.json"},
+           "copilot",
+           {"copilot"},
+           {"copilot"}},
+          {"gemini",
+           "Gemini CLI",
+           "Gemini",
+           "GEMINI_CLI_HOME",
+           "",
+           ".gemini",
+           {"settings.json", "projects.json", "installation_id"},
+           "gemini",
+           {},
+           {"gemini"}},
+      });
+  return *kVendors;
+}
+
+const AccountVendor* FindAccountVendor(std::string_view id) {
+  for (const AccountVendor& v : AccountVendors()) {
+    if (v.id == id) {
+      return &v;
+    }
+  }
+  return nullptr;
+}
+
+const AccountVendor* AccountVendorForProvider(std::string_view provider_id) {
+  for (const AccountVendor& v : AccountVendors()) {
+    if (std::ranges::find(v.providers, provider_id) != v.providers.end()) {
+      return &v;
+    }
+  }
+  return nullptr;
+}
+
+const AccountVendor* AccountVendorForKind(std::string_view kind) {
+  for (const AccountVendor& v : AccountVendors()) {
+    if (std::ranges::find(v.kinds, kind) != v.kinds.end()) {
+      return &v;
+    }
+  }
+  return nullptr;
+}
+
+std::string AccountId(const base::FilePath& dir) {
+  return base::StringPrintf(
+      "%08x", base::PersistentHash(
+                  dir.StripTrailingSeparators().AsUTF8Unsafe()));
+}
+
+namespace {
+
+base::FilePath OwnDir(const AccountVendor& vendor, const base::FilePath& home) {
+  return vendor.base.empty() ? home : home.AppendASCII(vendor.base);
+}
+
+// The vendor's own folder name in a home-style folder (".gemini") or its base
+// (".claude"): what other folders' names start with.
+std::string Stem(const AccountVendor& vendor) {
+  return vendor.base.empty() ? vendor.sub : vendor.base;
+}
+
+}  // namespace
+
+std::string AccountLabelFromDir(const AccountVendor& vendor,
+                                const base::FilePath& home,
+                                const base::FilePath& dir) {
+  if (SameDir(dir, OwnDir(vendor, home))) {
+    return "Default";
+  }
+  std::string name = dir.StripTrailingSeparators().BaseName().AsUTF8Unsafe();
+  const std::string stem = Stem(vendor);
+  if (name.starts_with(stem) && name.size() > stem.size() + 1 &&
+      (name[stem.size()] == '-' || name[stem.size()] == '_' ||
+       name[stem.size()] == '.')) {
+    name = name.substr(stem.size() + 1);
+  } else if (name.starts_with(".")) {
+    name = name.substr(1);
+  }
+  for (char& c : name) {
+    if (c == '-' || c == '_') {
+      c = ' ';
+    }
+  }
+  if (name.empty()) {
+    return "Account";
+  }
+  name[0] = base::ToUpperASCII(name[0]);
+  return name;
+}
+
+base::FilePath DefaultAccountDir(
+    const AccountVendor& vendor,
+    const base::FilePath& home,
+    const std::map<std::string, std::string>& login_env) {
+  if (auto it = login_env.find(vendor.var);
+      it != login_env.end() && !it->second.empty()) {
+    base::FilePath dir = base::FilePath::FromUTF8Unsafe(it->second);
+    if (dir.IsAbsolute()) {
+      return dir;
+    }
+  }
+  return OwnDir(vendor, home);
+}
+
+bool LooksLikeAccountDir(const AccountVendor& vendor,
+                         const base::FilePath& dir) {
+  base::FilePath config =
+      vendor.sub.empty() ? dir : dir.AppendASCII(vendor.sub);
+  if (!base::DirectoryExists(config)) {
+    return false;
+  }
+  return std::ranges::any_of(vendor.markers, [&](const std::string& m) {
+    return base::PathExists(config.AppendASCII(m));
+  });
+}
+
+std::vector<Account> ListAccounts(
+    const base::FilePath& home,
+    const std::map<std::string, std::string>& login_env,
+    const base::DictValue& saved) {
+  // The folders next to the CLIs' own: one look at the home folder's names.
+  std::vector<base::FilePath> siblings;
+  base::FileEnumerator e(home, false, base::FileEnumerator::DIRECTORIES,
+                         FILE_PATH_LITERAL(".*"));
+  for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+    siblings.push_back(p);
+  }
+  std::vector<Account> out;
+  for (const AccountVendor& vendor : AccountVendors()) {
+    std::vector<Account> list;
+    const base::FilePath default_dir =
+        DefaultAccountDir(vendor, home, login_env);
+    std::set<base::FilePath> hidden;
+    std::map<base::FilePath, std::string> labels;
+    std::vector<base::FilePath> added;
+    if (const base::ListValue* entries = saved.FindList(vendor.id)) {
+      for (const base::Value& entry : *entries) {
+        if (!entry.is_dict()) {
+          continue;
+        }
+        const std::string* dir = entry.GetDict().FindString("dir");
+        if (!dir || dir->empty()) {
+          continue;
+        }
+        base::FilePath path =
+            base::FilePath::FromUTF8Unsafe(*dir).StripTrailingSeparators();
+        if (entry.GetDict().FindBool("hidden").value_or(false)) {
+          hidden.insert(path);
+          continue;
+        }
+        if (const std::string* label = entry.GetDict().FindString("label");
+            label && !label->empty()) {
+          labels[path] = *label;
+        }
+        added.push_back(path);
+      }
+    }
+    auto add = [&](const base::FilePath& raw, bool is_saved) {
+      const base::FilePath dir = raw.StripTrailingSeparators();
+      if (hidden.contains(dir)) {
+        return;
+      }
+      for (Account& a : list) {
+        if (SameDir(a.dir, dir)) {
+          a.saved |= is_saved;
+          return;
+        }
+      }
+      Account a;
+      a.vendor = vendor.id;
+      a.dir = dir;
+      a.id = AccountId(dir);
+      a.is_default = SameDir(dir, default_dir);
+      a.found = LooksLikeAccountDir(vendor, dir);
+      a.saved = is_saved;
+      auto label = labels.find(dir);
+      a.label = label != labels.end()
+                    ? label->second
+                    : AccountLabelFromDir(vendor, home, dir);
+      list.push_back(std::move(a));
+    };
+    if (LooksLikeAccountDir(vendor, default_dir)) {
+      add(default_dir, false);
+    }
+    const std::string stem = Stem(vendor);
+    for (const base::FilePath& p : siblings) {
+      const std::string name = p.BaseName().AsUTF8Unsafe();
+      if (name.size() > stem.size() + 1 && name.starts_with(stem) &&
+          (name[stem.size()] == '-' || name[stem.size()] == '_') &&
+          LooksLikeAccountDir(vendor, p)) {
+        add(p, false);
+      }
+    }
+    if (!SameDir(default_dir, OwnDir(vendor, home)) &&
+        LooksLikeAccountDir(vendor, OwnDir(vendor, home))) {
+      add(OwnDir(vendor, home), false);
+    }
+    for (const base::FilePath& p : added) {
+      add(p, true);
+    }
+    // A default that isn't set up yet still counts once there are others:
+    // it is what runs when a space doesn't say.
+    if (!list.empty() &&
+        std::ranges::none_of(list, [](const Account& a) {
+          return a.is_default;
+        }) &&
+        !hidden.contains(default_dir.StripTrailingSeparators())) {
+      add(default_dir, false);
+    }
+    std::ranges::stable_sort(list, [](const Account& a, const Account& b) {
+      if (a.is_default != b.is_default) {
+        return a.is_default;
+      }
+      return Lower(a.label) < Lower(b.label);
+    });
+    for (Account& a : list) {
+      out.push_back(std::move(a));
+    }
+  }
+  return out;
+}
+
+std::map<std::string, std::string> AccountEnv(const AccountVendor& vendor,
+                                              const base::FilePath& home,
+                                              const base::FilePath& dir) {
+  if (dir.empty()) {
+    return {};
+  }
+  if (SameDir(dir, OwnDir(vendor, home))) {
+    return {{vendor.var, std::string()}};
+  }
+  return {{vendor.var, dir.StripTrailingSeparators().AsUTF8Unsafe()}};
+}
+
+void ApplyAccountEnv(const std::map<std::string, std::string>& changes,
+                     std::map<std::string, std::string>& env) {
+  for (const auto& [name, value] : changes) {
+    if (value.empty()) {
+      env.erase(name);
+    } else {
+      env[name] = value;
+    }
+  }
+}
+
+std::optional<base::FilePath> NewAccountDir(const AccountVendor& vendor,
+                                            const base::FilePath& home,
+                                            const std::string& raw,
+                                            std::string* error) {
+  std::string typed(base::TrimWhitespaceASCII(raw, base::TRIM_ALL));
+  if (typed.empty()) {
+    *error = "Give the account a name, such as Work.";
+    return std::nullopt;
+  }
+  base::FilePath dir;
+  if (typed.starts_with("~/") || typed.starts_with("/")) {
+    dir = typed.starts_with("~/")
+              ? home.AppendUTF8(typed.substr(2))
+              : base::FilePath::FromUTF8Unsafe(typed);
+    if (dir.ReferencesParent()) {
+      *error = "Use a folder without “..” in it.";
+      return std::nullopt;
+    }
+  } else {
+    std::string slug;
+    for (char c : Lower(typed)) {
+      if (base::IsAsciiAlphaNumeric(c)) {
+        slug += c;
+      } else if (!slug.empty() && slug.back() != '-') {
+        slug += '-';
+      }
+    }
+    while (!slug.empty() && slug.back() == '-') {
+      slug.pop_back();
+    }
+    if (slug.empty()) {
+      *error = "Use letters or digits in the name.";
+      return std::nullopt;
+    }
+    dir = home.AppendASCII(Stem(vendor) + "-" + slug);
+  }
+  dir = dir.StripTrailingSeparators();
+  if (!home.IsParent(dir)) {
+    *error = "Keep the account’s folder inside your home folder.";
+    return std::nullopt;
+  }
+  return dir;
+}
+
+base::DictValue SuggestAccounts(
+    const std::vector<Account>& accounts,
+    const std::vector<std::pair<std::string, std::string>>& spaces) {
+  base::DictValue out;
+  for (const AccountVendor& vendor : AccountVendors()) {
+    std::vector<const Account*> mine;
+    for (const Account& a : accounts) {
+      if (a.vendor == vendor.id) {
+        mine.push_back(&a);
+      }
+    }
+    if (mine.size() < 2) {
+      continue;
+    }
+    for (const auto& [space_id, name] : spaces) {
+      const Account* best = nullptr;
+      int score = 0;
+      for (const Account* a : mine) {
+        // "Default" says nothing about work or home.
+        int s = a->label == "Default" ? 0 : Match(name, a->label);
+        if (s > score) {
+          score = s;
+          best = a;
+        }
+      }
+      if (best) {
+        base::DictValue* space = out.EnsureDict(space_id);
+        space->Set(vendor.id, best->id);
+      }
+    }
+  }
+  return out;
+}
+
+std::string AccountLoginCommand(const AccountVendor& vendor,
+                                const base::FilePath& home,
+                                const base::FilePath& dir) {
+  std::map<std::string, std::string> env = AccountEnv(vendor, home, dir);
+  std::string prefix;
+  for (const auto& [name, value] : env) {
+    prefix += value.empty() ? "env -u " + name + " "
+                            : name + "=" + Quote(value) + " ";
+  }
+  return prefix + vendor.login;
+}
+
+}  // namespace meridian::ai
diff --git a/chrome/browser/meridian/ai/accounts.h b/chrome/browser/meridian/ai/accounts.h
new file mode 100644
index 0000000000..3e31568500
--- /dev/null
+++ b/chrome/browser/meridian/ai/accounts.h
@@ -0,0 +1,135 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AI_ACCOUNTS_H_
+#define CHROME_BROWSER_MERIDIAN_AI_ACCOUNTS_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/values.h"
+
+namespace meridian::ai {
+
+// AI subscriptions side by side: several accounts of one coding-agent CLI
+// (Claude Code at work and at home, two Codex plans), each a config folder of
+// that CLI. Every one of these CLIs has its own documented switch for it, an
+// environment variable naming the folder it keeps its settings, sign-in and
+// sessions in:
+//  - Claude Code: CLAUDE_CONFIG_DIR (its Keychain entry is keyed to the
+//    folder too).
+//  - Codex: CODEX_HOME.
+//  - GitHub Copilot CLI: COPILOT_HOME.
+//  - Gemini CLI: GEMINI_CLI_HOME (a home: the settings are in its .gemini).
+// Meridian never signs in, and never opens, keeps or passes on a sign-in: it
+// only starts the person's own CLI with that variable, and the CLI's own
+// sign-in runs in a terminal when the person asks for it. A folder is found
+// by the names of files any config folder has (settings.json, sessions/…),
+// never by reading them.
+struct AccountVendor {
+  std::string id;     // "claude"
+  std::string label;  // "Claude Code"
+  std::string short_label;  // "Claude"
+  std::string var;    // "CLAUDE_CONFIG_DIR"
+  // The CLI's own folder under the home folder; "" = the home itself
+  // (Gemini's variable names a home).
+  std::string base;
+  // For a home-style variable: where its settings are inside ("/.gemini").
+  std::string sub;
+  // Names whose existence marks a config folder of this CLI (never opened).
+  std::vector<std::string> markers;
+  // How its own sign-in starts in a terminal.
+  std::string login;
+  // Ask providers (ai/providers.h) and Workbench terminal kinds it runs as.
+  std::vector<std::string> providers;
+  std::vector<std::string> kinds;
+};
+
+const std::vector<AccountVendor>& AccountVendors();
+const AccountVendor* FindAccountVendor(std::string_view id);
+// The vendor whose CLI an Ask provider / a Workbench terminal kind runs, or
+// null.
+const AccountVendor* AccountVendorForProvider(std::string_view provider_id);
+const AccountVendor* AccountVendorForKind(std::string_view kind);
+
+struct Account {
+  std::string vendor;
+  // Stable and opaque (from the folder), for MCP clients and the UI.
+  std::string id;
+  std::string label;
+  base::FilePath dir;
+  // The one the CLI uses when nothing says otherwise.
+  bool is_default = false;
+  // Its folder exists and looks like this CLI's.
+  bool found = false;
+  // Added (or renamed) in Meridian.
+  bool saved = false;
+};
+
+std::string AccountId(const base::FilePath& dir);
+
+// "Work" for ~/.claude-work, "Default" for ~/.claude, else the folder's name.
+std::string AccountLabelFromDir(const AccountVendor& vendor,
+                                const base::FilePath& home,
+                                const base::FilePath& dir);
+
+// The folder the CLI uses by default: its variable in the person's login
+// environment, else its own folder in `home`.
+base::FilePath DefaultAccountDir(
+    const AccountVendor& vendor,
+    const base::FilePath& home,
+    const std::map<std::string, std::string>& login_env);
+
+// Whether `dir` looks like a config folder of the vendor's CLI (by names).
+bool LooksLikeAccountDir(const AccountVendor& vendor,
+                         const base::FilePath& dir);
+
+// Blocking. Every vendor's accounts: the default one, folders next to it
+// named like it (~/.claude-work, ~/.codex_personal), and the ones the person
+// added (`saved`: vendor -> [{dir, label, hidden}]; hidden = taken off the
+// list, the folder stays). Default first, then by label.
+std::vector<Account> ListAccounts(
+    const base::FilePath& home,
+    const std::map<std::string, std::string>& login_env,
+    const base::DictValue& saved);
+
+// What to change in the environment to run the vendor's CLI as `dir`: its
+// variable set to the folder, or, for the CLI's own folder in `home`, taken
+// away (Claude Code keys its Keychain entry by the variable: set to its own
+// default folder, it would look signed out). An empty value = remove.
+std::map<std::string, std::string> AccountEnv(const AccountVendor& vendor,
+                                              const base::FilePath& home,
+                                              const base::FilePath& dir);
+void ApplyAccountEnv(const std::map<std::string, std::string>& changes,
+                     std::map<std::string, std::string>& env);
+
+// The folder for an account the person adds, from what they typed: a name
+// ("Work" -> ~/.claude-work) or a folder (absolute or ~/...) inside the home
+// folder. nullopt and why when it can't be one.
+std::optional<base::FilePath> NewAccountDir(const AccountVendor& vendor,
+                                            const base::FilePath& home,
+                                            const std::string& typed,
+                                            std::string* error);
+
+// A space -> vendor -> account id mapping by names: a space whose name goes
+// with an account's label (Work and "work", Personal and "Home") gets that
+// account. Only vendors with two accounts or more; spaces that match nothing
+// keep the default. `spaces`: {id, name}.
+base::DictValue SuggestAccounts(
+    const std::vector<Account>& accounts,
+    const std::vector<std::pair<std::string, std::string>>& spaces);
+
+// The command that starts the vendor's sign-in as `dir` in a terminal.
+std::string AccountLoginCommand(const AccountVendor& vendor,
+                                const base::FilePath& home,
+                                const base::FilePath& dir);
+
+}  // namespace meridian::ai
+
+#endif  // CHROME_BROWSER_MERIDIAN_AI_ACCOUNTS_H_
