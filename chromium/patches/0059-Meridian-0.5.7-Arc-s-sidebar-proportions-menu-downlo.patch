+  // Arc's +: New Space, New Folder, New Split, New Tab (the + turns into ×).
+  protected onAddSpaceClick_(e: MouseEvent) {
+    if (this.menu_?.plus) {
+      this.menu_ = null;
+      return;
+    }
+    const space = this.activeSpace();
+    const r = (e.currentTarget as HTMLElement).getBoundingClientRect();
+    this.menu_ = {
+      x: r.right + 4,
+      y: r.top - 8,
+      sel: -1,
+      sub: null,
+      plus: true,
+      entries: [
+        {label: 'New Space', icon: 'layers', action: () => this.addSpace()},
+        {
+          label: 'New Folder',
