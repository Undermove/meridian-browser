From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 23 Nov 2026 23:26:56 +0400
Subject: [PATCH 237/297] Meridian: permission cards take a moment before they
 can be approved

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../resources/webui_browser/meridian/agent_asks.ts   | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/chrome/browser/resources/webui_browser/meridian/agent_asks.ts b/chrome/browser/resources/webui_browser/meridian/agent_asks.ts
index 7349eaafcc..4732f30fa8 100644
--- a/chrome/browser/resources/webui_browser/meridian/agent_asks.ts
+++ b/chrome/browser/resources/webui_browser/meridian/agent_asks.ts
@@ -54,6 +54,8 @@ function toolText(tool: string): string {
   }
 }
 
+const ALLOW_DELAY_MS = 600;
+
 export class MeridianAgentAsksElement extends CrLitElement {
   static get is() {
     return 'meridian-agent-asks';
@@ -86,6 +88,9 @@ export class MeridianAgentAsksElement extends CrLitElement {
     const nodes = new Map<string, MissionNode>(
         (s?.nodes || []).map(n => [n.id, n]));
     return asks.filter(a => !this.hidden_.has(a.id)).map(ask => {
+      if (!this.shownAt_.has(ask.id)) {
+        this.shownAt_.set(ask.id, performance.now());
+      }
       const node = nodes.get(ask.nodeId);
       const space = node?.spaceId ?
           (s?.spaces || []).find(sp => sp.id === node.spaceId) :
@@ -101,7 +106,14 @@ export class MeridianAgentAsksElement extends CrLitElement {
     });
   }
 
+  // When each card appeared: a click meant for the page can't approve it.
+  private readonly shownAt_ = new Map<string, number>();
+
   protected answer_(ask: MissionAsk, choice: string) {
+    if (choice !== 'deny' &&
+        performance.now() - (this.shownAt_.get(ask.id) ?? 0) < ALLOW_DELAY_MS) {
+      return;
+    }
     this.busy_ = ask.id;
     this.fire('meridian-ask-answer', {id: ask.id, choice});
   }
