+namespace {
+
+// The text blocks of one message's content, or "".
+std::string TextOf(const base::ListValue* content) {
+  std::string out;
+  if (!content) {
+    return out;
+  }
+  for (const base::Value& block : *content) {
+    if (!block.is_dict()) {
+      continue;
+    }
+    const std::string* type = block.GetDict().FindString("type");
+    const std::string* text = block.GetDict().FindString("text");
+    if (type && text && (*type == "text" || *type == "output_text") &&
+        !text->empty()) {
+      if (!out.empty()) {
+        out += "\n\n";
+      }
+      out += *text;
+    }
+  }
+  return out;
+}
+
+std::string AnswerInLine(std::string_view line) {
+  std::optional<base::DictValue> d =
+      base::JSONReader::ReadDict(line, base::JSON_PARSE_RFC);
+  if (!d) {
+    return std::string();
+  }
+  const std::string* type = d->FindString("type");
+  if (!type) {
+    return std::string();
+  }
+  if (*type == "assistant") {  // Claude Code
+    const base::DictValue* message = d->FindDict("message");
+    return message ? TextOf(message->FindList("content")) : std::string();
+  }
+  if (*type == "response_item") {  // Codex
+    const base::DictValue* payload = d->FindDict("payload");
+    const std::string* role = payload ? payload->FindString("role") : nullptr;
+    return role && *role == "assistant"
+               ? TextOf(payload->FindList("content"))
+               : std::string();
+  }
+  return std::string();
+}
+
+}  // namespace
+
+std::string LastAnswerInTranscript(const base::FilePath& transcript) {
+  constexpr int64_t kTail = 8 << 20;
+  base::File f(transcript, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!f.IsValid()) {
+    return std::string();
+  }
+  const int64_t size = f.GetLength();
+  const int64_t from = std::max<int64_t>(0, size - kTail);
+  std::string text(static_cast<size_t>(size - from), '\0');
+  const std::optional<size_t> got =
+      f.Read(from, base::as_writable_byte_span(text));
+  if (!got) {
+    return std::string();
+  }
+  text.resize(*got);
+  std::string_view rest(text);
+  while (!rest.empty()) {
+    // The newline before this last line (its own final one aside).
+    const size_t nl =
+        rest.size() < 2 ? std::string_view::npos
+                        : rest.rfind('\n', rest.size() - 2);
+    const bool first = nl == std::string_view::npos;
+    std::string_view line = first ? rest : rest.substr(nl + 1);
+    std::string answer =
+        AnswerInLine(base::TrimWhitespaceASCII(line, base::TRIM_ALL));
+    if (!answer.empty()) {
+      return answer;
+    }
+    if (first) {
+      break;
+    }
+    rest = rest.substr(0, nl + 1);
+  }
+  return std::string();
+}
+
 }  // namespace meridian::workbench
