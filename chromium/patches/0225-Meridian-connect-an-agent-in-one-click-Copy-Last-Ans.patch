+void AgentService::AskForAccess(const std::string& client,
+                                base::DictValue request,
+                                Reply reply) {
+  const bool first = waiting_for_access_.empty();
+  waiting_for_access_.emplace_back(std::move(request), std::move(reply));
+  if (!first) {
+    return;
+  }
+  BrowserWindowInterface* window = Window();
+  if (!window) {
+    return OnAccessAnswer(false);
+  }
+  SidebarHandler::AskAgent(
+      window, client,
+      "control Meridian: open pages, click and type,\n"
+      "also on sites where you are signed in",
+      base::BindOnce(&AgentService::OnAccessAnswer,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void AgentService::OnAccessAnswer(bool allowed) {
+  PrefService* prefs = profile_->GetPrefs();
+  if (allowed) {
+    // In this order: "decided" with access still off closes the socket.
+    prefs->SetString(prefs::kAgentAccess, "full");
+    prefs->SetBoolean(prefs::kAgentAccessDecided, true);
+  }
+  auto waiting = std::move(waiting_for_access_);
+  waiting_for_access_.clear();
+  for (auto& [request, reply] : waiting) {
+    if (!allowed) {
+      request.Set("access_declined", true);
+    }
+    Handle(std::move(request), std::move(reply));
+  }
+  if (!allowed) {
+    // After the answers have left: this closes the socket they go through.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<AgentService> self) {
+              if (self) {
+                self->profile_->GetPrefs()->SetBoolean(
+                    prefs::kAgentAccessDecided, true);
+              }
+            },
+            weak_factory_.GetWeakPtr()),
+        base::Seconds(1));
+  }
+}
+
