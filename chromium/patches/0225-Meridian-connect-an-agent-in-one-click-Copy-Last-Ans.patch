+      !profile_->GetPrefs()->GetBoolean(prefs::kAgentAccessDecided)) {
+    const std::string* who = request.FindString("client");
+    const std::string client = who ? who->substr(0, 60) : "An agent";
+    return AskForAccess(client, std::move(request), std::move(reply));
+  }
   auto call = std::make_unique<Call>();
