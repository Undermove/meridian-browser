From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Meridian <meridian@localhost>
Date: Thu, 26 Nov 2026 14:20:28 +0400
Subject: [PATCH] Meridian: moving in on Windows says what comes and what
 can't, without the Mac's keychain question

Windows showed the Mac's "Your Mac will ask for permission" card with its
Chrome Safe Storage drawing before reading a browser's sign-ins; Windows asks
nothing (the key is the person's own), so the card is the Mac's only.

Chrome (127+) locks its sign-ins to itself on Windows (App-Bound
Encryption): another browser can't read them. The option says so off the
Mac ("Saved passwords and cards too", sign-ins where the browser lets
another read them). After a move that brought no sign-ins and no
passwords, the note says how to bring the passwords (Export passwords in
that browser, then import the file) with a button to Meridian's Password
Manager settings, whose Import passwords takes it. Where to import again is
the Meridian menu on Windows, not the Mac's menu bar; a browser that's open
is closed, not quit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../webui_browser/meridian/onboarding.html.ts | 14 ++++++++--
 .../webui_browser/meridian/onboarding.ts      | 28 ++++++++++++++++---
 2 files changed, 36 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/resources/webui_browser/meridian/onboarding.html.ts b/chrome/browser/resources/webui_browser/meridian/onboarding.html.ts
index bb58f6a234..217887c616 100644
--- a/chrome/browser/resources/webui_browser/meridian/onboarding.html.ts
+++ b/chrome/browser/resources/webui_browser/meridian/onboarding.html.ts
@@ -6,7 +6,7 @@ import {html, repeat} from '//resources/lit/v3_0/lit.rollup.js';
 
 import {icon} from './icons.js';
 import type {MeridianOnboardingElement} from './onboarding.js';
-import {claudeApp, keyCaps} from './keys.js';
+import {claudeApp, isMac, keyCaps} from './keys.js';
 
 export function getHtml(this: MeridianOnboardingElement) {
   return html`<!--_html_template_start_-->
@@ -126,9 +126,15 @@ export function getHtml(this: MeridianOnboardingElement) {
               <button id="logins" class="opt ${this.withLogins_ ? 'on' : ''}"
                   @click="${this.onLoginsClick_}">
                 <span class="opt-ic">${icon('lock', 16)}</span>
+                ${isMac ? html`
                 <span><b>Stay signed in to your sites</b>
                   <em>Sign-ins, saved passwords and cards, so you don’t have
-                    to log in everywhere again</em></span>
+                    to log in everywhere again</em></span>` : html`
+                <span><b>Saved passwords and cards too</b>
+                  <em>And sign-ins where ${this.sourceName_} lets another
+                    browser read them: Chrome and others lock theirs to
+                    themselves, and then sites ask you to sign in once
+                    more</em></span>`}
                 <span class="tick">${icon('check', 13)}</span>
               </button>` : ''}
           </div>`}
@@ -257,6 +263,10 @@ export function getHtml(this: MeridianOnboardingElement) {
             <p class="whisper">Press ${keyCaps('⌘T').map(k => html`<kbd>${k}</kbd>`)} to open a new tab
               or find anything you had open.</p>
             ${this.note_ ? html`<p class="whisper">${this.note_}</p>` : ''}
+            ${this.passwordsFile_ ? html`
+              <button id="passwordsFile" class="pill"
+                  @click="${this.onPasswordsFileClick_}">
+                ${icon('lock', 15)} Import passwords from a file</button>` : ''}
             <div class="tries">
               <button class="try" data-try="ask" @click="${this.onTryClick_}">
                 <span class="try-ic">${icon('sparkles', 17)}</span>
diff --git a/chrome/browser/resources/webui_browser/meridian/onboarding.ts b/chrome/browser/resources/webui_browser/meridian/onboarding.ts
index a7045787e9..d0face13ea 100644
--- a/chrome/browser/resources/webui_browser/meridian/onboarding.ts
+++ b/chrome/browser/resources/webui_browser/meridian/onboarding.ts
@@ -24,6 +24,7 @@ import './mac_ask.js';
 import './showcase.js';
 
 import {IMPORT_KINDS, IMPORT_SOURCES, sourceName} from './import_sources.js';
+import {isMac} from './keys.js';
 import {getCss} from './onboarding.css.js';
 import {getHtml} from './onboarding.html.js';
 
@@ -150,6 +151,7 @@ export class MeridianOnboardingElement extends CrLitElement {
       thinking_: {state: true, type: Boolean},
       useApps_: {state: true, type: Boolean},
       note_: {state: true, type: String},
+      passwordsFile_: {state: true, type: Boolean},
       dots_: {state: true, type: Array},
       stepIndex_: {state: true, type: Number},
       nextLabel_: {state: true, type: String},
@@ -210,6 +212,9 @@ export class MeridianOnboardingElement extends CrLitElement {
   protected accessor useApps_: boolean = true;
   // A line under the Arc step after an import (e.g. sign-ins not brought).
   protected accessor note_: string = '';
+  // Under the note: the browser's passwords didn't come (Windows: locked to
+  // it), so a button to import the file it exports.
+  protected accessor passwordsFile_: boolean = false;
 
   // Derived in willUpdate() for the template.
   protected accessor dots_: Dot[] = [];
@@ -298,6 +303,7 @@ export class MeridianOnboardingElement extends CrLitElement {
     this.thinking_ = false;
     this.useApps_ = true;
     this.note_ = '';
+    this.passwordsFile_ = false;
     this.busy_ = '';
     this.aiFound_ = [];
     this.aiYes_ = false;
@@ -348,6 +354,10 @@ export class MeridianOnboardingElement extends CrLitElement {
 
   // Where to move in from this browser again, as the menu says it.
   protected importPath_(): string {
+    if (!isMac) {
+      // Windows: the menu at the left of the top bar (sidebar.ts).
+      return `the Meridian menu › Import from ${this.sourceName_}`;
+    }
     return this.source_ === 'arc' ?
         'File › Import from Arc' :
         `Meridian › Import from Another Browser (${this.sourceName_})`;
@@ -363,6 +373,7 @@ export class MeridianOnboardingElement extends CrLitElement {
     if (!this.busy_ && kind !== this.source_) {
       this.useSource_(kind);
       this.note_ = '';
+      this.passwordsFile_ = false;
     }
   }
 
@@ -890,6 +901,12 @@ export class MeridianOnboardingElement extends CrLitElement {
     this.note_ = 'Back to how it was.';
   }
 
+  // Meridian's Passwords, where Import passwords takes the browser's file.
+  protected onPasswordsFileClick_() {
+    this.fire('meridian-open-url', 'chrome://password-manager/settings');
+    this.finish_();
+  }
+
   protected onGetClaudeClick_() {
     this.fire('meridian-open-url', 'https://claude.ai/download');
     this.finish_();
@@ -904,8 +921,10 @@ export class MeridianOnboardingElement extends CrLitElement {
   // ------------------------------------------------------------ actions
 
   private async bringArc_(confirmed = false) {
-    // Reading Arc's sign-ins makes macOS ask; say so first.
-    if (this.withLogins_ && this.arc_?.loginsAvailable && !confirmed) {
+    // Reading Arc's sign-ins makes macOS ask; say so first. (Windows asks
+    // nothing: the key is the person's own.)
+    if (isMac && this.withLogins_ && this.arc_?.loginsAvailable &&
+        !confirmed) {
       this.confirmLogins_ = true;
       return;
     }
@@ -922,13 +941,14 @@ export class MeridianOnboardingElement extends CrLitElement {
       this.note_ = error === 'denied' ?
           `Sign-ins weren’t brought over. You can try again from ${this.importPath_()}.` :
           error === 'app-bound' ?
-          `${name} keeps its sign-ins locked to itself on Windows, so sign in to your sites once more${more.length ? ` (${more.join(', ')} came over)` : ''}.` :
+          `${name} locks its sign-ins to itself, so no other browser can read them: sign in to your sites once more${more.length ? ` (${more.join(', ')} came over)` : ''}.${passwords ? '' : ` For its passwords, use Export passwords in ${name}’s password manager settings, then import that file here.`}` :
           error === 'busy' ?
-          `Sign-ins weren’t brought over: ${name} is open. Quit ${name}, then try again from ${this.importPath_()}.` :
+          `Sign-ins weren’t brought over: ${name} is open. Close every ${name} window, then try again from ${this.importPath_()}.` :
           error ? `${name}’s sign-ins couldn’t be read.` :
                   `You’re still signed in to your sites (${
                       [count(imported, 'sign-in'), ...more].join(
                           ', ')} brought over).`;
+      this.passwordsFile_ = error === 'app-bound' && !passwords;
     }
     // History, permissions, sites' data and the rest: nothing to ask.
     if (ok && this.arc_?.dataAvailable) {
-- 
