+void SidebarHandler::TestFloatingWindows(
+    TestFloatingWindowsCallback callback) {
+  std::vector<std::string> out;
+  if (!HasTestSwitch("meridian-test-keys")) {
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+  for (NSWindow* window in NSApp.windows) {
+    views::Widget* widget =
+        views::Widget::GetWidgetForNativeWindow(gfx::NativeWindow(window));
+    if (!widget || !window.isVisible || window.level < NSFloatingWindowLevel) {
+      continue;
+    }
+    const NSWindowCollectionBehavior behavior = window.collectionBehavior;
+    std::string line = base::SysNSStringToUTF8(NSStringFromClass([window class]));
+    line += " allSpaces=";
+    line += (behavior & NSWindowCollectionBehaviorCanJoinAllSpaces) ? "1" : "0";
+    line += " fullScreenSpaces=";
+    line +=
+        (behavior & NSWindowCollectionBehaviorFullScreenAuxiliary) ? "1" : "0";
+    const gfx::Size size = widget->GetClientAreaBoundsInScreen().size();
+    line += " top=" + base::NumberToString(widget->GetNonClientComponent(
+                          gfx::Point(size.width() / 2, 12)));
+    line += " page=" + base::NumberToString(widget->GetNonClientComponent(
+                           gfx::Point(size.width() / 2, size.height() * 2 / 5)));
+    out.push_back(std::move(line));
+  }
+  std::move(callback).Run(std::move(out));
+}
