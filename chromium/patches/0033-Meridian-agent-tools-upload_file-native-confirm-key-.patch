+    // upload_file: marks the <input type=file> to fill (by index, selector,
+    // or the only one on the page) for the browser to find through DevTools.
+    markFileInput(spec) {
+      let el = null;
+      if (Number.isInteger(spec.element_index)) el = (window.__meridianEls || [])[spec.element_index];
+      else if (spec.selector) {
+        try { el = deepOne(spec.selector); } catch (e) { return {error: 'invalid selector'}; }
+      }
+      const files = deepAll('input[type=file]');
+      const isFile = (e) => e && e.tagName === 'INPUT' && e.type === 'file';
+      if (el && !isFile(el)) {
+        el = (el.shadowRoot && el.shadowRoot.querySelector('input[type=file]')) || (el.querySelector && el.querySelector('input[type=file]')) ||
+            (el.closest && el.closest('label') && el.closest('label').querySelector('input[type=file]')) || null;
+      }
+      if (!el && !spec.selector && !Number.isInteger(spec.element_index)) el = files.length === 1 ? files[0] : null;
+      if (!isFile(el)) {
+        return {error: files.length ? 'pick the file field: element_index or selector of an <input type=file> (' + files.length + ' on the page)' : 'no file field on this page — open the attach/upload dialog first'};
+      }
+      if (el.disabled) return {error: 'that file field is disabled'};
+      const mark = Math.random().toString(36).slice(2);
+      el.setAttribute('data-meridian-upload', mark);
+      window.__meridianUpload = el;
+      const lab = el.getAttribute('aria-label') || (el.closest('label') && el.closest('label').innerText) || el.getAttribute('name') || el.getAttribute('accept') || '';
+      return {mark, label: clip(lab, 80), multiple: el.multiple, accept: el.accept || ''};
+    },
+
+    unmarkFileInput() {
+      const el = window.__meridianUpload;
+      if (el) el.removeAttribute('data-meridian-upload');
+      window.__meridianUpload = null;
+      return true;
+    },
+
     has(text, selector) {
       if (selector) {
         try { if (deepOne(selector)) return true; } catch { return 'bad-selector'; }
