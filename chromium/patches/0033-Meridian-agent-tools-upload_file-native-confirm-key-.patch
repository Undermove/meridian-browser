+// upload_file: the file the person is asked about, or why it can't go.
+// Blocking.
+base::expected<std::pair<base::FilePath, int64_t>, std::string> CheckUpload(
+    const std::string& raw,
+    const base::FilePath& user_data) {
+  base::FilePath path(raw);
+  if (!path.IsAbsolute()) {
+    return base::unexpected("path must be an absolute path to a file");
+  }
+  base::File::Info info;
+  if (!base::GetFileInfo(path, &info)) {
+    return base::unexpected("no such file");
+  }
+  if (info.is_directory) {
+    return base::unexpected("not a file");
+  }
+  if (info.size > 1024LL * 1024 * 1024) {
+    return base::unexpected("file is over 1 GB");
+  }
+  base::FilePath real = base::MakeAbsoluteFilePath(path);
+  base::FilePath home = base::GetHomeDir();
+  std::vector<base::FilePath> forbidden = {
+      home.Append(".ssh"),         home.Append(".aws"),
+      home.Append(".gnupg"),       home.Append(".config/gh"),
+      home.Append("Library/Keychains"), home.Append(".docker"),
+      home.Append(".kube"),        base::MakeAbsoluteFilePath(user_data)};
+  bool secret = real.empty() ||
+                std::ranges::any_of(forbidden, [&](const base::FilePath& d) {
+                  return !d.empty() && (real == d || d.IsParent(real));
+                }) ||
+                RE2::PartialMatch(real.value(),
+                                  "(?i)(^|/)\\.env(\\.|$)|\\.(pem|key|p12|pfx|"
+                                  "keychain-db)$");
+  if (secret) {
+    return base::unexpected(
+        "that file holds keys or credentials; agents can’t upload it");
+  }
+  return std::make_pair(real, info.size);
+}
+
+// Puts a file into the marked <input type=file> through DevTools
+// (DOM.setFileInputFiles), then detaches. Deletes itself.
+class FileInputSetter : public content::DevToolsAgentHostClient {
+ public:
+  static void Start(content::WebContents* contents,
+                    const std::string& mark,
+                    const base::FilePath& file,
+                    base::OnceCallback<void(std::string error)> done) {
+    auto* self = new FileInputSetter(mark, file, std::move(done));
+    self->host_ = content::DevToolsAgentHost::GetOrCreateFor(contents);
+    if (!self->host_->AttachClient(self)) {
+      self->host_ = nullptr;
+      return self->Finish("couldn't reach the page");
+    }
+    self->Send("DOM.getDocument",
+               base::DictValue().Set("depth", -1).Set("pierce", true));
+  }
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(content::DevToolsAgentHost*,
+                               base::span<const uint8_t> message) override {
+    std::optional<base::Value> v = base::JSONReader::Read(
+        std::string_view(reinterpret_cast<const char*>(message.data()),
+                         message.size()),
+        0);
+    if (!v || !v->is_dict() || v->GetDict().FindInt("id") != id_) {
+      return;  // events
+    }
+    if (const base::DictValue* error = v->GetDict().FindDict("error")) {
+      const std::string* m = error->FindString("message");
+      return Finish(m ? *m : "DevTools error");
+    }
+    const base::DictValue* result = v->GetDict().FindDict("result");
+    if (!result) {
+      return Finish("DevTools error");
+    }
+    switch (step_) {
+      case 1:
+        Send("DOM.performSearch",
+             base::DictValue()
+                 .Set("query", "[data-meridian-upload=\"" + mark_ + "\"]")
+                 .Set("includeUserAgentShadowDOM", false));
+        break;
+      case 2: {
+        const std::string* search = result->FindString("searchId");
+        if (!search || result->FindInt("resultCount").value_or(0) < 1) {
+          return Finish(
+              "the file field disappeared — call get_interactive_elements "
+              "again");
+        }
+        search_ = *search;
+        Send("DOM.getSearchResults", base::DictValue()
+                                         .Set("searchId", search_)
+                                         .Set("fromIndex", 0)
+                                         .Set("toIndex", 1));
+        break;
+      }
+      case 3: {
+        const base::ListValue* ids = result->FindList("nodeIds");
+        if (!ids || ids->empty() || !(*ids)[0].is_int()) {
+          return Finish("the file field disappeared");
+        }
+        Send("DOM.setFileInputFiles",
+             base::DictValue()
+                 .Set("files", base::ListValue().Append(file_.value()))
+                 .Set("nodeId", (*ids)[0].GetInt()));
+        break;
+      }
+      default:
+        Finish(std::string());
+    }
+  }
+  void AgentHostClosed(content::DevToolsAgentHost*) override {
+    host_ = nullptr;
+    Finish("the tab is gone");
+  }
+  bool MayReadLocalFiles() override { return true; }
+
+ private:
+  friend class base::DeleteHelper<FileInputSetter>;
+
+  FileInputSetter(std::string mark,
+                  base::FilePath file,
+                  base::OnceCallback<void(std::string)> done)
+      : mark_(std::move(mark)), file_(std::move(file)), done_(std::move(done)) {}
+  ~FileInputSetter() override = default;
+
+  void Send(const std::string& method, base::DictValue params) {
+    ++step_;
+    std::string json =
+        base::WriteJson(base::DictValue()
+                            .Set("id", ++id_)
+                            .Set("method", method)
+                            .Set("params", std::move(params)))
+            .value_or("{}");
+    host_->DispatchProtocolMessage(this, base::as_byte_span(json));
+  }
+
+  void Finish(std::string error) {
+    if (host_) {
+      host_->DetachClient(this);
+      host_ = nullptr;
+    }
+    // Not from inside the host's dispatch.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done_), std::move(error)));
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                               this);
+  }
+
+  std::string mark_;
+  base::FilePath file_;
+  base::OnceCallback<void(std::string)> done_;
+  scoped_refptr<content::DevToolsAgentHost> host_;
+  int id_ = 0;
+  int step_ = 0;
+  std::string search_;
+};
