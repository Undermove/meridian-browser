+void AgentService::UploadFile(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  Activity(*call, tab);
+  std::string raw = call->StrOr("path", "");
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&CheckUpload, raw, profile_->GetPath().DirName()),
+      base::BindOnce(&AgentService::UploadChecked, weak_factory_.GetWeakPtr(),
+                     tab->GetHandle(), std::move(call)));
+}
+
+void AgentService::UploadChecked(
+    tabs::TabHandle handle,
+    std::unique_ptr<Call> call,
+    base::expected<std::pair<base::FilePath, int64_t>, std::string> file) {
+  tabs::TabInterface* tab = handle.Get();
+  if (!tab) {
+    return call->Fail("the tab is gone");
+  }
+  if (!file.has_value()) {
+    return call->Fail(file.error());
+  }
+  base::DictValue spec;
+  for (const char* key : {"element_index", "selector"}) {
+    if (const base::Value* v = call->input.Find(key)) {
+      spec.Set(key, v->Clone());
+    }
+  }
+  RunInPage(
+      tab->GetContents(),
+      "__meridianAgent.markFileInput(" + base::WriteJson(spec).value_or("{}") +
+          ")",
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+             std::unique_ptr<Call> call, base::FilePath real, int64_t size,
+             base::Value target) {
+            tabs::TabInterface* tab = handle.Get();
+            if (!self || !tab || !target.is_dict()) {
+              return call->Fail("couldn't look at the page");
+            }
+            const base::DictValue& t = target.GetDict();
+            if (const std::string* error = t.FindString("error")) {
+              return call->Fail(*error);
+            }
+            std::string mark = *t.FindString("mark");
+            std::string label = t.FindString("label") && !t.FindString("label")->empty()
+                                    ? *t.FindString("label")
+                                    : "file field";
+            std::string mb =
+                size >= 1024 * 1024
+                    ? base::StringPrintf("%.1f MB", size / 1024.0 / 1024.0)
+                    : base::NumberToString(
+                          std::max<int64_t>(1, (size + 512) / 1024)) +
+                          " KB";
+            content::WebContents* contents = tab->GetContents();
+            std::string host(contents->GetLastCommittedURL().host());
+            // Always asked, whatever the access level: a local file leaves
+            // the computer.
+            workbench::AskNative(
+                contents,
+                "Upload a file from your computer to " + host + "?",
+                (call->client.empty() ? std::string("An agent") : call->client) +
+                    " wants to upload:\n" + real.value() + "\nSize: " + mb +
+                    "\nInto: “" + label + "”",
+                {"Don’t upload", "Upload this file"},
+                base::BindOnce(
+                    [](base::WeakPtr<AgentService> self,
+                       tabs::TabHandle handle, std::unique_ptr<Call> call,
+                       std::string mark, base::FilePath real, std::string mb,
+                       std::string label, int choice) {
+                      tabs::TabInterface* tab = handle.Get();
+                      if (!self || !tab) {
+                        return call->Fail("the tab is gone");
+                      }
+                      content::WebContents* contents = tab->GetContents();
+                      if (choice != 1) {
+                        self->RunInPage(contents,
+                                        "__meridianAgent.unmarkFileInput()",
+                                        base::DoNothing());
+                        return call->Fail("The person declined this upload.");
+                      }
+                      FileInputSetter::Start(
+                          contents, mark, real,
+                          base::BindOnce(
+                              [](base::WeakPtr<AgentService> self,
+                                 tabs::TabHandle handle,
+                                 std::unique_ptr<Call> call,
+                                 base::FilePath real, std::string mb,
+                                 std::string label, std::string error) {
+                                if (self && handle.Get()) {
+                                  self->RunInPage(
+                                      handle.Get()->GetContents(),
+                                      "__meridianAgent.unmarkFileInput()",
+                                      base::DoNothing());
+                                }
+                                if (!error.empty()) {
+                                  return call->Fail(error);
+                                }
+                                call->Ok(base::Value(
+                                    base::DictValue()
+                                        .Set("uploaded",
+                                             real.BaseName().value())
+                                        .Set("size", mb)
+                                        .Set("into", label)));
+                              },
+                              self, handle, std::move(call), real, mb, label));
+                    },
+                    self, handle, std::move(call), mark, real, mb, label));
+          },
+          weak_factory_.GetWeakPtr(), handle, std::move(call),
+          file->first, file->second));
+}
