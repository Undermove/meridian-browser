From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 16 Nov 2026 18:18:25 +0400
Subject: [PATCH 148/151] Meridian: no crash when a focus change comes while a
 page's view is out of any window

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../browser/renderer_host/browser_compositor_view_mac.mm | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/content/browser/renderer_host/browser_compositor_view_mac.mm b/content/browser/renderer_host/browser_compositor_view_mac.mm
index 4ab8a9cf16..2882660b59 100644
--- a/content/browser/renderer_host/browser_compositor_view_mac.mm
+++ b/content/browser/renderer_host/browser_compositor_view_mac.mm
@@ -101,8 +101,13 @@ const gfx::CALayerParams* BrowserCompositorMac::GetLastCALayerParams() const {
 }
 
 viz::FrameSinkId BrowserCompositorMac::GetRootFrameSinkId() {
-  if (parent_ui_layer_)
-    return parent_ui_layer_->GetCompositor()->frame_sink_id();
+  if (parent_ui_layer_) {
+    // Meridian: the view's parent layer can be out of any window for a moment
+    // (a tab moving between windows, or its window closing) while its page
+    // still reports a focus change: no root then, as with no layer at all.
+    ui::Compositor* compositor = parent_ui_layer_->GetCompositor();
+    return compositor ? compositor->frame_sink_id() : viz::FrameSinkId();
+  }
   if (recyclable_compositor_)
     return recyclable_compositor_->compositor()->frame_sink_id();
   return viz::FrameSinkId();
