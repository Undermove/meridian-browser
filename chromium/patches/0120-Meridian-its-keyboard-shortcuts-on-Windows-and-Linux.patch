diff --git a/chrome/browser/resources/webui_browser/meridian/keys.ts b/chrome/browser/resources/webui_browser/meridian/keys.ts
new file mode 100644
index 0000000000..f5a2dc6982
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/keys.ts
@@ -0,0 +1,71 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Keyboard shortcuts as each system writes them. The UI's texts name them the
+// macOS way ("⇧⌘C"); on Windows and Linux the same texts read "Ctrl+Shift+C".
+// The keys themselves are set in the browser: chrome/browser/ui/
+// accelerator_table.cc (Windows, Linux) and ui/cocoa/accelerators_cocoa.mm.
+
+export const isMac = navigator.userAgent.includes('Mac');
+
+// Shortcuts that aren't the macOS one with Ctrl for ⌘ and Alt for ⌥.
+const OTHER: Record<string, string> = {
+  // Ctrl+Shift+= zooms in there.
+  '⌃⇧=': 'Ctrl+Alt+=',
+  '⌃⇧-': 'Ctrl+Alt+-',
+  // Ctrl+1–9 are the tabs there.
+  '⌃1–9': 'Alt+1–9',
+  // History, as every browser there has it.
+  '⌘Y': 'Ctrl+H',
+  // Downloads have no shortcut there (Ctrl+Shift+J is the DevTools console).
+  '⇧⌘J': '',
+};
+
+const KEY_NAMES: Record<string, string> = {
+  '⇥': 'Tab',
+  '↵': 'Enter',
+};
+
+function convert(mac: string): string {
+  const known = OTHER[mac];
+  if (known !== undefined) {
+    return known;
+  }
+  const parts: string[] = [];
+  if (mac.includes('⌘') || mac.includes('⌃')) {
+    parts.push('Ctrl');
+  }
+  if (mac.includes('⌥')) {
+    parts.push('Alt');
+  }
+  if (mac.includes('⇧')) {
+    parts.push('Shift');
+  }
+  const key = mac.replace(/[⌘⌃⌥⇧]/g, '');
+  if (key) {
+    parts.push(KEY_NAMES[key] || key);
+  }
+  return parts.join('+');
+}
+
+// `text` with every shortcut in it written for this system: "Copy Link
+// (⇧⌘C)" is "Copy Link (Ctrl+Shift+C)" off macOS. A shortcut the system
+// doesn't have goes, with its brackets.
+export function keyText(text: string): string {
+  if (isMac) {
+    return text;
+  }
+  return text
+      .replace(/[⌘⌃⌥⇧]+(1–9|[A-Za-z0-9,=\-←→↑↓⇥↵])?/g, convert)
+      .replace(' ()', '');
+}
+
+// The keys of a shortcut one by one, for a row of key caps: ⌘ and T on
+// macOS, Ctrl and T elsewhere.
+export function keyCaps(mac: string): string[] {
+  if (isMac) {
+    return Array.from(mac);
+  }
+  return keyText(mac).split('+').filter(k => k);
+}
