diff --git a/chrome/browser/meridian/arc_logins_win.cc b/chrome/browser/meridian/arc_logins_win.cc
new file mode 100644
index 0000000000..ee91e97ce6
--- /dev/null
+++ b/chrome/browser/meridian/arc_logins_win.cc
@@ -0,0 +1,71 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/arc_logins.h"
+
+#include <windows.h>
+
+#include <dpapi.h>
+
+#include <optional>
+#include <string>
+
+#include "base/base64.h"
+#include "base/containers/span.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
+#include "chrome/browser/meridian/arc_import.h"
+#include "third_party/boringssl/src/include/openssl/mem.h"
+
+namespace meridian::internal {
+
+// Arc on Windows keeps the key its cookies and passwords are encrypted with
+// as Chromium does there: in "Local State" beside the profiles, under
+// os_crypt.encrypted_key, base64 of "DPAPI" and the key as Windows's data
+// protection wrapped it for this account. Only this account can unwrap it,
+// and Windows doesn't ask.
+std::vector<uint8_t> ReadArcOsCryptKey(std::string* error) {
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(
+          ArcDataDir().AppendASCII("User Data").AppendASCII("Local State"),
+          &json, 16 * 1024 * 1024)) {
+    *error = "no-data";
+    return {};
+  }
+  std::optional<base::Value> state = base::JSONReader::Read(json, 0);
+  const std::string* encoded =
+      state && state->is_dict()
+          ? state->GetDict().FindStringByDottedPath("os_crypt.encrypted_key")
+          : nullptr;
+  std::optional<std::vector<uint8_t>> wrapped =
+      encoded ? base::Base64Decode(*encoded) : std::nullopt;
+  static constexpr std::string_view kPrefix = "DPAPI";
+  if (!wrapped || wrapped->size() <= kPrefix.size() ||
+      base::as_string_view(base::span(*wrapped).first(kPrefix.size())) !=
+          kPrefix) {
+    *error = "not-found";
+    return {};
+  }
+  base::span<uint8_t> data = base::span(*wrapped).subspan(kPrefix.size());
+  DATA_BLOB in = {static_cast<DWORD>(data.size()), data.data()};
+  DATA_BLOB out = {};
+  if (!::CryptUnprotectData(&in, nullptr, nullptr, nullptr, nullptr,
+                            CRYPTPROTECT_UI_FORBIDDEN, &out)) {
+    *error = "denied";
+    return {};
+  }
+  // SAFETY: CryptUnprotectData returns `cbData` bytes at `pbData`.
+  auto plain = UNSAFE_BUFFERS(base::span(out.pbData, size_t{out.cbData}));
+  std::vector<uint8_t> key(plain.begin(), plain.end());
+  OPENSSL_cleanse(plain.data(), plain.size());
+  ::LocalFree(out.pbData);
+  if (key.size() != 32) {
+    *error = "read";
+    return {};
+  }
+  return key;
+}
+
+}  // namespace meridian::internal
