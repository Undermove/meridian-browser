diff --git a/chrome/browser/resources/webui_browser/meridian/rows.css b/chrome/browser/resources/webui_browser/meridian/rows.css
index e25cc28c31..f71a87baf9 100644
--- a/chrome/browser/resources/webui_browser/meridian/rows.css
+++ b/chrome/browser/resources/webui_browser/meridian/rows.css
@@ -323,6 +323,32 @@ input.rename {
   box-shadow: 3px 0 0 var(--meridian-space);
 }
 
+/* Put to sleep: the favicon dims, with a small moon at its corner, until
+   the tab loads again. */
+.row.asleep .favicon {
+  position: relative;
+  overflow: visible;
+}
+
+.row.asleep .favicon img {
+  opacity: 0.45;
+  filter: grayscale(0.7);
+}
+
+.row.asleep .moon {
+  position: absolute;
+  right: -3px;
+  bottom: -3px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 11px;
+  height: 11px;
+  border-radius: 50%;
+  background: var(--meridian-surface);
+  color: var(--meridian-text-muted);
+}
+
 /* Loading: the favicon pulses (Electron: .row.loading .favicon). */
 .row.loading .favicon {
   animation: pulse 1s ease-in-out infinite;
