diff --git a/chrome/browser/meridian/sidebar.mojom b/chrome/browser/meridian/sidebar.mojom
index c44a160c4b..10c82edb88 100644
--- a/chrome/browser/meridian/sidebar.mojom
+++ b/chrome/browser/meridian/sidebar.mojom
@@ -97,6 +97,8 @@ struct TabInfo {
   // A Peek card over `opener_id` (see TabData::peek()).
   bool peek;
   tabs_api.mojom.NodeId? opener_id;
+  // Put to sleep (discarded) and not loaded again yet: the sidebar dims it.
+  bool asleep;
 };
 
 // Two tabs side by side (Chromium split tabs), `start` on the left.
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index 6fc5c6e0da..6b0be2ce2b 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -463,6 +463,22 @@ void SidebarHandler::OnTabChangedAt(tabs::TabInterface* tab,
   if (!peek_candidates_.empty()) {
     MaybePeek(tab);
   }
+  // Put to sleep, or loading again: the sidebar's sleeping look.
+  if (IsAsleep(tab) != asleep_.contains(tab->GetHandle().raw_value())) {
+    ScheduleNotify();
+  }
+}
+
+// static
+bool SidebarHandler::IsAsleep(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  if (!contents || contents->IsLoading()) {
+    return false;
+  }
+  auto* unit =
+      resource_coordinator::TabLifecycleUnitExternal::FromWebContents(contents);
+  return (unit && unit->GetTabState() == ::mojom::LifecycleUnitState::DISCARDED) ||
+         contents->WasDiscarded();
 }
 
 void SidebarHandler::ExpandPeek(const tabs_api::NodeId& tab_id) {
@@ -534,9 +550,13 @@ void SidebarHandler::PutTabToSleep(const tabs_api::NodeId& tab_id,
     std::move(callback).Run("form");
     return;
   }
-  std::move(callback).Run(
-      unit->DiscardTab(::mojom::LifecycleUnitDiscardReason::EXTERNAL) ?
-          "" : "failed");
+  const bool slept =
+      unit->DiscardTab(::mojom::LifecycleUnitDiscardReason::EXTERNAL);
+  // Its sleeping look in the sidebar (a discard may not change the row).
+  if (slept) {
+    ScheduleNotify();
+  }
+  std::move(callback).Run(slept ? "" : "failed");
 }
 
 void SidebarHandler::ToggleReader(ToggleReaderCallback callback) {
@@ -3124,6 +3144,12 @@ mojom::SidebarStatePtr SidebarHandler::BuildState() {
     if (tabs::TabInterface* opener = model()->GetOpenerOfTabAt(i)) {
       info->opener_id = tabs_api::NodeId::FromTabHandle(opener->GetHandle());
     }
+    info->asleep = IsAsleep(tab);
+    if (info->asleep) {
+      asleep_.insert(tab->GetHandle().raw_value());
+    } else {
+      asleep_.erase(tab->GetHandle().raw_value());
+    }
     state->tabs.push_back(std::move(info));
     // Each split once, from its first tab.
     std::optional<split_tabs::SplitTabId> split_id = tab->GetSplit();
