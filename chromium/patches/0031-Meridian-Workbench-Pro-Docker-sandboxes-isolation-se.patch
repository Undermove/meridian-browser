+base::FilePath EventChannel::MakeTailDir() {
+  base::FilePath dir;
+  if (!base::CreateNewTempDirectory("meridian-mission-", &dir)) {
+    return base::FilePath();
+  }
+  dir = base::MakeAbsoluteFilePath(dir);
+  base::SetPosixFilePermissions(dir, 0700);
+  base::ScopedFD fd(HANDLE_EINTR(open(dir.Append("events.jsonl").value().c_str(),
+                                      O_WRONLY | O_CREAT | O_EXCL, 0600)));
+  return fd.is_valid() ? dir : base::FilePath();
+}
