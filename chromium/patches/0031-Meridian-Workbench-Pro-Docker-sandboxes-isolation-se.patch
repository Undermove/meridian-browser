+std::string ReadDockerfile() {
+  std::string text;
+  base::ReadFileToString(
+      WorkbenchSource::Folder().Append("sandbox").Append("Dockerfile"), &text);
+  return text;
+}
+
+base::FilePath ReviewPath(Profile* profile) {
+  return profile->GetPath().Append("Meridian Workbench Review.json");
+}
+
+base::DictValue LoadJson(const base::FilePath& file) {
+  std::string json;
+  base::ReadFileToString(file, &json);
+  std::optional<base::Value> v = base::JSONReader::Read(json, 0);
+  return v && v->is_dict() ? std::move(v->GetDict()) : base::DictValue();
+}
+
+void SaveJson(const base::FilePath& file, const base::DictValue& value) {
+  if (base::WriteFile(file, base::WriteJson(value).value_or("{}"))) {
+    base::SetPosixFilePermissions(file, 0600);
+  }
+}
+
+}  // namespace
+
+void WorkbenchHandler::SandboxCall(const std::string& method,
+                                   const base::ListValue& params,
+                                   Reply reply) {
+  bool flag = !params.empty() && params[0].is_bool() && params[0].GetBool();
+  if (method == "sandboxNetwork") {
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::FilePath file, bool on) -> Result {
+              base::DictValue store = LoadStore(file);
+              store.Set("sandboxNetwork", on);
+              SaveStore(file, store);
+              return base::Value(on);
+            },
+            StorePath(), flag),
+        std::move(reply));
+    return;
+  }
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce([]() -> Result {
+        return base::Value(SandboxStatus(TerminalEnv(), ReadDockerfile()));
+      }),
+      std::move(reply));
+}
+
+void WorkbenchHandler::ReviewSandboxChanges(
+    base::OnceCallback<void(bool)> go) {
+  if (!project_) {
+    return std::move(go).Run(true);
+  }
+  std::string root = project_->root().value();
+  bool running = sandboxes_running_.contains(root);
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath review_file, std::string root, bool running)
+              -> std::optional<base::ListValue> {
+            base::DictValue review = LoadJson(review_file);
+            const base::DictValue* base_entry = review.FindDict(root);
+            if (!base_entry) {
+              return std::nullopt;
+            }
+            base::DictValue current = AutoExecSnapshot(base::FilePath(root));
+            const base::DictValue* snapshot = base_entry->FindDict("snapshot");
+            base::DictValue none;
+            base::ListValue changes =
+                SnapshotDiff(snapshot ? *snapshot : none, current);
+            if (changes.empty()) {
+              // Nothing to look at: settle now.
+              if (running) {
+                review.Set(root, base::DictValue().Set("snapshot",
+                                                       std::move(current)));
+              } else {
+                review.Remove(root);
+              }
+              SaveJson(review_file, review);
+              return std::nullopt;
+            }
+            return std::optional<base::ListValue>(std::move(changes));
+          },
+          ReviewPath(profile_), root, running),
+      base::BindOnce(
+          [](base::WeakPtr<WorkbenchHandler> self, std::string root,
+             bool running, base::OnceCallback<void(bool)> go,
+             std::optional<base::ListValue> changes) {
+            if (!self) {
+              return;
+            }
+            if (!changes) {
+              return std::move(go).Run(true);
+            }
+            std::string lines;
+            for (size_t i = 0; i < changes->size() && i < 15; ++i) {
+              const base::DictValue& c = (*changes)[i].GetDict();
+              lines += "• " + *c.FindString("change") + ": " +
+                       ai::OneLine(*c.FindString("path"), 160) + "\n";
+            }
+            if (changes->size() > 15) {
+              lines += "…and " + base::NumberToString(changes->size() - 15) +
+                       " more\n";
+            }
+            AskNative(
+                self->web_ui()->GetWebContents(),
+                "A sandboxed agent changed files that run code on this "
+                "computer",
+                "In " + ai::OneLine(root, 200) +
+                    (running ? " (a sandbox is still running there)" : "") +
+                    ":\n" + lines +
+                    "\nGit hooks and config, Claude Code / Codex / Gemini "
+                    "settings, MCP servers, editor tasks, direnv and similar "
+                    "files can run commands when you next use git, an agent "
+                    "or your editor in this folder. Look at them first (the "
+                    "file tree shows hidden files with the eye button).",
+                {"Cancel", "Start anyway"},
+                base::BindOnce(
+                    [](base::WeakPtr<WorkbenchHandler> self, std::string root,
+                       bool running, base::OnceCallback<void(bool)> go,
+                       int choice) {
+                      if (!self || choice != 1) {
+                        return std::move(go).Run(false);
+                      }
+                      self->files_->PostTaskAndReply(
+                          FROM_HERE,
+                          base::BindOnce(
+                              [](base::FilePath file, std::string root,
+                                 bool running) {
+                                base::DictValue review = LoadJson(file);
+                                if (running) {
+                                  review.Set(
+                                      root,
+                                      base::DictValue().Set(
+                                          "snapshot", AutoExecSnapshot(
+                                                          base::FilePath(root))));
+                                } else {
+                                  review.Remove(root);
+                                }
+                                SaveJson(file, review);
+                              },
+                              ReviewPath(self->profile_), root, running),
+                          base::BindOnce(std::move(go), true));
+                    },
+                    self, root, running, std::move(go)));
+          },
+          weak_factory_.GetWeakPtr(), root, running, std::move(go)));
+}
+
+void WorkbenchHandler::CreateSandbox(std::string kind,
+                                     base::DictValue opts,
+                                     Reply reply) {
+  WorkbenchService* workbench = WorkbenchServiceFactory::GetForProfile(profile_);
+  if (!opts.FindBool("vaultReady").value_or(false)) {
+    opts.Set("vaultReady", true);
+    workbench->vault().WhenReady(base::BindOnce(
+        &WorkbenchHandler::CreateSandbox, weak_factory_.GetWeakPtr(), kind,
+        std::move(opts), std::move(reply)));
+    return;
+  }
+  std::string root = project_->root().value();
+  const SandboxKind* sandbox_kind = FindSandboxKind(kind);
+  // Only the secrets picked for this session (default: what the agent needs
+  // to sign in plus project secrets marked "available in sandboxes").
+  std::map<std::string, std::string> available =
+      workbench->vault().EnvFor(root);
+  std::vector<std::string> wanted;
+  if (const base::ListValue* picked = opts.FindList("secrets")) {
+    for (const base::Value& n : *picked) {
+      if (n.is_string()) {
+        wanted.push_back(n.GetString());
+      }
+    }
+  } else {
+    wanted = workbench->vault().SandboxDefaults(root, sandbox_kind->needs);
+  }
+  std::map<std::string, std::string> secrets;
+  for (const std::string& n : wanted) {
+    if (available.contains(n)) {
+      secrets[n] = available[n];
+    }
+  }
+  // Mission Control: sandboxes report through a mounted events file.
+  mission::MissionControl* mission =
+      mission::MissionControlFactory::GetForProfile(profile_);
+  mission::MissionControl::Registration registration;
+  base::DictValue claude_settings;
+  if (mission && kind != "sandbox-shell") {
+    tabs::TabInterface* tab =
+        tabs::TabInterface::MaybeGetFromContents(web_ui()->GetWebContents());
+    registration = mission->RegisterTerminal(
+        kind, project_->name(), tab ? tab->GetHandle().raw_value() : 0,
+        /*sandbox=*/true);
+    claude_settings = mission->ClaudeHookSettings();
+  }
+  int cols = opts.FindInt("cols").value_or(80);
+  int rows = opts.FindInt("rows").value_or(24);
+  std::vector<base::FilePath> forbidden = {profile_->GetPath().DirName()};
+  struct Made {
+    base::expected<SandboxLaunch, std::string> launch;
+    std::optional<SandboxMount> mount;
+    std::map<std::string, std::string> env;
+    std::string docker;
+  };
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](std::string kind, std::string root,
+             std::map<std::string, std::string> secrets,
+             std::vector<base::FilePath> forbidden, base::FilePath store_file,
+             base::FilePath review_file, std::string token,
+             base::DictValue claude_settings) -> Made {
+            std::map<std::string, std::string> env = TerminalEnv();
+            std::string dockerfile = ReadDockerfile();
+            base::DictValue status = SandboxStatus(env, dockerfile);
+            bool network =
+                LoadStore(store_file).FindBool("sandboxNetwork").value_or(true);
+            std::optional<SandboxMount> mount;
+            if (!token.empty() && status.FindBool("imagePresent").value_or(false)) {
+              mount = mission::MissionControl::MakeSandboxMount(
+                  token, kind, std::move(claude_settings));
+            }
+            base::expected<SandboxLaunch, std::string> launch =
+                MakeSandboxLaunch(kind, base::FilePath(root), secrets, network,
+                                  forbidden, status, dockerfile, mount);
+            // What the host would run, before the sandbox can change it.
+            if (launch.has_value() && launch->then.empty()) {
+              base::DictValue review = LoadJson(review_file);
+              if (!review.FindDict(root)) {
+                review.Set(root, base::DictValue().Set(
+                                     "snapshot",
+                                     AutoExecSnapshot(base::FilePath(root))));
+                SaveJson(review_file, review);
+              }
+            }
+            const std::string* docker = status.FindString("docker");
+            return Made{std::move(launch), std::move(mount), std::move(env),
+                        docker ? *docker : std::string()};
+          },
+          kind, root, std::move(secrets), forbidden, StorePath(),
+          ReviewPath(profile_), registration.token, std::move(claude_settings)),
+      base::BindOnce(
+          [](base::WeakPtr<WorkbenchHandler> self, std::string kind, int cols,
+             int rows, mission::MissionControl::Registration registration,
+             Reply reply, Made made) {
+            mission::MissionControl* mission =
+                self ? mission::MissionControlFactory::GetForProfile(
+                           self->profile_)
+                     : nullptr;
+            if (!self || !self->project_ || !made.launch.has_value()) {
+              if (mission && !registration.node_id.empty()) {
+                mission->Discard(registration.token, registration.node_id);
+              }
+              if (self && !made.launch.has_value()) {
+                std::move(reply).Run(base::unexpected(made.launch.error()));
+              }
+              return;
+            }
+            SandboxLaunch& launch = *made.launch;
+            // The image build gets no secrets and no Mission node.
+            if (!launch.then.empty() && mission &&
+                !registration.node_id.empty()) {
+              mission->Discard(registration.token, registration.node_id);
+              registration = {};
+            }
+            if (made.mount && mission) {
+              mission->FollowSandbox(*made.mount);
+            }
+            std::string id = "t" + base::NumberToString(++self->term_seq_);
+            Terminal::Spec run;
+            run.argv = launch.argv;
+            run.env = made.env;
+            run.cwd = self->project_->root().value();
+            run.cols = cols;
+            run.rows = rows;
+            std::unique_ptr<Terminal> terminal = Terminal::Start(
+                run,
+                base::BindPostTaskToCurrentDefault(base::BindRepeating(
+                    &WorkbenchHandler::OnTerminalData, self, id)),
+                base::BindPostTaskToCurrentDefault(base::BindOnce(
+                    &WorkbenchHandler::OnTerminalExit, self, id)));
+            if (!terminal) {
+              ReleasePlaceholders(launch.placeholders);
+              return std::move(reply).Run(
+                  base::unexpected("Couldn’t start the terminal."));
+            }
+            Term term;
+            term.terminal = std::move(terminal);
+            term.kind = kind;
+            term.title = launch.title;
+            term.cleanup = launch.cleanup;
+            if (made.mount) {
+              term.cleanup.push_back(made.mount->dir);
+            }
+            term.secrets = launch.secret_names;
+            term.then = launch.then;
+            term.container = launch.container;
+            term.docker = made.docker;
+            term.placeholders = launch.placeholders;
+            term.mission_node = registration.node_id;
+            term.mission_token = registration.token;
+            if (launch.then.empty()) {
+              term.sandbox_root = self->project_->root().value();
+              self->sandboxes_running_[term.sandbox_root]++;
+            }
+            if (mission && !registration.node_id.empty()) {
+              mission->AttachTerminal(registration.node_id, id);
+            }
+            base::DictValue info = self->TermInfo(id, term);
+            base::ListValue notes;
+            for (const std::string& n : launch.notes) {
+              notes.Append(n);
+            }
+            info.Set("notes", std::move(notes));
+            info.Set("browserTools", false);
+            self->terms_[id] = std::move(term);
+            std::move(reply).Run(base::Value(std::move(info)));
+          },
+          weak_factory_.GetWeakPtr(), kind, cols, rows,
+          std::move(registration), std::move(reply)));
+}
