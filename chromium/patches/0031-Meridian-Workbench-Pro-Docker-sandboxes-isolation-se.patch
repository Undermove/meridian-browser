+
+  // New lines from each sandbox's events file (bounded per round and in
+  // total; a replaced or truncated file starts over).
+  void ReadTails() {
+    std::map<std::string, TailState> tails;
+    {
+      base::AutoLock hold(lock_);
+      tails = tails_;
+    }
+    for (auto& [token, t] : tails) {
+      base::FilePath file = t.dir.Append("events.jsonl");
+      base::ScopedFD fd(HANDLE_EINTR(
+          open(file.value().c_str(), O_RDONLY | O_NOFOLLOW | O_NONBLOCK)));
+      if (!fd.is_valid()) {
+        continue;
+      }
+      struct stat st;
+      if (fstat(fd.get(), &st) != 0 || !S_ISREG(st.st_mode) ||
+          st.st_nlink != 1 || st.st_dev != t.dev) {
+        continue;
+      }
+      if (st.st_ino != t.ino || st.st_size < t.offset) {
+        t.ino = st.st_ino;
+        t.offset = 0;
+        t.partial.clear();
+      }
+      if (st.st_size <= t.offset || t.total >= 4u * 1024 * 1024) {
+        continue;
+      }
+      std::array<char, 65536> chunk;
+      ssize_t n = HANDLE_EINTR(pread(fd.get(), chunk.data(), chunk.size(), t.offset));
+      if (n <= 0) {
+        continue;
+      }
+      t.offset += n;
+      t.total += static_cast<size_t>(n);
+      t.partial.append(base::as_string_view(
+          base::span(chunk).first(static_cast<size_t>(n))));
+      size_t nl;
+      while ((nl = t.partial.find('\n')) != std::string::npos) {
+        Accept(t.partial.substr(0, nl));
+        t.partial.erase(0, nl + 1);
+      }
+      if (t.partial.size() > kMaxLine) {
+        t.partial.clear();
+      }
+      base::AutoLock hold(lock_);
+      auto it = tails_.find(token);
+      if (it != tails_.end()) {
+        it->second = t;
+      }
+    }
