@@ -0,0 +1,99 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/sandbox.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::workbench {
+namespace {
+
+base::DictValue Running() {
+  return base::DictValue()
+      .Set("installed", true)
+      .Set("running", true)
+      .Set("docker", "/usr/local/bin/docker")
+      .Set("image", "meridian-sandbox:abc")
+      .Set("imagePresent", true);
+}
+
+class SandboxTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    root_ = base::MakeAbsoluteFilePath(dir_.GetPath()).Append("proj");
+    ASSERT_TRUE(base::CreateDirectory(root_.Append(".git")));
+  }
+  base::ScopedTempDir dir_;
+  base::FilePath root_;
+};
+
+TEST_F(SandboxTest, PinsHostRunConfigAndKeepsSecretsOutOfArgs) {
+  base::expected<SandboxLaunch, std::string> launch = MakeSandboxLaunch(
+      "sandbox-claude", root_, {{"ANTHROPIC_API_KEY", "sk-ant-secret-value"}},
+      /*network=*/false, {}, Running(), "FROM node", std::nullopt);
+  ASSERT_TRUE(launch.has_value()) << launch.error();
+  std::string args;
+  for (const std::string& a : launch->argv) {
+    args += a + " ";
+  }
+  EXPECT_NE(args.find("type=bind,source=" + root_.value() +
+                      ",target=/workspace "),
+            std::string::npos);
+  EXPECT_NE(args.find(root_.Append(".git").value() +
+                      ",target=/workspace/.git,readonly"),
+            std::string::npos);
+  EXPECT_NE(args.find("/workspace/.mcp.json,readonly"), std::string::npos);
+  EXPECT_NE(args.find("--cap-drop ALL"), std::string::npos);
+  EXPECT_NE(args.find("--network none"), std::string::npos);
+  EXPECT_EQ(args.find("sk-ant-secret-value"), std::string::npos);
+  // Placeholders exist while it runs and go afterwards; the real .git stays.
+  EXPECT_TRUE(base::PathExists(root_.Append(".mcp.json")));
+  EXPECT_TRUE(base::DirectoryExists(root_.Append(".claude")));
+  std::string env;
+  ASSERT_TRUE(base::ReadFileToString(launch->cleanup[0].Append("env"), &env));
+  EXPECT_EQ(env, "ANTHROPIC_API_KEY=c2stYW50LXNlY3JldC12YWx1ZQ==\n");
+  int mode = 0;
+  base::GetPosixFilePermissions(launch->cleanup[0].Append("env"), &mode);
+  EXPECT_EQ(mode, 0600);
+  ReleasePlaceholders(launch->placeholders);
+  EXPECT_FALSE(base::PathExists(root_.Append(".mcp.json")));
+  EXPECT_FALSE(base::PathExists(root_.Append(".claude")));
+  EXPECT_TRUE(base::DirectoryExists(root_.Append(".git")));
+  base::DeletePathRecursively(launch->cleanup[0]);
+}
+
+TEST_F(SandboxTest, RefusesSymlinksHomeAndMeridianData) {
+  ASSERT_TRUE(base::CreateSymbolicLink(base::FilePath("/etc"),
+                                       root_.Append(".vscode")));
+  EXPECT_FALSE(MakeSandboxLaunch("sandbox-shell", root_, {}, true, {},
+                                 Running(), "FROM node", std::nullopt)
+                   .has_value());
+  EXPECT_FALSE(base::PathExists(root_.Append(".mcp.json")));
+  EXPECT_FALSE(MakeSandboxLaunch("sandbox-shell",
+                                 base::MakeAbsoluteFilePath(base::GetHomeDir()),
+                                 {}, true, {}, Running(), "FROM node",
+                                 std::nullopt)
+                   .has_value());
+  EXPECT_FALSE(MakeSandboxLaunch("sandbox-shell", root_, {}, true,
+                                 {root_.Append("data")}, Running(),
+                                 "FROM node", std::nullopt)
+                   .has_value());
+}
+
+TEST_F(SandboxTest, SnapshotSeesPlantedConfig) {
+  base::DictValue before = AutoExecSnapshot(root_);
+  ASSERT_TRUE(base::CreateDirectory(root_.Append("sub/.git/hooks")));
+  ASSERT_TRUE(base::WriteFile(root_.Append("sub/.git/hooks/pre-commit"), "x"));
+  ASSERT_TRUE(base::WriteFile(root_.Append(".envrc"), "evil"));
+  base::ListValue diff = SnapshotDiff(before, AutoExecSnapshot(root_));
+  ASSERT_EQ(diff.size(), 2u);
+  EXPECT_EQ(*diff[0].GetDict().FindString("path"), ".envrc");
+  EXPECT_EQ(*diff[1].GetDict().FindString("path"), "sub/.git");
+}
+
+}  // namespace
+}  // namespace meridian::workbench
