+const SandboxKind* FindSandboxKind(const std::string& id) {
+  static const base::NoDestructor<std::vector<SandboxKind>> kinds(
+      std::vector<SandboxKind>{
+          {"sandbox-claude", "Claude Code (sandbox)", {"claude"},
+           {"ANTHROPIC_API_KEY"}},
+          {"sandbox-codex", "Codex (sandbox)", {"codex"}, {"OPENAI_API_KEY"}},
+          {"sandbox-shell", "Shell (sandbox)", {"bash", "-l"}, {}},
+      });
+  for (const SandboxKind& k : *kinds) {
+    if (id == k.id) {
+      return &k;
+    }
+  }
+  return nullptr;
+}
+
+std::string FindDocker(const std::string& search_path) {
+  std::string home = base::GetHomeDir().value();
+  std::vector<std::string> candidates = {
+      FindExecutable("docker", search_path),
+      home + "/.orbstack/bin/docker",
+      "/usr/local/bin/docker",
+      "/opt/homebrew/bin/docker",
+      "/Applications/OrbStack.app/Contents/MacOS/xbin/docker",
+      "/Applications/Docker.app/Contents/Resources/bin/docker",
+  };
+  for (const std::string& c : candidates) {
+    if (!c.empty() && access(c.c_str(), X_OK) == 0 &&
+        !base::DirectoryExists(base::FilePath(c))) {
+      return c;
+    }
+  }
+  return std::string();
+}
+
+std::string SandboxImageTag(const std::string& dockerfile) {
+  return "meridian-sandbox:" +
+         Hex(crypto::hash::Sha256(dockerfile)).substr(0, 12);
+}
+
+base::DictValue SandboxStatus(const std::map<std::string, std::string>& env,
+                              const std::string& dockerfile) {
+  auto found = env.find("PATH");
+  std::string docker = FindDocker(found != env.end() ? found->second : "");
+  base::DictValue st;
+  st.Set("installed", !docker.empty());
+  st.Set("running", false);
+  st.Set("docker", docker.empty() ? base::Value() : base::Value(docker));
+  st.Set("version", base::Value());
+  st.Set("image", SandboxImageTag(dockerfile));
+  st.Set("imagePresent", false);
+  st.Set("error", base::Value());
+  st.Set("available", !dockerfile.empty());
+  if (docker.empty()) {
+    return st;
+  }
+  base::FilePath home = base::GetHomeDir();
+  int code = -1;
+  std::string out = ai::CaptureOutput(
+      {docker, "info", "--format", "{{.ServerVersion}}"}, env, home.value(),
+      base::Seconds(8), &code);
+  std::string version(base::TrimWhitespaceASCII(out, base::TRIM_ALL));
+  if (code == 0 && !version.empty() && version.find('\n') == std::string::npos) {
+    st.Set("running", true);
+    st.Set("version", version.substr(0, 40));
+    int inspect = -1;
+    ai::CaptureOutput({docker, "image", "inspect", "--format", "{{.Id}}",
+                       SandboxImageTag(dockerfile)},
+                      env, home.value(), base::Seconds(8), &inspect);
+    st.Set("imagePresent", inspect == 0);
+  } else {
+    std::vector<std::string> lines = base::SplitString(
+        out, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    st.Set("error", lines.empty() ? std::string("The Docker daemon is not running.")
+                                  : lines.back().substr(0, 300));
+  }
+  return st;
+}
+
+base::expected<SandboxLaunch, std::string> MakeSandboxLaunch(
+    const std::string& kind_id,
+    const base::FilePath& root,
+    const std::map<std::string, std::string>& secrets,
+    bool network,
+    const std::vector<base::FilePath>& forbidden,
+    const base::DictValue& status,
+    const std::string& dockerfile,
+    const std::optional<SandboxMount>& mission) {
+  const SandboxKind* kind = FindSandboxKind(kind_id);
+  if (!kind) {
+    return base::unexpected("unknown sandbox");
+  }
+  // Never the whole disk or home, nor anything holding Meridian's own data.
+  base::FilePath home = base::MakeAbsoluteFilePath(base::GetHomeDir());
+  if (root.value() == "/" || root == home) {
+    return base::unexpected(
+        "Meridian won’t mount your whole disk or home folder into a sandbox. "
+        "Open a project folder instead.");
+  }
+  for (const base::FilePath& f : forbidden) {
+    base::FilePath real = base::MakeAbsoluteFilePath(f);
+    if (real.empty()) {
+      real = f;
+    }
+    if (real == root || root.IsParent(real) || real.IsParent(root)) {
+      return base::unexpected(
+          "This folder holds Meridian’s own data, so it can’t be opened in a "
+          "sandbox — a sandboxed agent could plant code that runs with "
+          "Workbench powers. Use a host terminal here.");
+    }
+  }
+  if (!status.FindBool("installed").value_or(false)) {
+    return base::unexpected(
+        "Docker isn’t installed. Install OrbStack or Docker Desktop to run "
+        "agents in a sandbox.");
+  }
+  if (!status.FindBool("running").value_or(false)) {
+    const std::string* error = status.FindString("error");
+    return base::unexpected("Docker isn’t running — start OrbStack or Docker "
+                            "Desktop. (" +
+                            (error ? *error : std::string()) + ")");
+  }
+  if (dockerfile.empty()) {
+    return base::unexpected("The sandbox Dockerfile is missing from this build.");
+  }
+  if (!root.IsAbsolute() || BadMountPath(root.value())) {
+    return base::unexpected(
+        "This project path can’t be mounted into a container (it contains a "
+        "comma, a quote or a line break).");
+  }
+  std::string docker = *status.FindString("docker");
+  std::string image = *status.FindString("image");
+  SandboxLaunch out;
+  if (!status.FindBool("imagePresent").value_or(false)) {
+    base::FilePath dir;
+    if (!base::CreateNewTempDirectory("meridian-sbx-build-", &dir)) {
+      return base::unexpected("Couldn’t prepare the image build.");
+    }
+    base::SetPosixFilePermissions(dir, 0700);
+    base::WriteFile(dir.Append("Dockerfile"), dockerfile);
+    out.title = "Building sandbox image";
+    out.argv = {docker, "build", "--progress=plain", "--label",
+                "dev.meridian.sandbox=1", "-t", image, dir.value()};
+    out.cleanup = {dir};
+    out.notes = {"First run: building " + image +
+                 " (Node LTS, git, ripgrep, Claude Code and Codex CLIs). This "
+                 "takes a few minutes once; the " +
+                 kind->label + " starts when it’s done."};
+    out.then = kind_id;
+    return out;
+  }
+  // Host-run config pinned read-only; placeholders for the missing ones.
+  std::vector<std::string> mounts;
+  std::vector<std::string> pinned;
+  std::vector<base::FilePath> created;
+  std::vector<std::string> names = ProtectDirs();
+  names.insert(names.end(), ProtectFiles().begin(), ProtectFiles().end());
+  names.insert(names.end(), ProtectIfPresent().begin(), ProtectIfPresent().end());
+  {
+    base::AutoLock hold(PlaceholderLock());
+    for (const std::string& name : names) {
+      base::FilePath abs = root.Append(name);
+      struct stat st;
+      bool exists = lstat(abs.value().c_str(), &st) == 0;
+      if (exists && S_ISLNK(st.st_mode)) {
+        for (const base::FilePath& c : created) {
+          --PlaceholderRefs()[c];
+        }
+        return base::unexpected(
+            "“" + name +
+            "” in this project is a symlink. Meridian won’t start a sandbox "
+            "here: docker would mount whatever it points at. Replace the "
+            "symlink with a real file or folder (or remove it) and try "
+            "again.");
+      }
+      if (exists && !S_ISREG(st.st_mode) && !S_ISDIR(st.st_mode)) {
+        return base::unexpected("“" + name +
+                                "” in this project is not a regular file or "
+                                "folder.");
+      }
+      if (!exists) {
+        if (Contains(ProtectIfPresent(), name)) {
+          continue;
+        }
+        bool made = Contains(ProtectDirs(), name)
+                        ? base::CreateDirectory(abs)
+                        : base::WriteFile(abs, Placeholder(name));
+        if (!made) {
+          return base::unexpected("Couldn’t prepare " + name + ".");
+        }
+        PlaceholderRefs()[abs] = 1;
+        created.push_back(abs);
+      } else if (PlaceholderRefs().contains(abs)) {
+        ++PlaceholderRefs()[abs];  // another running sandbox made it
+        created.push_back(abs);
+      }
+      mounts.insert(mounts.end(),
+                    {"--mount", "type=bind,source=" + abs.value() +
+                                    ",target=/workspace/" + name + ",readonly"});
+      pinned.push_back(name);
+    }
+  }
+  out.placeholders = created;
+  // The session's secrets: NAME=<base64 value> lines in a private file.
+  std::map<std::string, std::string> file_vars;
+  for (const auto& [name, value] : secrets) {
+    if (RE2::FullMatch(name, "[A-Z_][A-Z0-9_]{0,63}")) {
+      file_vars[name] = value;
+      out.secret_names.push_back(name);
+    }
+  }
+  if (mission && !mission->token.empty()) {
+    file_vars["MERIDIAN_MISSION_TOKEN"] = mission->token;
+  }
+  base::FilePath env_dir;
+  if (!base::CreateNewTempDirectory("meridian-sbx-env-", &env_dir) ||
+      BadMountPath(env_dir.value())) {
+    ReleasePlaceholders(created);
+    return base::unexpected("The temp folder path can’t be mounted into a "
+                            "container.");
+  }
+  env_dir = base::MakeAbsoluteFilePath(env_dir);
+  base::SetPosixFilePermissions(env_dir, 0700);
+  std::string body;
+  for (const auto& [name, value] : file_vars) {
+    body += name + "=" + base::Base64Encode(value) + "\n";
+  }
+  base::FilePath env_file = env_dir.Append("env");
+  if (!base::WriteFile(env_file, body) ||
+      !base::SetPosixFilePermissions(env_file, 0600)) {
+    ReleasePlaceholders(created);
+    return base::unexpected("Couldn’t write the sandbox’s secrets file.");
+  }
+  out.cleanup = {env_dir};
+  out.container = "meridian-sbx-" + Hex(base::RandBytesAsVector(5));
+  std::string volume =
+      "meridian-sbx-home-" + Hex(crypto::hash::Sha256(root.value())).substr(0, 12);
+  out.title = kind->label;
+  out.argv = {docker, "run", "--rm", "-it", "--init", "--name", out.container,
+              "--hostname", "sandbox", "--label", "dev.meridian.sandbox=1",
+              "--user", "node", "--cap-drop", "ALL", "--security-opt",
+              "no-new-privileges", "--pids-limit", "512", "--memory", "4g",
+              "--memory-swap", "4g", "--cpus", "2", "--mount",
+              "type=bind,source=" + root.value() + ",target=/workspace"};
+  out.argv.insert(out.argv.end(), mounts.begin(), mounts.end());
+  out.argv.insert(
+      out.argv.end(),
+      {"--mount",
+       "type=bind,source=" + env_file.value() +
+           ",target=/run/meridian/env,readonly",
+       "--mount", "type=volume,source=" + volume + ",target=/home/node",
+       "--workdir", "/workspace", "-e", "TERM=xterm-256color", "-e",
+       "COLORTERM=truecolor"});
+  if (!network) {
+    out.argv.insert(out.argv.end(), {"--network", "none"});
+  }
+  if (mission && mission->dir.IsAbsolute() &&
+      !BadMountPath(mission->dir.value())) {
+    out.argv.insert(out.argv.end(),
+                    {"--mount", "type=bind,source=" + mission->dir.value() +
+                                    ",target=" + mission->target});
+    for (const auto& [n, v] : mission->env) {
+      out.argv.insert(out.argv.end(), {"-e", n + "=" + v});
+    }
+    out.argv.push_back(image);
+    out.argv.insert(out.argv.end(), kind->cmd.begin(), kind->cmd.end());
+    out.argv.insert(out.argv.end(), mission->args.begin(), mission->args.end());
+  } else {
+    out.argv.push_back(image);
+    out.argv.insert(out.argv.end(), kind->cmd.begin(), kind->cmd.end());
+  }
+  out.notes.push_back(
+      std::string("Sandbox: only this project is mounted (at /workspace); ") +
+      (network ? "network ON (the agent can reach the internet, which it "
+                 "needs for its API)"
+               : "no network") +
+      "; limits 2 CPUs, 4g RAM.");
+  out.notes.push_back("Read-only inside the sandbox: " +
+                      base::JoinString(pinned, ", ") +
+                      " (git works read-only: commit from a host terminal).");
+  out.notes.push_back(
+      out.secret_names.empty()
+          ? "No vault secrets are passed into this sandbox."
+          : "Secrets in this sandbox: " + base::JoinString(out.secret_names, ", ") +
+                " (values hidden).");
+  std::vector<std::string> missing;
+  for (const std::string& n : kind->needs) {
+    if (!Contains(out.secret_names, n)) {
+      missing.push_back(n);
+    }
+  }
+  if (!missing.empty()) {
+    std::string label = kind->label;
+    base::ReplaceSubstringsAfterOffset(&label, 0, " (sandbox)", "");
+    out.notes.push_back(base::JoinString(missing, ", ") +
+                        " is not passed in, so " + label +
+                        " can’t sign in inside the container. Add it in "
+                        "Secrets (lock icon) and restart.");
+  }
+  if (!network && kind_id != "sandbox-shell") {
+    out.notes.push_back(
+        "Network is off: the agent can’t reach its API. Turn network on in "
+        "the sandbox menu.");
+  }
+  return out;
+}
+
+void ReleasePlaceholders(const std::vector<base::FilePath>& placeholders) {
+  base::AutoLock hold(PlaceholderLock());
+  for (const base::FilePath& abs : placeholders) {
+    auto it = PlaceholderRefs().find(abs);
+    if (it != PlaceholderRefs().end() && --it->second > 0) {
+      continue;
+    }
+    PlaceholderRefs().erase(abs);
+    struct stat st;
+    if (lstat(abs.value().c_str(), &st) != 0) {
+      continue;
+    }
+    if (S_ISDIR(st.st_mode)) {
+      rmdir(abs.value().c_str());  // stays if anything was put inside
+    } else if (S_ISREG(st.st_mode)) {
+      std::string content;
+      if (base::ReadFileToString(abs, &content) &&
+          content == Placeholder(abs.BaseName().value())) {
+        base::DeleteFile(abs);
+      }
+    }
+  }
+}
+
+namespace {
+
+std::string Digest(const base::FilePath& abs, int* seen) {
+  struct stat st;
+  if (lstat(abs.value().c_str(), &st) != 0) {
+    return "other";
+  }
+  if (S_ISLNK(st.st_mode)) {
+    base::FilePath target;
+    return "link:" + (base::ReadSymbolicLink(abs, &target) ? target.value()
+                                                           : std::string("?"));
+  }
+  if (S_ISREG(st.st_mode)) {
+    if (st.st_size > 1024 * 1024) {
+      return "big:" + base::NumberToString(st.st_size) + ":" +
+             base::NumberToString(st.st_mtime);
+    }
+    std::string content;
+    base::ReadFileToString(abs, &content);
+    return "file:" + Hex(crypto::hash::Sha256(content));
+  }
+  if (!S_ISDIR(st.st_mode)) {
+    return "other";
+  }
+  // One digest over the folder's files (sorted, bounded).
+  std::string listing;
+  std::vector<std::pair<base::FilePath, int>> stack = {{abs, 0}};
+  while (!stack.empty() && *seen < 30000) {
+    auto [dir, depth] = stack.back();
+    stack.pop_back();
+    if (depth > 6) {
+      continue;
+    }
+    std::vector<base::FilePath> entries;
+    base::FileEnumerator e(dir, false,
+                           base::FileEnumerator::FILES |
+                               base::FileEnumerator::DIRECTORIES |
+                               base::FileEnumerator::SHOW_SYM_LINKS);
+    for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+      entries.push_back(p);
+    }
+    std::ranges::sort(entries);
+    for (const base::FilePath& p : entries) {
+      ++*seen;
+      base::FilePath rel;
+      abs.AppendRelativePath(p, &rel);
+      struct stat s2;
+      if (lstat(p.value().c_str(), &s2) != 0) {
+        continue;
+      }
+      if (S_ISDIR(s2.st_mode)) {
+        listing += "d " + rel.value() + "\n";
+        stack.push_back({p, depth + 1});
+      } else {
+        listing += rel.value() + " " + Digest(p, seen) + "\n";
+      }
+    }
+  }
+  return "dir:" + Hex(crypto::hash::Sha256(listing));
+}
+
+}  // namespace
+
+base::DictValue AutoExecSnapshot(const base::FilePath& root) {
+  std::set<std::string> names(ProtectDirs().begin(), ProtectDirs().end());
+  names.insert(ProtectFiles().begin(), ProtectFiles().end());
+  names.insert(ProtectIfPresent().begin(), ProtectIfPresent().end());
+  base::DictValue out;
+  int seen = 0;
+  std::vector<std::pair<base::FilePath, int>> stack = {{root, 0}};
+  while (!stack.empty() && seen < 30000) {
+    auto [dir, depth] = stack.back();
+    stack.pop_back();
+    if (depth > 8) {
+      continue;
+    }
+    base::FileEnumerator e(dir, false,
+                           base::FileEnumerator::FILES |
+                               base::FileEnumerator::DIRECTORIES |
+                               base::FileEnumerator::SHOW_SYM_LINKS);
+    for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+      if (++seen > 30000) {
+        break;
+      }
+      std::string name = p.BaseName().value();
+      base::FilePath rel;
+      root.AppendRelativePath(p, &rel);
+      if (names.contains(name)) {
+        if (rel.value() != ".git") {
+          out.Set(rel.value(), Digest(p, &seen));
+        }
+        continue;
+      }
+      if (e.GetInfo().IsDirectory() && name != "node_modules") {
+        stack.push_back({p, depth + 1});
+      }
+    }
+  }
+  return out;
+}
+
+base::ListValue SnapshotDiff(const base::DictValue& before,
+                             const base::DictValue& after) {
+  auto placeholder = [](const std::string& rel, const std::string& digest) {
+    if (Contains(ProtectDirs(), rel)) {
+      return digest == "dir:" + Hex(crypto::hash::Sha256(std::string()));
+    }
+    if (Contains(ProtectFiles(), rel)) {
+      return digest == "file:" + Hex(crypto::hash::Sha256(Placeholder(rel)));
+    }
+    return false;
+  };
+  std::vector<std::pair<std::string, std::string>> changes;
+  for (const auto [rel, d] : after) {
+    const std::string* was = before.FindString(rel);
+    if (!was) {
+      if (!placeholder(rel, d.GetString())) {
+        changes.emplace_back(rel, "added");
+      }
+    } else if (*was != d.GetString()) {
+      changes.emplace_back(rel, "changed");
+    }
+  }
+  for (const auto [rel, d] : before) {
+    if (!after.Find(rel)) {
+      changes.emplace_back(rel, "removed");
+    }
+  }
+  std::ranges::sort(changes);
+  base::ListValue out;
+  for (const auto& [rel, change] : changes) {
+    out.Append(base::DictValue().Set("path", rel).Set("change", change));
+  }
+  return out;
+}
+
+}  // namespace meridian::workbench
diff --git a/chrome/browser/meridian/workbench/sandbox.h b/chrome/browser/meridian/workbench/sandbox.h
new file mode 100644
index 0000000000..c4dd57b0b5
--- /dev/null
+++ b/chrome/browser/meridian/workbench/sandbox.h
@@ -0,0 +1,98 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_SANDBOX_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_SANDBOX_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+
+namespace meridian::workbench {
+
+// Coding agents in a Docker / OrbStack container. What the container gets:
+//  - the project folder, read-write, at /workspace, and nothing else from the
+//    host (no home, no SSH keys, no Docker socket), EXCEPT files the host
+//    runs by itself (.git, .claude, .mcp.json, .vscode, .envrc…), mounted
+//    read-only on top; missing ones get an empty placeholder for the session,
+//    so the agent can't create them either. A symlinked one refuses the
+//    launch. What can't be pinned this way is snapshotted before the session
+//    and reviewed before the next host terminal (AutoExecSnapshot);
+//  - a per-project volume as /home/node; the unprivileged `node` user, all
+//    capabilities dropped, no-new-privileges, pid/memory/CPU limits;
+//    optionally no network;
+//  - only the vault secrets picked for the session, in a 0600 file in a
+//    private 0700 temp dir, mounted read-only (never container environment,
+//    which `docker inspect` shows, never a command line).
+// Every docker call is an argv array. Blocking.
+
+struct SandboxKind {
+  const char* id;
+  const char* label;
+  std::vector<std::string> cmd;
+  // Secrets the agent needs to sign in.
+  std::vector<std::string> needs;
+};
+const SandboxKind* FindSandboxKind(const std::string& id);
+
+std::string FindDocker(const std::string& search_path);
+// The image tag follows the Dockerfile: a changed recipe builds a new image.
+std::string SandboxImageTag(const std::string& dockerfile);
+
+// {installed, running, docker, version, image, imagePresent, error,
+// available}
+base::DictValue SandboxStatus(const std::map<std::string, std::string>& env,
+                              const std::string& dockerfile);
+
+struct SandboxMount {
+  base::FilePath dir;
+  std::string target;
+  std::map<std::string, std::string> env;
+  std::vector<std::string> args;
+  std::string token;
+};
+
+struct SandboxLaunch {
+  std::string title;
+  std::vector<std::string> argv;
+  std::vector<base::FilePath> cleanup;
+  std::vector<std::string> notes;
+  // Set while the image is being built: the sandbox kind to start after.
+  std::string then;
+  std::vector<std::string> secret_names;
+  std::string container;
+  std::vector<base::FilePath> placeholders;
+};
+
+// `forbidden`: folders that can never be mounted (Meridian's own data).
+base::expected<SandboxLaunch, std::string> MakeSandboxLaunch(
+    const std::string& kind,
+    const base::FilePath& root,
+    const std::map<std::string, std::string>& secrets,
+    bool network,
+    const std::vector<base::FilePath>& forbidden,
+    const base::DictValue& status,
+    const std::string& dockerfile,
+    const std::optional<SandboxMount>& mission);
+
+// Placeholders nobody uses any more go — only if they are still exactly
+// what Meridian created.
+void ReleasePlaceholders(const std::vector<base::FilePath>& placeholders);
+
+// {"<rel path>": "<digest>"} for every host-run config entry in the project
+// (any depth; the root .git is read-only in sandboxes and skipped).
+base::DictValue AutoExecSnapshot(const base::FilePath& root);
+// [{path, change: added|removed|changed}]; Meridian's placeholders don't
+// count as added.
+base::ListValue SnapshotDiff(const base::DictValue& before,
+                             const base::DictValue& after);
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_SANDBOX_H_
