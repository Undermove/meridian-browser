+// static
+std::optional<workbench::SandboxMount> MissionControl::MakeSandboxMount(
+    const std::string& token,
     const std::string& kind,
+    base::DictValue settings) {
+  if (token.empty()) {
+    return std::nullopt;
+  }
+  std::string script;
+  if (!base::ReadFileToString(workbench::WorkbenchSource::Folder().Append(
+                                  "hooks/mission-hook.js"),
+                              &script)) {
+    return std::nullopt;
+  }
+  base::FilePath dir = EventChannel::MakeTailDir();
+  if (dir.empty()) {
+    return std::nullopt;
+  }
+  base::WriteFile(dir.Append("mission-hook.js"), script);
+  base::SetPosixFilePermissions(dir.Append("mission-hook.js"), 0600);
+  workbench::SandboxMount mount;
+  mount.dir = dir;
+  mount.target = "/meridian";
+  mount.env["MERIDIAN_MISSION_FILE"] = "/meridian/events.jsonl";
+  mount.token = token;
+  if (kind == "sandbox-claude") {
+    // Inside the container the hook is the script, run by node.
+    for (auto [event, list] : *settings.FindDict("hooks")) {
+      for (base::Value& entry : list.GetList()) {
+        for (base::Value& hook : *entry.GetDict().FindList("hooks")) {
+          hook.GetDict().Set("command", "node /meridian/mission-hook.js");
+        }
+      }
+    }
+    base::WriteFile(dir.Append("settings.json"),
+                    base::WriteJson(settings).value_or("{}"));
+    base::SetPosixFilePermissions(dir.Append("settings.json"), 0600);
+    mount.args = {"--settings", "/meridian/settings.json"};
+  } else if (kind == "sandbox-codex") {
+    mount.args = {"-c",
+                  "notify=[\"node\", \"/meridian/mission-hook.js\", "
+                  "\"--codex\"]"};
+  }
+  return mount;
+}
