 #include <vector>
 
 #include "base/files/file_path.h"
@@ -81,6 +82,8 @@ class ContextInsights {
   std::vector<Request> requests_;
   Request subagents_;
   int subagent_requests_ = 0;
+  // When each subagent request happened and what it weighed, for the chart.
+  std::vector<std::pair<double, double>> subagent_spend_;
   std::set<std::string> seen_requests_;
   std::map<std::string, ToolCall> calls_;
   std::vector<std::string> call_order_;
