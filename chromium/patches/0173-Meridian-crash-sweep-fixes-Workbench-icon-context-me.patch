+#include <vector>
+
 #include "base/files/file_path.h"
 
 namespace meridian {
@@ -25,6 +28,14 @@ bool HasTestSwitch(std::string_view name);
 std::string TestSwitchValue(std::string_view name);
 base::FilePath TestSwitchPath(std::string_view name);
 
+// --meridian-test-context-menu-command: the context menu item a test picks
+// in place of the native menu a person would click. Its value is a command
+// id, or "@<file>" whose contents are read at each menu: a command id, or
+// "list" to write the menu's command ids (`ids`, one per line) to
+// "<file>.ids". nullopt when the switch isn't set (show the menu); else the
+// command to run, 0 for none.
+std::optional<int> TestContextMenuCommand(const std::vector<int>& ids);
+
 }  // namespace meridian
 
 #endif  // CHROME_BROWSER_MERIDIAN_TEST_SWITCHES_H_
