diff --git a/chrome/browser/meridian/test_switches.cc b/chrome/browser/meridian/test_switches.cc
index 7bb31fef35..43d717d92a 100644
--- a/chrome/browser/meridian/test_switches.cc
+++ b/chrome/browser/meridian/test_switches.cc
@@ -5,10 +5,15 @@
 #include "chrome/browser/meridian/test_switches.h"
 
 #include <limits.h>
+
+#include <algorithm>
 #include <stdlib.h>
 
 #include "base/command_line.h"
 #include "base/files/file_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/threading/thread_restrictions.h"
 #include "build/build_config.h"
 
 #if BUILDFLAG(IS_WIN)
@@ -101,4 +106,33 @@ base::FilePath TestSwitchPath(std::string_view name) {
              : base::FilePath();
 }
 
+std::optional<int> TestContextMenuCommand(const std::vector<int>& ids) {
+  std::string value = TestSwitchValue("meridian-test-context-menu-command");
+  if (value.empty()) {
+    return std::nullopt;
+  }
+  if (value.starts_with("@")) {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    base::FilePath file = base::FilePath::FromUTF8Unsafe(value.substr(1));
+    if (!base::ReadFileToString(file, &value)) {
+      return 0;
+    }
+    value = std::string(base::TrimWhitespaceASCII(value, base::TRIM_ALL));
+    if (value == "list") {
+      std::string out;
+      for (int id : ids) {
+        out += base::NumberToString(id) + "\n";
+      }
+      base::WriteFile(file.AddExtensionASCII("ids"), out);
+      return 0;
+    }
+  }
+  int command = 0;
+  if (!base::StringToInt(value, &command) ||
+      std::find(ids.begin(), ids.end(), command) == ids.end()) {
+    return 0;
+  }
+  return command;
+}
+
 }  // namespace meridian
diff --git a/chrome/browser/meridian/test_switches.h b/chrome/browser/meridian/test_switches.h
index c6ff6680ee..ef9c51c6ce 100644
