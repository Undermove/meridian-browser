diff --git a/chrome/browser/meridian/sidebar_handler_mac.mm b/chrome/browser/meridian/sidebar_handler_mac.mm
index bcdc3cd847..f49e8ce8a3 100644
--- a/chrome/browser/meridian/sidebar_handler_mac.mm
+++ b/chrome/browser/meridian/sidebar_handler_mac.mm
@@ -115,6 +115,26 @@ void SidebarHandler::SetWindowControlsVisible(bool visible) {
   }
 }
 
+void SidebarHandler::IsPointerOverWindowControls(
+    IsPointerOverWindowControlsCallback callback) {
+  NSWindow* window =
+      browser_->GetWindow()->GetNativeWindow().GetNativeNSWindow();
+  bool over = false;
+  const NSPoint mouse = NSEvent.mouseLocation;
+  for (NSWindowButton kind :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    NSButton* button = [window standardWindowButton:kind];
+    if (!button || button.hiddenOrHasHiddenAncestor) {
+      continue;
+    }
+    const NSRect in_window = [button convertRect:button.bounds toView:nil];
+    // A little around them, and the gaps between them.
+    over |= NSPointInRect(
+        mouse, NSInsetRect([window convertRectToScreen:in_window], -6, -6));
+  }
+  std::move(callback).Run(over);
+}
+
 void SidebarHandler::TestWindowState(TestWindowStateCallback callback) {
   NSWindow* window =
       browser_->GetWindow()->GetNativeWindow().GetNativeNSWindow();
diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index d938cbf444..6d94bb66bd 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -671,12 +671,14 @@ export class WebuiBrowserAppElement extends CrLitElement {
   protected onEdgeHotzoneMouseenter_() {
     if (this.sidebarHidden_) {
       clearTimeout(this.peekCloseTimer_);
+      this.peekCloseTimer_ = 0;
       this.sidebarPeek_ = true;
     }
   }
 
   protected onSidebarMouseenter_() {
     clearTimeout(this.peekCloseTimer_);
+    this.peekCloseTimer_ = 0;
   }
 
   protected onSidebarMouseleave_() {
@@ -696,14 +698,24 @@ export class WebuiBrowserAppElement extends CrLitElement {
 
   private closePeekSoon_() {
     clearTimeout(this.peekCloseTimer_);
-    this.peekCloseTimer_ = setTimeout(() => {
-      if (this.$.tabstrip.menuOpen()) {
-        this.closePeekSoon_();
+    const timer = setTimeout(async () => {
+      // On the window's buttons the page hears nothing, but the pointer is
+      // still on its way to use them.
+      if (this.$.tabstrip.menuOpen() ||
+          await this.$.tabstrip.pointerOverWindowControls()) {
+        // (Unless it came back to the sidebar meanwhile.)
+        if (this.peekCloseTimer_ === timer) {
+          this.closePeekSoon_();
+        }
+        return;
+      }
+      if (this.peekCloseTimer_ !== timer) {
         return;
       }
       this.closeSiteControl_();
       this.sidebarPeek_ = false;
     }, 450);
+    this.peekCloseTimer_ = timer;
   }
 
   // Meridian split view: the content region shows the active tab's split.
