   // Asks Claude Desktop to quit (it asks about unsaved work itself) and opens
   // it again; `message` says what happened.
   RestartClaudeDesktop() => (bool ok, string message);
+  // The pointer is on the window's close, minimize or zoom button, which
+  // the page can't see (macOS).
+  IsPointerOverWindowControls() => (bool over);
   FinishOnboarding();
   IsDefaultBrowser() => (bool is_default);
   // macOS asks the person to confirm.
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
