+  async pointerOverWindowControls(): Promise<boolean> {
+    return (await this.handler_.isPointerOverWindowControls()).over;
+  }
+
   setWindowControlsVisible(visible: boolean) {
     this.handler_.setWindowControlsVisible(visible);
   }
