@@ -511,6 +522,26 @@ bool SidebarHandler::HandleCommand(BrowserWindowInterface* browser,
   if (id == IDC_NEW_TAB) {
     return ShowCommandBar(browser);
   }
+  // ⇧⌥⌘C: "[title](url)" of the page (Arc's Copy URL as Markdown).
+  if (id == IDC_MERIDIAN_COPY_MARKDOWN) {
+    tabs::TabInterface* tab = browser->GetActiveTabInterface();
+    if (!tab) {
+      return true;
+    }
+    content::WebContents* contents = tab->GetContents();
+    std::u16string title = contents->GetTitle();
+    base::ReplaceChars(title, u"[]", u"", &title);
+    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+        .WriteText(u"[" + title + u"](" +
+                   base::UTF8ToUTF16(contents->GetVisibleURL().spec()) +
+                   u")");
+    return true;
+  }
+  // ⌥⌘N: a Little Window (Arc's Little Arc) on a new tab page.
+  if (id == IDC_MERIDIAN_LITTLE_WINDOW) {
+    OpenLittleWindow(browser->GetProfile(), GURL(chrome::kChromeUINewTabURL));
+    return true;
+  }
   mojom::Command command;
   int arg = 0;
   if (id >= IDC_SELECT_TAB_0 && id <= IDC_SELECT_TAB_7) {
