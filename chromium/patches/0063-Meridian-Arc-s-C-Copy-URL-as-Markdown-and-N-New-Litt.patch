         IDC_MERIDIAN_ARCHIVE, IDC_MERIDIAN_CLEAR_TODAY,
         IDC_MERIDIAN_WELCOME_TOUR, IDC_MERIDIAN_IMPORT_ARC,
         IDC_MERIDIAN_ASK, IDC_MERIDIAN_CHAT, IDC_MERIDIAN_WORKBENCH,
-        IDC_MERIDIAN_MISSION}) {
+        IDC_MERIDIAN_MISSION, IDC_MERIDIAN_COPY_MARKDOWN,
+        IDC_MERIDIAN_LITTLE_WINDOW}) {
     command_updater_->UpdateCommandEnabled(meridian_command, supports_tabs);
   }
   for (int i = IDC_MERIDIAN_SPACE_1; i <= IDC_MERIDIAN_SPACE_9; ++i) {
