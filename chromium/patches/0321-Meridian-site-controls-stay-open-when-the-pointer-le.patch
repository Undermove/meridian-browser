From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 26 Nov 2026 13:10:19 +0400
Subject: [PATCH] Meridian: site controls stay open when the pointer leaves a
 shown sidebar

Only the floating (peek) sidebar closes itself, and its site controls
with it, when the pointer leaves.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/resources/webui_browser/app.ts | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index 77023f3d95..ca1ce9a641 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -727,6 +727,13 @@ export class WebuiBrowserAppElement extends CrLitElement {
 
   private closePeekSoon_() {
     clearTimeout(this.peekCloseTimer_);
+    this.peekCloseTimer_ = 0;
+    // Only the floating sidebar goes away by itself. A sidebar that stays
+    // put keeps its panels (site controls) open while the pointer goes to
+    // the page, until a click elsewhere or Esc, as in Arc.
+    if (!this.sidebarPeek_) {
+      return;
+    }
     const timer = setTimeout(async () => {
       // On the window's buttons the page hears nothing, but the pointer is
       // still on its way to use them.
@@ -738,7 +745,8 @@ export class WebuiBrowserAppElement extends CrLitElement {
         }
         return;
       }
-      if (this.peekCloseTimer_ !== timer) {
+      // Pinned again meanwhile (⌘S): nothing floats to send away.
+      if (this.peekCloseTimer_ !== timer || !this.sidebarPeek_) {
         return;
       }
       this.closeSiteControl_();
-- 
