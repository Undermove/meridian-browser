+    // type_text into a <select>: the option whose text (or value) it names.
+    chooseOption(want) {
+      const el = window.__meridianTarget;
+      if (!el || !el.isConnected || el.tagName !== 'SELECT') return {error: 'not a dropdown'};
+      const norm = (s) => String(s || '').trim().replace(/\s+/g, ' ').toLowerCase();
+      const w = norm(want);
+      const options = [...el.options];
+      const option = options.find((o) => norm(o.text) === w) || options.find((o) => norm(o.value) === w) ||
+          options.find((o) => norm(o.text).startsWith(w)) || (w && options.find((o) => norm(o.text).includes(w)));
+      if (!option) return {error: `no option "${clip(want, 60)}"; the options are: ${options.slice(0, 40).map((o) => clip(o.text, 40)).join(' | ')}`};
+      if (option.disabled) return {error: `the option "${clip(option.text, 60)}" is disabled`};
+      el.focus();
+      if (el.multiple) option.selected = true; else el.value = option.value;
+      // What a person's choice sends (pages listen for these).
+      el.dispatchEvent(new Event('input', {bubbles: true}));
+      el.dispatchEvent(new Event('change', {bubbles: true}));
+      return {chosen: clip(option.text, 100)};
+    },
+
     readTarget() {
       const el = window.__meridianTarget;
       if (!el || !el.isConnected) return null;
