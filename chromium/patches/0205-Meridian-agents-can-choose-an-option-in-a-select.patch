+// type_text into a dropdown: the option it names is chosen, the way a
+// person's pick in the (native, out-of-page) list would.
+void AgentService::ChooseOption(tabs::TabHandle handle,
+                                std::unique_ptr<Call> call,
+                                const std::string& label,
+                                const std::string& value) {
+  Confirm(std::move(call), "choose “" + value + "” in “" + label + "”",
+          base::BindOnce(
+              [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+                 std::string value, std::unique_ptr<Call> call) {
+                tabs::TabInterface* tab = handle.Get();
+                if (!self || !tab) {
+                  return call->Fail("the tab is gone");
+                }
+                self->RunInPage(
+                    tab->GetContents(),
+                    "__meridianAgent.chooseOption(" +
+                        base::WriteJson(base::Value(value)).value_or("\"\"") +
+                        ")",
+                    base::BindOnce(
+                        [](std::unique_ptr<Call> call, base::Value result) {
+                          if (!result.is_dict()) {
+                            return call->Fail("couldn't look at the page");
+                          }
+                          const base::DictValue& r = result.GetDict();
+                          if (const std::string* error = r.FindString("error")) {
+                            return call->Fail(*error);
+                          }
+                          base::DictValue out;
+                          out.Set("chosen", r.FindString("chosen")
+                                                ? *r.FindString("chosen")
+                                                : std::string());
+                          call->Ok(base::Value(std::move(out)));
+                        },
+                        std::move(call)));
+              },
+              weak_factory_.GetWeakPtr(), handle, value));
+}
