From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Fri, 20 Nov 2026 00:29:19 +0400
Subject: [PATCH 197/202] Meridian: background tests: clicks and scrolling
 always pass through their windows

With alpha forced to 0 the check "alpha > 0" never held, so a see-through
test window on top could take the person's clicks and scrolling.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/app_controller_mac.mm | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/chrome/browser/app_controller_mac.mm b/chrome/browser/app_controller_mac.mm
index b67fa1fb69..07e621b53e 100644
--- a/chrome/browser/app_controller_mac.mm
+++ b/chrome/browser/app_controller_mac.mm
@@ -944,10 +944,14 @@ class AppControllerProfileObserver : public ProfileAttributesStorage::Observer,
     // opened over DevTools, a bubble): every window of this app is
     // see-through and lets clicks pass, as soon as it updates (and on a
     // timer, should one not).
+    // (Clicks and scrolling pass through always: a see-through window on
+    // top of the person's own apps must not take them.)
     auto hide = ^{
       for (NSWindow* window in NSApp.windows) {
         if (window.alphaValue > 0) {
           window.alphaValue = 0;
+        }
+        if (!window.ignoresMouseEvents) {
           window.ignoresMouseEvents = YES;
         }
       }
@@ -983,6 +987,8 @@ class AppControllerProfileObserver : public ProfileAttributesStorage::Observer,
                   NSWindow* window = note.object;
                   if (window.alphaValue > 0) {
                     window.alphaValue = 0;
+                  }
+                  if (!window.ignoresMouseEvents) {
                     window.ignoresMouseEvents = YES;
                   }
                 }];
