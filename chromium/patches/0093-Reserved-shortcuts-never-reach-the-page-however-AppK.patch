index 7188576c05..9cf4ab3632 100644
--- a/chrome/browser/ui/webui_browser/webui_browser_window_mac.mm
+++ b/chrome/browser/ui/webui_browser/webui_browser_window_mac.mm
@@ -13,6 +13,7 @@
 #include "chrome/browser/ui/browser_command_controller.h"
 #include "chrome/browser/ui/browser_commands.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/global_keyboard_shortcuts_mac.h"
 #import "chrome/browser/ui/cocoa/browser_window_command_handler.h"
 #import "chrome/browser/ui/cocoa/chrome_command_dispatcher_delegate.h"
 #include "components/input/native_web_keyboard_event.h"
@@ -56,6 +57,42 @@ bool ShouldHandleKeyboardEvent(const input::NativeWebKeyboardEvent& event) {
 
 }  // namespace
 
+int WebUIBrowserWindow::ReservedCommandForKeyEvent(
+    const input::NativeWebKeyboardEvent& event) {
+  if (event.GetType() != blink::WebInputEvent::Type::kRawKeyDown) {
+    return 0;
+  }
+  int command = NO_COMMAND;
+  if (event.os_event && event.os_event.Get().type == NSEventTypeKeyDown) {
+    command = CommandForKeyEvent(event.os_event.Get()).chrome_command;
+  }
+  if (command == NO_COMMAND) {
+    // The key on its own, by its Mac key code and modifiers: what reaches a
+    // page may lack the characters the menus match by (an arrow's, say).
+    int modifiers = event.GetModifiers();
+    for (const KeyboardShortcutData& shortcut :
+         GetShortcutsNotPresentInMainMenu()) {
+      if (shortcut.vkey_code == event.native_key_code &&
+          shortcut.command_key ==
+              !!(modifiers & blink::WebInputEvent::kMetaKey) &&
+          shortcut.shift_key ==
+              !!(modifiers & blink::WebInputEvent::kShiftKey) &&
+          shortcut.cntrl_key ==
+              !!(modifiers & blink::WebInputEvent::kControlKey) &&
+          shortcut.opt_key == !!(modifiers & blink::WebInputEvent::kAltKey)) {
+        command = shortcut.chrome_command;
+        break;
+      }
+    }
+  }
+  if (command == NO_COMMAND ||
+      !chrome::BrowserCommandController::From(browser_.get())
+           ->IsReservedCommandOrKey(command, event)) {
+    return 0;
+  }
+  return command;
+}
