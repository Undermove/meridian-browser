diff --git a/chrome/browser/ui/webui_browser/webui_browser_window.cc b/chrome/browser/ui/webui_browser/webui_browser_window.cc
index 26d024ceb3..5fd88ce5a0 100644
--- a/chrome/browser/ui/webui_browser/webui_browser_window.cc
+++ b/chrome/browser/ui/webui_browser/webui_browser_window.cc
@@ -1081,6 +1081,15 @@ WebUIBrowserWindow::PreHandleKeyboardEvent(
   // - If the |browser_| is not for an app, and the |accelerator| is associated
   //   with the browser, and it is not a reserved one, do nothing.
 
+#if BUILDFLAG(IS_MAC)
+  // Meridian: a reserved shortcut never reaches the page (Arc: a
+  // spreadsheet or an editor can't keep ⌘⌥↑/↓ for itself).
+  if (int command = ReservedCommandForKeyEvent(event)) {
+    chrome::ExecuteCommand(browser_.get(), command);
+    return content::KeyboardEventProcessingResult::HANDLED;
+  }
+#endif
+
   if (browser_->GetType() == BrowserWindowInterface::Type::TYPE_APP ||
       browser_->GetType() == BrowserWindowInterface::Type::TYPE_APP_POPUP) {
     // Let all keys fall through to a v1 app's web content, even accelerators.
