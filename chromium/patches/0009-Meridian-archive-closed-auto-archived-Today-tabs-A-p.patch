+void SidebarHandler::ClearToday() {
+  std::vector<content::WebContents*> today;
+  for (int i = 0; i < model()->count(); ++i) {
+    tabs::TabInterface* tab = model()->GetTabAtIndex(i);
+    const TabData* data = TabData::Get(tab->GetContents());
+    if (IsTodayTab(tab) &&
+        (!data || data->space_id() == service_->active_space_id())) {
+      today.push_back(tab->GetContents());
