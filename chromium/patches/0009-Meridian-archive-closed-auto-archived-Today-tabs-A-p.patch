+// A tab opened from a pinned tab or favorite into another site becomes a
+// Peek over it (Arc). Its URL often isn't known when it is inserted (a
+// target=_blank link starts loading after), so this runs again on changes.
+void SidebarHandler::MaybePeek(tabs::TabInterface* tab) {
+  auto candidate = peek_candidates_.find(tab->GetHandle());
+  if (candidate == peek_candidates_.end()) {
+    int index = model()->GetIndexOfTab(tab);
+    tabs::TabInterface* opener = index == TabStripModel::kNoTab
+                                     ? nullptr
+                                     : model()->GetOpenerOfTabAt(index);
+    const TabData* opener_data =
+        opener ? TabData::Get(opener->GetContents()) : nullptr;
+    if (!opener_data || opener_data->item_id().empty()) {
+      return;
+    }
+    candidate = peek_candidates_
+                    .emplace(tab->GetHandle(),
+                             opener->GetContents()->GetLastCommittedURL())
+                    .first;
+  }
+  GURL to = tab->GetContents()->GetVisibleURL();
+  if (!to.SchemeIsHTTPOrHTTPS()) {
+    return;  // not known yet
+  }
+  bool peek = !net::registry_controlled_domains::SameDomainOrHost(
+      candidate->second, to,
+      net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  peek_candidates_.erase(candidate);
+  if (peek) {
+    TabData::SetPeek(tab->GetContents(), true);
+    ScheduleNotify();
+  }
+}
