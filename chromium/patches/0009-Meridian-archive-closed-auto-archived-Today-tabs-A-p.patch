+  private peekLayer_: HTMLElement|null = null;
+  private peekHost_: HTMLElement|null = null;
+  private peek_: {tab: string, under: string}|null = null;
+
+  setPeek(peek: {tab: string, under: string, url: string}|null) {
+    for (const webview of this.webviews.values()) {
+      webview.classList.remove('peek-card', 'peek-under');
+    }
+    this.peek_ = peek;
+    this.toggleAttribute('peek', !!peek);
+    if (!peek || !this.webviews.has(peek.tab) || !this.webviews.has(peek.under)) {
+      this.peekLayer_?.remove();
+      return;
+    }
+    this.webviews.get(peek.tab)!.classList.add('peek-card');
+    this.webviews.get(peek.under)!.classList.add('peek-under');
+    if (!this.peekLayer_) {
+      this.peekLayer_ = document.createElement('div');
+      this.peekLayer_.id = 'peekLayer';
+      const backdrop = document.createElement('div');
+      backdrop.id = 'peekBackdrop';
+      backdrop.addEventListener('mousedown', () => this.firePeek_('close'));
+      const bar = document.createElement('div');
+      bar.id = 'peekBar';
+      this.peekHost_ = document.createElement('span');
+      this.peekHost_.className = 'host';
+      bar.appendChild(this.peekHost_);
+      for (const [action, label] of [['split', 'Split'], ['expand', 'Open as Tab'],
+                                     ['close', 'Close']]) {
+        const button = document.createElement('button');
+        button.dataset['action'] = action;
+        button.textContent = label!;
+        button.addEventListener('click', () => this.firePeek_(action!));
+        bar.appendChild(button);
+      }
+      this.peekLayer_.append(backdrop, bar);
+    }
+    try {
+      this.peekHost_!.textContent = new URL(peek.url).hostname;
+    } catch {
+      this.peekHost_!.textContent = peek.url;
