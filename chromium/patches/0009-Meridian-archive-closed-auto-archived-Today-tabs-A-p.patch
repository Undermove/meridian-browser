+void SidebarHandler::ArchiveStaleTabs() {
+  base::Time cutoff = base::Time::Now() - ArchiveAfter();
+  tabs::TabInterface* active = model()->GetActiveTab();
+  std::vector<content::WebContents*> stale;
+  for (int i = 0; i < model()->count(); ++i) {
+    tabs::TabInterface* tab = model()->GetTabAtIndex(i);
+    if (tab == active || tab->GetSplit() || !IsTodayTab(tab)) {
+      continue;
+    }
+    content::WebContents* contents = tab->GetContents();
+    if (contents->GetLastActiveTime() < cutoff &&
+        !contents->IsCurrentlyAudible()) {
+      stale.push_back(contents);
+    }
+  }
+  // Closing archives them (OnTabStripModelChanged).
+  for (content::WebContents* contents : stale) {
+    int index = model()->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab) {
+      model()->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+    }
+  }
