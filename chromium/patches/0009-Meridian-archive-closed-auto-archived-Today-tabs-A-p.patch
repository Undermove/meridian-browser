diff --git a/chrome/browser/meridian/archive_service.cc b/chrome/browser/meridian/archive_service.cc
new file mode 100644
index 0000000000..d345f3f99a
--- /dev/null
+++ b/chrome/browser/meridian/archive_service.cc
@@ -0,0 +1,234 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/archive_service.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/i18n/case_conversion.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/json/values_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "base/uuid.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr base::FilePath::CharType kFileName[] =
+    FILE_PATH_LITERAL("Meridian Archive.json");
+
+bool WorthKeeping(const GURL& url) {
+  if (!url.is_valid() || url.is_empty()) {
+    return false;
+  }
+  if (url.SchemeIs("about") || url.SchemeIs("data") ||
+      url.SchemeIs("javascript")) {
+    return false;
+  }
+  return !(url.SchemeIs("chrome") &&
+           (url.host() == "newtab" || url.host() == "new-tab-page"));
+}
+
+std::optional<std::string> ReadFile(const base::FilePath& path) {
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return std::nullopt;
+  }
+  return json;
+}
+
+std::u16string Fold(const std::string& s) {
+  return base::i18n::ToLower(base::UTF8ToUTF16(s));
+}
+
+}  // namespace
+
+class ArchiveService::Serializer
+    : public base::ImportantFileWriter::DataSerializer {
+ public:
+  explicit Serializer(ArchiveService* service) : service_(service) {}
+  std::optional<std::string> SerializeData() override {
+    return base::WriteJson(service_->ToValue());
+  }
+
+ private:
+  raw_ptr<ArchiveService> service_;
+};
+
+ArchiveService::ArchiveService(const base::FilePath& profile_path,
+                               bool off_the_record)
+    : off_the_record_(off_the_record),
+      serializer_(std::make_unique<Serializer>(this)) {
+  if (profile_path.empty() || off_the_record) {
+    return;
+  }
+  scoped_refptr<base::SequencedTaskRunner> file_runner =
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
+  base::FilePath path = profile_path.Append(kFileName);
+  writer_ = std::make_unique<base::ImportantFileWriter>(path, file_runner);
+  file_runner->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ReadFile, path),
+      base::BindOnce(&ArchiveService::OnLoaded, weak_factory_.GetWeakPtr()));
+}
+
+ArchiveService::~ArchiveService() {
+  if (writer_ && writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
+
+void ArchiveService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void ArchiveService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void ArchiveService::OnLoaded(std::optional<std::string> json) {
+  if (!json) {
+    return;
+  }
+  std::optional<base::Value> value =
+      base::JSONReader::Read(*json, base::JSON_PARSE_RFC);
+  if (!value || !value->is_list()) {
+    return;
+  }
+  // Entries archived while loading go first (they're newer).
+  std::vector<ArchivedTab> loaded = FromValue(value->GetList());
+  entries_.insert(entries_.end(), loaded.begin(), loaded.end());
+  if (entries_.size() > kMaxEntries) {
+    entries_.resize(kMaxEntries);
+  }
+  for (Observer& o : observers_) {
+    o.OnArchiveChanged();
+  }
+}
+
+void ArchiveService::Add(const GURL& url,
+                         const std::string& title,
+                         const std::string& space_id,
+                         base::Time when) {
+  if (off_the_record_ || !WorthKeeping(url)) {
+    return;
+  }
+  // The same page archived again moves to the top.
+  std::erase_if(entries_, [&](const ArchivedTab& e) { return e.url == url; });
+  ArchivedTab entry;
+  entry.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  entry.url = url;
+  entry.title = title;
+  entry.space_id = space_id;
+  entry.archived_at = when;
+  entries_.insert(entries_.begin(), std::move(entry));
+  if (entries_.size() > kMaxEntries) {
+    entries_.resize(kMaxEntries);
+  }
+  Changed();
+}
+
+std::optional<ArchivedTab> ArchiveService::Take(const std::string& id) {
+  auto it = std::ranges::find(entries_, id, &ArchivedTab::id);
+  if (it == entries_.end()) {
+    return std::nullopt;
+  }
+  ArchivedTab entry = std::move(*it);
+  entries_.erase(it);
+  Changed();
+  return entry;
+}
+
+void ArchiveService::Remove(const std::string& id) {
+  Take(id);
+}
+
+void ArchiveService::Clear() {
+  entries_.clear();
+  Changed();
+}
+
+std::vector<ArchivedTab> ArchiveService::Search(const std::string& query,
+                                                size_t limit) const {
+  std::vector<ArchivedTab> out;
+  std::u16string q = Fold(query);
+  for (const ArchivedTab& e : entries_) {
+    if (out.size() >= limit) {
+      break;
+    }
+    if (q.empty() || Fold(e.title).find(q) != std::u16string::npos ||
+        Fold(e.url.spec()).find(q) != std::u16string::npos) {
+      out.push_back(e);
+    }
+  }
+  return out;
+}
+
+base::ListValue ArchiveService::ToValue() const {
+  base::ListValue list;
+  for (const ArchivedTab& e : entries_) {
+    base::DictValue d;
+    d.Set("id", e.id);
+    d.Set("url", e.url.spec());
+    d.Set("title", e.title);
+    d.Set("space", e.space_id);
+    d.Set("at", base::TimeToValue(e.archived_at));
+    list.Append(std::move(d));
+  }
+  return list;
+}
+
+// static
+std::vector<ArchivedTab> ArchiveService::FromValue(
+    const base::ListValue& list) {
+  std::vector<ArchivedTab> out;
+  for (const base::Value& v : list) {
+    if (!v.is_dict()) {
+      continue;
+    }
+    const base::DictValue& d = v.GetDict();
+    const std::string* id = d.FindString("id");
+    const std::string* url = d.FindString("url");
+    if (!id || !url || !GURL(*url).is_valid()) {
+      continue;
+    }
+    ArchivedTab e;
+    e.id = *id;
+    e.url = GURL(*url);
+    if (const std::string* title = d.FindString("title")) {
+      e.title = *title;
+    }
+    if (const std::string* space = d.FindString("space")) {
+      e.space_id = *space;
+    }
+    if (const base::Value* at = d.Find("at")) {
+      e.archived_at = base::ValueToTime(*at).value_or(base::Time());
+    }
+    out.push_back(std::move(e));
+  }
+  return out;
+}
+
+void ArchiveService::FlushForTesting() {
+  if (writer_ && writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
+
+void ArchiveService::Changed() {
+  if (writer_) {
+    writer_->ScheduleWrite(serializer_.get());
+  }
+  for (Observer& o : observers_) {
+    o.OnArchiveChanged();
+  }
+}
+
+}  // namespace meridian
diff --git a/chrome/browser/meridian/archive_service.h b/chrome/browser/meridian/archive_service.h
new file mode 100644
index 0000000000..c1899475e3
--- /dev/null
+++ b/chrome/browser/meridian/archive_service.h
@@ -0,0 +1,91 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_ARCHIVE_SERVICE_H_
+#define CHROME_BROWSER_MERIDIAN_ARCHIVE_SERVICE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/important_file_writer.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "url/gurl.h"
+
+namespace meridian {
+
+// A Today tab that was closed or auto-archived, kept so it can be found and
+// reopened (Arc's archive).
+struct ArchivedTab {
+  std::string id;
+  GURL url;
+  std::string title;
+  std::string space_id;
+  base::Time archived_at;
+};
+
+// The archive of one profile, newest first, capped at kMaxEntries. Saved as
+// "<profile>/Meridian Archive.json"; off-the-record profiles keep nothing.
+class ArchiveService : public KeyedService {
+ public:
+  static constexpr size_t kMaxEntries = 5000;
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnArchiveChanged() = 0;
+  };
+
+  // `profile_path` empty: in memory only. `off_the_record`: archives nothing.
+  ArchiveService(const base::FilePath& profile_path, bool off_the_record);
+  ArchiveService(const ArchiveService&) = delete;
+  ArchiveService& operator=(const ArchiveService&) = delete;
+  ~ArchiveService() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  const std::vector<ArchivedTab>& entries() const { return entries_; }
+
+  // Ignores URLs not worth keeping (new tab page, about:blank, ...).
+  void Add(const GURL& url,
+           const std::string& title,
+           const std::string& space_id,
+           base::Time when);
+  // Removes and returns the entry, for reopening.
+  std::optional<ArchivedTab> Take(const std::string& id);
+  void Remove(const std::string& id);
+  void Clear();
+
+  // Case-insensitive match on title and URL; empty query: everything.
+  std::vector<ArchivedTab> Search(const std::string& query,
+                                  size_t limit) const;
+
+  base::ListValue ToValue() const;
+  static std::vector<ArchivedTab> FromValue(const base::ListValue& list);
+  void FlushForTesting();
+
+ private:
+  class Serializer;
+
+  void OnLoaded(std::optional<std::string> json);
+  void Changed();
+
+  const bool off_the_record_;
+  std::vector<ArchivedTab> entries_;
+  std::unique_ptr<Serializer> serializer_;
+  std::unique_ptr<base::ImportantFileWriter> writer_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<ArchiveService> weak_factory_{this};
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_ARCHIVE_SERVICE_H_
diff --git a/chrome/browser/meridian/archive_service_unittest.cc b/chrome/browser/meridian/archive_service_unittest.cc
new file mode 100644
index 0000000000..82f1f5c45f
--- /dev/null
+++ b/chrome/browser/meridian/archive_service_unittest.cc
@@ -0,0 +1,81 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/archive_service.h"
+
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/test/task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+class ArchiveServiceTest : public testing::Test {
+ protected:
+  base::test::TaskEnvironment env_;
+};
+
+TEST_F(ArchiveServiceTest, KeepsNewestFirstWithoutDuplicatesOrJunk) {
+  ArchiveService archive{base::FilePath(), /*off_the_record=*/false};
+  base::Time now = base::Time::Now();
+  archive.Add(GURL("https://a.example/"), "A", "s", now);
+  archive.Add(GURL("https://b.example/"), "B", "s", now);
+  archive.Add(GURL("https://a.example/"), "A again", "s", now);
+  archive.Add(GURL("chrome://newtab/"), "New Tab", "s", now);
+  archive.Add(GURL("about:blank"), "", "s", now);
+  ASSERT_EQ(archive.entries().size(), 2u);
+  EXPECT_EQ(archive.entries()[0].title, "A again");
+  EXPECT_EQ(archive.entries()[1].title, "B");
+}
+
+TEST_F(ArchiveServiceTest, SearchTakeAndOffTheRecord) {
+  ArchiveService archive{base::FilePath(), false};
+  archive.Add(GURL("https://docs.example/design"), "Design Doc", "s",
+              base::Time::Now());
+  archive.Add(GURL("https://mail.example/"), "Inbox", "s", base::Time::Now());
+  EXPECT_EQ(archive.Search("DESIGN", 10).size(), 1u);
+  EXPECT_EQ(archive.Search("mail.example", 10).size(), 1u);
+  EXPECT_EQ(archive.Search("", 1).size(), 1u);
+  std::string id = archive.entries()[0].id;
+  auto taken = archive.Take(id);
+  ASSERT_TRUE(taken);
+  EXPECT_EQ(archive.entries().size(), 1u);
+  EXPECT_FALSE(archive.Take(id));
+
+  ArchiveService incognito{base::FilePath(), /*off_the_record=*/true};
+  incognito.Add(GURL("https://secret.example/"), "x", "s", base::Time::Now());
+  EXPECT_TRUE(incognito.entries().empty());
+}
+
+TEST_F(ArchiveServiceTest, SavesAndLoads) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::Time when = base::Time::Now() - base::Hours(13);
+  {
+    ArchiveService archive(dir.GetPath(), false);
+    env_.RunUntilIdle();
+    archive.Add(GURL("https://kept.example/"), "Kept", "space-1", when);
+    archive.FlushForTesting();
+    env_.RunUntilIdle();
+  }
+  ArchiveService again(dir.GetPath(), false);
+  env_.RunUntilIdle();
+  ASSERT_EQ(again.entries().size(), 1u);
+  EXPECT_EQ(again.entries()[0].title, "Kept");
+  EXPECT_EQ(again.entries()[0].space_id, "space-1");
+  EXPECT_EQ(again.entries()[0].archived_at, when);
+}
+
+TEST_F(ArchiveServiceTest, Capped) {
+  ArchiveService archive{base::FilePath(), false};
+  for (size_t i = 0; i < ArchiveService::kMaxEntries + 10; ++i) {
+    archive.Add(GURL("https://e.example/" + base::NumberToString(i)), "e", "s",
+                base::Time::Now());
+  }
+  EXPECT_EQ(archive.entries().size(), ArchiveService::kMaxEntries);
+}
+
+}  // namespace
+}  // namespace meridian
