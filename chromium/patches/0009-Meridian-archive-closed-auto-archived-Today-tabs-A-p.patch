+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianArchiveElement} from './archive.js';
+import {icon} from './icons.js';
+
+export function getHtml(this: MeridianArchiveElement) {
+  return html`<!--_html_template_start_-->
+<div id="overlay" @mousedown="${this.onOverlayMousedown_}"
+    @keydown="${this.onOverlayKeydown_}">
+  <div id="panel">
+    <div id="head">
+      <span class="ic">${icon('archive', 18)}</span>
+      <input id="search" placeholder="Search the archive" spellcheck="false"
+          @input="${this.onSearchInput_}">
+    </div>
+    <div id="list">
+      ${this.empty_ ? html`
+        <div class="empty">Tabs you close, and Today tabs you leave alone for
+          12 hours, land here.</div>` : ''}
+      ${this.groups_.map(group => html`
+        <div class="day">${group.label}</div>
+        ${group.tabs.map(tab => html`
+          <div class="entry" data-id="${tab.id}" title="${tab.url}"
+              @click="${this.onRowClick_}">
+            <img src="${this.favicon_(tab.url)}" width="16" height="16" alt="">
+            <span class="title">${tab.title || tab.url}</span>
+            <span class="host">${this.host_(tab.url)}</span>
+            <span class="time">${this.time_(tab.archivedAt)}</span>
+            <button class="forget" title="Remove from the archive"
+                data-id="${tab.id}" @click="${this.onDeleteClick_}">
+              ${icon('x', 14)}
+            </button>
+          </div>`)}
+      `)}
+    </div>
+  </div>
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/archive.ts b/chrome/browser/resources/webui_browser/meridian/archive.ts
new file mode 100644
index 0000000000..ec4645684f
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/archive.ts
@@ -0,0 +1,170 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The archive (⌥⌘A): closed and auto-archived Today tabs, newest first,
+// grouped by day; search, reopen, forget.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {ArchivedTab, SidebarHandlerInterface} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './archive.css.js';
+import {getHtml} from './archive.html.js';
+
+export interface ArchiveGroup {
+  label: string;
+  tabs: ArchivedTab[];
+}
+
+export interface MeridianArchiveElement {
+  $: {
+    search: HTMLInputElement,
+  };
+}
+
+export class MeridianArchiveElement extends CrLitElement {
+  static get is() {
+    return 'meridian-archive';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      groups_: {state: true, type: Array},
+      empty_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  protected accessor groups_: ArchiveGroup[] = [];
+  protected accessor empty_: boolean = false;
+
+  private readonly handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  private listenerId_: number|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.listenerId_ =
+        browserProxyFactory.getInstance().callbackRouter.onArchiveChanged
+            .addListener(() => this.open && this.refresh_());
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    if (this.listenerId_ !== null) {
+      browserProxyFactory.getInstance().callbackRouter.removeListener(
+          this.listenerId_);
+      this.listenerId_ = null;
+    }
+  }
+
+  async show() {
+    this.open = true;
+    await this.updateComplete;
+    this.$.search.value = '';
+    this.$.search.focus();
+    await this.refresh_();
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  private async refresh_() {
+    const {tabs} = await this.handler_.searchArchive(this.$.search.value);
+    this.empty_ = tabs.length === 0;
+    this.groups_ = groupByDay(tabs);
+  }
+
+  protected onSearchInput_() {
+    this.refresh_();
+  }
+
+  protected onOverlayMousedown_(e: MouseEvent) {
+    if (e.target === e.currentTarget) {
+      this.hide();
+    }
+  }
+
+  protected onOverlayKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.hide();
+    }
+  }
+
+  protected onRowClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    this.handler_.restoreArchived(id);
+    this.hide();
+  }
+
+  protected onDeleteClick_(e: Event) {
+    e.stopPropagation();
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    this.handler_.deleteArchived(id);
+  }
+
+  protected favicon_(url: string): string {
+    return `chrome://favicon2/?size=16&scaleFactor=2x&allowGoogleServerFallback=0&pageUrl=${
+        encodeURIComponent(url)}`;
+  }
+
+  protected host_(url: string): string {
+    try {
+      return new URL(url).hostname.replace(/^www\./, '');
+    } catch {
+      return url;
+    }
+  }
+
+  protected time_(ms: number): string {
+    return new Date(ms).toLocaleTimeString(
+        undefined, {hour: '2-digit', minute: '2-digit'});
+  }
+}
+
+function groupByDay(tabs: ArchivedTab[]): ArchiveGroup[] {
+  const groups: ArchiveGroup[] = [];
+  const today = new Date();
+  today.setHours(0, 0, 0, 0);
+  const day = 24 * 60 * 60 * 1000;
+  for (const tab of tabs) {
+    const d = new Date(tab.archivedAt);
+    d.setHours(0, 0, 0, 0);
+    const diff = Math.round((today.getTime() - d.getTime()) / day);
+    const label = diff === 0 ? 'Today' :
+        diff === 1          ? 'Yesterday' :
+                              d.toLocaleDateString(undefined, {
+                                weekday: 'long',
+                                month: 'long',
+                                day: 'numeric',
+                              });
+    const last = groups[groups.length - 1];
+    if (last && last.label === label) {
+      last.tabs.push(tab);
+    } else {
+      groups.push({label, tabs: [tab]});
+    }
+  }
+  return groups;
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-archive': MeridianArchiveElement;
+  }
+}
+
+customElements.define(MeridianArchiveElement.is, MeridianArchiveElement);
