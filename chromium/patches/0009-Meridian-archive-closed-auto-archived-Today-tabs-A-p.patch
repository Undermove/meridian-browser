+  std::vector<mojom::ArchivedTabPtr> out;
+  for (const ArchivedTab& e : archive_->Search(query, 500)) {
+    auto m = mojom::ArchivedTab::New();
+    m->id = e.id;
+    m->url = e.url;
+    m->title = e.title;
+    m->space_id = e.space_id;
+    m->archived_at = e.archived_at.InMillisecondsFSinceUnixEpoch();
+    out.push_back(std::move(m));
+  }
+  std::move(callback).Run(std::move(out));
+}
