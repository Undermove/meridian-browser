diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index c9cab120e9..c4cc8808f2 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -647,11 +647,30 @@ void BrowserCommandController::ShowCustomizeChromeSidePanel(
 ////////////////////////////////////////////////////////////////////////////////
 // BrowserCommandController, CommandUpdater implementation:
 
+namespace {
+
+// Meridian's own commands (chrome_command_ids.h, 39700-39725). They have no
+// ActionItem, and with UseActionsForBrowserCommands (on by default) the
+// command updater treats such a command as unsupported and disabled, which
+// left every Meridian menu item and shortcut dead. They are on in every
+// normal window and go straight to the sidebar.
+bool IsMeridianCommand(int id) {
+  return id >= IDC_MERIDIAN_TOGGLE_SIDEBAR && id <= IDC_MERIDIAN_MISSION;
+}
+
+}  // namespace
+
 bool BrowserCommandController::SupportsCommand(int id) const {
+  if (IsMeridianCommand(id)) {
+    return true;
+  }
   return command_updater_->SupportsCommand(id);
 }
 
 bool BrowserCommandController::IsCommandEnabled(int id) const {
+  if (IsMeridianCommand(id)) {
+    return browser_->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL;
+  }
   return command_updater_->IsCommandEnabled(id);
 }
 
@@ -664,6 +683,14 @@ bool BrowserCommandController::ExecuteCommandWithDispositionAndContext(
     return false;
   }
 
+  // Meridian: tab and space commands follow the sidebar (its favorites,
+  // pinned tabs and Today), not the raw tab strip. Here and not only in
+  // HandleCommandWithDisposition(): with actions for browser commands, the
