 #include "base/functional/bind.h"
 #include "base/functional/callback.h"
 #include "content/public/browser/browser_task_traits.h"
@@ -25,6 +28,36 @@ void SidebarHandler::SetWindowControlsVisible(bool visible) {
   }
 }
 
+void SidebarHandler::TestKeyPress(uint16_t key_code,
+                                  const std::string& characters,
+                                  uint32_t modifiers) {
+  if (!HasTestSwitch("meridian-test-keys")) {
+    return;
+  }
+  NSWindow* window =
+      browser_->GetWindow()->GetNativeWindow().GetNativeNSWindow();
+  NSString* chars = base::SysUTF8ToNSString(characters);
+  for (NSEventType type : {NSEventTypeKeyDown, NSEventTypeKeyUp}) {
+    NSEvent* event = [NSEvent keyEventWithType:type
+                                      location:NSZeroPoint
+                                 modifierFlags:modifiers
+                                     timestamp:NSProcessInfo.processInfo
+                                                   .systemUptime
+                                  windowNumber:window.windowNumber
+                                       context:nil
+                                    characters:chars
+                   charactersIgnoringModifiers:chars
+                                     isARepeat:NO
+                                       keyCode:key_code];
+    // What -[NSApplication sendEvent:] does for the key window, which a test
+    // window in the background isn't: key equivalents first, then the
+    // window's first responder.
+    if (type == NSEventTypeKeyUp || ![window performKeyEquivalent:event]) {
+      [window sendEvent:event];
+    }
+  }
+}
