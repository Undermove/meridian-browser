From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Meridian <meridian@localhost>
Date: Thu, 26 Nov 2026 19:05:13 +0400
Subject: [PATCH] Meridian: Windows: the MCP bridge started without
 --user-data-dir doesn't crash

Codex, Claude Code, Claude Desktop and the rest start Meridian's MCP server
as Connect writes it: <Meridian> --mcp-bridge, no --user-data-dir. On
Windows the helper modes run at the very start of ChromeMain, before
install_static::InitializeFromPrimaryModule(); the bridge then asked
chrome::GetDefaultUserDataDirectory(), which reads the install details,
and crashed (0xC0000005) before it said anything. Helper processes now set
the install details up first.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/meridian/BUILD.gn        | 1 +
 chrome/browser/meridian/helper_modes.cc | 5 +++++
 2 files changed, 6 insertions(+)

diff --git a/chrome/browser/meridian/BUILD.gn b/chrome/browser/meridian/BUILD.gn
index a336c5c2b0..be0157d913 100644
--- a/chrome/browser/meridian/BUILD.gn
+++ b/chrome/browser/meridian/BUILD.gn
@@ -354,6 +354,7 @@ source_set("helper_modes") {
       "crash_watcher_win.cc",
       "crash_watcher_win.h",
     ]
+    deps += [ "//chrome/install_static:secondary_module" ]
   }
 }
 
diff --git a/chrome/browser/meridian/helper_modes.cc b/chrome/browser/meridian/helper_modes.cc
index f4cf93bc5a..66f5e58c65 100644
--- a/chrome/browser/meridian/helper_modes.cc
+++ b/chrome/browser/meridian/helper_modes.cc
@@ -29,6 +29,7 @@
 
 #include "base/command_line.h"
 #include "base/strings/utf_string_conversions.h"
+#include "chrome/install_static/initialize_from_primary_module.h"
 #endif
 
 namespace meridian {
@@ -102,6 +103,10 @@ std::optional<int> RunHelperMode() {
   // are, without the C runtime's text mode in between.
   _setmode(_fileno(stdin), _O_BINARY);
   _setmode(_fileno(stdout), _O_BINARY);
+  // What ChromeMain sets up only after this: which install this is. The MCP
+  // bridge's default user data folder (no --user-data-dir: how Codex, Claude
+  // and the rest start it) reads it, and without it the bridge crashed.
+  install_static::InitializeFromPrimaryModule();
   return Run(argc, argv.data());
 }
 #else
