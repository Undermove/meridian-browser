+// Meridian: the WebUI browser frame (chrome://webui-browser) has no history of
+// its own; a swipe over it, or bubbled up from a page that couldn't scroll
+// further, goes back and forward in the window's active tab.
+- (content::WebContents*)historyWebContentsOnWindow:(NSWindow*)window {
+  content::WebContents* webContents = self.webContents;
+  if (!webContents) {
+    return nullptr;
+  }
+  const GURL& url = webContents->GetLastCommittedURL();
+  if (!url.SchemeIs(content::kChromeUIScheme) || url.host() != "webui-browser") {
+    return webContents;
+  }
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithWindow(
+          gfx::NativeWindow(window));
+  tabs::TabInterface* tab = browser ? browser->GetActiveTabInterface() : nullptr;
+  return tab ? tab->GetContents() : nullptr;
+}
+
 - (BOOL)canNavigateInDirection:(history_swiper::NavigationDirection)direction
                       onWindow:(NSWindow*)window {
-  content::WebContents* webContents = self.webContents;
+  content::WebContents* webContents =
+      [self historyWebContentsOnWindow:window];
   if (!webContents) {
     return NO;
   }
@@ -185,7 +207,8 @@
 
