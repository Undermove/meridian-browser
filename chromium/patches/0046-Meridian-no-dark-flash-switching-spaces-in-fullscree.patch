+// macOS full screen (its own Space) for the windows of one frame.
+bool IsInNativeFullscreen(BrowserWindowInterface* browser);
+// Lets `browser` show in a full-screen window's Space, over it.
+void SetOverFullscreen(BrowserWindowInterface* browser, bool over);
