+#if BUILDFLAG(IS_MAC)
+              // In full screen the full-screen window stays put and the
+              // others show over it, in its Space: hiding it would close the
+              // Space (macOS's dark slide out of full screen and back).
+              if (BrowserWindowInterface* base = FullscreenWindowOf(frame)) {
+                if (target != base) {
+                  SetOverFullscreen(target, true);
+                  target->GetWindow()->SetBounds(base->GetWindow()->GetBounds());
+                  target->GetWindow()->Show();
+                  WatchFullscreenExit(frame, base);
+                }
+                target->GetWindow()->Activate();
+                if (current != base) {
+                  current->GetWindow()->Hide();
+                }
+              } else
+#endif
+              {
+                target->GetWindow()->SetBounds(
+                    current->GetWindow()->GetBounds());
+                target->GetWindow()->Show();
+                target->GetWindow()->Activate();
+                current->GetWindow()->Hide();
+              }
             }
             if (show) {
               SidebarHandler::ActivateSpaceInWindow(target, space_id);
