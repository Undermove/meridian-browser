+#if BUILDFLAG(IS_MAC)
+// The frame's window in macOS full screen, if any (another profile's window
+// may be showing over it).
+BrowserWindowInterface* FullscreenWindowOf(int frame) {
+  for (auto& [b, id] : F().frame_of) {
+    if (id == frame && IsInNativeFullscreen(b)) {
+      return b;
+    }
+  }
+  return nullptr;
+}
+
+// When the full-screen window leaves full screen with another profile's
+// window over it, that one takes its place, like any swap.
+void WatchFullscreenExit(int frame, BrowserWindowInterface* base) {
+  static base::NoDestructor<std::set<BrowserWindowInterface*>> watched;
+  if (!watched->insert(base).second) {
+    return;
+  }
+  OnFullscreenExit(base, base::BindOnce(
+                             [](int frame, BrowserWindowInterface* base) {
+                               watched->erase(base);
+                               Frames& f = F();
+                               auto it = f.frame_of.find(base);
+                               auto visible = f.visible_of.find(frame);
+                               if (it == f.frame_of.end() ||
+                                   visible == f.visible_of.end() ||
+                                   visible->second == base) {
+                                 return;
+                               }
+                               BrowserWindowInterface* over = visible->second;
+                               SetOverFullscreen(over, false);
+                               over->GetWindow()->SetBounds(
+                                   base->GetWindow()->GetBounds());
+                               base->GetWindow()->Hide();
+                             },
+                             frame, base));
+}
+#endif
+
 void Track(BrowserWindowInterface* browser, int frame) {
   Frames& f = F();
   f.frame_of[browser] = frame;
