From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 19 Nov 2026 23:52:49 +0400
Subject: [PATCH 194/196] Meridian: E2E tests can run in the background on
 macOS
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

--meridian-test-background (test profiles only): the app is never active —
no focus taken, no windows on screen, no Dock icon — so the tests run beside
the person working on the Mac; their input goes over DevTools.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/app_controller_mac.mm | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/chrome/browser/app_controller_mac.mm b/chrome/browser/app_controller_mac.mm
index d10c9dcfaf..32bbdf5fe2 100644
--- a/chrome/browser/app_controller_mac.mm
+++ b/chrome/browser/app_controller_mac.mm
@@ -84,6 +84,7 @@
 #include "chrome/browser/ui/browser_window/public/create_browser_window.h"
 #include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
 #include "chrome/browser/meridian/little_window.h"
+#include "chrome/browser/meridian/test_switches.h"
 #include "chrome/browser/meridian/sidebar_handler.h"
 #include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
 #include "chrome/browser/ui/chrome_pages.h"
@@ -932,6 +933,12 @@ class AppControllerProfileObserver : public ProfileAttributesStorage::Observer,
 // the default handlers.
 - (void)applicationWillFinishLaunching:(NSNotification*)notification {
   NSWindow.allowsAutomaticWindowTabbing = NO;
+  // Meridian: E2E tests run in the background, beside the person working on
+  // this Mac: never the active app (no focus taken, no Dock icon). Their input
+  // goes to the pages over the DevTools protocol, not through macOS.
+  if (meridian::HasTestSwitch("meridian-test-background")) {
+    [NSApp setActivationPolicy:NSApplicationActivationPolicyProhibited];
+  }
 
   [self initShareMenu];
 }
