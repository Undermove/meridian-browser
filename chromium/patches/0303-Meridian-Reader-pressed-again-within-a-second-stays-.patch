From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Thu, 26 Nov 2026 02:32:27 +0400
Subject: [PATCH 303/304] Meridian: Reader pressed again within a second stays
 as pressed

Exit Reader leaves a check for a second later: a reading view still
there is taken out (the navigation away once dropped). When the reading
view hadn't come in yet, any reading view counted, so Reader pressed again
within that second (in, out, in) was undone and the page shown instead.
Each press now counts, and the check stands down after a later one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/meridian/sidebar_handler.cc | 11 +++++++++--
 chrome/browser/meridian/sidebar_handler.h  |  2 ++
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index 4c09dc41b7..5b5f579b5f 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -581,6 +581,8 @@ void SidebarHandler::PutTabToSleep(const tabs_api::NodeId& tab_id,
 }
 
 void SidebarHandler::ToggleReader(ToggleReaderCallback callback) {
+  // Each press counts: a later one wins over what an earlier one left to do.
+  const int press = ++reader_presses_;
   tabs::TabInterface* tab = model()->GetActiveTab();
   if (!tab) {
     std::move(callback).Run("none");
@@ -628,8 +630,13 @@ void SidebarHandler::ToggleReader(ToggleReaderCallback callback) {
     base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
         FROM_HERE,
         base::BindOnce(
-            [](tabs::TabHandle handle, GURL original, int entry_id,
+            [](base::WeakPtr<SidebarHandler> self, int press,
+               tabs::TabHandle handle, GURL original, int entry_id,
                void (*load)(content::WebContents*, const GURL&)) {
+              // Reader pressed again since (back in, say): that press stands.
+              if (!self || self->reader_presses_ != press) {
+                return;
+              }
               // The tab's page now (the reading view may have come in as a
               // page of its own).
               tabs::TabInterface* tab = handle.Get();
@@ -651,7 +658,7 @@ void SidebarHandler::ToggleReader(ToggleReaderCallback callback) {
               }
               load(contents, original);
             },
-            tab->GetHandle(), original,
+            weak_factory_.GetWeakPtr(), press, tab->GetHandle(), original,
             entry_id,
             static_cast<void (*)(content::WebContents*, const GURL&)>(load)),
         base::Seconds(1));
diff --git a/chrome/browser/meridian/sidebar_handler.h b/chrome/browser/meridian/sidebar_handler.h
index 2ec7b2b589..9d6cf9f9ae 100644
--- a/chrome/browser/meridian/sidebar_handler.h
+++ b/chrome/browser/meridian/sidebar_handler.h
@@ -533,6 +533,8 @@ class SidebarHandler : public mojom::SidebarHandler,
   base::ScopedObservation<mission::MissionControl,
                           mission::MissionControl::Observer>
       mission_observation_{this};
+  // ToggleReader presses so far (its delayed fallback stands down after one).
+  int reader_presses_ = 0;
   base::WeakPtrFactory<SidebarHandler> weak_factory_{this};
 };
 
