+void SidebarHandler::SwitchKeyboardLayout(const std::string& language) {
+  // Test browsers leave the person's keyboard alone.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "meridian-keep-keyboard-layout")) {
+    return;
+  }
+  NSDictionary* filter = @{
+    (__bridge NSString*)kTISPropertyInputSourceCategory :
+        (__bridge NSString*)kTISCategoryKeyboardInputSource,
+    (__bridge NSString*)kTISPropertyInputSourceIsSelectCapable : @YES,
+  };
+  CFArrayRef sources =
+      TISCreateInputSourceList((__bridge CFDictionaryRef)filter, false);
+  if (!sources) {
+    return;
+  }
+  NSString* wanted = base::SysUTF8ToNSString(language);
+  for (CFIndex i = 0; i < CFArrayGetCount(sources); ++i) {
+    TISInputSourceRef source =
+        (TISInputSourceRef)CFArrayGetValueAtIndex(sources, i);
+    NSArray* languages = (__bridge NSArray*)TISGetInputSourceProperty(
+        source, kTISPropertyInputSourceLanguages);
+    if ([languages.firstObject hasPrefix:wanted]) {
+      TISSelectInputSource(source);
+      break;
+    }
+  }
+  CFRelease(sources);
+}
+
 void SidebarHandler::TestKeyPress(uint16_t key_code,
                                   const std::string& characters,
                                   uint32_t modifiers) {
