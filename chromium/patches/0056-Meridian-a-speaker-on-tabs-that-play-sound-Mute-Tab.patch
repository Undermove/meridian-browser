 #include "chrome/browser/meridian/workbench/workbench_handler.h"
 #include "chrome/browser/meridian/ai/ai_service.h"
 #include "chrome/browser/meridian/ai/ai_service_factory.h"
@@ -303,6 +304,13 @@ void SidebarHandler::ExpandPeek(const tabs_api::NodeId& tab_id) {
   }
 }
 
+void SidebarHandler::SetTabMuted(const tabs_api::NodeId& tab_id, bool muted) {
+  if (tabs::TabInterface* tab = TabFor(tab_id)) {
+    SetTabAudioMuted(tab->GetContents(), muted,
+                     TabMutedReason::kAudioIndicator, std::string());
+  }
+}
+
