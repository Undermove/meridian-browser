From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 23 Nov 2026 23:28:35 +0400
Subject: [PATCH 239/245] Meridian: site settings apply to the site on screen

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/sidebar.mojom                       | 3 ++-
 chrome/browser/meridian/sidebar_handler.cc                  | 6 ++++--
 chrome/browser/meridian/sidebar_handler.h                   | 3 ++-
 chrome/browser/meridian/site_control.cc                     | 4 +++-
 chrome/browser/meridian/site_control.h                      | 1 +
 .../resources/webui_browser/meridian/site_control.ts        | 5 +++--
 6 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/chrome/browser/meridian/sidebar.mojom b/chrome/browser/meridian/sidebar.mojom
index cd5ed443bf..e75d384ea1 100644
--- a/chrome/browser/meridian/sidebar.mojom
+++ b/chrome/browser/meridian/sidebar.mojom
@@ -631,8 +631,9 @@ interface SidebarHandler {
 
   // The Site Control Center, for the active tab's site. `type` "ads" is the
   // ad and tracker blocking; settings are "allow", "block" or "ask".
+  // `origin` is the site the person saw: refused if the tab is elsewhere now.
   GetSiteInfo() => (SiteInfo info);
-  SetSitePermission(string type, string setting);
+  SetSitePermission(string origin, string type, string setting);
   // +1 zooms in, -1 out, 0 back to 100%.
   ZoomSite(int32 step);
   // Translates the active tab into the person's language (`on`), or shows
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index f080c132c1..90d7ea2b36 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -3470,10 +3470,12 @@ void SidebarHandler::GetSiteInfo(GetSiteInfoCallback callback) {
       ActiveTabProfile(), model()->GetActiveWebContents()));
 }
 
-void SidebarHandler::SetSitePermission(const std::string& type,
+void SidebarHandler::SetSitePermission(const std::string& origin,
+                                       const std::string& type,
                                        const std::string& setting) {
   meridian::SetSitePermission(ActiveTabProfile(),
-                              model()->GetActiveWebContents(), type, setting);
+                              model()->GetActiveWebContents(), origin, type,
+                              setting);
 }
 
 void SidebarHandler::ZoomSite(int32_t step) {
diff --git a/chrome/browser/meridian/sidebar_handler.h b/chrome/browser/meridian/sidebar_handler.h
index be445e1ba9..59e12ca2a9 100644
--- a/chrome/browser/meridian/sidebar_handler.h
+++ b/chrome/browser/meridian/sidebar_handler.h
@@ -155,7 +155,8 @@ class SidebarHandler : public mojom::SidebarHandler,
   void RunSpaceExtension(const std::string& id,
                          RunSpaceExtensionCallback callback) override;
   void GetSiteInfo(GetSiteInfoCallback callback) override;
-  void SetSitePermission(const std::string& type,
+  void SetSitePermission(const std::string& origin,
+                         const std::string& type,
                          const std::string& setting) override;
   void ZoomSite(int32_t step) override;
   void TranslateSite(bool on) override;
diff --git a/chrome/browser/meridian/site_control.cc b/chrome/browser/meridian/site_control.cc
index d0f0654d1a..7ed308b4d6 100644
--- a/chrome/browser/meridian/site_control.cc
+++ b/chrome/browser/meridian/site_control.cc
@@ -204,13 +204,15 @@ mojom::SiteInfoPtr GetSiteInfo(Profile* profile,
 
 void SetSitePermission(Profile* profile,
                        content::WebContents* contents,
+                       const std::string& origin,
                        const std::string& type,
                        const std::string& setting) {
   if (!contents) {
     return;
   }
   const GURL url = contents->GetLastCommittedURL();
-  if (!IsWebSite(url)) {
+  // Only for the site the person was looking at when they chose.
+  if (!IsWebSite(url) || url::Origin::Create(url).Serialize() != origin) {
     return;
   }
   ContentSetting value = CONTENT_SETTING_DEFAULT;
diff --git a/chrome/browser/meridian/site_control.h b/chrome/browser/meridian/site_control.h
index 85c123b1fe..0029c5dd67 100644
--- a/chrome/browser/meridian/site_control.h
+++ b/chrome/browser/meridian/site_control.h
@@ -30,6 +30,7 @@ mojom::SiteInfoPtr GetSiteInfo(Profile* profile,
 // (back to the default).
 void SetSitePermission(Profile* profile,
                        content::WebContents* contents,
+                       const std::string& origin,
                        const std::string& type,
                        const std::string& setting);
 
diff --git a/chrome/browser/resources/webui_browser/meridian/site_control.ts b/chrome/browser/resources/webui_browser/meridian/site_control.ts
index 6017e2727f..1f511257d4 100644
--- a/chrome/browser/resources/webui_browser/meridian/site_control.ts
+++ b/chrome/browser/resources/webui_browser/meridian/site_control.ts
@@ -213,14 +213,15 @@ export class MeridianSiteControlElement extends CrLitElement {
     }
     // Allowed here, or back to the default (blocked).
     await this.handler_.setSitePermission(
-        'ads', this.info_.adblock ? 'allow' : 'ask');
+        this.info_.origin, 'ads', this.info_.adblock ? 'allow' : 'ask');
     this.refresh_();
   }
 
   protected async onPermissionClick_(e: Event) {
     const type = (e.currentTarget as HTMLElement).dataset['type']!;
     const row = this.rows_.find(r => r.type === type);
-    await this.handler_.setSitePermission(type, row?.allowed ? 'block' : 'allow');
+    await this.handler_.setSitePermission(
+        this.info_?.origin ?? '', type, row?.allowed ? 'block' : 'allow');
     this.refresh_();
   }
 
