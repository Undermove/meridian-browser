+            (std::vector<std::string>{"run", "--format", "json", "--agent",
+                                      "meridian", "--session", "ses_1"}));
+  EXPECT_NE(v1.env["OPENCODE_CONFIG_CONTENT"].find("\"permission\":"),
+            std::string::npos);
+
+  // 2: on its own (no background service outside Meridian's reach), with
+  // the keys it reads.
+  CommandSpec v2 = BuildCommand(opencode, turn, "/tmp/x", true);
+  EXPECT_EQ(v2.args, (std::vector<std::string>{
+                         "run", "--standalone", "--format", "json", "--agent",
+                         "meridian", "--session", "ses_1"}));
+  EXPECT_EQ(v2.stdin_text, turn.prompt);
+  EXPECT_EQ(v2.env.at("OPENCODE_DISABLE_PROJECT_CONFIG"), "1");
+  const std::string& config = v2.env.at("OPENCODE_CONFIG_CONTENT");
+  std::optional<base::Value> read = base::JSONReader::Read(config);
+  ASSERT_TRUE(read) << config;
+  const base::DictValue& c = read->GetDict();
+  // Denied everywhere: globally, and for Meridian's agent.
+  const base::DictValue* meridian = c.FindDictByDottedPath("agents.meridian");
+  ASSERT_NE(meridian, nullptr);
+  const base::ListValue* everywhere = c.FindList("permissions");
+  const base::ListValue* agent = meridian->FindList("permissions");
+  ASSERT_NE(everywhere, nullptr);
+  ASSERT_NE(agent, nullptr);
+  EXPECT_EQ(everywhere->size(), 1u);
+  EXPECT_EQ(agent->size(), 1u);
+  for (const base::ListValue* rules : {everywhere, agent}) {
+    const base::DictValue& rule = rules->front().GetDict();
+    EXPECT_EQ(*rule.FindString("action"), "*");
+    EXPECT_EQ(*rule.FindString("resource"), "*");
+    EXPECT_EQ(*rule.FindString("effect"), "deny");
+  }
+  EXPECT_EQ(*meridian->FindString("system"), "Be brief.");
+  EXPECT_EQ(*meridian->FindString("mode"), "primary");
+  // The keys the one before 2 reads are unknown to it.
+  EXPECT_EQ(c.Find("permission"), nullptr);
+  EXPECT_EQ(c.Find("agent"), nullptr);
+  EXPECT_EQ(meridian->Find("prompt"), nullptr);
+
+  turn.system.clear();
+  CommandSpec v2_plain = BuildCommand(opencode, turn, "/tmp/x", true);
+  EXPECT_EQ(std::ranges::find(v2_plain.args, "--agent"), v2_plain.args.end());
+  EXPECT_EQ(v2_plain.env.at("OPENCODE_CONFIG_CONTENT").find("agents"),
+            std::string::npos);
+}
