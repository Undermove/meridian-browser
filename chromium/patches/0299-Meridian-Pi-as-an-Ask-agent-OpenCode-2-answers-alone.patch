+bool OpenCodeIsV2(const std::string& version_output) {
+  int major = 0;
+  return RE2::PartialMatch(version_output, "v?([0-9]+)\\.[0-9]+\\.[0-9]+",
+                           &major) &&
+         major >= 2;
+}
