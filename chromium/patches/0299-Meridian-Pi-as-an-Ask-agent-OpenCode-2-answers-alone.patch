+TEST(ProvidersTest, PiStreamGivesTextAndOnlyTheLastErrorCounts) {
+  // Pi retries a failed answer itself: only an error nothing follows is one.
+  std::vector<Event> retried = Parse(
+      "pi",
+      "{\"type\":\"session\",\"id\":\"s-1\",\"cwd\":\"/tmp/x\"}\n"
+      "{\"type\":\"message_start\",\"message\":{\"role\":\"user\"}}\n"
+      "{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\","
+      "\"stopReason\":\"error\",\"errorMessage\":\"zai is down\"}}\n"
+      "{\"type\":\"message_update\",\"usage\":{},\"assistantMessageEvent\":"
+      "{\"type\":\"text_delta\",\"delta\":\"Pi \"}}\n"
+      "{\"type\":\"message_update\",\"usage\":{},\"assistantMessageEvent\":"
+      "{\"type\":\"thinking_delta\",\"delta\":\"hidden\"}}\n"
+      "{\"type\":\"message_update\",\"usage\":{},\"assistantMessageEvent\":"
+      "{\"type\":\"text_delta\",\"delta\":\"heard: blank\"}}\n"
+      "{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\","
+      "\"stopReason\":\"stop\"}}\n"
+      "{\"type\":\"agent_end\",\"messages\":[{}]}\n");
+  EXPECT_EQ(Text(retried, Event::Type::kDelta), "Pi heard: blank");
+  EXPECT_EQ(Text(retried, Event::Type::kError), "");
+  EXPECT_EQ(Text(retried, Event::Type::kSession), "");
+
+  std::vector<Event> failed = Parse(
+      "pi",
+      "{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\","
+      "\"stopReason\":\"error\","
+      "\"errorMessage\":\"No API key found for zai\"}}\n");
+  EXPECT_EQ(Text(failed, Event::Type::kDelta), "");
+  EXPECT_EQ(Text(failed, Event::Type::kError), "No API key found for zai");
+
+  std::vector<Event> cut = Parse(
+      "pi",
+      "{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\","
+      "\"stopReason\":\"length\"}}\n");
+  EXPECT_NE(Text(cut, Event::Type::kDelta).find("length limit"),
+            std::string::npos);
+  EXPECT_EQ(Text(cut, Event::Type::kError), "");
+}
