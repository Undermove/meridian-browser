@@ -500,6 +550,26 @@ std::optional<bool> OpenCodeAuth(const std::string& out, std::string*) {
   if (RE2::PartialMatch(clean, "(?i)(\\d+)\\s+credentials?", &count)) {
     return count > 0;
   }
+  // OpenCode 2: one line per sign-in, ending in "stored" (or "environment"
+  // for a key from the shell), and "No authenticated integrations" without.
+  if (RE2::PartialMatch(clean, "(?i)no authenticated")) {
+    return false;
+  }
+  if (RE2::PartialMatch(clean, "(?i)\\b(stored|environment)\\s*(\n|$)")) {
+    return true;
+  }
+  return std::nullopt;
+}
