+TEST(ProvidersTest, SignInChecks) {
+  std::string account;
+  const auto opencode = AuthCheckFor(*FindProvider("opencode"))->parse;
+  // OpenCode before 2 counts credentials; 2 lists them, one per line.
+  EXPECT_EQ(opencode("1 credentials\n", &account), std::optional<bool>(true));
+  EXPECT_EQ(opencode("0 credentials\n", &account),
+            std::optional<bool>(false));
+  EXPECT_EQ(opencode("OpenCode Console   Default                      stored\n",
+                    &account),
+            std::optional<bool>(true));
+  EXPECT_EQ(opencode("zai   env   environment\n", &account),
+            std::optional<bool>(true));
+  EXPECT_EQ(opencode("No authenticated integrations\n", &account),
+            std::optional<bool>(false));
+  EXPECT_EQ(opencode("garbage\n", &account), std::nullopt);
+
+  const auto pi = AuthCheckFor(*FindProvider("pi"))->parse;
+  EXPECT_EQ(pi("provider  model\nzai  glm-5.4\n", &account),
+            std::optional<bool>(true));
+  EXPECT_EQ(pi("No models available. Run pi auth login.\n", &account),
+            std::optional<bool>(false));
+  EXPECT_EQ(pi("Warning: errors loading models.json\n", &account),
+            std::nullopt);
+}
