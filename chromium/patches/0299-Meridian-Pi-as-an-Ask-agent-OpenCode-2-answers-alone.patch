+// Pi's JSON mode (pi --mode json), one object per line. A failed answer is
+// retried by Pi itself, so its error only counts when nothing answered after
+// it; the exit code says nothing either way.
+class PiParser : public JsonLinesParser {
+ public:
+  PiParser()
+      : JsonLinesParser([this](const base::DictValue& o,
+                               std::vector<Event>& out) { Line(o, out); }) {}
+
+  void End(std::vector<Event>& out) override {
+    JsonLinesParser::End(out);
+    if (!error_.empty()) {
+      out.push_back(
+          {Event::Type::kError, std::exchange(error_, std::string())});
+    }
+  }
+
+ private:
+  void Line(const base::DictValue& o, std::vector<Event>& out) {
+    std::string type = StringAt(o, "type");
+    if (type == "message_update" &&
+        StringAt(o, "assistantMessageEvent.type") == "text_delta") {
+      out.push_back(
+          {Event::Type::kDelta, StringAt(o, "assistantMessageEvent.delta")});
+    } else if (type == "message_end" &&
+               StringAt(o, "message.role") == "assistant") {
+      std::string stop = StringAt(o, "message.stopReason");
+      error_.clear();
+      if (stop == "error") {
+        error_ = StringAt(o, "message.errorMessage");
+      } else if (stop == "length") {
+        out.push_back({Event::Type::kDelta,
+                       "\n\n[Pi stopped at its answer length limit.]"});
+      }
+    }
+  }
+
+  std::string error_;
+};
