+TEST(ProvidersTest, PiAnswersFromStdinWithTheModelPickedHere) {
+  Turn turn;
+  turn.prompt = "What is this page?";
+  turn.system = "Be brief.";
+  const Provider& pi = *FindProvider("pi");
+  CommandSpec spec = BuildCommand(pi, turn, "/tmp/x");
+  EXPECT_EQ(spec.args.front(), "--mode");
+  EXPECT_EQ(spec.args[1], "json");
+  // Answers only: nothing of the person's own Pi setup runs with it.
+  for (const char* flag :
+       {"--no-tools", "--no-extensions", "--no-mcp", "--no-skills",
+        "--no-session", "--no-context-files"}) {
+    EXPECT_NE(std::ranges::find(spec.args, flag), spec.args.end()) << flag;
+  }
+  const auto system = std::ranges::find(spec.args, "--system-prompt");
+  ASSERT_NE(system, spec.args.end());
+  EXPECT_EQ(*std::next(system), turn.system);
+  EXPECT_EQ(spec.stdin_text, turn.prompt);
+  EXPECT_TRUE(spec.env.empty());
+  // The model picked in Settings, when one is.
+  EXPECT_EQ(std::ranges::find(spec.args, "--model"), spec.args.end());
+  turn.model = "homelab/qwen3.6-35b-a3b";
+  CommandSpec with_model = BuildCommand(pi, turn, "/tmp/x");
+  const auto model = std::ranges::find(with_model.args, "--model");
+  ASSERT_NE(model, with_model.args.end());
+  EXPECT_EQ(*std::next(model), "homelab/qwen3.6-35b-a3b");
+}
