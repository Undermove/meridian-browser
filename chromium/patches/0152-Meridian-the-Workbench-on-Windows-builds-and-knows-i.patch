From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 16 Nov 2026 20:29:19 +0400
Subject: [PATCH] Meridian: the Workbench on Windows builds and knows its
 system

The dropped files' folder is named with AppendASCII: a FilePath on
Windows takes wide strings, and Append("Meridian Drops") didn't compile.
info() says the system it runs on (win32, linux), not always darwin.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/meridian/workbench/workbench_handler.cc | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/meridian/workbench/workbench_handler.cc b/chrome/browser/meridian/workbench/workbench_handler.cc
index 933a996743..261516b9d8 100644
--- a/chrome/browser/meridian/workbench/workbench_handler.cc
+++ b/chrome/browser/meridian/workbench/workbench_handler.cc
@@ -529,8 +529,8 @@ void WorkbenchHandler::Dispatch(const std::string& method,
               if (!bytes || !base::GetTempDir(&dir)) {
                 return base::unexpected("Can't save this file");
               }
-              dir = dir.Append("Meridian Drops")
-                        .Append(base::Uuid::GenerateRandomV4().AsLowercaseString());
+              dir = dir.AppendASCII("Meridian Drops")
+                        .AppendASCII(base::Uuid::GenerateRandomV4().AsLowercaseString());
               base::FilePath file = dir.Append(base::FilePath::FromUTF8Unsafe(name));
               if (!base::CreateDirectory(dir) || !base::WriteFile(file, *bytes)) {
                 return base::unexpected("Can't save this file");
@@ -1575,7 +1575,13 @@ void WorkbenchHandler::Info(Reply reply) {
             }
             return base::Value(
                 base::DictValue()
+#if BUILDFLAG(IS_MAC)
                     .Set("platform", "darwin")
+#elif BUILDFLAG(IS_WIN)
+                    .Set("platform", "win32")
+#else
+                    .Set("platform", "linux")
+#endif
                     .Set("project", has_project ? base::Value(std::move(project))
                                                 : base::Value())
                     .Set("recents", LiveRecents(store))
