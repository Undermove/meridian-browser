+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_RENDERER_MERIDIAN_COOKIE_BANNER_AGENT_H_
+#define CHROME_RENDERER_MERIDIAN_COOKIE_BANNER_AGENT_H_
+
+#include <optional>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/common/meridian/cookie_banners.mojom.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "mojo/public/cpp/bindings/associated_receiver_set.h"
+
+namespace blink {
+class AssociatedInterfaceRegistry;
+}
+
+namespace meridian {
+
+// Hide cookie banners, in one frame (the browser side is
+// chrome/browser/meridian/cookie_banners.h). The rules go in as user style
+// sheets: the rules for every site parsed once in this renderer and shared by
+// all its documents (blink::WebDocument::InsertSharedStyleSheet), the site's
+// own as a small sheet of the document's. In the main frame, when a consent
+// popup locked the page's scrolling and its box is hidden, a script gives the
+// scrolling back (kUnlockScript).
+class CookieBannerAgent : public content::RenderFrameObserver,
+                          public mojom::CookieBannerAgent {
+ public:
+  CookieBannerAgent(content::RenderFrame* frame,
+                    blink::AssociatedInterfaceRegistry* registry);
+  CookieBannerAgent(const CookieBannerAgent&) = delete;
+  CookieBannerAgent& operator=(const CookieBannerAgent&) = delete;
+  ~CookieBannerAgent() override;
+
+ private:
+  struct Rules {
+    uint64_t generic_id = 0;
+    std::string site;
+    bool unlock = false;
+    bool operator==(const Rules&) const = default;
+  };
+
+  // mojom::CookieBannerAgent:
+  void Apply(uint64_t generic_id,
+             base::ReadOnlySharedMemoryRegion generic,
+             const std::string& site,
+             bool unlock,
+             bool next_document) override;
+
+  // content::RenderFrameObserver:
+  void DidCommitProvisionalLoad(ui::PageTransition transition) override;
+  void DidCreateDocumentElement() override;
+  void DidDispatchDOMContentLoadedEvent() override;
+  void OnDestruct() override;
+
+  void Bind(mojo::PendingAssociatedReceiver<mojom::CookieBannerAgent> receiver);
+  // Puts `rules_` in the document (once it has its <html>), taking away what
+  // was put before.
+  void Update();
+  void RunUnlockScript();
+  // `again`: run it again if it ran (the rules are back on).
+  void ExecuteUnlockScript(int document, bool again);
+
+  Rules rules_;                // For the document shown.
+  Rules inserted_;             // What it has.
+  std::optional<Rules> next_;  // For the document committing next.
+  bool dom_loaded_ = false;
+  bool unlock_script_due_ = false;
+  bool unlock_script_ran_ = false;
+  int document_ = 0;  // Counts the documents committed.
+  mojo::AssociatedReceiverSet<mojom::CookieBannerAgent> receivers_;
+  base::WeakPtrFactory<CookieBannerAgent> weak_factory_{this};
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_RENDERER_MERIDIAN_COOKIE_BANNER_AGENT_H_
