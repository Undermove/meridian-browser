--- /dev/null
+++ b/chrome/common/meridian/cookie_banners.mojom
@@ -0,0 +1,25 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module meridian.mojom;
+
+import "mojo/public/mojom/base/shared_memory.mojom";
+
+// Hide cookie banners in one frame (chrome/browser/meridian/cookie_banners.h,
+// the renderer side in chrome/renderer/meridian/cookie_banner_agent.h). The
+// rules go in as user style sheets, so a page's own !important can't undo
+// them.
+interface CookieBannerAgent {
+  // The rules for the document this frame shows now (`next_document`: the
+  // one it is about to load instead). `generic_id` names the rules for every
+  // site (0: none), the same text in every frame: the renderer parses it once
+  // and reads `generic` only when it hasn't got that id yet. `site`: the
+  // site's own rules. `unlock`: give back the scrolling a consent popup locked
+  // when the popup is hidden. Nothing at all takes the rules away.
+  Apply(uint64 generic_id,
+        mojo_base.mojom.ReadOnlySharedMemoryRegion? generic,
+        string site,
+        bool unlock,
+        bool next_document);
+};
