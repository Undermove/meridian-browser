--- /dev/null
+++ b/chrome/renderer/meridian/cookie_banner_agent.cc
@@ -0,0 +1,282 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/renderer/meridian/cookie_banner_agent.h"
+
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/read_only_shared_memory_region.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "content/public/renderer/render_frame.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_registry.h"
+#include "third_party/blink/public/platform/task_type.h"
+#include "third_party/blink/public/platform/web_string.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_element.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_script_source.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr char kGenericKey[] = "meridian-cookie-banners";
+constexpr char kSiteKey[] = "meridian-cookie-banners-site";
+constexpr char kUnlockKey[] = "meridian-cookie-banners-unlock";
+
+// The scrolling back: user !important beats the page's own, inline ones too.
+constexpr char kUnlockCss[] =
+    "html[meridian-cookie-unlock]{overflow:auto!important;"
+    "position:static!important}\n"
+    "html[meridian-cookie-unlock]>body{overflow:visible!important;"
+    "position:static!important}\n";
+
+// Consent popups' own boxes (the popup and its backdrop), as the cookie list
+// hides them.
+constexpr char kPopupBoxes[] =
+    "#onetrust-consent-sdk,#onetrust-banner-sdk,#onetrust-pc-sdk,"
+    ".onetrust-pc-dark-filter,#didomi-host,#didomi-popup,#didomi-notice,"
+    ".didomi-popup-backdrop,[id^=\"sp_message_container_\"],"
+    "#qc-cmp2-container,.qc-cmp2-container,#qc-cmp2-ui,.qc-cmp-ui-container,"
+    "#CybotCookiebotDialog,#CybotCookiebotDialogBodyUnderlay,"
+    "#usercentrics-root,#usercentrics-cmp-ui,#uc-banner,#truste-consent-track,"
+    "#truste-banner,.truste_overlay,.truste_box_overlay,#consent_blackbar,"
+    "#trustarc-banner-overlay,.fc-consent-root,#iubenda-cs-banner,#cmpbox,"
+    "#cmpwrapper,.cmpboxBG,#cookiescript_injected,#axeptio_overlay,"
+    ".cky-consent-container,.cky-overlay,#cmplz-cookiebanner-container,"
+    "#BorlabsCookieBox,.osano-cm-window,#sd-cmp";
+
+// Runs in an isolated world of the main frame, given kPopupBoxes. Puts
+// meridian-cookie-unlock on <html> while all of this holds:
+// - a consent popup's box is there and hidden (by the cookie rules: the
+//   popups' own boxes are in the list);
+// - the page doesn't scroll: overflow hidden on <html> or <body>, or <body>
+//   fixed in place;
+// - what locked it is the popup's: a consent manager's class on <html> or
+//   <body> (Sourcepoint, Didomi, Quantcast, OneTrust, Cookiebot,
+//   Usercentrics, TrustArc...), or an inline style on them, or a generic
+//   lock class (Bootstrap's modal-open and the like);
+// - no dialog of the site's own is open (a visible modal that isn't the
+//   popup's).
+// Looked at again when <html>'s or <body>'s class or style, or <body>'s
+// children, change, a few times while the page loads, and when the rules
+// come back on.
+constexpr char kUnlockScript[] = R"(((BOXES) => {
+  // Again (the rules back on): look again.
+  if (window.meridianCookieUnlock) { window.meridianCookieUnlock(); return; }
+  const ATTR = 'meridian-cookie-unlock';
+  const CMP_CLASS = /^(sp-message-open|didomi-popup-open|didomi-notice-popup-open|qc-cmp-showing|qc-cmp-ui-showing|qc-cmp2-showing|ot-overflow-hidden|ot-no-scroll|onetrust-.*|CybotCookiebotDialogActive|CybotCookiebot.*|uc-.*overflow.*|overflowHidden|usercentrics-.*|truste.*|trustarc.*|fc-consent-.*|iubenda-cs-.*|cmp-.*open|cky-.*|cmplz-.*|borlabs-.*|osano-.*|axeptio.*)$/;
+  const GENERIC_CLASS = /^(modal-open|no-scroll|noscroll|no-overflow|overflow-hidden|scroll-lock|scroll-locked|lock-scroll|disable-scroll|stop-scrolling|is-locked)$/;
+  const SITE_DIALOGS = 'dialog[open],[aria-modal="true"],[role="dialog"],.modal.show,.modal.in,.modal.is-open';
+  const shown = (el) => el.checkVisibility ? el.checkVisibility() : el.getClientRects().length > 0;
+  const html = document.documentElement;
+  const check = () => {
+    const body = document.body;
+    if (!body || !html) return;
+    const boxes = [...document.querySelectorAll(BOXES)];
+    const hidden = boxes.some((el) => !shown(el));
+    let unlock = false;
+    if (hidden) {
+      const h = getComputedStyle(html), b = getComputedStyle(body);
+      const stuck = (s) => s.overflowY === 'hidden' || s.overflowY === 'clip';
+      const locked = stuck(h) || stuck(b) || b.position === 'fixed' || h.position === 'fixed';
+      const classes = [...html.classList, ...body.classList];
+      const inline = [html, body].some((el) => /overflow[^;]*:\s*(hidden|clip)|position\s*:\s*fixed/i.test(el.getAttribute('style') || ''));
+      const why = classes.some((c) => CMP_CLASS.test(c) || GENERIC_CLASS.test(c)) || inline;
+      const dialog = [...document.querySelectorAll(SITE_DIALOGS)].some(
+          (el) => shown(el) && !boxes.some((box) => box.contains(el)));
+      unlock = locked && why && !dialog;
+      // Unlocked by us, the page looks unlocked: keep it while the popup's
+      // lock is there and no site dialog opens.
+      if (!unlock && html.hasAttribute(ATTR) && !dialog) unlock = why;
+    }
+    if (unlock !== html.hasAttribute(ATTR)) {
+      if (unlock) html.setAttribute(ATTR, ''); else html.removeAttribute(ATTR);
+    }
+  };
+  let timer = 0;
+  const soon = () => { if (!timer) timer = setTimeout(() => { timer = 0; check(); }, 30); };
+  window.meridianCookieUnlock = soon;
+  const watch = new MutationObserver(soon);
+  const observe = () => {
+    watch.observe(html, { attributes: true, attributeFilter: ['class', 'style'], childList: true });
+    if (document.body) watch.observe(document.body, { attributes: true, attributeFilter: ['class', 'style'], childList: true });
+  };
+  observe();
+  if (!document.body) new MutationObserver((_, me) => { if (document.body) { me.disconnect(); observe(); soon(); } }).observe(html, { childList: true });
+  document.addEventListener('DOMContentLoaded', soon);
+  addEventListener('load', soon);
+  for (const ms of [500, 1500, 3000, 6000, 10000]) setTimeout(soon, ms);
+  soon();
+}))";
+
+}  // namespace
+
+CookieBannerAgent::CookieBannerAgent(
+    content::RenderFrame* frame,
+    blink::AssociatedInterfaceRegistry* registry)
+    : content::RenderFrameObserver(frame) {
+  registry->AddInterface<mojom::CookieBannerAgent>(
+      base::BindRepeating(&CookieBannerAgent::Bind, base::Unretained(this)));
+}
+
+CookieBannerAgent::~CookieBannerAgent() = default;
+
+void CookieBannerAgent::Bind(
+    mojo::PendingAssociatedReceiver<mojom::CookieBannerAgent> receiver) {
+  receivers_.Add(this, std::move(receiver));
+}
+
+void CookieBannerAgent::Apply(uint64_t generic_id,
+                              base::ReadOnlySharedMemoryRegion generic,
+                              const std::string& site,
+                              bool unlock,
+                              bool next_document) {
+  // The rules for every site: parsed the first time this renderer sees them.
+  if (generic_id && !blink::WebDocument::HasSharedStyleSheet(generic_id)) {
+    base::ReadOnlySharedMemoryMapping mapping;
+    if (generic.IsValid()) {
+      mapping = generic.Map();
+    }
+    if (!mapping.IsValid()) {
+      generic_id = 0;
+    } else {
+      base::span<const char> text = mapping.GetMemoryAsSpan<char>();
+      blink::WebDocument::SetSharedStyleSheet(
+          generic_id, blink::WebString::FromUtf8(
+                          std::string_view(text.data(), text.size())));
+    }
+  }
+  Rules rules{generic_id, site, unlock};
+  if (next_document) {
+    next_ = std::move(rules);
+    return;
+  }
+  rules_ = std::move(rules);
+  Update();
+}
+
+void CookieBannerAgent::DidCommitProvisionalLoad(
+    ui::PageTransition transition) {
+  // A new document: nothing in it yet, and the rules sent for it.
+  rules_ = next_.value_or(Rules());
+  next_.reset();
+  inserted_ = Rules();
+  dom_loaded_ = false;
+  unlock_script_due_ = false;
+  unlock_script_ran_ = false;
+  ++document_;
+}
+
+void CookieBannerAgent::DidDispatchDOMContentLoadedEvent() {
+  dom_loaded_ = true;
+  if (unlock_script_due_) {
+    RunUnlockScript();
+  }
+}
+
+void CookieBannerAgent::RunUnlockScript() {
+  // Not from inside the frame's own notifications (a script run from there
+  // doesn't run): tasks of their own, once the DOM is in. The script (and
+  // the isolated world it needs, a few ms) only on pages with a popup's box:
+  // looked for now and a few times while consent managers load.
+  unlock_script_due_ = !dom_loaded_;
+  if (unlock_script_due_) {
+    return;
+  }
+  scoped_refptr<base::SingleThreadTaskRunner> runner =
+      render_frame()->GetTaskRunner(blink::TaskType::kInternalDefault);
+  runner->PostTask(FROM_HERE,
+                   base::BindOnce(&CookieBannerAgent::ExecuteUnlockScript,
+                                  weak_factory_.GetWeakPtr(), document_, true));
+  for (base::TimeDelta delay :
+       {base::Milliseconds(500), base::Milliseconds(1500), base::Seconds(4),
+        base::Seconds(10)}) {
+    runner->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&CookieBannerAgent::ExecuteUnlockScript,
+                       weak_factory_.GetWeakPtr(), document_, false),
+        delay);
+  }
+}
+
+void CookieBannerAgent::ExecuteUnlockScript(int document, bool again) {
+  if (document != document_ || !rules_.unlock) {
+    return;  // Another document by now, or the rules taken away.
+  }
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (unlock_script_ran_) {
+    if (!again) {
+      return;  // It watches the page itself.
+    }
+  } else if (frame->GetDocument()
+                 .QuerySelector(blink::WebString::FromUtf8(kPopupBoxes))
+                 .IsNull()) {
+    return;
+  }
+  unlock_script_ran_ = true;
+  frame->ExecuteScriptInIsolatedWorld(
+      ISOLATED_WORLD_ID_CHROME_INTERNAL,
+      blink::WebScriptSource(blink::WebString::FromUtf8(
+          std::string(kUnlockScript) + "('" + kPopupBoxes + "')")),
+      blink::BackForwardCacheAware::kAllow);
+}
+
+void CookieBannerAgent::DidCreateDocumentElement() {
+  Update();
+}
+
+void CookieBannerAgent::Update() {
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  blink::WebDocument document = frame->GetDocument();
+  if (document.IsNull() || document.DocumentElement().IsNull() ||
+      rules_ == inserted_) {
+    return;
+  }
+  const blink::WebString generic_key = blink::WebString::FromUtf8(kGenericKey);
+  const blink::WebString site_key = blink::WebString::FromUtf8(kSiteKey);
+  const blink::WebString unlock_key = blink::WebString::FromUtf8(kUnlockKey);
+  if (rules_.generic_id != inserted_.generic_id) {
+    if (inserted_.generic_id) {
+      document.RemoveInsertedStyleSheet(generic_key,
+                                        blink::WebCssOrigin::kUser);
+    }
+    // Not in a document that isn't HTML (nothing to hide there).
+    if (rules_.generic_id) {
+      document.InsertSharedStyleSheet(rules_.generic_id, generic_key,
+                                      blink::WebCssOrigin::kUser);
+    }
+    inserted_.generic_id = rules_.generic_id;
+  }
+  if (rules_.site != inserted_.site) {
+    if (!inserted_.site.empty()) {
+      document.RemoveInsertedStyleSheet(site_key, blink::WebCssOrigin::kUser);
+    }
+    if (!rules_.site.empty()) {
+      document.InsertStyleSheet(blink::WebString::FromUtf8(rules_.site),
+                                &site_key, blink::WebCssOrigin::kUser);
+    }
+    inserted_.site = rules_.site;
+  }
+  if (rules_.unlock != inserted_.unlock) {
+    if (rules_.unlock) {
+      document.InsertStyleSheet(blink::WebString::FromUtf8(kUnlockCss),
+                                &unlock_key, blink::WebCssOrigin::kUser);
+      RunUnlockScript();
+    } else {
+      document.RemoveInsertedStyleSheet(unlock_key, blink::WebCssOrigin::kUser);
+    }
+    inserted_.unlock = rules_.unlock;
+  }
+}
+
+void CookieBannerAgent::OnDestruct() {
+  delete this;
+}
+
+}  // namespace meridian
