+namespace {
+
+// The sheet WebDocument::SetSharedStyleSheet() parsed: its contents (and the
+// RuleSet built from them) are used by every document inserting it.
+uint64_t g_shared_style_sheet_id = 0;
+
+Persistent<StyleSheetContents>& SharedStyleSheet() {
+  DEFINE_STATIC_LOCAL(Persistent<StyleSheetContents>, contents, ());
+  return contents;
+}
+
+}  // namespace
+
+// static
+bool WebDocument::HasSharedStyleSheet(uint64_t shared_id) {
+  DCHECK(IsMainThread());
+  return shared_id && shared_id == g_shared_style_sheet_id &&
+         SharedStyleSheet();
+}
+
+// static
+void WebDocument::SetSharedStyleSheet(uint64_t shared_id,
+                                      const WebString& source_code) {
+  DCHECK(IsMainThread());
+  // No document: HTML documents' selector rules (tag names in lower case),
+  // nothing loaded from it, no use counters.
+  auto* context = MakeGarbageCollected<CSSParserContext>(
+      KURL(), /*origin_clean=*/true, TextEncoding(), kHTMLStandardMode,
+      Referrer(), /*is_html_document=*/true,
+      SecureContextMode::kInsecureContext, /*world=*/nullptr,
+      /*use_counter_document=*/nullptr, ResourceFetchRestriction::kNone);
+  auto* contents = MakeGarbageCollected<StyleSheetContents>(context);
+  contents->ParseString(source_code);
+  g_shared_style_sheet_id = shared_id;
+  SharedStyleSheet() = contents;
+}
+
+WebStyleSheetKey WebDocument::InsertSharedStyleSheet(
+    uint64_t shared_id,
+    const WebStyleSheetKey& key,
+    WebCssOrigin origin) {
+  Document* document = Unwrap<Document>();
+  DCHECK(document);
+  DCHECK(!key.IsEmpty());
+  if (!HasSharedStyleSheet(shared_id) || !document->IsHTMLDocument()) {
+    return WebStyleSheetKey();
+  }
+  document->GetStyleEngine().InjectSheet(key, SharedStyleSheet().Get(), origin);
+  return key;
+}
+
 void WebDocument::RemoveInsertedStyleSheet(const WebStyleSheetKey& key,
                                            WebCssOrigin origin) {
   Unwrap<Document>()->GetStyleEngine().RemoveInjectedSheet(key, origin);
