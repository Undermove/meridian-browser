+// Most sites share the rules for every site as they are (renderers parse them
+// once); a site with exceptions to them gets its own copy.
+TEST(CookieListTest, SharedGenericRules) {
+  auto list = CookieList::Parse(kList);
+  ASSERT_TRUE(list);
+  CookieList::Rules any = list->RulesFor("www.any.net");
+  EXPECT_TRUE(any.generic);
+  EXPECT_EQ(any.css, "");
+  EXPECT_EQ(list->generic_css(), list->CssFor("www.any.net"));
+  CookieList::Rules sport = list->RulesFor("sport.news.com");
+  EXPECT_FALSE(sport.generic);  // news.com#@#.dup-free
+  EXPECT_NE(sport.css.find(".cookie-notice{"), std::string::npos);
+  EXPECT_EQ(sport.css.find(".dup-free"), std::string::npos);
+  CookieList::Rules shop = list->RulesFor("shop.de");
+  EXPECT_TRUE(shop.generic);
+  EXPECT_EQ(shop.css, ".shop-cookies{display:none!important}\n");
+  CookieList::Rules own = list->RulesFor("own.com");  // $generichide
+  EXPECT_FALSE(own.generic);
+  EXPECT_EQ(own.css, ".own-banner{display:none!important}\n");
+  EXPECT_FALSE(list->RulesFor("quiet.com").generic);
+}
+
+// :has() only on the sites it was written for, never on every page.
+TEST(CookieListTest, NoGenericHas) {
+  auto list = CookieList::Parse(kList);
+  ASSERT_TRUE(list);
+  EXPECT_EQ(list->generic_css().find(":has("), std::string::npos);
+  EXPECT_NE(list->CssFor("paper.com").find(".paywall:has(.consent){"),
+            std::string::npos);
+}
