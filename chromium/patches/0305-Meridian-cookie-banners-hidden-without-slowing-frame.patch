+void CookieBanners::SetList(std::unique_ptr<CookieList> list) {
+  list_ = std::move(list);
+  generic_ = base::ReadOnlySharedMemoryRegion();
+  const std::string& css = list_->generic_css();
+  if (css.empty()) {
+    return;
+  }
