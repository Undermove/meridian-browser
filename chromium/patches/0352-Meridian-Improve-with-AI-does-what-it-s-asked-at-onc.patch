+TEST(BoostImproveTest, AskedToHideItsCssHidesBecomeZaps) {
+  std::vector<std::string> hidden;
+  CssCheck c = CheckCss(
+      "ytd-rich-shelf-renderer[is-shorts] { display: none !important }\n"
+      ".badge { visibility: hidden; }\n"
+      "#title { font-size: 20px; display: none }\n"
+      "@media (max-width: 500px) { .x { display: none } }\n"
+      "body { background: url(https://tracker.example/p.png) }\n"
+      "h1 { animation: spin 1s infinite }\n"
+      "a { color: red }",
+      &hidden);
+  EXPECT_EQ(hidden, (std::vector<std::string>{
+                        "ytd-rich-shelf-renderer[is-shorts]", ".badge",
+                        "#title"}));
+  ASSERT_TRUE(c.ok);
+  EXPECT_TRUE(Has(c.css, "font-size: 20px !important"));
+  EXPECT_TRUE(Has(c.css, "color: red !important"));
+  EXPECT_FALSE(Has(c.css, "display: none"));
+  EXPECT_FALSE(Has(c.css, "visibility"));
+  // Still never from the internet, never animated; inside @media a hide
+  // is taken out as before.
+  EXPECT_FALSE(Has(c.css, "tracker.example"));
+  EXPECT_FALSE(Has(c.css, "animation"));
+  EXPECT_TRUE(AnyProblem(c, "loads from the internet"));
+  EXPECT_TRUE(AnyProblem(c, "no animations"));
+  EXPECT_TRUE(AnyProblem(c, ".x: display: none hides content"));
+  // Without `hidden`, as a redesign checks it: taken out.
+  CssCheck r = CheckCss(".badge { visibility: hidden; color: red }");
+  EXPECT_TRUE(AnyProblem(r, "hides content"));
+  EXPECT_FALSE(Has(r.css, "visibility"));
+}
