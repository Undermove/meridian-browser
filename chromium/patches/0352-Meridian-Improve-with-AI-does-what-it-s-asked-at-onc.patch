+void BoostTabHelper::Peek(const std::string& selector, bool hidden) {
+  if (selector.empty() || selector.size() > 300 ||
+      selector.find_first_of("{};<@\\") != std::string::npos) {
+    return;
+  }
+  // As Zap's Undo shows what it brings back, a little longer.
+  static constexpr char kPeek[] = R"JS(((sel, hidden) => {
+  let el;
+  try { el = document.querySelector(sel); } catch { return false; }
+  let st = document.getElementById('meridian-boost-peek');
+  if (!st) {
+    st = document.createElement('style');
+    st.id = 'meridian-boost-peek';
+    (document.head || document.documentElement).appendChild(st);
+  }
+  st.textContent = 'html ' + sel + ' { ' + (hidden ? 'display: revert !important; visibility: visible !important; ' : '') +
+      'outline: 3px solid #8b5cf6 !important; outline-offset: -3px !important; background-color: rgba(139, 92, 246, .14) !important; }';
+  if (el) el.scrollIntoView({ block: 'center', behavior: 'smooth' });
+  clearTimeout(window.meridianPeekTimer);
+  window.meridianPeekTimer = setTimeout(() => st.remove(), 2200);
+  return !!el;
+}))JS";
+  content::RenderFrameHost* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame->IsRenderFrameLive()) {
+    return;
+  }
+  RunInFrame(frame,
+             std::string("(") + kPeek + ")(" +
+                 base::WriteJson(base::Value(selector)).value_or("\"\"") +
+                 ", " + (hidden ? "true" : "false") + ")",
+             base::DoNothing());
+}
