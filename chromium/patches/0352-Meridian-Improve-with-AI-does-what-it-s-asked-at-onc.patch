+void BoostImprover::OnQuickAnswer(std::string text) {
+  std::optional<boost_ai::Answer> answer = boost_ai::ParseAnswer(text);
+  if (!answer) {
+    Finish(L("The AI didn’t answer with a boost. Try again.",
+             "ИИ не ответил бустом. Попробуйте ещё раз."));
+    return;
+  }
+  // What it hides: the "hide" list, and the rules of its CSS that hide
+  // something (asked for, so they're zaps rather than taken out).
+  std::vector<std::string> hidden;
+  boost_ai::CssCheck check = answer->css.empty()
+                                 ? boost_ai::CssCheck()
+                                 : boost_ai::CheckCss(answer->css, &hidden);
+  std::vector<std::string> hide = answer->hide;
+  std::vector<std::string> labels = answer->hide_labels;
+  labels.resize(hide.size());
+  base::ListValue from_css;
+  for (const std::string& sel : hidden) {
+    from_css.Append(sel);
+  }
+  for (const std::string& sel : boost_ai::CheckHide(&from_css)) {
+    if (!std::ranges::contains(hide, sel)) {
+      hide.push_back(sel);
+      labels.push_back(std::string());
+    }
+  }
+  content::RenderFrameHost* frame = contents_->GetPrimaryMainFrame();
+  if (hide.empty() || !frame->IsRenderFrameLive()) {
+    OnQuickHideChecked(std::move(*answer), std::move(check), std::move(hide),
+                       std::move(labels), base::Value(base::ListValue()));
+    return;
+  }
+  std::vector<std::string> named;
+  base::ListValue sels;
+  for (size_t i = 0; i < hide.size(); ++i) {
+    named.push_back(labels[i].empty() ? SelectorLabel(hide[i]) : labels[i]);
+    sels.Append(hide[i]);
+  }
+  SetProgress(L("Found: ", "Нашёл: ") + Join(named, ", "),
+              L("hiding " + Elements(hide.size(), false) + "…",
+                "скрываю " + Elements(hide.size(), true) + "…"));
+  RunInFrame(frame,
+             std::string("(") + kSafeHide + ")(" +
+                 base::WriteJson(sels).value_or("[]") + ", true)",
+             base::BindOnce(&BoostImprover::OnQuickHideChecked,
+                            run_weak_factory_.GetWeakPtr(), std::move(*answer),
+                            std::move(check), std::move(hide),
+                            std::move(labels)));
+}
+
+void BoostImprover::OnQuickHideChecked(boost_ai::Answer answer,
+                                       boost_ai::CssCheck check,
+                                       std::vector<std::string> hide,
+                                       std::vector<std::string> labels,
+                                       base::Value safe) {
+  BoostService* s = service();
+  if (!s) {
+    Finish(L("The AI isn’t available here.", "ИИ здесь недоступен."));
+    return;
+  }
+  const Boost* existing = Target();
+  Boost boost = existing ? *existing : Boost();
+  boost.host = host_;
+  boost.enabled = true;
+  const bool restyled = check.ok && check.css != css_before_;
+  if (check.ok) {
+    boost.css = check.css;
+  }
+  std::vector<std::string> hid, left;
+  for (size_t i = 0; i < hide.size(); ++i) {
+    const std::string label =
+        labels[i].empty() ? SelectorLabel(hide[i]) : labels[i];
+    const bool ok = safe.is_list() &&
+                    std::ranges::contains(safe.GetList(), base::Value(hide[i]));
+    if (!ok) {
+      left.push_back(label);
+      continue;
+    }
+    if (!std::ranges::contains(boost.zaps, hide[i])) {
+      boost.zaps.push_back(hide[i]);
+    }
+    hid.push_back(label);
+    changes_.Append(base::DictValue()
+                        .Set("kind", "hide")
+                        .Set("label", label)
+                        .Set("selector", hide[i]));
+  }
+  const std::string not_hidden =
+      left.empty() ? std::string()
+                   : L("didn’t hide " + Join(left, ", ") +
+                           " (the page’s content or controls)",
+                       "не стал скрывать: " + Join(left, ", ") +
+                           " (это содержимое или управление страницы)");
+  if (hid.empty() && !restyled) {
+    Finish(!not_hidden.empty()
+               ? L("Nothing changed: ", "Ничего не изменил: ") + not_hidden
+           : !answer.summary.empty()
+               ? answer.summary
+               : L("The AI changed nothing. Try saying it differently.",
+                   "ИИ ничего не изменил. Попробуйте сказать иначе."));
+    return;
+  }
+  if (restyled) {
+    const std::string what = Join(answer.changes, ", ");
+    changes_.Append(
+        base::DictValue()
+            .Set("kind", "style")
+            .Set("label", !what.empty() ? what
+                          : !answer.summary.empty()
+                              ? answer.summary
+                              : L("the site’s styles", "стили сайта"))
+            .Set("selector", ""));
+  }
+  if (boost.name.empty() || boost.name == host_ || boost.name == "My Boost") {
+    boost.name = !answer.name.empty() ? answer.name : host_;
+  }
+  boost_id_ = s->Set(std::move(boost));
+  applied_ = true;
+  ++applied_count_;
+  std::vector<std::string> parts;
+  if (!hid.empty()) {
+    parts.push_back(L("Hid: ", "Скрыл: ") + Join(hid, ", "));
+  }
+  if (restyled) {
+    const std::string what = Join(answer.changes, ", ");
+    parts.push_back(what.empty() ? answer.summary
+                                 : L("Changed: ", "Изменил: ") + what);
+  }
+  parts.push_back(not_hidden);
+  summary_ = Join(parts, " · ");
+  Finish(std::string());
+}
