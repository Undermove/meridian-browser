+  // A space menu (the Little window's or a Peek's): any click outside it
+  // closes it.
+  private closeOnClickOutside_(ids: string[], close: () => void) {
+    window.addEventListener('pointerdown', (ev: Event) => {
+      if (!ev.composedPath().some(
+              el => el instanceof HTMLElement && ids.includes(el.id))) {
+        close();
+      }
+    }, {once: true, capture: true});
+  }
+
+  // Focuses the menu's first (or checked) space once it's drawn.
+  private async focusSpaceMenu_(id: string) {
+    await this.updateComplete;
+    const menu = this.shadowRoot.getElementById(id);
+    (menu?.querySelector<HTMLElement>('[aria-current="true"]') ||
+     menu?.querySelector<HTMLElement>('.little-space'))?.focus();
+  }
+
   protected onLittleSpaceClick_(e: Event) {
