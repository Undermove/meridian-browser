diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index e129d3af33..6f1ca45342 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -3275,10 +3275,53 @@ void SidebarHandler::ActivateSpaceHere(const std::string& space_id) {
 
 void SidebarHandler::MoveTabToSpace(const tabs_api::NodeId& tab_id,
                                     const std::string& space_id) {
+  MoveTabToSpaceImpl(TabFor(tab_id), space_id);
+}
+
+void SidebarHandler::MoveTabToSpaceAndShow(const tabs_api::NodeId& tab_id,
+                                           const std::string& space_id) {
   tabs::TabInterface* tab = TabFor(tab_id);
   if (!tab || !service_->FindSpace(space_id)) {
     return;
   }
+  TabData::SetPeek(tab->GetContents(), false);
+  content::WebContents* moved = MoveTabToSpaceImpl(tab, space_id);
+  ActivateSpaceHere(space_id);
+  if (tabs::TabInterface* shown =
+          moved ? tabs::TabInterface::MaybeGetFromContents(moved) : nullptr;
+      shown && model()->GetIndexOfTab(shown) != TabStripModel::kNoTab) {
+    model()->ActivateTab(shown);
+  }
+  ScheduleNotify();
+}
+
+void SidebarHandler::OpenUrlInSpace(const std::string& space_id,
+                                    const GURL& url,
+                                    bool show) {
+  const Space* space = service_->FindSpace(space_id);
+  if (!space || !url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  content::WebContents* opened =
+      OpenInSpace(browser_, space_id, url, /*active=*/false);
+  if (show) {
+    ActivateSpaceHere(space_id);
+    if (tabs::TabInterface* tab =
+            tabs::TabInterface::MaybeGetFromContents(opened)) {
+      model()->ActivateTab(tab);
+    }
+  } else if (page_.is_connected()) {
+    page_->ShowToast("Opened in " + space->name);
+  }
+  ScheduleNotify();
+}
+
+content::WebContents* SidebarHandler::MoveTabToSpaceImpl(
+    tabs::TabInterface* tab,
+    const std::string& space_id) {
+  if (!tab || !service_->FindSpace(space_id)) {
+    return nullptr;
+  }
   const TabData* data = TabData::Get(tab->GetContents());
   std::string item_id = data ? data->item_id() : std::string();
   // A tab leaving the space of its pinned item is no longer that item's tab.
@@ -3292,13 +3335,15 @@ void SidebarHandler::MoveTabToSpace(const tabs_api::NodeId& tab_id,
       HoldsSpaceTabs(browser_)) {
     // A page can't change profiles: it reopens there (signed out, maybe).
     content::WebContents* old = tab->GetContents();
-    OpenInSpace(browser_, space_id, old->GetLastCommittedURL(),
-                tab->IsActivated(), item_id);
+    content::WebContents* reopened =
+        OpenInSpace(browser_, space_id, old->GetLastCommittedURL(),
+                    tab->IsActivated(), item_id);
     old->ClosePage();
-    return;
+    return reopened;
   }
   TabData::Set(tab->GetContents(), space_id, item_id);
   ScheduleNotify();
+  return tab->GetContents();
 }
 
