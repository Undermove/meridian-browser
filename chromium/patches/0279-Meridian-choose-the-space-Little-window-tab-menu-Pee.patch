+  protected onLittleSpaceKeydown_(e: KeyboardEvent) {
+    if (e.key === 'ArrowDown' && !this.littleMenu_) {
+      e.preventDefault();
+      this.onLittleSpaceClick_(e);
     }
   }
 
+  // Arrows move between the spaces, Escape (or Tab) closes the menu.
+  protected onSpaceMenuKeydown_(e: KeyboardEvent) {
+    const menu = e.currentTarget as HTMLElement;
+    const items = [...menu.querySelectorAll<HTMLElement>('.little-space')];
+    const at = items.indexOf(this.shadowRoot.activeElement as HTMLElement);
+    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+      e.preventDefault();
+      const step = e.key === 'ArrowDown' ? 1 : -1;
+      items[(at + step + items.length) % items.length]?.focus();
+    } else if (e.key === 'Home' || e.key === 'End') {
+      e.preventDefault();
+      items[e.key === 'Home' ? 0 : items.length - 1]?.focus();
+    } else if (e.key === 'Escape' || e.key === 'Tab') {
+      if (e.key === 'Escape') {
+        e.preventDefault();
+      }
+      const little = menu.id === 'littleSpaces';
+      this.littleMenu_ = false;
+      this.peekMenu_ = null;
+      if (little) {
+        this.shadowRoot.getElementById('littleSpace')?.focus();
+      } else {
+        this.$.contentRegion.focusPeekMore();
+      }
+    }
+  }
