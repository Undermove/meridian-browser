+// A Claude Code session to pick up: its id (the file's name), when it was
+// last written, and its first thing the person asked (a title, or "").
+struct ClaudeSessionFile {
+  std::string id;
+  base::Time modified;
+  std::string title;
+};
+
+// Blocking. Claude Code's sessions of project `root` kept in one account's
+// config folder (`config`/projects/<root, non-alphanumerics as ->/*.jsonl),
+// the newest first, at most `limit`. Sessions are per config folder, so a
+// space that switched accounts finds its earlier ones under the other one.
+std::vector<ClaudeSessionFile> ClaudeSessionsIn(const base::FilePath& config,
+                                                const base::FilePath& root,
+                                                size_t limit);
+
 }  // namespace meridian::workbench
 
 #endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_AGENT_INSIGHTS_H_
