 // ---------------------------------------------------------------- readers
 
+// Sessions are per config folder: each account's own list for a project,
+// newest first, with the first thing asked as a title.
+TEST(AgentInsightsTest, ClaudeSessionsPerAccountFolder) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath root = temp.GetPath().AppendASCII("work.shop");
+  base::CreateDirectory(root);
+  std::string slug = base::MakeAbsoluteFilePath(root).AsUTF8Unsafe();
+  for (char& c : slug) {
+    if (!base::IsAsciiAlphaNumeric(c)) {
+      c = '-';
+    }
+  }
+  const base::FilePath personal = temp.GetPath().AppendASCII(".claude-personal");
+  const base::FilePath dir = personal.AppendASCII("projects").AppendASCII(slug);
+  ASSERT_TRUE(base::CreateDirectory(dir));
+  ASSERT_TRUE(base::WriteFile(
+      dir.AppendASCII("aaa-1.jsonl"),
+      R"({"type":"summary"})" "\n"
+      R"({"type":"user","isMeta":true,"message":{"content":"<command>"}})" "\n"
+      R"({"type":"user","message":{"role":"user","content":"Fix the checkout"}})" "\n"));
+  ASSERT_TRUE(base::WriteFile(
+      dir.AppendASCII("bbb-2.jsonl"),
+      R"({"type":"user","message":{"content":[{"type":"text","text":"Add tests"}]}})" "\n"));
+  ASSERT_TRUE(base::WriteFile(dir.AppendASCII("not a session.txt"), ""));
+  const base::Time now = base::Time::Now();
+  base::TouchFile(dir.AppendASCII("aaa-1.jsonl"), now - base::Hours(2),
+                  now - base::Hours(2));
+  base::TouchFile(dir.AppendASCII("bbb-2.jsonl"), now, now);
+  std::vector<ClaudeSessionFile> list = ClaudeSessionsIn(personal, root, 10);
+  ASSERT_EQ(list.size(), 2u);
+  EXPECT_EQ(list[0].id, "bbb-2");
+  EXPECT_EQ(list[0].title, "Add tests");
+  EXPECT_EQ(list[1].id, "aaa-1");
+  EXPECT_EQ(list[1].title, "Fix the checkout");
+  EXPECT_EQ(ClaudeSessionsIn(personal, root, 1).size(), 1u);
+  // Another account's folder: none of these.
+  EXPECT_TRUE(
+      ClaudeSessionsIn(temp.GetPath().AppendASCII(".claude"), root, 10).empty());
+}
+
