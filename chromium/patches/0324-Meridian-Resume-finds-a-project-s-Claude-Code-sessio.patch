+std::vector<ClaudeSessionFile> ClaudeSessionsIn(const base::FilePath& config,
+                                                const base::FilePath& root,
+                                                size_t limit) {
+  std::vector<base::FilePath> dirs;
+  for (const base::FilePath& r : {root, base::MakeAbsoluteFilePath(root)}) {
+    if (r.empty()) {
+      continue;
+    }
+    // Claude Code's own name for the project's folder (as Qwen's).
+    base::FilePath dir =
+        config.AppendASCII("projects").AppendASCII(QwenProjectName(r));
+    if (std::ranges::find(dirs, dir) == dirs.end()) {
+      dirs.push_back(dir);
+    }
+  }
+  std::vector<ClaudeSessionFile> out;
+  for (const base::FilePath& dir : dirs) {
+    base::FileEnumerator e(dir, false, base::FileEnumerator::FILES,
+                           FILE_PATH_LITERAL("*.jsonl"));
+    for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+      std::string id = p.BaseName().RemoveFinalExtension().AsUTF8Unsafe();
+      if (id.empty() || id.size() > 80 ||
+          !std::ranges::all_of(id, [](char c) {
+            return base::IsAsciiAlphaNumeric(c) || c == '-' || c == '_';
+          })) {
+        continue;
+      }
+      out.push_back({std::move(id), e.GetInfo().GetLastModifiedTime(), ""});
+    }
+  }
+  std::ranges::sort(out, [](const ClaudeSessionFile& a,
+                            const ClaudeSessionFile& b) {
+    return a.modified > b.modified;
+  });
+  if (out.size() > limit) {
+    out.resize(limit);
+  }
+  // A title: the first thing the person typed (from the file's start only).
+  for (ClaudeSessionFile& s : out) {
+    for (const base::FilePath& dir : dirs) {
+      base::File file(dir.AppendASCII(s.id + ".jsonl"),
+                      base::File::FLAG_OPEN | base::File::FLAG_READ);
+      if (!file.IsValid()) {
+        continue;
+      }
+      std::string head(64 * 1024, '\0');
+      std::optional<size_t> n =
+          file.Read(0, base::as_writable_byte_span(head));
+      head.resize(n.value_or(0));
+      for (std::string_view line : base::SplitStringPiece(
+               head, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+        std::optional<base::Value> v = base::JSONReader::Read(line, base::JSON_PARSE_RFC);
+        const base::DictValue* d = v && v->is_dict() ? &v->GetDict() : nullptr;
+        const std::string* type = d ? d->FindString("type") : nullptr;
+        if (!type || *type != "user" || d->FindBool("isMeta").value_or(false)) {
+          continue;
+        }
+        const base::DictValue* message = d->FindDict("message");
+        const std::string* text =
+            message ? message->FindString("content") : nullptr;
+        std::string found = text ? *text : std::string();
+        if (!text && message) {
+          if (const base::ListValue* parts = message->FindList("content")) {
+            for (const base::Value& part : *parts) {
+              const std::string* t =
+                  part.is_dict() ? part.GetDict().FindString("text") : nullptr;
+              if (t) {
+                found = *t;
+                break;
+              }
+            }
+          }
+        }
+        found = std::string(base::TrimWhitespaceASCII(found, base::TRIM_ALL));
+        // Claude Code's own wrappers (<command-name>…) aren't a question.
+        if (found.empty() || found.starts_with("<")) {
+          continue;
+        }
+        if (found.size() > 120) {
+          found.resize(117);
+          found += "…";
+        }
+        s.title = std::move(found);
+        break;
+      }
+      break;
+    }
+  }
+  return out;
+}
+
 }  // namespace meridian::workbench
