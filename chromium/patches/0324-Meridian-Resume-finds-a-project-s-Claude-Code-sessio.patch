diff --git a/chrome/browser/meridian/workbench/workbench_handler.cc b/chrome/browser/meridian/workbench/workbench_handler.cc
index 0a185745c5..be34c5b0e6 100644
--- a/chrome/browser/meridian/workbench/workbench_handler.cc
+++ b/chrome/browser/meridian/workbench/workbench_handler.cc
@@ -883,6 +883,75 @@ void WorkbenchHandler::Dispatch(const std::string& method,
   }
   // The project's Claude Code sessions to reopen after a restart. Written
   // to disk right away: the browser may quit (an update) a moment later.
+  if (method == "claudeAccountSessions") {
+    // Claude Code's sessions of this project in every one of the person's
+    // Claude accounts (sessions are per config folder): {current: account
+    // id the space runs as, accounts: [{id, label, current, sessions: [{id,
+    // modified (ms), title}]}]}. Only names and titles: never a folder.
+    if (!project_) {
+      return std::move(reply).Run(base::Value(base::DictValue()));
+    }
+    std::optional<ai::SpaceAccount> chosen =
+        ai::SpaceAccountFor(profile_, SpaceForTerminals(), "claude");
+    ai::ListAccountsAsync(
+        profile_,
+        base::BindOnce(
+            [](base::WeakPtr<WorkbenchHandler> self, base::FilePath root,
+               std::optional<ai::SpaceAccount> chosen, Reply reply,
+               std::vector<ai::Account> list) {
+              if (!self) {
+                return;
+              }
+              std::vector<ai::Account> claude;
+              std::string current;
+              for (ai::Account& a : list) {
+                if (a.vendor != "claude") {
+                  continue;
+                }
+                if (chosen ? a.id == chosen->id : a.is_default) {
+                  current = a.id;
+                }
+                self->session_accounts_[a.id] = {a.dir, a.label};
+                claude.push_back(std::move(a));
+              }
+              base::ThreadPool::PostTaskAndReplyWithResult(
+                  FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+                  base::BindOnce(
+                      [](std::vector<ai::Account> claude, base::FilePath root,
+                         std::string current) {
+                        base::ListValue accounts;
+                        for (const ai::Account& a : claude) {
+                          base::ListValue sessions;
+                          for (const ClaudeSessionFile& f :
+                               ClaudeSessionsIn(a.dir, root, 30)) {
+                            sessions.Append(
+                                base::DictValue()
+                                    .Set("id", f.id)
+                                    .Set("modified",
+                                         f.modified.InMillisecondsFSinceUnixEpoch())
+                                    .Set("title", f.title));
+                          }
+                          accounts.Append(base::DictValue()
+                                              .Set("id", a.id)
+                                              .Set("label", a.label)
+                                              .Set("current", a.id == current)
+                                              .Set("sessions", std::move(sessions)));
+                        }
+                        return base::Value(base::DictValue()
+                                               .Set("current", current)
+                                               .Set("accounts", std::move(accounts)));
+                      },
+                      std::move(claude), root, current),
+                  base::BindOnce(
+                      [](Reply reply, base::Value v) {
+                        std::move(reply).Run(std::move(v));
+                      },
+                      std::move(reply)));
+            },
+            weak_factory_.GetWeakPtr(), project_->root(), std::move(chosen),
+            std::move(reply)));
+    return;
+  }
   if (method == "claudeSessions" || method == "saveClaudeSessions") {
     if (!project_) {
       return std::move(reply).Run(base::Value(base::ListValue()));
@@ -925,6 +994,12 @@ void WorkbenchHandler::Dispatch(const std::string& method,
         if (v.GetDict().FindBool("remote").value_or(false)) {
           entry.Set("remote", true);
         }
+        // Resumed under another account than the space's: that one again.
+        if (const std::string* account = v.GetDict().FindString("account");
+            account && account->size() == 8 &&
+            std::ranges::all_of(*account, base::IsHexDigit<char>)) {
+          entry.Set("account", *account);
+        }
         list.Append(std::move(entry));
       }
     }
@@ -2448,6 +2523,13 @@ void WorkbenchHandler::OnProject(
       std::move(reply));
 }
 
+std::string WorkbenchHandler::SpaceForTerminals() {
+  const TabData* data = TabData::Get(web_ui()->GetWebContents());
+  return data && !data->space_id().empty()
+             ? data->space_id()
+             : SidebarServiceFactory::GetForProfile(profile_)->active_space_id();
+}
+
 void WorkbenchHandler::CreateTerminal(base::DictValue opts, Reply reply) {
   ContinueTerminal(std::move(opts), TerminalSteps(), std::move(reply));
 }
@@ -2642,12 +2724,22 @@ void WorkbenchHandler::ContinueTerminal(base::DictValue opts,
   std::string account;
   std::map<std::string, std::string> account_env;
   if (kind == "shell" || ai::AccountVendorForKind(kind)) {
-    const TabData* data = TabData::Get(web_ui()->GetWebContents());
-    std::string space = data && !data->space_id().empty()
-                            ? data->space_id()
-                            : SidebarServiceFactory::GetForProfile(profile_)
-                                  ->active_space_id();
-    account_env = ai::AccountEnvForKind(profile_, space, kind, &account);
+    account_env =
+        ai::AccountEnvForKind(profile_, SpaceForTerminals(), kind, &account);
+  }
+  // A session picked from another account's list (Resume): it goes on
+  // under that account, where its history is, not the space's.
+  if (const std::string* id = opts.FindString("accountId");
+      id && kind == "claude" && !resume_id.empty()) {
+    if (auto it = session_accounts_.find(*id); it != session_accounts_.end()) {
+      account_env = ai::AccountEnv(*ai::FindAccountVendor("claude"),
+                                   ai::AccountsHome(), it->second.first);
+      // An empty change list: the variable taken away (its own folder).
+      if (account_env.empty()) {
+        account_env["CLAUDE_CONFIG_DIR"] = std::string();
+      }
+      account = it->second.second;
+    }
   }
   files_->PostTaskAndReplyWithResult(
       FROM_HERE,
