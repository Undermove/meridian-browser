diff --git a/chrome/browser/meridian/ai/local_agents.cc b/chrome/browser/meridian/ai/local_agents.cc
index 5a7d2d8bd3..6e461b2643 100644
--- a/chrome/browser/meridian/ai/local_agents.cc
+++ b/chrome/browser/meridian/ai/local_agents.cc
@@ -304,7 +304,7 @@ std::unique_ptr<network::SimpleURLLoader> Request(
   // headers).
   if (p.id == "openrouter") {
     request->headers.SetHeader("HTTP-Referer",
-                               "https://undermove.github.io/meridian-browser/");
+                               "https://meridianbrowser.app/");
     request->headers.SetHeader("X-Title", "Meridian");
   }
   auto loader =
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index 5beda24d6d..0806af20f9 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -2380,7 +2380,7 @@ void SidebarHandler::MaybeShowWhatsNew() {
   prefs->SetString(prefs::kLastVersion, update::kVersion);
   const bool updated = last.empty() ? prefs->GetBoolean(prefs::kOnboarded)
                                     : update::IsNewer(update::kVersion, last);
-  std::string page = "https://undermove.github.io/meridian-browser/changelog.html";
+  std::string page = "https://meridianbrowser.app/changelog.html";
   if (TestSwitchesAllowed()) {
     // Tests: only one that asks for it.
     page = TestSwitchValue("meridian-test-changelog-url");
