+#include "base/no_destructor.h"
 #include "base/strings/utf_string_conversions.h"
 #include "base/task/thread_pool.h"
 #include "build/chromeos_buildflags.h"
@@ -235,11 +236,31 @@ class HandleDropScanData : public content::WebContentsObserver {
 #endif  // BUILDFLAG(ENTERPRISE_CLOUD_CONTENT_ANALYSIS) &&
         // BUILDFLAG(SAFE_BROWSING_AVAILABLE)
 
+DroppedFiles::DroppedFiles() = default;
+DroppedFiles::DroppedFiles(const DroppedFiles&) = default;
+DroppedFiles::~DroppedFiles() = default;
+
+namespace {
+DroppedFiles& LastDrop() {
+  static base::NoDestructor<DroppedFiles> last;
+  return *last;
+}
+}  // namespace
+
+const DroppedFiles& LastDroppedFiles() {
+  return LastDrop();
+}
+
 void HandleOnPerformingDrop(
     content::WebContents* web_contents,
     content::DropData drop_data,
     content::WebContentsViewDelegate::DropCompletionCallback callback) {
   CHECK(callback);
+  LastDrop().paths.clear();
+  for (const ui::FileInfo& file : drop_data.filenames) {
+    LastDrop().paths.push_back(file.path);
+  }
+  LastDrop().when = base::TimeTicks::Now();
 
   content::WebContents* scan_target =
       glic::GetGlicGuestWebContents(web_contents);
