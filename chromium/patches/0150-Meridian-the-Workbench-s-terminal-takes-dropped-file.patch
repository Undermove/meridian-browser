@@ -457,6 +463,84 @@ void WorkbenchHandler::Dispatch(const std::string& method,
                          a),
                      std::move(reply));
   }
+  if (method == "droppedPaths") {
+    // The paths of the files just dropped on the page, which it names (and
+    // sizes): what a terminal types for them. None unless all of them match.
+    std::vector<std::pair<std::string, int64_t>> files;
+    if (!params.empty() && params[0].is_list()) {
+      for (const base::Value& f : params[0].GetList()) {
+        const std::string* name = f.is_dict() ? f.GetDict().FindString("name")
+                                              : nullptr;
+        std::optional<double> size =
+            f.is_dict() ? f.GetDict().FindDouble("size") : std::nullopt;
+        if (name && size) {
+          files.emplace_back(*name, static_cast<int64_t>(*size));
+        }
+      }
+    }
+    const DroppedFiles& last = LastDroppedFiles();
+    if (files.empty() ||
+        base::TimeTicks::Now() - last.when > base::Seconds(10)) {
+      return std::move(reply).Run(base::Value(base::ListValue()));
+    }
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](std::vector<std::pair<std::string, int64_t>> files,
+               std::vector<base::FilePath> paths) -> Result {
+              base::ListValue out;
+              std::vector<bool> used(paths.size());
+              for (const auto& [name, size] : files) {
+                bool found = false;
+                for (size_t i = 0; i < paths.size() && !found; ++i) {
+                  std::optional<int64_t> real = base::GetFileSize(paths[i]);
+                  bool dir = base::DirectoryExists(paths[i]);
+                  if (!used[i] && paths[i].BaseName().AsUTF8Unsafe() == name &&
+                      (dir || real == size)) {
+                    used[i] = found = true;
+                    out.Append(paths[i].AsUTF8Unsafe());
+                  }
+                }
+                if (!found) {
+                  return base::Value(base::ListValue());
+                }
+              }
+              return base::Value(std::move(out));
+            },
+            std::move(files), last.paths),
+        std::move(reply));
+    return;
+  }
+  if (method == "saveDrop") {
+    // A dropped or pasted file that has no path (an image from a page, a
+    // screenshot on the clipboard): saved where the terminal's program can
+    // read it.
+    std::string name = base::FilePath::FromUTF8Unsafe(a).BaseName().AsUTF8Unsafe();
+    if (name.empty() || name == "." || name == ".." || b.size() > 70000000) {
+      return std::move(reply).Run(base::unexpected("Can't save this file"));
+    }
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](std::string name, std::string data) -> Result {
+              std::optional<std::vector<uint8_t>> bytes =
+                  base::Base64Decode(data);
+              base::FilePath dir;
+              if (!bytes || !base::GetTempDir(&dir)) {
+                return base::unexpected("Can't save this file");
+              }
+              dir = dir.Append("Meridian Drops")
+                        .Append(base::Uuid::GenerateRandomV4().AsLowercaseString());
+              base::FilePath file = dir.Append(base::FilePath::FromUTF8Unsafe(name));
+              if (!base::CreateDirectory(dir) || !base::WriteFile(file, *bytes)) {
+                return base::unexpected("Can't save this file");
+              }
+              return base::Value(file.AsUTF8Unsafe());
+            },
+            name, b),
+        std::move(reply));
+    return;
+  }
   if (method == "stat") {
     return OnProject(base::BindOnce(
                          [](std::string rel, const ProjectFs& p) -> Result {
