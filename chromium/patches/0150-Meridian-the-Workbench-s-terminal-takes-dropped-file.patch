 #ifndef CHROME_BROWSER_UI_TAB_CONTENTS_CHROME_WEB_CONTENTS_VIEW_HANDLE_DROP_H_
 #define CHROME_BROWSER_UI_TAB_CONTENTS_CHROME_WEB_CONTENTS_VIEW_HANDLE_DROP_H_
 
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
 #include "content/public/browser/web_contents_view_delegate.h"
 
 namespace content {
@@ -19,4 +23,16 @@ void HandleOnPerformingDrop(
     content::DropData drop_data,
     content::WebContentsViewDelegate::DropCompletionCallback callback);
 
+// Meridian: the files of the last drop on a page, and when it came. A chrome://
+// page sees only the names and contents of files dropped on it; the
+// Workbench's terminal types their paths, as a terminal does.
+struct DroppedFiles {
+  DroppedFiles();
+  DroppedFiles(const DroppedFiles&);
+  ~DroppedFiles();
+  std::vector<base::FilePath> paths;
+  base::TimeTicks when;
+};
+const DroppedFiles& LastDroppedFiles();
+
 #endif  // CHROME_BROWSER_UI_TAB_CONTENTS_CHROME_WEB_CONTENTS_VIEW_HANDLE_DROP_H_
