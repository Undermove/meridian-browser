+
+  // The heading or option label that starts with `text`, in the shown
+  // section: scrolled to the middle and marked for a moment.
+  private reveal_(text: string) {
+    const want = text.toLowerCase();
+    const all = this.shadowRoot.querySelectorAll<HTMLElement>(
+        'section h2, section .row-label');
+    const el = [...all].find(
+        e => (e.textContent || '').trim().replace(/\s+/g, ' ').toLowerCase()
+                 .startsWith(want));
+    if (!el) {
+      return;
+    }
+    const mark = el.closest<HTMLElement>('.row') || el;
+    mark.scrollIntoView({block: 'center'});
+    mark.classList.add('found');
+    setTimeout(() => mark.classList.remove('found'), 1800);
+  }
