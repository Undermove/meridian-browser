+  // `find`: a heading or an option's label in that section (the command
+  // bar's "Settings" rows, settings_index.ts) to bring into sight and mark
+  // for a moment.
+  async show(spaces: Space[], section: SectionId = 'member', find = '') {
     this.spaces_ = spaces;
     this.section_ = section;
     this.tryResult_ = '';
@@ -256,6 +283,10 @@ export class MeridianSettingsElement extends CrLitElement {
     const {settings} = await this.handler_.getSettings();
