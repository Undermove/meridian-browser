 ];
 
-// How well `q` names a feature: 2 a word of its name or a word for it starts
-// with it, 1 its name or a word for it contains it, 0 not at all.
+// Settings' sections, their options and Chromium's settings pages
+// (settings_index.ts), found the same way and listed after the features.
+export const SETTINGS_FEATURES: CommandBarFeature[] =
+    SETTINGS_INDEX.map(e => ({
+                         id: e.id,
+                         name: e.name,
+                         hint: e.path,
+                         keys: '',
+                         icon: 'settings' as IconName,
+                         words: e.words,
+                       }));
+
+// How well `q` names a feature: 3 it is its name, 2 a word of its name or a
+// word for it starts with it, 1 its name or a word for it contains it, 0 not
+// at all.
 export function featureMatch(f: CommandBarFeature, q: string): number {
   if (q.length < 2) {
     return 0;
   }
+  if (f.name.toLowerCase() === q) {
+    return 3;
+  }
   const names = [f.name.toLowerCase(), ...f.words];
   if (names.some(n => n.split(/[\s-]+/).some(w => w.startsWith(q)) ||
                       n.startsWith(q))) {
@@ -290,18 +307,26 @@ export class MeridianCommandBarElement extends CrLitElement {
             .slice(0, 3) :
         this.tabs.slice(0, 4);
     this.tabRows_ = rows;
-    const features =
-        FEATURES.map(f => ({f, m: featureMatch(f, q)}))
+    // Up to three features, then up to three places in Settings; a setting
+    // named exactly goes first ("ai": Settings' AI, before Chat).
+    const rank = (list: CommandBarFeature[], setting: boolean) =>
+        list.map(f => ({f, m: featureMatch(f, q), setting}))
             .filter(x => x.m > 0)
             .sort((a, b) => b.m - a.m)
             .slice(0, 3);
+    const found = rank(FEATURES, false).concat(rank(SETTINGS_FEATURES, true));
+    const features = found.filter(x => x.setting && x.m === 3)
+                         .concat(found.filter(x => !(x.setting && x.m === 3)));
     this.featureRows_ = features.map(x => x.f);
     const first = q !== '' && !!rows[0] && starts(rows[0]);
     if (changed.has('query_' as keyof MeridianCommandBarElement)) {
       this.tabsFirst_ = first;
       // A feature named by what was typed is picked for Return, before a
       // tab that starts that way.
-      this.tabSel_ = features[0]?.m === 2 ? 0 :
+      // (A setting only when it is named in full: "privacy" and Return
+      // still searches.)
+      const top = features[0];
+      this.tabSel_ = top && (top.setting ? top.m === 3 : top.m >= 2) ? 0 :
           first                          ? this.featureRows_.length :
                                            -1;
     }
