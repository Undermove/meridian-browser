+         ['summaries', 'hover']),
+  option('ai-notify', 'ai', 'AI', 'Agent Notifications',
+         'Notify me when an agent', ['mission control', 'notify']),
+  option('ai-access', 'ai', 'AI', 'What Agents May Do', 'What agents may do',
+         ['agent access', 'mcp', 'permissions', 'read-only', 'full access']),
+  option('ai-js', 'ai', 'AI', 'Run JavaScript in Pages',
+         'Run JavaScript in pages', ['scripts', 'agents']),
+  option('ai-connect', 'ai', 'AI', 'Connect an Agent', 'Connect',
+         ['mcp', 'claude code', 'codex', 'cursor', 'cli']),
+
+  option('theme', 'general', 'General', 'Theme', 'Theme',
+         ['dark', 'light', 'appearance', 'dark mode']),
+  option('sidebar-position', 'general', 'General', 'Sidebar Position',
+         'Sidebar position', ['left', 'right', 'side']),
+  option('space-colours', 'general', 'General', 'Space Colours',
+         'Space colours', ['colors', 'space colors', 'tint']),
+  option('mode', 'general', 'General', 'Mode', 'Mode',
+         ['everyday', 'developer', 'ai for work', 'developer tools']),
+  option('default-browser', 'general', 'General', 'Default Browser',
+         'Default browser', ['make default', 'open links']),
+  option('search-engine', 'general', 'General', 'Search Engine',
+         'Search engine', ['google', 'duckduckgo', 'bing', 'search']),
+  option('archive-after', 'general', 'General', 'Archive Today Tabs After',
+         'Archive Today tabs after', ['auto archive', 'close old tabs']),
+  option('updates', 'general', 'General', 'Updates', 'Updates',
+         ['version', 'check for updates', 'new version']),
+
+  option('link-rules', 'links', 'Links', 'Link Rules', 'Rules',
+         ['routing', 'open links in', 'spaces']),
+  option('other-links', 'links', 'Links', 'Other Links Open In',
+         'Other links open in', ['little window', 'default space']),
+
+  option('adblock', 'advanced', 'Advanced', 'Block Ads and Trackers',
+         'Block ads and trackers', ['adblock', 'ad blocker', 'privacy']),
+  option('clear-archive', 'advanced', 'Advanced', 'Clear the Archive',
+         'Archive', ['delete closed tabs', 'data']),
+  option('about', 'advanced', 'Advanced', 'About Meridian', 'About',
+         ['version', 'licence', 'license']),
+
+  option('welcome-tour', 'member', 'Get started', 'Welcome Tour',
+         'Welcome tour', ['onboarding', 'intro', 'tutorial']),
+
+  chromium('privacy', 'Privacy and Security', 'privacy',
+           ['cookies', 'tracking', 'safe browsing', 'https']),
+  chromium('content', 'Site Settings', 'content',
+           ['site permissions', 'camera', 'microphone', 'location',
+            'notifications', 'pop-ups']),
+  chromium('clear', 'Clear Browsing Data', 'clearBrowserData',
+           ['cache', 'delete history', 'cookies']),
+  chromium('autofill', 'Addresses and Payment Methods', 'autofill',
+           ['autofill', 'cards', 'addresses']),
+  chromium('languages', 'Languages', 'languages',
+           ['spell check', 'translate', 'language']),
+  chromium('downloads', 'Downloads Folder', 'downloads',
+           ['download location', 'ask where to save']),
+  chromium('all', 'All Chromium Settings', '', ['chrome settings']),
+];
+
+export function settingsEntry(id: string): SettingsEntry|undefined {
+  return SETTINGS_INDEX.find(e => e.id === id);
+}
