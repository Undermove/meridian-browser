@@ -1032,6 +1033,20 @@ export class WebuiBrowserAppElement extends CrLitElement {
   // A feature picked in the command bar (its FEATURES id).
   protected onCommandBarFeature_(e: CustomEvent<string>) {
     const run = (command: Command) => this.$.tabstrip.runCommand(command, 0);
+    // A place in Settings (settings_index.ts).
+    const setting = settingsEntry(e.detail);
+    if (setting) {
+      if (setting.url) {
+        this.$.tabstrip.openUrl(setting.url);
+      } else {
+        this.closeSiteControl_();
+        this.$.settings
+            .show(this.$.tabstrip.spaces(), setting.section, setting.find)
+            .then(() => this.$.settings.updateComplete)
+            .then(() => this.$.settings.focusSection());
+      }
+      return;
+    }
     switch (e.detail) {
       case 'workbench':
         run(Command.kWorkbench);
