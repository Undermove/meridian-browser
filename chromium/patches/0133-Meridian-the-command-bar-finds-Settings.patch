+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// What the command bar finds in Settings, like "search everywhere" in an
+// editor: each section of Meridian's Settings, the options in them, and the
+// pages of Chromium's own settings. Picking one opens Settings at that
+// section with the option in sight, or the Chromium page in a tab.
+//
+// `find` is the text of the heading or of the option's label in
+// settings.html.ts (settings.test.mjs checks that every one is there, so a
+// renamed option doesn't leave an entry that leads nowhere).
+
+import type {SectionId} from './settings.js';
+
+export interface SettingsEntry {
+  // 'set:<something>', for the command bar's rows.
+  id: string;
+  name: string;
+  // Where it is, shown beside the name.
+  path: string;
+  // Other words a person may type for it.
+  words: string[];
+  // In Meridian's Settings…
+  section?: SectionId;
+  find?: string;
+  // …or a page of Chromium's.
+  url?: string;
+}
+
+const section =
+    (id: SectionId, name: string, words: string[]): SettingsEntry =>
+        ({id: `set:${id}`, name, path: 'Settings', words, section: id});
+
+const option = (id: string, sectionId: SectionId, where: string, name: string,
+                find: string, words: string[]): SettingsEntry => ({
+  id: `set:${id}`,
+  name,
+  path: `Settings › ${where}`,
+  words,
+  section: sectionId,
+  find,
+});
+
+const chromium = (id: string, name: string, page: string,
+                  words: string[]): SettingsEntry => ({
+  id: `set:chromium-${id}`,
+  name,
+  path: 'Chromium settings',
+  words,
+  url: `chrome://settings/${page}`,
+});
+
+export const SETTINGS_INDEX: SettingsEntry[] = [
+  section('ai', 'AI', ['artificial intelligence', 'llm', 'models']),
+  section('general', 'General', []),
+  section('profiles', 'Profiles', ['accounts', 'work profile', 'personal']),
+  section('links', 'Links', ['air traffic control', 'atc', 'link rules']),
+  section('advanced', 'Advanced', []),
+
+  option('ai-provider', 'ai', 'AI', 'AI Provider', 'Your AI',
+         ['your ai', 'model', 'ollama', 'lm studio', 'openai', 'gemini',
+          'local model']),
+  option('ai-keys', 'ai', 'AI', 'API Keys', 'API keys',
+         ['anthropic key', 'openai key', 'token']),
+  option('ai-tidy', 'ai', 'AI', 'Tidy Today', 'Tidy Today',
