From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Fri, 30 Oct 2026 18:24:00 +0400
Subject: [PATCH 67/68] Meridian: a Little Window on an empty page starts in
 the command bar
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Like Little Arc: ⌥⌘N opens the command bar over a compact home (the
greeting and the search field, no feature tour).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/resources/webui_browser/app.html.ts       | 2 +-
 chrome/browser/resources/webui_browser/app.ts            | 7 +++++++
 chrome/browser/resources/webui_browser/meridian/home.css | 7 +++++++
 chrome/browser/resources/webui_browser/meridian/home.ts  | 3 +++
 4 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/resources/webui_browser/app.html.ts b/chrome/browser/resources/webui_browser/app.html.ts
index 38014e2641..043ab29bea 100644
--- a/chrome/browser/resources/webui_browser/app.html.ts
+++ b/chrome/browser/resources/webui_browser/app.html.ts
@@ -161,7 +161,7 @@ export function getHtml(this: WebuiBrowserAppElement) {
         @meridian-open-url="${this.onMeridianOpenUrl_}"
         @meridian-show-settings="${this.onMeridianShowSettings_}">
     </meridian-chat>
-    <meridian-home id="home" ?shown="${this.showHome_}"
+    <meridian-home id="home" ?shown="${this.showHome_}" ?little="${this.little_}"
         @meridian-home-action="${this.onMeridianHomeAction_}"
         @meridian-preset="${this.onMeridianPreset_}">
     </meridian-home>
diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index c6ae2109df..7fd66ff5f1 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -214,6 +214,7 @@ export class WebuiBrowserAppElement extends CrLitElement {
   protected accessor sidebarPeek_: boolean = false;
   // A Little window: a link from another app, without the sidebar.
   protected accessor little_: boolean = false;
+  private littleAsked_ = false;
   protected accessor sidebarRight_: boolean = false;
   protected accessor private_: boolean = false;
   // The active tab is a new tab: the home page shows instead.
@@ -490,6 +491,12 @@ export class WebuiBrowserAppElement extends CrLitElement {
 
   override updated(changed: PropertyValues<this>) {
     super.updated(changed);
+    // A Little Window opened on an empty page (⌥⌘N) starts in the command
+    // bar, like Little Arc.
+    if (this.little_ && this.showHome_ && !this.littleAsked_) {
+      this.littleAsked_ = true;
+      this.showCommandBar_(/*newTab=*/ false, '');
+    }
     if (changed.has('sidebarHidden_' as keyof WebuiBrowserAppElement) ||
         changed.has('sidebarPeek_' as keyof WebuiBrowserAppElement) ||
         changed.has('little_' as keyof WebuiBrowserAppElement)) {
diff --git a/chrome/browser/resources/webui_browser/meridian/home.css b/chrome/browser/resources/webui_browser/meridian/home.css
index 3321671316..6d2d3dbbfa 100644
--- a/chrome/browser/resources/webui_browser/meridian/home.css
+++ b/chrome/browser/resources/webui_browser/meridian/home.css
@@ -670,3 +670,10 @@ kbd {
     width: 85%;
   }
 }
+
+/* A Little Window is for one quick page: no tour of features. */
+:host([little]) .quick,
+:host([little]) #expand,
+:host([little]) #more {
+  display: none;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/home.ts b/chrome/browser/resources/webui_browser/meridian/home.ts
index 53d7654cad..1256ddb04f 100644
--- a/chrome/browser/resources/webui_browser/meridian/home.ts
+++ b/chrome/browser/resources/webui_browser/meridian/home.ts
@@ -132,6 +132,8 @@ export class MeridianHomeElement extends CrLitElement {
   static override get properties() {
     return {
       shown: {type: Boolean, reflect: true},
+      // In a Little Window: the greeting and the search field only.
+      little: {type: Boolean, reflect: true},
       compact_: {type: Boolean, reflect: true, attribute: 'compact'},
       greeting_: {state: true, type: String},
       tipKeys_: {state: true, type: Array},
@@ -142,6 +144,7 @@ export class MeridianHomeElement extends CrLitElement {
   }
 
   accessor shown: boolean = false;
+  accessor little: boolean = false;
   protected accessor compact_: boolean = readCompact();
   protected accessor greeting_: string = '';
   protected accessor tipKeys_: string[] = [];
