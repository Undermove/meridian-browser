+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/toolkit/toolkit_cdp.h"
+
+#include <string_view>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/task/sequenced_task_runner.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace meridian::toolkit {
+
+CdpSession::CdpSession(content::WebContents* contents) {
+  host_ = content::DevToolsAgentHost::GetOrCreateFor(contents);
+  if (!host_->AttachClient(this)) {
+    host_ = nullptr;
+  }
+}
+
+CdpSession::~CdpSession() {
+  if (host_) {
+    host_->DetachClient(this);
+  }
+}
+
+void CdpSession::Send(const std::string& method,
+                      base::DictValue params,
+                      Done done) {
+  if (!host_) {
+    if (done) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(std::move(done), base::Value()));
+    }
+    return;
+  }
+  const int id = ++id_;
+  if (done) {
+    pending_[id] = std::move(done);
+  }
+  std::string json = base::WriteJson(base::DictValue()
+                                         .Set("id", id)
+                                         .Set("method", method)
+                                         .Set("params", std::move(params)))
+                         .value_or("{}");
+  host_->DispatchProtocolMessage(this, base::as_byte_span(json));
+}
+
+void CdpSession::DispatchProtocolMessage(content::DevToolsAgentHost*,
+                                         base::span<const uint8_t> message) {
+  std::optional<base::Value> v = base::JSONReader::Read(
+      std::string_view(reinterpret_cast<const char*>(message.data()),
+                       message.size()),
+      0);
+  if (!v || !v->is_dict()) {
+    return;
+  }
+  const std::optional<int> id = v->GetDict().FindInt("id");
+  if (!id) {
+    return;  // an event
+  }
+  auto it = pending_.find(*id);
+  if (it == pending_.end()) {
+    return;
+  }
+  Done done = std::move(it->second);
+  pending_.erase(it);
+  base::Value result;
+  if (base::DictValue* r = v->GetDict().FindDict("result")) {
+    result = base::Value(std::move(*r));
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(done), std::move(result)));
+}
+
+void CdpSession::AgentHostClosed(content::DevToolsAgentHost*) {
+  host_ = nullptr;
+  for (auto& [id, done] : pending_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), base::Value()));
+  }
+  pending_.clear();
+}
+
+}  // namespace meridian::toolkit
