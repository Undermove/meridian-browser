+void ToolkitTabHelper::Page(int id, const base::DictValue& args) {
+  const double w = args.FindDouble("width").value_or(0);
+  const double h = std::min(args.FindDouble("height").value_or(0), 30000.0);
+  // The screenshot already has the screen's scale (2× on a Retina Mac).
+  const double scale = 1;
+  if (w <= 0 || h <= 0 || page_cdp_) {
+    return Answer(id, base::Value());
+  }
+  page_cdp_ = std::make_unique<CdpSession>(web_contents());
+  if (!page_cdp_->attached()) {
+    page_cdp_.reset();
+    return Answer(id, base::Value());
+  }
+  content::RenderWidgetHostView* view =
+      web_contents()->GetRenderWidgetHostView();
+  const float dsf = view ? view->GetDeviceScaleFactor() : 1.f;
+  const int tile = std::max(200, static_cast<int>(8000 / std::max(1.f, dsf)));
+  CaptureTile(id, w, h, scale, tile, 0, base::ListValue());
+}
+
+void ToolkitTabHelper::CaptureTile(int id,
+                                   double w,
+                                   double h,
+                                   double scale,
+                                   int tile,
+                                   int y,
+                                   base::ListValue tiles) {
+  if (y >= h) {
+    page_cdp_.reset();
+    return Answer(id, base::Value(base::DictValue()
+                                      .Set("tiles", std::move(tiles))
+                                      .Set("tile", tile)
+                                      .Set("scale", scale)));
+  }
+  const double th = std::min<double>(tile, h - y);
+  page_cdp_->Send(
+      "Page.captureScreenshot",
+      base::DictValue()
+          .Set("format", "png")
+          .Set("captureBeyondViewport", true)
+          .Set("fromSurface", true)
+          .Set("clip", base::DictValue()
+                           .Set("x", 0)
+                           .Set("y", y)
+                           .Set("width", w)
+                           .Set("height", th)
+                           .Set("scale", scale)),
+      base::BindOnce(
+          [](base::WeakPtr<ToolkitTabHelper> self, int id, double w, double h,
+             double scale, int tile, int y, base::ListValue tiles,
+             base::Value result) {
+            if (!self) {
+              return;
+            }
+            const std::string* data =
+                result.is_dict() ? result.GetDict().FindString("data")
+                                 : nullptr;
+            if (!data) {
+              self->page_cdp_.reset();
+              return self->Answer(id, base::Value());
+            }
+            tiles.Append(*data);
+            self->CaptureTile(id, w, h, scale, tile, y + tile,
+                              std::move(tiles));
+          },
+          weak_factory_.GetWeakPtr(), id, w, h, scale, tile, y,
+          std::move(tiles)));
+}
+
+void ToolkitTabHelper::Phone(int id, const base::DictValue& args) {
+  const std::string* op = args.FindString("op");
+  if (!op) {
+    return Answer(id, base::Value(false));
+  }
+  if (*op == "close") {
+    if (phone_) {
+      if (tabs::TabInterface* tab =
+              tabs::TabInterface::MaybeGetFromContents(phone_.get())) {
+        tab->Close();
+      }
+    }
+    phone_ = nullptr;
+    return Answer(id, base::Value(true));
+  }
+  base::DictValue spec = args.Clone();
+  spec.Remove("op");
+  if (!phone_) {
+    tabs::TabInterface* me =
+        tabs::TabInterface::MaybeGetFromContents(web_contents());
+    BrowserWindowInterface* window =
+        me ? me->GetBrowserWindowInterface() : nullptr;
+    SidebarHandler* handler = window ? SidebarHandler::For(window) : nullptr;
+    if (!handler) {
+      return Answer(id, base::Value(false));
+    }
+    NavigateParams params(window, web_contents()->GetLastCommittedURL(),
+                          ui::PAGE_TRANSITION_LINK);
+    params.disposition = WindowOpenDisposition::kNewBackgroundTab;
+    ::Navigate(&params);
+    content::WebContents* contents = params.navigated_or_inserted_contents;
+    tabs::TabInterface* tab =
+        contents ? tabs::TabInterface::MaybeGetFromContents(contents)
+                 : nullptr;
+    if (!tab) {
+      return Answer(id, base::Value(false));
+    }
+    if (const TabData* data = TabData::Get(web_contents())) {
+      TabData::Set(contents, data->space_id(), std::string());
+    }
+    window->GetTabStripModel()->ActivateTab(me);
+    handler->SplitWith(tabs_api::NodeId::FromTabHandle(tab->GetHandle()));
+    phone_ = contents->GetWeakPtr();
+  }
+  ToolkitTabHelper* phone = ToolkitTabHelper::FromWebContents(phone_.get());
+  if (!phone) {
+    return Answer(id, base::Value(false));
+  }
+  phone->ApplyPhone(std::move(spec));
+  Answer(id, base::Value(true));
+}
+
+void ToolkitTabHelper::ApplyPhone(base::DictValue spec) {
+  const std::string* id = spec.FindString("device");
+  const Device& d = DeviceFor(id ? *id : std::string("iphone"));
+  const bool land = spec.FindBool("landscape").value_or(false);
+  const bool dark = spec.FindBool("dark").value_or(false);
+  const bool motion = spec.FindBool("motion").value_or(false);
+  const bool slow = spec.FindBool("slow").value_or(false);
+  const int w = land ? d.height : d.width;
+  const int h = land ? d.width : d.height;
+  const gfx::Size view = web_contents()->GetContainerBounds().size();
+  double fit = 1;
+  if (!view.IsEmpty()) {
+    fit = std::min({1.0, (view.height() - 24.0) / h, (view.width() - 24.0) / w});
+  }
+  if (fit <= 0.1) {
+    fit = 1;
+  }
+  const bool reload =
+      !phone_spec_ || !phone_spec_->FindString("device") ||
+      *phone_spec_->FindString("device") != std::string(d.id);
+  if (!phone_cdp_) {
+    phone_cdp_ = std::make_unique<CdpSession>(web_contents());
+  }
+  CdpSession& s = *phone_cdp_;
+  s.Send("Emulation.setDeviceMetricsOverride",
+         base::DictValue()
+             .Set("width", w)
+             .Set("height", h)
+             .Set("deviceScaleFactor", d.scale)
+             .Set("mobile", true)
+             .Set("scale", fit)
+             .Set("screenWidth", w)
+             .Set("screenHeight", h)
+             .Set("screenOrientation",
+                  base::DictValue()
+                      .Set("type", land ? "landscapePrimary" : "portraitPrimary")
+                      .Set("angle", land ? 90 : 0)));
+  s.Send("Emulation.setTouchEmulationEnabled",
+         base::DictValue().Set("enabled", true).Set("maxTouchPoints", 5));
+  s.Send("Emulation.setEmitTouchEventsForMouse",
+         base::DictValue().Set("enabled", true).Set("configuration", "mobile"));
+  s.Send("Emulation.setUserAgentOverride",
+         base::DictValue().Set("userAgent", d.ua).Set("platform", d.platform));
+  s.Send("Emulation.setEmulatedMedia",
+         base::DictValue().Set(
+             "features",
+             base::ListValue()
+                 .Append(base::DictValue()
+                             .Set("name", "prefers-color-scheme")
+                             .Set("value", dark ? "dark" : "light"))
+                 .Append(base::DictValue()
+                             .Set("name", "prefers-reduced-motion")
+                             .Set("value", motion ? "reduce" : "no-preference"))));
+  s.Send("Network.enable", base::DictValue());
+  // "Slow 3G" of DevTools: 400 ms, ~400 kbit/s down, ~400 kbit/s up.
+  s.Send("Network.emulateNetworkConditions",
+         base::DictValue()
+             .Set("offline", false)
+             .Set("latency", slow ? 400 : 0)
+             .Set("downloadThroughput", slow ? 50000 : -1)
+             .Set("uploadThroughput", slow ? 50000 : -1));
+  spec.Set("frame", base::DictValue()
+                        .Set("kind", d.id)
+                        .Set("radius", land ? 0 : d.radius));
+  phone_spec_ = std::move(spec);
+  if (reload) {
+    s.Send("Page.reload", base::DictValue());
+  } else {
+    Run(PhoneFrameScript());
+  }
+}
+
+std::string ToolkitTabHelper::PhoneFrameScript() const {
+  if (!phone_spec_) {
+    return std::string();
+  }
+  const base::DictValue* frame = phone_spec_->FindDict("frame");
+  return "window.__meridianToolkit && window.__meridianToolkit.tk.phoneFrame(" +
+         (frame ? base::WriteJson(*frame).value_or("null") : "null") + ");";
+}
+
+void ToolkitTabHelper::Qr(int id) {
+  // Only a page the phone can open as is: http(s) and not this computer's
+  // own (localhost, 127.0.0.1, [::1], file:). Those would need a server on
+  // the network; not in this version.
+  const GURL& url = web_contents()->GetLastCommittedURL();
+  if (!url.SchemeIsHTTPOrHTTPS() || net::IsLocalhost(url)) {
+    return Answer(id, base::Value(base::DictValue().Set("local", true)));
+  }
+  const std::string spec = url.spec();
+  auto code = qr_code_generator::GenerateCode(base::as_byte_span(spec));
+  if (!code.has_value()) {
+    return Answer(id, base::Value());
+  }
+  std::string bits;
+  bits.reserve(code->data.size());
+  for (uint8_t b : code->data) {
+    bits.push_back((b & 1) ? '1' : '0');
+  }
+  Answer(id, base::Value(base::DictValue()
+                             .Set("size", code->qr_size)
+                             .Set("bits", std::move(bits))
+                             .Set("url", spec)));
+}
