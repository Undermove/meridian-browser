@@ -0,0 +1,414 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/live_folders.h"
+
+#include <map>
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/json/json_reader.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/escape.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/meridian/sidebar_service.h"
+#include "chrome/browser/meridian/test_switches.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/base/load_flags.h"
+#include "net/base/url_util.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/data_decoder/public/cpp/data_decoder.h"
+#include "services/data_decoder/public/cpp/safe_xml_parser.h"
+#include "services/data_decoder/public/mojom/xml_parser.mojom.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+
+namespace meridian::live_folders {
+
+namespace {
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("meridian_live_folders", R"(
+      semantics {
+        sender: "Meridian live folders"
+        description: "The feed (RSS or Atom) or GitHub search a pinned "
+          "folder was made live with, for its newest items."
+        trigger: "The person makes a folder live, then every 30 minutes "
+          "while a window is open."
+        data: "None."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Stop Live Updates in the folder's menu."
+        policy_exception_justification: "Not implemented."
+      })");
+
+using Done = base::OnceCallback<void(std::string)>;
+
+// One SidebarService's live folders, while a window shows them.
+struct State {
+  ~State() {
+    for (auto& [id, list] : waiting) {
+      for (Done& done : list) {
+        std::move(done).Run("the window closed");
+      }
+    }
+  }
+  std::map<const void*, raw_ptr<Profile>> owners;
+  base::RepeatingTimer timer;
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>> loaders;
+  std::map<std::string, std::vector<Done>> waiting;
+  base::WeakPtrFactory<State> weak{this};
+};
+
+std::map<SidebarService*, std::unique_ptr<State>>& States() {
+  static base::NoDestructor<std::map<SidebarService*, std::unique_ptr<State>>>
+      states;
+  return *states;
+}
+
+base::TimeDelta Interval() {
+  int seconds = 0;
+  if (base::StringToInt(TestSwitchValue("meridian-test-live-folder-seconds"),
+                        &seconds) &&
+      seconds > 0) {
+    return base::Seconds(seconds);
+  }
+  return base::Minutes(30);
+}
+
+std::string LocalName(const base::Value& el) {
+  std::string name;
+  if (!data_decoder::GetXmlElementTagName(el, &name)) {
+    return std::string();
+  }
+  size_t colon = name.rfind(':');
+  return colon == std::string::npos ? name : name.substr(colon + 1);
+}
+
+std::vector<const base::Value*> Children(const base::Value& el,
+                                         std::string_view name) {
+  std::vector<const base::Value*> out;
+  if (const base::ListValue* list = data_decoder::GetXmlElementChildren(el)) {
+    for (const base::Value& child : *list) {
+      if (data_decoder::IsXmlElementOfType(
+              child, data_decoder::mojom::XmlParser::kElementType) &&
+          LocalName(child) == name) {
+        out.push_back(&child);
+      }
+    }
+  }
+  return out;
+}
+
+const base::Value* Child(const base::Value& el, std::string_view name) {
+  std::vector<const base::Value*> all = Children(el, name);
+  return all.empty() ? nullptr : all.front();
+}
+
+std::string Text(const base::Value* el) {
+  std::string out;
+  if (!el) {
+    return out;
+  }
+  if (const base::ListValue* list = data_decoder::GetXmlElementChildren(*el)) {
+    // Every text and CDATA piece (GetXmlElementText gives the first only).
+    for (const base::Value& child : *list) {
+      const base::DictValue* node = child.GetIfDict();
+      const std::string* type =
+          node ? node->FindString(data_decoder::mojom::XmlParser::kTypeKey)
+               : nullptr;
+      if (type && (*type == data_decoder::mojom::XmlParser::kTextNodeType ||
+                   *type == data_decoder::mojom::XmlParser::kCDataNodeType)) {
+        if (const std::string* text =
+                node->FindString(data_decoder::mojom::XmlParser::kTextKey)) {
+          out += *text;
+        }
+      }
+    }
+  }
+  return out;
+}
+
+std::string CleanTitle(const std::string& title) {
+  std::string t = base::CollapseWhitespaceASCII(title, true);
+  return t.size() > 200 ? t.substr(0, 200) : t;
+}
+
+void Finish(SidebarService* service,
+            const std::string& id,
+            std::optional<Links> links) {
+  auto it = States().find(service);
+  if (it == States().end()) {
+    return;
+  }
+  State& state = *it->second;
+  state.loaders.erase(id);
+  std::string error;
+  if (links) {
+    if (links->size() > kMaxItems) {
+      links->resize(kMaxItems);
+    }
+    service->SetLiveItems(id, *links);
+  } else {
+    error =
+        "That address isn't an RSS or Atom feed or a GitHub search, or it "
+        "didn't load.";
+  }
+  std::vector<Done> waiting = std::move(state.waiting[id]);
+  state.waiting.erase(id);
+  for (Done& done : waiting) {
+    std::move(done).Run(error);
+  }
+}
+
+void Refresh(SidebarService* service,
+             const std::string& id,
+             const GURL& url,
+             Done done) {
+  auto it = States().find(service);
+  if (it == States().end() || it->second->owners.empty()) {
+    return std::move(done).Run("no window is open");
+  }
+  State& state = *it->second;
+  state.waiting[id].push_back(std::move(done));
+  if (state.loaders.contains(id)) {
+    return;  // Already on its way.
+  }
+  bool github = false;
+  GURL fetch = FetchUrlFor(url, &github);
+  if (!fetch.SchemeIsHTTPOrHTTPS()) {
+    return Finish(service, id, std::nullopt);
+  }
+  Profile* profile = state.owners.begin()->second;
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = fetch;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  if (github) {
+    request->headers.SetHeader("Accept", "application/vnd.github+json");
+  }
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+  loader->SetTimeoutDuration(base::Seconds(20));
+  network::SimpleURLLoader* raw = loader.get();
+  state.loaders[id] = std::move(loader);
+  raw->DownloadToString(
+      profile->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(
+          [](base::WeakPtr<State> state, SidebarService* service,
+             std::string id, GURL base, bool github,
+             std::optional<std::string> body) {
+            if (!state) {
+              return;
+            }
+            if (!body) {
+              return Finish(service, id, std::nullopt);
+            }
+            if (github) {
+              return Finish(service, id, ParseGithub(*body));
+            }
+            data_decoder::DataDecoder::ParseXmlIsolated(
+                *body,
+                data_decoder::mojom::XmlParser::WhitespaceBehavior::
+                    kIgnore,
+                base::BindOnce(
+                    [](base::WeakPtr<State> state, SidebarService* service,
+                       std::string id, GURL base,
+                       data_decoder::DataDecoder::ValueOrError xml) {
+                      if (!state) {
+                        return;
+                      }
+                      Finish(service, id,
+                             xml.has_value() ? ParseFeed(*xml, base)
+                                             : std::nullopt);
+                    },
+                    state, service, id, base));
+          },
+          state.weak.GetWeakPtr(), service, id, fetch, github),
+      1024 * 1024);
+}
+
+void RefreshAll(SidebarService* service) {
+  for (const auto& [id, url] : service->LiveFolderList()) {
+    Refresh(service, id, url, base::DoNothing());
+  }
+}
+
+}  // namespace
+
+void Attach(SidebarService* service, Profile* profile, const void* owner) {
+  std::unique_ptr<State>& state = States()[service];
+  if (!state) {
+    state = std::make_unique<State>();
+    state->timer.Start(FROM_HERE, Interval(),
+                       base::BindRepeating(&RefreshAll, service));
+    // Fresh items soon after the start too.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<State> state, SidebarService* service) {
+              if (state) {
+                RefreshAll(service);
+              }
+            },
+            state->weak.GetWeakPtr(), service),
+        base::Seconds(3));
+  }
+  state->owners[owner] = profile;
+}
+
+void Detach(SidebarService* service, const void* owner) {
+  auto it = States().find(service);
+  if (it == States().end()) {
+    return;
+  }
+  it->second->owners.erase(owner);
+  if (it->second->owners.empty()) {
+    States().erase(it);
+  }
+}
+
+void RefreshNow(SidebarService* service,
+                const std::string& item_id,
+                Done done) {
+  const Item* item = service->FindItem(item_id);
+  if (!item || !item->is_folder || !item->live_url.is_valid()) {
+    return std::move(done).Run("not a live folder");
+  }
+  Refresh(service, item_id, item->live_url, std::move(done));
+}
+
+GURL FetchUrlFor(const GURL& url, bool* github) {
+  *github = false;
+  std::string api = TestSwitchValue("meridian-test-github-api");
+  if (api.empty()) {
+    api = "https://api.github.com";
+  }
+  if (url.host() == "api.github.com" && url.path().starts_with("/search/")) {
+    *github = true;
+    return url;
+  }
+  if ((url.host() != "github.com" && url.host() != "www.github.com") ||
+      url.path() != "/search") {
+    return url;
+  }
+  std::string q, type, sort, order;
+  net::GetValueForKeyInQuery(url, "q", &q);
+  net::GetValueForKeyInQuery(url, "type", &type);
+  net::GetValueForKeyInQuery(url, "s", &sort);
+  net::GetValueForKeyInQuery(url, "o", &order);
+  if (q.empty()) {
+    return url;
+  }
+  type = base::ToLowerASCII(type);
+  std::string kind = "repositories";
+  if (type == "issues" || type == "pullrequests") {
+    kind = "issues";
+    const char* is = type == "issues" ? "is:issue" : "is:pr";
+    if (q.find(is) == std::string::npos) {
+      q += std::string(" ") + is;
+    }
+  }
+  *github = true;
+  std::string spec = api + "/search/" + kind +
+                     "?q=" + base::EscapeQueryParamValue(q, true) +
+                     "&per_page=" + base::NumberToString(kMaxItems);
+  if (!sort.empty()) {
+    spec += "&sort=" + base::EscapeQueryParamValue(sort, true);
+  }
+  if (!order.empty()) {
+    spec += "&order=" + base::EscapeQueryParamValue(order, true);
+  }
+  return GURL(spec);
+}
+
+std::optional<Links> ParseGithub(const std::string& json) {
+  std::optional<base::Value> value = base::JSONReader::Read(
+      json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  const base::ListValue* items =
+      value && value->is_dict() ? value->GetDict().FindList("items") : nullptr;
+  if (!items) {
+    return std::nullopt;
+  }
+  Links out;
+  for (const base::Value& v : *items) {
+    const base::DictValue* item = v.GetIfDict();
+    const std::string* href = item ? item->FindString("html_url") : nullptr;
+    if (!href) {
+      continue;
+    }
+    const std::string* title = item->FindString("title");
+    if (!title) {
+      title = item->FindString("full_name");
+    }
+    GURL url(*href);
+    if (url.SchemeIsHTTPOrHTTPS()) {
+      out.emplace_back(CleanTitle(title ? *title : *href), url);
+    }
+    if (out.size() >= kMaxItems) {
+      break;
+    }
+  }
+  return out;
+}
+
+std::optional<Links> ParseFeed(const base::Value& xml, const GURL& base) {
+  const std::string root = LocalName(xml);
+  std::vector<const base::Value*> entries;
+  const bool atom = root == "feed";
+  if (root == "rss") {
+    if (const base::Value* channel = Child(xml, "channel")) {
+      entries = Children(*channel, "item");
+    }
+  } else if (root == "RDF") {
+    entries = Children(xml, "item");
+  } else if (atom) {
+    entries = Children(xml, "entry");
+  } else {
+    return std::nullopt;
+  }
+  Links out;
+  for (const base::Value* entry : entries) {
+    std::string href;
+    if (atom) {
+      for (const base::Value* link : Children(*entry, "link")) {
+        std::string rel =
+            data_decoder::GetXmlElementAttribute(*link, "rel");
+        if (rel.empty() || rel == "alternate") {
+          href = data_decoder::GetXmlElementAttribute(*link, "href");
+          break;
+        }
+        if (href.empty()) {
+          href = data_decoder::GetXmlElementAttribute(*link, "href");
+        }
+      }
+    } else {
+      href = std::string(
+          base::TrimWhitespaceASCII(Text(Child(*entry, "link")), base::TRIM_ALL));
+    }
+    GURL url = base.Resolve(href);
+    if (href.empty() || !url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    out.emplace_back(CleanTitle(Text(Child(*entry, "title"))), url);
+    if (out.size() >= kMaxItems) {
+      break;
+    }
+  }
+  return out;
+}
+
+}  // namespace meridian::live_folders
