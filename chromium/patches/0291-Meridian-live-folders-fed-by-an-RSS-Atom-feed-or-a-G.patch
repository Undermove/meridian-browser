+void SidebarHandler::SetFolderLive(const std::string& item_id,
+                                   const GURL& url,
+                                   SetFolderLiveCallback callback) {
+  if (url.is_empty()) {
+    service_->SetFolderLive(item_id, GURL());
+    return std::move(callback).Run(std::string());
+  }
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return std::move(callback).Run(
+        "Give an http(s) address: an RSS or Atom feed, or a GitHub search.");
+  }
+  const Item* item = service_->FindItem(item_id);
+  if (!item || !item->is_folder) {
+    return std::move(callback).Run("That folder is gone.");
+  }
+  const GURL before = item->live_url;
+  service_->SetFolderLive(item_id, url);
+  // Its first items now; an address that gives none leaves it as it was.
+  live_folders::RefreshNow(
+      service_, item_id,
+      base::BindOnce(
+          [](base::WeakPtr<SidebarHandler> self, std::string item_id,
+             GURL before, SetFolderLiveCallback callback, std::string error) {
+            if (!error.empty() && self) {
+              self->service_->SetFolderLive(item_id, before);
+            }
+            std::move(callback).Run(error);
+          },
+          weak_factory_.GetWeakPtr(), item_id, before, std::move(callback)));
+}
