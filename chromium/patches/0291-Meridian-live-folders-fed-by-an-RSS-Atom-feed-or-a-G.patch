+bool SidebarService::SetFolderLive(const std::string& item_id,
+                                   const GURL& url) {
+  Item* item = const_cast<Item*>(FindItem(item_id));
+  if (!item || !item->is_folder ||
+      (!url.is_empty() && !url.SchemeIsHTTPOrHTTPS())) {
