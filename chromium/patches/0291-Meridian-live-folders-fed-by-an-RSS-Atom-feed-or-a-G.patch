+#ifndef CHROME_BROWSER_MERIDIAN_LIVE_FOLDERS_H_
+#define CHROME_BROWSER_MERIDIAN_LIVE_FOLDERS_H_
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+#include "url/gurl.h"
+
+class Profile;
+
+namespace meridian {
+
+class SidebarService;
+
+// Live folders (Arc's): a pinned folder whose items come from an RSS or
+// Atom feed or a GitHub search, its first 10, refreshed every 30 minutes
+// while a window is open. Nothing is sent but the request itself: no
+// cookies.
+namespace live_folders {
+
+inline constexpr size_t kMaxItems = 10;
+
+// A window keeps them refreshing while it's open (`owner`: its handler).
+void Attach(SidebarService* service, Profile* profile, const void* owner);
+void Detach(SidebarService* service, const void* owner);
+
+// "Make Live…": the folder's items now. `done` gets "" or why not.
+void RefreshNow(SidebarService* service,
+                const std::string& item_id,
+                base::OnceCallback<void(std::string error)> done);
+
+// What is fetched for a live folder's URL: a GitHub search page
+// (github.com/search?q=…) becomes GitHub's search API (`github` true);
+// anything else is fetched as it is (a feed).
+GURL FetchUrlFor(const GURL& url, bool* github);
+
+using Links = std::vector<std::pair<std::string, GURL>>;
+// GitHub's search API answer: issues and pull requests (title) or
+// repositories (full name). nullopt: not one.
+std::optional<Links> ParseGithub(const std::string& json);
+// An RSS (2.0 or 1.0) or Atom document as the data decoder's XML parser
+// gives it; links relative to `base`. nullopt: not a feed.
+std::optional<Links> ParseFeed(const base::Value& xml, const GURL& base);
+
+}  // namespace live_folders
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_LIVE_FOLDERS_H_
