+
+bool SidebarService::SetLiveItems(
+    const std::string& item_id,
+    const std::vector<std::pair<std::string, GURL>>& links) {
+  Item* folder = const_cast<Item*>(FindItem(item_id));
+  if (!folder || !folder->is_folder || !folder->live_url.is_valid()) {
+    return false;
+  }
+  std::vector<Item> children;
+  for (const auto& [title, url] : links) {
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    Item child;
+    child.title = title.empty() ? url.spec() : title;
+    child.url = url;
+    for (const Item& old : folder->children) {
+      if (!old.is_folder && old.url == url) {
+        child.id = old.id;
+      }
+    }
+    if (child.id.empty()) {
+      child.id = NewId();
+    }
+    children.push_back(std::move(child));
+  }
+  const bool same =
+      children.size() == folder->children.size() &&
+      std::ranges::equal(children, folder->children,
+                         [](const Item& a, const Item& b) {
+                           return a.id == b.id && a.title == b.title &&
+                                  a.url == b.url && !b.is_folder;
+                         });
+  if (same) {
+    return false;
+  }
+  folder->children = std::move(children);
+  Changed();
+  return true;
+}
+
+std::vector<std::pair<std::string, GURL>> SidebarService::LiveFolderList()
+    const {
+  std::vector<std::pair<std::string, GURL>> out;
+  std::function<void(const std::vector<Item>&)> walk =
+      [&](const std::vector<Item>& items) {
+        for (const Item& item : items) {
+          if (item.is_folder && item.live_url.is_valid()) {
+            out.emplace_back(item.id, item.live_url);
+          }
+          if (item.is_folder) {
+            walk(item.children);
+          }
+        }
+      };
+  for (const Space& space : spaces_) {
+    walk(space.pinned);
+  }
+  for (const std::vector<Item>* list : FavoriteLists()) {
+    walk(*list);
+  }
+  return out;
+}
