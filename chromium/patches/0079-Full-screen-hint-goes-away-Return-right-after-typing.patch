+++ b/ui/webui/resources/cr_components/searchbox/searchbox_mixin.ts
@@ -1014,7 +1014,10 @@ export const SearchboxMixin = <T extends Constructor<CrLitElement>>(
       }
 
       // Do not handle the following keys if there are no matches available.
-      if (!this.result || this.result.matches.length === 0) {
+      // Enter still goes on: typed and pressed quickly, before the first
+      // matches, it waits for them (see handleEnterNavigation_()).
+      if ((!this.result || this.result.matches.length === 0) &&
+          e.key !== 'Enter') {
         return;
       }
 
