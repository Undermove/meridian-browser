+std::string Friendly(int status, const std::string& body) {
+  std::string message;
+  if (std::optional<base::Value> v = base::JSONReader::Read(body, 0)) {
+    if (const std::string* m =
+            v->is_dict() ? v->GetDict().FindStringByDottedPath("error.message")
+                         : nullptr) {
+      message = *m;
+    }
+  }
+  switch (status) {
+    case 401:
+      return "Anthropic didn’t accept the API key. Check it in Settings > AI.";
+    case 403:
+      return "This API key can’t use Claude yet. Check billing in the "
+             "Anthropic Console.";
+    case 429:
+      return "Rate limited by Anthropic. Try again in a moment.";
+    case 529:
+      return "Claude is overloaded right now. Try again in a moment.";
+  }
+  return message.empty() ? "Claude couldn’t answer (HTTP " +
+                               base::NumberToString(status) + ")."
+                         : message;
+}
