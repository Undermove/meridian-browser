diff --git a/chrome/browser/resources/webui_browser/meridian/markdown.ts b/chrome/browser/resources/webui_browser/meridian/markdown.ts
new file mode 100644
index 0000000000..16bf8d8be8
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/markdown.ts
@@ -0,0 +1,87 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A small Markdown renderer for AI answers: paragraphs, headings, lists,
+// code blocks, and inline code, bold, italics and links. It builds Lit
+// templates (never innerHTML), so model output can't inject markup. Links
+// carry data-href and open in a new tab from the panel's click handler.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+import type {TemplateResult} from '//resources/lit/v3_0/lit.rollup.js';
+
+function inline(text: string): Array<TemplateResult|string> {
+  const out: Array<TemplateResult|string> = [];
+  const re = /`([^`]+)`|\*\*([^*]+)\*\*|\*([^*\s][^*]*)\*|\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g;
+  let last = 0;
+  for (let m = re.exec(text); m; m = re.exec(text)) {
+    if (m.index > last) {
+      out.push(text.slice(last, m.index));
+    }
+    if (m[1] !== undefined) {
+      out.push(html`<code>${m[1]}</code>`);
+    } else if (m[2] !== undefined) {
+      out.push(html`<b>${m[2]}</b>`);
+    } else if (m[3] !== undefined) {
+      out.push(html`<i>${m[3]}</i>`);
+    } else {
+      out.push(html`<a href="#" data-href="${m[5]}">${m[4]}</a>`);
+    }
+    last = m.index + m[0].length;
+  }
+  if (last < text.length) {
+    out.push(text.slice(last));
+  }
+  return out;
+}
+
+export function renderMarkdown(source: string): TemplateResult[] {
+  const lines = source.replace(/\r\n/g, '\n').split('\n');
+  const blocks: TemplateResult[] = [];
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i]!;
+    if (line.startsWith('```')) {
+      const code: string[] = [];
+      i++;
+      while (i < lines.length && !lines[i]!.startsWith('```')) {
+        code.push(lines[i]!);
+        i++;
+      }
+      i++;
+      blocks.push(html`<pre><code>${code.join('\n')}</code></pre>`);
+      continue;
+    }
+    const heading = /^(#{1,4})\s+(.*)$/.exec(line);
+    if (heading) {
+      blocks.push(html`<h4>${inline(heading[2]!)}</h4>`);
+      i++;
+      continue;
+    }
+    if (/^\s*([-*•]|\d+[.)])\s+/.test(line)) {
+      const ordered = /^\s*\d+[.)]\s+/.test(line);
+      const items: Array<Array<TemplateResult|string>> = [];
+      while (i < lines.length && /^\s*([-*•]|\d+[.)])\s+/.test(lines[i]!)) {
+        items.push(inline(lines[i]!.replace(/^\s*([-*•]|\d+[.)])\s+/, '')));
+        i++;
+      }
+      blocks.push(ordered ?
+                      html`<ol>${items.map(it => html`<li>${it}</li>`)}</ol>` :
+                      html`<ul>${items.map(it => html`<li>${it}</li>`)}</ul>`);
+      continue;
+    }
+    if (!line.trim()) {
+      i++;
+      continue;
+    }
+    const para: string[] = [];
+    while (i < lines.length && lines[i]!.trim() && !lines[i]!.startsWith('```') &&
+           !/^(#{1,4})\s/.test(lines[i]!) &&
+           !/^\s*([-*•]|\d+[.)])\s+/.test(lines[i]!)) {
+      para.push(lines[i]!);
+      i++;
+    }
+    blocks.push(html`<p>${inline(para.join('\n'))}</p>`);
+  }
+  return blocks;
+}
