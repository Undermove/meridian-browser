+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AI_AI_SERVICE_H_
+#define CHROME_BROWSER_MERIDIAN_AI_AI_SERVICE_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+class Profile;
+
+namespace network {
+class SimpleURLLoader;
+}
+
+namespace meridian {
+
+// The built-in AI (⌘J Ask panel, Ask in the command bar): Claude through the
+// person's own Anthropic API key. The key is encrypted at rest with
+// Chromium's OS-backed encryption (the macOS keychain) and never reaches web
+// content or the browser UI page.
+//
+// With agent access on (Settings > AI) the assistant can use the same browser
+// tools as MCP clients, through AgentService: the same access level,
+// confirmations and activity bar apply.
+class AiService : public KeyedService {
+ public:
+  // What a turn streams back: "text" (a delta), "tool" (a browser tool it
+  // uses), "done" or "error".
+  using EventCallback =
+      base::RepeatingCallback<void(const std::string& type,
+                                   const std::string& text)>;
+
+  struct Request {
+    std::string session_id;
+    std::string text;
+    // The page the person is looking at, as context.
+    std::string page_url;
+    std::string page_title;
+    std::string page_text;
+    // "chat" (the panel) or "ask" (a quick answer in the command bar).
+    std::string mode = "chat";
+    bool use_tools = false;
+  };
+
+  explicit AiService(Profile* profile);
+  AiService(const AiService&) = delete;
+  AiService& operator=(const AiService&) = delete;
+  ~AiService() override;
+
+  bool HasKey() const;
+  // Checks the key with a one-token request, then stores it (encrypted).
+  void SetKey(const std::string& key,
+              base::OnceCallback<void(bool ok, std::string error)> done);
+  void RemoveKey();
+
+  void Chat(Request request, EventCallback events);
+  void Stop(const std::string& session_id);
+  void Reset(const std::string& session_id);
+
+  base::WeakPtr<AiService> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+
+ private:
+  struct Session;
+  class Stream;
+
+  void WithKey(base::OnceCallback<void(std::optional<std::string>)> done);
+  void Step(const std::string& session_id, std::string key, int step);
+  void OnStreamDone(const std::string& session_id,
+                    std::string key,
+                    int step,
+                    base::ListValue content,
+                    std::string stop_reason,
+                    std::string error);
+  void RunTools(const std::string& session_id,
+                std::string key,
+                int step,
+                base::ListValue tool_uses);
+  std::unique_ptr<network::SimpleURLLoader> Post(const base::DictValue& body,
+                                                 const std::string& key);
+
+  raw_ptr<Profile> profile_;
+  std::map<std::string, std::unique_ptr<Session>> sessions_;
+  std::unique_ptr<network::SimpleURLLoader> key_check_;
+  base::WeakPtrFactory<AiService> weak_factory_{this};
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_AI_AI_SERVICE_H_
