+void SidebarHandler::HasAiKey(HasAiKeyCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  std::move(callback).Run(ai && ai->HasKey());
+}
+
+void SidebarHandler::SetAiKey(const std::string& key,
+                              SetAiKeyCallback callback) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!ai) {
+    std::move(callback).Run(false, "AI isn’t available in a private window.");
+    return;
+  }
+  ai->SetKey(key, base::BindOnce(
+                      [](SetAiKeyCallback callback, bool ok,
+                         std::string error) {
+                        std::move(callback).Run(ok, error);
+                      },
+                      std::move(callback)));
+}
+
+void SidebarHandler::RemoveAiKey() {
+  if (AiService* ai =
+          AiServiceFactory::GetForProfile(browser_->GetProfile())) {
+    ai->RemoveKey();
+  }
+}
+
+void SidebarHandler::AiChat(const std::string& session_id,
+                            const std::string& text,
+                            const std::string& mode,
+                            bool with_page) {
+  AiService* ai = AiServiceFactory::GetForProfile(browser_->GetProfile());
+  auto events = base::BindRepeating(
+      [](base::WeakPtr<SidebarHandler> self, std::string session_id,
+         const std::string& type, const std::string& text) {
+        if (self && self->page_.is_connected()) {
+          self->page_->OnAiEvent(session_id, type, text);
+        }
+      },
+      weak_factory_.GetWeakPtr(), session_id);
+  if (!ai) {
+    events.Run("error", "AI isn’t available in a private window.");
+    return;
+  }
+  AiService::Request request;
+  request.session_id = session_id;
+  request.text = text;
+  request.mode = mode == "ask" ? "ask" : "chat";
+  request.use_tools = true;
+  content::WebContents* contents = model()->GetActiveWebContents();
+  GURL url = contents ? contents->GetLastCommittedURL() : GURL();
+  if (!with_page || !contents || !url.SchemeIsHTTPOrHTTPS()) {
+    ai->Chat(std::move(request), events);
+    return;
+  }
+  AgentServiceFactory::GetForProfile(browser_->GetProfile())
+      ->ReadPageText(
+          contents,
+          base::BindOnce(
+              [](base::WeakPtr<AiService> ai, AiService::Request request,
+                 AiService::EventCallback events, base::Value page) {
+                if (!ai) {
+                  return;
+                }
+                if (const base::DictValue* p = page.GetIfDict()) {
+                  auto str = [&](const char* key) {
+                    const std::string* v = p->FindString(key);
+                    return v ? *v : std::string();
+                  };
+                  request.page_url = str("url");
+                  request.page_title = str("title");
+                  request.page_text = str("text");
+                }
+                ai->Chat(std::move(request), events);
+              },
+              ai->GetWeakPtr(), std::move(request), events));
+}
+
+void SidebarHandler::AiStop(const std::string& session_id) {
+  if (AiService* ai =
+          AiServiceFactory::GetForProfile(browser_->GetProfile())) {
+    ai->Stop(session_id);
+  }
+}
+
+void SidebarHandler::AiReset(const std::string& session_id) {
+  if (AiService* ai =
+          AiServiceFactory::GetForProfile(browser_->GetProfile())) {
+    ai->Reset(session_id);
+  }
+}
