+// Unanswered questions and tool calls without results would break the next
+// turn: back to the last complete answer.
+void Rewind(base::ListValue& messages) {
+  while (!messages.empty()) {
+    const base::DictValue& last = messages.back().GetDict();
+    bool user = *last.FindString("role") == "user";
+    bool calls_tools = false;
+    if (const base::ListValue* content = last.FindList("content")) {
+      for (const base::Value& block : *content) {
+        const std::string* type = block.GetDict().FindString("type");
+        calls_tools |= type && *type == "tool_use";
+      }
+    }
+    if (!user && !calls_tools) {
+      break;
+    }
+    messages.erase(messages.end() - 1);
+  }
+}
