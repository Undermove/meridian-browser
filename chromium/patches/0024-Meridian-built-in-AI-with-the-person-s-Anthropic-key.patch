+bool AiService::HasKey() const {
+  return !profile_->GetPrefs()->GetString(prefs::kAiKey).empty() ||
+         base::Environment::Create()->HasVar("ANTHROPIC_API_KEY");
+}
+
+void AiService::WithKey(
+    base::OnceCallback<void(std::optional<std::string>)> done) {
+  std::string sealed;
+  if (!base::Base64Decode(profile_->GetPrefs()->GetString(prefs::kAiKey),
+                          &sealed) ||
+      sealed.empty()) {
+    std::move(done).Run(
+        base::Environment::Create()->GetVar("ANTHROPIC_API_KEY"));
+    return;
+  }
+  g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+      [](base::OnceCallback<void(std::optional<std::string>)> done,
+         std::string sealed,
+         scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+        std::string key;
+        if (!encryptor || !encryptor->DecryptString(sealed, &key)) {
+          std::move(done).Run(std::nullopt);
+          return;
+        }
+        std::move(done).Run(key);
+      },
+      std::move(done), sealed));
+}
+
+std::unique_ptr<network::SimpleURLLoader> AiService::Post(
+    const base::DictValue& body,
+    const std::string& key) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(BaseUrl() + "/v1/messages");
+  request->method = "POST";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->headers.SetHeader("x-api-key", key);
+  request->headers.SetHeader("anthropic-version", kApiVersion);
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+  loader->AttachStringForUpload(base::WriteJson(body).value_or("{}"),
+                                "application/json");
+  loader->SetAllowHttpErrorResults(true);
+  return loader;
+}
+
+void AiService::SetKey(
+    const std::string& raw,
+    base::OnceCallback<void(bool ok, std::string error)> done) {
+  std::string key(base::TrimWhitespaceASCII(raw, base::TRIM_ALL));
+  if (!key.starts_with("sk-ant-") || key.size() < 27) {
+    std::move(done).Run(false,
+                        "That doesn’t look like an Anthropic API key. It "
+                        "starts with “sk-ant-”.");
+    return;
+  }
+  // One tiny request (a one-token reply).
+  base::ListValue messages;
+  messages.Append(base::DictValue().Set("role", "user").Set("content", "Hi"));
+  base::DictValue body;
+  body.Set("model", kQuickModel);
+  body.Set("max_tokens", 1);
+  body.Set("messages", std::move(messages));
+  key_check_ = Post(body, key);
+  key_check_->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(
+          [](base::WeakPtr<AiService> self, std::string key,
+             base::OnceCallback<void(bool, std::string)> done,
+             std::optional<std::string> body) {
+            if (!self) {
+              return;
+            }
+            const network::mojom::URLResponseHead* head =
+                self->key_check_->ResponseInfo();
+            int status =
+                head && head->headers ? head->headers->response_code() : 0;
+            self->key_check_.reset();
+            if (status != 200) {
+              std::move(done).Run(
+                  false, status ? Friendly(status, body.value_or(""))
+                                : "Couldn’t reach Anthropic. Check your "
+                                  "connection.");
+              return;
+            }
+            g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+                [](base::WeakPtr<AiService> self, std::string key,
+                   base::OnceCallback<void(bool, std::string)> done,
+                   scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+                  std::string sealed;
+                  if (!self || !encryptor ||
+                      !encryptor->EncryptString(key, &sealed)) {
+                    std::move(done).Run(
+                        false,
+                        "Meridian couldn’t reach your Mac’s keychain to store "
+                        "the key safely.");
+                    return;
+                  }
+                  self->profile_->GetPrefs()->SetString(
+                      prefs::kAiKey, base::Base64Encode(sealed));
+                  std::move(done).Run(true, std::string());
+                },
+                self, key, std::move(done)));
+          },
+          weak_factory_.GetWeakPtr(), key, std::move(done)),
+      64 * 1024);
+}
+
+void AiService::RemoveKey() {
+  profile_->GetPrefs()->ClearPref(prefs::kAiKey);
+}
+
+void AiService::Chat(Request request, EventCallback events) {
+  auto& session = sessions_[request.session_id];
+  if (!session) {
+    session = std::make_unique<Session>();
+  }
+  session->events = events;
+  session->mode = request.mode;
+  session->use_tools = request.use_tools && request.mode == "chat";
+  session->stopped = false;
+  base::ListValue content;
+  if (!request.page_text.empty()) {
+    std::string body = Neutralize(request.page_text);
+    if (body.size() > kPageCharLimit) {
+      body = body.substr(0, kPageCharLimit) +
+             "\n[Page text truncated: showing the first part only.]";
+    }
+    content.Append(base::DictValue()
+                       .Set("type", "text")
+                       .Set("text", "<current_page url=\"" +
+                                        Attr(request.page_url) + "\" title=\"" +
+                                        Attr(request.page_title) + "\">\n" +
+                                        body + "\n</current_page>"));
+  }
+  content.Append(
+      base::DictValue().Set("type", "text").Set("text", request.text));
+  session->messages.Append(base::DictValue()
+                               .Set("role", "user")
+                               .Set("content", std::move(content)));
+  std::string id = request.session_id;
+  WithKey(base::BindOnce(
+      [](base::WeakPtr<AiService> self, std::string id,
+         std::optional<std::string> key) {
+        if (!self || !self->sessions_.contains(id)) {
+          return;
+        }
+        if (!key || key->empty()) {
+          self->sessions_[id]->events.Run(
+              "error", "Add your Anthropic API key in Settings > AI.");
+          return;
+        }
+        self->Step(id, *key, 0);
+      },
+      weak_factory_.GetWeakPtr(), id));
+}
+
+void AiService::Step(const std::string& id, std::string key, int step) {
+  Session* session = sessions_[id].get();
+  bool quick = session->mode == "ask";
+  base::DictValue body;
+  body.Set("model", quick ? kQuickModel : kModel);
+  body.Set("max_tokens", quick ? 4000 : 64000);
+  body.Set("stream", true);
+  body.Set("system", quick ? kAskSystem : kSystem);
+  body.Set("messages", session->messages.Clone());
+  if (!quick) {
+    body.Set("output_config", base::DictValue().Set("effort", "medium"));
+  }
+  if (session->use_tools) {
+    PrefService* prefs = profile_->GetPrefs();
+    std::string access = prefs->GetString(prefs::kAgentAccess);
+    bool js = prefs->GetBoolean(prefs::kAgentAllowJs);
+    base::ListValue tools;
+    for (const base::Value& t : AgentService::Tools()) {
+      const base::DictValue& def = t.GetDict();
+      const std::string& needs = *def.FindString("access");
+      bool allowed = access != "off" &&
+                     (needs == "read" ||
+                      (needs == "write" && access != "read") ||
+                      (needs == "js" && js && access != "read"));
+      if (allowed) {
+        tools.Append(base::DictValue()
+                         .Set("name", *def.FindString("name"))
+                         .Set("description", *def.FindString("description"))
+                         .Set("input_schema",
+                              def.FindDict("input_schema")->Clone())
+                         .Set("eager_input_streaming", true));
+      }
+    }
+    if (!tools.empty()) {
+      body.Set("tools", std::move(tools));
+    }
+  }
+  session->stream = std::make_unique<Stream>(
+      Post(body, key),
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      session->events,
+      base::BindOnce(&AiService::OnStreamDone, weak_factory_.GetWeakPtr(), id,
+                     key, step));
+}
+
+void AiService::OnStreamDone(const std::string& id,
+                             std::string key,
+                             int step,
+                             base::ListValue content,
+                             std::string stop_reason,
+                             std::string error) {
+  auto it = sessions_.find(id);
+  if (it == sessions_.end()) {
+    return;
+  }
+  Session* session = it->second.get();
+  session->stream.reset();
+  if (session->stopped) {
+    return;
+  }
+  if (!error.empty()) {
+    // Nothing answered the question: forget it, so a retry starts clean.
+    Rewind(session->messages);
+    session->events.Run("error", error);
+    return;
+  }
+  base::ListValue tool_uses;
+  for (const base::Value& block : content) {
+    const std::string* type = block.GetDict().FindString("type");
+    if (type && *type == "tool_use") {
+      tool_uses.Append(block.Clone());
+    }
+  }
+  session->messages.Append(base::DictValue()
+                               .Set("role", "assistant")
+                               .Set("content", std::move(content)));
+  if (stop_reason == "tool_use" && !tool_uses.empty() && step < kMaxSteps) {
+    RunTools(id, key, step, std::move(tool_uses));
+    return;
+  }
+  if (stop_reason == "refusal") {
+    session->events.Run("error", "Claude declined this request.");
+    return;
+  }
+  if (stop_reason == "max_tokens") {
+    session->events.Run("text", "\n\n[The answer hit the length limit.]");
+  }
+  session->events.Run("done", std::string());
+}
+
+void AiService::RunTools(const std::string& id,
+                         std::string key,
+                         int step,
+                         base::ListValue tool_uses) {
+  // One at a time (each may ask the person); results go back together.
+  struct Runner {
+    static void Next(base::WeakPtr<AiService> self, std::string id,
+                     std::string key, int step, base::ListValue pending,
+                     base::ListValue results) {
+      if (!self || !self->sessions_.contains(id) ||
+          self->sessions_[id]->stopped) {
+        return;
+      }
+      if (pending.empty()) {
+        self->sessions_[id]->messages.Append(
+            base::DictValue()
+                .Set("role", "user")
+                .Set("content", std::move(results)));
+        self->Step(id, key, step + 1);
+        return;
+      }
+      base::DictValue use = std::move(pending.front()).TakeDict();
+      pending.erase(pending.begin());
+      std::string tool_id = *use.FindString("id");
+      base::DictValue request;
+      request.Set("tool", *use.FindString("name"));
+      request.Set("client", "Meridian AI");
+      base::DictValue* input = use.FindDict("input");
+      request.Set("input", input ? std::move(*input) : base::DictValue());
+      AgentServiceFactory::GetForProfile(self->profile_)
+          ->Handle(
+              std::move(request),
+              base::BindOnce(
+                  [](base::WeakPtr<AiService> self, std::string id,
+                     std::string key, int step, base::ListValue pending,
+                     base::ListValue results, std::string tool_id,
+                     base::DictValue response) {
+                    base::DictValue result;
+                    result.Set("type", "tool_result");
+                    result.Set("tool_use_id", tool_id);
+                    if (const std::string* error =
+                            response.FindString("error")) {
+                      result.Set("content", *error);
+                      result.Set("is_error", true);
+                    } else {
+                      base::Value* value = response.Find("result");
+                      const std::string* image =
+                          value && value->is_dict()
+                              ? value->GetDict().FindString("image")
+                              : nullptr;
+                      if (image) {
+                        base::ListValue parts;
+                        parts.Append(
+                            base::DictValue()
+                                .Set("type", "image")
+                                .Set("source",
+                                     base::DictValue()
+                                         .Set("type", "base64")
+                                         .Set("media_type", "image/jpeg")
+                                         .Set("data", *image)));
+                        result.Set("content", std::move(parts));
+                      } else {
+                        result.Set("content",
+                                   value ? base::WriteJson(*value).value_or("")
+                                         : std::string());
+                      }
+                    }
+                    results.Append(std::move(result));
+                    Next(self, id, key, step, std::move(pending),
+                         std::move(results));
+                  },
+                  self, id, key, step, std::move(pending), std::move(results),
+                  tool_id));
+    }
+  };
+  Runner::Next(weak_factory_.GetWeakPtr(), id, key, step,
+               std::move(tool_uses), base::ListValue());
+}
+
+void AiService::Stop(const std::string& id) {
+  auto it = sessions_.find(id);
+  if (it == sessions_.end()) {
+    return;
+  }
+  it->second->stopped = true;
+  it->second->stream.reset();
+  Rewind(it->second->messages);
+  it->second->events.Run("done", "stopped");
+}
+
+void AiService::Reset(const std::string& id) {
+  sessions_.erase(id);
+}
+
+}  // namespace meridian
