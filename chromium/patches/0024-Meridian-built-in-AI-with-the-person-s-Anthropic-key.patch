@@ -0,0 +1,55 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianAskElement} from './ask.js';
+import {icon} from './icons.js';
+
+export function getHtml(this: MeridianAskElement) {
+  return html`<!--_html_template_start_-->
+<div id="panel">
+  <div class="head">
+    <span class="title">${icon('sparkles', 15)} Ask</span>
+    <div class="grow"></div>
+    <button id="new" class="icon-btn" title="New chat"
+        @click="${this.onNewClick_}">${icon('plus', 15)}</button>
+    <button id="close" class="icon-btn" title="Close (⌘J)"
+        @click="${this.onCloseClick_}">${icon('x', 15)}</button>
+  </div>
+  <div id="log" @click="${this.onLogClick_}">
+    ${!this.hasKey_ ? html`
+      <div class="empty">
+        <p>Ask Claude about the page you're on, or ask it to do things in the
+          browser.</p>
+        <button id="addKey" class="btn" @click="${this.onSettingsClick_}">
+          Add your Anthropic API key</button>
+      </div>` : ''}
+    ${this.rendered_.map(m => html`
+      <div class="msg ${m.role}">
+        ${m.role === 'user' ? html`<div class="bubble">${m.text}</div>` : html`
+          ${m.tools ? html`<div class="tools">${icon('globe', 12)} ${m.tools}
+            </div>` : ''}
+          <div class="answer">${m.body}</div>
+          ${m.error ? html`<div class="error">${m.error}</div>` : ''}`}
+      </div>`)}
+  </div>
+  <div class="compose">
+    <textarea id="input" rows="2" placeholder="Ask about this page…"
+        @keydown="${this.onInputKeydown_}"></textarea>
+    <div class="row">
+      <label class="check"><input type="checkbox" id="withPage"
+          .checked="${this.withPage_}" @change="${this.onWithPageChange_}">
+        Use this page</label>
+      <div class="grow"></div>
+      ${this.busy_ ? html`
+        <button id="stop" class="btn" @click="${this.onStopClick_}">Stop
+        </button>` : html`
+        <button id="send" class="btn primary" @click="${this.onSendClick_}">
+          Send</button>`}
+    </div>
+  </div>
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/ask.ts b/chrome/browser/resources/webui_browser/meridian/ask.ts
new file mode 100644
index 0000000000..cb79105ce7
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/ask.ts
@@ -0,0 +1,206 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The Ask panel (⌘J): a chat with Claude beside the page, about the page.
+// With agent access on, Claude can also use the browser (same rules as MCP).
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues, TemplateResult} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {SidebarHandlerInterface} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './ask.css.js';
+import {getHtml} from './ask.html.js';
+import {renderMarkdown} from './markdown.js';
+
+export interface Message {
+  role: 'user'|'assistant';
+  text: string;
+  tools: string[];
+  error: string;
+}
+
+export interface RenderedMessage {
+  role: 'user'|'assistant';
+  text: string;
+  body: TemplateResult[];
+  tools: string;
+  error: string;
+}
+
+export class MeridianAskElement extends CrLitElement {
+  static get is() {
+    return 'meridian-ask';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      messages_: {state: true, type: Array},
+      rendered_: {state: true, type: Array},
+      busy_: {state: true, type: Boolean},
+      withPage_: {state: true, type: Boolean},
+      hasKey_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  protected accessor messages_: Message[] = [];
+  protected accessor rendered_: RenderedMessage[] = [];
+  protected accessor busy_: boolean = false;
+  protected accessor withPage_: boolean = true;
+  protected accessor hasKey_: boolean = true;
+
+  private readonly handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  private sessionId_: string = crypto.randomUUID();
+  private listenerId_: number|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.listenerId_ =
+        browserProxyFactory.getInstance().callbackRouter.onAiEvent.addListener(
+            (session: string, type: string, text: string) =>
+                session === this.sessionId_ && this.onEvent_(type, text));
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    if (this.listenerId_ !== null) {
+      browserProxyFactory.getInstance().callbackRouter.removeListener(
+          this.listenerId_);
+    }
+  }
+
+  async toggle() {
+    this.open = !this.open;
+    if (this.open) {
+      this.hasKey_ = (await this.handler_.hasAiKey()).hasKey;
+      await this.updateComplete;
+      this.shadowRoot.querySelector<HTMLTextAreaElement>('#input')?.focus();
+    }
+  }
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    if (changed.has('messages_' as keyof MeridianAskElement)) {
+      this.rendered_ = this.messages_.map(m => ({
+                                            role: m.role,
+                                            text: m.text,
+                                            body: m.role === 'assistant' ?
+                                                renderMarkdown(m.text) :
+                                                [],
+                                            tools: m.tools.join(', ')
+                                                       .replace(/_/g, ' '),
+                                            error: m.error,
+                                          }));
+    }
+  }
+
+  override updated(changed: PropertyValues<this>) {
+    super.updated(changed);
+    if (changed.has('messages_' as keyof MeridianAskElement)) {
+      const log = this.shadowRoot.querySelector('#log');
+      log?.scrollTo({top: log.scrollHeight});
+    }
+  }
+
+  private onEvent_(type: string, text: string) {
+    const messages = [...this.messages_];
+    const last = messages[messages.length - 1];
+    if (!last || last.role !== 'assistant') {
+      return;
+    }
+    const updated = {...last, tools: [...last.tools]};
+    if (type === 'text') {
+      updated.text += text;
+    } else if (type === 'tool') {
+      updated.tools.push(text);
+    } else if (type === 'error') {
+      updated.error = text;
+      this.busy_ = false;
+    } else if (type === 'done') {
+      this.busy_ = false;
+    }
+    messages[messages.length - 1] = updated;
+    this.messages_ = messages;
+  }
+
+  private send_() {
+    const input = this.shadowRoot.querySelector<HTMLTextAreaElement>('#input');
+    const text = input?.value.trim() || '';
+    if (!text || this.busy_) {
+      return;
+    }
+    input!.value = '';
+    this.messages_ = [
+      ...this.messages_,
+      {role: 'user', text, tools: [], error: ''},
+      {role: 'assistant', text: '', tools: [], error: ''},
+    ];
+    this.busy_ = true;
+    this.handler_.aiChat(this.sessionId_, text, 'chat', this.withPage_);
+  }
+
+  protected onInputKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
+      e.preventDefault();
+      this.send_();
+    } else if (e.key === 'Escape') {
+      this.open = false;
+    }
+  }
+
+  protected onSendClick_() {
+    this.send_();
+  }
+
+  protected onStopClick_() {
+    this.handler_.aiStop(this.sessionId_);
+  }
+
+  protected onNewClick_() {
+    this.handler_.aiReset(this.sessionId_);
+    this.sessionId_ = crypto.randomUUID();
+    this.messages_ = [];
+    this.busy_ = false;
+  }
+
+  protected onCloseClick_() {
+    this.open = false;
+  }
+
+  protected onWithPageChange_(e: Event) {
+    this.withPage_ = (e.target as HTMLInputElement).checked;
+  }
+
+  protected onSettingsClick_() {
+    this.fire('meridian-show-settings', 'ai');
+  }
+
+  protected onLogClick_(e: Event) {
+    const link = (e.target as HTMLElement).closest<HTMLElement>('a[data-href]');
+    if (link) {
+      e.preventDefault();
+      this.fire('meridian-open-url', link.dataset['href']);
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-ask': MeridianAskElement;
+  }
+}
+
+customElements.define(MeridianAskElement.is, MeridianAskElement);
