+// One streamed Messages API response (server-sent events): text deltas go
+// out as they come; the whole content (thinking, text, tool_use blocks,
+// untouched) is kept for the next turn.
+class AiService::Stream : public network::SimpleURLLoaderStreamConsumer {
+ public:
+  using Done = base::OnceCallback<void(base::ListValue content,
+                                       std::string stop_reason,
+                                       std::string error)>;
+
+  Stream(std::unique_ptr<network::SimpleURLLoader> loader,
+         network::mojom::URLLoaderFactory* factory,
+         EventCallback events,
+         Done done)
+      : loader_(std::move(loader)),
+        events_(std::move(events)),
+        done_(std::move(done)) {
+    loader_->SetOnResponseStartedCallback(base::BindOnce(
+        [](Stream* self, const GURL&,
+           const network::mojom::URLResponseHead& head) {
+          self->status_ = head.headers ? head.headers->response_code() : 0;
+        },
+        base::Unretained(this)));
+    loader_->DownloadAsStream(factory, this);
+  }
+
+  void OnDataReceived(std::string_view data,
+                      base::OnceClosure resume) override {
+    buffer_.append(data);
+    // An error answer is plain JSON; it stays whole for OnComplete.
+    if (status_ == 200) {
+      size_t newline;
+      while ((newline = buffer_.find('\n')) != std::string::npos) {
+        std::string line = buffer_.substr(0, newline);
+        buffer_.erase(0, newline + 1);
+        if (line.starts_with("data: ")) {
+          HandleEvent(line.substr(6));
+        }
+      }
+    }
+    std::move(resume).Run();
+  }
+
+  void OnComplete(bool success) override {
+    int status = status_;
+    std::string error = error_;
+    if (status != 200) {
+      error = status ? Friendly(status, buffer_)
+                     : "Couldn’t reach Anthropic. Check your connection.";
+    } else if (!success && error.empty()) {
+      error = "The connection to Anthropic broke off.";
+    }
+    base::ListValue content;
+    for (auto& [index, block] : blocks_) {
+      content.Append(std::move(block));
+    }
+    std::move(done_).Run(std::move(content), stop_reason_, error);
+  }
+
+  void OnRetry(base::OnceClosure start_retry) override {}
+
+ private:
+  void HandleEvent(const std::string& json) {
+    std::optional<base::Value> parsed = base::JSONReader::Read(json, 0);
+    if (!parsed || !parsed->is_dict()) {
+      return;
+    }
+    base::DictValue& event = parsed->GetDict();
+    const std::string* type = event.FindString("type");
+    if (!type) {
+      return;
+    }
+    int index = event.FindInt("index").value_or(0);
+    if (*type == "content_block_start") {
+      if (base::DictValue* block = event.FindDict("content_block")) {
+        blocks_[index] = std::move(*block);
+        if (const std::string* t = blocks_[index].FindString("type");
+            t && *t == "tool_use") {
+          events_.Run("tool", *blocks_[index].FindString("name"));
+        }
+      }
+    } else if (*type == "content_block_delta") {
+      base::DictValue* delta = event.FindDict("delta");
+      auto it = blocks_.find(index);
+      if (!delta || it == blocks_.end()) {
+        return;
+      }
+      const std::string* dt = delta->FindString("type");
+      auto append = [&](const char* key, const char* from) {
+        const std::string* piece = delta->FindString(from);
+        if (piece) {
+          const std::string* now = it->second.FindString(key);
+          it->second.Set(key, (now ? *now : std::string()) + *piece);
+        }
+        return piece;
+      };
+      if (dt && *dt == "text_delta") {
+        if (const std::string* piece = append("text", "text")) {
+          events_.Run("text", *piece);
+        }
+      } else if (dt && *dt == "thinking_delta") {
+        append("thinking", "thinking");
+      } else if (dt && *dt == "signature_delta") {
+        append("signature", "signature");
+      } else if (dt && *dt == "input_json_delta") {
+        if (const std::string* piece = delta->FindString("partial_json")) {
+          partial_[index] += *piece;
+        }
+      }
+    } else if (*type == "content_block_stop") {
+      auto it = blocks_.find(index);
+      if (it != blocks_.end() && partial_.contains(index)) {
+        std::optional<base::Value> input =
+            base::JSONReader::Read(partial_[index], 0);
+        it->second.Set("input", input && input->is_dict()
+                                    ? std::move(*input)
+                                    : base::Value(base::DictValue()));
+      }
+    } else if (*type == "message_delta") {
+      if (const std::string* reason =
+              event.FindStringByDottedPath("delta.stop_reason")) {
+        stop_reason_ = *reason;
+      }
+    } else if (*type == "error") {
+      const std::string* message = event.FindStringByDottedPath("error.message");
+      error_ = message ? *message : "Claude stopped with an error.";
+    }
+  }
+
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  EventCallback events_;
+  Done done_;
+  std::string buffer_;
+  int status_ = 0;
+  std::map<int, base::DictValue> blocks_;
+  std::map<int, std::string> partial_;
+  std::string stop_reason_;
+  std::string error_;
+};
