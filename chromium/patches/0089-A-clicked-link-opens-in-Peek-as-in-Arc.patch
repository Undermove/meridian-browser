Chrome opens it in a new window; in a window that holds space tabs it now
opens as a Peek over the page.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/space_profiles.cc       |  6 ++++++
 chrome/browser/meridian/space_profiles.h        |  4 ++++
 .../browser/ui/navigator/browser_navigator.cc   | 17 ++++++++++++++++-
 3 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/meridian/space_profiles.cc b/chrome/browser/meridian/space_profiles.cc
index 3a7e949f34..dd2fae6cb3 100644
--- a/chrome/browser/meridian/space_profiles.cc
+++ b/chrome/browser/meridian/space_profiles.cc
@@ -157,6 +157,12 @@ bool HoldsSpaceTabs(BrowserWindowInterface* browser) {
          !IsSpaceProfile(browser->GetProfile());
 }
 
+bool LinkOpensInPeek(content::WebContents* source) {
+  tabs::TabInterface* tab =
+      source ? tabs::TabInterface::MaybeGetFromContents(source) : nullptr;
+  return tab && HoldsSpaceTabs(tab->GetBrowserWindowInterface());
+}
+
 Profile* ProfileForNewTab(BrowserWindowInterface* browser, Profile* source) {
   Profile* own = browser->GetProfile();
   if (!HoldsSpaceTabs(browser)) {
diff --git a/chrome/browser/meridian/space_profiles.h b/chrome/browser/meridian/space_profiles.h
index dd949ee851..69d837cadd 100644
--- a/chrome/browser/meridian/space_profiles.h
+++ b/chrome/browser/meridian/space_profiles.h
@@ -50,6 +50,10 @@ void PreloadSpaceProfiles(Profile* main);
 // Whether `browser` holds tabs of every profile: a normal window of the main
 // profile, not a Little Window or a private one.
 bool HoldsSpaceTabs(BrowserWindowInterface* browser);
+// Whether a link ⇧-clicked in `source` opens in Peek over it (Arc) rather
+// than in a new window: a tab of a window that holds space tabs.
+bool LinkOpensInPeek(content::WebContents* source);
+
 // The profile for a new tab in `browser`: the profile of `source` (the page it
 // is opened from) if it has one, else the active space's. The browser's own
 // for any other window.
diff --git a/chrome/browser/ui/navigator/browser_navigator.cc b/chrome/browser/ui/navigator/browser_navigator.cc
index 5efeccb762..105d396433 100644
--- a/chrome/browser/ui/navigator/browser_navigator.cc
+++ b/chrome/browser/ui/navigator/browser_navigator.cc
@@ -5,6 +5,7 @@
 #include "chrome/browser/ui/navigator/browser_navigator.h"
 
 #include "chrome/browser/meridian/space_profiles.h"
+#include "chrome/browser/meridian/tab_data.h"
 
 #include <algorithm>
 #include <memory>
@@ -1250,8 +1251,22 @@ base::WeakPtr<content::NavigationHandle> ShowTabModalPopup(
 }  // namespace internal
 
 base::WeakPtr<content::NavigationHandle> Navigate(NavigateParams* params) {
+  // Meridian: a ⇧-clicked link opens in Peek over the page, as in Arc, not in
+  // a new window.
+  const bool peek =
+      params->disposition == WindowOpenDisposition::kNewWindow &&
+      params->is_renderer_initiated &&
+      meridian::LinkOpensInPeek(params->source_contents);
+  if (peek) {
+    params->disposition = WindowOpenDisposition::kNewForegroundTab;
+  }
   AdditionalParams additional_params;
-  return internal::NavigateImpl(params, additional_params);
+  base::WeakPtr<content::NavigationHandle> handle =
+      internal::NavigateImpl(params, additional_params);
+  if (peek && params->navigated_or_inserted_contents) {
+    meridian::TabData::SetPeek(params->navigated_or_inserted_contents, true);
+  }
+  return handle;
 }
 
 void Navigate(NavigateParams* params,
