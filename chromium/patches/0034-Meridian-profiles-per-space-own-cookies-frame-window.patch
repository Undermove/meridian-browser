+void SidebarHandler::AddProfile(const std::string& name,
+                                AddProfileCallback callback) {
+  std::vector<std::string> taken;
+  for (const ProfileInfo& p : service_->profiles()) {
+    taken.push_back(p.id);
+  }
+  std::string id = NewProfileId(taken);
+  std::string clean(base::TrimWhitespaceASCII(name, base::TRIM_ALL));
+  if (!service_->AddProfile(id, clean.substr(0, 60))) {
+    return std::move(callback).Run(std::string());
+  }
+  // Meridian has no profile picker: never Chromium's at startup either.
+  g_browser_process->local_state()->SetBoolean(
+      ::prefs::kBrowserShowProfilePickerOnStartup, false);
+  std::move(callback).Run(id);
+}
