+void SidebarHandler::SetSpaceProfile(const std::string& space_id,
+                                     const std::string& profile_id) {
+  const Space* space = service_->FindSpace(space_id);
+  if (!space || space->profile == profile_id ||
+      !service_->FindProfile(profile_id) || IsLittleWindow(browser_) ||
+      browser_->GetProfile()->IsOffTheRecord()) {
+    return;
+  }
+  // Its open tabs, in every window: they reopen in the new profile.
+  std::vector<GURL> urls;
+  std::vector<base::WeakPtr<content::WebContents>> old;
+  for (auto& [window, handler] : Handlers()) {
+    if (handler->service_ != service_) {
+      continue;
+    }
+    TabStripModel* tabs = window->GetTabStripModel();
+    for (int i = 0; i < tabs->count(); ++i) {
+      content::WebContents* contents = tabs->GetWebContentsAt(i);
+      const TabData* data = TabData::Get(contents);
+      if (data && data->space_id() == space_id) {
+        if (data->item_id().empty() &&
+            contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+          urls.push_back(contents->GetLastCommittedURL());
+        }
+        old.push_back(contents->GetWeakPtr());
+      }
+    }
+  }
+  bool active = service_->active_space_id() == space_id;
+  service_->SetSpaceProfile(space_id, profile_id);
+  // The tabs close once the new window has its own (a window losing its last
+  // tab would close).
+  ShowSpaceInProfile(
+      browser_, profile_id, space_id, std::move(urls), /*show=*/active,
+      base::BindOnce(
+          [](std::vector<base::WeakPtr<content::WebContents>> old,
+             BrowserWindowInterface*) {
+            for (const auto& contents : old) {
+              if (contents) {
+                contents->ClosePage();
+              }
+            }
+          },
+          std::move(old)));
+}
