+  service_->RenameProfile(profile_id, clean.substr(0, 60));
+}
+
+void SidebarHandler::DeleteProfile(const std::string& profile_id,
+                                   DeleteProfileCallback callback) {
+  if (!service_->RemoveProfile(profile_id)) {
+    return std::move(callback).Run(false);
+  }
+  base::FilePath path = ProfilePathFor(profile_id);
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+          path)) {
+    manager->GetDeleteProfileHelper().MaybeScheduleProfileForDeletion(
+        path, base::DoNothing(), ProfileMetrics::DELETE_PROFILE_SETTINGS);
+  }
+  std::move(callback).Run(true);
+}
+
+void SidebarHandler::ClearProfileData(const std::string& profile_id,
+                                      ClearProfileDataCallback callback) {
+  if (!service_->FindProfile(profile_id)) {
+    return std::move(callback).Run(false);
+  }
+  Profile* profile = g_browser_process->profile_manager()->GetProfileByPath(
+      ProfilePathFor(profile_id));
+  if (!profile) {
+    // Not loaded since Meridian started: load it to clear it.
+    g_browser_process->profile_manager()->CreateProfileAsync(
+        ProfilePathFor(profile_id),
+        base::BindOnce(
+            [](ClearProfileDataCallback callback, Profile* profile) {
+              if (profile) {
+                profile->GetBrowsingDataRemover()->Remove(
+                    base::Time(), base::Time::Max(),
+                    chrome_browsing_data_remover::ALL_DATA_TYPES,
+                    chrome_browsing_data_remover::ALL_ORIGIN_TYPES);
+              }
+              std::move(callback).Run(!!profile);
+            },
+            std::move(callback)));
+    return;
+  }
+  profile->GetBrowsingDataRemover()->Remove(
+      base::Time(), base::Time::Max(),
+      chrome_browsing_data_remover::ALL_DATA_TYPES,
+      chrome_browsing_data_remover::ALL_ORIGIN_TYPES);
+  std::move(callback).Run(true);
+}
