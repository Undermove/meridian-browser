@@ -0,0 +1,59 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_DOWNLOADS_TRACKER_H_
+#define CHROME_BROWSER_MERIDIAN_DOWNLOADS_TRACKER_H_
+
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/meridian/sidebar.mojom.h"
+#include "components/download/content/public/all_download_item_notifier.h"
+
+class Profile;
+
+namespace meridian {
+
+// The sidebar's Downloads popover (⇧⌘J): this session's downloads of a
+// profile, newest first, with what can be done to each (show in Finder,
+// open, cancel, keep or discard a dangerous one). `changed` runs on every
+// change, progress included.
+class DownloadsTracker : public download::AllDownloadItemNotifier::Observer {
+ public:
+  DownloadsTracker(Profile* profile, base::RepeatingClosure changed);
+  DownloadsTracker(const DownloadsTracker&) = delete;
+  DownloadsTracker& operator=(const DownloadsTracker&) = delete;
+  ~DownloadsTracker() override;
+
+  std::vector<mojom::DownloadPtr> List();
+  // "reveal", "open", "cancel", "keep" (a dangerous file) or "discard".
+  void Act(const std::string& id, const std::string& action);
+  // Forgets the finished ones (the files stay).
+  void Clear();
+  bool AnyInProgress();
+
+  // download::AllDownloadItemNotifier::Observer:
+  void OnDownloadCreated(content::DownloadManager* manager,
+                         download::DownloadItem* item) override;
+  void OnDownloadUpdated(content::DownloadManager* manager,
+                         download::DownloadItem* item) override;
+  void OnDownloadRemoved(content::DownloadManager* manager,
+                         download::DownloadItem* item) override;
+
+ private:
+  download::DownloadItem* Find(const std::string& id);
+
+  raw_ptr<Profile> profile_;
+  base::RepeatingClosure changed_;
+  // Newest first.
+  std::vector<std::string> ids_;
+  download::AllDownloadItemNotifier notifier_;
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_DOWNLOADS_TRACKER_H_
