+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_PROFILE_WINDOWS_H_
+#define CHROME_BROWSER_MERIDIAN_PROFILE_WINDOWS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace meridian {
+
+// Spaces with their own profile, Arc's model on Chromium: every Meridian
+// profile is a Chromium profile ("Meridian Profile N" next to the main one),
+// and a Meridian window is a frame of one browser window per profile, stacked
+// in the same place. Switching to a space of another profile shows that
+// profile's window where the current one was and hides the current one;
+// closing the visible window closes the hidden ones of its frame. The sidebar
+// model is the main profile's (SidebarServiceFactory).
+
+// "" for the main profile (or any profile Meridian didn't create), else the
+// profile's folder name.
+std::string ProfileIdOf(Profile* profile);
+bool IsSpaceProfile(Profile* profile);
+// The folder of a Meridian profile id.
+base::FilePath ProfilePathFor(const std::string& profile_id);
+// The main profile, loaded if it isn't yet (blocking then).
+Profile* MainProfileFor(Profile* profile);
+// A folder name for a new profile, unused on disk and in `taken`.
+std::string NewProfileId(const std::vector<std::string>& taken);
+
+// Shows `space_id` (of `profile_id`) in the frame of `from`: activates the
+// space in that profile's window, creating the window at `from`'s place if
+// needed, and opens `urls` there as tabs of the space. With `show` false the
+// frame stays as it is (the tabs open in the hidden window). `done` gets the
+// window, or nullptr if the profile couldn't be loaded.
+void ShowSpaceInProfile(
+    BrowserWindowInterface* from,
+    const std::string& profile_id,
+    const std::string& space_id,
+    std::vector<GURL> urls,
+    bool show,
+    base::OnceCallback<void(BrowserWindowInterface*)> done = {});
+
+// Whether `browser` is a hidden window of a frame.
+bool IsHiddenInFrame(BrowserWindowInterface* browser);
+// After a restart the windows of a frame come back as separate windows:
+// `browser`, of a profile other than the active space's, joins (hidden) the
+// frame of a visible window of that profile, if there is one.
+void JoinFrameIfBehind(BrowserWindowInterface* browser,
+                       const std::string& active_profile_id);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_PROFILE_WINDOWS_H_
