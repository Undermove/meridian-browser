+    EXPECT_FALSE(service.RemoveProfile("Meridian Profile 1")) << "a space uses it";
+    EXPECT_FALSE(service.RemoveProfile("")) << "never the main one";
+    service.FlushForTesting();
+    env_.RunUntilIdle();
+  }
+  SidebarService again(dir.GetPath());
+  env_.RunUntilIdle();
