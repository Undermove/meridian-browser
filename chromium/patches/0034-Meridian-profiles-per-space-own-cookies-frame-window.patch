diff --git a/chrome/browser/meridian/profile_windows.cc b/chrome/browser/meridian/profile_windows.cc
new file mode 100644
index 0000000000..9d3e496512
--- /dev/null
+++ b/chrome/browser/meridian/profile_windows.cc
@@ -0,0 +1,283 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/profile_windows.h"
+
+#include <map>
+#include <set>
+
+#include "base/files/file_util.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/meridian/little_window.h"
+#include "chrome/browser/meridian/sidebar_handler.h"
+#include "chrome/browser/meridian/sidebar_service.h"
+#include "chrome/browser/meridian/sidebar_service_factory.h"
+#include "chrome/browser/meridian/tab_data.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/browser_window/public/create_browser_window.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "ui/base/base_window.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr char kPrefix[] = "Meridian Profile ";
+
+struct Frames {
+  int next = 1;
+  std::map<BrowserWindowInterface*, int> frame_of;
+  std::map<int, BrowserWindowInterface*> visible_of;
+  std::map<BrowserWindowInterface*, base::CallbackListSubscription> closing;
+};
+
+Frames& F() {
+  static base::NoDestructor<Frames> frames;
+  return *frames;
+}
+
+void OnClosed(BrowserWindowInterface* browser) {
+  Frames& f = F();
+  f.closing.erase(browser);
+  auto it = f.frame_of.find(browser);
+  if (it == f.frame_of.end()) {
+    return;
+  }
+  int id = it->second;
+  f.frame_of.erase(it);
+  if (f.visible_of[id] != browser) {
+    return;
+  }
+  f.visible_of.erase(id);
+  // The frame closes with its visible window.
+  std::vector<BrowserWindowInterface*> hidden;
+  for (auto& [b, frame] : f.frame_of) {
+    if (frame == id) {
+      hidden.push_back(b);
+    }
+  }
+  for (BrowserWindowInterface* b : hidden) {
+    f.frame_of.erase(b);
+    b->GetWindow()->Close();
+  }
+}
+
+void Track(BrowserWindowInterface* browser, int frame) {
+  Frames& f = F();
+  f.frame_of[browser] = frame;
+  if (!f.closing.contains(browser)) {
+    f.closing[browser] =
+        browser->RegisterBrowserDidClose(base::BindRepeating(&OnClosed));
+  }
+}
+
+// The frame of `browser`, a new one (with it visible) if it has none.
+int FrameOf(BrowserWindowInterface* browser) {
+  Frames& f = F();
+  auto it = f.frame_of.find(browser);
+  if (it != f.frame_of.end()) {
+    return it->second;
+  }
+  int id = f.next++;
+  Track(browser, id);
+  f.visible_of[id] = browser;
+  return id;
+}
+
+bool IsMainWindow(BrowserWindowInterface* b) {
+  return b->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         !IsLittleWindow(b) && !b->GetProfile()->IsOffTheRecord();
+}
+
+void Open(BrowserWindowInterface* target,
+          const std::string& space_id,
+          const std::vector<GURL>& urls) {
+  TabStripModel* model = target->GetTabStripModel();
+  bool has_tab = false;
+  for (int i = 0; i < model->count(); ++i) {
+    const TabData* data = TabData::Get(model->GetWebContentsAt(i));
+    has_tab |= data && data->space_id() == space_id;
+  }
+  std::vector<GURL> open = urls;
+  if (open.empty() && !has_tab) {
+    open.push_back(GURL("chrome://newtab/"));  // an empty space, like Arc
+  }
+  for (const GURL& url : open) {
+    NavigateParams nav(target, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+    nav.disposition = WindowOpenDisposition::kNewForegroundTab;
+    Navigate(&nav);
+    if (nav.navigated_or_inserted_contents) {
+      TabData::Set(nav.navigated_or_inserted_contents, space_id,
+                   std::string());
+    }
+  }
+}
+
+}  // namespace
+
+std::string ProfileIdOf(Profile* profile) {
+  std::string base = profile->GetOriginalProfile()->GetPath().BaseName().value();
+  return base.starts_with(kPrefix) ? base : std::string();
+}
+
+bool IsSpaceProfile(Profile* profile) {
+  return !ProfileIdOf(profile).empty();
+}
+
+base::FilePath ProfilePathFor(const std::string& profile_id) {
+  const base::FilePath& dir = g_browser_process->profile_manager()->user_data_dir();
+  return profile_id.empty()
+             ? dir.Append(ProfileManager::GetInitialProfileDir())
+             : dir.Append(profile_id);
+}
+
+Profile* MainProfileFor(Profile* profile) {
+  if (!IsSpaceProfile(profile)) {
+    return profile;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  base::FilePath main = ProfilePathFor(std::string());
+  if (Profile* loaded = manager->GetProfileByPath(main)) {
+    return loaded;
+  }
+  // Only after a restart with just another profile's windows open (loads
+  // synchronously; ProfileImpl allows its own blocking).
+  return manager->GetProfile(main);
+}
+
+std::string NewProfileId(const std::vector<std::string>& taken) {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  ProfileAttributesStorage& known = manager->GetProfileAttributesStorage();
+  for (int n = 1;; ++n) {
+    std::string id = kPrefix + base::NumberToString(n);
+    if (std::ranges::find(taken, id) == taken.end() &&
+        !known.GetProfileAttributesWithPath(
+            manager->user_data_dir().Append(id))) {
+      return id;
+    }
+  }
+}
+
+void ShowSpaceInProfile(
+    BrowserWindowInterface* from,
+    const std::string& profile_id,
+    const std::string& space_id,
+    std::vector<GURL> urls,
+    bool show,
+    base::OnceCallback<void(BrowserWindowInterface*)> done) {
+  int frame = FrameOf(from);
+  g_browser_process->profile_manager()->CreateProfileAsync(
+      ProfilePathFor(profile_id),
+      base::BindOnce(
+          [](int frame, std::string space_id, std::vector<GURL> urls,
+             bool show, base::OnceCallback<void(BrowserWindowInterface*)> done,
+             Profile* profile) {
+            Frames& f = F();
+            auto visible = f.visible_of.find(frame);
+            if (!profile || visible == f.visible_of.end()) {
+              if (done) {
+                std::move(done).Run(nullptr);
+              }
+              return;
+            }
+            BrowserWindowInterface* current = visible->second;
+            BrowserWindowInterface* target = nullptr;
+            for (auto& [b, id] : f.frame_of) {
+              if (id == frame && b->GetProfile() == profile) {
+                target = b;
+              }
+            }
+            if (!target) {
+              BrowserWindowCreateParams params(*profile,
+                                               /*from_user_gesture=*/true);
+              params.initial_bounds = current->GetWindow()->GetBounds();
+              params.initial_origin_specified =
+                  BrowserWindowCreateParams::ValueSpecified::kSpecified;
+              params.should_trigger_session_restore = false;
+              target = CreateBrowserWindow(std::move(params));
+              if (!target) {
+                if (done) {
+                  std::move(done).Run(nullptr);
+                }
+                return;
+              }
+              Track(target, frame);
+            }
+            SidebarService* service =
+                SidebarServiceFactory::GetForProfile(profile);
+            if (show) {
+              service->SetActiveSpace(space_id);
+            }
+            Open(target, space_id, urls);
+            if (show && target != current) {
+              target->GetWindow()->SetBounds(current->GetWindow()->GetBounds());
+              f.visible_of[frame] = target;
+              target->GetWindow()->Show();
+              target->GetWindow()->Activate();
+              current->GetWindow()->Hide();
+            }
+            if (show) {
+              SidebarHandler::ActivateSpaceInWindow(target, space_id);
+            }
+            if (done) {
+              std::move(done).Run(target);
+            }
+          },
+          frame, space_id, std::move(urls), show, std::move(done)));
+}
+
+bool IsHiddenInFrame(BrowserWindowInterface* browser) {
+  Frames& f = F();
+  auto it = f.frame_of.find(browser);
+  return it != f.frame_of.end() && f.visible_of[it->second] != browser;
+}
+
+void JoinFrameIfBehind(BrowserWindowInterface* browser,
+                       const std::string& active_profile_id) {
+  Frames& f = F();
+  if (!IsMainWindow(browser) || f.frame_of.contains(browser)) {
+    return;
+  }
+  bool active = ProfileIdOf(browser->GetProfile()) == active_profile_id;
+  std::vector<BrowserWindowInterface*> others;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* b) {
+        if (b != browser && IsMainWindow(b) &&
+            b->GetProfile() != browser->GetProfile()) {
+          others.push_back(b);
+        }
+        return true;
+      });
+  if (!active) {
+    // Behind a visible window of the active space's profile.
+    for (BrowserWindowInterface* b : others) {
+      if (ProfileIdOf(b->GetProfile()) == active_profile_id &&
+          !IsHiddenInFrame(b)) {
+        Track(browser, FrameOf(b));
+        browser->GetWindow()->Hide();
+        return;
+      }
+    }
+    return;
+  }
+  // The other profiles' separate windows go behind this one.
+  int frame = FrameOf(browser);
+  for (BrowserWindowInterface* b : others) {
+    if (!f.frame_of.contains(b)) {
+      Track(b, frame);
+      b->GetWindow()->Hide();
+    }
+  }
+}
+
+}  // namespace meridian
