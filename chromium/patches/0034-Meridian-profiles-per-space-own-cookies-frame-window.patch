+// "4.2 MB of 10 MB", "820 KB".
+function formatBytes(bytes: number): string {
+  const units = ['B', 'KB', 'MB', 'GB'];
+  let i = 0;
+  while (bytes >= 1024 && i < units.length - 1) {
+    bytes /= 1024;
+    i++;
+  }
+  return `${i ? bytes.toFixed(bytes < 10 ? 1 : 0) : bytes} ${units[i]}`;
+}
+
+export function downloadStatus(d: Download): string {
+  switch (d.state) {
+    case 'progressing':
+    case 'paused': {
+      const done = formatBytes(d.received);
+      const of = d.total ? `${done} of ${formatBytes(d.total)}` : done;
+      return d.state === 'paused' ? `Paused · ${of}` : of;
+    }
+    case 'dangerous':
+      return 'This file may be harmful';
+    case 'completed':
+      return formatBytes(d.total || d.received);
+    case 'cancelled':
+      return 'Cancelled';
+    default:
+      return 'Failed';
+  }
+}
