+  profile_favorites_[id];
+  Changed();
+  return true;
+}
+
+bool SidebarService::RenameProfile(const std::string& profile_id,
+                                   const std::string& name) {
+  if (name.empty()) {
+    return false;
+  }
+  if (profile_id.empty()) {
+    main_profile_name_ = name;
+  } else {
+    auto it = std::ranges::find(profiles_, profile_id, &ProfileInfo::id);
+    if (it == profiles_.end()) {
+      return false;
+    }
+    it->name = name;
+  }
+  Changed();
+  return true;
+}
+
+bool SidebarService::RemoveProfile(const std::string& profile_id) {
+  auto it = std::ranges::find(profiles_, profile_id, &ProfileInfo::id);
+  if (profile_id.empty() || it == profiles_.end() ||
+      std::ranges::any_of(spaces_, [&](const Space& s) {
+        return s.profile == profile_id;
+      })) {
+    return false;
+  }
+  profiles_.erase(it);
+  profile_favorites_.erase(profile_id);
+  Changed();
+  return true;
+}
