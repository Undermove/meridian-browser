+  auto it = std::ranges::find(spaces_, space_id, &Space::id);
+  if (it == spaces_.end() || !FindProfile(profile_id)) {
+    return false;
+  }
+  if (it->profile != profile_id) {
+    it->profile = profile_id;
+    Changed();
+  }
+  return true;
