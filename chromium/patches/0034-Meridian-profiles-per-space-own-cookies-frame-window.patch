diff --git a/chrome/browser/meridian/downloads_tracker.cc b/chrome/browser/meridian/downloads_tracker.cc
new file mode 100644
index 0000000000..77465cb76d
--- /dev/null
+++ b/chrome/browser/meridian/downloads_tracker.cc
@@ -0,0 +1,142 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/downloads_tracker.h"
+
+#include <algorithm>
+
+#include "chrome/browser/platform_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/download/public/common/download_item.h"
+#include "content/public/browser/download_manager.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr size_t kMax = 20;
+
+std::string StateOf(download::DownloadItem* item) {
+  switch (item->GetState()) {
+    case download::DownloadItem::IN_PROGRESS:
+      if (item->IsDangerous()) {
+        return "dangerous";
+      }
+      return item->IsPaused() ? "paused" : "progressing";
+    case download::DownloadItem::COMPLETE:
+      return "completed";
+    case download::DownloadItem::CANCELLED:
+      return "cancelled";
+    case download::DownloadItem::INTERRUPTED:
+    case download::DownloadItem::MAX_DOWNLOAD_STATE:
+      return "interrupted";
+  }
+  return "interrupted";
+}
+
+}  // namespace
+
+DownloadsTracker::DownloadsTracker(Profile* profile,
+                                   base::RepeatingClosure changed)
+    : profile_(profile),
+      changed_(std::move(changed)),
+      notifier_(profile->GetDownloadManager(), this) {}
+
+DownloadsTracker::~DownloadsTracker() = default;
+
+download::DownloadItem* DownloadsTracker::Find(const std::string& id) {
+  content::DownloadManager* manager = notifier_.GetManager();
+  return manager ? manager->GetDownloadByGuid(id) : nullptr;
+}
+
+std::vector<mojom::DownloadPtr> DownloadsTracker::List() {
+  std::vector<mojom::DownloadPtr> out;
+  for (const std::string& id : ids_) {
+    download::DownloadItem* item = Find(id);
+    if (!item) {
+      continue;
+    }
+    auto d = mojom::Download::New();
+    d->id = id;
+    d->name = item->GetFileNameToReportUser().AsUTF8Unsafe();
+    if (d->name.empty()) {
+      d->name = item->GetURL().ExtractFileName();
+    }
+    d->received = item->GetReceivedBytes();
+    d->total = std::max<int64_t>(0, item->GetTotalBytes());
+    d->state = StateOf(item);
+    out.push_back(std::move(d));
+  }
+  return out;
+}
+
+bool DownloadsTracker::AnyInProgress() {
+  return std::ranges::any_of(ids_, [&](const std::string& id) {
+    download::DownloadItem* item = Find(id);
+    return item && item->GetState() == download::DownloadItem::IN_PROGRESS;
+  });
+}
+
+void DownloadsTracker::Act(const std::string& id, const std::string& action) {
+  download::DownloadItem* item = Find(id);
+  if (!item) {
+    return;
+  }
+  if (action == "reveal") {
+    base::FilePath path = item->GetTargetFilePath();
+    if (!path.empty()) {
+      platform_util::ShowItemInFolder(profile_, path);
+    }
+  } else if (action == "open") {
+    if (item->GetState() == download::DownloadItem::COMPLETE) {
+      item->OpenDownload();
+    }
+  } else if (action == "cancel") {
+    item->Cancel(/*user_cancel=*/true);
+  } else if (action == "keep") {
+    if (item->IsDangerous()) {
+      item->ValidateDangerousDownload();
+    }
+  } else if (action == "discard") {
+    item->Remove();
+  }
+}
+
+void DownloadsTracker::Clear() {
+  std::erase_if(ids_, [&](const std::string& id) {
+    download::DownloadItem* item = Find(id);
+    return !item || item->GetState() != download::DownloadItem::IN_PROGRESS;
+  });
+  changed_.Run();
+}
+
+void DownloadsTracker::OnDownloadCreated(content::DownloadManager* manager,
+                                         download::DownloadItem* item) {
+  // This session's only (not the history Chromium loads at startup).
+  if (item->IsTransient() ||
+      item->GetState() != download::DownloadItem::IN_PROGRESS) {
+    return;
+  }
+  ids_.insert(ids_.begin(), item->GetGuid());
+  if (ids_.size() > kMax) {
+    ids_.resize(kMax);
+  }
+  changed_.Run();
+}
+
+void DownloadsTracker::OnDownloadUpdated(content::DownloadManager* manager,
+                                         download::DownloadItem* item) {
+  if (std::ranges::find(ids_, item->GetGuid()) != ids_.end()) {
+    changed_.Run();
+  }
+}
+
+void DownloadsTracker::OnDownloadRemoved(content::DownloadManager* manager,
+                                         download::DownloadItem* item) {
+  if (std::erase(ids_, item->GetGuid())) {
+    changed_.Run();
+  }
+}
+
+}  // namespace meridian
