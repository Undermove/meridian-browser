+// static
+bool SidebarHandler::HandleCommand(BrowserWindowInterface* browser,
+                                   int id) {
+  mojom::Command command;
+  int arg = 0;
+  if (id >= IDC_SELECT_TAB_0 && id <= IDC_SELECT_TAB_7) {
+    command = mojom::Command::kSelectTab;
+    arg = id - IDC_SELECT_TAB_0;
+  } else if (id >= IDC_MERIDIAN_SPACE_1 && id <= IDC_MERIDIAN_SPACE_9) {
+    command = mojom::Command::kSelectSpace;
+    arg = id - IDC_MERIDIAN_SPACE_1;
+  } else {
+    switch (id) {
+      case IDC_SELECT_LAST_TAB:
+        command = mojom::Command::kSelectTab;
+        arg = 8;
+        break;
+      case IDC_SELECT_NEXT_TAB:
+      case IDC_CYCLE_TO_NEXT_TAB:
+      case IDC_MERIDIAN_NEXT_TAB:
+        command = mojom::Command::kStepTab;
+        arg = 1;
+        break;
+      case IDC_SELECT_PREVIOUS_TAB:
+      case IDC_CYCLE_TO_PREV_TAB:
+      case IDC_MERIDIAN_PREVIOUS_TAB:
+        command = mojom::Command::kStepTab;
+        arg = -1;
+        break;
+      case IDC_MERIDIAN_NEXT_SPACE:
+        command = mojom::Command::kStepSpace;
+        arg = 1;
+        break;
+      case IDC_MERIDIAN_PREVIOUS_SPACE:
+        command = mojom::Command::kStepSpace;
+        arg = -1;
+        break;
+      case IDC_MERIDIAN_TOGGLE_PIN:
+        command = mojom::Command::kTogglePin;
+        break;
+      case IDC_MERIDIAN_TOGGLE_SIDEBAR:
+        command = mojom::Command::kToggleSidebar;
+        break;
+      case IDC_MERIDIAN_NEW_FOLDER:
+        command = mojom::Command::kNewFolder;
+        break;
+      default:
+        return false;
+    }
+  }
+  auto it = Handlers().find(browser);
+  if (it == Handlers().end() || !it->second->page_.is_connected()) {
+    return false;
+  }
+  it->second->page_->RunCommand(command, arg);
+  return true;
+}
