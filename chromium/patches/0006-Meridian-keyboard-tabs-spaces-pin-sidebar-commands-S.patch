   overflow: hidden;
@@ -233,3 +238,49 @@ side-panel {
 cr-icon-button[hidden] {
   display: none;
 }
+
+/* ⌘S: the sidebar hides; hovering the window edge slides it back over the
+ * page as a floating card (Electron: body.sidebar-hidden). */
+#edgeHotzone {
+  display: none;
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: 0;
+  width: 8px;
+  z-index: 20;
+  app-region: no-drag;
+  -webkit-app-region: no-drag;
+}
+
+:host([sidebar-hidden]) #edgeHotzone {
+  display: block;
+}
+
+:host([sidebar-hidden]) #sidebar {
+  position: absolute;
+  top: var(--meridian-gap);
+  bottom: var(--meridian-gap);
+  left: var(--meridian-gap);
+  z-index: 30;
+  border-radius: 12px;
+  background: color-mix(in srgb, var(--meridian-surface) 82%, var(--meridian-space));
+  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
+  transform: translateX(calc(-100% - 20px));
+  opacity: 0;
+  transition: transform 0.22s ease, opacity 0.22s ease;
+}
+
+:host([sidebar-hidden][sidebar-peek]) #sidebar {
+  transform: none;
+  opacity: 1;
+}
+
+:host([sidebar-hidden]) #main {
+  padding: var(--meridian-gap);
+}
+
+/* Sliding away (and hidden), the sidebar must not catch the pointer. */
+:host([sidebar-hidden]:not([sidebar-peek])) #sidebar {
+  pointer-events: none;
+}
