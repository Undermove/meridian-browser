+namespace meridian {
+
+void SidebarHandler::SetWindowControlsVisible(bool visible) {
+  NSWindow* window =
+      browser_->GetWindow()->GetNativeWindow().GetNativeNSWindow();
+  for (NSWindowButton button :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    [window standardWindowButton:button].hidden = !visible;
+  }
+}
+
+}  // namespace meridian
diff --git a/chrome/browser/resources/webui_browser/app.css b/chrome/browser/resources/webui_browser/app.css
