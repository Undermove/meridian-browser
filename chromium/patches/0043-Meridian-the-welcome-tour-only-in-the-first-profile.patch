From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 29 Oct 2026 19:15:51 +0400
Subject: [PATCH 44/56] Meridian: the welcome tour only in the first profile

Bringing Arc over during the tour can make a profile for another Arc profile;
its window opened in the same frame with a tour of its own, so people saw the
welcome twice.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/sidebar_handler.cc | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index 236bbe0429..238e2ad0f5 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -57,6 +57,7 @@
 #include "chrome/browser/profiles/profile_attributes_storage.h"
 #include "chrome/browser/profiles/profile_manager.h"
 #include "chrome/browser/profiles/profile_metrics.h"
+#include "chrome/common/chrome_constants.h"
 #include "chrome/common/pref_names.h"
 #include "content/public/browser/browsing_data_remover.h"
 #include "chrome/browser/ui/browser_tabrestore.h"
@@ -1736,11 +1737,14 @@ mojom::SidebarStatePtr SidebarHandler::BuildState() {
       browser_->GetProfile()->GetPrefs()->GetBoolean(prefs::kSidebarRight);
   state->off_the_record = browser_->GetProfile()->IsOffTheRecord();
   // Tests open the tour with --meridian-onboarding; --no-first-run (what
-  // automation passes) keeps it closed.
+  // automation passes) keeps it closed. Only the first profile has it: the
+  // ones Meridian makes later (an Arc profile brought over during the tour)
+  // open in the same window frame, and a second tour there was a repeat.
   const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
   Profile* profile = browser_->GetProfile();
   state->onboarding =
       !state->little && !profile->IsOffTheRecord() &&
+      profile->GetBaseName() == base::FilePath(chrome::kInitialProfile) &&
       !profile->GetPrefs()->GetBoolean(prefs::kOnboarded) &&
       (cl->HasSwitch("meridian-onboarding") || !cl->HasSwitch("no-first-run"));
   return state;
