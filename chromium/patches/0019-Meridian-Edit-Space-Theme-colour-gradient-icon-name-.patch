+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import type {MeridianThemeEditorElement} from './theme_editor.js';
+
+export function getHtml(this: MeridianThemeEditorElement) {
+  return html`<!--_html_template_start_-->
+${this.space_ ? html`
+  <div id="overlay" @mousedown="${this.onOverlayMousedown_}">
+    <div id="card" role="dialog" aria-label="Edit space theme"
+        @keydown="${this.onCardKeydown_}">
+      <div id="preview"
+          style="--a:${this.space_.color};--b:${this.space_.color2}">
+        <div class="tp-sidebar">
+          <div class="tp-url"></div>
+          <div class="tp-space"><span>${this.space_.icon}</span>
+            <span>${this.space_.name}</span></div>
+          <div class="tp-row a"></div><div class="tp-row"></div>
+          <div class="tp-row"></div><div class="tp-row short"></div>
+        </div>
+        <div class="tp-page"></div>
+      </div>
+      <div class="body">
+        <input id="name" class="name" .value="${this.space_.name}"
+            spellcheck="false" maxlength="40" @input="${this.onNameInput_}">
+        <div class="label">Colour</div>
+        <div class="swatches">
+          ${this.swatches_.map(s => html`
+            <button class="sw ${s.on ? 'on' : ''}" data-index="${s.index}"
+                style="--a:${s.a};--b:${s.b}" title="${s.a}"
+                @click="${this.onSwatchClick_}"></button>`)}
+        </div>
+        <div class="custom">
+          <label class="pick"><input type="color" id="color"
+              .value="${this.space_.color}" @input="${this.onColorInput_}">
+            <span>Colour</span></label>
+          <label class="check-line"><input type="checkbox" id="gradient"
+              .checked="${this.gradient_}" @change="${this.onGradientChange_}">
+            Gradient</label>
+          <label class="pick ${this.gradient_ ? '' : 'off'}"><input type="color"
+              id="color2" .value="${this.space_.color2}"
+              @input="${this.onColor2Input_}"><span>Second colour</span></label>
+        </div>
+        <div class="label">Icon</div>
+        <div class="emoji">
+          <button class="em none ${this.noIcon_ ? 'on' : ''}" data-emoji=""
+              title="No icon" @click="${this.onEmojiClick_}">
+            ${icon('x', 14)}</button>
+          ${this.emoji_.map(e => html`
+            <button class="em ${e.on ? 'on' : ''}" data-emoji="${e.emoji}"
+                @click="${this.onEmojiClick_}">${e.emoji}</button>`)}
+        </div>
+        <div class="actions">
+          <button id="cancel" class="btn" @click="${this.onCancelClick_}">
+            Cancel</button>
+          <button id="done" class="btn accent" @click="${this.onDoneClick_}">
+            Done</button>
+        </div>
+      </div>
+    </div>
+  </div>` : ''}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/theme_editor.ts b/chrome/browser/resources/webui_browser/meridian/theme_editor.ts
new file mode 100644
index 0000000000..0cc6860b6c
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/theme_editor.ts
@@ -0,0 +1,193 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Edit Space Theme: a space's colour (solid or gradient), icon and name. The
+// window takes each change at once; Cancel puts the old theme back.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {SidebarHandlerInterface, Space} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './theme_editor.css.js';
+import {getHtml} from './theme_editor.html.js';
+
+const PRESETS: Array<[string, string]> = [
+  ['#8a8fe0', '#8a8fe0'], ['#e08a9b', '#e08a9b'], ['#e0b27a', '#e0b27a'],
+  ['#7fbf8e', '#7fbf8e'], ['#6fb6d9', '#6fb6d9'], ['#b48ae0', '#b48ae0'],
+  ['#d98a6f', '#d98a6f'], ['#9aa3ad', '#9aa3ad'], ['#ff8a65', '#f06292'],
+  ['#7f7fd5', '#86a8e7'], ['#43cea2', '#185a9d'], ['#f7b267', '#f4845f'],
+  ['#c471f5', '#fa71cd'], ['#4facfe', '#00f2fe'], ['#a8e063', '#56ab2f'],
+  ['#30323d', '#6b6e80'],
+];
+
+const EMOJI = [
+  '🏠', '💼', '🧪', '🎨', '📚', '🎮', '🎵', '✈️', '🛒', '💡', '🧠',
+  '🚀', '🌿', '☕️', '🔥', '⭐️', '❤️', '🐙', '🦊', '🍀', '🌊', '⚡️',
+  '🧩', '📷', '🏀', '🍕', '💰', '🛠️', '📝', '🗂️', '🌙', '☀️',
+];
+
+// A darker, hue-shifted partner colour for a one-click gradient.
+function shade(hex: string): string {
+  const n = parseInt(hex.slice(1), 16);
+  if (Number.isNaN(n)) {
+    return '#6b6e80';
+  }
+  const r = (n >> 16) & 255;
+  const g = (n >> 8) & 255;
+  const b = n & 255;
+  return '#' +
+      [r * 0.72 + b * 0.1, g * 0.68 + r * 0.08, b * 0.8 + 40]
+          .map(v => Math.max(0, Math.min(255, Math.round(v))))
+          .map(v => v.toString(16).padStart(2, '0'))
+          .join('');
+}
+
+export interface Swatch {
+  index: number;
+  a: string;
+  b: string;
+  on: boolean;
+}
+
+export interface EmojiChoice {
+  emoji: string;
+  on: boolean;
+}
+
+export class MeridianThemeEditorElement extends CrLitElement {
+  static get is() {
+    return 'meridian-theme-editor';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      space_: {state: true, type: Object},
+      swatches_: {state: true, type: Array},
+      emoji_: {state: true, type: Array},
+      gradient_: {state: true, type: Boolean},
+      noIcon_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  protected accessor space_: Space|null = null;
+  protected accessor swatches_: Swatch[] = [];
+  protected accessor emoji_: EmojiChoice[] = [];
+  protected accessor gradient_: boolean = false;
+  protected accessor noIcon_: boolean = true;
+
+  private readonly handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  private original_: Space|null = null;
+
+  show(space: Space) {
+    this.original_ = {...space};
+    this.space_ = {...space};
+    this.open = true;
+    this.handler_.activateSpace(space.id);
+    this.updateComplete.then(
+        () => this.shadowRoot.querySelector<HTMLElement>('#done')?.focus());
+  }
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    const s = this.space_;
+    this.gradient_ = !!s && s.color2 !== s.color;
+    this.noIcon_ = !s?.icon;
+    this.swatches_ = PRESETS.map(([a, b], index) => ({
+                                   index,
+                                   a,
+                                   b,
+                                   on: !!s && s.color === a && s.color2 === b,
+                                 }));
+    this.emoji_ = EMOJI.map(emoji => ({emoji, on: s?.icon === emoji}));
+  }
+
+  private apply_(change: Partial<Space>) {
+    const s = {...this.space_!, ...change};
+    this.space_ = s;
+    this.handler_.updateSpace(s.id, s.name, s.icon, s.color, s.color2);
+  }
+
+  private finish_(keep: boolean) {
+    if (!keep && this.original_) {
+      const o = this.original_;
+      this.handler_.updateSpace(o.id, o.name, o.icon, o.color, o.color2);
+    }
+    this.open = false;
+  }
+
+  protected onSwatchClick_(e: Event) {
+    const [a, b] =
+        PRESETS[Number((e.currentTarget as HTMLElement).dataset['index'])]!;
+    this.apply_({color: a, color2: b});
+  }
+
+  protected onColorInput_(e: Event) {
+    const color = (e.target as HTMLInputElement).value;
+    this.apply_({color, color2: this.gradient_ ? this.space_!.color2 : color});
+  }
+
+  protected onColor2Input_(e: Event) {
+    this.apply_({color2: (e.target as HTMLInputElement).value});
+  }
+
+  protected onGradientChange_(e: Event) {
+    const on = (e.target as HTMLInputElement).checked;
+    const color = this.space_!.color;
+    this.apply_({color2: on ? shade(color) : color});
+  }
+
+  protected onEmojiClick_(e: Event) {
+    this.apply_({icon: (e.currentTarget as HTMLElement).dataset['emoji'] || ''});
+  }
+
+  protected onNameInput_(e: Event) {
+    const name = (e.target as HTMLInputElement).value.trim();
+    this.apply_({name: name || this.original_!.name});
+  }
+
+  protected onCancelClick_() {
+    this.finish_(false);
+  }
+
+  protected onDoneClick_() {
+    this.finish_(true);
+  }
+
+  protected onOverlayMousedown_(e: Event) {
+    if (e.target === e.currentTarget) {
+      this.finish_(true);
+    }
+  }
+
+  protected onCardKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.finish_(false);
+    } else if (e.key === 'Enter' &&
+               (e.target as HTMLElement).id === 'name') {
+      this.finish_(true);
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-theme-editor': MeridianThemeEditorElement;
+  }
+}
+
+customElements.define(MeridianThemeEditorElement.is, MeridianThemeEditorElement);
