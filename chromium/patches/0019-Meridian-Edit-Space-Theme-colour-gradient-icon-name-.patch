+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #css_wrapper_metadata_end */
+
+/* From the Electron build's theme editor (src/renderer/chrome.css). */
+
+:host {
+  position: fixed;
+  inset: 0;
+  z-index: 60;
+  display: none;
+  color: var(--meridian-text);
+  font-size: 13px;
+}
+
+:host([open]) {
+  display: block;
+}
+
+button,
+input {
+  font: inherit;
+  color: inherit;
+}
+
+button {
+  background: none;
+  border: 0;
+  padding: 0;
+  cursor: default;
+}
+
+#overlay {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  background: rgba(20, 20, 30, 0.12);
+  app-region: no-drag;
+  -webkit-app-region: no-drag;
+}
+
+#card {
+  width: 380px;
+  border-radius: 16px;
+  overflow: hidden;
+  background: var(--meridian-surface);
+  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35),
+      0 0 0 0.5px var(--meridian-border);
+}
+
+#preview {
+  height: 150px;
+  padding: 14px;
+  box-sizing: border-box;
+  display: flex;
+  gap: 10px;
+  background: linear-gradient(140deg, var(--a), var(--b));
+  transition: background 0.3s;
+}
+
+.tp-sidebar {
+  width: 34%;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.tp-url {
+  height: 16px;
+  border-radius: 5px;
+  background: rgba(255, 255, 255, 0.55);
+}
+
+.tp-space {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  font-size: 11px;
+  font-weight: 650;
+  color: rgba(0, 0, 0, 0.6);
+  margin: 4px 2px 0;
+  min-height: 14px;
+}
+
+.tp-row {
+  height: 12px;
+  border-radius: 4px;
+  background: rgba(255, 255, 255, 0.28);
+}
+
+.tp-row.a {
+  background: rgba(255, 255, 255, 0.75);
+}
+
+.tp-row.short {
+  width: 60%;
+}
+
+.tp-page {
+  flex: 1;
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.92);
+  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
+}
+
+.body {
+  padding: 14px 16px 16px;
+}
+
+.name {
+  width: 100%;
+  box-sizing: border-box;
+  border: 0;
+  outline: 0;
+  background: transparent;
+  font-size: 17px;
+  font-weight: 650;
+  padding: 2px 0 8px;
+  border-bottom: 1px solid var(--meridian-border);
+}
+
+.name:focus {
+  border-color: var(--meridian-space);
+}
+
+.label {
+  margin: 14px 0 7px;
+  font-size: 11px;
+  font-weight: 650;
+  color: var(--meridian-text-muted);
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+}
+
+.swatches {
+  display: grid;
+  grid-template-columns: repeat(8, 1fr);
+  gap: 8px;
+}
+
+.sw {
+  aspect-ratio: 1;
+  border-radius: 50%;
+  background: linear-gradient(140deg, var(--a), var(--b));
+  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
+  transition: transform 0.12s;
+}
+
+.sw:hover {
+  transform: scale(1.08);
+}
+
+.sw.on {
+  box-shadow: 0 0 0 2px var(--meridian-surface), 0 0 0 4px var(--a);
+}
+
+.custom {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  margin-top: 12px;
+  font-size: 12px;
+  color: var(--meridian-text-muted);
+}
+
+.pick {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.pick.off {
+  opacity: 0.35;
+  pointer-events: none;
+}
+
+.pick input {
+  width: 24px;
+  height: 24px;
+  padding: 0;
+  border: 0;
+  border-radius: 6px;
+  background: none;
+}
+
+.check-line {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+}
+
+.emoji {
+  display: grid;
+  grid-template-columns: repeat(11, 1fr);
+  gap: 3px;
+}
+
+.em {
+  aspect-ratio: 1;
+  border-radius: 7px;
+  font-size: 16px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.em:hover {
+  background: var(--meridian-row-hover);
+}
+
+.em.on {
+  background: color-mix(in srgb, var(--meridian-space) 25%, transparent);
+  box-shadow: inset 0 0 0 1.5px var(--meridian-space);
+}
+
+.em.none {
+  color: var(--meridian-text-muted);
+}
+
+.actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  margin-top: 16px;
+}
+
+.btn {
+  height: 30px;
+  padding: 0 14px;
+  border-radius: 8px;
+  font-weight: 500;
+  background: color-mix(in srgb, var(--meridian-text) 7%, transparent);
+}
+
+.btn.accent {
+  background: color-mix(in oklab, var(--meridian-space) 78%, #141420);
+  color: #fff;
+}
+
+@media (prefers-color-scheme: dark) {
+  .tp-page {
+    background: rgba(30, 30, 34, 0.92);
+  }
+
+  .tp-space {
+    color: rgba(255, 255, 255, 0.75);
+  }
+}
