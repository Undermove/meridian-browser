@@ -0,0 +1,87 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html, repeat} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianHomeElement} from './home.js';
+import {icon} from './icons.js';
+
+export function getHtml(this: MeridianHomeElement) {
+  return html`<!--_html_template_start_-->
+<div id="scroller">
+  <div class="hero">
+    <div class="greet">${this.greeting_}</div>
+    <button id="search" class="search" @click="${this.onSearchClick_}">
+      <span class="search-ic">${icon('search', 18)}</span>
+      <span class="search-text">Search or open a site</span>
+      <span class="search-keys"><kbd>⌘</kbd><kbd>T</kbd></span>
+    </button>
+    ${this.compact_ ? html`
+      <button id="expand" class="link" @click="${this.onExpandClick_}">
+        What can Meridian do?</button>` : ''}
+  </div>
+  <div id="more" ?hidden="${this.compact_}">
+    <section class="section">
+      <div class="head">
+        <h2>What Meridian can do</h2>
+        <button id="compact" class="link" @click="${this.onCompactClick_}">
+          Show less</button>
+      </div>
+      <div class="cards">
+        ${this.cards_.map(c => html`
+          <article class="card" data-card="${c.id}"
+              style="--c:${c.color};--i:${c.index}" tabindex="0">
+            <div class="demo">
+              ${c.demo === 'find' ? html`
+                <div class="hd hd-find">
+                  <i class="hd-side"><b></b><b></b><b class="on"></b><b></b></i>
+                  <i class="hd-page"></i>
+                  <i class="hd-bar"><i class="hd-q"></i><b></b><b class="hit"></b>
+                    <b></b></i>
+                </div>` : ''}
+              ${c.demo === 'split' ? html`
+                <div class="hd hd-split">
+                  <i class="hd-side"><b></b><b></b><b class="on"></b><b></b></i>
+                  <i class="hd-page a"></i><i class="hd-page b"></i>
+                </div>` : ''}
+              ${c.demo === 'spaces' ? html`
+                <div class="hd hd-spaces">
+                  <i class="hd-side s1"><b></b><b class="on"></b><b></b></i>
+                  <i class="hd-side s2"><b class="on"></b><b></b></i>
+                  <i class="hd-page"></i><i class="hd-dots"><b></b><b></b></i>
+                </div>` : ''}
+            </div>
+            <div class="body">
+              <div class="title">${c.title}</div>
+              <div class="tagline">${c.tagline}</div>
+              <ul class="points">
+                ${c.points.map(p => html`
+                  <li>
+                    <span class="k">
+                      ${p.label ? html`<em>${p.label}</em>` : ''}
+                      ${p.keys.map(k => html`<kbd>${k}</kbd>`)}
+                    </span>
+                    <span>${p.text}</span>
+                  </li>`)}
+              </ul>
+              <div class="actions">
+                <button class="btn accent" data-action="${c.tryAction}"
+                    @click="${this.onTryClick_}">${c.tryLabel}</button>
+                <button class="btn ghost" data-persona="${c.id}"
+                    @click="${this.onPresetClick_}">Set up for me</button>
+              </div>
+            </div>
+          </article>`)}
+      </div>
+    </section>
+    ${repeat([this.tipIndex_], i => i, () => html`
+      <div id="tip" class="tip" aria-live="polite">
+        <span class="tip-label">Tip</span>
+        ${this.tipKeys_.map(k => html`<kbd>${k}</kbd>`)}
+        <span>${this.tipText_}</span>
+      </div>`)}
+  </div>
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/home.ts b/chrome/browser/resources/webui_browser/meridian/home.ts
new file mode 100644
index 0000000000..49aa5a61b7
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/home.ts
@@ -0,0 +1,212 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The home page, shown instead of an empty new tab: a greeting, a big search
+// field that opens ⌘T, what Meridian can do (a card per kind of person, each
+// with something to try and a preset), and shortcut tips.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './home.css.js';
+import {getHtml} from './home.html.js';
+
+export interface HomePoint {
+  // Keys ("⌘T") show as keycaps; words ("Peek") as a label.
+  keys: string[];
+  label: string;
+  text: string;
+}
+
+export interface HomeCard {
+  id: string;
+  index: number;
+  title: string;
+  tagline: string;
+  color: string;
+  demo: 'find'|'split'|'spaces';
+  points: HomePoint[];
+  tryLabel: string;
+  tryAction: 'command-bar'|'edit-theme'|'new-space';
+}
+
+const keys = (k: string) => k.split(' ');
+
+const CARDS: HomeCard[] = [
+  {
+    id: 'everyday',
+    index: 0,
+    title: 'For every day',
+    tagline: 'Tabs that tidy themselves.',
+    color: '#8a8fe0',
+    demo: 'find',
+    points: [
+      {keys: keys('⌘ T'), label: '', text: 'Find any open tab by typing a few letters'},
+      {keys: [], label: 'Today', text: 'Tabs you don’t pin are archived after a while'},
+      {keys: keys('⌘ D'), label: '', text: 'Pinned tabs always return to their home page'},
+    ],
+    tryLabel: 'Try ⌘T',
+    tryAction: 'command-bar',
+  },
+  {
+    id: 'designer',
+    index: 1,
+    title: 'For designers',
+    tagline: 'Two pages at a glance.',
+    color: '#c471f5',
+    demo: 'split',
+    points: [
+      {keys: keys('⌃ ⇧ ='), label: '', text: 'Split view: two pages side by side'},
+      {keys: [], label: 'Peek', text: 'Links from pinned tabs open in a preview'},
+      {keys: [], label: 'Theme', text: 'Every space gets its own colour'},
+    ],
+    tryLabel: 'Pick a colour',
+    tryAction: 'edit-theme',
+  },
+  {
+    id: 'manager',
+    index: 2,
+    title: 'For managers',
+    tagline: 'Work and life, kept apart.',
+    color: '#4facfe',
+    demo: 'spaces',
+    points: [
+      {keys: keys('⌃ 1–9'), label: '', text: 'Spaces for work and personal'},
+      {keys: [], label: 'Links', text: 'A little window for links from other apps'},
+      {keys: keys('⌥ ⌘ A'), label: '', text: 'Everything you closed, in the Archive'},
+    ],
+    tryLabel: 'Make a space',
+    tryAction: 'new-space',
+  },
+];
+
+const TIPS: Array<[string[], string]> = [
+  [keys('⌘ T'), 'finds any open tab, in any space'],
+  [keys('⌃ ⇥'), 'jumps to the next tab without the mouse'],
+  [keys('⌃ 1–9'), 'switches straight to a space'],
+  [keys('⇧ ⌘ C'), 'copies the address of the page'],
+  [keys('⌘ S'), 'hides the sidebar for a full-width page'],
+  [keys('⌥ ⌘ A'), 'shows every tab you closed'],
+  [keys('⌘ D'), 'pins the tab so it’s always there'],
+];
+
+const COMPACT_KEY = 'meridian.homeCompact';
+
+function readCompact(): boolean {
+  try {
+    return localStorage.getItem(COMPACT_KEY) === '1';
+  } catch {
+    return false;
+  }
+}
+
+export class MeridianHomeElement extends CrLitElement {
+  static get is() {
+    return 'meridian-home';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      shown: {type: Boolean, reflect: true},
+      compact_: {type: Boolean, reflect: true, attribute: 'compact'},
+      greeting_: {state: true, type: String},
+      tipKeys_: {state: true, type: Array},
+      tipText_: {state: true, type: String},
+      tipIndex_: {state: true, type: Number},
+      cards_: {state: true, type: Array},
+    };
+  }
+
+  accessor shown: boolean = false;
+  protected accessor compact_: boolean = readCompact();
+  protected accessor greeting_: string = '';
+  protected accessor tipKeys_: string[] = [];
+  protected accessor tipText_: string = '';
+  protected accessor tipIndex_: number = 0;
+  protected accessor cards_: HomeCard[] = CARDS;
+
+  private tipTimer_: number|null = null;
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    if (changed.has('shown' as keyof MeridianHomeElement)) {
+      if (this.shown) {
+        this.greeting_ = this.greet_();
+        this.startTips_();
+      } else {
+        this.stopTips_();
+      }
+    }
+    const [tipKeys, tipText] = TIPS[this.tipIndex_ % TIPS.length]!;
+    this.tipKeys_ = tipKeys;
+    this.tipText_ = tipText;
+  }
+
+  private greet_(): string {
+    const h = new Date().getHours();
+    return h < 5 ? 'Good night' :
+        h < 12   ? 'Good morning' :
+        h < 18   ? 'Good afternoon' :
+                   'Good evening';
+  }
+
+  private startTips_() {
+    this.stopTips_();
+    this.tipTimer_ = setInterval(() => this.tipIndex_++, 7000);
+  }
+
+  private stopTips_() {
+    if (this.tipTimer_ !== null) {
+      clearInterval(this.tipTimer_);
+      this.tipTimer_ = null;
+    }
+  }
+
+  private setCompact_(compact: boolean) {
+    this.compact_ = compact;
+    try {
+      localStorage.setItem(COMPACT_KEY, compact ? '1' : '');
+    } catch {
+      // Storage unavailable: the choice lasts until the window closes.
+    }
+  }
+
+  protected onSearchClick_() {
+    this.fire('meridian-home-action', 'command-bar');
+  }
+
+  protected onTryClick_(e: Event) {
+    this.fire('meridian-home-action',
+              (e.currentTarget as HTMLElement).dataset['action']);
+  }
+
+  protected onPresetClick_(e: Event) {
+    this.fire('meridian-preset',
+              (e.currentTarget as HTMLElement).dataset['persona']);
+  }
+
+  protected onCompactClick_() {
+    this.setCompact_(true);
+  }
+
+  protected onExpandClick_() {
+    this.setCompact_(false);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-home': MeridianHomeElement;
+  }
+}
+
+customElements.define(MeridianHomeElement.is, MeridianHomeElement);
