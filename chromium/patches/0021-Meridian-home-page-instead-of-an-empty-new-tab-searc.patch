   constructor() {
     super();
@@ -364,6 +368,7 @@ export class WebuiBrowserAppElement extends CrLitElement {
       }
     }
     this.showLocationIconButton_ = !isNTP;
+    this.showHome_ = isNTP && !this.private_;
     this.url_ = displayUrl;
     this.urlHost_ = hostForPill(displayUrl);
     this.$.contentRegion.classList.toggle('modalScrim', active.isBlocked);
@@ -516,6 +521,28 @@ export class WebuiBrowserAppElement extends CrLitElement {
     this.$.settings.show(this.$.tabstrip.spaces());
   }
 
+  protected onMeridianHomeAction_(e: CustomEvent<string>) {
+    switch (e.detail) {
+      case 'command-bar':
+        this.$.commandBar.show(/*newTab=*/ false, '');
+        break;
+      case 'edit-theme': {
+        const space = this.$.tabstrip.activeSpace();
+        if (space) {
+          this.$.themeEditor.show(space);
+        }
+        break;
+      }
+      case 'new-space':
+        this.$.tabstrip.addSpace();
+        break;
+    }
+  }
+
+  protected onMeridianPreset_(e: CustomEvent<string>) {
+    this.$.onboarding.show('preset', e.detail);
+  }
+
   protected onMeridianPrivate_(e: CustomEvent<boolean>) {
     this.private_ = e.detail;
   }
diff --git a/chrome/browser/resources/webui_browser/meridian/home.css b/chrome/browser/resources/webui_browser/meridian/home.css
