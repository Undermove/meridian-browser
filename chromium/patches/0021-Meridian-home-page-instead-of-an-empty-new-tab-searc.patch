 .private-badge[hidden] {
   display: none;
 }
+
+/* The home page lies exactly over the page card. */
+#home {
+  inset: var(--meridian-gap) var(--meridian-gap) var(--meridian-gap) 0;
+}
+
+:host([sidebar-hidden]) #home,
+:host([sidebar-right][sidebar-hidden]) #home {
+  inset: var(--meridian-gap);
+}
+
+:host([sidebar-right]:not([sidebar-hidden])) #home {
+  inset: 36px 0 var(--meridian-gap) var(--meridian-gap);
+}
