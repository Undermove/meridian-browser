@@ -0,0 +1,560 @@
+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #css_wrapper_metadata_end */
+
+/* The home page, from the Electron build (src/renderer/home.css). */
+
+:host {
+  position: absolute;
+  inset: 0;
+  z-index: 5;
+  display: none;
+  color: var(--meridian-text-muted);
+  border-radius: var(--meridian-radius);
+  background: var(--meridian-surface);
+  overflow: hidden;
+}
+
+:host([shown]) {
+  display: block;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+button {
+  font: inherit;
+  color: inherit;
+  background: none;
+  border: 0;
+  padding: 0;
+  cursor: default;
+}
+
+kbd {
+  display: inline-block;
+  min-width: 1.4em;
+  padding: 1px 5px;
+  margin-right: 2px;
+  border-radius: 5px;
+  font: 600 11px system-ui;
+  text-align: center;
+  color: var(--meridian-text);
+  background: color-mix(in srgb, var(--meridian-text) 7%, transparent);
+  box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--meridian-text) 15%,
+                                       transparent);
+}
+
+#scroller {
+  position: absolute;
+  inset: 0;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: safe center;
+  padding: 40px 24px 28px;
+  box-sizing: border-box;
+}
+
+@keyframes rise {
+  from {
+    opacity: 0;
+    transform: translateY(10px);
+  }
+}
+
+/* ------------------------------------------------------------ hero */
+
+.hero {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 14px;
+  width: 100%;
+}
+
+.greet {
+  font-size: 30px;
+  font-weight: 650;
+  letter-spacing: -0.02em;
+  color: var(--meridian-text);
+  animation: rise 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+
+.search {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  width: min(560px, 100%);
+  height: 52px;
+  padding: 0 12px 0 18px;
+  box-sizing: border-box;
+  border-radius: 26px;
+  background: var(--meridian-surface);
+  color: var(--meridian-text-muted);
+  font-size: 15px;
+  text-align: left;
+  border: 1px solid var(--meridian-border);
+  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.05);
+  transition: transform 0.18s ease, box-shadow 0.18s ease,
+      border-color 0.18s ease;
+  animation: rise 0.5s 0.05s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+
+.search:hover {
+  transform: translateY(-1px);
+  border-color: color-mix(in srgb, var(--meridian-space) 55%, transparent);
+  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12),
+      0 0 0 4px color-mix(in srgb, var(--meridian-space) 14%, transparent);
+}
+
+.search-ic {
+  display: inline-flex;
+  color: var(--meridian-space);
+}
+
+.search-text {
+  flex: 1;
+}
+
+.link {
+  color: var(--meridian-space);
+  font-size: 12.5px;
+  font-weight: 550;
+  padding: 2px 4px;
+  border-radius: 6px;
+}
+
+.link:hover {
+  text-decoration: underline;
+}
+
+/* ------------------------------------------------------------ cards */
+
+#more {
+  width: min(1040px, 100%);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 18px;
+  margin-top: 34px;
+}
+
+.section {
+  width: 100%;
+}
+
+.head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  margin: 0 4px 12px;
+}
+
+.head h2 {
+  margin: 0;
+  font-size: 15px;
+  font-weight: 650;
+  color: var(--meridian-text);
+}
+
+.cards {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+  gap: 14px;
+}
+
+.card {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  border-radius: 18px;
+  overflow: hidden;
+  outline: none;
+  background: var(--meridian-surface);
+  border: 1px solid var(--meridian-border);
+  color: var(--meridian-text);
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 8px 24px rgba(0, 0, 0, 0.05);
+  transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
+      box-shadow 0.25s ease, border-color 0.25s ease;
+  animation: rise 0.55s calc(0.15s + var(--i) * 0.06s)
+      cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+
+.card:hover,
+.card:focus-within {
+  transform: translateY(-3px);
+  border-color: color-mix(in srgb, var(--c) 45%, transparent);
+  box-shadow: 0 18px 44px color-mix(in srgb, var(--c) 22%, rgba(0, 0, 0, 0.1));
+}
+
+.demo {
+  height: 118px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: radial-gradient(120% 100% at 30% 0%,
+      color-mix(in srgb, var(--c) 34%, var(--meridian-surface)) 0%,
+      color-mix(in srgb, var(--c) 10%, var(--meridian-surface)) 70%);
+}
+
+.body {
+  padding: 14px 16px 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  flex: 1;
+}
+
+.title {
+  font-size: 12px;
+  font-weight: 650;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  color: color-mix(in srgb, var(--c) 75%, var(--meridian-text));
+}
+
+.tagline {
+  font-size: 17px;
+  font-weight: 650;
+  letter-spacing: -0.01em;
+  margin-bottom: 6px;
+}
+
+.points {
+  list-style: none;
+  margin: 0 0 12px;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 7px;
+  font-size: 12.5px;
+  color: var(--meridian-text-muted);
+}
+
+.points li {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+}
+
+.k {
+  flex: none;
+  min-width: 52px;
+}
+
+.k kbd {
+  font-size: 10.5px;
+  padding: 1px 4px;
+}
+
+.k em {
+  font-style: normal;
+  font-size: 10.5px;
+  font-weight: 650;
+  color: var(--c);
+  background: color-mix(in srgb, var(--c) 14%, transparent);
+  padding: 2px 6px;
+  border-radius: 5px;
+}
+
+.actions {
+  margin-top: auto;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.btn {
+  height: 26px;
+  padding: 0 10px;
+  border-radius: 7px;
+  font-size: 12px;
+  font-weight: 550;
+  white-space: nowrap;
+}
+
+.btn.accent {
+  background: color-mix(in oklab, var(--c) 80%, #141420);
+  color: #fff;
+}
+
+.btn.ghost:hover {
+  background: color-mix(in srgb, var(--meridian-text) 7%, transparent);
+}
+
+/* ------------------------------------------------------------ miniatures */
+
+/* They act out the feature while the card is hovered or focused. */
+.hd {
+  position: relative;
+  width: 150px;
+  height: 88px;
+  border-radius: 9px;
+  background: var(--meridian-surface);
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14), 0 0 0 0.5px var(--meridian-border);
+  overflow: hidden;
+}
+
+.hd i,
+.hd b {
+  position: absolute;
+  display: block;
+}
+
+.hd * {
+  animation-play-state: paused !important;
+}
+
+.card:hover .hd *,
+.card:focus-within .hd * {
+  animation-play-state: running !important;
+}
+
+.hd-side {
+  left: 0;
+  top: 0;
+  bottom: 0;
+  width: 34px;
+  box-sizing: border-box;
+  background: color-mix(in srgb, var(--c) 22%, var(--meridian-surface));
+  padding: 8px 5px;
+}
+
+.hd .hd-side b {
+  position: relative;
+  height: 5px;
+  border-radius: 3px;
+  background: color-mix(in srgb, var(--meridian-text) 18%, transparent);
+  margin-bottom: 5px;
+}
+
+.hd .hd-side b.on {
+  background: color-mix(in srgb, var(--c) 80%, var(--meridian-surface));
+}
+
+.hd-page {
+  left: 40px;
+  right: 6px;
+  top: 6px;
+  bottom: 6px;
+  border-radius: 5px;
+  background: linear-gradient(
+      color-mix(in srgb, var(--meridian-text) 9%, transparent) 0 8px,
+      transparent 8px 14px,
+      color-mix(in srgb, var(--meridian-text) 6%, transparent) 14px 40px,
+      transparent 40px);
+}
+
+.hd-find .hd-bar {
+  left: 30px;
+  right: 18px;
+  top: 14px;
+  height: 56px;
+  box-sizing: border-box;
+  border-radius: 6px;
+  background: var(--meridian-surface);
+  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18), 0 0 0 0.5px var(--meridian-border);
+  padding: 7px 7px 0;
+  animation: hd-pop 3.2s infinite cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+
+.hd-find .hd-q {
+  position: relative;
+  height: 7px;
+  width: 0;
+  border-radius: 3px;
+  background: color-mix(in srgb, var(--c) 70%, var(--meridian-surface));
+  margin-bottom: 7px;
+  animation: hd-type 3.2s infinite steps(6);
+}
+
+.hd-find .hd-bar b {
+  position: relative;
+  height: 6px;
+  border-radius: 3px;
+  margin: 0 0 5px;
+  background: color-mix(in srgb, var(--meridian-text) 12%, transparent);
+}
+
+.hd-find .hd-bar b.hit {
+  animation: hd-hit 3.2s infinite;
+}
+
+@keyframes hd-pop {
+  0%,
+  8% {
+    transform: translateY(-6px) scale(0.92);
+    opacity: 0;
+  }
+  18%,
+  82% {
+    transform: none;
+    opacity: 1;
+  }
+  92%,
+  100% {
+    transform: scale(0.96);
+    opacity: 0;
+  }
+}
+
+@keyframes hd-type {
+  0%,
+  18% {
+    width: 0;
+  }
+  50%,
+  100% {
+    width: 60%;
+  }
+}
+
+@keyframes hd-hit {
+  0%,
+  52% {
+    background: color-mix(in srgb, var(--meridian-text) 12%, transparent);
+  }
+  60%,
+  100% {
+    background: color-mix(in srgb, var(--c) 55%, transparent);
+  }
+}
+
+.hd-split .hd-page.a {
+  right: 6px;
+  animation: hd-split-a 3.4s infinite cubic-bezier(0.6, 0, 0.2, 1);
+}
+
+.hd-split .hd-page.b {
+  left: auto;
+  right: 6px;
+  width: 0;
+  opacity: 0;
+  background: linear-gradient(
+      color-mix(in srgb, var(--c) 30%, transparent) 0 24px,
+      transparent 24px 30px,
+      color-mix(in srgb, var(--meridian-text) 6%, transparent) 30px);
+  animation: hd-split-b 3.4s infinite cubic-bezier(0.6, 0, 0.2, 1);
+}
+
+@keyframes hd-split-a {
+  0%,
+  20% {
+    right: 6px;
+  }
+  45%,
+  85% {
+    right: 58px;
+  }
+  100% {
+    right: 6px;
+  }
+}
+
+@keyframes hd-split-b {
+  0%,
+  20% {
+    width: 0;
+    opacity: 0;
+  }
+  45%,
+  85% {
+    width: 48px;
+    opacity: 1;
+  }
+  100% {
+    width: 0;
+    opacity: 0;
+  }
+}
+
+.hd-spaces .hd-side.s2 {
+  --c: #43cea2;
+  transform: translateX(-100%);
+  animation: hd-space-in 3.6s infinite cubic-bezier(0.6, 0, 0.2, 1);
+}
+
+.hd-spaces .hd-side.s1 {
+  animation: hd-space-out 3.6s infinite cubic-bezier(0.6, 0, 0.2, 1);
+}
+
+.hd-spaces .hd-dots {
+  left: 9px;
+  bottom: 6px;
+  display: flex;
+  gap: 4px;
+}
+
+.hd-spaces .hd-dots b {
+  position: relative;
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: color-mix(in srgb, var(--meridian-text) 25%, transparent);
+}
+
+@keyframes hd-space-in {
+  0%,
+  35% {
+    transform: translateX(-100%);
+  }
+  50%,
+  85% {
+    transform: none;
+  }
+  100% {
+    transform: translateX(-100%);
+  }
+}
+
+@keyframes hd-space-out {
+  0%,
+  35% {
+    transform: none;
+  }
+  50%,
+  85% {
+    transform: translateX(100%);
+    opacity: 0;
+  }
+  100% {
+    transform: none;
+  }
+}
+
+/* ------------------------------------------------------------ tip */
+
+.tip {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 12.5px;
+  color: var(--meridian-text-muted);
+  min-height: 24px;
+  animation: rise 0.4s ease both;
+}
+
+.tip-label {
+  font-size: 10.5px;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  color: var(--meridian-space);
+  margin-right: 4px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .greet,
+  .search,
+  .card,
+  .tip {
+    animation: none;
+  }
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/home.html.ts b/chrome/browser/resources/webui_browser/meridian/home.html.ts
