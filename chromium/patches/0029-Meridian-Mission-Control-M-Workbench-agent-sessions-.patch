+
+MissionControl::MissionControl(Profile* profile)
+    : profile_(profile),
+      quiet_(base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "meridian-no-notify")),
+      history_writer_(
+          profile->GetPath().Append("Meridian Mission History.json"),
+          base::ThreadPool::CreateSequencedTaskRunner(
+              {base::MayBlock(),
+               base::TaskShutdownBehavior::BLOCK_SHUTDOWN}),
+          base::Seconds(1)) {
+  channel_ = std::make_unique<EventChannel>(base::BindRepeating(
+      &MissionControl::OnHookEvent, weak_factory_.GetWeakPtr()));
+  LoadHistory();
+  channel_->Start(base::DoNothing());
+  sweep_.Start(FROM_HERE, base::Seconds(5),
+               base::BindRepeating(&MissionControl::Sweep,
+                                   base::Unretained(this), false));
+}
+
+MissionControl::~MissionControl() = default;
+
+void MissionControl::Shutdown() {
+  sweep_.Stop();
+  flush_.Stop();
+  if (history_writer_.HasPendingWrite()) {
+    history_writer_.DoScheduledWrite();
+  }
+  channel_.reset();
+  SetDockBadge(std::string());
+}
+
+void MissionControl::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void MissionControl::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
