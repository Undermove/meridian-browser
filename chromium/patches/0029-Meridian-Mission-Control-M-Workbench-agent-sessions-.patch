diff --git a/chrome/browser/resources/webui_browser/meridian/mission.css b/chrome/browser/resources/webui_browser/meridian/mission.css
new file mode 100644
index 0000000000..8be4dd2d4b
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/mission.css
@@ -0,0 +1,508 @@
+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  position: fixed;
+  inset: 0;
+  z-index: 50;
+  display: none;
+  color: var(--meridian-text);
+  font-size: 13px;
+  --working: #3b82f6;
+  --waiting: #e0a100;
+  --done: #2e9d5b;
+  --error: #d14b4b;
+}
+
+:host([open]) {
+  display: block;
+}
+
+button {
+  border: 0;
+  background: none;
+  font: inherit;
+  color: inherit;
+  cursor: default;
+}
+
+#overlay {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  justify-content: center;
+  align-items: flex-start;
+  padding-top: 7vh;
+  background: var(--meridian-overlay);
+  app-region: no-drag;
+  -webkit-app-region: no-drag;
+}
+
+#card {
+  width: min(980px, 92vw);
+  height: min(640px, 84vh);
+  display: flex;
+  flex-direction: column;
+  border-radius: 14px;
+  background: var(--meridian-surface);
+  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35),
+    0 0 0 0.5px var(--meridian-border);
+  overflow: hidden;
+  outline: none;
+}
+
+.head {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  height: 52px;
+  padding: 0 14px 0 18px;
+  border-bottom: 1px solid var(--meridian-border);
+  flex: none;
+}
+
+.title {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-weight: 650;
+  font-size: 14px;
+}
+
+.title svg {
+  color: var(--meridian-space);
+}
+
+.chips {
+  display: flex;
+  gap: 6px;
+}
+
+.chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  padding: 2px 9px;
+  border-radius: 10px;
+  font-size: 11.5px;
+  color: var(--meridian-text-muted);
+  background: color-mix(in srgb, var(--meridian-text) 6%, transparent);
+}
+
+.chip i {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: currentColor;
+  opacity: 0.4;
+}
+
+.chip.working.on i {
+  background: var(--working);
+  opacity: 1;
+  animation: pulse 1.4s ease-in-out infinite;
+}
+
+.chip.waiting.on {
+  color: var(--waiting);
+  background: color-mix(in srgb, var(--waiting) 14%, transparent);
+}
+
+.chip.waiting.on i {
+  background: var(--waiting);
+  opacity: 1;
+}
+
+@keyframes pulse {
+  50% {
+    opacity: 0.3;
+  }
+}
+
+.grow {
+  flex: 1;
+}
+
+.kbd {
+  font-size: 11px;
+  color: var(--meridian-text-muted);
+}
+
+.icon-btn {
+  width: 26px;
+  height: 26px;
+  border-radius: 7px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--meridian-text-muted);
+}
+
+.icon-btn:hover {
+  background: var(--meridian-row-hover);
+  color: var(--meridian-text);
+}
+
+.body {
+  flex: 1;
+  min-height: 0;
+  display: flex;
+}
+
+.tree-wrap {
+  flex: 1;
+  min-width: 0;
+  overflow-y: auto;
+  padding: 10px;
+}
+
+.row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 10px 8px calc(10px + var(--depth) * 26px);
+  border-radius: 10px;
+}
+
+.row:hover {
+  background: var(--meridian-row-hover);
+}
+
+.row.sel {
+  background: color-mix(in srgb, var(--meridian-space) 14%, transparent);
+}
+
+.row.ended {
+  opacity: 0.6;
+}
+
+.avatar {
+  position: relative;
+  flex: none;
+  width: 30px;
+  height: 30px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  font-weight: 700;
+  font-size: 12px;
+  background: color-mix(in srgb, var(--meridian-text) 8%, transparent);
+}
+
+.ring {
+  position: absolute;
+  inset: -2px;
+  border-radius: 50%;
+  border: 2px solid transparent;
+}
+
+.row.live .ring {
+  border-color: var(--working);
+  border-right-color: transparent;
+  animation: spin 1s linear infinite;
+}
+
+.row[data-status='waiting'] .ring {
+  border-color: var(--waiting);
+}
+
+@keyframes spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+.main {
+  flex: 1;
+  min-width: 0;
+}
+
+.line1,
+.line2 {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  min-width: 0;
+  white-space: nowrap;
+}
+
+.line2 {
+  margin-top: 3px;
+}
+
+.label {
+  font-weight: 600;
+}
+
+.sub,
+.proj,
+.tool {
+  color: var(--meridian-text-muted);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  font-size: 12px;
+}
+
+.where:not(:empty) {
+  padding: 0 6px;
+  border-radius: 6px;
+  font-size: 10.5px;
+  color: var(--meridian-text-muted);
+  background: color-mix(in srgb, var(--meridian-text) 6%, transparent);
+}
+
+.pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  flex: none;
+  font-size: 11.5px;
+}
+
+.pill i {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--meridian-text-muted);
+}
+
+.pill[data-status='thinking'] i,
+.pill[data-status='tool'] i,
+.pill[data-status='starting'] i {
+  background: var(--working);
+}
+
+.pill[data-status='waiting'] {
+  color: var(--waiting);
+}
+
+.pill[data-status='waiting'] i {
+  background: var(--waiting);
+}
+
+.pill[data-status='done'] i {
+  background: var(--done);
+}
+
+.pill[data-status='error'] {
+  color: var(--error);
+}
+
+.pill[data-status='error'] i {
+  background: var(--error);
+}
+
+.meta {
+  flex: none;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  gap: 2px;
+  font-size: 11px;
+  color: var(--meridian-text-muted);
+  font-variant-numeric: tabular-nums;
+}
+
+.empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8px;
+  padding: 48px 32px;
+  text-align: center;
+  color: var(--meridian-text-muted);
+}
+
+.orbit {
+  color: var(--meridian-space);
+}
+
+.empty-title {
+  font-weight: 600;
+  color: var(--meridian-text);
+}
+
+.empty-sub {
+  max-width: 380px;
+  line-height: 1.5;
+}
+
+.btn {
+  height: 28px;
+  padding: 0 12px;
+  border-radius: 8px;
+  font-weight: 550;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  background: color-mix(in srgb, var(--meridian-text) 8%, transparent);
+}
+
+.btn.primary {
+  background: color-mix(in oklab, var(--meridian-space) 78%, #141420);
+  color: #fff;
+}
+
+#history {
+  margin-top: 14px;
+  padding-top: 10px;
+  border-top: 1px solid var(--meridian-border);
+}
+
+.h-head {
+  display: flex;
+  align-items: center;
+  padding: 0 10px 6px;
+  font-size: 11.5px;
+  font-weight: 600;
+  color: var(--meridian-text-muted);
+}
+
+.link-btn {
+  color: var(--meridian-text-muted);
+  font-size: 11.5px;
+}
+
+.link-btn:hover {
+  color: var(--meridian-text);
+}
+
+.h-row {
+  display: grid;
+  grid-template-columns: 10px 1.4fr 1fr 70px 1.2fr 50px 70px;
+  align-items: center;
+  gap: 8px;
+  padding: 4px 10px;
+  font-size: 12px;
+  color: var(--meridian-text-muted);
+  white-space: nowrap;
+}
+
+.h-row span {
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.h-label {
+  color: var(--meridian-text);
+}
+
+.h-dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--done);
+}
+
+.h-row[data-status='error'] .h-dot {
+  background: var(--error);
+}
+
+#detail {
+  flex: none;
+  width: 320px;
+  overflow-y: auto;
+  padding: 16px;
+  border-left: 1px solid var(--meridian-border);
+  background: color-mix(in srgb, var(--meridian-text) 2%, transparent);
+}
+
+.d-title {
+  font-weight: 650;
+  font-size: 15px;
+}
+
+.d-sub {
+  margin: 3px 0 8px;
+  color: var(--meridian-text-muted);
+  font-size: 12px;
+}
+
+.facts {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 10px;
+  margin: 16px 0;
+}
+
+.facts dt {
+  font-size: 11px;
+  color: var(--meridian-text-muted);
+}
+
+.facts dd {
+  margin: 2px 0 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.actions {
+  display: flex;
+  gap: 8px;
+  margin-bottom: 16px;
+}
+
+.log-title {
+  font-size: 11.5px;
+  font-weight: 600;
+  color: var(--meridian-text-muted);
+  margin-bottom: 6px;
+}
+
+.log {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.log li {
+  display: grid;
+  grid-template-columns: 8px auto 1fr auto;
+  align-items: center;
+  gap: 7px;
+  padding: 4px 0;
+  font-size: 12px;
+}
+
+.log li i {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--working);
+}
+
+.log li[data-ok='true'] i {
+  background: var(--done);
+}
+
+.log li[data-ok='false'] i {
+  background: var(--error);
+}
+
+.log li span {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  color: var(--meridian-text-muted);
+}
+
+.log li time {
+  font-size: 11px;
+  color: var(--meridian-text-muted);
+  font-variant-numeric: tabular-nums;
+}
+
+.muted {
+  color: var(--meridian-text-muted);
+}
+
+.d-empty {
+  padding-top: 40px;
+  text-align: center;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/mission.html.ts b/chrome/browser/resources/webui_browser/meridian/mission.html.ts
new file mode 100644
index 0000000000..09eba0539f
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/mission.html.ts
@@ -0,0 +1,131 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import type {MeridianMissionElement} from './mission.js';
+
+export function getHtml(this: MeridianMissionElement) {
+  return html`<!--_html_template_start_-->
+<div id="overlay" @mousedown="${this.onOverlayMousedown_}"
+    @keydown="${this.onKeydown_}">
+  <div id="card" role="dialog" aria-label="Mission Control" tabindex="-1">
+    <header class="head">
+      <span class="title">${icon('agents', 18)} Mission Control</span>
+      <div class="chips">
+        <span class="chip working ${this.snapshot?.counts.working ? 'on' : ''}">
+          <i></i><b id="working">${this.snapshot?.counts.working ?? 0}</b>
+          working</span>
+        <span class="chip waiting ${this.snapshot?.counts.waiting ? 'on' : ''}">
+          <i></i><b id="waiting">${this.snapshot?.counts.waiting ?? 0}</b>
+          waiting for you</span>
+        <span class="chip"><b id="calls">${this.totalCalls_}</b> tool calls</span>
+      </div>
+      <div class="grow"></div>
+      <span class="kbd">⇧⌘M</span>
+      <button id="close" class="icon-btn" title="Close (Esc)"
+          @click="${this.onCloseClick_}">${icon('x', 14)}</button>
+    </header>
+    <div class="body">
+      <section class="tree-wrap">
+        <div id="tree">
+          ${this.rows_.map(r => html`
+            <div class="row ${r.selected ? 'sel' : ''} ${r.live ? 'live' : ''}
+                ${r.ended ? 'ended' : ''}" data-id="${r.id}"
+                data-status="${r.status}" style="--depth:${r.depth}"
+                @click="${this.onRowClick_}" @dblclick="${this.onRowDblclick_}">
+              <span class="avatar"><i class="ring"></i>
+                <span class="mark">${r.icon || r.mark}</span></span>
+              <div class="main">
+                <div class="line1">
+                  <span class="label">${r.label}</span>
+                  <span class="sub">${r.sublabel}</span>
+                  <span class="where">${r.where}</span>
+                  <span class="proj">${r.project}</span>
+                </div>
+                <div class="line2">
+                  <span class="pill" data-status="${r.status}"><i></i>
+                    <span class="pill-text">${r.statusText}</span></span>
+                  <span class="tool" title="${r.toolSummary}">
+                    ${r.toolSummary}</span>
+                </div>
+              </div>
+              <div class="meta">
+                <span class="elapsed">${r.elapsed}</span>
+                <span class="count">${r.count}</span>
+              </div>
+            </div>`)}
+        </div>
+        ${this.empty_ ? html`
+          <div id="empty" class="empty">
+            <span class="orbit">${icon('agents', 26)}</span>
+            <div class="empty-title">No agents at work</div>
+            <div class="empty-sub">Start Claude Code or Codex in the Workbench,
+              connect an MCP client, or ask Claude with ⌘J. They show up here
+              live, with their subagents.</div>
+            <button id="openWorkbench" class="btn"
+                @click="${this.onOpenWorkbenchClick_}">
+              ${icon('code', 13)} Open Workbench</button>
+          </div>` : ''}
+        ${this.historyRows_.length ? html`
+          <div id="history">
+            <div class="h-head"><span>Recent sessions</span>
+              <div class="grow"></div>
+              <button id="clearHistory" class="link-btn"
+                  @click="${this.onClearHistoryClick_}">Clear</button></div>
+            ${this.historyRows_.map(h => html`
+              <div class="h-row" data-status="${h.status}">
+                <span class="h-dot"></span>
+                <span class="h-label">${h.label}</span>
+                <span class="h-proj">${h.project}</span>
+                <span class="h-where">${h.where}</span>
+                <span class="h-n">${h.calls}</span>
+                <span class="h-dur">${h.duration}</span>
+                <span class="h-time">${h.time}</span>
+              </div>`)}
+          </div>` : ''}
+      </section>
+      <aside id="detail">
+        ${this.detail_ ? html`
+          <div class="d-head">
+            <div class="d-title">${this.detail_.label}</div>
+            <div class="d-sub">${this.detail_.sub}</div>
+            <span class="pill" data-status="${this.detail_.status}"><i></i>
+              <span>${this.detail_.statusText}</span></span>
+          </div>
+          <dl class="facts">
+            <div><dt>Runs</dt><dd title="${this.detail_.whereTitle}">
+              ${this.detail_.where}</dd></div>
+            <div><dt>Project</dt><dd>${this.detail_.project}</dd></div>
+            <div><dt>Elapsed</dt><dd>${this.detail_.elapsed}</dd></div>
+            <div><dt>${this.detail_.callsLabel}</dt>
+              <dd>${this.detail_.calls}</dd></div>
+          </dl>
+          <div class="actions">
+            ${this.detail_.canReveal ? html`
+              <button id="reveal" class="btn primary"
+                  @click="${this.onRevealClick_}">
+                ${this.detail_.revealLabel}</button>` : ''}
+            ${this.detail_.canDismiss ? html`
+              <button id="dismiss" class="btn"
+                  @click="${this.onDismissClick_}">Dismiss</button>` : ''}
+          </div>
+          <div class="log-title">Recent activity</div>
+          <ol class="log">
+            ${this.detail_.emptyLog ? html`
+              <li class="muted">${this.detail_.emptyLog}</li>` : ''}
+            ${this.detail_.log.map(e => html`
+              <li data-ok="${e.ok}"><i></i><b>${e.name}</b>
+                <span title="${e.summary}">${e.summary}</span>
+                <time>${e.time}</time></li>`)}
+          </ol>` : html`
+          <div class="muted d-empty">Select an agent to see what it’s doing.
+          </div>`}
+      </aside>
+    </div>
+  </div>
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/mission.ts b/chrome/browser/resources/webui_browser/meridian/mission.ts
new file mode 100644
index 0000000000..c332304608
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/mission.ts
@@ -0,0 +1,446 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Mission Control (⇧⌘M): a live tree of every agent working with Meridian
+// (Workbench sessions with their subagents, MCP clients, ⌘J chats), what
+// each is doing, and recent sessions. The browser keeps the state
+// (mission_control.h); this only draws its snapshots.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues, TemplateResult} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './mission.css.js';
+import {getHtml} from './mission.html.js';
+import {icon} from './icons.js';
+
+export interface MissionLog {
+  ts: number;
+  name: string;
+  summary: string|null;
+  ok: boolean|null;
+}
+
+export interface MissionNode {
+  id: string;
+  parentId: string|null;
+  kind: string;
+  source: string;
+  where: string;
+  label: string;
+  sublabel: string|null;
+  project: string|null;
+  status: string;
+  statusText: string|null;
+  tool: {name: string, summary: string|null}|null;
+  toolCalls: number;
+  errors: number;
+  startedAt: number;
+  endedAt: number|null;
+  termId: string|null;
+  turns: number;
+  selfReported: boolean;
+  log: MissionLog[];
+}
+
+export interface MissionHistory {
+  id: string;
+  label: string;
+  source: string;
+  where: string;
+  project: string|null;
+  startedAt: number;
+  endedAt: number;
+  status: string;
+  toolCalls: number;
+  subagents: number;
+}
+
+export interface MissionSnapshot {
+  nodes: MissionNode[];
+  history: MissionHistory[];
+  counts: {working: number, waiting: number, live: number};
+  now: number;
+}
+
+export interface MissionRow {
+  id: string;
+  depth: number;
+  label: string;
+  sublabel: string;
+  where: string;
+  project: string;
+  status: string;
+  statusText: string;
+  toolSummary: string;
+  elapsed: string;
+  count: string;
+  mark: string;
+  icon: TemplateResult|null;
+  live: boolean;
+  ended: boolean;
+  selected: boolean;
+}
+
+export interface MissionDetail {
+  id: string;
+  label: string;
+  sub: string;
+  status: string;
+  statusText: string;
+  where: string;
+  whereTitle: string;
+  project: string;
+  elapsed: string;
+  callsLabel: string;
+  calls: string;
+  canReveal: boolean;
+  revealLabel: string;
+  canDismiss: boolean;
+  log: Array<{name: string, summary: string, time: string, ok: string}>;
+  emptyLog: string;
+}
+
+export interface MissionHistoryRow {
+  label: string;
+  project: string;
+  where: string;
+  calls: string;
+  duration: string;
+  time: string;
+  status: string;
+  source: string;
+}
+
+const MARKS: {[source: string]: string} = {
+  claude: 'C',
+  codex: 'X',
+  gemini: 'G',
+};
+const WHERE: {[where: string]: string} = {
+  local: 'Local',
+  sandbox: 'Sandbox',
+  mcp: 'MCP',
+  assistant: 'Assistant',
+};
+const WHERE_LONG: {[where: string]: string} = {
+  local: 'On this Mac',
+  sandbox: 'Docker sandbox',
+  mcp: 'MCP client',
+  assistant: 'Built-in assistant',
+};
+const STATUS: {[status: string]: string} = {
+  starting: 'Starting',
+  thinking: 'Thinking',
+  tool: 'Running a tool',
+  waiting: 'Waiting for you',
+  idle: 'Idle',
+  done: 'Done',
+  error: 'Error',
+};
+
+function prettyTool(name: string): string {
+  const m = /^mcp__(.+?)__(.+)$/.exec(name || '');
+  return (m ? m[2]! : name || '').replace(/_/g, ' ');
+}
+
+function statusText(n: MissionNode): string {
+  if (n.status === 'tool' && n.tool) {
+    return n.tool.name === 'Compacting' ? 'Compacting context' :
+                                          `Running ${prettyTool(n.tool.name)}`;
+  }
+  return n.statusText || STATUS[n.status] || n.status;
+}
+
+function elapsed(n: MissionNode, now: number): string {
+  const s = Math.max(0, Math.round(((n.endedAt || now) - n.startedAt) / 1000));
+  if (s < 60) {
+    return `${s}s`;
+  }
+  const m = Math.floor(s / 60);
+  if (m < 60) {
+    return `${m}:${String(s % 60).padStart(2, '0')}`;
+  }
+  return `${Math.floor(m / 60)}h ${String(m % 60).padStart(2, '0')}m`;
+}
+
+function calls(n: MissionNode): string {
+  return n.source === 'codex' ?
+      `${n.turns} turn${n.turns === 1 ? '' : 's'}` :
+      `${n.toolCalls} call${n.toolCalls === 1 ? '' : 's'}`;
+}
+
+export class MeridianMissionElement extends CrLitElement {
+  static get is() {
+    return 'meridian-mission';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      snapshot: {type: Object},
+      selected_: {state: true, type: String},
+      tick_: {state: true, type: Number},
+      rows_: {state: true, type: Array},
+      detail_: {state: true, type: Object},
+      historyRows_: {state: true, type: Array},
+      totalCalls_: {state: true, type: Number},
+      empty_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  accessor snapshot: MissionSnapshot|null = null;
+  protected accessor selected_: string = '';
+  protected accessor tick_: number = 0;
+  // Derived in willUpdate().
+  protected accessor rows_: MissionRow[] = [];
+  protected accessor detail_: MissionDetail|null = null;
+  protected accessor historyRows_: MissionHistoryRow[] = [];
+  protected accessor totalCalls_: number = 0;
+  protected accessor empty_: boolean = true;
+
+  private timer_: number|null = null;
+  // The browser's clock minus ours.
+  private skew_: number = 0;
+
+  async show(nodeId: string = '') {
+    if (nodeId) {
+      this.selected_ = nodeId;
+    }
+    this.open = true;
+    const {snapshotJson} =
+        await browserProxyFactory.getInstance().handler.getMissionState();
+    this.snapshot = JSON.parse(snapshotJson) as MissionSnapshot;
+    if (this.timer_ === null) {
+      this.timer_ = setInterval(() => this.tick_++, 1000);
+    }
+    await this.updateComplete;
+    this.shadowRoot.querySelector<HTMLElement>('#card')?.focus();
+  }
+
+  hide() {
+    this.open = false;
+    if (this.timer_ !== null) {
+      clearInterval(this.timer_);
+      this.timer_ = null;
+    }
+  }
+
+  toggle() {
+    if (this.open) {
+      this.hide();
+    } else {
+      this.show();
+    }
+  }
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    const snap = this.snapshot;
+    if (!snap || !Array.isArray(snap.nodes)) {
+      return;
+    }
+    if (changed.has('snapshot')) {
+      this.skew_ = (snap.now || Date.now()) - Date.now();
+    }
+    const now = Date.now() + this.skew_;
+    const byId = new Map(snap.nodes.map(n => [n.id, n]));
+    const kids = new Map<string, MissionNode[]>();
+    const roots: MissionNode[] = [];
+    for (const n of snap.nodes) {
+      if (n.parentId && byId.has(n.parentId)) {
+        if (!kids.has(n.parentId)) {
+          kids.set(n.parentId, []);
+        }
+        kids.get(n.parentId)!.push(n);
+      } else {
+        roots.push(n);
+      }
+    }
+    for (const list of kids.values()) {
+      list.sort((a, b) => a.startedAt - b.startedAt);
+    }
+    roots.sort((a, b) => b.startedAt - a.startedAt);
+    if (this.selected_ && !byId.has(this.selected_)) {
+      this.selected_ = '';
+    }
+    if (!this.selected_ && roots.length) {
+      this.selected_ = (roots.find(r => r.status === 'waiting') ||
+                        roots.find(r => !r.endedAt) || roots[0])!.id;
+    }
+    const rows: MissionRow[] = [];
+    const walk = (list: MissionNode[], depth: number) => {
+      for (const n of list) {
+        const sub = n.kind === 'subagent';
+        rows.push({
+          id: n.id,
+          depth,
+          label: n.label,
+          sublabel: n.sublabel && n.sublabel !== n.label ? n.sublabel : '',
+          where: sub ? '' : WHERE[n.where] || '',
+          project: sub ? '' : n.project || '',
+          status: n.status,
+          statusText: statusText(n),
+          toolSummary: (n.status === 'tool' || n.status === 'waiting') &&
+                  n.tool?.summary ?
+              n.tool.summary :
+              '',
+          elapsed: elapsed(n, now),
+          count: calls(n),
+          mark: sub ? '' : MARKS[n.source] || '',
+          icon: sub                    ? icon('sparkles', 14) :
+              n.source === 'mcp'       ? icon('globe', 13) :
+              n.source === 'assistant' ? icon('bolt', 13) :
+                                         null,
+          live: !n.endedAt &&
+              ['starting', 'thinking', 'tool'].includes(n.status),
+          ended: !!n.endedAt,
+          selected: n.id === this.selected_,
+        });
+        walk(kids.get(n.id) || [], depth + 1);
+      }
+    };
+    walk(roots, 0);
+    this.rows_ = rows;
+    this.empty_ = roots.length === 0;
+    this.totalCalls_ = snap.nodes.reduce(
+        (a, n) => a + (n.source === 'codex' ? 0 : n.toolCalls), 0);
+    const n = byId.get(this.selected_);
+    let root = n;
+    for (let i = 0; i < 20 && root?.parentId; i++) {
+      root = byId.get(root.parentId) || root;
+    }
+    this.detail_ = n ? {
+      id: n.id,
+      label: n.label,
+      sub: [
+        n.sublabel !== n.label ? n.sublabel : null,
+        n.parentId && root ? `in ${root.label}` : null,
+      ].filter(Boolean).join(' · '),
+      status: n.status,
+      statusText: statusText(n),
+      where: WHERE_LONG[n.where] || n.where || '—',
+      whereTitle: n.selfReported ?
+          'The client chose its own name; Meridian can’t verify it.' :
+          '',
+      project: n.project || root?.project || '—',
+      elapsed: elapsed(n, now),
+      callsLabel: n.source === 'codex' ? 'Turns' : 'Tool calls',
+      calls: n.source === 'codex' ?
+          String(n.turns) :
+          `${n.toolCalls}${n.errors ? ` · ${n.errors} failed` : ''}`,
+      canReveal: !!n.termId || n.kind === 'assistant',
+      revealLabel: n.termId ? 'Open terminal' : 'Open chat',
+      canDismiss: !n.parentId && !!n.endedAt,
+      log: n.log.slice().reverse().map(e => ({
+                                         name: prettyTool(e.name),
+                                         summary: e.summary || '',
+                                         time: new Date(e.ts - this.skew_)
+                                                   .toLocaleTimeString(
+                                                       undefined, {
+                                                         hour: 'numeric',
+                                                         minute: '2-digit',
+                                                         second: '2-digit',
+                                                       }),
+                                         ok: e.ok === null ? 'pending' :
+                                                             String(e.ok),
+                                       })),
+      // Shown while the log is empty.
+      emptyLog: n.log.length   ? '' :
+          n.status === 'starting' ? 'Starting up…' :
+                                    'No tool calls yet.',
+    } :
+                    null;
+    this.historyRows_ = (snap.history || []).slice(0, 12).map(h => {
+      const d = Math.max(0, Math.round(((h.endedAt || 0) - (h.startedAt || 0)) /
+                                       1000));
+      return {
+        label: h.label,
+        project: h.project || '',
+        where: WHERE[h.where] || '',
+        calls: `${h.source === 'codex' ? '' : `${h.toolCalls} calls`}${
+            h.subagents ?
+                ` · ${h.subagents} subagent${h.subagents === 1 ? '' : 's'}` :
+                ''}`,
+        duration: d < 60 ? `${d}s` :
+            d < 3600     ? `${Math.floor(d / 60)}m` :
+                           `${Math.floor(d / 3600)}h ${Math.floor((d % 3600) / 60)}m`,
+        time: new Date(h.endedAt).toLocaleTimeString(
+            undefined, {hour: 'numeric', minute: '2-digit'}),
+        status: h.status,
+        source: h.source,
+      };
+    });
+  }
+
+  protected onRowClick_(e: Event) {
+    this.selected_ = (e.currentTarget as HTMLElement).dataset['id'] || '';
+  }
+
+  protected onRowDblclick_(e: Event) {
+    this.reveal_((e.currentTarget as HTMLElement).dataset['id'] || '');
+  }
+
+  protected onRevealClick_() {
+    this.reveal_(this.selected_);
+  }
+
+  private reveal_(id: string) {
+    const n = this.snapshot?.nodes.find(x => x.id === id);
+    if (!n) {
+      return;
+    }
+    this.hide();
+    this.fire('meridian-mission-reveal', {id, assistant: n.kind === 'assistant'});
+  }
+
+  protected onDismissClick_() {
+    browserProxyFactory.getInstance().handler.dismissMission(this.selected_);
+    this.selected_ = '';
+  }
+
+  protected onClearHistoryClick_() {
+    browserProxyFactory.getInstance().handler.clearMissionHistory();
+  }
+
+  protected onOpenWorkbenchClick_() {
+    this.hide();
+    this.fire('meridian-mission-workbench');
+  }
+
+  protected onCloseClick_() {
+    this.hide();
+  }
+
+  protected onOverlayMousedown_(e: MouseEvent) {
+    if (e.target === e.currentTarget) {
+      this.hide();
+    }
+  }
+
+  protected onKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.hide();
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-mission': MeridianMissionElement;
+  }
+}
+
+customElements.define(MeridianMissionElement.is, MeridianMissionElement);
