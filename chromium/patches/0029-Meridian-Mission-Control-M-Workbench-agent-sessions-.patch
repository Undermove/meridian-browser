diff --git a/chrome/browser/meridian/mission/secrets.cc b/chrome/browser/meridian/mission/secrets.cc
new file mode 100644
index 0000000000..319c83dd3a
--- /dev/null
+++ b/chrome/browser/meridian/mission/secrets.cc
@@ -0,0 +1,258 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/mission/secrets.h"
+
+#include <algorithm>
+#include <cmath>
+#include <map>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/meridian/ai/tidy.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace meridian::mission {
+
+namespace {
+
+constexpr char kMask[] = "•••";
+
+struct Known {
+  std::unique_ptr<RE2> re;
+  const char* name;
+  const char* kind;
+};
+
+const std::vector<Known>& KnownFormats() {
+  static const base::NoDestructor<std::vector<Known>> known([] {
+    std::vector<Known> k;
+    auto add = [&](const char* re, const char* name, const char* kind) {
+      k.push_back({std::make_unique<RE2>(re), name, kind});
+    };
+    add("(sk-ant-[A-Za-z0-9_-]{20,})", "ANTHROPIC_API_KEY", "Anthropic API key");
+    add("(sk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,})", "OPENAI_API_KEY",
+        "OpenAI API key");
+    add("(github_pat_[A-Za-z0-9_]{22,})", "GITHUB_TOKEN", "GitHub token");
+    add("(gh[pousr]_[A-Za-z0-9]{30,})", "GITHUB_TOKEN", "GitHub token");
+    add("(glpat-[A-Za-z0-9_-]{20,})", "GITLAB_TOKEN", "GitLab token");
+    add("\\b((?:AKIA|ASIA)[0-9A-Z]{16})\\b", "AWS_ACCESS_KEY_ID",
+        "AWS access key");
+    add("(xox[bpas]-[A-Za-z0-9-]{10,})", "SLACK_TOKEN", "Slack token");
+    add("(AIza[0-9A-Za-z_-]{35})", "GOOGLE_API_KEY", "Google API key");
+    add("(?s)(-----BEGIN (?:[A-Z]+ )?PRIVATE KEY-----.*?(?:-----END "
+        "(?:[A-Z]+ )?PRIVATE KEY-----|\\z))",
+        "PRIVATE_KEY", "private key");
+    return k;
+  }());
+  return *known;
+}
+
+double Entropy(const std::string& s) {
+  std::map<char, int> counts;
+  for (char c : s) {
+    ++counts[c];
+  }
+  double h = 0;
+  for (const auto& [c, n] : counts) {
+    double p = static_cast<double>(n) / s.size();
+    h -= p * std::log2(p);
+  }
+  return h;
+}
+
+bool LooksRandom(const std::string& v) {
+  return v.size() >= 16 && Entropy(v) >= 3.4 &&
+         std::ranges::any_of(v, base::IsAsciiDigit<char>) &&
+         std::ranges::any_of(v, base::IsAsciiAlpha<char>) &&
+         !RE2::PartialMatch(v, "^\\$\\{?[A-Za-z_]");
+}
+
+bool Overlaps(const std::vector<SecretHit>& hits, size_t s, size_t e) {
+  return std::ranges::any_of(
+      hits, [&](const SecretHit& h) { return s < h.end && e > h.start; });
+}
+
+// Replaces every match of `re` (on `s`) with what `fn` returns for it.
+template <typename Fn>
+std::string ReplaceAll(const std::string& s, const RE2& re, Fn fn) {
+  std::string out;
+  std::string_view input(s);
+  size_t last = 0;
+  int groups = re.NumberOfCapturingGroups();
+  std::vector<std::string_view> match(groups + 1);
+  size_t pos = 0;
+  while (pos <= s.size() &&
+         re.Match(input, pos, s.size(), RE2::UNANCHORED, match.data(),
+                  groups + 1)) {
+    size_t start = static_cast<size_t>(match[0].data() - s.data());
+    size_t end = start + match[0].size();
+    out.append(s, last, start - last);
+    out += fn(match);
+    last = end;
+    pos = end > start ? end : end + 1;
+  }
+  out.append(s, last, std::string::npos);
+  return out;
+}
+
+}  // namespace
+
+std::vector<SecretHit> FindSecrets(const std::string& text) {
+  std::vector<SecretHit> out;
+  if (text.empty() || text.size() > 200000) {
+    return out;
+  }
+  for (const Known& k : KnownFormats()) {
+    std::string_view input(text);
+    std::string_view m;
+    size_t pos = 0;
+    while (pos < text.size() && k.re->Match(input, pos, text.size(),
+                                            RE2::UNANCHORED, &m, 1)) {
+      std::string_view whole;
+      k.re->Match(input, pos, text.size(), RE2::UNANCHORED, &whole, 1);
+      std::string_view group[2];
+      k.re->Match(input, pos, text.size(), RE2::UNANCHORED, group, 2);
+      size_t start = static_cast<size_t>(group[1].data() - text.data());
+      size_t end = start + group[1].size();
+      if (!Overlaps(out, start, end)) {
+        out.push_back({start, end, std::string(group[1]), k.name, k.kind});
+      }
+      size_t whole_end =
+          static_cast<size_t>(group[0].data() - text.data()) + group[0].size();
+      pos = whole_end > pos ? whole_end : pos + 1;
+    }
+  }
+  static const base::NoDestructor<RE2> assign(
+      "(?i)\\b([A-Za-z_][A-Za-z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD|PWD|"
+      "CREDENTIALS?|AUTH))\\s*[=:]\\s*[\"']?([^\\s\"'`]{16,})");
+  std::string_view input(text);
+  std::string_view g[3];
+  size_t pos = 0;
+  while (pos < text.size() &&
+         assign->Match(input, pos, text.size(), RE2::UNANCHORED, g, 3)) {
+    size_t start = static_cast<size_t>(g[2].data() - text.data());
+    size_t end = start + g[2].size();
+    std::string name = base::ToUpperASCII(g[1]);
+    pos = end;
+    if (Overlaps(out, start, end)) {
+      // A known token assigned to a name: prefer the name the person gave it.
+      for (SecretHit& h : out) {
+        if (start < h.end && end > h.start) {
+          h.name = name;
+        }
+      }
+      continue;
+    }
+    std::string value(g[2]);
+    if (LooksRandom(value)) {
+      out.push_back({start, end, value, name, "credential"});
+    }
+  }
+  std::ranges::sort(out, {}, &SecretHit::start);
+  return out;
+}
+
+std::string Redact(const std::string& text,
+                   const std::vector<NamedSecret>& secrets) {
+  std::string s = text;
+  // Exact vault values first, longest first (so prefixes leave no tails).
+  std::vector<NamedSecret> sorted;
+  for (const NamedSecret& v : secrets) {
+    if (v.value.size() >= 6) {
+      sorted.push_back(v);
+    }
+  }
+  std::ranges::sort(sorted, [](const NamedSecret& a, const NamedSecret& b) {
+    return a.value.size() > b.value.size();
+  });
+  for (const NamedSecret& v : sorted) {
+    base::ReplaceSubstringsAfterOffset(&s, 0, v.value, "$" + v.name);
+  }
+  std::vector<SecretHit> hits = FindSecrets(s);
+  for (auto it = hits.rbegin(); it != hits.rend(); ++it) {
+    s.replace(it->start, it->end - it->start, kMask);
+  }
+  static const base::NoDestructor<RE2> secret_name(
+      "(?i)(KEY|TOKEN|SECRET|PASSWORD|PASSWD|PWD|PASS|CREDENTIALS?|AUTH|"
+      "COOKIE|SESSION|PRIVATE|SIGNATURE)");
+  struct Rule {
+    const char* re;
+    // "" = replace the whole match with the mask after keeping group 1.
+    bool keep_first;
+  };
+  // Authorization schemes first (before NAME: value eats the scheme word).
+  s = ReplaceAll(s, RE2("(?i)\\b(Bearer|Basic|Token)\\s+[A-Za-z0-9._~+/=-]{8,}"),
+                 [](auto& m) { return std::string(m[1]) + " " + kMask; });
+  s = ReplaceAll(
+      s,
+      RE2("\\b([A-Za-z_][\\w.-]*)(\\s*[=:]\\s*)(\"[^\"]*\"|'[^']*'|[^\\s\"'`&;|]+)"),
+      [](auto& m) {
+        std::string name(m[1]), sep(m[2]), val(m[3]);
+        if (RE2::PartialMatch(name, *secret_name) && val != kMask &&
+            !RE2::FullMatch(val, "\\$\\{?\\w+\\}?")) {
+          return name + sep + kMask;
+        }
+        return std::string(m[0]);
+      });
+  s = ReplaceAll(s, RE2("(?i)(\\b[a-z][a-z0-9+.-]*://)([^\\s/@:]+):([^\\s/@]+)@"),
+                 [](auto& m) {
+                   return std::string(m[1]) + std::string(m[2]) + ":" + kMask +
+                          "@";
+                 });
+  s = ReplaceAll(
+      s,
+      RE2("(?i)([?&](?:access_token|token|key|api_key|apikey|secret|sig|"
+          "signature|password|auth|code)=)[^&\\s#\"']+"),
+      [](auto& m) { return std::string(m[1]) + kMask; });
+  s = ReplaceAll(
+      s,
+      RE2("(?i)(--?(?:password|passwd|token|secret|api-key|apikey)(?:\\s+|=))("
+          "\"[^\"]*\"|'[^']*'|\\S+)"),
+      [](auto& m) { return std::string(m[1]) + kMask; });
+  s = ReplaceAll(
+      s,
+      RE2("((?:^|\\s)(?:-u|--user)(?:\\s+|=)[\"']?[^\\s:\"']+:)(\"[^\"]*\"|'["
+          "^']*'|[^\\s\"']+)"),
+      [](auto& m) { return std::string(m[1]) + kMask; });
+  s = ReplaceAll(
+      s,
+      RE2("(?i)(\\b(?:mysql|mysqldump|mariadb|mysqladmin)\\b[^|;&]*?\\s-p)([^\\s-]"
+          "[^\\s]*)"),
+      [](auto& m) { return std::string(m[1]) + kMask; });
+  s = ReplaceAll(
+      s,
+      RE2("(?i)(\\b(?:(?:docker|podman|nerdctl|oras|skopeo|helm(?:\\s+registry)"
+          "?)\\s+login|sshpass)\\b[^|;&]*?\\s-p\\s+)(\"[^\"]*\"|'[^']*'|\\S+)"),
+      [](auto& m) { return std::string(m[1]) + kMask; });
+  s = ReplaceAll(s, RE2("\\b(?:sk|rk|pk|whsec)_(?:live|test)_[A-Za-z0-9]{10,}"),
+                 [](auto&) { return std::string(kMask); });
+  s = ReplaceAll(
+      s, RE2("\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{4,}"),
+      [](auto&) { return std::string(kMask); });
+  // Long opaque strings: masked, except short git SHAs.
+  s = ReplaceAll(s, RE2("\\b[A-Za-z0-9+/_-]{40,}={0,2}"), [](auto& m) {
+    std::string v(m[0]);
+    return RE2::FullMatch(v, "(?i)[a-f0-9]{40}") ? v.substr(0, 10)
+                                                  : std::string(kMask);
+  });
+  return s;
+}
+
+std::string Clean(const std::string& text,
+                  size_t max,
+                  const std::vector<NamedSecret>& secrets) {
+  std::string one = ai::OneLine(text, max * 2);
+  if (one.empty()) {
+    return one;
+  }
+  std::u16string r = base::UTF8ToUTF16(Redact(one, secrets));
+  if (r.size() > max) {
+    r = r.substr(0, max - 1) + u"…";
+  }
+  return base::UTF16ToUTF8(r);
+}
+
+}  // namespace meridian::mission
