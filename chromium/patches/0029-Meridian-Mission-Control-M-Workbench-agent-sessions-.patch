diff --git a/chrome/browser/meridian/mission/mission_hook.cc b/chrome/browser/meridian/mission/mission_hook.cc
new file mode 100644
index 0000000000..8f0abb2d0c
--- /dev/null
+++ b/chrome/browser/meridian/mission/mission_hook.cc
@@ -0,0 +1,295 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/mission/mission_hook.h"
+
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <iterator>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "url/gurl.h"
+
+namespace meridian::mission {
+
+namespace {
+
+constexpr std::string_view kSwitch = "--mission-hook";
+
+base::span<const char*> Args(int argc, const char** argv) {
+  // SAFETY: main() gives `argc` arguments in `argv`.
+  return UNSAFE_BUFFERS(base::span(argv, static_cast<size_t>(argc)));
+}
+
+// One line, no control characters, at most `n` bytes (on a character
+// boundary).
+std::optional<std::string> Str(const base::Value* v, size_t n) {
+  if (!v || !v->is_string()) {
+    return std::nullopt;
+  }
+  std::string s;
+  bool space = false;
+  for (char c : v->GetString()) {
+    if (static_cast<unsigned char>(c) < 0x20 || c == 0x7f) {
+      space = !s.empty();
+      continue;
+    }
+    if (space) {
+      s += ' ';
+      space = false;
+    }
+    s += c;
+  }
+  if (s.size() > n) {
+    size_t cut = n;
+    while (cut > 0 && (s[cut] & 0xc0) == 0x80) {
+      --cut;
+    }
+    s.resize(cut);
+  }
+  if (s.empty()) {
+    return std::nullopt;
+  }
+  return s;
+}
+
+std::optional<std::string> Host(const base::Value* v) {
+  if (!v || !v->is_string()) {
+    return std::nullopt;
+  }
+  GURL url(v->GetString());
+  if (!url.is_valid() || url.host().empty()) {
+    return std::nullopt;
+  }
+  return std::string(url.host());
+}
+
+std::optional<std::string> Rel(const base::Value* v, const std::string& cwd) {
+  if (!v || !v->is_string() || v->GetString().empty()) {
+    return std::nullopt;
+  }
+  base::FilePath path(v->GetString());
+  std::string r = path.value();
+  if (!cwd.empty() && path.IsAbsolute()) {
+    base::FilePath rel;
+    r = base::FilePath(cwd).AppendRelativePath(path, &rel)
+            ? rel.value()
+            : path.BaseName().value();
+  }
+  if (r.size() > 120) {
+    r = r.substr(r.size() - 120);
+  }
+  return r;
+}
+
+// A short, human summary of a tool call. Deliberately lossy.
+std::optional<std::string> Summarize(const std::string& tool,
+                                     const base::DictValue& input,
+                                     const std::string& cwd) {
+  if (tool == "Bash" || tool == "BashOutput") {
+    const std::string* command = input.FindString("command");
+    if (!command) {
+      return std::nullopt;
+    }
+    std::string head = command->substr(0, command->find('\n'));
+    return "$ " + head.substr(0, 140);
+  }
+  if (tool == "Read" || tool == "Write" || tool == "Edit" ||
+      tool == "MultiEdit" || tool == "NotebookRead" || tool == "NotebookEdit") {
+    const base::Value* p = input.Find("file_path");
+    return Rel(p ? p : input.Find("notebook_path"), cwd);
+  }
+  if (tool == "Grep") {
+    std::optional<std::string> pattern = Str(input.Find("pattern"), 60);
+    if (!pattern) {
+      return std::nullopt;
+    }
+    std::optional<std::string> in = Rel(input.Find("path"), cwd);
+    return "“" + *pattern + "”" + (in ? " in " + *in : "");
+  }
+  if (tool == "Glob") {
+    return Str(input.Find("pattern"), 100);
+  }
+  if (tool == "WebFetch") {
+    return Host(input.Find("url"));
+  }
+  if (tool == "WebSearch") {
+    return Str(input.Find("query"), 100);
+  }
+  if (tool == "Agent" || tool == "Task") {
+    return Str(input.Find("description"), 120);
+  }
+  if (tool == "TodoWrite") {
+    const base::ListValue* todos = input.FindList("todos");
+    return todos ? std::optional<std::string>(
+                       std::to_string(todos->size()) + " to-dos")
+                 : std::nullopt;
+  }
+  if (tool == "Skill") {
+    const base::Value* s = input.Find("skill");
+    return Str(s ? s : input.Find("command"), 60);
+  }
+  if (tool.starts_with("mcp__")) {
+    size_t sep = tool.find("__", 5);
+    if (sep != std::string::npos) {
+      std::string out = tool.substr(5, sep - 5) + " › " + tool.substr(sep + 2);
+      if (std::optional<std::string> host = Host(input.Find("url"))) {
+        out += " · " + *host;
+      }
+      return out;
+    }
+  }
+  return std::nullopt;
+}
+
+void SetIf(base::DictValue& d, const char* key, std::optional<std::string> v) {
+  if (v) {
+    d.Set(key, *v);
+  }
+}
+
+void Send(base::DictValue line) {
+  const char* token = getenv("MERIDIAN_MISSION_TOKEN");
+  const char* socket_path = getenv("MERIDIAN_MISSION_SOCKET");
+  if (!token || !socket_path) {
+    return;
+  }
+  line.Set("v", 1);
+  line.Set("token", token);
+  std::string payload = base::WriteJson(line).value_or("") + "\n";
+  sockaddr_un addr = {};
+  if (payload.size() > 16000 ||
+      strlen(socket_path) >= sizeof(addr.sun_path)) {
+    return;
+  }
+  int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (fd < 0) {
+    return;
+  }
+  addr.sun_family = AF_UNIX;
+  base::span(addr.sun_path).copy_prefix_from(
+      base::span(std::string_view(socket_path)));
+  if (connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) == 0) {
+    std::string_view rest(payload);
+    while (!rest.empty()) {
+      ssize_t n = write(fd, rest.data(), rest.size());
+      if (n <= 0) {
+        break;
+      }
+      rest.remove_prefix(static_cast<size_t>(n));
+    }
+  }
+  close(fd);
+}
+
+}  // namespace
+
+bool IsMissionHook(int argc, const char** argv) {
+  for (const char* arg : Args(argc, argv).subspan(1u)) {
+    if (std::string_view(arg) == kSwitch) {
+      return true;
+    }
+  }
+  return false;
+}
+
+base::DictValue FromClaudeEvent(const base::DictValue& ev) {
+  std::optional<std::string> tool = Str(ev.Find("tool_name"), 80);
+  const base::DictValue* raw_input = ev.FindDict("tool_input");
+  base::DictValue empty;
+  const base::DictValue& input = raw_input ? *raw_input : empty;
+  const std::string* cwd_value = ev.FindString("cwd");
+  std::string cwd = cwd_value ? *cwd_value : std::string();
+  std::optional<std::string> event = Str(ev.Find("hook_event_name"), 40);
+  base::DictValue out;
+  out.Set("kind", "claude");
+  SetIf(out, "event", event);
+  SetIf(out, "session_id", Str(ev.Find("session_id"), 80));
+  SetIf(out, "agent_id", Str(ev.Find("agent_id"), 80));
+  SetIf(out, "agent_type", Str(ev.Find("agent_type"), 60));
+  SetIf(out, "tool", tool);
+  SetIf(out, "tool_use_id", Str(ev.Find("tool_use_id"), 80));
+  if (tool) {
+    SetIf(out, "summary", Summarize(*tool, input, cwd));
+  }
+  SetIf(out, "source", Str(ev.Find("source"), 20));
+  SetIf(out, "reason", Str(ev.Find("reason"), 40));
+  SetIf(out, "notification_type", Str(ev.Find("notification_type"), 40));
+  if (event == "Notification") {
+    SetIf(out, "message", Str(ev.Find("message"), 200));
+  }
+  const base::Value* model = ev.Find("model");
+  if (model && model->is_dict()) {
+    model = model->GetDict().Find("id");
+  }
+  SetIf(out, "model", Str(model, 60));
+  if (event == "PostToolUseFailure" || event == "StopFailure") {
+    out.Set("error", true);
+  }
+  if (!cwd.empty()) {
+    base::Value name(base::FilePath(cwd).BaseName().value());
+    SetIf(out, "cwd_name", Str(&name, 80));
+  }
+  if (tool == "Agent" || tool == "Task") {
+    SetIf(out, "description", Str(input.Find("description"), 120));
+    SetIf(out, "subagent_type", Str(input.Find("subagent_type"), 60));
+    if (input.FindBool("run_in_background").value_or(false)) {
+      out.Set("background", true);
+    }
+  }
+  return out;
+}
+
+base::DictValue FromCodexEvent(const std::string& json) {
+  std::optional<base::Value> v = base::JSONReader::Read(json, 0);
+  base::DictValue ev = v && v->is_dict() ? std::move(v->GetDict())
+                                         : base::DictValue();
+  base::DictValue out;
+  out.Set("kind", "codex");
+  const std::string* type = ev.FindString("type");
+  out.Set("event", type && *type == "agent-turn-complete"
+                       ? std::string("TurnComplete")
+                       : Str(ev.Find("type"), 40).value_or("Notify"));
+  SetIf(out, "session_id", Str(ev.Find("thread-id"), 80));
+  if (const std::string* cwd = ev.FindString("cwd")) {
+    base::Value name(base::FilePath(*cwd).BaseName().value());
+    SetIf(out, "cwd_name", Str(&name, 80));
+  }
+  return out;
+}
+
+int RunMissionHook(int argc, const char** argv) {
+  base::span<const char*> args = Args(argc, argv);
+  bool codex = false;
+  for (const char* a : args) {
+    codex |= std::string_view(a) == "--codex";
+  }
+  if (codex) {
+    Send(FromCodexEvent(args.size() > 1 ? args.back() : ""));
+    return 0;
+  }
+  std::string input;
+  for (int c = std::cin.get(); c != EOF; c = std::cin.get()) {
+    input += static_cast<char>(c);
+    if (input.size() > 1000000) {
+      return 0;
+    }
+  }
+  std::optional<base::Value> ev = base::JSONReader::Read(input, 0);
+  if (ev && ev->is_dict()) {
+    Send(FromClaudeEvent(ev->GetDict()));
+  }
+  return 0;
+}
+
+}  // namespace meridian::mission
