+constexpr size_t kLogMax = 30;
+constexpr size_t kHistoryMax = 40;
+constexpr size_t kLiveMax = 300;
+constexpr size_t kSubtreeMax = 100;
+constexpr double kNotifyGapMs = 15000;
+constexpr double kLingerMs = 20000;
+constexpr double kMcpIdleMs = 10 * 60000;
+constexpr double kAssistantIdleMs = 3 * 60000;
+
+double Now() {
+  return base::Time::Now().InMillisecondsFSinceUnixEpoch();
+}
+
+bool Working(const std::string& status) {
+  return status == "starting" || status == "thinking" || status == "tool";
+}
+
+std::string RandomId(size_t bytes) {
+  return base::HexEncodeLower(base::RandBytesAsVector(bytes));
+}
+
+std::string HostOf(const std::string* url) {
+  if (!url) {
+    return std::string();
+  }
+  GURL u(*url);
+  return u.is_valid() ? std::string(u.host()) : url->substr(0, 60);
+}
+
+// A short safe summary of a browser tool call: never typed text or code.
+std::string BrowserSummary(const std::string& name, const base::DictValue& i) {
+  auto str = [&](const char* key, size_t n) {
+    const std::string* s = i.FindString(key);
+    return s ? s->substr(0, n) : std::string();
+  };
+  if (name == "open_tab" || name == "navigate") {
+    return HostOf(i.FindString("url"));
+  }
+  if (name == "type_text") {
+    const std::string* v = i.FindString("value");
+    return base::NumberToString(v ? base::UTF8ToUTF16(*v).size() : 0) +
+           " characters" +
+           (i.FindBool("submit").value_or(false) ? " + Enter" : "");
+  }
+  if (name == "click") {
+    if (std::optional<int> index = i.FindInt("element_index")) {
+      return "element #" + base::NumberToString(*index);
+    }
+    if (const std::string* text = i.FindString("text")) {
+      return "“" + text->substr(0, 40) + "”";
+    }
+    return i.Find("selector") ? "selector" : "";
+  }
+  if (name == "search_tabs" || name == "search_history") {
+    return i.FindString("query") ? "“" + str("query", 50) + "”" : "";
+  }
+  if (name == "press_key") {
+    return str("key", 20);
+  }
+  if (name == "scroll") {
+    return str("direction", 20);
+  }
+  if (name == "history_nav") {
+    return str("action", 20);
+  }
+  if (name == "organize_tab") {
+    std::string a = str("action", 30);
+    std::ranges::replace(a, '_', ' ');
+    return a;
+  }
+  if (name == "create_space") {
+    return str("name", 40);
+  }
+  if (name == "run_javascript") {
+    const std::string* code = i.FindString("code");
+    return base::NumberToString(code ? code->size() : 0) +
+           " chars of JavaScript";
+  }
+  if (name == "wait_for") {
+    if (i.FindString("text")) {
+      return "“" + str("text", 30) + "”";
+    }
+    return i.Find("selector") ? "selector" : "";
+  }
+  return std::string();
+}
+
+base::Value OptString(const std::string& s) {
+  return s.empty() ? base::Value() : base::Value(s);
+}
