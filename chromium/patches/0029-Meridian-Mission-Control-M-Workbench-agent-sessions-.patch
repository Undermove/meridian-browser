+
+#include "base/containers/span.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#include "base/json/json_reader.h"
+#include "base/memory/ref_counted.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_view_util.h"
+#include "base/synchronization/lock.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/time/time.h"
+#include "crypto/secure_util.h"
+
+namespace meridian::mission {
+
+namespace {
+
+constexpr size_t kMaxLine = 16 * 1024;
+constexpr size_t kMaxConnection = 64 * 1024;
+constexpr size_t kMaxClients = 64;
+constexpr base::TimeDelta kClientTimeout = base::Seconds(3);
+constexpr double kBurst = 200;
+constexpr double kPerSecond = 60;
+
+void SetNonBlocking(int fd) {
+  int flags = fcntl(fd, F_GETFL);
+  if (flags != -1) {
+    fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+  }
+  fcntl(fd, F_SETFD, FD_CLOEXEC);
+}
+
+}  // namespace
+
+// Accepts connections and reads lines on a blocking thread-pool task.
+class EventChannel::Server : public base::RefCountedThreadSafe<Server> {
+ public:
+  explicit Server(EventCallback on_event) : on_event_(std::move(on_event)) {}
+
+  // Blocking: creates the socket and serves until Stop().
+  void Run(base::OnceCallback<void(base::FilePath)> started) {
+    base::ScopedBlockingCall blocking(FROM_HERE,
+                                      base::BlockingType::WILL_BLOCK);
+    base::FilePath dir;
+    if (!base::CreateNewTempDirectory("mm-", &dir)) {
+      std::move(started).Run(base::FilePath());
+      return;
+    }
+    base::SetPosixFilePermissions(dir, 0700);
+    dir_ = dir;
+    base::FilePath path = dir.Append("events.sock");
+    base::ScopedFD listener(socket(AF_UNIX, SOCK_STREAM, 0));
+    sockaddr_un addr = {};
+    addr.sun_family = AF_UNIX;
+    if (!listener.is_valid() ||
+        path.value().size() >= sizeof(addr.sun_path)) {
+      std::move(started).Run(base::FilePath());
+      return;
+    }
+    base::span(addr.sun_path)
+        .copy_prefix_from(base::span(std::string_view(path.value())));
+    if (bind(listener.get(), reinterpret_cast<sockaddr*>(&addr),
+             sizeof(addr)) != 0 ||
+        listen(listener.get(), 16) != 0) {
+      std::move(started).Run(base::FilePath());
+      return;
+    }
+    base::SetPosixFilePermissions(path, 0600);
+    SetNonBlocking(listener.get());
+    int wake[2];
+    if (pipe(wake) != 0) {
+      std::move(started).Run(base::FilePath());
+      return;
+    }
+    wake_read_.reset(wake[0]);
+    wake_write_ = wake[1];
+    SetNonBlocking(wake_read_.get());
+    std::move(started).Run(path);
+
+    struct Client {
+      base::ScopedFD fd;
+      std::string buffer;
+      size_t total = 0;
+      base::TimeTicks deadline;
+    };
+    std::vector<Client> clients;
+    std::array<char, 8192> chunk;
+    while (!stop_) {
+      std::vector<pollfd> fds = {{listener.get(), POLLIN, 0},
+                                 {wake_read_.get(), POLLIN, 0}};
+      for (const Client& c : clients) {
+        fds.push_back({c.fd.get(), POLLIN, 0});
+      }
+      HANDLE_EINTR(poll(fds.data(), fds.size(), 500));
+      base::TimeTicks now = base::TimeTicks::Now();
+      // The clients polled this round (a new one joins after them).
+      const size_t polled = clients.size();
+      if (fds[0].revents & POLLIN) {
+        base::ScopedFD client(HANDLE_EINTR(accept(listener.get(), nullptr, nullptr)));
+        if (client.is_valid() && clients.size() < kMaxClients) {
+          SetNonBlocking(client.get());
+          clients.push_back({std::move(client), std::string(), 0,
+                             now + kClientTimeout});
+        }
+      }
+      for (size_t i = 0; i < polled; ++i) {
+        Client& c = clients[i];
+        bool close_it = now > c.deadline;
+        if (!close_it && (fds[i + 2].revents & (POLLIN | POLLHUP | POLLERR))) {
+          ssize_t n = HANDLE_EINTR(read(c.fd.get(), chunk.data(), chunk.size()));
+          if (n > 0) {
+            c.total += static_cast<size_t>(n);
+            c.buffer.append(base::as_string_view(
+                base::span(chunk).first(static_cast<size_t>(n))));
+            size_t nl;
+            while ((nl = c.buffer.find('\n')) != std::string::npos) {
+              Accept(c.buffer.substr(0, nl));
+              c.buffer.erase(0, nl + 1);
+            }
+            close_it = c.total > kMaxConnection || c.buffer.size() > kMaxLine;
+          } else if (n == 0 || errno != EAGAIN) {
+            if (!c.buffer.empty()) {
+              Accept(c.buffer);
+            }
+            close_it = true;
+          }
+        }
+        if (close_it) {
+          c.fd.reset();
+        }
+      }
+      std::erase_if(clients, [](const Client& c) { return !c.fd.is_valid(); });
+    }
+    listener.reset();
+    base::DeletePathRecursively(dir_);
+  }
+
+  void Stop() {
+    stop_ = true;
+    if (wake_write_ >= 0) {
+      char c = 0;
+      HANDLE_EINTR(write(wake_write_, &c, 1));
+    }
+  }
+
+  std::string Register(const std::string& session) {
+    std::string token = base::HexEncodeLower(base::RandBytesAsVector(32));
+    base::AutoLock hold(lock_);
+    sessions_[token] = {session, kBurst, base::TimeTicks::Now()};
+    return token;
+  }
+
+  void Unregister(const std::string& token) {
+    base::AutoLock hold(lock_);
+    sessions_.erase(token);
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<Server>;
+  ~Server() {
+    if (wake_write_ >= 0) {
+      close(wake_write_);
+    }
+  }
+
+  struct Session {
+    std::string id;
+    double bucket;
+    base::TimeTicks at;
+  };
+
+  void Accept(const std::string& line) {
+    if (line.empty() || line.size() > kMaxLine) {
+      return;
+    }
+    std::optional<base::Value> v = base::JSONReader::Read(line, 0);
+    if (!v || !v->is_dict()) {
+      return;
+    }
+    base::DictValue event = std::move(v->GetDict());
+    const std::string* given = event.FindString("token");
+    if (!given || given->size() != 64) {
+      return;
+    }
+    std::string session;
+    {
+      base::AutoLock hold(lock_);
+      Session* found = nullptr;
+      for (auto& [token, s] : sessions_) {
+        if (crypto::SecureMemEqual(base::as_byte_span(token),
+                                   base::as_byte_span(*given))) {
+          found = &s;
+        }
+      }
+      if (!found) {
+        return;
+      }
+      base::TimeTicks now = base::TimeTicks::Now();
+      found->bucket = std::min(
+          kBurst, found->bucket + (now - found->at).InSecondsF() * kPerSecond);
+      found->at = now;
+      if (found->bucket < 1) {
+        return;
+      }
+      found->bucket -= 1;
+      session = found->id;
+    }
+    event.Remove("token");
+    on_event_.Run(session, std::move(event));
+  }
+
+  EventCallback on_event_;
+  std::atomic<bool> stop_{false};
+  base::FilePath dir_;
+  base::ScopedFD wake_read_;
+  int wake_write_ = -1;
+  base::Lock lock_;
+  std::map<std::string, Session> sessions_;
+};
+
+EventChannel::EventChannel(EventCallback on_event)
+    : server_(base::MakeRefCounted<Server>(
+          base::BindPostTaskToCurrentDefault(std::move(on_event)))) {}
+
+EventChannel::~EventChannel() {
+  server_->Stop();
+}
+
+void EventChannel::Start(base::OnceCallback<void(base::FilePath)> done) {
+  if (!socket_path_.empty()) {
+    std::move(done).Run(socket_path_);
+    return;
+  }
+  waiting_.push_back(std::move(done));
+  if (starting_) {
+    return;
+  }
+  starting_ = true;
+  auto started = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::WeakPtr<EventChannel> self, base::FilePath path) {
+        if (!self) {
+          return;
+        }
+        self->socket_path_ = path;
+        self->starting_ = path.empty() ? false : self->starting_;
+        for (auto& w : self->waiting_) {
+          std::move(w).Run(path);
+        }
+        self->waiting_.clear();
+      },
+      weak_factory_.GetWeakPtr()));
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&Server::Run, server_, std::move(started)));
+}
+
+std::string EventChannel::Register(const std::string& session) {
+  return server_->Register(session);
+}
+
+void EventChannel::Unregister(const std::string& token) {
+  server_->Unregister(token);
+}
+
+}  // namespace meridian::mission
