+}
+
+TEST(MissionHookTest, SummarizesWithoutInputs) {
+  base::DictValue line = FromClaudeEvent(Parse(R"({
+    "hook_event_name": "PreToolUse", "session_id": "s1", "tool_name": "Bash",
+    "tool_use_id": "tu1", "cwd": "/Users/me/proj",
+    "tool_input": {"command": "npm test\nsecond line", "env": "SECRET=1"}})"));
+  EXPECT_EQ(*line.FindString("event"), "PreToolUse");
+  EXPECT_EQ(*line.FindString("summary"), "$ npm test");
+  EXPECT_EQ(*line.FindString("cwd_name"), "proj");
+  EXPECT_FALSE(line.Find("tool_input"));
+
+  line = FromClaudeEvent(Parse(R"({"hook_event_name": "PostToolUse",
+    "tool_name": "Edit", "cwd": "/Users/me/proj",
+    "tool_input": {"file_path": "/Users/me/proj/src/app.js"}})"));
+  EXPECT_EQ(*line.FindString("summary"), "src/app.js");
+
+  line = FromClaudeEvent(Parse(R"({"hook_event_name": "PreToolUse",
+    "tool_name": "Agent", "tool_input": {"description": "Find bugs",
+    "subagent_type": "reviewer", "run_in_background": true, "prompt": "x"}})"));
+  EXPECT_EQ(*line.FindString("description"), "Find bugs");
+  EXPECT_TRUE(line.FindBool("background").value_or(false));
+  EXPECT_FALSE(line.Find("prompt"));
+
+  line = FromClaudeEvent(Parse(R"({"hook_event_name": "PreToolUse",
+    "tool_name": "mcp__meridian__navigate",
+    "tool_input": {"url": "https://example.com/a?token=x"}})"));
+  EXPECT_EQ(*line.FindString("summary"), "meridian › navigate · example.com");
+}
+
+TEST(MissionHookTest, CodexTurns) {
+  base::DictValue line = FromCodexEvent(
+      R"({"type": "agent-turn-complete", "thread-id": "t9", "cwd": "/x/site"})");
+  EXPECT_EQ(*line.FindString("event"), "TurnComplete");
+  EXPECT_EQ(*line.FindString("cwd_name"), "site");
+}
