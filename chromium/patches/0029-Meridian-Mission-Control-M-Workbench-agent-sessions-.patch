+    call->reply = base::BindOnce(
+        [](base::WeakPtr<mission::MissionControl> mission, int id,
+           Reply reply, base::DictValue response) {
+          if (mission) {
+            mission->HubCallEnd(id, !response.Find("error"), std::string());
+          }
+          std::move(reply).Run(std::move(response));
+        },
+        mission->GetWeakPtr(), id, std::move(call->reply));
+  }
   Run(std::move(call));
