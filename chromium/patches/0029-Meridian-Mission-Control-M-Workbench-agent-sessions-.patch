+// static
+void SidebarHandler::ShowMissionControl(Profile* profile,
+                                        const std::string& node_id) {
+  for (auto& [browser, handler] : Handlers()) {
+    if (browser->GetProfile() == profile && handler->page_.is_connected()) {
+      handler->page_->ShowMission(node_id);
+      return;
+    }
+  }
+}
+
+void SidebarHandler::OnMissionChanged(const base::DictValue& snapshot) {
+  if (page_.is_connected()) {
+    page_->OnMissionState(base::WriteJson(snapshot).value_or("{}"));
+  }
+}
+
+void SidebarHandler::OnMissionToast(const std::string& node_id,
+                                    const std::string& title,
+                                    const std::string& body) {
+  // In the frontmost window only (a notice about notifications goes to every
+  // window: the session may have been started from a background one).
+  if (page_.is_connected() && (browser_->IsActive() || node_id.empty())) {
+    page_->OnMissionToast(node_id, title, body);
+  }
+}
+
+void SidebarHandler::GetMissionState(GetMissionStateCallback callback) {
+  mission::MissionControl* mission =
+      mission::MissionControlFactory::GetForProfile(browser_->GetProfile());
+  std::move(callback).Run(
+      mission ? base::WriteJson(mission->Snapshot()).value_or("{}") : "{}");
+}
+
+void SidebarHandler::RevealMissionNode(const std::string& id,
+                                       RevealMissionNodeCallback callback) {
+  mission::MissionControl* mission =
+      mission::MissionControlFactory::GetForProfile(browser_->GetProfile());
+  std::optional<std::pair<int, std::string>> where =
+      mission ? mission->TerminalOf(id) : std::nullopt;
+  tabs::TabInterface* tab =
+      where ? tabs::TabHandle(where->first).Get() : nullptr;
+  if (!tab || tab->GetBrowserWindowInterface() != browser_.get()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (const TabData* data = TabData::Get(tab->GetContents());
+      data && data->space_id() != service_->active_space_id()) {
+    service_->SetActiveSpace(data->space_id());
+  }
+  model()->ActivateTabAt(model()->GetIndexOfTab(tab));
+  workbench::WorkbenchHandler::FocusTerminal(tab->GetContents(), where->second);
+  std::move(callback).Run(true);
+}
+
+void SidebarHandler::DismissMission(const std::string& id) {
+  if (mission::MissionControl* mission =
+          mission::MissionControlFactory::GetForProfile(
+              browser_->GetProfile())) {
+    mission->Dismiss(id);
+  }
+}
+
+void SidebarHandler::ClearMissionHistory() {
+  if (mission::MissionControl* mission =
+          mission::MissionControlFactory::GetForProfile(
+              browser_->GetProfile())) {
+    mission->ClearHistory();
+  }
+}
