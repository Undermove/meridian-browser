@@ -0,0 +1,47 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/mission/secrets.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::mission {
+namespace {
+
+TEST(SecretsTest, FindsKnownTokensAndRandomAssignments) {
+  std::vector<SecretHit> hits = FindSecrets(
+      "export MY_SERVICE_TOKEN=Zq8vR2kLm9Xa4Wt7Pb3N and sk-ant-api03-"
+      "abcdefghijklmnopqrstuv0123 plus PORT=3000 PASSWORD=password");
+  ASSERT_EQ(hits.size(), 2u);
+  EXPECT_EQ(hits[0].name, "MY_SERVICE_TOKEN");
+  EXPECT_EQ(hits[0].value, "Zq8vR2kLm9Xa4Wt7Pb3N");
+  EXPECT_EQ(hits[1].name, "ANTHROPIC_API_KEY");
+  // A known token assigned to a name keeps the person's name.
+  hits = FindSecrets("OPENAI=sk-proj-abcdefghijklmnopqrstuvwx");
+  ASSERT_EQ(hits.size(), 1u);
+}
+
+TEST(SecretsTest, RedactsSummaries) {
+  EXPECT_EQ(Redact("API_KEY=hunter2 npm test", {}), "API_KEY=••• npm test");
+  EXPECT_EQ(Redact("curl -H \"Authorization: Bearer abcdefghijkl\" x", {}),
+            "curl -H \"Authorization: ••• •••\" x");
+  EXPECT_EQ(Redact("git clone https://me:pa55w0rd@github.com/x", {}),
+            "git clone https://me:•••@github.com/x");
+  EXPECT_EQ(Redact("open https://x.io/?token=abc123&q=1", {}),
+            "open https://x.io/?token=•••&q=1");
+  EXPECT_EQ(Redact("deploy with my-vault-value-123", {{"DEPLOY_KEY", "my-vault-value-123"}}),
+            "deploy with $DEPLOY_KEY");
+  EXPECT_EQ(Redact("git checkout 0123456789abcdef0123456789abcdef01234567", {}),
+            "git checkout 0123456789");
+  EXPECT_EQ(Redact("PATH=$HOME/bin ls src/app.js", {}),
+            "PATH=$HOME/bin ls src/app.js");
+}
+
+TEST(SecretsTest, CleanIsOneShortLine) {
+  EXPECT_EQ(Clean("line one\nline\ttwo", 100), "line one line two");
+  EXPECT_EQ(Clean("abcdefghij", 5), "abcd…");
+}
+
+}  // namespace
+}  // namespace meridian::mission
