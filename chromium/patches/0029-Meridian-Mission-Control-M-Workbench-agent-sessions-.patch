+// ---------------------------------------------------------------- terminals
+
+void MissionControl::WhenChannelReady(base::OnceClosure ready) {
+  channel_->Start(base::BindOnce(
+      [](base::OnceClosure ready, base::FilePath) { std::move(ready).Run(); },
+      std::move(ready)));
+}
+
+std::optional<std::pair<int, std::string>> MissionControl::TerminalOf(
+    const std::string& node_id) {
+  Node* node = Get(node_id);
+  if (!node || node->term_id.empty()) {
+    return std::nullopt;
+  }
+  Node* root = node->root_id.empty() ? node : Get(node->root_id);
+  return std::make_pair(root ? root->owner_tab : node->owner_tab,
+                        node->term_id);
+}
+
+MissionControl::Registration MissionControl::RegisterTerminal(
+    const std::string& kind,
+    const std::string& project,
+    int owner_tab) {
+  Registration out;
+  Node node;
+  node.owner_tab = owner_tab;
+  node.id = "term-" + RandomId(6);
+  node.kind = "session";
+  node.source = kind;
+  node.where = "local";
+  node.label = kind == "claude"  ? "Claude Code"
+               : kind == "codex" ? "Codex"
+               : kind == "gemini" ? "Gemini"
+                                  : kind;
+  node.project = Clean(project, 60);
+  node.status = "starting";
+  if (kind == "gemini") {
+    node.status_text = "Running · no live status";
+  }
+  out.node_id = node.id;
+  AddNode(std::move(node));
+  // The first agent session: macOS will ask once about notifications (they
+  // come when an agent waits), so say so before its prompt appears.
+  PrefService* prefs = profile_->GetPrefs();
+  if (!prefs->GetBoolean(prefs::kMissionNotifyIntro) &&
+      prefs->GetBoolean(prefs::kMissionNotify)) {
+    prefs->SetBoolean(prefs::kMissionNotifyIntro, true);
+    for (Observer& o : observers_) {
+      o.OnMissionToast(std::string(),
+                       "When an agent needs you, Meridian will let you know "
+                       "with a notification. Your Mac will ask once whether "
+                       "that’s OK — click Allow.",
+                       std::string());
+    }
+  }
+  if (kind == "claude" || kind == "codex") {
+    out.token = channel_->Register(out.node_id);
+    terminals_[out.token] = out.node_id;
+    token_hashes_[base::HexEncodeLower(
+                      crypto::hash::Sha256(base::as_byte_span(out.token)))
+                      .substr(0, 32)] = out.node_id;
+    out.env["MERIDIAN_MISSION_TOKEN"] = out.token;
+    if (!channel_->socket_path().empty()) {
+      out.env["MERIDIAN_MISSION_SOCKET"] = channel_->socket_path().value();
+    }
+  }
+  Changed();
+  return out;
+}
+
+base::DictValue MissionControl::ClaudeHookSettings() const {
+  std::string exe = base::CommandLine::ForCurrentProcess()->GetProgram().value();
+  base::DictValue hook;
+  hook.Set("type", "command");
+  hook.Set("command", "\"" + exe + "\" --mission-hook");
+  hook.Set("timeout", 5);
+  hook.Set("async", true);
+  base::DictValue hooks;
+  for (const char* ev :
+       {"SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse",
+        "PostToolUseFailure", "PermissionRequest", "Notification", "Stop",
+        "StopFailure", "SubagentStart", "SubagentStop", "PreCompact",
+        "SessionEnd"}) {
+    std::string_view e(ev);
+    bool tool = e == "PreToolUse" || e == "PostToolUse" ||
+                e == "PostToolUseFailure" || e == "PermissionRequest";
+    base::DictValue entry;
+    if (tool) {
+      entry.Set("matcher", "*");
+    }
+    entry.Set("hooks", base::ListValue().Append(hook.Clone()));
+    hooks.Set(ev, base::ListValue().Append(std::move(entry)));
+  }
+  return base::DictValue().Set("hooks", std::move(hooks));
+}
+
+std::string MissionControl::CodexNotifyArg() const {
+  std::string exe = base::CommandLine::ForCurrentProcess()->GetProgram().value();
+  auto json = [](const std::string& s) {
+    return base::WriteJson(base::Value(s)).value_or("\"\"");
+  };
+  return "notify=[" + json(exe) + ", \"--mission-hook\", \"--codex\"]";
+}
+
+void MissionControl::AttachTerminal(const std::string& node_id,
+                                    const std::string& term_id) {
+  Node* node = Get(node_id);
+  if (!node) {
+    return;
+  }
+  node->term_id = term_id;
+  if (node->source == "codex" && node->status == "starting") {
+    SetStatus(*node, "idle", "Ready");
+  }
+  Changed();
+}
+
+void MissionControl::TerminalInput(const std::string& node_id,
+                                   const std::string& data) {
+  Node* node = Get(node_id);
+  if (!node || node->ended_at || data.find('\r') == std::string::npos) {
+    return;
+  }
+  if (node->source == "codex" && node->status != "thinking") {
+    SetStatus(*node, "thinking", "Working");
+    Changed();
+  }
+  if (node->status == "waiting" && node->source == "claude") {
+    SetStatus(*node, "thinking");
+    Changed();
+  }
+}
+
+void MissionControl::TerminalExit(const std::string& token,
+                                  const std::string& node_id,
+                                  int code,
+                                  bool killed) {
+  if (!token.empty()) {
+    channel_->Unregister(token);
+    terminals_.erase(token);
+  }
+  std::erase_if(token_hashes_,
+                [&](const auto& kv) { return kv.second == node_id; });
+  Node* node = Get(node_id);
+  if (!node || node->ended_at) {
+    return;
+  }
+  bool ok = killed || code == 0;
+  Finish(*node, ok ? "done" : "error",
+         ok ? (killed ? "Stopped" : "Exited")
+            : "Exited with code " + base::NumberToString(code));
+}
+
+// ---------------------------------------------------------------- hooks
+
+void MissionControl::OnHookEvent(const std::string& node_id,
+                                 base::DictValue raw) {
+  Node* root = Get(node_id);
+  if (!root || root->ended_at) {
+    return;
+  }
+  std::vector<NamedSecret> sv = SecretValues();
+  auto s = [&](const char* key, size_t n) {
+    const std::string* v = raw.FindString(key);
+    return v ? Clean(*v, n, sv) : std::string();
+  };
+  auto id = [&](const char* key) {
+    const std::string* v = raw.FindString(key);
+    return v ? v->substr(0, 80) : std::string();
+  };
+  std::string event = id("event").substr(0, 40);
+  std::string agent_id = id("agent_id");
+  std::string agent_type = s("agent_type", 40);
+  std::string tool = s("tool", 80);
+  std::string tool_use_id = id("tool_use_id");
+  std::string summary = s("summary", 140);
+  std::string description = s("description", 100);
+  std::string subagent_type = s("subagent_type", 40);
+  std::string message = s("message", 160);
+  std::string notification_type = s("notification_type", 30);
+  std::string model = s("model", 40);
+  std::string reason = s("reason", 30);
+  bool error = raw.FindBool("error").value_or(false);
+  bool background = raw.FindBool("background").value_or(false);
+  std::string cwd_name = s("cwd_name", 60);
+  const std::string* kind = raw.FindString("kind");
+  if (kind && *kind == "codex") {
+    if (event == "TurnComplete") {
+      root->tool_calls++;
+      root->turns++;
+      if (root->project.empty()) {
+        root->project = cwd_name;
+      }
+      SetStatus(*root, "idle", "Turn finished — your move");
+      Log(*root, "", "Turn", "turn " + base::NumberToString(root->turns), true);
+      Changed();
+    }
+    return;
+  }
+  root->last_event_at = Now();
+  if (root->project.empty()) {
+    root->project = cwd_name;
+  }
+  Node* target = root;
+  if (!agent_id.empty()) {
+    if (Node* sub = FindChild(root->id, [&](const Node& n) {
+          return n.agent_id == agent_id;
+        })) {
+      target = sub;
+    }
+  }
+  std::string root_id = root->id;
+  bool spawn = tool == "Agent" || tool == "Task";
+  if (event == "SessionStart") {
+    if (!model.empty()) {
+      root->sublabel = model;
+    }
+    if (root->status == "starting" || root->status == "done") {
+      SetStatus(*root, "idle", "Ready");
+    }
+  } else if (event == "UserPromptSubmit") {
+    SetStatus(*root, "thinking");
+  } else if (event == "PreToolUse") {
+    target->tool_calls++;
+    target->tool = std::make_pair(tool.empty() ? "tool" : tool, summary);
+    SetStatus(*target, "tool");
+    Log(*target, tool_use_id, tool, summary);
+    if (spawn) {
+      Node child;
+      child.id = root_id + "~spawn~" +
+                 (tool_use_id.empty() ? RandomId(4) : tool_use_id);
+      child.parent_id = target->id;
+      child.root_id = root_id;
+      child.kind = "subagent";
+      child.source = "claude";
+      child.where = root->where;
+      child.label = !description.empty()     ? description
+                    : !subagent_type.empty() ? subagent_type
+                                             : "Subagent";
+      child.sublabel = subagent_type;
+      child.project = root->project;
+      child.status = "starting";
+      child.status_text = background ? "Starting in background" : "Starting";
+      child.tool_use_id = tool_use_id;
+      child.subagent_type = subagent_type;
+      child.term_id = root->term_id;
+      child.pending = true;
+      AddNode(std::move(child));
+    }
+  } else if (event == "PostToolUse" || event == "PostToolUseFailure") {
+    for (auto it = target->log.rbegin(); it != target->log.rend(); ++it) {
+      if ((!tool_use_id.empty() && it->id == tool_use_id) ||
+          (!it->ok && it->name == tool)) {
+        it->ok = !error;
+        break;
+      }
+    }
+    if (error) {
+      target->errors++;
+    }
+    target->tool.reset();
+    if (target->status == "tool" || target->status == "waiting") {
+      SetStatus(*target, "thinking");
+    }
+    if (spawn) {
+      if (Node* child = FindChild(root_id, [&](const Node& n) {
+            return !n.tool_use_id.empty() && n.tool_use_id == tool_use_id;
+          })) {
+        if (!child->ended_at && (child->agent_id.empty() || error)) {
+          Finish(*child, error ? "error" : "done", error ? "Failed" : "Done");
+        }
+      }
+    }
+  } else if (event == "PermissionRequest") {
+    SetStatus(*target, "waiting",
+              "Needs permission" + (tool.empty() ? "" : ": " + tool) +
+                  (summary.empty() ? "" : " · " + summary));
+  } else if (event == "Notification") {
+    if (notification_type == "permission_prompt" ||
+        notification_type == "elicitation_dialog" ||
+        (notification_type.empty() &&
+         RE2::PartialMatch(message, "(?i)permission|approve|input"))) {
+      SetStatus(*target, "waiting",
+                message.empty() ? "Waiting for you" : message);
+    } else if (notification_type == "idle_prompt" &&
+               root->status != "waiting") {
+      SetStatus(*root, "idle", "Waiting for your next prompt");
+    }
+  } else if (event == "Stop") {
+    root->tool.reset();
+    SetStatus(*root, "idle", "Turn finished");
+  } else if (event == "StopFailure") {
+    root->tool.reset();
+    root->errors++;
+    SetStatus(*root, "error", "The turn failed");
+  } else if (event == "SubagentStart") {
+    Node* child = FindChild(root_id, [&](const Node& n) {
+      return n.pending && n.agent_id.empty() && !n.ended_at &&
+             (agent_type.empty() || n.subagent_type.empty() ||
+              n.subagent_type == agent_type);
+    });
+    if (!child) {
+      Node fresh;
+      fresh.id = root_id + "~agent~" + agent_id;
+      fresh.parent_id = root_id;
+      fresh.root_id = root_id;
+      fresh.kind = "subagent";
+      fresh.source = "claude";
+      fresh.where = root->where;
+      fresh.label = agent_type.empty() ? "Subagent" : agent_type;
+      fresh.sublabel = agent_type;
+      fresh.project = root->project;
+      fresh.status = "starting";
+      fresh.term_id = root->term_id;
+      child = AddNode(std::move(fresh));
+    }
+    if (child) {
+      child->pending = false;
+      child->agent_id = agent_id;
+      if (!agent_type.empty() && child->sublabel.empty()) {
+        child->sublabel = agent_type;
+      }
+      SetStatus(*child, "thinking");
+    }
+  } else if (event == "SubagentStop") {
+    if (Node* child = agent_id.empty() ? nullptr
+                                       : FindChild(root_id, [&](const Node& n) {
+                                           return n.agent_id == agent_id;
+                                         })) {
+      if (!child->ended_at) {
+        Finish(*child, "done", "Done");
+      }
+    }
+  } else if (event == "PreCompact") {
+    target->tool = std::make_pair(std::string("Compacting"),
+                                  std::string("context"));
+    SetStatus(*target, "tool");
+  } else if (event == "SessionEnd") {
+    for (Node* c : Descendants(root_id)) {
+      if (!c->ended_at) {
+        Finish(*c, "done", "Done");
+      }
+    }
+    root = Get(root_id);
+    root->tool.reset();
+    if (reason == "clear" || reason == "resume") {
+      SetStatus(*root, "idle", "Ready");
+    } else {
+      SetStatus(*root, "done", "Session ended");
+    }
+  } else {
+    return;
+  }
+  Changed();
+}
+
+// ---------------------------------------------------------------- hub
+
+MissionControl::Node* MissionControl::McpNode(const Caller& caller) {
+  std::string cid = RE2::FullMatch(caller.client_id, "[\\w-]{6,64}")
+                        ? caller.client_id
+                        : "anonymous";
+  std::string id = "mcp-" + cid;
+  if (Node* node = Get(id)) {
+    if (!node->ended_at) {
+      return node;
+    }
+    Archive(id);
+  }
+  auto parent_it = token_hashes_.find(caller.session);
+  Node* parent =
+      parent_it != token_hashes_.end() ? Get(parent_it->second) : nullptr;
+  // The name comes from the client itself (anything holding the agent token
+  // can claim to be "Claude Code"), so it's shown as self-reported. Only the
+  // session link is verified.
+  std::string name = Clean(caller.client_name, 40);
+  Node node;
+  node.id = id;
+  node.parent_id = parent ? parent->id : std::string();
+  node.root_id = parent ? parent->id : std::string();
+  node.kind = "client";
+  node.source = "mcp";
+  node.where = "mcp";
+  node.label = parent ? "Meridian browser tools"
+                      : (name.empty() ? "MCP client" : name);
+  node.sublabel = !name.empty()
+                      ? (parent ? name + " · " : "") + "self-reported name"
+                      : (parent ? "" : "MCP");
+  node.self_reported = !name.empty();
+  node.project = parent ? parent->project : std::string();
+  node.status = "idle";
+  node.status_text = "Connected";
+  node.term_id = parent ? parent->term_id : std::string();
+  return AddNode(std::move(node));
+}
+
+MissionControl::Node* MissionControl::AssistantNode(const std::string& run_id) {
+  std::string rid =
+      RE2::FullMatch(run_id, "[\\w-]{6,64}") ? run_id : "default";
+  std::string id = "assistant-" + rid;
+  if (Node* node = Get(id)) {
+    if (!node->ended_at) {
+      return node;
+    }
+    Archive(id);
+  }
+  Node node;
+  node.id = id;
+  node.kind = "assistant";
+  node.source = "assistant";
+  node.where = "assistant";
+  node.label = "⌘J Assistant";
+  node.sublabel = "Claude";
+  node.status = "idle";
+  node.status_text = "Ready";
+  return AddNode(std::move(node));
+}
+
+void MissionControl::HubCallStart(int call_id,
+                                  const std::string& tool,
+                                  const base::DictValue& input,
+                                  const Caller& caller) {
+  Node* node = caller.source == "assistant" ? AssistantNode(caller.run_id)
+                                            : McpNode(caller);
+  if (!node) {
+    return;
+  }
+  node->tool_calls++;
+  node->last_event_at = Now();
+  node->ended_at = 0;
+  std::string summary = Clean(BrowserSummary(tool, input), 80, SecretValues());
+  node->tool = std::make_pair(tool, summary);
+  SetStatus(*node, "tool");
+  LogEntry* entry = Log(*node, "", tool, summary);
+  calls_[call_id] = {node->id, entry->ts};
+  Changed();
+}
+
+void MissionControl::HubCallEnd(int call_id,
+                                bool ok,
+                                const std::string& tab_id) {
+  auto it = calls_.find(call_id);
+  if (it == calls_.end()) {
+    return;
+  }
+  Call call = it->second;
+  calls_.erase(it);
+  Node* node = Get(call.node_id);
+  if (!node) {
+    return;
+  }
+  for (LogEntry& e : node->log) {
+    if (e.ts == call.ts && !e.ok) {
+      e.ok = ok;
+    }
+  }
+  if (!ok) {
+    node->errors++;
+  }
+  if (!tab_id.empty()) {
+    node->tab_id = tab_id.substr(0, 80);
+  }
+  node->tool.reset();
+  if (node->kind == "assistant") {
+    SetStatus(*node, node->running ? "thinking" : "done");
+  } else {
+    SetStatus(*node, "idle", "Connected");
+  }
+  Changed();
+}
+
+void MissionControl::AssistantRunStart(const std::string& run_id,
+                                       const std::string& host) {
+  Node* node = AssistantNode(run_id);
+  if (!node) {
+    return;
+  }
+  node->running = true;
+  node->ended_at = 0;
+  if (!host.empty()) {
+    node->project = Clean(host, 60);
+  }
+  SetStatus(*node, "thinking");
+  Changed();
+}
+
+void MissionControl::AssistantRunEnd(const std::string& run_id,
+                                     const std::string& error,
+                                     bool stopped) {
+  Node* node = Get("assistant-" + run_id);
+  if (!node) {
+    return;
+  }
+  node->running = false;
+  node->tool.reset();
+  if (!error.empty()) {
+    node->errors++;
+    SetStatus(*node, "error", Clean(error, 120));
+  } else {
+    SetStatus(*node, "done", stopped ? "Stopped" : "Answered");
+  }
+  node->last_event_at = Now();
+  Changed();
+}
+
+void MissionControl::AssistantReset(const std::string& run_id) {
+  Node* node = Get("assistant-" + run_id);
+  if (node && !node->ended_at) {
+    Finish(*node, node->status == "error" ? "error" : "done", "Chat closed");
+  }
+}
+
+// ---------------------------------------------------------------- tree
+
+MissionControl::Node* MissionControl::Get(const std::string& id) {
+  auto it = nodes_.find(id);
+  return it == nodes_.end() ? nullptr : &it->second;
+}
+
+std::vector<MissionControl::Node*> MissionControl::Descendants(
+    const std::string& root_id) {
+  std::vector<Node*> out;
+  for (auto& [id, n] : nodes_) {
+    if (n.root_id == root_id && id != root_id) {
+      out.push_back(&n);
+    }
+  }
+  std::ranges::sort(out, {}, &Node::started_at);
+  return out;
+}
+
+MissionControl::Node* MissionControl::FindChild(
+    const std::string& root_id,
+    base::FunctionRef<bool(const Node&)> pred) {
+  for (Node* n : Descendants(root_id)) {
+    if (pred(*n)) {
+      return n;
+    }
+  }
+  return nullptr;
+}
+
+// Hook events and MCP client ids are agent-controlled: capped.
+MissionControl::Node* MissionControl::AddNode(Node n) {
+  if (n.kind == "subagent" || n.kind == "client") {
+    if (nodes_.size() >= kLiveMax) {
+      Sweep(true);
+    }
+    if (nodes_.size() >= kLiveMax && !nodes_.contains(n.id)) {
+      return nullptr;
+    }
+    if (n.kind == "subagent" && !n.root_id.empty() && !nodes_.contains(n.id) &&
+        Descendants(n.root_id).size() >= kSubtreeMax) {
+      return nullptr;
+    }
+  }
+  double now = Now();
+  n.started_at = now;
+  n.last_event_at = now;
+  if (n.root_id.empty()) {
+    Node* parent = n.parent_id.empty() ? nullptr : Get(n.parent_id);
+    n.root_id = parent ? parent->root_id : (n.parent_id.empty() ? n.id : n.parent_id);
+  }
+  std::string id = n.id;
+  nodes_[id] = std::move(n);
+  return &nodes_[id];
+}
+
+MissionControl::LogEntry* MissionControl::Log(Node& node,
+                                              const std::string& id,
+                                              const std::string& name,
+                                              const std::string& summary,
+                                              std::optional<bool> ok) {
+  double ts = Now();
+  // Distinct stamps, so a hub call finds its own entry.
+  if (!node.log.empty() && node.log.back().ts >= ts) {
+    ts = node.log.back().ts + 0.001;
+  }
+  node.log.push_back({id, ts, name.empty() ? "tool" : name, summary, ok});
+  if (node.log.size() > kLogMax) {
+    node.log.erase(node.log.begin(),
+                   node.log.begin() + (node.log.size() - kLogMax));
+  }
+  return &node.log.back();
+}
+
+void MissionControl::SetStatus(Node& node,
+                               const std::string& status,
+                               const std::string& text) {
+  std::string was = node.status;
+  node.status = status;
+  node.status_text = text;
+  if (status != "tool" && status != "waiting") {
+    node.tool.reset();
+  }
+  if (status == "waiting") {
+    if (was != "waiting") {
+      node.waiting_since = Now();
+      NotifyWaiting(node);
+    }
+  } else {
+    node.waiting_since = 0;
+  }
+}
+
+void MissionControl::Finish(Node& node,
+                            const std::string& status,
+                            const std::string& text) {
+  node.tool.reset();
+  SetStatus(node, status, text);
+  node.ended_at = Now();
+  if (node.parent_id.empty()) {
+    for (Node* c : Descendants(node.id)) {
+      if (!c->ended_at) {
+        c->tool.reset();
+        SetStatus(*c, "done", c->status_text.empty() ? "Done" : c->status_text);
+        c->ended_at = Now();
+      }
+    }
+  }
+  Changed();
+}
+
+void MissionControl::Archive(const std::string& root_id) {
+  Node* root = Get(root_id);
+  if (!root) {
+    return;
+  }
+  Node copy = *root;
+  int calls = copy.tool_calls;
+  int subagents = 0;
+  std::vector<std::string> sub;
+  for (Node* n : Descendants(root_id)) {
+    calls += n->tool_calls;
+    subagents += n->kind == "subagent";
+    sub.push_back(n->id);
+  }
+  for (const std::string& id : sub) {
+    nodes_.erase(id);
+  }
+  nodes_.erase(root_id);
+  last_notify_.erase(root_id);
+  // An MCP bridge that only listed tools.
+  if (copy.tool_calls == 0 && copy.kind == "client" && sub.empty()) {
+    return;
+  }
+  base::ListValue next;
+  next.Append(base::DictValue()
+                  .Set("id", copy.id)
+                  .Set("label", copy.label)
+                  .Set("sublabel", OptString(copy.sublabel))
+                  .Set("source", copy.source)
+                  .Set("where", copy.where)
+                  .Set("project", OptString(copy.project))
+                  .Set("startedAt", copy.started_at)
+                  .Set("endedAt", copy.ended_at ? copy.ended_at : Now())
+                  .Set("status", copy.status == "error" ? "error" : "done")
+                  .Set("toolCalls", calls)
+                  .Set("subagents", subagents));
+  for (base::Value& h : history_) {
+    if (next.size() < kHistoryMax) {
+      next.Append(std::move(h));
+    }
+  }
+  history_ = std::move(next);
+  history_writer_.ScheduleWrite(this);
+}
+
+void MissionControl::Sweep(bool force) {
+  double t = Now();
+  bool changed = false;
+  std::vector<std::string> roots;
+  for (const auto& [id, n] : nodes_) {
+    if (n.parent_id.empty()) {
+      roots.push_back(id);
+    }
+  }
+  for (const std::string& id : roots) {
+    Node* n = Get(id);
+    if (!n) {
+      continue;
+    }
+    if (!n->ended_at && n->kind == "client" &&
+        t - n->last_event_at > kMcpIdleMs && !n->tool) {
+      Finish(*n, "done", "Disconnected");
+      changed = true;
+    }
+    if (!n->ended_at && n->kind == "assistant" && !n->running &&
+        t - n->last_event_at > kAssistantIdleMs) {
+      Finish(*n, n->status == "error" ? "error" : "done", n->status_text);
+      changed = true;
+    }
+    if (n->ended_at && (force || t - n->ended_at > kLingerMs)) {
+      Archive(id);
+      changed = true;
+    }
+  }
+  if (changed) {
+    Changed();
+  }
+}
+
+bool MissionControl::Dismiss(const std::string& id) {
+  Node* n = Get(id);
+  if (n && n->parent_id.empty() && n->ended_at) {
+    Archive(id);
+    Changed();
+    return true;
+  }
+  return false;
+}
+
+void MissionControl::ClearHistory() {
+  history_ = base::ListValue();
+  history_writer_.ScheduleWrite(this);
+  Changed();
+}
+
+// ---------------------------------------------------------------- output
+
+base::DictValue MissionControl::Counts() const {
+  int working = 0, waiting = 0, live = 0;
+  for (const auto& [id, n] : nodes_) {
+    if (n.ended_at) {
+      continue;
+    }
+    live += n.parent_id.empty();
+    working += Working(n.status);
+    waiting += n.status == "waiting";
+  }
+  return base::DictValue()
+      .Set("working", working)
+      .Set("waiting", waiting)
+      .Set("live", live);
+}
+
+base::DictValue MissionControl::Snapshot() const {
+  base::ListValue nodes;
+  for (const auto& [id, n] : nodes_) {
+    base::ListValue log;
+    for (const LogEntry& e : n.log) {
+      log.Append(base::DictValue()
+                     .Set("ts", e.ts)
+                     .Set("name", e.name)
+                     .Set("summary", OptString(e.summary))
+                     .Set("ok", e.ok ? base::Value(*e.ok) : base::Value()));
+    }
+    nodes.Append(
+        base::DictValue()
+            .Set("id", n.id)
+            .Set("parentId", OptString(n.parent_id))
+            .Set("kind", n.kind)
+            .Set("source", n.source)
+            .Set("where", n.where)
+            .Set("label", n.label)
+            .Set("sublabel", OptString(n.sublabel))
+            .Set("project", OptString(n.project))
+            .Set("status", n.status)
+            .Set("statusText", OptString(n.status_text))
+            .Set("tool", n.tool ? base::Value(base::DictValue()
+                                                  .Set("name", n.tool->first)
+                                                  .Set("summary",
+                                                       OptString(n.tool->second)))
+                                : base::Value())
+            .Set("toolCalls", n.tool_calls)
+            .Set("errors", n.errors)
+            .Set("startedAt", n.started_at)
+            .Set("endedAt", n.ended_at ? base::Value(n.ended_at) : base::Value())
+            .Set("waitingSince",
+                 n.waiting_since ? base::Value(n.waiting_since) : base::Value())
+            .Set("termId", OptString(n.term_id))
+            .Set("tabId", OptString(n.tab_id))
+            .Set("turns", n.turns)
+            .Set("selfReported", n.self_reported)
+            .Set("log", std::move(log)));
+  }
+  return base::DictValue()
+      .Set("nodes", std::move(nodes))
+      .Set("history", history_.Clone())
+      .Set("counts", Counts())
+      .Set("notified", notified_.Clone())
+      .Set("now", Now());
+}
+
+void MissionControl::Changed() {
+  if (!flush_.IsRunning()) {
+    flush_.Start(FROM_HERE, base::Milliseconds(80),
+                 base::BindOnce(&MissionControl::Flush,
+                                base::Unretained(this)));
+  }
+}
+
+void MissionControl::Flush() {
+  base::DictValue snapshot = Snapshot();
+  for (Observer& o : observers_) {
+    o.OnMissionChanged(snapshot);
+  }
+  int waiting = snapshot.FindDict("counts")->FindInt("waiting").value_or(0);
+  std::string badge = waiting ? base::NumberToString(waiting) : std::string();
+  if (!quiet_ && badge != last_badge_) {
+    last_badge_ = badge;
+    SetDockBadge(badge);
+  }
+}
+
+void MissionControl::NotifyWaiting(Node& node) {
+  Node* root = node.parent_id.empty() ? &node : Get(node.root_id);
+  // An agent can flip between waiting and working as fast as its hooks fire.
+  std::string key = root ? root->id : node.id;
+  double now = Now();
+  if (now - last_notify_[key] < kNotifyGapMs) {
+    return;
+  }
+  last_notify_[key] = now;
+  std::string title = (root ? root->label : node.label) +
+                      (root && !root->project.empty() ? " · " + root->project
+                                                      : "") +
+                      " is waiting for you";
+  std::string body = !node.status_text.empty() ? node.status_text
+                     : &node != root            ? node.label
+                                               : "It needs your input to continue.";
+  body = body.substr(0, 200);
+  bool focused = AppIsActive();
+  if (notified_.size() > 50) {
+    notified_.erase(notified_.begin());
+  }
+  if (!profile_->GetPrefs()->GetBoolean(prefs::kMissionNotify)) {
+    return;
+  }
+  notified_.Append(base::DictValue()
+                       .Set("nodeId", node.id)
+                       .Set("title", title)
+                       .Set("body", body)
+                       .Set("native", !focused));
+  if (focused) {
+    for (Observer& o : observers_) {
+      o.OnMissionToast(node.id, title, body);
+    }
+    return;
+  }
+  if (quiet_) {
+    return;
+  }
+  std::string node_id = node.id;
+  message_center::Notification notification(
+      message_center::NOTIFICATION_TYPE_SIMPLE, "meridian-mission-" + node_id,
+      base::UTF8ToUTF16(title), base::UTF8ToUTF16(body), ui::ImageModel(),
+      u"Mission Control", GURL(),
+      message_center::NotifierId(message_center::NotifierType::SYSTEM_COMPONENT,
+                                 "meridian.mission"),
+      message_center::RichNotificationData(),
+      base::MakeRefCounted<message_center::HandleNotificationClickDelegate>(
+          base::BindRepeating(&RevealMissionControl, profile_, node_id)));
+  NotificationDisplayServiceFactory::GetForProfile(profile_)->Display(
+      NotificationHandler::Type::TRANSIENT, notification, nullptr);
+}
+
+std::vector<NamedSecret> MissionControl::SecretValues() const {
+  // The Workbench vault (when it has values for the project) supplies these.
+  return {};
+}
+
+void MissionControl::LoadHistory() {
+  base::FilePath file = history_writer_.path();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(
+          [](base::FilePath file) {
+            std::string json;
+            base::ReadFileToString(file, &json);
+            return json;
+          },
+          file),
+      base::BindOnce(
+          [](base::WeakPtr<MissionControl> self, std::string json) {
+            std::optional<base::Value> v = base::JSONReader::Read(json, 0);
+            if (!self || !v || !v->is_list()) {
+              return;
+            }
+            for (const base::Value& h : v->GetList()) {
+              const base::DictValue* d = h.is_dict() ? &h.GetDict() : nullptr;
+              const std::string* label = d ? d->FindString("label") : nullptr;
+              if (!label || self->history_.size() >= kHistoryMax) {
+                continue;
+              }
+              auto str = [&](const char* k, size_t n) -> base::Value {
+                const std::string* s = d->FindString(k);
+                return s ? base::Value(s->substr(0, n)) : base::Value();
+              };
+              const std::string* status = d->FindString("status");
+              self->history_.Append(
+                  base::DictValue()
+                      .Set("id", str("id", 80))
+                      .Set("label", label->substr(0, 80))
+                      .Set("sublabel", str("sublabel", 60))
+                      .Set("source", str("source", 20))
+                      .Set("where", str("where", 20))
+                      .Set("project", str("project", 60))
+                      .Set("startedAt", d->FindDouble("startedAt").value_or(0))
+                      .Set("endedAt", d->FindDouble("endedAt").value_or(0))
+                      .Set("status",
+                           status && *status == "error" ? "error" : "done")
+                      .Set("toolCalls", d->FindInt("toolCalls").value_or(0))
+                      .Set("subagents", d->FindInt("subagents").value_or(0)));
+            }
+            self->Changed();
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+std::optional<std::string> MissionControl::SerializeData() {
+  history_writer_.RegisterOnNextWriteCallbacks(
+      base::OnceClosure(),
+      base::BindOnce(
+          [](base::FilePath file, bool ok) {
+            if (ok) {
+              base::SetPosixFilePermissions(file, 0600);
+            }
+          },
+          history_writer_.path()));
+  return base::WriteJson(history_);
+}
+
+}  // namespace meridian::mission
