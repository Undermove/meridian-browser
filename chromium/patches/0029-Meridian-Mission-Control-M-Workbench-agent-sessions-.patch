+
+#ifndef CHROME_BROWSER_MERIDIAN_MISSION_MISSION_HOOK_H_
+#define CHROME_BROWSER_MERIDIAN_MISSION_MISSION_HOOK_H_
+
+#include <string>
+
+#include "base/values.h"
+
+namespace meridian::mission {
+
+// `Meridian --mission-hook`: the Mission Control event hook for coding agents
+// started from the Workbench. It starts no browser.
+//   Claude Code: an async command hook (from the session's --settings file);
+//     stdin is the hook event JSON.
+//   Codex: the session's `notify` program (`--mission-hook --codex <json>`).
+// What leaves this process: a small fixed set of fields plus a short summary
+// of the tool call (file name, command head, host); never tool inputs,
+// outputs, prompts or messages. Sent as one line with the session's token
+// over MERIDIAN_MISSION_SOCKET, then it exits 0 with no output.
+bool IsMissionHook(int argc, const char** argv);
+int RunMissionHook(int argc, const char** argv);
+
+// The line for one Claude Code hook event (without the token).
+base::DictValue FromClaudeEvent(const base::DictValue& event);
+// The line for one Codex notify payload.
+base::DictValue FromCodexEvent(const std::string& json);
+
+}  // namespace meridian::mission
+
+#endif  // CHROME_BROWSER_MERIDIAN_MISSION_MISSION_HOOK_H_
