+++ b/chrome/browser/meridian/mission/secrets.h
@@ -0,0 +1,48 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_MISSION_SECRETS_H_
+#define CHROME_BROWSER_MERIDIAN_MISSION_SECRETS_H_
+
+#include <string>
+#include <vector>
+
+namespace meridian::mission {
+
+// "Does this text look like a secret?" A nudge, not a guarantee: known token
+// prefixes plus long, high-entropy values assigned to names like *_KEY,
+// *_TOKEN, *_SECRET, *_PASSWORD.
+struct SecretHit {
+  size_t start;
+  size_t end;
+  std::string value;
+  // The environment variable name it would get ("OPENAI_API_KEY").
+  std::string name;
+  std::string kind;
+};
+
+// Sorted by position, non-overlapping. Nothing for text over 200,000 bytes.
+std::vector<SecretHit> FindSecrets(const std::string& text);
+
+// A vault value the caller knows, to replace by its name.
+struct NamedSecret {
+  std::string name;
+  std::string value;
+};
+
+// Masks secrets in a short agent summary (`API_KEY=sk-… npm test`,
+// `curl -H "Authorization: Bearer …"`, `https://user:pass@host`): exact vault
+// values become `$NAME`; known formats and credential-looking assignments
+// become •••.
+std::string Redact(const std::string& text,
+                   const std::vector<NamedSecret>& secrets);
+
+// Plain one-line text, capped at `max` characters, redacted.
+std::string Clean(const std::string& text,
+                  size_t max,
+                  const std::vector<NamedSecret>& secrets = {});
+
+}  // namespace meridian::mission
+
+#endif  // CHROME_BROWSER_MERIDIAN_MISSION_SECRETS_H_
