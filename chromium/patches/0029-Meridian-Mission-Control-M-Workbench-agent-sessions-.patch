@@ -0,0 +1,227 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_MISSION_MISSION_CONTROL_H_
+#define CHROME_BROWSER_MERIDIAN_MISSION_MISSION_CONTROL_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/important_file_writer.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/functional/function_ref.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+class Profile;
+
+namespace meridian::mission {
+
+class EventChannel;
+struct NamedSecret;
+
+// Mission Control: a live picture of every agent working with Meridian.
+//  - Claude Code sessions started from the Workbench: lifecycle hooks from the
+//    session's own --settings file (`Meridian --mission-hook`). Subagents come
+//    from Agent/Task tool calls and SubagentStart/Stop.
+//  - Codex sessions: process status, plus Codex's `notify` program.
+//  - MCP clients driving the browser (one node per bridge; nested under the
+//    Workbench session that started it when the bridge proves it).
+//  - The built-in AI (⌘J): one node per chat.
+// Nodes hold labels, statuses and short redacted summaries, never tool
+// inputs, outputs, prompts or page text. Finished sessions go to a short
+// history; only a summary of each is written to disk.
+class MissionControl : public KeyedService,
+                       public base::ImportantFileWriter::DataSerializer {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnMissionChanged(const base::DictValue& snapshot) {}
+    // An agent waits while Meridian is in front: an in-window notice.
+    virtual void OnMissionToast(const std::string& node_id,
+                                const std::string& title,
+                                const std::string& body) {}
+  };
+
+  struct Registration {
+    std::string token;
+    std::string node_id;
+    // MERIDIAN_MISSION_TOKEN / MERIDIAN_MISSION_SOCKET for the agent.
+    std::map<std::string, std::string> env;
+  };
+
+  explicit MissionControl(Profile* profile);
+  MissionControl(const MissionControl&) = delete;
+  MissionControl& operator=(const MissionControl&) = delete;
+  ~MissionControl() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // ---- Workbench terminals (kind: claude, codex, gemini…) ----
+  // Runs `ready` once the event channel listens (or couldn't start).
+  void WhenChannelReady(base::OnceClosure ready);
+  // `owner_tab`: the Workbench tab's handle id (to open its terminal).
+  Registration RegisterTerminal(const std::string& kind,
+                                const std::string& project,
+                                int owner_tab);
+  // (owner tab handle id, terminal id) of a session node, if it has one.
+  std::optional<std::pair<int, std::string>> TerminalOf(
+      const std::string& node_id);
+  // The Claude Code --settings fragment that reports to Mission Control.
+  base::DictValue ClaudeHookSettings() const;
+  // Codex's `-c notify=[…]` value.
+  std::string CodexNotifyArg() const;
+  void AttachTerminal(const std::string& node_id, const std::string& term_id);
+  // Enter in an agent's terminal (Codex has no per-tool hooks).
+  void TerminalInput(const std::string& node_id, const std::string& data);
+  void TerminalExit(const std::string& token,
+                    const std::string& node_id,
+                    int code,
+                    bool killed);
+
+  // ---- Browser tool calls (AgentService): MCP clients and the ⌘J AI ----
+  struct Caller {
+    // "mcp" or "assistant".
+    std::string source;
+    std::string client_id;
+    std::string client_name;
+    // A hash of a Workbench session's token, when the bridge proves it.
+    std::string session;
+    std::string run_id;
+  };
+  void HubCallStart(int call_id,
+                    const std::string& tool,
+                    const base::DictValue& input,
+                    const Caller& caller);
+  void HubCallEnd(int call_id, bool ok, const std::string& tab_id);
+
+  void AssistantRunStart(const std::string& run_id, const std::string& host);
+  void AssistantRunEnd(const std::string& run_id,
+                       const std::string& error,
+                       bool stopped);
+  void AssistantReset(const std::string& run_id);
+
+  // ---- The view ----
+  base::DictValue Snapshot() const;
+  bool Dismiss(const std::string& id);
+  void ClearHistory();
+
+  // Delivered by the event channel.
+  void OnHookEvent(const std::string& node_id, base::DictValue event);
+
+  // base::ImportantFileWriter::DataSerializer:
+  std::optional<std::string> SerializeData() override;
+
+  // KeyedService:
+  void Shutdown() override;
+
+  base::WeakPtr<MissionControl> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  struct LogEntry {
+    std::string id;
+    double ts = 0;
+    std::string name;
+    std::string summary;
+    std::optional<bool> ok;
+  };
+  struct Node {
+    Node();
+    Node(const Node&);
+    Node& operator=(const Node&);
+    ~Node();
+    std::string id;
+    std::string parent_id;
+    std::string root_id;
+    std::string kind;    // session, subagent, client, assistant
+    std::string source;  // claude, codex, gemini, mcp, assistant
+    std::string where;   // local, sandbox, mcp, assistant
+    std::string label;
+    std::string sublabel;
+    std::string project;
+    std::string status;  // starting, idle, thinking, tool, waiting, done, error
+    std::string status_text;
+    std::optional<std::pair<std::string, std::string>> tool;
+    int tool_calls = 0;
+    int errors = 0;
+    int turns = 0;
+    double started_at = 0;
+    double ended_at = 0;
+    double last_event_at = 0;
+    double waiting_since = 0;
+    std::vector<LogEntry> log;
+    std::string term_id;
+    int owner_tab = 0;
+    std::string tab_id;
+    std::string agent_id;
+    std::string tool_use_id;
+    std::string subagent_type;
+    bool pending = false;
+    bool running = false;
+    bool self_reported = false;
+  };
+
+  Node* AddNode(Node node);
+  Node* Get(const std::string& id);
+  std::vector<Node*> Descendants(const std::string& root_id);
+  Node* FindChild(const std::string& root_id,
+                  base::FunctionRef<bool(const Node&)> pred);
+  LogEntry* Log(Node& node,
+                const std::string& id,
+                const std::string& name,
+                const std::string& summary,
+                std::optional<bool> ok = std::nullopt);
+  void SetStatus(Node& node,
+                 const std::string& status,
+                 const std::string& text = std::string());
+  void Finish(Node& node, const std::string& status, const std::string& text);
+  void Archive(const std::string& root_id);
+  void Sweep(bool force);
+  Node* McpNode(const Caller& caller);
+  Node* AssistantNode(const std::string& run_id);
+  void OnCodexEvent(Node& root, const base::DictValue& event);
+  void NotifyWaiting(Node& node);
+  void Changed();
+  void Flush();
+  base::DictValue Counts() const;
+  std::vector<NamedSecret> SecretValues() const;
+  void LoadHistory();
+
+  raw_ptr<Profile> profile_;
+  std::unique_ptr<EventChannel> channel_;
+  std::map<std::string, Node> nodes_;
+  base::ListValue history_;
+  // token -> node id; sha256(token) prefix -> node id.
+  std::map<std::string, std::string> terminals_;
+  std::map<std::string, std::string> token_hashes_;
+  // hub call id -> (node id, index in its log by entry ts).
+  struct Call {
+    std::string node_id;
+    double ts;
+  };
+  std::map<int, Call> calls_;
+  std::map<std::string, double> last_notify_;
+  base::ListValue notified_;
+  bool quiet_ = false;
+  std::string last_badge_;
+  base::RepeatingTimer sweep_;
+  base::OneShotTimer flush_;
+  base::ImportantFileWriter history_writer_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<MissionControl> weak_factory_{this};
+};
+
+}  // namespace meridian::mission
+
+#endif  // CHROME_BROWSER_MERIDIAN_MISSION_MISSION_CONTROL_H_
