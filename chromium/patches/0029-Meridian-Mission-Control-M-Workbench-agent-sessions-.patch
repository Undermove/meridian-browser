+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_MISSION_EVENT_CHANNEL_H_
+#define CHROME_BROWSER_MERIDIAN_MISSION_EVENT_CHANNEL_H_
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+
+namespace meridian::mission {
+
+// Mission Control: the local, one-way channel from agent hooks to Meridian.
+//  - a unix socket in a fresh 0700 temp dir (the socket itself 0600): no TCP
+//    port, so nothing outside this user account can reach it;
+//  - every line carries a per-session token (32 random bytes, handed to the
+//    agent in its environment, never written to disk); lines with unknown
+//    tokens are dropped;
+//  - one JSON object per line, at most 16 KB a line and 64 KB a connection;
+//    connections that dawdle are cut after 3 s; each session is
+//    rate-limited. Nothing is ever sent back.
+class EventChannel {
+ public:
+  // (the session's id as registered, the event without its token).
+  using EventCallback =
+      base::RepeatingCallback<void(const std::string& session,
+                                   base::DictValue event)>;
+
+  // `on_event` runs on the sequence that creates the channel.
+  explicit EventChannel(EventCallback on_event);
+  EventChannel(const EventChannel&) = delete;
+  EventChannel& operator=(const EventChannel&) = delete;
+  ~EventChannel();
+
+  // Starts listening (once); `done` gets the socket path, or empty.
+  void Start(base::OnceCallback<void(base::FilePath)> done);
+  // The path once started, else empty.
+  const base::FilePath& socket_path() const { return socket_path_; }
+
+  // A new session; returns its token.
+  std::string Register(const std::string& session);
+  void Unregister(const std::string& token);
+
+ private:
+  class Server;
+
+  scoped_refptr<Server> server_;
+  base::FilePath socket_path_;
+  bool starting_ = false;
+  std::vector<base::OnceCallback<void(base::FilePath)>> waiting_;
+  base::WeakPtrFactory<EventChannel> weak_factory_{this};
+};
+
+}  // namespace meridian::mission
+
+#endif  // CHROME_BROWSER_MERIDIAN_MISSION_EVENT_CHANNEL_H_
