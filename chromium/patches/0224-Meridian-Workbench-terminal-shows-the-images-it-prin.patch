+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_TERM_IMAGES_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_TERM_IMAGES_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+
+namespace meridian::workbench {
+
+// An image a terminal printed the path of (absolute, ~/ or relative to
+// `root`): {path, name, mime, size}, and `data` (base64) when asked. Only a
+// regular file, really a PNG, JPEG, GIF or WebP under that extension after
+// following links, and not over 25 MB: a path in a program's output must not
+// turn into a way to read anything else. Blocks.
+base::expected<base::DictValue, std::string> ReadTerminalImage(
+    const std::string& printed,
+    const base::FilePath& root,
+    bool with_data);
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_TERM_IMAGES_H_
