+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/term_images.h"
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/strings/string_util.h"
+#include "build/build_config.h"
+#include "chrome/browser/meridian/real_path.h"
+
+#if BUILDFLAG(IS_POSIX)
+#include <sys/stat.h>
+#endif
+
+namespace meridian::workbench {
+
+namespace {
+
+constexpr int64_t kMaxBytes = 25 << 20;
+
+// The type the first bytes say, if it is the one the extension says.
+std::optional<std::string_view> MimeOf(std::string_view ext,
+                                       base::span<const uint8_t> head) {
+  const auto starts = [&](std::string_view magic, size_t at = 0) {
+    if (head.size() < at + magic.size()) {
+      return false;
+    }
+    for (size_t i = 0; i < magic.size(); ++i) {
+      if (head[at + i] != static_cast<uint8_t>(magic[i])) {
+        return false;
+      }
+    }
+    return true;
+  };
+  if (ext == ".png" && starts("\x89PNG\r\n\x1a\n")) {
+    return "image/png";
+  }
+  if ((ext == ".jpg" || ext == ".jpeg") && starts("\xff\xd8\xff")) {
+    return "image/jpeg";
+  }
+  if (ext == ".gif" && (starts("GIF87a") || starts("GIF89a"))) {
+    return "image/gif";
+  }
+  if (ext == ".webp" && starts("RIFF") && starts("WEBP", 8)) {
+    return "image/webp";
+  }
+  return std::nullopt;
+}
+
+bool IsRegularFile(const base::FilePath& path) {
+#if BUILDFLAG(IS_POSIX)
+  // Before opening: a pipe named .png would block the read forever.
+  base::stat_wrapper_t st;
+  return base::File::Stat(path, &st) == 0 && S_ISREG(st.st_mode);
+#else
+  base::File::Info info;
+  return base::GetFileInfo(path, &info) && !info.is_directory;
+#endif
+}
+
+}  // namespace
+
+base::expected<base::DictValue, std::string> ReadTerminalImage(
+    const std::string& printed,
+    const base::FilePath& root,
+    bool with_data) {
+  if (printed.empty() || printed.size() > 4096 ||
+      printed.find('\0') != std::string::npos) {
+    return base::unexpected("Not an image path");
+  }
+  base::FilePath path;
+  if (printed.starts_with("~/") || printed.starts_with("~\\")) {
+    path = base::GetHomeDir().Append(
+        base::FilePath::FromUTF8Unsafe(printed.substr(2)));
+  } else {
+    path = base::FilePath::FromUTF8Unsafe(printed);
+    if (!path.IsAbsolute()) {
+      if (root.empty()) {
+        return base::unexpected("Not an image path");
+      }
+      path = root.Append(path);
+    }
+  }
+  const base::FilePath real = RealFilePath(path);
+  if (real.empty() || !IsRegularFile(real)) {
+    return base::unexpected("No such image");
+  }
+  const std::string ext =
+      base::ToLowerASCII(real.FinalExtension().empty()
+                             ? std::string()
+                             : base::FilePath(real.FinalExtension())
+                                   .AsUTF8Unsafe());
+  base::File file(real, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return base::unexpected("Can't open this image");
+  }
+  const int64_t size = file.GetLength();
+  if (size <= 0 || size > kMaxBytes) {
+    return base::unexpected("This image is too large to show");
+  }
+  std::array<uint8_t, 16> head{};
+  const std::optional<size_t> got = file.Read(0, head);
+  if (!got) {
+    return base::unexpected("Can't read this image");
+  }
+  const std::optional<std::string_view> mime =
+      MimeOf(ext, base::span(head).first(*got));
+  if (!mime) {
+    return base::unexpected("Not a PNG, JPEG, GIF or WebP image");
+  }
+  base::DictValue out;
+  out.Set("path", real.AsUTF8Unsafe());
+  out.Set("name", real.BaseName().AsUTF8Unsafe());
+  out.Set("mime", *mime);
+  out.Set("size", static_cast<double>(size));
+  if (with_data) {
+    std::vector<uint8_t> bytes(static_cast<size_t>(size));
+    const std::optional<size_t> read = file.Read(0, bytes);
+    if (!read || *read != bytes.size()) {
+      return base::unexpected("Can't read this image");
+    }
+    out.Set("data", base::Base64Encode(bytes));
+  }
+  return out;
+}
+
+}  // namespace meridian::workbench
