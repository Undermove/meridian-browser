@@ -0,0 +1,82 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/currency_parse.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+constexpr char kEcb[] =
+    "<gesmes:Envelope><Cube><Cube time='2026-11-20'>"
+    "<Cube currency='USD' rate='1.25'/><Cube currency='GBP' rate='0.85'/>"
+    "</Cube></Cube></gesmes:Envelope>";
+
+constexpr char kNbg[] = R"([{"date":"2026-11-25T00:00:00.000Z","currencies":[
+  {"code":"EUR","quantity":1,"rate":3.0},
+  {"code":"USD","quantity":1,"rate":2.5},
+  {"code":"RUB","quantity":100,"rate":3.2},
+  {"code":"AMD","quantity":1000,"rate":7.5}]}])";
+
+TEST(CurrencyParseTest, ReadsTheEcbFile) {
+  std::string date;
+  auto rates = ParseEcbRates(kEcb, &date);
+  EXPECT_EQ(date, "2026-11-20");
+  EXPECT_EQ(rates.size(), 2u);
+  EXPECT_DOUBLE_EQ(rates["USD"], 1.25);
+}
+
+TEST(CurrencyParseTest, ReadsTheNbgJsonPerUnit) {
+  std::string date;
+  auto gel = ParseNbgRates(kNbg, &date);
+  EXPECT_EQ(date, "2026-11-25");
+  EXPECT_DOUBLE_EQ(gel["GEL"], 1);
+  EXPECT_DOUBLE_EQ(gel["RUB"], 0.032);
+  EXPECT_DOUBLE_EQ(gel["AMD"], 0.0075);
+  EXPECT_TRUE(ParseNbgRates("not json", &date).empty());
+  EXPECT_TRUE(ParseNbgRates("[]", &date).empty());
+}
+
+TEST(CurrencyParseTest, TheNbgAddsWhatTheEcbLacks) {
+  std::string ecb_date, nbg_date;
+  auto ecb = ParseEcbRates(kEcb, &ecb_date);
+  auto gel = ParseNbgRates(kNbg, &nbg_date);
+  CurrencyRates merged = MergeRates(ecb, ecb_date, gel, nbg_date);
+  // The ECB's own stay.
+  EXPECT_DOUBLE_EQ(merged.rates["USD"], 1.25);
+  // 3 lari a euro.
+  EXPECT_DOUBLE_EQ(merged.rates["GEL"], 3);
+  EXPECT_DOUBLE_EQ(merged.rates["RUB"], 3 / 0.032);
+  EXPECT_EQ(merged.nbg_codes,
+            (std::vector<std::string>{"AMD", "GEL", "RUB"}));
+  EXPECT_EQ(merged.date, "2026-11-20");
+  EXPECT_EQ(merged.nbg_date, "2026-11-25");
+
+  // Without the ECB, all from the NBG.
+  CurrencyRates nbg_only = MergeRates({}, "", gel, nbg_date);
+  EXPECT_DOUBLE_EQ(nbg_only.rates["USD"], 3 / 2.5);
+  EXPECT_EQ(nbg_only.nbg_codes.size(), 4u);
+  EXPECT_TRUE(MergeRates({}, "", {}, "").rates.empty());
+}
+
+TEST(CurrencyParseTest, KeptOnDiskAndBack) {
+  CurrencyRates rates;
+  rates.rates = {{"USD", 1.25}, {"GEL", 3}};
+  rates.date = "2026-11-20";
+  rates.nbg_codes = {"GEL"};
+  rates.nbg_date = "2026-11-25";
+  rates.fetched = base::Time::FromSecondsSinceUnixEpoch(1800000000);
+  std::optional<CurrencyRates> back = RatesFromDict(RatesToDict(rates));
+  ASSERT_TRUE(back);
+  EXPECT_EQ(back->rates, rates.rates);
+  EXPECT_EQ(back->date, rates.date);
+  EXPECT_EQ(back->nbg_codes, rates.nbg_codes);
+  EXPECT_EQ(back->nbg_date, rates.nbg_date);
+  EXPECT_EQ(back->fetched, rates.fetched);
+  EXPECT_FALSE(RatesFromDict(base::DictValue()));
+}
+
+}  // namespace
+}  // namespace meridian
