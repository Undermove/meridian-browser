+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_CURRENCY_PARSE_H_
+#define CHROME_BROWSER_MERIDIAN_CURRENCY_PARSE_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+#include "base/values.h"
+
+namespace meridian {
+
+// The command bar's currency rates, per euro (EUR itself is left out).
+struct CurrencyRates {
+  CurrencyRates();
+  CurrencyRates(const CurrencyRates&);
+  CurrencyRates& operator=(const CurrencyRates&);
+  ~CurrencyRates();
+
+  std::map<std::string, double> rates;
+  // The ECB's day ("2026-11-20").
+  std::string date;
+  // The codes that came from the National Bank of Georgia, and its day.
+  std::vector<std::string> nbg_codes;
+  std::string nbg_date;
+  // When they were fetched (kept with them on disk).
+  base::Time fetched;
+};
+
+// The ECB file's rates (`<Cube currency='USD' rate='1.08'/>`) and day.
+std::map<std::string, double> ParseEcbRates(const std::string& xml,
+                                            std::string* date);
+
+// The National Bank of Georgia's JSON (lari for `quantity` units of each
+// currency) as lari per one unit, GEL itself 1, and its day.
+std::map<std::string, double> ParseNbgRates(const std::string& json,
+                                            std::string* date);
+
+// The ECB's rates, with what the NBG adds turned into rates per euro (all of
+// the NBG's when the ECB's are missing). Empty when neither has any.
+CurrencyRates MergeRates(const std::map<std::string, double>& ecb,
+                         const std::string& ecb_date,
+                         const std::map<std::string, double>& nbg_gel,
+                         const std::string& nbg_date);
+
+// Kept on disk between runs: the last rates, for when there's no connection.
+base::DictValue RatesToDict(const CurrencyRates& rates);
+std::optional<CurrencyRates> RatesFromDict(const base::DictValue& dict);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_CURRENCY_PARSE_H_
