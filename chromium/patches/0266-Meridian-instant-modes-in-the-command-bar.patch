diff --git a/chrome/browser/meridian/currency_parse.cc b/chrome/browser/meridian/currency_parse.cc
new file mode 100644
index 0000000000..44cd724c84
--- /dev/null
+++ b/chrome/browser/meridian/currency_parse.cc
@@ -0,0 +1,150 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/currency_parse.h"
+
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace meridian {
+
+CurrencyRates::CurrencyRates() = default;
+CurrencyRates::CurrencyRates(const CurrencyRates&) = default;
+CurrencyRates& CurrencyRates::operator=(const CurrencyRates&) = default;
+CurrencyRates::~CurrencyRates() = default;
+
+std::map<std::string, double> ParseEcbRates(const std::string& xml,
+                                            std::string* date) {
+  std::map<std::string, double> out;
+  std::string_view input(xml);
+  std::string code;
+  std::string rate;
+  static const base::NoDestructor<re2::RE2> kRate(
+      R"(currency\s*=\s*['"]([A-Z]{3})['"]\s+rate\s*=\s*['"]([0-9.]+)['"])");
+  while (re2::RE2::FindAndConsume(&input, *kRate, &code, &rate)) {
+    double value = 0;
+    if (base::StringToDouble(rate, &value) && value > 0) {
+      out[code] = value;
+    }
+  }
+  std::string day;
+  if (re2::RE2::PartialMatch(xml, R"(time\s*=\s*['"](\d{4}-\d{2}-\d{2})['"])",
+                             &day)) {
+    *date = day;
+  }
+  return out;
+}
+
+std::map<std::string, double> ParseNbgRates(const std::string& json,
+                                            std::string* date) {
+  std::map<std::string, double> out;
+  std::optional<base::Value> root = base::JSONReader::Read(json, 0);
+  if (!root || !root->is_list() || root->GetList().empty() ||
+      !root->GetList()[0].is_dict()) {
+    return out;
+  }
+  const base::DictValue& day = root->GetList()[0].GetDict();
+  const base::ListValue* currencies = day.FindList("currencies");
+  if (!currencies) {
+    return out;
+  }
+  for (const base::Value& c : *currencies) {
+    if (!c.is_dict()) {
+      continue;
+    }
+    const std::string* code = c.GetDict().FindString("code");
+    std::optional<double> rate = c.GetDict().FindDouble("rate");
+    std::optional<double> quantity = c.GetDict().FindDouble("quantity");
+    if (!code || code->size() != 3 || !rate || *rate <= 0) {
+      continue;
+    }
+    out[*code] = *rate / (quantity && *quantity > 0 ? *quantity : 1);
+  }
+  if (out.empty()) {
+    return out;
+  }
+  out["GEL"] = 1;
+  if (const std::string* d = day.FindString("date"); d && d->size() >= 10) {
+    *date = d->substr(0, 10);
+  }
+  return out;
+}
+
+CurrencyRates MergeRates(const std::map<std::string, double>& ecb,
+                         const std::string& ecb_date,
+                         const std::map<std::string, double>& nbg_gel,
+                         const std::string& nbg_date) {
+  CurrencyRates out;
+  out.rates = ecb;
+  out.date = ecb_date;
+  auto eur = nbg_gel.find("EUR");
+  if (eur == nbg_gel.end() || eur->second <= 0) {
+    return out;
+  }
+  // Lari per euro over lari per unit: units per euro.
+  for (const auto& [code, gel] : nbg_gel) {
+    if (code == "EUR" || gel <= 0 || out.rates.contains(code)) {
+      continue;
+    }
+    out.rates[code] = eur->second / gel;
+    out.nbg_codes.push_back(code);
+  }
+  if (!out.nbg_codes.empty()) {
+    out.nbg_date = nbg_date;
+  }
+  return out;
+}
+
+base::DictValue RatesToDict(const CurrencyRates& rates) {
+  base::DictValue values;
+  for (const auto& [code, rate] : rates.rates) {
+    values.Set(code, rate);
+  }
+  base::ListValue nbg;
+  for (const std::string& code : rates.nbg_codes) {
+    nbg.Append(code);
+  }
+  return base::DictValue()
+      .Set("rates", std::move(values))
+      .Set("date", rates.date)
+      .Set("nbg_codes", std::move(nbg))
+      .Set("nbg_date", rates.nbg_date)
+      .Set("fetched", rates.fetched.InSecondsFSinceUnixEpoch());
+}
+
+std::optional<CurrencyRates> RatesFromDict(const base::DictValue& dict) {
+  const base::DictValue* values = dict.FindDict("rates");
+  if (!values || values->empty()) {
+    return std::nullopt;
+  }
+  CurrencyRates out;
+  for (const auto [code, rate] : *values) {
+    if (rate.is_double() || rate.is_int()) {
+      out.rates[code] = rate.GetDouble();
+    }
+  }
+  if (out.rates.empty()) {
+    return std::nullopt;
+  }
+  if (const std::string* d = dict.FindString("date")) {
+    out.date = *d;
+  }
+  if (const std::string* d = dict.FindString("nbg_date")) {
+    out.nbg_date = *d;
+  }
+  if (const base::ListValue* nbg = dict.FindList("nbg_codes")) {
+    for (const base::Value& code : *nbg) {
+      if (code.is_string()) {
+        out.nbg_codes.push_back(code.GetString());
+      }
+    }
+  }
+  out.fetched = base::Time::FromSecondsSinceUnixEpoch(
+      dict.FindDouble("fetched").value_or(0));
+  return out;
+}
+
+}  // namespace meridian
