+
+// "youtube ⇥ cats" in the command bar, as in Arc and Raycast: a site by its
+// name, then Tab, searches that site. Chromium's own search engine for the
+// site is used when the person has one (its keyword is the site's address);
+// otherwise the search page below.
+
+export interface SiteSearch {
+  name: string;
+  // The site's address, as Chromium's keyword for it would be.
+  host: string;
+  // What can be typed for it.
+  words: string[];
+  // The search page, %s for the words.
+  url: string;
+}
+
+export const SITE_SEARCHES: SiteSearch[] = [
+  {name: 'YouTube', host: 'youtube.com', words: ['youtube', 'yt'],
+   url: 'https://www.youtube.com/results?search_query=%s'},
+  {name: 'GitHub', host: 'github.com', words: ['github', 'gh'],
+   url: 'https://github.com/search?q=%s'},
+  {name: 'Wikipedia', host: 'wikipedia.org',
+   words: ['wikipedia', 'wiki'],
+   url: 'https://en.wikipedia.org/w/index.php?search=%s'},
+  {name: 'Google Maps', host: 'maps.google.com',
+   words: ['maps', 'map', 'google maps', 'gmaps'],
+   url: 'https://www.google.com/maps/search/%s'},
+  {name: 'X', host: 'x.com', words: ['x', 'twitter'],
+   url: 'https://x.com/search?q=%s'},
+  {name: 'Reddit', host: 'reddit.com', words: ['reddit'],
+   url: 'https://www.reddit.com/search/?q=%s'},
+  {name: 'Amazon', host: 'amazon.com', words: ['amazon', 'amz'],
+   url: 'https://www.amazon.com/s?k=%s'},
+  {name: 'Figma', host: 'figma.com', words: ['figma'],
+   url: 'https://www.figma.com/community/search?resource_type=mixed&query=%s'},
+  {name: 'Pinterest', host: 'pinterest.com', words: ['pinterest'],
+   url: 'https://www.pinterest.com/search/pins/?q=%s'},
+  {name: 'Google', host: 'google.com', words: ['google'],
+   url: 'https://www.google.com/search?q=%s'},
+  {name: 'DuckDuckGo', host: 'duckduckgo.com', words: ['duckduckgo', 'ddg'],
+   url: 'https://duckduckgo.com/?q=%s'},
+  {name: 'Stack Overflow', host: 'stackoverflow.com',
+   words: ['stackoverflow', 'stack overflow'],
+   url: 'https://stackoverflow.com/search?q=%s'},
+  {name: 'npm', host: 'npmjs.com', words: ['npm'],
+   url: 'https://www.npmjs.com/search?q=%s'},
+  {name: 'MDN', host: 'developer.mozilla.org', words: ['mdn'],
+   url: 'https://developer.mozilla.org/search?q=%s'},
+  {name: 'Google Images', host: 'images.google.com',
+   words: ['images', 'image'],
+   url: 'https://www.google.com/search?tbm=isch&q=%s'},
+  {name: 'Google Translate', host: 'translate.google.com',
+   words: ['translate', 'tr'],
+   url: 'https://translate.google.com/?sl=auto&tl=en&text=%s&op=translate'},
+];
+
+// The site named by `word` ("youtube", "wiki"), if any.
+export function siteSearchFor(word: string): SiteSearch|null {
+  const w = word.trim().toLowerCase();
+  return w ? SITE_SEARCHES.find(s => s.words.includes(w)) || null : null;
+}
+
+export function siteSearchUrl(site: SiteSearch, terms: string): string {
+  return site.url.replace('%s', encodeURIComponent(terms));
+}
