+  protected onMeridianSpaceChanged_(
+      e: CustomEvent<{color: string, color2: string, grain?: boolean}>) {
     this.style.setProperty('--meridian-space', e.detail.color);
     this.style.setProperty('--meridian-space2', e.detail.color2);
+    if (e.detail.grain !== undefined) {
+      this.toggleAttribute('grain', e.detail.grain);
+    }
   }
 
   // ⌘L and the like: the command bar, editing the current URL.
