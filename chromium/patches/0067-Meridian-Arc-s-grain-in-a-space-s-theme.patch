@@ -404,6 +404,16 @@ bool SidebarService::UpdateSpace(const std::string& space_id,
   return true;
 }
 
+bool SidebarService::SetSpaceGrain(const std::string& space_id, bool grain) {
+  auto it = std::ranges::find(spaces_, space_id, &Space::id);
+  if (it == spaces_.end()) {
+    return false;
+  }
+  it->grain = grain;
+  Changed();
+  return true;
+}
