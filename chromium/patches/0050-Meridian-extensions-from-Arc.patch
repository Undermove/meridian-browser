+// An extension installed in Arc (from the Chrome Web Store), to install again
+// in Meridian.
+struct ArcExtension {
+  std::string id;
+  std::string name;
+};
+
+// The extensions in Arc's profiles (User Data/<profile>/Extensions), each once,
+// by name; themes and Arc's own are left out. Blocking (file IO).
+std::vector<ArcExtension> ReadArcExtensions();
