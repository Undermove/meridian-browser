+std::vector<ArcExtension> ReadArcExtensionsIn(const base::FilePath& arc_dir);
+
+// The extension's name from its manifest, with a "__MSG_name__" looked up in
+// its default locale. `dir` is the folder of one version. Empty if unreadable.
+std::string ExtensionNameIn(const base::FilePath& dir);
+
