+void SidebarHandler::GetArcExtensions(GetArcExtensionsCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadArcExtensions),
+      base::BindOnce(
+          [](base::WeakPtr<SidebarHandler> self,
+             GetArcExtensionsCallback callback,
+             std::vector<ArcExtension> found) {
+            std::vector<mojom::ArcExtensionPtr> out;
+            extensions::ExtensionRegistry* registry =
+                self ? extensions::ExtensionRegistry::Get(
+                           self->browser_->GetProfile())
+                     : nullptr;
+            for (const ArcExtension& e : found) {
+              out.push_back(mojom::ArcExtension::New(
+                  e.id, e.name,
+                  registry && registry->GetInstalledExtension(e.id)));
+            }
+            std::move(callback).Run(std::move(out));
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
 void SidebarHandler::GetSiteInfo(GetSiteInfoCallback callback) {
   std::move(callback).Run(meridian::GetSiteInfo(
       browser_->GetProfile(), model()->GetActiveWebContents()));
