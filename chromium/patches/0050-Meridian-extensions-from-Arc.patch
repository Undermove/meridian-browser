 }
 
+
+namespace {
+
+std::optional<base::DictValue> ReadJsonDict(const base::FilePath& path) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(path, &text, 4 * 1024 * 1024)) {
+    return std::nullopt;
+  }
+  // Some extensions' messages.json start with a byte order mark.
+  if (text.starts_with("\xEF\xBB\xBF")) {
+    text.erase(0, 3);
+  }
+  std::optional<base::Value> value = base::JSONReader::Read(
+      text, base::JSON_PARSE_CHROMIUM_EXTENSIONS | base::JSON_ALLOW_TRAILING_COMMAS);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(*value).TakeDict();
+}
+
+// A Chrome Web Store id: 32 letters a-p.
+bool IsWebStoreId(const std::string& id) {
+  return id.size() == 32 &&
+         std::ranges::all_of(id, [](char c) { return c >= 'a' && c <= 'p'; });
+}
+
+}  // namespace
+
+std::string ExtensionNameIn(const base::FilePath& dir) {
+  std::optional<base::DictValue> manifest =
+      ReadJsonDict(dir.Append("manifest.json"));
+  if (!manifest) {
+    return std::string();
+  }
+  // Themes change Arc's colours; Meridian has its own space themes.
+  if (manifest->Find("theme")) {
+    return std::string();
+  }
+  const std::string* name = manifest->FindString("name");
+  if (!name) {
+    return std::string();
+  }
+  std::string out = *name;
+  if (out.starts_with("__MSG_") && out.ends_with("__") && out.size() > 8) {
+    std::string key = base::ToLowerASCII(out.substr(6, out.size() - 8));
+    const std::string* locale = manifest->FindString("default_locale");
+    std::optional<base::DictValue> messages = ReadJsonDict(
+        dir.Append("_locales")
+            .AppendASCII(locale ? *locale : "en")
+            .Append("messages.json"));
+    out.clear();
+    if (messages) {
+      // Message keys are case-insensitive.
+      for (auto [k, v] : *messages) {
+        if (base::ToLowerASCII(k) == key && v.is_dict()) {
+          if (const std::string* m = v.GetDict().FindString("message")) {
+            out = *m;
+          }
+          break;
+        }
+      }
+    }
+  }
+  return std::string(base::TrimWhitespaceASCII(out, base::TRIM_ALL));
+}
+
+std::vector<ArcExtension> ReadArcExtensions() {
+  return ReadArcExtensionsIn(ArcDataDir());
+}
+
+std::vector<ArcExtension> ReadArcExtensionsIn(const base::FilePath& arc_dir) {
+  std::vector<ArcExtension> out;
+  std::set<std::string> seen;
+  base::FilePath user_data = arc_dir.Append("User Data");
+  base::FileEnumerator profiles(user_data, false,
+                                base::FileEnumerator::DIRECTORIES);
+  std::vector<base::FilePath> dirs;
+  for (base::FilePath dir = profiles.Next(); !dir.empty();
+       dir = profiles.Next()) {
+    const std::string name = dir.BaseName().value();
+    if (name == "Default" || name.starts_with("Profile ")) {
+      dirs.push_back(dir);
+    }
+  }
+  std::ranges::sort(dirs);
+  for (const base::FilePath& profile : dirs) {
+    base::FileEnumerator ids(profile.Append("Extensions"), false,
+                             base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath id_dir = ids.Next(); !id_dir.empty();
+         id_dir = ids.Next()) {
+      const std::string id = id_dir.BaseName().value();
+      if (!IsWebStoreId(id) || seen.contains(id)) {
+        continue;
+      }
+      // The newest version folder.
+      base::FileEnumerator versions(id_dir, false,
+                                    base::FileEnumerator::DIRECTORIES);
+      base::FilePath newest;
+      for (base::FilePath v = versions.Next(); !v.empty(); v = versions.Next()) {
+        if (newest.empty() || v.BaseName().value() > newest.BaseName().value()) {
+          newest = v;
+        }
+      }
+      std::string ext_name = newest.empty() ? "" : ExtensionNameIn(newest);
+      if (ext_name.empty()) {
+        continue;
+      }
+      seen.insert(id);
+      out.push_back({id, ext_name});
+    }
+  }
+  std::ranges::sort(out, [](const ArcExtension& a, const ArcExtension& b) {
+    return base::ToLowerASCII(a.name) < base::ToLowerASCII(b.name);
+  });
+  return out;
+}
+
 }  // namespace meridian
