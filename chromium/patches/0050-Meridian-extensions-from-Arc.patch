 }
 
+
+// Writes an extension version folder: Extensions/<id>/<version>/.
+void WriteExtension(const base::FilePath& profile,
+                    const std::string& id,
+                    const std::string& version,
+                    const std::string& manifest,
+                    const std::string& messages = "") {
+  base::FilePath dir = profile.Append("Extensions").AppendASCII(id).AppendASCII(version);
+  ASSERT_TRUE(base::CreateDirectory(dir));
+  ASSERT_TRUE(base::WriteFile(dir.Append("manifest.json"), manifest));
+  if (!messages.empty()) {
+    base::FilePath locale = dir.Append("_locales").Append("en");
+    ASSERT_TRUE(base::CreateDirectory(locale));
+    ASSERT_TRUE(base::WriteFile(locale.Append("messages.json"), messages));
+  }
+}
+
+TEST(ArcImportTest, ReadsArcExtensionsOnceByNameWithoutThemes) {
+  base::ScopedTempDir arc;
+  ASSERT_TRUE(arc.CreateUniqueTempDir());
+  base::FilePath def = arc.GetPath().Append("User Data").Append("Default");
+  base::FilePath p2 = arc.GetPath().Append("User Data").Append("Profile 2");
+  const std::string ublock(32, 'c');
+  const std::string dark(32, 'd');
+  const std::string theme(32, 'e');
+  WriteExtension(def, ublock, "1.0", R"({"name": "uBlock Origin Lite"})");
+  // The newest version's name, with the message looked up (any case, and a
+  // byte order mark).
+  WriteExtension(def, dark, "1.0", R"({"name": "Old"})");
+  WriteExtension(def, dark, "2.0",
+                 R"({"name": "__MSG_appName__", "default_locale": "en"})",
+                 "\xEF\xBB\xBF{\"APPNAME\": {\"message\": \"Dark Reader\"}}");
+  WriteExtension(p2, ublock, "1.0", R"({"name": "uBlock Origin Lite"})");
+  WriteExtension(p2, theme, "1.0", R"({"name": "Blue", "theme": {}})");
+  // Not a Web Store id (unpacked or Arc's own).
+  WriteExtension(p2, "arc-internal", "1.0", R"({"name": "Arc Helper"})");
+
+  std::vector<ArcExtension> got = ReadArcExtensionsIn(arc.GetPath());
+  ASSERT_EQ(got.size(), 2u);
+  EXPECT_EQ(got[0].name, "Dark Reader");
+  EXPECT_EQ(got[0].id, dark);
+  EXPECT_EQ(got[1].name, "uBlock Origin Lite");
+  EXPECT_EQ(got[1].id, ublock);
+}
+
+TEST(ArcImportTest, NoArcMeansNoExtensions) {
+  base::ScopedTempDir arc;
+  ASSERT_TRUE(arc.CreateUniqueTempDir());
+  EXPECT_TRUE(ReadArcExtensionsIn(arc.GetPath()).empty());
+}
+
 }  // namespace
 }  // namespace meridian
