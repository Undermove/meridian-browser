+// The AI features' question goes to the frontmost Meridian window of the
+// profile (its spaces' too): "cancel" when there is none, or it closes first.
+void AskAiConsentIn(Profile* profile,
+                    const std::string& to,
+                    AiService::ConsentAnswer answer) {
+  SidebarHandler* best = nullptr;
+  Profile* main = MainProfileFor(profile);
+  for (auto& [browser, handler] : Handlers()) {
+    if (MainProfileFor(browser->GetProfile()) != main ||
+        !handler->page_connected()) {
+      continue;
+    }
+    if (!best || browser->IsActive()) {
+      best = handler;
+    }
+  }
+  if (!best) {
+    std::move(answer).Run("cancel");
+    return;
+  }
+  best->AskAiConsent(to, std::move(answer));
+}
+
