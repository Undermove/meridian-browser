+}
+
+p {
+  margin: 6px 20px;
+  line-height: 1.5;
+}
+
+.muted {
+  color: var(--meridian-text-muted);
+  font-size: 12px;
+}
+
+.choices {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  padding: 14px 20px 18px;
+}
+
+.btn {
+  height: 28px;
+  padding: 0 14px;
+  border: 0;
+  border-radius: 8px;
+  font: inherit;
+  font-weight: 550;
+  color: var(--meridian-text);
+  background: color-mix(in srgb, var(--meridian-text) 8%, transparent);
+  cursor: pointer;
+}
+
+.btn.primary {
+  color: white;
+  background: var(--meridian-space);
+}
+
+.btn.quiet {
+  margin-left: auto;
+  background: none;
+  color: var(--meridian-text-muted);
+}
