+namespace {
+
+AiService::ConsentAsker& Asker() {
+  static base::NoDestructor<AiService::ConsentAsker> asker;
+  return *asker;
+}
+
+}  // namespace
+
+// static
+void AiService::SetConsentAsker(ConsentAsker asker) {
+  Asker() = std::move(asker);
+}
+
+// static
+std::string AiService::DestinationOf(const std::string& provider) {
+  if (provider == "api" || provider == "claude") {
+    return "Anthropic (Claude)";
+  }
+  const ai::Provider* p = ai::FindProvider(provider);
+  if (!p || p->kind == ai::Kind::kOllama || p->kind == ai::Kind::kOpenAiLocal) {
+    return std::string();
+  }
+  return p->vendor.empty() || p->vendor == p->label
+             ? p->label
+             : p->vendor + " (" + p->label + ")";
+}
+
+bool AiService::ConsentGiven(const std::string& provider) const {
+  const std::string consent =
+      profile_->GetPrefs()->GetString(prefs::kAiConsent);
+  if (consent == "off") {
+    return false;
+  }
+  // On this computer, said yes already, or a test that doesn't ask about it.
+  return DestinationOf(provider).empty() || consent == "always" ||
+         consent_this_run_ ||
+         (TestSwitchesAllowed() && !HasTestSwitch("meridian-test-ai-consent")) ||
+         Asker().is_null();
+}
+
+void AiService::WhenAllowed(
+    const std::string& provider,
+    base::OnceClosure go,
+    base::OnceCallback<void(const std::string&)> refuse) {
+  if (profile_->GetPrefs()->GetString(prefs::kAiConsent) == "off") {
+    return std::move(refuse).Run(
+        "AI features are off. Turn them on in Settings › AI.");
+  }
+  if (ConsentGiven(provider)) {
+    return std::move(go).Run();
+  }
+  const std::string to = DestinationOf(provider);
+  consent_waiting_.emplace_back(std::move(go), std::move(refuse));
+  if (consent_waiting_.size() > 1) {
+    return;  // one question for all of them
+  }
+  Asker().Run(profile_, to,
+              base::BindOnce(&AiService::OnConsent,
+                             weak_factory_.GetWeakPtr()));
+}
+
+void AiService::OnConsent(const std::string& choice) {
+  if (choice == "always") {
+    profile_->GetPrefs()->SetString(prefs::kAiConsent, "always");
+  } else if (choice == "off") {
+    profile_->GetPrefs()->SetString(prefs::kAiConsent, "off");
+  }
+  const bool yes = choice == "send" || choice == "always";
+  if (yes) {
+    consent_this_run_ = true;
+  }
+  const std::string why =
+      choice == "off"     ? "AI features are off. Turn them on in Settings › AI."
+      : choice == "other" ? "Pick the AI to use in Settings › AI."
+                          : "Not sent: you didn’t allow it.";
+  auto waiting = std::move(consent_waiting_);
+  consent_waiting_.clear();
+  for (auto& [go, refuse] : waiting) {
+    if (yes) {
+      std::move(go).Run();
+    } else {
+      std::move(refuse).Run(why);
+    }
+  }
+}
