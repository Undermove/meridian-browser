@@ -0,0 +1,122 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Before an AI feature (⌘J, Tidy, Improve with AI, link previews…) sends
+// anything to an AI service on the internet, Meridian says where it goes and
+// the person decides: send (and don't ask again this run), always send, pick
+// another AI, or turn the AI features off. Nothing leaves before an answer.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './ai_consent.css.js';
+import {getHtml} from './ai_consent.html.js';
+
+interface Question {
+  to: string;
+  answer: (choice: string) => void;
+}
+
+export class MeridianAiConsentElement extends CrLitElement {
+  static get is() {
+    return 'meridian-ai-consent';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      to_: {state: true, type: String},
+    };
+  }
+
+  accessor open: boolean = false;
+  protected accessor to_: string = '';
+
+  private question_: Question|null = null;
+  private listener_: number|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    const router = browserProxyFactory.getInstance().callbackRouter;
+    this.listener_ = router.askAiConsent.addListener(
+        (to: string) => new Promise<{choice: string}>(resolve => {
+          // A question still open: the new one gets the same answer.
+          if (this.question_) {
+            const earlier = this.question_.answer;
+            this.question_.answer = (choice: string) => {
+              earlier(choice);
+              resolve({choice});
+            };
+            return;
+          }
+          this.question_ = {to, answer: (choice) => resolve({choice})};
+          this.to_ = to;
+          this.open = true;
+          this.updateComplete.then(
+              () => this.shadowRoot.querySelector<HTMLElement>('#cancel')
+                        ?.focus());
+        }));
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    if (this.listener_ !== null) {
+      browserProxyFactory.getInstance().callbackRouter.removeListener(
+          this.listener_);
+      this.listener_ = null;
+    }
+  }
+
+  private answer_(choice: string) {
+    const q = this.question_;
+    this.question_ = null;
+    this.open = false;
+    q?.answer(choice);
+  }
+
+  protected onSendClick_() {
+    this.answer_('send');
+  }
+
+  protected onAlwaysClick_() {
+    this.answer_('always');
+  }
+
+  protected onOtherClick_() {
+    this.answer_('other');
+    this.fire('meridian-show-settings', 'ai');
+  }
+
+  protected onOffClick_() {
+    this.answer_('off');
+  }
+
+  protected onCancelClick_() {
+    this.answer_('cancel');
+  }
+
+  protected onKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.answer_('cancel');
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-ai-consent': MeridianAiConsentElement;
+  }
+}
+
+customElements.define(MeridianAiConsentElement.is, MeridianAiConsentElement);
