+// The background commands an agent left running: shells (`sh -c …`, how
+// Claude Code runs a Bash command) below the agent's own process, under the
+// terminal's process `root`. While the agent waits for its next prompt they
+// are its background tasks.
+int BackgroundShells(int root,
+                     const std::map<int, std::vector<int>>& children,
+                     const std::map<int, std::vector<std::string>>& args) {
+  int count = 0;
+  std::vector<std::pair<int, int>> stack = {{root, 0}};
+  while (!stack.empty()) {
+    auto [pid, depth] = stack.back();
+    stack.pop_back();
+    auto a = args.find(pid);
+    // The terminal runs the agent itself: any shell under it with -c is a
+    // command it started (Meridian's own hooks and status line aside).
+    if (depth >= 1 && a != args.end() && !a->second.empty()) {
+      std::string exe = base::FilePath(a->second[0]).BaseName().value();
+      if (exe.starts_with("-")) {
+        exe = exe.substr(1);
+      }
+      bool shell = exe == "sh" || exe == "bash" || exe == "zsh" ||
+                   exe == "dash" || exe == "fish";
+      bool dash_c = std::ranges::find(a->second, "-c") != a->second.end() ||
+                    std::ranges::find(a->second, "-lc") != a->second.end();
+      std::string line = base::JoinString(a->second, " ");
+      if (shell && dash_c && line.find("claude") == std::string::npos &&
+          line.find("codex") == std::string::npos &&
+          line.find("--mission-hook") == std::string::npos &&
+          line.find("--secret-guard") == std::string::npos &&
+          line.find("--permission-hook") == std::string::npos) {
+        ++count;
+        continue;  // its own children are part of the same task
+      }
+    }
+    auto c = children.find(pid);
+    if (c != children.end() && depth < 12) {
+      for (int child : c->second) {
+        stack.emplace_back(child, depth + 1);
+      }
+    }
+  }
+  return count;
+}
+
+}  // namespace
+
+void WorkbenchHandler::CountBackgroundTasks() {
+  std::map<std::string, int> roots;
+  for (const auto& [id, term] : terms_) {
+    if (!term.mission_node.empty() && term.container.empty() &&
+        term.terminal && term.exited.is_none()) {
+      roots[id] = term.terminal->pid();
+    }
+  }
+  if (roots.empty()) {
+    return;
+  }
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(web_ui()->GetWebContents());
+  const int owner = tab ? tab->GetHandle().raw_value() : 0;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](std::map<std::string, int> roots) {
+            std::map<std::string, int> counts;
+#if !BUILDFLAG(IS_WIN)
+            std::map<int, std::vector<int>> children;
+            std::map<int, std::vector<std::string>> args;
+            base::ProcessIterator it(nullptr);
+            while (const base::ProcessEntry* e = it.NextProcessEntry()) {
+              children[e->parent_pid()].push_back(e->pid());
+              args[e->pid()] = e->cmd_line_args();
+            }
+            for (const auto& [id, pid] : roots) {
+              counts[id] = BackgroundShells(pid, children, args);
+            }
+#endif
+            return counts;
+          },
+          std::move(roots)),
+      base::BindOnce(
+          [](base::WeakPtr<WorkbenchHandler> self, int owner,
+             std::map<std::string, int> counts) {
+            if (!self) {
+              return;
+            }
+            if (mission::MissionControl* mission =
+                    mission::MissionControlFactory::GetForProfile(
+                        self->profile_)) {
+              mission->SetBackgroundTasks(owner, counts);
+            }
+          },
+          weak_factory_.GetWeakPtr(), owner));
+}
