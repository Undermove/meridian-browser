From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Wed, 4 Nov 2026 11:49:00 +0400
Subject: [PATCH 92/92] =?UTF-8?q?=E2=8C=98=E2=8C=A5=E2=86=91/=E2=86=93=20b?=
 =?UTF-8?q?eat=20the=20page;=20the=20sidebar=20follows=20a=20pinned=20tab?=
 =?UTF-8?q?=20into=20its=20folder?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- ⌘⌥↑/↓ are reserved like the space keys: a page that keeps arrow keys
  for itself (an editor, a slideshow) no longer swallows them.
- A pinned tab opened from the sidebar shows in Today for a moment before
  its item comes back with the state; the sidebar scrolled to that Today
  row and stopped there, so stepping through a long folder of unloaded
  pinned tabs left the active one out of sight. It now scrolls again
  whenever the active tab's row changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../webui_browser/meridian/sidebar.ts         | 27 ++++++++++++-------
 chrome/browser/ui/accelerator_table.cc        |  6 +++--
 2 files changed, 21 insertions(+), 12 deletions(-)

diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
index ad09561783..3d04359d7f 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
@@ -207,8 +207,9 @@ export class MeridianSidebarElement extends CrLitElement implements
   protected accessor playerToggle_: string = 'pause';
   protected accessor playerToggleIcon_: IconName = 'pause';
   private nowPlayingTimer_ = 0;
-  // The active tab the sidebar last scrolled to (Arc keeps it in sight).
-  private shownActive_: string|null = null;
+  // The active tab the sidebar last scrolled to, and its row (Arc keeps it
+  // in sight).
+  private shownActive_: {id: string, row: HTMLElement}|null = null;
   private nowPlayingPoll_ = 0;
   // Which side it comes from: 1 the right (the next space), -1 the left.
   private ghostDir_ = 1;
@@ -1542,16 +1543,16 @@ export class MeridianSidebarElement extends CrLitElement implements
 
 
   // Arc: whatever made a tab active (⌘⌥↑/↓, ⌃⇥, Switch to Tab, a link), its
-  // row scrolls into the sidebar's view, once it has rendered.
+  // row scrolls into the sidebar's view, once it has rendered. Again when
+  // that row moves: a pinned tab opened from the sidebar shows in Today for
+  // a moment, before the item it belongs to comes back with the state.
   private keepActiveInSight_() {
-    const active = [...this.tabs_.values()].find(t => t.isActive);
-    const id = active ? active.id : null;
-    if (id === this.shownActive_) {
-      return;
-    }
-    this.shownActive_ = id;
     // After the rows (and a pinned row's own render) caught up.
     setTimeout(() => {
+      const active = [...this.tabs_.values()].find(t => t.isActive);
+      if (!active) {
+        return;
+      }
       const rows = [
         ...this.shadowRoot.querySelectorAll<HTMLElement>('meridian-tab-row'),
       ];
@@ -1576,7 +1577,13 @@ export class MeridianSidebarElement extends CrLitElement implements
         };
         row = find(this.shadowRoot);
       }
-      row?.scrollIntoView({block: 'nearest'});
+      if (!row ||
+          (this.shownActive_?.id === active.id &&
+           this.shownActive_.row === row)) {
+        return;
+      }
+      this.shownActive_ = {id: active.id, row};
+      row.scrollIntoView({block: 'nearest'});
     });
   }
 
diff --git a/chrome/browser/ui/accelerator_table.cc b/chrome/browser/ui/accelerator_table.cc
index 092f068799..71a0f80e26 100644
--- a/chrome/browser/ui/accelerator_table.cc
+++ b/chrome/browser/ui/accelerator_table.cc
@@ -357,10 +357,12 @@ constexpr int kReservedCommandIds[] = {
     IDC_CYCLE_TO_NEXT_TAB,
     IDC_CYCLE_TO_PREV_TAB,
     IDC_EXIT,
-    // Meridian: switching spaces works whatever the page does with the keys,
-    // like Arc (pages can't keep ⌘⌥←/→ or ⌃1-9 for themselves).
+    // Meridian: switching spaces and tabs works whatever the page does with
+    // the keys, like Arc (pages can't keep ⌘⌥←/→/↑/↓ or ⌃1-9 for themselves).
     IDC_MERIDIAN_NEXT_SPACE,
     IDC_MERIDIAN_PREVIOUS_SPACE,
+    IDC_MERIDIAN_NEXT_TAB,
+    IDC_MERIDIAN_PREVIOUS_TAB,
     IDC_MERIDIAN_SPACE_1,
     IDC_MERIDIAN_SPACE_1 + 1,
     IDC_MERIDIAN_SPACE_1 + 2,
