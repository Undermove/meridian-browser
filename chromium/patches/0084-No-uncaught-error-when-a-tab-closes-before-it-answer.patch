From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Wed, 4 Nov 2026 01:47:08 +0400
Subject: [PATCH 085/114] No uncaught error when a tab closes before it answers

The UI asked the active tab for its security icon and back/forward state
without handling a closed pipe; a link that turns into a download closes
its tab first, which left an unhandled rejection in the browser UI.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/resources/webui_browser/app.ts |  3 +-
 .../resources/webui_browser/webview.ts        | 28 ++++++++++++++-----
 2 files changed, 23 insertions(+), 8 deletions(-)

diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index d10c89de40..b14867f3dc 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -431,7 +431,8 @@ export class WebuiBrowserAppElement extends CrLitElement {
       if (tabWebView) {
         tabWebView.getSecurityIcon().then(securityIcon => {
           // The content may have changed by the time this is resolved.
-          if (this.$.contentRegion.activeWebview === tabWebView) {
+          if (securityIcon !== null &&
+              this.$.contentRegion.activeWebview === tabWebView) {
             const iconName = this.securityIconToIconNameMap.get(securityIcon);
             assert(iconName);
             this.locationIcon_ = iconName;
diff --git a/chrome/browser/resources/webui_browser/webview.ts b/chrome/browser/resources/webui_browser/webview.ts
index 33ff8a30e2..a614a5518b 100644
--- a/chrome/browser/resources/webui_browser/webview.ts
+++ b/chrome/browser/resources/webui_browser/webview.ts
@@ -141,9 +141,15 @@ export class TabWebviewElement extends WebviewElement {
     this.guestHandler.openPageInfoMenu();
   }
 
-  async getSecurityIcon(): Promise<SecurityIcon> {
-    const {securityIcon} = await this.guestHandler.getSecurityIcon();
-    return securityIcon;
+  // These ask the tab, which may close before it answers (a link that turns
+  // into a download): then there is nothing to show.
+  async getSecurityIcon(): Promise<SecurityIcon|null> {
+    try {
+      const {securityIcon} = await this.guestHandler.getSecurityIcon();
+      return securityIcon;
+    } catch {
+      return null;
+    }
   }
 
   private attachTabContents() {
@@ -178,13 +184,21 @@ export class TabWebviewElement extends WebviewElement {
   }
 
   async canGoBack(): Promise<boolean> {
-    const {canGoBack} = await this.guestHandler.canGoBack();
-    return canGoBack;
+    try {
+      const {canGoBack} = await this.guestHandler.canGoBack();
+      return canGoBack;
+    } catch {
+      return false;
+    }
   }
 
   async canGoForward(): Promise<boolean> {
-    const {canGoForward} = await this.guestHandler.canGoForward();
-    return canGoForward;
+    try {
+      const {canGoForward} = await this.guestHandler.canGoForward();
+      return canGoForward;
+    } catch {
+      return false;
+    }
   }
 }
 
