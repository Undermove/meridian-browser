@@ -66,3 +68,49 @@ export function siteSearchFor(word: string): SiteSearch|null {
 export function siteSearchUrl(site: SiteSearch, terms: string): string {
   return site.url.replace('%s', encodeURIComponent(terms));
 }
+
+// The site a "!bang" names: its bangs or any of its words ("!yt", "!g",
+// "!wiki"), DuckDuckGo-style.
+export function siteForBang(bang: string): SiteSearch|null {
+  const w = bang.trim().toLowerCase();
+  if (!w) {
+    return null;
+  }
+  return SITE_SEARCHES.find(s => (s.bangs || []).includes(w)) ||
+      SITE_SEARCHES.find(s => s.words.includes(w)) || null;
+}
+
+export interface Bang {
+  site: SiteSearch;
+  // What to search for; empty for the bang alone ("!yt" opens the site).
+  terms: string;
+  // The URL it opens.
+  url: string;
+}
+
+// "!yt lofi", "lofi !yt" or "!yt": a site search typed as a bang, from the
+// same table as "youtube ⇥ lofi". Null when the text has no known bang.
+export function parseBang(text: string): Bang|null {
+  const t = text.trim();
+  let m = /^!(\S+)(?:\s+(.*))?$/s.exec(t);
+  let bang = '';
+  let terms = '';
+  if (m) {
+    bang = m[1]!;
+    terms = (m[2] || '').trim();
+  } else {
+    m = /^(.*\S)\s+!(\S+)$/s.exec(t);
+    if (!m) {
+      return null;
+    }
+    terms = m[1]!.trim();
+    bang = m[2]!;
+  }
+  const site = siteForBang(bang);
+  if (!site) {
+    return null;
+  }
+  const url = terms ? siteSearchUrl(site, terms) : `https://${
+      site.host === 'maps.google.com' ? 'www.google.com/maps' : site.host}`;
+  return {site, terms, url};
+}
