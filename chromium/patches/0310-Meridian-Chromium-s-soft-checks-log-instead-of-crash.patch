From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 26 Nov 2026 11:39:02 +0400
Subject: [PATCH 2/4] Meridian: Chromium's soft checks log instead of crashing

Meridian's releases are not OFFICIAL_BUILD, and outside official builds
base/check.cc made every DUMP_WILL_BE_CHECK and CHECK(..., NotFatalUntil)
not yet due fatal. Chrome stable only logs them and dumps without
crashing: the subpixel-opacity check in views::Label::PaintText ended
Meridian at every start. GetDumpSeverity() now gives what an official
build gives.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 base/check.cc                                 | 13 ++++----
 chrome/browser/meridian/BUILD.gn              |  1 +
 .../browser/meridian/soft_checks_unittest.cc  | 30 +++++++++++++++++++
 3 files changed, 37 insertions(+), 7 deletions(-)
 create mode 100644 chrome/browser/meridian/soft_checks_unittest.cc

diff --git a/base/check.cc b/base/check.cc
index f935dbad04..c195d283e1 100644
--- a/base/check.cc
+++ b/base/check.cc
@@ -60,14 +60,13 @@ constexpr char kCheckFailureMessageSeparator[] =
     ;
 
 LogSeverity GetDumpSeverity() {
-#if defined(OFFICIAL_BUILD)
+  // Meridian: its releases are what people run but are not OFFICIAL_BUILD
+  // (that needs Google's internal setup), and outside official builds every
+  // DUMP_WILL_BE_CHECK and CHECK(..., base::NotFatalUntil::M...) not yet due
+  // is fatal. Chrome stable only logs them (and dumps without crashing): one
+  // in views::Label::PaintText ended Meridian at every start. As in an
+  // official build.
   return DCHECK_IS_ON() ? LOGGING_DCHECK : LOGGING_ERROR;
-#else
-  // Crash outside official builds (outside user-facing builds) to detect
-  // invariant violations early in release-build testing like fuzzing, etc.
-  // These should eventually be migrated to fatal CHECKs.
-  return LOGGING_FATAL;
-#endif
 }
 
 LogSeverity GetNotFatalUntilSeverity(base::NotFatalUntil fatal_milestone) {
diff --git a/chrome/browser/meridian/BUILD.gn b/chrome/browser/meridian/BUILD.gn
index 174c027f3a..a9ca81eac1 100644
--- a/chrome/browser/meridian/BUILD.gn
+++ b/chrome/browser/meridian/BUILD.gn
@@ -581,6 +581,7 @@ test("meridian_unittests") {
     "self_install_unittest.cc",
     "setup_profile_unittest.cc",
     "sidebar_service_unittest.cc",
+    "soft_checks_unittest.cc",
     "test_links.h",
     "update_check_unittest.cc",
     "ai/accounts_unittest.cc",
diff --git a/chrome/browser/meridian/soft_checks_unittest.cc b/chrome/browser/meridian/soft_checks_unittest.cc
new file mode 100644
index 0000000000..e078f1024b
--- /dev/null
+++ b/chrome/browser/meridian/soft_checks_unittest.cc
@@ -0,0 +1,30 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/check.h"
+#include "base/not_fatal_until.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+// Meridian ships non-official builds; Chromium's soft checks (not fatal yet)
+// must only log there, as in Chrome stable (base/check.cc GetDumpSeverity):
+// one in views::Label::PaintText once ended Meridian at every start.
+TEST(SoftChecksTest, NotFatalUntilAndDumpWillBeCheckDoNotCrash) {
+  int reached = 0;
+  CHECK(false, base::NotFatalUntil::M235) << "a soft check";
+  ++reached;
+  DUMP_WILL_BE_CHECK(false) << "a dump-only check";
+  ++reached;
+  EXPECT_EQ(reached, 2);
+}
+
+// Real CHECKs still stop.
+TEST(SoftChecksDeathTest, PlainCheckStillCrashes) {
+  EXPECT_DEATH_IF_SUPPORTED(CHECK(false) << "fatal", "");
+}
+
+}  // namespace
+}  // namespace meridian
