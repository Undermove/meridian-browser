+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_CRASH_WATCHER_WIN_H_
+#define CHROME_BROWSER_MERIDIAN_CRASH_WATCHER_WIN_H_
+
+namespace meridian {
+
+// The Windows side of crash_watcher_mac.h: if the browser process crashes,
+// a small watcher (meridian.exe itself with `--meridian-crash-watcher=<pid>`,
+// no windows) opens Meridian again, which restores the tabs and the agents'
+// sessions. Only when the profile's exit_type is still "Crashed", not when
+// another Meridian holds the profile, not twice within two minutes, only for
+// an installed copy, and not under tests (--remote-debugging-*,
+// --meridian-test-*), unless --meridian-crash-relaunch asks for it
+// (=dry: the watcher only leaves its mark).
+//
+// argv is main()'s, in UTF-8 (helper_modes.cc makes it from the command line).
+
+// Called for the browser process before it starts: launches the watcher.
+void MaybeStartCrashWatcher(int argc, const char** argv);
+
+bool IsCrashWatcher(int argc, const char** argv);
+int RunCrashWatcher(int argc, const char** argv);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_CRASH_WATCHER_WIN_H_
