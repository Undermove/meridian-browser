+  if (!helper && line.find(L"--type=") != std::wstring_view::npos) {
     return std::nullopt;
   }
   // main()'s arguments, in UTF-8.
@@ -74,9 +80,14 @@ std::optional<int> RunHelperMode() {
     argv.push_back(arg.c_str());
   }
   const int argc = static_cast<int>(argv.size());
+  if (IsCrashWatcher(argc, argv.data())) {
+    return RunCrashWatcher(argc, argv.data());
