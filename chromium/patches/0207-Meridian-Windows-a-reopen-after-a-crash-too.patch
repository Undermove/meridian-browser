diff --git a/chrome/browser/meridian/crash_watcher_win.cc b/chrome/browser/meridian/crash_watcher_win.cc
new file mode 100644
index 0000000000..34f8b5bdab
--- /dev/null
+++ b/chrome/browser/meridian/crash_watcher_win.cc
@@ -0,0 +1,275 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/crash_watcher_win.h"
+
+#include <windows.h>
+
+#include <objbase.h>
+#include <shlobj.h>
+#include <stdlib.h>
+
+#include <string>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr std::string_view kWatcher = "--meridian-crash-watcher=";
+constexpr std::string_view kUserDataDir = "--user-data-dir=";
+constexpr std::string_view kDry = "--meridian-crash-relaunch=dry";
+constexpr wchar_t kMark[] = L"\\Meridian Crash Relaunch";
+// In FILETIME's units (100 ns).
+constexpr int64_t kLoop = int64_t{120} * 10'000'000;
+
+bool StartsWith(std::string_view s, std::string_view prefix) {
+  return s.substr(0, prefix.size()) == prefix;
+}
+
+base::span<const char*> Args(int argc, const char** argv) {
+  // main()'s own arguments.
+  return UNSAFE_BUFFERS(base::span(argv, static_cast<size_t>(argc)));
+}
+
+std::string ValueOf(int argc, const char** argv, std::string_view sw) {
+  for (const char* a : Args(argc, argv).subspan(1u)) {
+    if (a && StartsWith(a, sw)) {
+      return std::string(std::string_view(a).substr(sw.size()));
+    }
+  }
+  return {};
+}
+
+bool Has(int argc, const char** argv, std::string_view prefix) {
+  for (const char* a : Args(argc, argv).subspan(1u)) {
+    if (a && StartsWith(a, prefix)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::wstring ExePath() {
+  wchar_t path[MAX_PATH * 4];
+  DWORD n = ::GetModuleFileNameW(nullptr, path, std::size(path));
+  return n > 0 && n < std::size(path) ? std::wstring(path, n) : std::wstring();
+}
+
+// %LOCALAPPDATA%\Meridian Browser\User Data (install_static's folder).
+std::wstring DefaultUserDataDir() {
+  PWSTR local = nullptr;
+  std::wstring dir;
+  if (SUCCEEDED(::SHGetKnownFolderPath(FOLDERID_LocalAppData, 0, nullptr,
+                                       &local))) {
+    dir = std::wstring(local) + L"\\Meridian Browser\\User Data";
+  }
+  ::CoTaskMemFree(local);
+  return dir;
+}
+
+// A copy that Meridian's installer put there: its version folder (where
+// chrome.dll, this code, is) has Installer\setup.exe, as the updater checks.
+bool IsInstalledCopy() {
+  HMODULE module = nullptr;
+  if (!::GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            reinterpret_cast<LPCWSTR>(&IsCrashWatcher),
+                            &module)) {
+    return false;
+  }
+  wchar_t path[MAX_PATH * 4];
+  DWORD n = ::GetModuleFileNameW(module, path, std::size(path));
+  if (n == 0 || n >= std::size(path)) {
+    return false;
+  }
+  std::wstring dir(path, n);
+  dir.resize(dir.find_last_of(L'\\'));
+  return ::GetFileAttributesW((dir + L"\\Installer\\setup.exe").c_str()) !=
+         INVALID_FILE_ATTRIBUTES;
+}
+
+std::string ReadWholeFile(const std::wstring& path) {
+  HANDLE file = ::CreateFileW(path.c_str(), GENERIC_READ,
+                              FILE_SHARE_READ | FILE_SHARE_WRITE |
+                                  FILE_SHARE_DELETE,
+                              nullptr, OPEN_EXISTING, 0, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return {};
+  }
+  std::string data;
+  char buffer[64 * 1024];
+  DWORD n = 0;
+  while (::ReadFile(file, buffer, sizeof(buffer), &n, nullptr) && n > 0 &&
+         data.size() < (64u << 20)) {
+    data.append(buffer, n);
+  }
+  ::CloseHandle(file);
+  return data;
+}
+
+void WriteWholeFile(const std::wstring& path, std::string_view text) {
+  HANDLE file = ::CreateFileW(path.c_str(), GENERIC_WRITE, 0, nullptr,
+                              CREATE_ALWAYS, 0, nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return;
+  }
+  DWORD n = 0;
+  ::WriteFile(file, text.data(), static_cast<DWORD>(text.size()), &n, nullptr);
+  ::CloseHandle(file);
+}
+
+// The profile's exit_type: "Crashed" from start until a clean exit writes
+// "Normal" (Chrome's own "restore pages?" signal).
+bool EndedWithoutCleanExit(const std::wstring& user_data_dir) {
+  return ReadWholeFile(user_data_dir + L"\\Default\\Preferences")
+             .find("\"exit_type\":\"Crashed\"") != std::string::npos;
+}
+
+// A browser runs on this profile: it holds its lockfile (opened for writing,
+// shared for reading only, and deleted when its handle closes).
+bool ProfileInUse(const std::wstring& user_data_dir) {
+  HANDLE lock = ::CreateFileW((user_data_dir + L"\\lockfile").c_str(),
+                              GENERIC_WRITE,
+                              FILE_SHARE_READ | FILE_SHARE_WRITE |
+                                  FILE_SHARE_DELETE,
+                              nullptr, OPEN_EXISTING, 0, nullptr);
+  if (lock != INVALID_HANDLE_VALUE) {
+    ::CloseHandle(lock);
+    return false;
+  }
+  return ::GetLastError() == ERROR_SHARING_VIOLATION;
+}
+
+int64_t Now() {
+  FILETIME now;
+  ::GetSystemTimeAsFileTime(&now);
+  return static_cast<int64_t>(
+      (static_cast<uint64_t>(now.dwHighDateTime) << 32) | now.dwLowDateTime);
+}
+
+// Too soon after the last relaunch: a crash at startup must not loop.
+bool RelaunchedRecently(const std::wstring& user_data_dir) {
+  const std::wstring mark = user_data_dir + kMark;
+  WIN32_FILE_ATTRIBUTE_DATA data;
+  if (::GetFileAttributesExW(mark.c_str(), GetFileExInfoStandard, &data)) {
+    const int64_t written = static_cast<int64_t>(
+        (static_cast<uint64_t>(data.ftLastWriteTime.dwHighDateTime) << 32) |
+        data.ftLastWriteTime.dwLowDateTime);
+    if (Now() - written < kLoop) {
+      return true;
+    }
+  }
+  WriteWholeFile(mark, "relaunched");
+  return false;
+}
+
+// Out of any job the browser is in (so it outlives a job that ends with the
+// browser), when the job allows it; no handles go along.
+bool Spawn(const base::CommandLine& line) {
+  std::wstring text = line.GetCommandLineString();
+  for (DWORD flags : {DWORD{CREATE_BREAKAWAY_FROM_JOB}, DWORD{0}}) {
+    STARTUPINFOW startup = {};
+    startup.cb = sizeof(startup);
+    PROCESS_INFORMATION process = {};
+    std::wstring mutable_text = text;
+    if (::CreateProcessW(line.GetProgram().value().c_str(),
+                         mutable_text.data(), nullptr, nullptr,
+                         /*bInheritHandles=*/FALSE, flags, nullptr, nullptr,
+                         &startup, &process)) {
+      ::CloseHandle(process.hThread);
+      ::CloseHandle(process.hProcess);
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+void MaybeStartCrashWatcher(int argc, const char** argv) {
+  if (argc < 1 || Has(argc, argv, "--type=")) {
+    return;
+  }
+  const bool forced = Has(argc, argv, "--meridian-crash-relaunch");
+  if (!forced && (Has(argc, argv, "--remote-debugging-") ||
+                  Has(argc, argv, "--meridian-no-crash-relaunch") ||
+                  Has(argc, argv, "--headless") ||
+                  Has(argc, argv, "--meridian-test-") ||
+                  !IsInstalledCopy())) {
+    return;
+  }
+  const std::wstring exe = ExePath();
+  if (exe.empty()) {
+    return;
+  }
+  base::CommandLine line{base::FilePath(exe)};
+  line.AppendSwitchNative("meridian-crash-watcher",
+                          std::to_wstring(::GetCurrentProcessId()));
+  std::string dir = ValueOf(argc, argv, kUserDataDir);
+  if (!dir.empty()) {
+    line.AppendSwitchPath("user-data-dir",
+                          base::FilePath(base::UTF8ToWide(dir)));
+  }
+  // Tests: the watcher only leaves its mark (no window on the screen).
+  if (Has(argc, argv, kDry)) {
+    line.AppendSwitchASCII("meridian-crash-relaunch", "dry");
+  }
+  Spawn(line);
+}
+
+bool IsCrashWatcher(int argc, const char** argv) {
+  return Has(argc, argv, kWatcher);
+}
+
+int RunCrashWatcher(int argc, const char** argv) {
+  const DWORD browser =
+      static_cast<DWORD>(atoi(ValueOf(argc, argv, kWatcher).c_str()));
+  if (browser == 0) {
+    return 2;
+  }
+  const std::string explicit_dir = ValueOf(argc, argv, kUserDataDir);
+  const std::wstring dir = explicit_dir.empty()
+                               ? DefaultUserDataDir()
+                               : base::UTF8ToWide(explicit_dir);
+  if (dir.empty()) {
+    return 0;
+  }
+
+  // Until the browser ends.
+  HANDLE process = ::OpenProcess(SYNCHRONIZE, FALSE, browser);
+  if (!process) {
+    return 0;  // Already gone (or not ours to watch).
+  }
+  ::WaitForSingleObject(process, INFINITE);
+  ::CloseHandle(process);
+
+  // Its helpers and the crash reporter finish first.
+  ::Sleep(2000);
+  if (!EndedWithoutCleanExit(dir) || ProfileInUse(dir) ||
+      RelaunchedRecently(dir)) {
+    return 0;
+  }
+  if (Has(argc, argv, kDry)) {
+    WriteWholeFile(dir + kMark, "would relaunch");
+    return 0;
+  }
+  const std::wstring exe = ExePath();
+  if (exe.empty()) {
+    return 1;
+  }
+  base::CommandLine line{base::FilePath(exe)};
+  if (!explicit_dir.empty()) {
+    line.AppendSwitchPath("user-data-dir", base::FilePath(dir));
+  }
+  return Spawn(line) ? 0 : 1;
+}
+
+}  // namespace meridian
