+        ExtensionRegistry::Get(tab_profile)
+            ->enabled_extensions()
+            .Contains(extension.id())) {
+      profile = tab_profile;
+    }
+  }
+  return CreateExtensionViewHost(extension, url, profile,
                                  mojom::ViewType::kExtensionPopup,
                                  std::move(delegate));
