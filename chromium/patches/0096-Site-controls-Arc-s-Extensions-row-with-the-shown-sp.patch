+namespace {
+
+const extensions::Extension* SpaceExtension(Profile* profile,
+                                            const std::string& id) {
+  return extensions::ExtensionRegistry::Get(profile)
+      ->enabled_extensions()
+      .GetByID(id);
+}
+
+}  // namespace
+
+std::vector<mojom::SpaceExtensionPtr> GetSpaceExtensions(
+    content::WebContents* contents) {
+  std::vector<mojom::SpaceExtensionPtr> out;
+  if (!contents) {
+    return out;
+  }
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  ToolbarActionsModel* model = ToolbarActionsModel::Get(profile);
+  if (!model) {
+    return out;
+  }
+  const int tab_id = sessions::SessionTabHelper::IdForTab(contents).id();
+  for (const std::string& id : model->action_ids()) {
+    const extensions::Extension* extension = SpaceExtension(profile, id);
+    extensions::ExtensionAction* action =
+        extension ? extensions::ExtensionActionManager::Get(profile)
+                        ->GetExtensionAction(*extension)
+                  : nullptr;
+    if (!action) {
+      continue;
+    }
+    gfx::Image image = action->GetExplicitlySetIcon(tab_id);
+    if (image.IsEmpty()) {
+      image = action->GetDeclarativeIcon(tab_id);
+    }
+    if (image.IsEmpty() && action->default_icon_image()) {
+      image = action->GetDefaultIconImage();
+    }
+    if (image.IsEmpty()) {
+      image = action->GetPlaceholderIconImage();
+    }
+    std::string icon;
+    if (!image.IsEmpty()) {
+      const gfx::ImageSkiaRep& rep =
+          image.AsImageSkia().GetRepresentation(2.0f);
+      if (!rep.is_null()) {
+        icon = webui::GetBitmapDataUrl(rep.GetBitmap());
+      }
+    }
+    std::string title = action->GetTitle(tab_id);
+    out.push_back(mojom::SpaceExtension::New(
+        id, title.empty() ? extension->name() : title, icon,
+        action->GetDisplayBadgeText(tab_id)));
+  }
+  std::ranges::sort(out, [](const mojom::SpaceExtensionPtr& a,
+                            const mojom::SpaceExtensionPtr& b) {
+    return base::ToLowerASCII(a->title) < base::ToLowerASCII(b->title);
+  });
+  return out;
+}
+
+bool RunSpaceExtension(BrowserWindowInterface* browser,
+                       content::WebContents* contents,
+                       const std::string& id) {
+  if (!contents) {
+    return false;
+  }
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  const extensions::Extension* extension = SpaceExtension(profile, id);
+  extensions::ExtensionActionRunner* runner =
+      extensions::ExtensionActionRunner::GetForWebContents(contents);
+  if (!extension || !runner) {
+    return false;
+  }
+  if (runner->RunAction(extension, /*grant_tab_permissions=*/true) !=
+      extensions::ExtensionAction::ShowAction::kShowPopup) {
+    return false;
+  }
+  extensions::ExtensionAction* action =
+      extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(
+          *extension);
+  const int tab_id = sessions::SessionTabHelper::IdForTab(contents).id();
+  // The popup is the extension's profile's, under the sliders it was opened
+  // from.
+  std::unique_ptr<extensions::ExtensionViewHost> host =
+      extensions::ExtensionViewHostFactory::CreatePopupHost(
+          *extension, action->GetPopupUrl(tab_id), browser);
+  views::Widget* widget = views::Widget::GetWidgetForNativeWindow(
+      browser->GetWindow()->GetNativeWindow());
+  ui::TrackedElement* anchor =
+      widget ? ui::ElementTracker::GetElementTracker()->GetFirstMatchingElement(
+                   kLocationIconElementId,
+                   views::ElementTrackerViews::GetContextForWidget(widget))
+             : nullptr;
+  if (!host || !anchor) {
+    return false;
+  }
+  ExtensionPopup::ShowPopup(browser, std::move(host),
+                            views::BubbleAnchor(anchor),
+                            views::BubbleBorder::TOP_RIGHT,
+                            PopupShowAction::kShow, ShowPopupCallback());
+  return true;
+}
+
 }  // namespace meridian
