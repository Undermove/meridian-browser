-  return CreateExtensionViewHost(extension, url, browser->GetProfile(),
+  // Meridian: a window holds tabs of every profile (its spaces'); the popup
+  // is in the profile of the extension, the active tab's.
+  Profile* profile = browser->GetProfile();
+  if (content::WebContents* active =
+          browser->GetTabStripModel()->GetActiveWebContents()) {
+    Profile* tab_profile =
+        Profile::FromBrowserContext(active->GetBrowserContext());
