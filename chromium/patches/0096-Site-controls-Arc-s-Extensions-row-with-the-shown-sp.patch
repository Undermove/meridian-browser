+  private async loadExtensions_() {
+    const {extensions} = await this.handler_.getSpaceExtensions();
+    this.extensions_ = extensions;
+    // Icons not read from disk yet come blank: once more when they are.
+    setTimeout(async () => {
+      if (this.open) {
+        this.extensions_ =
+            (await this.handler_.getSpaceExtensions()).extensions;
+      }
+    }, 400);
+  }
+
+  // Runs it on the page, as its toolbar button does (its popup opens under
+  // the sliders).
+  protected async onExtensionClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    this.fire('site-control-action', 'close');
+    await this.handler_.runSpaceExtension(id);
+  }
+
+  protected onManageExtensionsClick_() {
