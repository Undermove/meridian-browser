From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Sun, 15 Nov 2026 20:21:25 +0400
Subject: [PATCH 129/297] Meridian: Ctrl+, really opens Meridian's Settings on
 Windows and Linux

0124 put the check in the IDC_OPTIONS case of the command switch, which
the command never reaches: it is an ActionItem (browser_actions.cc), run by
the command updater. The check now sits beside the sidebar's other
commands, before the updater.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 chrome/browser/ui/browser_command_controller.cc | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index 4716046ad3..064c40228a 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -692,6 +692,15 @@ bool BrowserCommandController::ExecuteCommandWithDispositionAndContext(
   if (meridian::SidebarHandler::HandleCommand(browser_, id)) {
     return true;
   }
+#if !BUILDFLAG(IS_MAC)
+  // Meridian: Settings is Meridian's own panel, as on macOS, where ⌘,
+  // reaches it from the app menu (app_controller_mac.mm). Chromium's
+  // settings pages are opened from there. Here for the same reason as
+  // above: the command is an ActionItem (browser_actions.cc).
+  if (id == IDC_OPTIONS && meridian::SidebarHandler::ShowSettings(browser_)) {
+    return true;
+  }
+#endif
 
   // No commands are enabled if there is not yet any selected tab.
   // TODO(pkasting): It seems like we should not need this, because either
@@ -1388,14 +1397,6 @@ void BrowserCommandController::HandleCommandWithDisposition(
                           chrome::kPerformanceSubPage);
       break;
     case IDC_OPTIONS:
-#if !BUILDFLAG(IS_MAC)
-      // Meridian: Settings is Meridian's own panel, as on macOS, where ⌘,
-      // reaches it from the app menu (app_controller_mac.mm). Chromium's
-      // settings pages are opened from there.
-      if (meridian::SidebarHandler::ShowSettings(browser_)) {
-        break;
-      }
-#endif
       ShowSettings(webui::GetBrowserForOpeningWebUi(browser_));
       break;
     case IDC_EDIT_SEARCH_ENGINES:
