diff --git a/chrome/browser/meridian/boosts/boost_tab_helper.cc b/chrome/browser/meridian/boosts/boost_tab_helper.cc
index ee8b14e2bb..e029dce4db 100644
--- a/chrome/browser/meridian/boosts/boost_tab_helper.cc
+++ b/chrome/browser/meridian/boosts/boost_tab_helper.cc
@@ -28,67 +28,260 @@ namespace meridian {
 
 namespace {
 
+// Boost colours, as Arc's: a palette from the two picked colours, written as
+// CSS for each colour the page uses (not a filter over the page). Neutral
+// backgrounds take a tint of the main colour, big coloured blocks turn to it,
+// buttons, badges and links to the second one; lightness stays, so light
+// pages stay light and dark ones dark. Text is then made readable (WCAG AA,
+// 4.5:1, 3:1 when large) on what's under it. Pictures and video are not
+// touched. Returns {on(tint, tint2, amount), off()}, kept in the page.
+constexpr char kPaint[] = R"JS(() => {
+  // sRGB <-> OKLab/OKLCH, and WCAG contrast.
+  const lin = (v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
+  const gam = (v) => (v <= 0.0031308 ? 12.92 * v : 1.055 * v ** (1 / 2.4) - 0.055);
+  const toLch = ([r, g, b]) => {
+    const [R, G, B] = [r, g, b].map((v) => lin(v / 255));
+    const l = Math.cbrt(0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B);
+    const m = Math.cbrt(0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B);
+    const s = Math.cbrt(0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B);
+    const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
+    const a = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
+    const bb = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
+    return { L, C: Math.hypot(a, bb), h: (Math.atan2(bb, a) * 180 / Math.PI + 360) % 360 };
+  };
+  const rawRgb = ({ L, C, h }) => {
+    const a = C * Math.cos(h * Math.PI / 180), b = C * Math.sin(h * Math.PI / 180);
+    const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;
+    const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;
+    const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
+    return [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+      -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+      -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s];
+  };
+  // Into sRGB: less chroma until it fits.
+  const toRgb = (c) => {
+    let x = { ...c, L: Math.min(1, Math.max(0, c.L)) };
+    for (let i = 0; i < 24; i++) {
+      const v = rawRgb(x);
+      if (v.every((n) => n >= -0.0005 && n <= 1.0005)) break;
+      x = { ...x, C: x.C * 0.85 };
+    }
+    return rawRgb(x).map((v) => Math.round(gam(Math.min(1, Math.max(0, v))) * 255));
+  };
+  const lum = ([r, g, b]) => 0.2126 * lin(r / 255) + 0.7152 * lin(g / 255) + 0.0722 * lin(b / 255);
+  const contrast = (x, y) => { const a = lum(x), b = lum(y); return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05); };
+  // Computed colours, whatever their syntax: through a canvas once each.
+  const ctx = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
+  const parsed = new Map();
+  const parse = (c) => {
+    if (!c || c === 'transparent') return null;
+    if (parsed.has(c)) return parsed.get(c);
+    let v = null;
+    const m = c.match(/^rgba?\(([\d.]+)[, ]+([\d.]+)[, ]+([\d.]+)(?:[,/ ]+([\d.]+%?))?\)$/);
+    if (m) {
+      const a = m[4] === undefined ? 1 : m[4].endsWith('%') ? parseFloat(m[4]) / 100 : +m[4];
+      v = { rgb: [+m[1], +m[2], +m[3]], a };
+    } else if (ctx) {
+      ctx.clearRect(0, 0, 1, 1); ctx.fillStyle = '#000'; ctx.fillStyle = c; ctx.fillRect(0, 0, 1, 1);
+      const d = ctx.getImageData(0, 0, 1, 1).data;
+      v = { rgb: [d[0], d[1], d[2]], a: d[3] / 255 };
+    }
+    if (v && v.a < 0.04) v = null;
+    parsed.set(c, v);
+    return v;
+  };
+  const css = (rgb, a = 1) => (a >= 1 ? `rgb(${rgb.join(' ')})` : `rgb(${rgb.join(' ')} / ${+a.toFixed(3)})`);
+  // The picked hues (the pad's, HSL degrees) as OKLCH hues.
+  const hueOf = (deg) => {
+    const k = (n) => { const x = (n + deg / 30) % 12; return 0.5 - 0.42 * Math.max(-1, Math.min(x - 3, 9 - x, 1)); };
+    return toLch([k(0), k(8), k(4)].map((v) => v * 255)).h;
+  };
+  const turn = (from, to, k) => from + ((((to - from) % 360) + 540) % 360 - 180) * k;
+  const MEDIA = 'img,video,picture,canvas,iframe,embed,object';
+  const ATTRS = ['data-mb-bg', 'data-mb-fg', 'data-mb-bd', 'data-mb-gi'];
+  let pick = null, observer = null, timer = 0, last = 0;
+  const clear = () => {
+    document.getElementById('meridian-boost-paint')?.remove();
+    for (const el of document.querySelectorAll('[data-mb-bg],[data-mb-fg],[data-mb-bd],[data-mb-gi]')) {
+      for (const a of ATTRS) el.removeAttribute(a);
+    }
+  };
+  const paint = () => {
+    if (!pick || !document.body) return;
+    last = performance.now();
+    const { h1, h2, t } = pick;
+    const old = document.getElementById('meridian-boost-paint');
+    old?.remove();   // The site's own colours are read without ours.
+    const pageBg = parse(getComputedStyle(document.body).backgroundColor) ||
+        parse(getComputedStyle(document.documentElement).backgroundColor) || { rgb: [255, 255, 255], a: 1 };
+    const dark = toLch(pageBg.rgb).L < 0.55;
+    const screen = innerWidth * innerHeight;
+    // A background: a neutral one takes the main colour, Arc's tint; a
+    // big coloured block (a hero, a header) turns to it; a small coloured
+    // one (a button, a badge) turns to the second colour. Lightness stays.
+    const bgMemo = new Map();
+    const mapBg = (c, big) => {
+      const key = c.rgb.join() + (big ? 'B' : 's');
+      if (bgMemo.has(key)) return bgMemo.get(key);
+      const x = toLch(c.rgb);
+      let y;
+      if (x.C < 0.035) {
+        const room = 1 - Math.abs(x.L - 0.6) / 0.6;
+        y = { L: dark ? x.L + 0.03 * t : Math.min(x.L, 1 - 0.05 * t),
+              C: x.C * (1 - t) + t * (0.04 + 0.06 * room), h: h1 };
+      } else {
+        y = { L: x.L, C: x.C * (1 - 0.3 * t) + 0.3 * t * Math.max(x.C, 0.13),
+              h: turn(x.h, big ? h1 : h2, Math.min(1, t * 1.6)) };
+      }
+      const out = toRgb(y);
+      bgMemo.set(key, out);
+      return out;
+    };
+    // Text and borders: grey text gets a whisper of the main colour, coloured
+    // text (links) the second one; then it's made readable on what's under it.
+    const mapFg = (c, link) => {
+      const x = toLch(c.rgb);
+      return x.C < 0.035 && !link ?
+          { L: x.L, C: x.C * (1 - t) + t * 0.025, h: h1 } :
+          { L: x.L, C: Math.max(x.C, 0.09 * t), h: turn(x.h, h2, Math.min(1, t * 1.6)) };
+    };
+    const readable = (y, under, need) => {
+      let rgb = toRgb(y);
+      if (contrast(rgb, under) >= need) return rgb;
+      const up = lum(under) < 0.18;
+      // Darker text turns a deep shade of the colour rather than grey.
+      const deep = !up && y.C < 0.05;
+      for (let i = 0; i < 50 && contrast(rgb, under) < need; i++) {
+        y = { L: y.L + (up ? 0.02 : -0.02),
+              C: deep ? Math.max(y.C, 0.08 * pick.t) : y.C * 0.97, h: deep ? pick.h1 : y.h };
+        rgb = toRgb(y);
+      }
+      return rgb;
+    };
+    const rules = new Map();
+    const rule = (attr, prop, value) => {
+      const key = attr + prop + value;
+      let r = rules.get(key);
+      if (!r) { r = { attr, n: rules.size, text: `${prop}:${value}!important` }; rules.set(key, r); }
+      return r.n;
+    };
+    const els = [document.body, ...document.body.querySelectorAll('*')].slice(0, 6000);
+    const under = new Map();   // element -> the opaque background (new) behind it
+    const pageNew = mapBg(pageBg, true);
+    for (const el of els) {
+      for (const a of ATTRS) el.removeAttribute(a);
+      if (el.closest(MEDIA) || el.id === 'meridian-zap') continue;
+      const inSvg = el instanceof SVGElement;
+      const cs = getComputedStyle(el);
+      const parent = el.parentElement;
+      let behind = (parent && under.get(parent)) || pageNew;
+      if (!inSvg) {
+        const bg = parse(cs.backgroundColor);
+        if (bg) {
+          const r = el.getBoundingClientRect();
+          const big = el === document.body || r.width * r.height > screen * 0.12 || r.width > innerWidth * 0.8;
+          const now = mapBg(bg, big);
+          el.setAttribute('data-mb-bg', rule('bg', 'background-color', css(now, bg.a)));
+          if (bg.a > 0.85) behind = now;
+        }
+        const gi = cs.backgroundImage;
+        if (gi && gi.includes('gradient') && !gi.includes('url(')) {
+          const r = el.getBoundingClientRect();
+          const big = r.width * r.height > screen * 0.12;
+          const stops = [];
+          const text = gi.replace(/rgba?\([^)]*\)/g, (m) => {
+            const c = parse(m);
+            if (!c) return m;
+            const now = mapBg(c, big);
+            if (c.a > 0.85) stops.push(now);
+            return css(now, c.a);
+          });
+          if (text !== gi) el.setAttribute('data-mb-gi', rule('gi', 'background-image', text));
+          // Text on a gradient is read against its stops' middle.
+          if (stops.length) behind = [0, 1, 2].map((i) => Math.round(stops.reduce((n, c) => n + c[i], 0) / stops.length));
+        }
+      }
+      under.set(el, behind);
+      const fg = parse(cs.color);
+      const pfg = parent && getComputedStyle(parent).color;
+      const hasText = [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim());
+      if (fg && (hasText || cs.color !== pfg || el === document.body) && !inSvg) {
+        const link = !!el.closest('a[href]') && toLch(fg.rgb).C >= 0.035;
+        const size = parseFloat(cs.fontSize), weight = parseInt(cs.fontWeight, 10);
+        const need = size >= 24 || (size >= 18.66 && weight >= 700) ? 3 : 4.5;
+        el.setAttribute('data-mb-fg', rule('fg', 'color', css(readable(mapFg(fg, link), behind, need), fg.a)));
+      }
+      for (const side of ['Top', 'Right', 'Bottom', 'Left']) {
+        if (parseFloat(cs[`border${side}Width`]) > 0) {
+          const bd = parse(cs[`border${side}Color`]);
+          if (bd) el.setAttribute('data-mb-bd', rule('bd', 'border-color', css(toRgb(mapFg(bd, false)), bd.a)));
+          break;
+        }
+      }
+    }
+    const accent = css(toRgb({ L: dark ? 0.72 : 0.55, C: 0.15, h: h2 }));
+    let text = `html { accent-color: ${accent} !important; }\n` +
+        `::selection { background-color: ${css(toRgb({ L: dark ? 0.45 : 0.85, C: 0.1, h: h2 }))} !important; }\n` +
+        `html { background-color: ${css(pageNew)} !important; }\n`;
+    for (const r of rules.values()) text += `[data-mb-${r.attr}="${r.n}"]{${r.text}}\n`;
+    const style = old || document.createElement('style');
+    style.id = 'meridian-boost-paint';
+    style.textContent = text;
+    document.documentElement.appendChild(style);
+  };
+  // Pages that change (apps, feeds): painted again, at most once a second.
+  const later = () => {
+    if (timer) return;
+    timer = setTimeout(() => { timer = 0; paint(); }, Math.max(150, 1000 - (performance.now() - last)));
+  };
+  const watch = () => {
+    if (observer || !document.body) return;
+    observer = new MutationObserver((list) => {
+      if (list.some((m) => m.type !== 'attributes' || !String(m.attributeName).startsWith('data-mb-'))) later();
+    });
+    observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'style'] });
+  };
+  return {
+    on(tint, tint2, t) {
+      const next = { h1: hueOf(tint), h2: hueOf(tint2), t: Math.max(0, Math.min(1, t)) };
+      const same = pick && pick.h1 === next.h1 && pick.h2 === next.h2 && pick.t === next.t &&
+          document.getElementById('meridian-boost-paint');
+      pick = next;
+      if (!document.body) {
+        document.addEventListener('DOMContentLoaded', () => { paint(); watch(); }, { once: true });
+        return;
+      }
