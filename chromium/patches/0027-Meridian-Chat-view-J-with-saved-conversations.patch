@@ -0,0 +1,371 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The Chat view (⌥⌘J): a calm, full-size chat with the AI picked in
+// Settings > AI, over the page, for people who want to talk to an AI rather
+// than browse with it. Conversations are kept by the browser
+// (ai/chats.h); each chat has its own AI session ("chat-" + id), and a chat
+// reopened after a restart continues with its earlier turns.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues, TemplateResult} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {Chat, ChatMessage, ChatSummary, SidebarHandlerInterface} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './chat.css.js';
+import {getHtml} from './chat.html.js';
+import {renderMarkdown} from './markdown.js';
+
+export interface ChatRow {
+  id: string;
+  title: string;
+  on: boolean;
+}
+
+export interface ShownMessage {
+  role: string;
+  text: string;
+  body: TemplateResult[];
+  error: string;
+  pending: boolean;
+}
+
+export interface Suggestion {
+  label: string;
+  question: string;
+  page: boolean;
+}
+
+const SUGGESTIONS: Suggestion[] = [
+  {label: 'Summarize this page', question: 'Summarize this page.', page: true},
+  {
+    label: 'Draft an email',
+    question: 'Help me draft a short, friendly email. Ask me who it’s for ' +
+        'and what it should say.',
+    page: false,
+  },
+  {
+    label: 'Explain like I’m new to this',
+    question: 'Explain this page simply, like I’m new to the topic.',
+    page: true,
+  },
+  {
+    label: 'Brainstorm ideas',
+    question: 'Help me brainstorm ideas. First ask me what I’m working on.',
+    page: false,
+  },
+];
+
+function newId(): string {
+  return crypto.randomUUID().replace(/-/g, '').slice(0, 16);
+}
+
+export class MeridianChatElement extends CrLitElement {
+  static get is() {
+    return 'meridian-chat';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      shown: {type: Boolean, reflect: true},
+      chats_: {state: true, type: Array},
+      current_: {state: true, type: Object},
+      rows_: {state: true, type: Array},
+      shownMessages_: {state: true, type: Array},
+      empty_: {state: true, type: Boolean},
+      busy_: {state: true, type: Boolean},
+      ready_: {state: true, type: Boolean},
+      who_: {state: true, type: String},
+      withPage_: {state: true, type: Boolean},
+      error_: {state: true, type: String},
+    };
+  }
+
+  accessor shown: boolean = false;
+  protected accessor chats_: ChatSummary[] = [];
+  protected accessor current_: Chat|null = null;
+  // Derived in willUpdate().
+  protected accessor rows_: ChatRow[] = [];
+  protected accessor shownMessages_: ShownMessage[] = [];
+  protected accessor empty_: boolean = true;
+  protected accessor busy_: boolean = false;
+  protected accessor ready_: boolean = true;
+  protected accessor who_: string = '';
+  protected accessor withPage_: boolean = false;
+  protected accessor error_: string = '';
+  protected readonly suggestions_: Suggestion[] = SUGGESTIONS;
+
+  private readonly handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  private listenerId_: number|null = null;
+  // The chat a running answer belongs to.
+  private running_: string = '';
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.listenerId_ =
+        browserProxyFactory.getInstance().callbackRouter.onAiEvent.addListener(
+            (session: string, type: string, text: string) =>
+                this.onEvent_(session, type, text));
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    if (this.listenerId_ !== null) {
+      browserProxyFactory.getInstance().callbackRouter.removeListener(
+          this.listenerId_);
+      this.listenerId_ = null;
+    }
+  }
+
+  async show() {
+    this.shown = true;
+    const [{chats}, {ready, label}] = await Promise.all(
+        [this.handler_.listChats(), this.handler_.getAiStatus()]);
+    this.chats_ = chats;
+    this.ready_ = ready;
+    this.who_ = label;
+    if (!this.current_) {
+      this.newChat_();
+    }
+    await this.updateComplete;
+    this.focusInput_();
+  }
+
+  hide() {
+    this.shown = false;
+    this.fire('meridian-chat-closed');
+  }
+
+  toggle() {
+    if (this.shown) {
+      this.hide();
+    } else {
+      this.show();
+    }
+  }
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    const id = this.current_?.id || '';
+    this.rows_ = this.chats_.map(c => ({id: c.id, title: c.title, on: c.id === id}));
+    const messages = this.current_?.messages || [];
+    this.empty_ = messages.length === 0;
+    this.shownMessages_ = messages.map((m, i) => ({
+                                         role: m.role,
+                                         text: m.text,
+                                         body: m.role === 'assistant' ?
+                                             renderMarkdown(m.text) :
+                                             [],
+                                         error: '',
+                                         pending: this.busy_ &&
+                                             i === messages.length - 1 &&
+                                             !m.text,
+                                       }));
+    if (this.error_ && this.shownMessages_.length) {
+      this.shownMessages_[this.shownMessages_.length - 1]!.error = this.error_;
+    }
+  }
+
+  override updated(changed: PropertyValues<this>) {
+    super.updated(changed);
+    if (changed.has('current_' as keyof MeridianChatElement)) {
+      const log = this.shadowRoot.querySelector('#thread');
+      log?.scrollTo({top: log.scrollHeight});
+    }
+  }
+
+  private focusInput_() {
+    this.shadowRoot.querySelector<HTMLTextAreaElement>('#input')?.focus();
+  }
+
+  private newChat_() {
+    const now = Date.now();
+    this.current_ =
+        {id: newId(), title: 'New chat', created: now, updated: now, messages: []};
+    this.error_ = '';
+  }
+
+  private save_() {
+    const chat = this.current_;
+    if (!chat || !chat.messages.length) {
+      return;
+    }
+    this.handler_.saveChat(chat);
+    const summary = {id: chat.id, title: chat.title, updated: chat.updated};
+    this.chats_ = [summary, ...this.chats_.filter(c => c.id !== chat.id)];
+  }
+
+  private onEvent_(session: string, type: string, text: string) {
+    const chat = this.current_;
+    if (!session.startsWith('chat-') || session.slice(5) !== this.running_) {
+      return;
+    }
+    if (!chat || chat.id !== this.running_) {
+      // Another chat is on screen; the answer still finishes in the store
+      // through the next save of that chat. Keep it simple: stop listening.
+      if (type === 'done' || type === 'error') {
+        this.busy_ = false;
+        this.running_ = '';
+      }
+      return;
+    }
+    const messages = [...chat.messages];
+    const last = messages[messages.length - 1];
+    if (!last || last.role !== 'assistant') {
+      return;
+    }
+    const updated: ChatMessage = {...last};
+    if (type === 'text') {
+      updated.text += text;
+    } else if (type === 'error') {
+      this.error_ = text;
+    } else if (type === 'done') {
+      updated.stopped = text === 'stopped';
+    }
+    messages[messages.length - 1] = updated;
+    this.current_ = {...chat, messages, updated: Date.now()};
+    if (type === 'done' || type === 'error') {
+      this.busy_ = false;
+      this.running_ = '';
+      // An answer that never came is dropped, like in the Ask panel.
+      if (!updated.text) {
+        this.current_ = {...this.current_, messages: messages.slice(0, -1)};
+      }
+      this.save_();
+    }
+  }
+
+  private send_(text: string, withPage: boolean) {
+    const chat = this.current_;
+    if (!text || this.busy_ || !chat) {
+      return;
+    }
+    const now = Date.now();
+    const first = chat.messages.length === 0;
+    const title = first ? text.replace(/\s+/g, ' ').slice(0, 60) : chat.title;
+    this.current_ = {
+      ...chat,
+      title,
+      updated: now,
+      messages: [
+        ...chat.messages,
+        {role: 'user', text, ts: now, provider: '', stopped: false},
+        {role: 'assistant', text: '', ts: now, provider: '', stopped: false},
+      ],
+    };
+    this.error_ = '';
+    this.busy_ = true;
+    this.running_ = chat.id;
+    this.save_();
+    this.handler_.aiChat(`chat-${chat.id}`, text, 'chat', withPage);
+  }
+
+  protected onInputKeydown_(e: KeyboardEvent) {
+    const input = e.target as HTMLTextAreaElement;
+    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
+      e.preventDefault();
+      const text = input.value.trim();
+      if (text && !this.busy_) {
+        input.value = '';
+        this.send_(text, this.withPage_);
+      }
+    } else if (e.key === 'Escape') {
+      this.hide();
+    }
+  }
+
+  protected onSendClick_() {
+    const input = this.shadowRoot.querySelector<HTMLTextAreaElement>('#input');
+    const text = input?.value.trim() || '';
+    if (text && !this.busy_) {
+      input!.value = '';
+      this.send_(text, this.withPage_);
+    }
+  }
+
+  protected onStopClick_() {
+    if (this.running_) {
+      this.handler_.aiStop(`chat-${this.running_}`);
+    }
+  }
+
+  protected onSuggestionClick_(e: Event) {
+    const index = Number((e.currentTarget as HTMLElement).dataset['index']);
+    const s = this.suggestions_[index];
+    if (s) {
+      this.send_(s.question, s.page);
+    }
+  }
+
+  protected onNewClick_() {
+    if (this.busy_) {
+      this.onStopClick_();
+    }
+    this.newChat_();
+    this.focusInput_();
+  }
+
+  protected async onChatClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id'] || '';
+    if (id === this.current_?.id) {
+      return;
+    }
+    if (this.busy_) {
+      this.onStopClick_();
+    }
+    const {chat} = await this.handler_.getChat(id);
+    if (chat) {
+      this.current_ = chat;
+      this.error_ = '';
+    }
+  }
+
+  protected onDeleteClick_(e: Event) {
+    e.stopPropagation();
+    const id = (e.currentTarget as HTMLElement).dataset['id'] || '';
+    this.handler_.deleteChat(id);
+    this.chats_ = this.chats_.filter(c => c.id !== id);
+    if (this.current_?.id === id) {
+      this.newChat_();
+    }
+  }
+
+  protected onWithPageChange_(e: Event) {
+    this.withPage_ = (e.target as HTMLInputElement).checked;
+  }
+
+  protected onSettingsClick_() {
+    this.fire('meridian-show-settings', 'ai');
+  }
+
+  protected onCloseClick_() {
+    this.hide();
+  }
+
+  protected onThreadClick_(e: Event) {
+    const link = (e.target as HTMLElement).closest<HTMLElement>('a[data-href]');
+    if (link) {
+      e.preventDefault();
+      this.fire('meridian-open-url', link.dataset['href']);
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-chat': MeridianChatElement;
+  }
+}
+
+customElements.define(MeridianChatElement.is, MeridianChatElement);
