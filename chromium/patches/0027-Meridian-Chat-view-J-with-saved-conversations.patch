+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianChatElement} from './chat.js';
+import {icon} from './icons.js';
+
+export function getHtml(this: MeridianChatElement) {
+  return html`<!--_html_template_start_-->
+<div id="view">
+  <nav id="list">
+    <div class="list-head">
+      <span class="list-title">Chats</span>
+      <button id="new" class="icon-btn" title="New chat"
+          @click="${this.onNewClick_}">${icon('plus', 15)}</button>
+    </div>
+    <div class="rows">
+      ${this.rows_.map(r => html`
+        <div class="chat-row ${r.on ? 'on' : ''}" data-id="${r.id}"
+            @click="${this.onChatClick_}">
+          <span class="chat-title">${r.title}</span>
+          <button class="delete icon-btn" data-id="${r.id}" title="Delete chat"
+              @click="${this.onDeleteClick_}">${icon('trash', 13)}</button>
+        </div>`)}
+    </div>
+  </nav>
+  <section id="main">
+    <div class="head">
+      ${this.who_ ? html`<span id="who" class="who">${this.who_}</span>` : ''}
+      <div class="grow"></div>
+      <button id="close" class="icon-btn" title="Close (⌥⌘J)"
+          @click="${this.onCloseClick_}">${icon('x', 15)}</button>
+    </div>
+    <div id="thread" @click="${this.onThreadClick_}">
+      ${!this.ready_ ? html`
+        <div class="welcome">
+          <h1>Chat with an AI</h1>
+          <p>Set up who answers first: an API key, or a free local model like
+            Ollama.</p>
+          <button id="setup" class="btn primary"
+              @click="${this.onSettingsClick_}">Set up AI</button>
+        </div>` : ''}
+      ${this.ready_ && this.empty_ ? html`
+        <div class="welcome">
+          <h1>What can I help with?</h1>
+          <div class="suggestions">
+            ${this.suggestions_.map((s, index) => html`
+              <button class="suggestion" data-index="${index}"
+                  @click="${this.onSuggestionClick_}">${s.label}</button>`)}
+          </div>
+        </div>` : ''}
+      <div class="messages">
+        ${this.shownMessages_.map(m => html`
+          <div class="msg ${m.role}">
+            ${m.role === 'user' ? html`<div class="bubble">${m.text}</div>` : html`
+              <div class="answer">${m.body}</div>
+              ${m.pending ? html`<div class="thinking">Thinking…</div>` : ''}
+              ${m.error ? html`<div class="error">${m.error}</div>` : ''}`}
+          </div>`)}
+      </div>
+    </div>
+    <div class="compose">
+      <textarea id="input" rows="2" placeholder="Message…"
+          ?disabled="${!this.ready_}"
+          @keydown="${this.onInputKeydown_}"></textarea>
+      <div class="compose-row">
+        <label class="check"><input type="checkbox" id="withPage"
+            .checked="${this.withPage_}" @change="${this.onWithPageChange_}">
+          Use the current page</label>
+        <div class="grow"></div>
+        ${this.busy_ ? html`
+          <button id="stop" class="btn" @click="${this.onStopClick_}">Stop
+          </button>` : html`
+          <button id="send" class="btn primary" ?disabled="${!this.ready_}"
+              @click="${this.onSendClick_}">Send</button>`}
+      </div>
+    </div>
+  </section>
+</div>
+<!--_html_template_end_-->`;
+}
