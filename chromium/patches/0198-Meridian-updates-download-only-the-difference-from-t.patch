+}  // namespace
+
+std::string ApplyDelta(const base::FilePath& delta,
+                       const base::FilePath& from,
+                       const base::FilePath& staged) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(delta.Append("manifest.json"), &text,
+                                         16 << 20)) {
+    return "no manifest";
+  }
+  std::optional<base::Value> manifest =
+      base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+  const base::ListValue* entries =
+      manifest && manifest->is_dict() ? manifest->GetDict().FindList("entries")
+                                      : nullptr;
+  if (!entries || manifest->GetDict().FindInt("format").value_or(0) != 1) {
+    return "not a delta this version reads";
+  }
+  if (base::PathExists(staged) || mkdir(staged.value().c_str(), 0755) != 0) {
+    return "can't create the new app";
+  }
+  int n = 0;
+  for (const base::Value& value : *entries) {
+    ++n;
+    const base::DictValue* entry = value.GetIfDict();
+    const std::string* path = entry ? entry->FindString("path") : nullptr;
+    const std::string* type = entry ? entry->FindString("type") : nullptr;
+    if (!path || !type || !SafeRelative(*path)) {
+      return "a bad entry " + base::NumberToString(n);
+    }
+    const base::FilePath target = staged.Append(*path);
+    const int mode = entry->FindInt("mode").value_or(0644) & 0777;
+    if (*type == "dir") {
+      if (mkdir(target.value().c_str(), 0755) != 0 && errno != EEXIST) {
+        return "can't create " + *path;
+      }
+      chmod(target.value().c_str(), mode | 0700);
+      continue;
+    }
+    if (*type == "link") {
+      const std::string* link = entry->FindString("target");
+      if (!link || !SafeLink(*path, *link) ||
+          symlink(link->c_str(), target.value().c_str()) != 0) {
+        return "can't link " + *path;
+      }
+      continue;
+    }
+    if (*type != "file") {
+      return "a bad entry " + *path;
+    }
+    const std::string* sha = entry->FindString("sha256");
+    const std::string* source = entry->FindString("source");
+    if (!sha || !source) {
+      return "a bad entry " + *path;
+    }
+    std::optional<std::string> made;
+    if (*source == "same" || *source == "patch") {
+      // The old file it was made from.
+      const std::string* from_path = entry->FindString("from");
+      const std::string* from_sha = entry->FindString("from_sha256");
+      if (!from_path || !from_sha || !SafeRelative(*from_path)) {
+        return "a bad entry " + *path;
+      }
+      const base::FilePath old = from.Append(*from_path);
+      if (base::IsLink(old)) {
+        return "the installed app has a link at " + *from_path;
+      }
+      std::optional<std::string> old_sha = Sha256Of(old);
+      if (old_sha != *from_sha) {
+        return "the installed app differs at " + *from_path + " (" +
+               old_sha.value_or("unreadable") + ")";
+      }
+      if (*source == "same") {
+        // A copy that shares the data on APFS (or a plain copy).
+        if (clonefile(old.value().c_str(), target.value().c_str(),
+                      CLONE_NOFOLLOW) != 0 &&
+            !base::CopyFile(old, target)) {
+          return "can't copy " + *path;
+        }
+        made = *from_sha;
+      } else {
+        const std::string* blob = entry->FindString("blob");
+        if (!blob || !SafeRelative(*blob)) {
+          return "a bad entry " + *path;
+        }
+        made = Decode(delta.Append(*blob), old, target);
+      }
+    } else if (*source == "data") {
+      const std::string* blob = entry->FindString("blob");
+      if (!blob || !SafeRelative(*blob)) {
+        return "a bad entry " + *path;
+      }
+      made = Decode(delta.Append(*blob), base::FilePath(), target);
+    } else {
+      return "a bad entry " + *path;
+    }
+    if (made != *sha) {
+      return "the result differs at " + *path;
+    }
+    if (chmod(target.value().c_str(), mode) != 0) {
+      return "can't set the mode of " + *path;
+    }
+  }
+  return std::string();
+}
+
+}  // namespace meridian::update
