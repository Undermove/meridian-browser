+
+#ifndef CHROME_BROWSER_MERIDIAN_UPDATE_DELTA_H_
+#define CHROME_BROWSER_MERIDIAN_UPDATE_DELTA_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+
+namespace meridian::update {
+
+// An update as the difference from one version (tools/make_delta.py): a
+// folder with manifest.json, which lists every file, folder and link of the
+// new app, and files/<n>.zst: a file new in this version (zstd), or the
+// changes to a file of the old one (zstd with the old file as its prefix,
+// as `zstd --patch-from`).
+//
+// Builds the new app at `staged` (which mustn't exist) from the running app
+// `from` and that folder. Every file the manifest takes from the old app must
+// be the one it was made from, and every file it ends up with is checked
+// against the manifest's checksum. Returns an error (for the log; the updater
+// then downloads the whole app) or an empty string.
+std::string ApplyDelta(const base::FilePath& delta,
+                       const base::FilePath& from,
+                       const base::FilePath& staged);
+
+}  // namespace meridian::update
+
+#endif  // CHROME_BROWSER_MERIDIAN_UPDATE_DELTA_H_
