+#include "crypto/hash.h"
+#include "third_party/zstd/src/lib/zstd.h"
+
+namespace meridian::update {
+namespace {
+
+// The largest file a patch may refer back into (a 1 GB window).
+constexpr int kWindowLog = 30;
+
+// A path inside the app: relative, no "..", nothing odd.
+bool SafeRelative(std::string_view path) {
+  if (path.empty() || path.front() == '/' || path.find('\0') != path.npos) {
+    return false;
+  }
+  for (std::string_view part : base::SplitStringPiece(
+           path, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (part.empty() || part == "." || part == "..") {
+      return false;
+    }
+  }
+  return true;
+}
+
+// A link's target stays inside the app.
+bool SafeLink(std::string_view path, std::string_view target) {
+  if (target.empty() || target.front() == '/') {
+    return false;
+  }
+  int depth = static_cast<int>(
+                  base::SplitStringPiece(path, "/", base::KEEP_WHITESPACE,
+                                         base::SPLIT_WANT_ALL)
+                      .size()) -
+              1;
+  for (std::string_view part : base::SplitStringPiece(
+           target, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (part == "..") {
+      if (--depth < 0) {
+        return false;
+      }
+    } else if (!part.empty() && part != ".") {
+      ++depth;
+    }
+  }
+  return true;
+}
+
+std::optional<std::string> Sha256Of(const base::FilePath& path) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return std::nullopt;
+  }
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+  std::vector<uint8_t> buffer(1 << 20);
+  while (true) {
+    std::optional<size_t> n = file.ReadAtCurrentPos(buffer);
+    if (!n) {
+      return std::nullopt;
+    }
+    if (*n == 0) {
+      break;
+    }
+    hasher.Update(base::span(buffer).first(*n));
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  return base::ToLowerASCII(base::HexEncode(digest));
+}
+
+struct DCtxDeleter {
+  void operator()(ZSTD_DCtx* ctx) const { ZSTD_freeDCtx(ctx); }
+};
+
+// Decompresses `blob` into `out`, with `prefix` (the old file) when there is
+// one, and returns the result's SHA-256 (or nullopt).
+std::optional<std::string> Decode(const base::FilePath& blob,
+                                  const base::FilePath& prefix,
+                                  const base::FilePath& out) {
+  std::unique_ptr<ZSTD_DCtx, DCtxDeleter> ctx(ZSTD_createDCtx());
+  if (!ctx || ZSTD_isError(ZSTD_DCtx_setParameter(
+                  ctx.get(), ZSTD_d_windowLogMax, kWindowLog))) {
+    return std::nullopt;
+  }
+  base::MemoryMappedFile old;
+  if (!prefix.empty()) {
+    if (!old.Initialize(prefix)) {
+      return std::nullopt;
+    }
+    if (ZSTD_isError(ZSTD_DCtx_refPrefix(ctx.get(), old.bytes().data(),
+                                         old.bytes().size()))) {
+      return std::nullopt;
+    }
+  }
+  base::File in(blob, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  base::File output(out, base::File::FLAG_CREATE | base::File::FLAG_WRITE);
+  if (!in.IsValid() || !output.IsValid()) {
+    return std::nullopt;
+  }
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+  std::vector<uint8_t> in_buffer(ZSTD_DStreamInSize());
+  std::vector<uint8_t> out_buffer(ZSTD_DStreamOutSize());
+  size_t last = 0;
+  bool any = false;
+  while (true) {
+    std::optional<size_t> n = in.ReadAtCurrentPos(in_buffer);
+    if (!n) {
+      return std::nullopt;
+    }
+    if (*n == 0) {
+      break;
+    }
+    any = true;
+    ZSTD_inBuffer input = {in_buffer.data(), *n, 0};
+    while (input.pos < input.size) {
+      ZSTD_outBuffer o = {out_buffer.data(), out_buffer.size(), 0};
+      last = ZSTD_decompressStream(ctx.get(), &o, &input);
+      if (ZSTD_isError(last)) {
+        return std::nullopt;
+      }
+      auto produced = base::span(out_buffer).first(o.pos);
+      if (!output.WriteAtCurrentPosAndCheck(produced)) {
+        return std::nullopt;
+      }
+      hasher.Update(produced);
+    }
+  }
+  // The whole frame, not a cut-off one.
+  if (!any || last != 0) {
+    return std::nullopt;
+  }
+  // The rest of a frame the last read didn't flush.
+  while (true) {
+    ZSTD_inBuffer input = {nullptr, 0, 0};
+    ZSTD_outBuffer o = {out_buffer.data(), out_buffer.size(), 0};
+    size_t left = ZSTD_decompressStream(ctx.get(), &o, &input);
+    if (ZSTD_isError(left)) {
+      return std::nullopt;
+    }
+    auto produced = base::span(out_buffer).first(o.pos);
+    if (!output.WriteAtCurrentPosAndCheck(produced)) {
+      return std::nullopt;
+    }
+    hasher.Update(produced);
+    if (o.pos == 0) {
+      break;
+    }
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  return base::ToLowerASCII(base::HexEncode(digest));
+}
