+bool WorkbenchHandler::UseTermHost() const {
+#if BUILDFLAG(IS_POSIX)
+  // Not under tests (they end browsers outright: their shells would be kept
+  // for hours), unless a test asks for it.
+  const base::CommandLine& cl = *base::CommandLine::ForCurrentProcess();
+  return cl.HasSwitch("meridian-term-host-test") ||
+         (!cl.HasSwitch("remote-debugging-port") &&
+          !cl.HasSwitch("remote-debugging-pipe"));
+#else
+  return false;
+#endif
+}
+
+void WorkbenchHandler::KeepInHost(const std::string& id) {
+#if BUILDFLAG(IS_POSIX)
+  auto it = terms_.find(id);
+  if (!project_ || !UseTermHost() || it == terms_.end() ||
+      !it->second.terminal) {
+    return;
+  }
+  Term& term = it->second;
+  int fd = term.terminal->DupMaster();
+  if (fd < 0) {
+    return;
+  }
+  term.host_key = base::NumberToString(getpid()) + "-" +
+                  base::HexEncodeLower(base::RandBytesAsVector(8));
+  std::string meta =
+      base::WriteJson(base::DictValue()
+                          .Set("kind", term.kind)
+                          .Set("title", term.title)
+                          .Set("mission", !term.mission_node.empty())
+                          .Set("mission_kind", term.mission_kind)
+                          .Set("in_shell", term.in_shell)
+                          .Set("token", term.mission_token))
+          .value_or("{}");
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(base::IgnoreResult(&KeepTerminal),
+                     profile_->GetPath().DirName().AsUTF8Unsafe(),
+                     term.host_key, term.terminal->pid(), fd,
+                     project_->root().AsUTF8Unsafe(), std::move(meta)));
+#endif
+}
+
+void WorkbenchHandler::DropFromHost(Term& term) {
+#if BUILDFLAG(IS_POSIX)
+  if (term.host_key.empty()) {
+    return;
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&DropTerminal,
+                     profile_->GetPath().DirName().AsUTF8Unsafe(),
+                     term.host_key));
+  term.host_key.clear();
+#endif
+}
+
+void WorkbenchHandler::OnAdopted(
+    Reply reply,
+    std::vector<OrphanTerminal> orphans) {
+#if BUILDFLAG(IS_POSIX)
+  mission::MissionControl* mission =
+      mission::MissionControlFactory::GetForProfile(profile_);
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(web_ui()->GetWebContents());
+  for (OrphanTerminal& o : orphans) {
+    std::string id = "t" + base::NumberToString(++term_seq_);
+    std::unique_ptr<Terminal> terminal = Terminal::Adopt(
+        o.pid, o.master,
+        base::BindPostTaskToCurrentDefault(base::BindRepeating(
+            &WorkbenchHandler::OnTerminalData, weak_factory_.GetWeakPtr(), id)),
+        base::BindPostTaskToCurrentDefault(base::BindOnce(
+            &WorkbenchHandler::OnTerminalExit, weak_factory_.GetWeakPtr(), id)));
+    if (!terminal) {
+      continue;
+    }
+    std::optional<base::Value> meta = base::JSONReader::Read(o.meta, 0);
+    base::DictValue m =
+        meta && meta->is_dict() ? std::move(*meta).TakeDict() : base::DictValue();
+    auto str = [&](const char* key) {
+      const std::string* v = m.FindString(key);
+      return v ? *v : std::string();
+    };
+    Term term;
+    term.terminal = std::move(terminal);
+    term.kind = str("kind").empty() ? "shell" : str("kind");
+    term.title = str("title");
+    term.mission_kind = str("mission_kind");
+    term.in_shell = m.FindBool("in_shell").value_or(false);
+    term.scrollback =
+        "\r\n\x1b[2m[Meridian restarted; this session kept running]\x1b[0m"
+        "\r\n" +
+        o.output.substr(o.output.size() > kScrollbackBytes
+                            ? o.output.size() - kScrollbackBytes
+                            : 0);
+    // Its hooks still have their token and Mission Control's socket (the
+    // same path across runs): the session shows, and reports, again.
+    if (mission && m.FindBool("mission").value_or(false) &&
+        !term.mission_kind.empty()) {
+      mission::MissionControl::Registration registration =
+          mission->RegisterTerminal(term.mission_kind, project_->name(),
+                                    tab ? tab->GetHandle().raw_value() : 0,
+                                    /*sandbox=*/false, term.in_shell,
+                                    str("token"));
+      term.mission_node = registration.node_id;
+      term.mission_token = registration.token;
+      if (!registration.node_id.empty()) {
+        mission->AttachTerminal(registration.node_id, id);
+      }
+    }
+    const int pid = term.terminal->pid();
+    terms_[id] = std::move(term);
+    KeepInHost(id);
+    // A full-screen program (Claude Code) draws itself again.
+    kill(-pid, SIGWINCH);
+  }
+#endif
+  base::ListValue list;
+  for (const auto& [id, term] : terms_) {
+    list.Append(TermInfo(id, term));
+  }
+  std::move(reply).Run(base::Value(std::move(list)));
+}
