+};
+
+bool Alive(int pid) {
+  return pid > 0 && (kill(pid, 0) == 0 || errno == EPERM);
+}
+
+// The browser that ended quit cleanly (the profile says "Normal", not
+// "Crashed"): its terminals close, as they did before the host.
+bool QuitCleanly(const std::string& user_data_dir) {
+  if (user_data_dir.empty()) {
+    return false;
+  }
+  int fd = open((user_data_dir + "/Default/Preferences").c_str(), O_RDONLY);
+  if (fd < 0) {
+    return false;
+  }
+  std::string prefs;
+  std::array<char, 65536> chunk;
+  ssize_t n;
+  while ((n = read(fd, chunk.data(), chunk.size())) > 0) {
+    prefs.append(chunk.data(), static_cast<size_t>(n));
+  }
+  close(fd);
+  return prefs.find("\"exit_type\":\"Crashed\"") == std::string::npos;
+}
+
+void HangUp(Kept& k) {
+  kill(-k.pid, SIGHUP);
+  kill(k.pid, SIGHUP);
+  close(k.fd);
+}
+
+void Serve(int client, std::map<std::string, Kept>& kept) {
+  int fd = -1;
+  std::string line = ReceiveAll(client, &fd, true);
+  line = line.substr(0, line.find('\n'));
+  std::vector<std::string> f = base::SplitString(
+      line, "\t", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  std::string reply = "ERR\n";
+  if (f.size() == 6 && f[0] == "KEEP" && fd >= 0) {
+    Kept k;
+    int pid = 0;
+    int browser = 0;
+    if (base::StringToInt(f[2], &pid) && base::StringToInt(f[3], &browser)) {
+      k.pid = pid;
+      k.browser = browser;
+      k.root = UnB64(f[4]);
+      k.meta = UnB64(f[5]);
+      k.fd = fd;
+      fd = -1;
+      if (auto it = kept.find(f[1]); it != kept.end()) {
+        close(it->second.fd);
+      }
+      kept[f[1]] = std::move(k);
+      reply = "OK\n";
+    }
+  } else if (f.size() == 2 && f[0] == "DROP") {
+    if (auto it = kept.find(f[1]); it != kept.end()) {
+      close(it->second.fd);
+      kept.erase(it);
+    }
+    reply = "OK\n";
+  } else if (f.size() == 2 && f[0] == "LIST") {
+    std::string root = UnB64(f[1]);
+    reply.clear();
+    for (const auto& [key, k] : kept) {
+      // Only what a browser that's gone left (the browser alive now still
+      // has the others).
+      if (k.root == root && !Alive(k.browser)) {
+        reply += key + "\t" + base::NumberToString(k.pid) + "\t" + B64(k.meta) +
+                 "\n";
+      }
+    }
+    reply += "END\n";
+  } else if (f.size() == 2 && f[0] == "TAKE") {
+    auto it = kept.find(f[1]);
+    if (it != kept.end() && !Alive(it->second.browser)) {
+      // The fd rides on the first byte; the output follows.
+      SendMsg(client, "T" + B64(it->second.output) + "\n", it->second.fd);
+      close(it->second.fd);
+      kept.erase(it);
+      reply.clear();
+    }
+  } else if (f.size() == 1 && f[0] == "PING") {
+    reply = "OK\n";
+  }
+  if (fd >= 0) {
+    close(fd);
+  }
+  if (!reply.empty()) {
+    SendMsg(client, reply, -1);
+  }
+}
+
+}  // namespace
+
+bool IsTermHost(int argc, const char** argv) {
+  for (const char* a : Args(argc, argv).subspan(1u)) {
+    if (a && std::string_view(a).starts_with(kSwitch)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+int RunTermHost(int argc, const char** argv) {
+  std::string path;
+  std::string user_data_dir;
+  for (const char* a : Args(argc, argv).subspan(1u)) {
+    if (a && std::string_view(a).starts_with(kSwitch)) {
+      path = std::string(std::string_view(a).substr(kSwitch.size()));
+    } else if (a && std::string_view(a).starts_with("--user-data-dir=")) {
+      user_data_dir = std::string(std::string_view(a).substr(16));
+    }
+  }
+  sockaddr_un addr;
+  if (path.empty() || !SafeDir(path) || !FillAddr(path, &addr)) {
+    return 2;
+  }
+  signal(SIGPIPE, SIG_IGN);
+  signal(SIGHUP, SIG_IGN);
+  int listener = socket(AF_UNIX, SOCK_STREAM, 0);
+  // Another host already serves this socket: it stays.
+  if (int probe = Connect(path); probe >= 0) {
+    close(probe);
+    return 0;
+  }
+  unlink(path.c_str());
+  if (listener < 0 ||
+      bind(listener, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0 ||
+      listen(listener, 16) != 0) {
+    return 1;
+  }
+  chmod(path.c_str(), 0600);
+  std::map<std::string, Kept> kept;
+  time_t empty_since = time(nullptr);
+  std::array<char, 65536> chunk;
+  while (true) {
+    time_t now = time(nullptr);
+    // Terminals whose browser is gone: after a crash the host reads them
+    // from now on; after a clean quit they close.
+    for (auto it = kept.begin(); it != kept.end();) {
+      Kept& k = it->second;
+      if (!k.orphan && !Alive(k.browser)) {
+        if (QuitCleanly(user_data_dir)) {
+          HangUp(k);
+          it = kept.erase(it);
+          continue;
+        }
+        k.orphan = true;
+        k.since = now;
+      }
+      ++it;
+    }
+    std::vector<pollfd> fds = {{listener, POLLIN, 0}};
+    std::vector<std::string> keys;
+    for (const auto& [key, k] : kept) {
+      if (k.orphan) {
+        fds.push_back({k.fd, POLLIN, 0});
+        keys.push_back(key);
+      }
+    }
+    int ready = poll(fds.data(), fds.size(), 1000);
+    if (ready > 0 && (fds[0].revents & POLLIN)) {
+      int client = accept(listener, nullptr, nullptr);
+      if (client >= 0) {
+        timeval tv = {5, 0};
+        setsockopt(client, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+        setsockopt(client, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+        Serve(client, kept);
+        close(client);
+      }
+    }
+    for (size_t i = 1; ready > 0 && i < fds.size(); ++i) {
+      if (!fds[i].revents) {
+        continue;
+      }
+      auto it = kept.find(keys[i - 1]);
+      if (it == kept.end()) {
+        continue;
+      }
+      ssize_t n = read(it->second.fd, chunk.data(), chunk.size());
+      if (n > 0) {
+        std::string& out = it->second.output;
+        out.append(chunk.data(), static_cast<size_t>(n));
+        if (out.size() > kMaxOutput) {
+          out.erase(0, out.size() - kMaxOutput);
+        }
+      } else if (n == 0 || (errno != EAGAIN && errno != EINTR)) {
+        // The program ended (the pty's other side closed).
+        close(it->second.fd);
+        kept.erase(it);
+      }
+    }
+    // Unclaimed too long: hung up, as closing its terminal would.
+    for (auto it = kept.begin(); it != kept.end();) {
+      if (it->second.orphan && now - it->second.since > kOrphanSeconds) {
+        HangUp(it->second);
+        it = kept.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    if (!kept.empty()) {
+      empty_since = now;
+    } else if (now - empty_since > kIdleSeconds) {
+      break;
+    }
+  }
+  close(listener);
+  unlink(path.c_str());
+  return 0;
+}
+
+// ------------------------------------------------------------------ browser
+
+std::string StableRuntimeDir(const std::string& user_data_dir,
+                             const std::string& what) {
+  std::string base = "/tmp/meridian-term-" + base::NumberToString(getuid());
+  mkdir(base.c_str(), 0700);
+  std::string dir = base + "/" + ProfileHash(user_data_dir) + "-" + what;
+  mkdir(dir.c_str(), 0700);
+  struct stat st;
+  if (!SafeDir(base + "/x") || lstat(dir.c_str(), &st) != 0 ||
+      !S_ISDIR(st.st_mode) || st.st_uid != getuid() ||
+      (st.st_mode & 0077) != 0) {
+    return std::string();
+  }
+  return dir;
+}
+
+namespace {
+
+std::string Request(const std::string& user_data_dir,
+                    const std::string& line,
+                    int pass,
+                    int* fd_out,
+                    bool start_host) {
+  const std::string path = SocketPath(user_data_dir);
+  int sock = Connect(path);
+  if (sock < 0 && start_host) {
+    // Started detached: its own session, nothing of the browser's open.
+    std::string exe =
+        base::CommandLine::ForCurrentProcess()->GetProgram().value();
+    std::string sw = std::string(kSwitch) + path;
+    std::string dir = "--user-data-dir=" + user_data_dir;
+    std::vector<char*> argv = {exe.data(), sw.data(), dir.data(), nullptr};
+    posix_spawn_file_actions_t files;
+    posix_spawn_file_actions_init(&files);
+    for (int f = 0; f < 3; ++f) {
+      posix_spawn_file_actions_addopen(&files, f, "/dev/null",
+                                       f == 0 ? O_RDONLY : O_WRONLY, 0);
+    }
+    posix_spawnattr_t attr;
+    posix_spawnattr_init(&attr);
+    short flags = POSIX_SPAWN_SETSID;
+#if BUILDFLAG(IS_MAC)
+    flags |= POSIX_SPAWN_CLOEXEC_DEFAULT;
+#endif
+    posix_spawnattr_setflags(&attr, flags);
+    pid_t pid = 0;
+    posix_spawn(&pid, exe.c_str(), &files, &attr, argv.data(), environ);
+    posix_spawnattr_destroy(&attr);
+    posix_spawn_file_actions_destroy(&files);
+    for (int i = 0; i < 60 && sock < 0; ++i) {
+      usleep(50000);
+      sock = Connect(path);
+    }
+  }
+  if (sock < 0) {
+    if (pass >= 0) {
+      close(pass);
+    }
+    return {};
+  }
+  SendMsg(sock, line + "\n", pass);
+  if (pass >= 0) {
+    close(pass);
+  }
+  shutdown(sock, SHUT_WR);
+  std::string reply = ReceiveAll(sock, fd_out, false);
+  close(sock);
+  return reply;
+}
+
+}  // namespace
+
+bool KeepTerminal(const std::string& user_data_dir,
+                  const std::string& key,
+                  int pid,
+                  int master,
+                  const std::string& root,
+                  const std::string& meta) {
+  return Request(user_data_dir,
+                 "KEEP\t" + key + "\t" + base::NumberToString(pid) + "\t" +
+                     base::NumberToString(getpid()) + "\t" + B64(root) + "\t" +
+                     B64(meta),
+                 master, nullptr, true) == "OK\n";
+}
+
+void DropTerminal(const std::string& user_data_dir, const std::string& key) {
+  Request(user_data_dir, "DROP\t" + key, -1, nullptr, false);
+}
+
+std::vector<OrphanTerminal> AdoptTerminals(const std::string& user_data_dir,
+                                           const std::string& root) {
+  std::vector<OrphanTerminal> out;
+  std::string list =
+      Request(user_data_dir, "LIST\t" + B64(root), -1, nullptr, false);
+  for (const std::string& line : base::SplitString(
+           list, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    std::vector<std::string> f = base::SplitString(
+        line, "\t", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+    int pid = 0;
+    if (f.size() != 3 || !base::StringToInt(f[1], &pid)) {
+      continue;
+    }
+    int fd = -1;
+    std::string got =
+        Request(user_data_dir, "TAKE\t" + f[0], -1, &fd, false);
+    if (fd < 0 || got.empty() || got[0] != 'T') {
+      if (fd >= 0) {
+        close(fd);
+      }
+      continue;
+    }
+    OrphanTerminal t;
+    t.key = f[0];
+    t.pid = pid;
+    t.master = fd;
+    t.meta = UnB64(f[2]);
+    std::string b64 = got.substr(1);
+    while (!b64.empty() && b64.back() == '\n') {
+      b64.pop_back();
+    }
+    t.output = UnB64(b64);
+    out.push_back(std::move(t));
+  }
+  return out;
+}
+
+}  // namespace meridian::workbench
