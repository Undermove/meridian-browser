+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_TERM_HOST_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_TERM_HOST_H_
+
+#include <string>
+#include <vector>
+
+namespace meridian::workbench {
+
+// Workbench terminals (Claude Code among them) are the browser's children:
+// when the browser crashed, their pty closed and they ended with it. The
+// terminal host keeps a second fd of each pty's master side, so a crash of
+// the browser doesn't close the pty. Once the browser that handed a terminal
+// over is gone, the host reads what the terminal prints (so the program
+// doesn't stall on a full pty) and keeps it; the reopened browser takes the
+// terminal back, with that output, and the Workbench shows it again instead
+// of resuming the session anew. Unclaimed for two hours, a terminal is hung
+// up; with nothing to keep, the host ends.
+//
+// The host is the browser's own binary: `--meridian-term-host=<socket>`
+// (macOS and Linux; Windows terminals are pseudoconsoles in the browser).
+
+bool IsTermHost(int argc, const char** argv);
+int RunTermHost(int argc, const char** argv);
+
+// A folder only this user can use, the same for a profile folder across
+// browser runs (sockets an agent outliving a crash still knows): created if
+// missing, empty if it can't be made safe.
+std::string StableRuntimeDir(const std::string& user_data_dir,
+                             const std::string& what);
+
+// Browser side. All block (sockets): call them on a MayBlock sequence.
+
+// Hands the host a terminal (`master` is a dup the call closes). Starts the
+// host if it isn't running. `key` is unique across browser runs.
+bool KeepTerminal(const std::string& user_data_dir,
+                  const std::string& key,
+                  int pid,
+                  int master,
+                  const std::string& root,
+                  const std::string& meta);
+
+// The terminal ended (or was closed) in the browser: the host lets it go.
+void DropTerminal(const std::string& user_data_dir, const std::string& key);
+
+struct OrphanTerminal {
+  std::string key;
+  int pid = 0;
+  int master = -1;   // owned by the caller now
+  std::string meta;  // what KeepTerminal was given
+  std::string output;  // printed while no browser read it
+};
+
+// The terminals of `root` that a browser which is gone left behind (none if
+// no host runs: it isn't started for this).
+std::vector<OrphanTerminal> AdoptTerminals(const std::string& user_data_dir,
+                                           const std::string& root);
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_TERM_HOST_H_
