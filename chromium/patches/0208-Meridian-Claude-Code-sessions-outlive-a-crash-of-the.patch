+
+// A short path (sun_path holds 104 bytes) in a folder only this user can
+// use, one socket per profile folder.
+std::string SocketPath(const std::string& user_data_dir) {
+  uint64_t h = 1469598103934665603ull;  // FNV-1a
+  for (unsigned char c : user_data_dir) {
+    h = (h ^ c) * 1099511628211ull;
+  }
+  std::string dir = "/tmp/meridian-term-" + base::NumberToString(getuid());
+  mkdir(dir.c_str(), 0700);
+  return dir + "/" + base::HexEncodeLower(base::byte_span_from_ref(h)) +
+         ".sock";
+}
+
+std::string ProfileHash(const std::string& user_data_dir) {
+  uint64_t h = 1469598103934665603ull;  // FNV-1a
+  for (unsigned char c : user_data_dir) {
+    h = (h ^ c) * 1099511628211ull;
+  }
+  return base::HexEncodeLower(base::byte_span_from_ref(h));
+}
+
+bool SafeDir(const std::string& socket) {
+  struct stat st;
+  std::string dir = socket.substr(0, socket.rfind('/'));
+  return lstat(dir.c_str(), &st) == 0 && S_ISDIR(st.st_mode) &&
+         st.st_uid == getuid() && (st.st_mode & 0077) == 0;
+}
+
+bool FillAddr(const std::string& path, sockaddr_un* addr) {
+  *addr = {};
+  addr->sun_family = AF_UNIX;
+  if (path.size() >= sizeof(addr->sun_path)) {
+    return false;
+  }
+  std::ranges::copy(path, base::span(addr->sun_path).begin());
+  return true;
+}
+
+int Connect(const std::string& path) {
+  sockaddr_un addr;
+  if (!SafeDir(path) || !FillAddr(path, &addr)) {
+    return -1;
+  }
+  int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (fd < 0) {
+    return -1;
+  }
+  fcntl(fd, F_SETFD, FD_CLOEXEC);
+  timeval tv = {5, 0};
+  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+  setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+  if (connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+    close(fd);
+    return -1;
+  }
+  return fd;
+}
+
+// One message, with an fd riding along if `pass` >= 0.
+bool SendMsg(int sock, std::string_view data, int pass) {
+  iovec iov = {const_cast<char*>(data.data()), data.size()};
+  msghdr msg = {};
+  msg.msg_iov = &iov;
+  msg.msg_iovlen = 1;
+  alignas(cmsghdr) std::array<char, CMSG_SPACE(sizeof(int))> control = {};
+  if (pass >= 0) {
+    msg.msg_control = control.data();
+    msg.msg_controllen = control.size();
+    cmsghdr* c = CMSG_FIRSTHDR(&msg);
+    c->cmsg_level = SOL_SOCKET;
+    c->cmsg_type = SCM_RIGHTS;
+    c->cmsg_len = CMSG_LEN(sizeof(int));
+    UNSAFE_BUFFERS(memcpy(CMSG_DATA(c), &pass, sizeof(int)));
+  }
+  ssize_t n = sendmsg(sock, &msg, 0);
+  if (n < 0) {
+    return false;
+  }
+  // The rest (never with the fd again).
+  for (size_t sent = static_cast<size_t>(n); sent < data.size();) {
+    ssize_t m = write(sock, data.substr(sent).data(), data.size() - sent);
+    if (m <= 0) {
+      return false;
+    }
+    sent += static_cast<size_t>(m);
+  }
+  return true;
+}
+
+// Reads until EOF (or `stop_at_newline`), keeping the first fd that came.
+std::string ReceiveAll(int sock, int* fd, bool stop_at_newline) {
+  std::string out;
+  std::array<char, 65536> buffer;
+  while (true) {
+    iovec iov = {buffer.data(), buffer.size()};
+    msghdr msg = {};
+    msg.msg_iov = &iov;
+    msg.msg_iovlen = 1;
+    alignas(cmsghdr) std::array<char, CMSG_SPACE(sizeof(int) * 4)> control = {};
+    msg.msg_control = control.data();
+    msg.msg_controllen = control.size();
+    ssize_t n = recvmsg(sock, &msg, 0);
+    if (n < 0 && errno == EINTR) {
+      continue;
+    }
+    for (cmsghdr* c = CMSG_FIRSTHDR(&msg); c;
+         c = UNSAFE_BUFFERS(CMSG_NXTHDR(&msg, c))) {
+      if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS) {
+        size_t count = (c->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+        for (size_t i = 0; i < count; ++i) {
+          int got;
+          UNSAFE_BUFFERS(memcpy(&got, CMSG_DATA(c) + i * sizeof(int),
+                                sizeof(int)));
+          if (fd && *fd < 0) {
+            *fd = got;
+            fcntl(got, F_SETFD, FD_CLOEXEC);
+          } else {
+            close(got);
+          }
+        }
+      }
+    }
+    if (n <= 0) {
+      break;
+    }
+    out.append(buffer.data(), static_cast<size_t>(n));
+    if (stop_at_newline && out.find('\n') != std::string::npos) {
+      break;
+    }
+    if (out.size() > 8 * kMaxOutput) {
+      break;
+    }
+  }
+  return out;
+}
+
+std::string B64(std::string_view s) {
+  return base::Base64Encode(base::as_byte_span(s));
+}
+
+std::string UnB64(std::string_view s) {
+  std::string out;
+  base::Base64Decode(s, &out);
+  return out;
+}
