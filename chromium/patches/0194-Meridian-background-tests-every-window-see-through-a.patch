From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Fri, 20 Nov 2026 00:01:29 +0400
Subject: [PATCH 195/202] Meridian: background tests: every window see-through
 and click-through

Some windows go on screen though the app is never active (a tab opened over
DevTools, a bubble): in --meridian-test-background each one is made fully
transparent and lets clicks pass, on its first update and on a timer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/app_controller_mac.mm | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/chrome/browser/app_controller_mac.mm b/chrome/browser/app_controller_mac.mm
index 32bbdf5fe2..6a19fb3e6a 100644
--- a/chrome/browser/app_controller_mac.mm
+++ b/chrome/browser/app_controller_mac.mm
@@ -938,6 +938,32 @@ class AppControllerProfileObserver : public ProfileAttributesStorage::Observer,
   // goes to the pages over the DevTools protocol, not through macOS.
   if (meridian::HasTestSwitch("meridian-test-background")) {
     [NSApp setActivationPolicy:NSApplicationActivationPolicyProhibited];
+    // Some windows are put on screen without the app being active (a tab
+    // opened over DevTools, a bubble): every window of this app is
+    // see-through and lets clicks pass, as soon as it updates (and on a
+    // timer, should one not).
+    auto hide = ^{
+      for (NSWindow* window in NSApp.windows) {
+        if (window.alphaValue > 0) {
+          window.alphaValue = 0;
+          window.ignoresMouseEvents = YES;
+        }
+      }
+    };
+    [NSNotificationCenter.defaultCenter
+        addObserverForName:NSWindowDidUpdateNotification
+                    object:nil
+                     queue:nil
+                usingBlock:^(NSNotification* note) {
+                  NSWindow* window = note.object;
+                  if (window.alphaValue > 0) {
+                    window.alphaValue = 0;
+                    window.ignoresMouseEvents = YES;
+                  }
+                }];
+    [NSTimer scheduledTimerWithTimeInterval:0.05
+                                    repeats:YES
+                                      block:^(NSTimer*) { hide(); }];
   }
 
   [self initShareMenu];
