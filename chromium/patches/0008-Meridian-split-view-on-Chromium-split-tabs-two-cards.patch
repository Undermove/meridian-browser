+void SidebarHandler::OnSplitTabChanged(const SplitTabChange& change) {
+  ScheduleNotify();
+}
+
+void SidebarHandler::SplitWith(const tabs_api::NodeId& other) {
+  tabs::TabInterface* tab = TabFor(other);
+  tabs::TabInterface* active = model()->GetActiveTab();
+  if (!tab || !active || tab == active || tab->GetSplit() ||
+      active->GetSplit()) {
+    return;
+  }
+  model()->AddToNewSplit(
+      {model()->GetIndexOfTab(active), model()->GetIndexOfTab(tab)},
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kSideBySide),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+}
+
+void SidebarHandler::Unsplit() {
+  tabs::TabInterface* active = model()->GetActiveTab();
+  if (active && active->GetSplit()) {
+    model()->RemoveSplit(*active->GetSplit());
+  }
+}
+
+void SidebarHandler::SetSplitRatio(const std::string& split_id, double ratio) {
+  for (int i = 0; i < model()->count(); ++i) {
+    std::optional<split_tabs::SplitTabId> id =
+        model()->GetTabAtIndex(i)->GetSplit();
+    if (id && id->ToString() == split_id) {
+      model()->UpdateSplitRatio(*id, std::clamp(ratio, 0.15, 0.85));
+      return;
+    }
+  }
+}
