+  // Meridian split view: `split` tabs side by side as two cards, `ratio` of
+  // the width for the first, with a draggable divider. null: one tab.
+  private split_: {id: string, start: string, end: string}|null = null;
+  private handle_: HTMLElement|null = null;
+
+  setSplit(split: {id: string, start: string, end: string, ratio: number}|null) {
+    for (const webview of this.webviews.values()) {
+      webview.classList.remove('split-start', 'split-end');
+    }
+    this.split_ = split;
+    this.toggleAttribute('split', !!split);
+    if (!split) {
+      this.handle_?.remove();
+      return;
+    }
+    this.webviews.get(split.start)?.classList.add('split-start');
+    this.webviews.get(split.end)?.classList.add('split-end');
+    this.style.setProperty('--split-ratio', String(split.ratio));
+    if (!this.handle_) {
+      this.handle_ = document.createElement('div');
+      this.handle_.id = 'splitHandle';
+      this.handle_.addEventListener('pointerdown', this.onHandleDown_);
+    }
+    this.shadowRoot.appendChild(this.handle_);
+  }
+
+  private onHandleDown_ = (e: PointerEvent) => {
+    const split = this.split_;
+    if (!split || !this.handle_) {
+      return;
+    }
+    e.preventDefault();
+    this.handle_.setPointerCapture(e.pointerId);
+    this.toggleAttribute('resizing', true);
+    const rect = this.getBoundingClientRect();
+    const ratioAt = (x: number) =>
+        Math.min(0.85, Math.max(0.15, (x - rect.left) / rect.width));
+    const move = (ev: PointerEvent) => {
+      this.style.setProperty('--split-ratio', String(ratioAt(ev.clientX)));
+    };
+    const up = (ev: PointerEvent) => {
+      this.handle_?.removeEventListener('pointermove', move);
+      this.handle_?.removeEventListener('pointerup', up);
+      this.toggleAttribute('resizing', false);
+      this.fire('split-ratio-changed', {id: split.id, ratio: ratioAt(ev.clientX)});
+    };
+    this.handle_.addEventListener('pointermove', move);
+    this.handle_.addEventListener('pointerup', up);
+  };
+
+  // A click into the other half of a split makes its tab the active one.
+  private onWebviewFocusIn_ = (e: Event) => {
+    const webview = e.currentTarget as TabWebviewElement;
+    if (this.split_ && webview !== this.activeWebview &&
+        (webview.tabId === this.split_.start ||
+         webview.tabId === this.split_.end)) {
+      this.fire('split-pane-focused', webview.tabId);
+    }
+  };
+
   removeTab(tabId: string) {
     const webview = this.webviews.get(tabId);
     assert(webview);
