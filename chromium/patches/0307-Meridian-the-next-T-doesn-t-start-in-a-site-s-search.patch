From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 26 Nov 2026 04:36:46 +0400
Subject: [PATCH] =?UTF-8?q?Meridian:=20the=20next=20=E2=8C=98T=20doesn't?=
 =?UTF-8?q?=20start=20in=20a=20site's=20search=20left=20over?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Chromium 159's field keeps its keyword chip ("kiwi " typed) through a
reset, so after Escape the next ⌘T began in that site's search: "ai"
then picked nothing for Return, which is how "the command bar finds
Settings" failed. The bar leaves keyword mode as it opens and closes,
and reads the chip with the text on every key, so the pick follows the
chip even when the text stays the same.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../webui_browser/meridian/command_bar.ts     | 23 ++++++++++++++-----
 1 file changed, 17 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/resources/webui_browser/meridian/command_bar.ts b/chrome/browser/resources/webui_browser/meridian/command_bar.ts
index 8730f96dbc..f6e536a343 100644
--- a/chrome/browser/resources/webui_browser/meridian/command_bar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/command_bar.ts
@@ -205,6 +205,7 @@ export class MeridianCommandBarElement extends CrLitElement {
       askError_: {state: true, type: String},
       tabs: {type: Array},
       query_: {state: true, type: String},
+      chip_: {state: true, type: Boolean},
       tabRows_: {state: true, type: Array},
       featureRows_: {state: true, type: Array},
       layoutFix_: {state: true, type: String},
@@ -227,6 +228,10 @@ export class MeridianCommandBarElement extends CrLitElement {
   // is empty, and the ones that match what is typed.
   accessor tabs: CommandBarTab[] = [];
   protected accessor query_: string = '';
+  // Chromium 159's keyword chip shows in the field ("kiwi " typed): read
+  // with the text, as the field can take the chip or drop it while the text
+  // stays the same (Backspace in an empty field).
+  protected accessor chip_: boolean = false;
   protected accessor tabRows_: CommandBarTab[] = [];
   // Meridian's features named by what is typed, above everything else.
   protected accessor featureRows_: CommandBarFeature[] = [];
@@ -292,8 +297,10 @@ export class MeridianCommandBarElement extends CrLitElement {
     const input = this.address_.shadowRoot.querySelector('cr-searchbox-input')
                       ?.shadowRoot?.querySelector<HTMLInputElement>('input');
     const query = input?.value || '';
-    if (query !== this.query_) {
+    const chip = this.address_.keywordModeManager.isInKeywordMode;
+    if (query !== this.query_ || chip !== this.chip_) {
       this.query_ = query;
+      this.chip_ = chip;
       this.tabSel_ = -1;
     }
   }
@@ -527,7 +534,8 @@ export class MeridianCommandBarElement extends CrLitElement {
       this.bang_ = parseBang(this.query_);
     }
     const first = q !== '' && !!rows[0] && starts(rows[0]);
-    if (changed.has('query_' as keyof MeridianCommandBarElement)) {
+    if (changed.has('query_' as keyof MeridianCommandBarElement) ||
+        changed.has('chip_' as keyof MeridianCommandBarElement)) {
       this.tabsFirst_ = first;
       // A feature named by what was typed is picked for Return, before a
       // tab that starts that way.
@@ -536,10 +544,7 @@ export class MeridianCommandBarElement extends CrLitElement {
       // Nothing either for what follows a site's keyword chip ("kiwi pear"):
       // Return searches that site.
       const top = features[0];
-      const chip =
-          this.address_ ? this.address_.keywordModeManager.isInKeywordMode :
-                          false;
-      this.tabSel_ = this.bang_ || chip ? -1 :
+      this.tabSel_ = this.bang_ || this.chip_ ? -1 :
           top && (top.setting ? top.m === 3 : top.m >= 2) ? 0 :
           first                          ? this.featureRows_.length :
                                            -1;
@@ -603,9 +608,13 @@ export class MeridianCommandBarElement extends CrLitElement {
     await this.updateComplete;
     const box = this.address_;
     this.query_ = text;
+    this.chip_ = false;
     this.shownText_ = text;
     // ⌘T: the latest tab is picked, so Return goes back to it (Arc).
     this.tabSel_ = text ? -1 : 0;
+    // The field keeps its keyword chip through a reset: the next ⌘T would
+    // start in that site's search, with nothing picked for Return.
+    box.keywordModeManager.exit();
     box.reset(text);
     box.focusInput();
     box.selectAll();
@@ -620,8 +629,10 @@ export class MeridianCommandBarElement extends CrLitElement {
     this.open = false;
     this.mode_ = null;
     this.query_ = '';
+    this.chip_ = false;
     this.siteHint_ = '';
     this.bang_ = null;
+    this.address_.keywordModeManager.exit();
     this.address_.reset('');
     this.clearAnswer_();
     this.fire('command-bar-closed', {handBack});
