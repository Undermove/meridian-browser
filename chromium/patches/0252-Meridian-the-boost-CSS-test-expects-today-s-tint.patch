From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Tue, 24 Nov 2026 21:52:35 +0400
Subject: [PATCH 252/297] Meridian: the boost CSS test expects today's tint

The tint now turns the site's own accent (hue-rotate by the page's
--meridian-boost-turn) and lays hsl(<tint> 70% 72%) at a tenth of the
strength on top; the test still looked for the old overlay
(hsl(30 85% 50%), opacity 0.5) and a filter without the turn.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../browser/meridian/boosts/boost_service_unittest.cc | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/meridian/boosts/boost_service_unittest.cc b/chrome/browser/meridian/boosts/boost_service_unittest.cc
index c0c3733536..dacc670c35 100644
--- a/chrome/browser/meridian/boosts/boost_service_unittest.cc
+++ b/chrome/browser/meridian/boosts/boost_service_unittest.cc
@@ -77,9 +77,14 @@ TEST(BoostServiceTest, PageCssHasTintDarkSizeAndCase) {
   b.text_case = "lower";
   b.contrast = 120;
   std::string css = b.PageCss();
-  EXPECT_NE(css.find("hsl(30 85% 50%)"), std::string::npos);
-  EXPECT_NE(css.find("opacity: 0.5"), std::string::npos);
-  EXPECT_NE(css.find("invert(1) hue-rotate(180deg) contrast(120%)"),
+  // The tint turns the site's own accent (the turn comes from the page) and
+  // lays a breath of the colour on top.
+  EXPECT_NE(css.find("--meridian-boost-tint: 30; --meridian-boost-strength: 50;"),
+            std::string::npos);
+  EXPECT_NE(css.find("hsl(30 70% 72%)"), std::string::npos);
+  EXPECT_NE(css.find("opacity: 0.05"), std::string::npos);
+  EXPECT_NE(css.find("invert(1) hue-rotate(180deg) hue-rotate(var("
+                     "--meridian-boost-turn, 0deg)) contrast(120%)"),
             std::string::npos);
   // Pictures undo the dark.
   EXPECT_NE(css.find("img, video"), std::string::npos);
