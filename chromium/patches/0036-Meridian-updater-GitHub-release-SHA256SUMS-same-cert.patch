diff --git a/chrome/browser/meridian/update_check.cc b/chrome/browser/meridian/update_check.cc
new file mode 100644
index 0000000000..00624b6c0c
--- /dev/null
+++ b/chrome/browser/meridian/update_check.cc
@@ -0,0 +1,167 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/update_check.h"
+
+#include <vector>
+
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/values.h"
+
+namespace meridian::update {
+
+namespace {
+
+// Digits and dots only ("1.0.3").
+std::optional<std::vector<int>> Parts(std::string_view version) {
+  std::vector<int> out;
+  for (std::string_view part : base::SplitStringPiece(
+           version, ".", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    int n = 0;
+    if (part.empty() || !base::StringToInt(part, &n) || n < 0 ||
+        part.find_first_not_of("0123456789") != std::string_view::npos) {
+      return std::nullopt;
+    }
+    out.push_back(n);
+  }
+  return out;
+}
+
+// Single-quoted for bash.
+std::string Quote(const base::FilePath& path) {
+  std::string s;
+  base::ReplaceChars(path.value(), "'", "'\\''", &s);
+  return "'" + s + "'";
+}
+
+}  // namespace
+
+bool IsNewer(std::string_view latest, std::string_view current) {
+  std::optional<std::vector<int>> a = Parts(latest);
+  // The current one may carry a suffix ("1.0.0-dev"): compare its numbers.
+  std::optional<std::vector<int>> b =
+      Parts(current.substr(0, current.find('-')));
+  if (!a || !b) {
+    return false;
+  }
+  for (size_t i = 0; i < std::max(a->size(), b->size()); ++i) {
+    int x = i < a->size() ? (*a)[i] : 0;
+    int y = i < b->size() ? (*b)[i] : 0;
+    if (x != y) {
+      return x > y;
+    }
+  }
+  return false;
+}
+
+std::optional<Release> ParseRelease(std::string_view json,
+                                    std::string_view arch) {
+  std::optional<base::Value> value =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = value->GetDict();
+  const std::string* tag = dict.FindString("tag_name");
+  if (!tag || dict.FindBool("prerelease").value_or(false) ||
+      dict.FindBool("draft").value_or(false)) {
+    return std::nullopt;
+  }
+  Release release;
+  release.version = std::string(base::TrimString(*tag, "v", base::TRIM_LEADING));
+  if (!Parts(release.version)) {
+    return std::nullopt;
+  }
+  if (const std::string* page = dict.FindString("html_url")) {
+    release.page_url = *page;
+  }
+  release.zip_name = base::StringPrintf("Meridian-%s-mac-%s.zip",
+                                        release.version.c_str(),
+                                        std::string(arch).c_str());
+  if (const base::ListValue* assets = dict.FindList("assets")) {
+    for (const base::Value& asset : *assets) {
+      if (!asset.is_dict()) {
+        continue;
+      }
+      const std::string* name = asset.GetDict().FindString("name");
+      const std::string* url =
+          asset.GetDict().FindString("browser_download_url");
+      if (!name || !url) {
+        continue;
+      }
+      if (*name == release.zip_name) {
+        release.zip_url = *url;
+      } else if (*name == "SHA256SUMS") {
+        release.sums_url = *url;
+      }
+    }
+  }
+  if (release.zip_url.empty() || release.sums_url.empty()) {
+    return std::nullopt;
+  }
+  return release;
+}
+
+std::optional<std::string> FindSum(std::string_view sums,
+                                   std::string_view name) {
+  for (std::string_view line : base::SplitStringPiece(
+           sums, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    std::vector<std::string_view> parts = base::SplitStringPiece(
+        line, " \t", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (parts.size() != 2) {
+      continue;
+    }
+    // `shasum -b` marks binary mode with a leading '*'.
+    std::string_view file = parts[1];
+    if (base::StartsWith(file, "*")) {
+      file.remove_prefix(1);
+    }
+    if (file != name || parts[0].size() != 64 ||
+        parts[0].find_first_not_of("0123456789abcdefABCDEF") !=
+            std::string_view::npos) {
+      continue;
+    }
+    return base::ToLowerASCII(parts[0]);
+  }
+  return std::nullopt;
+}
+
+bool CanUpdateInPlace(const base::FilePath& bundle) {
+  if (bundle.Extension() != ".app") {
+    return false;
+  }
+  const std::string& path = bundle.value();
+  return !base::StartsWith(path, "/Volumes/") &&
+         path.find("/AppTranslocation/") == std::string::npos;
+}
+
+std::string SwapScript(int pid,
+                       const base::FilePath& staged,
+                       const base::FilePath& target,
+                       bool relaunch) {
+  const std::string old = Quote(target.AddExtension("previous"));
+  return base::StringPrintf(
+      "set -u\n"
+      "# Meridian's updater: swap the app once Meridian has quit.\n"
+      "for i in $(seq 1 600); do kill -0 %d 2>/dev/null || break; "
+      "sleep 0.1; done\n"
+      "kill -0 %d 2>/dev/null && { echo 'Meridian is still running'; "
+      "exit 1; }\n"
+      "rm -rf %s\n"
+      "mv %s %s || exit 1\n"
+      "if ! mv %s %s; then mv %s %s; echo 'swap failed'; exit 1; fi\n"
+      "rm -rf %s\n"
+      "echo 'updated'\n"
+      "%s\n",
+      pid, pid, old.c_str(), Quote(target).c_str(), old.c_str(),
+      Quote(staged).c_str(), Quote(target).c_str(), old.c_str(),
+      Quote(target).c_str(), old.c_str(),
+      relaunch ? ("/usr/bin/open " + Quote(target)).c_str() : "true");
+}
+
+}  // namespace meridian::update
