+namespace network {
+class SimpleURLLoader;
+}
+
+namespace meridian {
+
+// Meridian's own updater (no paid Apple signing, so no Sparkle or system
+// updater): asks GitHub for the latest release a little after start and then
+// daily, downloads its zip in the background, checks it against the
+// release's SHA256SUMS and that it is signed like this build, unpacks it,
+// and offers "Restart to update", which quits and lets a small script swap
+// the app and open the new one. Run from a disk image (or anywhere it can't
+// write) it only points to the release page.
+//
+// Tests: --meridian-update-feed=<url> (checks at once), and
+// --meridian-test-update-target=<Meridian.app> swaps that one instead of the
+// running app, without the signature check and without opening it.
+class Updater {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnUpdateStateChanged() = 0;
+  };
+
+  static Updater& Get();
+
+  Updater(const Updater&) = delete;
+  Updater& operator=(const Updater&) = delete;
+
+  // Starts the checks (once; later calls do nothing).
+  void Start();
+  // "Check for Updates" in Settings: now, and says when it's up to date.
+  void CheckNow();
+  // Quits Meridian and swaps in the downloaded version.
+  bool Install();
+
+  mojom::UpdateStatePtr State() const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  friend class base::NoDestructor<Updater>;
+  Updater();
+  ~Updater();
+
+  void OnLocated(std::pair<bool, bool> signed_and_in_place);
+  void Check();
+  void OnFeed(std::optional<std::string> body);
+  void OnZip(base::FilePath path);
+  void OnSums(std::optional<std::string> body);
+  void OnStaged(std::string error);
+  void Set(mojom::UpdateStatus status, std::string error = std::string());
+
+  bool started_ = false;
+  bool user_check_ = false;
+  bool located_ = false;
+  bool in_place_ = false;
+  base::FilePath dir_;
+  base::FilePath bundle_;
+  base::FilePath zip_;
+  update::Release release_;
+  mojom::UpdateStatus status_ = mojom::UpdateStatus::kIdle;
+  std::string error_;
+  double progress_ = 0;
+  int64_t zip_size_ = 0;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::RepeatingTimer timer_;
+  base::OneShotTimer first_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<Updater> weak_factory_{this};
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_UPDATER_H_
