+constexpr base::TimeDelta kFirstCheck = base::Seconds(15);
+constexpr base::TimeDelta kEvery = base::Hours(24);
+constexpr int64_t kMaxZip = int64_t{2} << 30;
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("meridian_updater", R"(
+      semantics {
+        sender: "Meridian updater"
+        description:
+          "Asks GitHub for Meridian's latest release and downloads it, with "
+          "its checksums, when it is newer than this build."
+        trigger: "A little after start, then daily; Settings > Check for "
+                 "Updates."
+        data: "None: no cookies or other credentials are sent."
+        destination: OTHER
+        destination_other: "GitHub releases of Meridian."
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "None; the update is installed only when the person "
+                 "restarts to update."
+        policy_exception_justification: "Keeps Meridian up to date."
+      })");
+
+const char* Arch() {
+#if defined(ARCH_CPU_ARM64)
+  return "arm64";
+#else
+  return "x64";
+#endif
+}
+
+const base::CommandLine& Switches() {
+  return *base::CommandLine::ForCurrentProcess();
+}
+
+std::unique_ptr<network::SimpleURLLoader> Request(const std::string& url) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(url);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  // Not IDLE: SimpleURLLoader would write the file at BEST_EFFORT, which
+  // waits for startup to finish (and never does behind a locked screen).
+  request->priority = net::LOW;
+  request->headers.SetHeader("Accept", "application/vnd.github+json");
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kAnnotation);
+  loader->SetRetryOptions(
+      2, network::SimpleURLLoader::RETRY_ON_NETWORK_CHANGE |
+             network::SimpleURLLoader::RETRY_ON_5XX);
+  return loader;
+}
+
+// The designated requirement macOS keeps for `bundle` ("identifier ... and
+// certificate leaf = H\"...\""), or empty for an unsigned or ad-hoc one.
+std::string Requirement(const base::FilePath& bundle) {
+  std::string out;
+  if (!base::GetAppOutputAndError(
+          {"/usr/bin/codesign", "-d", "-r-", bundle.value()}, &out)) {
+    return std::string();
+  }
+  for (std::string_view line : base::SplitStringPiece(
+           out, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (base::StartsWith(line, "designated => ")) {
+      line.remove_prefix(strlen("designated => "));
+      // Ad-hoc signatures are only their own hash.
+      if (base::StartsWith(line, "cdhash ")) {
+        return std::string();
+      }
+      return std::string(line);
+    }
+  }
+  return std::string();
+}
+
+std::string Plist(const base::FilePath& bundle, const std::string& key) {
+  std::string out;
+  base::GetAppOutput({"/usr/libexec/PlistBuddy", "-c", "Print :" + key,
+                      bundle.Append("Contents/Info.plist").value()},
+                     &out);
+  return std::string(base::TrimWhitespaceASCII(out, base::TRIM_ALL));
+}
+
+// On a worker: checks the zip, unpacks it and checks the app inside.
+// Returns an error for the person, or empty when `staged` is ready.
+std::string Stage(base::FilePath zip,
+                  std::string sum,
+                  base::FilePath staged,
+                  base::FilePath running,
+                  bool check_signature) {
+  base::File file(zip, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return "The download is missing.";
+  }
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+  std::vector<uint8_t> buffer(1 << 20);
+  while (true) {
+    std::optional<size_t> n = file.ReadAtCurrentPos(buffer);
+    if (!n) {
+      return "The download couldn’t be read.";
+    }
+    if (*n == 0) {
+      break;
+    }
+    hasher.Update(base::span(buffer).first(*n));
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  if (base::ToLowerASCII(base::HexEncode(digest)) != sum) {
+    return "The download doesn’t match the release’s checksum.";
+  }
+
+  base::FilePath unpacked = staged.DirName();
+  base::DeletePathRecursively(unpacked);
+  base::CreateDirectory(unpacked);
+  std::string out;
+  int code = -1;
+  if (!base::GetAppOutputWithExitCode(
+          {"/usr/bin/ditto", "-x", "-k", zip.value(), unpacked.value()}, &out,
+          &code) ||
+      code != 0 || !base::DirectoryExists(staged)) {
+    return "The download couldn’t be unpacked.";
+  }
+  base::DeleteFile(zip);
+  if (Plist(staged, "CFBundleIdentifier") !=
+      Plist(running, "CFBundleIdentifier")) {
+    return "The download isn’t Meridian.";
+  }
+  if (check_signature) {
+    // Signed with the same certificate as this build ("Meridian Signing").
+    std::string requirement = Requirement(running);
+    if (requirement.empty()) {
+      return "This build isn’t signed, so it can’t check an update.";
+    }
+    if (!base::GetAppOutputWithExitCode(
+            {"/usr/bin/codesign", "--verify", "--deep", "--strict",
+             "-R=" + requirement, staged.value()},
+            &out, &code) ||
+        code != 0) {
+      return "The download isn’t signed like Meridian.";
+    }
+  }
+  return std::string();
+}
+
+}  // namespace
+
+// static
+Updater& Updater::Get() {
+  static base::NoDestructor<Updater> updater;
+  return *updater;
+}
+
+Updater::Updater() = default;
+Updater::~Updater() = default;
+
+void Updater::Start() {
+  if (started_) {
+    return;
+  }
+  started_ = true;
+  base::PathService::Get(chrome::DIR_USER_DATA, &dir_);
+  dir_ = dir_.Append("Meridian Update");
+  bundle_ = base::apple::OuterBundlePath();
+  if (Switches().HasSwitch("meridian-test-update-target")) {
+    bundle_ = Switches().GetSwitchValuePath("meridian-test-update-target");
+  }
+  // Off the UI thread: whether this build is signed (development builds,
+  // ad-hoc signed in out/, don't update themselves; tests point them at a
+  // feed) and whether its folder can take the new version.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath bundle, base::FilePath dir) {
+            base::CreateDirectory(dir);
+            return std::make_pair(
+                !Requirement(base::apple::OuterBundlePath()).empty(),
+                update::CanUpdateInPlace(bundle) &&
+                    base::PathIsWritable(bundle.DirName()));
+          },
+          bundle_, dir_),
+      base::BindOnce(&Updater::OnLocated, weak_factory_.GetWeakPtr()));
+}
+
+void Updater::OnLocated(std::pair<bool, bool> signed_and_in_place) {
+  in_place_ = signed_and_in_place.second;
+  located_ = true;
+  if (user_check_) {
+    Check();
+  }
+  if (!signed_and_in_place.first &&
+      !Switches().HasSwitch("meridian-update-feed")) {
+    return;
+  }
+  first_.Start(FROM_HERE,
+               Switches().HasSwitch("meridian-update-feed") ? base::TimeDelta()
+                                                            : kFirstCheck,
+               base::BindOnce(&Updater::Check, weak_factory_.GetWeakPtr()));
+  timer_.Start(FROM_HERE, kEvery,
+               base::BindRepeating(&Updater::Check,
+                                   weak_factory_.GetWeakPtr()));
+}
+
+void Updater::CheckNow() {
+  user_check_ = true;
+  Start();
+  if (located_) {
+    Check();
+  }
+}
+
+void Updater::Check() {
+  // Busy, or already waiting for a restart.
+  if (status_ == mojom::UpdateStatus::kChecking ||
+      status_ == mojom::UpdateStatus::kDownloading ||
+      status_ == mojom::UpdateStatus::kReady) {
+    return;
+  }
+  std::string feed = Switches().HasSwitch("meridian-update-feed")
+                         ? Switches().GetSwitchValueASCII("meridian-update-feed")
+                         : update::kFeed;
+  Set(mojom::UpdateStatus::kChecking);
+  loader_ = Request(feed);
+  loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&Updater::OnFeed, weak_factory_.GetWeakPtr()),
+      1 << 20);
+}
+
+void Updater::OnFeed(std::optional<std::string> body) {
+  loader_.reset();
+  bool user = std::exchange(user_check_, false);
+  if (!body) {
+    Set(user ? mojom::UpdateStatus::kFailed : mojom::UpdateStatus::kIdle,
+        "Couldn’t reach GitHub to check for updates.");
+    return;
+  }
+  std::optional<update::Release> release = update::ParseRelease(*body, Arch());
+  std::string current = Switches().HasSwitch("meridian-test-version")
+                            ? Switches().GetSwitchValueASCII(
+                                  "meridian-test-version")
+                            : update::kVersion;
+  if (!release || !update::IsNewer(release->version, current)) {
+    Set(mojom::UpdateStatus::kUpToDate);
+    return;
+  }
+  release_ = *release;
+  if (!in_place_) {
+    Set(mojom::UpdateStatus::kAvailable);
+    return;
+  }
+  progress_ = 0;
+  zip_size_ = 0;
+  Set(mojom::UpdateStatus::kDownloading);
+  loader_ = Request(release_.zip_url);
+  loader_->SetOnResponseStartedCallback(base::BindOnce(
+      [](Updater* self, const GURL&,
+         const network::mojom::URLResponseHead& head) {
+        self->zip_size_ = head.content_length;
+      },
+      base::Unretained(this)));
+  loader_->SetOnDownloadProgressCallback(base::BindRepeating(
+      [](Updater* self, uint64_t current) {
+        if (self->zip_size_ > 0) {
+          double progress = static_cast<double>(current) / self->zip_size_;
+          // A few updates are enough.
+          if (progress - self->progress_ >= 0.02 || progress >= 1) {
+            self->progress_ = progress;
+            self->observers_.Notify(&Observer::OnUpdateStateChanged);
+          }
+        }
+      },
+      base::Unretained(this)));
+  loader_->DownloadToFile(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&Updater::OnZip, weak_factory_.GetWeakPtr()),
+      dir_.Append(release_.zip_name), kMaxZip);
+}
+
+void Updater::OnZip(base::FilePath path) {
+  bool ok = loader_ && loader_->NetError() == net::OK && !path.empty();
+  loader_.reset();
+  if (!ok) {
+    Set(mojom::UpdateStatus::kFailed, "The update didn’t download.");
+    return;
+  }
+  zip_ = path;
+  loader_ = Request(release_.sums_url);
+  loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&Updater::OnSums, weak_factory_.GetWeakPtr()), 64 << 10);
+}
+
+void Updater::OnSums(std::optional<std::string> body) {
+  loader_.reset();
+  std::optional<std::string> sum =
+      body ? update::FindSum(*body, release_.zip_name) : std::nullopt;
+  if (!sum) {
+    Set(mojom::UpdateStatus::kFailed,
+        "The release has no checksum for this Mac.");
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&Stage, zip_, *sum,
+                     dir_.Append("staged").Append("Meridian.app"),
+                     base::apple::OuterBundlePath(),
+                     !Switches().HasSwitch("meridian-test-update-target")),
+      base::BindOnce(&Updater::OnStaged, weak_factory_.GetWeakPtr()));
+}
+
+void Updater::OnStaged(std::string error) {
+  if (!error.empty()) {
+    LOG(WARNING) << "Meridian update " << release_.version << ": " << error;
+    Set(mojom::UpdateStatus::kFailed, error);
+    return;
+  }
+  Set(mojom::UpdateStatus::kReady);
+}
+
+bool Updater::Install() {
+  if (status_ != mojom::UpdateStatus::kReady) {
+    return false;
+  }
+  const bool test = Switches().HasSwitch("meridian-test-update-target");
+  std::string script = update::SwapScript(
+      base::Process::Current().Pid(),
+      dir_.Append("staged").Append("Meridian.app"), bundle_,
+      /*relaunch=*/!test);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(
+          [](base::FilePath dir, std::string script) {
+            base::FilePath path = dir.Append("swap.sh");
+            if (!base::WriteFile(path, script)) {
+              return false;
+            }
+            base::LaunchOptions options;
+            options.new_process_group = true;
+            base::File log(dir.Append("swap.log"), base::File::FLAG_CREATE_ALWAYS |
+                                                       base::File::FLAG_WRITE);
+            if (log.IsValid()) {
+              options.fds_to_remap.emplace_back(log.GetPlatformFile(),
+                                                STDOUT_FILENO);
+              options.fds_to_remap.emplace_back(log.GetPlatformFile(),
+                                                STDERR_FILENO);
+            }
+            return base::LaunchProcess({"/bin/bash", path.value()}, options)
+                .IsValid();
+          },
+          dir_, std::move(script)),
+      base::BindOnce(
+          [](base::WeakPtr<Updater> self, bool started) {
+            if (!started) {
+              if (self) {
+                self->Set(mojom::UpdateStatus::kFailed,
+                          "Couldn’t start the update.");
+              }
+              return;
+            }
+            // Quit like ⌘Q: the session is saved and comes back in the new
+            // version.
+            chrome::AttemptExit();
+          },
+          weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+mojom::UpdateStatePtr Updater::State() const {
+  auto state = mojom::UpdateState::New();
+  state->status = status_;
+  state->current = Switches().HasSwitch("meridian-test-version")
+                       ? Switches().GetSwitchValueASCII("meridian-test-version")
+                       : update::kVersion;
+  state->version = release_.version;
+  state->progress = progress_;
+  state->error = error_;
+  state->page_url = release_.page_url;
+  return state;
+}
+
+void Updater::Set(mojom::UpdateStatus status, std::string error) {
+  status_ = status;
+  error_ = std::move(error);
+  observers_.Notify(&Observer::OnUpdateStateChanged);
+}
+
+void Updater::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void Updater::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+}  // namespace meridian
