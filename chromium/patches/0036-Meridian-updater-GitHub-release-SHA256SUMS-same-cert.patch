@@ -0,0 +1,62 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_UPDATE_CHECK_H_
+#define CHROME_BROWSER_MERIDIAN_UPDATE_CHECK_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/files/file_path.h"
+
+namespace meridian::update {
+
+// This build's version (the release tag without "v").
+inline constexpr char kVersion[] = "1.0.0";
+
+// GitHub's latest release of Meridian.
+inline constexpr char kFeed[] =
+    "https://api.github.com/repos/Undermove/meridian-browser/releases/latest";
+
+// "1.0.10" > "1.0.9"; a pre-release tag ("1.1.0-beta") is never newer.
+bool IsNewer(std::string_view latest, std::string_view current);
+
+// What a release offers this Mac: the zip the updater swaps in, the
+// checksums it is verified against, and the page for doing it by hand.
+struct Release {
+  std::string version;
+  std::string zip_name;
+  std::string zip_url;
+  std::string sums_url;
+  std::string page_url;
+};
+
+// From the GitHub release JSON; nullopt if it isn't one or has no zip for
+// `arch` ("arm64" or "x64") named Meridian-<version>-mac-<arch>.zip.
+std::optional<Release> ParseRelease(std::string_view json,
+                                    std::string_view arch);
+
+// The SHA-256 (lowercase hex) of `name` in a SHA256SUMS file
+// ("<hex>  <name>" lines), or nullopt.
+std::optional<std::string> FindSum(std::string_view sums,
+                                   std::string_view name);
+
+// Whether Meridian.app at `bundle` can be replaced in place: not run from a
+// disk image or a quarantine-translocated copy. (Writability is checked by
+// the caller.)
+bool CanUpdateInPlace(const base::FilePath& bundle);
+
+// The script that swaps the app once Meridian has quit: waits for `pid` to
+// exit, moves `target` aside, moves `staged` into its place (putting the old
+// one back if that fails), then opens it unless `relaunch` is false. Run
+// detached with /bin/bash.
+std::string SwapScript(int pid,
+                       const base::FilePath& staged,
+                       const base::FilePath& target,
+                       bool relaunch);
+
+}  // namespace meridian::update
+
+#endif  // CHROME_BROWSER_MERIDIAN_UPDATE_CHECK_H_
diff --git a/chrome/browser/meridian/update_check_unittest.cc b/chrome/browser/meridian/update_check_unittest.cc
new file mode 100644
index 0000000000..98f0100ebb
--- /dev/null
+++ b/chrome/browser/meridian/update_check_unittest.cc
@@ -0,0 +1,103 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/update_check.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/process/launch.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::update {
+namespace {
+
+TEST(UpdateCheckTest, ComparesVersions) {
+  EXPECT_TRUE(IsNewer("1.0.1", "1.0.0"));
+  EXPECT_TRUE(IsNewer("1.0.10", "1.0.9"));
+  EXPECT_TRUE(IsNewer("1.1", "1.0.9"));
+  EXPECT_TRUE(IsNewer("1.0.0", "1.0.0-dev") == false);
+  EXPECT_FALSE(IsNewer("1.0.0", "1.0.0"));
+  EXPECT_FALSE(IsNewer("0.9.9", "1.0.0"));
+  EXPECT_FALSE(IsNewer("1.1.0-beta", "1.0.0"));
+  EXPECT_FALSE(IsNewer("", "1.0.0"));
+  EXPECT_FALSE(IsNewer("1..2", "1.0.0"));
+}
+
+TEST(UpdateCheckTest, ParsesTheReleaseForThisMac) {
+  const char kJson[] = R"({
+    "tag_name": "v1.0.3", "html_url": "https://github.com/x/releases/tag/v1.0.3",
+    "assets": [
+      {"name": "Meridian-1.0.3-mac-arm64.dmg", "browser_download_url": "https://d/dmg"},
+      {"name": "Meridian-1.0.3-mac-arm64.zip", "browser_download_url": "https://d/zip"},
+      {"name": "SHA256SUMS", "browser_download_url": "https://d/sums"}
+    ]})";
+  std::optional<Release> r = ParseRelease(kJson, "arm64");
+  ASSERT_TRUE(r);
+  EXPECT_EQ(r->version, "1.0.3");
+  EXPECT_EQ(r->zip_name, "Meridian-1.0.3-mac-arm64.zip");
+  EXPECT_EQ(r->zip_url, "https://d/zip");
+  EXPECT_EQ(r->sums_url, "https://d/sums");
+  EXPECT_EQ(r->page_url, "https://github.com/x/releases/tag/v1.0.3");
+  // No zip for this architecture, a pre-release, or not JSON at all.
+  EXPECT_FALSE(ParseRelease(kJson, "x64"));
+  EXPECT_FALSE(ParseRelease(R"({"tag_name": "v1.1.0", "prerelease": true,
+      "assets": []})", "arm64"));
+  EXPECT_FALSE(ParseRelease("<html>", "arm64"));
+  EXPECT_FALSE(ParseRelease(R"({"tag_name": "nightly", "assets": []})",
+                            "arm64"));
+}
+
+TEST(UpdateCheckTest, FindsTheChecksum) {
+  const std::string hex(64, 'a');
+  const std::string sums = "0123  other.zip\n" + hex +
+                           "  Meridian-1.0.3-mac-arm64.dmg\n" +
+                           std::string(64, 'B') +
+                           " *Meridian-1.0.3-mac-arm64.zip\n";
+  EXPECT_EQ(FindSum(sums, "Meridian-1.0.3-mac-arm64.dmg"), hex);
+  EXPECT_EQ(FindSum(sums, "Meridian-1.0.3-mac-arm64.zip"),
+            std::string(64, 'b'));
+  EXPECT_FALSE(FindSum(sums, "other.zip"));
+  EXPECT_FALSE(FindSum(sums, "missing.zip"));
+}
+
+TEST(UpdateCheckTest, UpdatesInPlaceOnlyFromAnInstalledApp) {
+  EXPECT_TRUE(CanUpdateInPlace(base::FilePath("/Applications/Meridian.app")));
+  EXPECT_TRUE(
+      CanUpdateInPlace(base::FilePath("/Users/me/Applications/Meridian.app")));
+  EXPECT_FALSE(CanUpdateInPlace(base::FilePath("/Volumes/Meridian/Meridian.app")));
+  EXPECT_FALSE(CanUpdateInPlace(base::FilePath(
+      "/private/var/folders/x/AppTranslocation/1234/d/Meridian.app")));
+  EXPECT_FALSE(CanUpdateInPlace(base::FilePath("/usr/local/bin/meridian")));
+}
+
+TEST(UpdateCheckTest, TheSwapScriptReplacesTheAppAndKeepsItOnFailure) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::FilePath target = dir.GetPath().Append("Mer'idian.app");
+  base::FilePath staged = dir.GetPath().Append("staged").Append("Meridian.app");
+  ASSERT_TRUE(base::CreateDirectory(target));
+  ASSERT_TRUE(base::WriteFile(target.Append("version"), "old"));
+  ASSERT_TRUE(base::CreateDirectory(staged));
+  ASSERT_TRUE(base::WriteFile(staged.Append("version"), "new"));
+
+  // A process that has already exited.
+  std::string out;
+  ASSERT_TRUE(base::GetAppOutput(
+      {"/bin/bash", "-c", SwapScript(999999, staged, target, false)}, &out));
+  EXPECT_EQ(out, "updated\n");
+  std::string version;
+  ASSERT_TRUE(base::ReadFileToString(target.Append("version"), &version));
+  EXPECT_EQ(version, "new");
+  EXPECT_FALSE(base::PathExists(staged));
+  EXPECT_FALSE(base::PathExists(target.AddExtension("previous")));
+
+  // Nothing staged: the installed app stays.
+  base::GetAppOutput(
+      {"/bin/bash", "-c", SwapScript(999999, staged, target, false)}, &out);
+  ASSERT_TRUE(base::ReadFileToString(target.Append("version"), &version));
+  EXPECT_EQ(version, "new");
+}
+
+}  // namespace
+}  // namespace meridian::update
