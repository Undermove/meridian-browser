+        return `Meridian ${u.version} is ready. Restart to update; your ` +
+            'tabs come back.';
+      case UpdateStatus.kFailed:
+        return u.error;
+      default:
+        return '';
+    }
+  }
+
+  protected updateReady_(): boolean {
+    return this.update_?.status === UpdateStatus.kReady;
+  }
+
+  protected updateAvailable_(): boolean {
+    return this.update_?.status === UpdateStatus.kAvailable;
+  }
+
+  protected onCheckUpdatesClick_() {
+    this.handler_.checkForUpdates();
+  }
+
+  protected onRestartUpdateClick_() {
+    this.handler_.installUpdate();
+  }
+
+  protected onReleasePageClick_() {
+    if (this.update_?.pageUrl) {
+      this.fire('meridian-open-url', this.update_.pageUrl);
+      this.open = false;
+    }
   }
 
