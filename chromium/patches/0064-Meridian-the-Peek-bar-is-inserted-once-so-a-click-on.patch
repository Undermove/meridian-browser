From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Fri, 30 Oct 2026 17:50:45 +0400
Subject: [PATCH 65/77] Meridian: the Peek bar is inserted once, so a click on
 it can't get lost

Every Peek update (the page's title or URL changing as it loads) inserted
the layer again; a press and release straddling one lost the click.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/resources/webui_browser/content_region.ts | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/resources/webui_browser/content_region.ts b/chrome/browser/resources/webui_browser/content_region.ts
index e15752072c..b2df0c9dfc 100644
--- a/chrome/browser/resources/webui_browser/content_region.ts
+++ b/chrome/browser/resources/webui_browser/content_region.ts
@@ -164,7 +164,12 @@ export class ContentRegionElement extends CrLitElement {
     } catch {
       this.peekHost_!.textContent = peek.url;
     }
-    this.shadowRoot.appendChild(this.peekLayer_);
+    // Only once: re-inserting it on every update (the page's title or URL
+    // changing as it loads) lost a click whose press and release straddled
+    // one.
+    if (!this.peekLayer_.isConnected) {
+      this.shadowRoot.appendChild(this.peekLayer_);
+    }
   }
 
   private firePeek_(action: string) {
