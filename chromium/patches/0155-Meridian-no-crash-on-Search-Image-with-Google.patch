From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Tue, 17 Nov 2026 14:49:41 +0400
Subject: [PATCH 156/156] Meridian: no crash on "Search Image with Google"

Chromium's Lens overlay needs its own browser window and crashed Meridian's
(a CHECK in OverlayBaseController::ShowOverlay) when a picture's context
menu searched for it. The overlay is off; the search opens in a new tab.

Tests: --meridian-test-context-menu-command=<id> runs a context menu's item
in place of the native menu a person would click.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/ui/views/tab_contents/BUILD.gn     |  1 +
 .../chrome_web_contents_view_delegate_views.cc    | 15 +++++++++++++++
 ...chrome_web_contents_view_delegate_views_mac.mm | 15 +++++++++++++++
 components/lens/lens_features.cc                  | 10 +++-------
 4 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/chrome/browser/ui/views/tab_contents/BUILD.gn b/chrome/browser/ui/views/tab_contents/BUILD.gn
index 268f1292fb..3cef37ade0 100644
--- a/chrome/browser/ui/views/tab_contents/BUILD.gn
+++ b/chrome/browser/ui/views/tab_contents/BUILD.gn
@@ -22,6 +22,7 @@ source_set("tab_contents") {
   ]
 
   deps = [
+    "//chrome/browser/meridian:test_switches",
     "//chrome/browser/ui:browser_element_identifiers",
     "//chrome/browser/ui:sad_tab",
     "//chrome/browser/ui/location_bar",
diff --git a/chrome/browser/ui/views/tab_contents/chrome_web_contents_view_delegate_views.cc b/chrome/browser/ui/views/tab_contents/chrome_web_contents_view_delegate_views.cc
index c0d7ec5a86..83a3e71114 100644
--- a/chrome/browser/ui/views/tab_contents/chrome_web_contents_view_delegate_views.cc
+++ b/chrome/browser/ui/views/tab_contents/chrome_web_contents_view_delegate_views.cc
@@ -7,7 +7,9 @@
 #include <memory>
 #include <utility>
 
+#include "base/strings/string_number_conversions.h"
 #include "chrome/browser/defaults.h"
+#include "chrome/browser/meridian/test_switches.h"
 #include "chrome/browser/renderer_context_menu/render_view_context_menu.h"
 #include "chrome/browser/ui/aura/tab_contents/web_drag_bookmark_handler_aura.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
@@ -98,6 +100,19 @@ void ChromeWebContentsViewDelegateViews::ShowMenu(
     return;
   }
 
+  // Meridian's tests: the item a person would pick (by its command id), with
+  // no native menu to click.
+  if (std::string id = meridian::TestSwitchValue(
+          "meridian-test-context-menu-command");
+      !id.empty()) {
+    int command = 0;
+    if (base::StringToInt(id, &command) &&
+        context_menu_->menu_model().GetIndexOfCommandId(command)) {
+      context_menu_->ExecuteCommand(command, 0);
+    }
+    return;
+  }
+
   context_menu_->Show();
 }
 
diff --git a/chrome/browser/ui/views/tab_contents/chrome_web_contents_view_delegate_views_mac.mm b/chrome/browser/ui/views/tab_contents/chrome_web_contents_view_delegate_views_mac.mm
index c9e1734658..9bd01cb6ae 100644
--- a/chrome/browser/ui/views/tab_contents/chrome_web_contents_view_delegate_views_mac.mm
+++ b/chrome/browser/ui/views/tab_contents/chrome_web_contents_view_delegate_views_mac.mm
@@ -8,6 +8,8 @@
 #include <optional>
 
 #import "chrome/browser/renderer_host/chrome_render_widget_host_view_mac_delegate.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/meridian/test_switches.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
 #include "chrome/browser/ui/cocoa/renderer_context_menu/render_view_context_menu_mac_cocoa.h"
@@ -210,6 +212,19 @@ void ChromeWebContentsViewDelegateViewsMac::ShowMenu(
     return;
   }
 
+  // Meridian's tests: the item a person would pick (by its command id), with
+  // no native menu to click.
+  if (std::string id = meridian::TestSwitchValue(
+          "meridian-test-context-menu-command");
+      !id.empty()) {
+    int command = 0;
+    if (base::StringToInt(id, &command) &&
+        context_menu_->menu_model().GetIndexOfCommandId(command)) {
+      context_menu_->ExecuteCommand(command, 0);
+    }
+    return;
+  }
+
   context_menu_->Show();
 }
 
diff --git a/components/lens/lens_features.cc b/components/lens/lens_features.cc
index 417012736c..7808259bb1 100644
--- a/components/lens/lens_features.cc
+++ b/components/lens/lens_features.cc
@@ -20,13 +20,9 @@ BASE_FEATURE(kLensStandalone, base::FEATURE_ENABLED_BY_DEFAULT);
 
 BASE_FEATURE(kShowContextualTasksMenuIcon, base::FEATURE_ENABLED_BY_DEFAULT);
 
-BASE_FEATURE(kLensOverlay,
-#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_IOS)
-             base::FEATURE_DISABLED_BY_DEFAULT
-#else
-             base::FEATURE_ENABLED_BY_DEFAULT
-#endif
-);
+// Meridian: off. The overlay needs Chromium's own window (it crashed in
+// Meridian's on "Search Image with Google"); image search opens in a tab.
+BASE_FEATURE(kLensOverlay, base::FEATURE_DISABLED_BY_DEFAULT);
 
 BASE_FEATURE(kLensOverlayAndroid, base::FEATURE_DISABLED_BY_DEFAULT);
 
