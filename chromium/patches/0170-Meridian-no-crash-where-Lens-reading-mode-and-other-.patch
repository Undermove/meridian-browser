@@ -988,13 +991,16 @@ views::View* IndigoPageActionController::GetIndigoOverlayView() const {
 
   auto* browser_view =
       BrowserView::GetBrowserViewForBrowser(tab().GetBrowserWindowInterface());
+  // Meridian: its WebUI window may have neither; no overlay then, no crash.
