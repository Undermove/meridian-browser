diff --git a/chrome/browser/ui/lens/overlay_base_controller.cc b/chrome/browser/ui/lens/overlay_base_controller.cc
index 9eaafbc555..e421fb99e2 100644
--- a/chrome/browser/ui/lens/overlay_base_controller.cc
+++ b/chrome/browser/ui/lens/overlay_base_controller.cc
@@ -708,7 +708,15 @@ void OverlayBaseController::ShowOverlay() {
   auto* contents_web_view =
       BrowserElementsViews::From(tab_->GetBrowserWindowInterface())
           ->RetrieveView(kActiveContentsWebViewRetrievalId);
-  CHECK(contents_web_view);
+  // Meridian: its WebUI window has no Views contents container for the overlay
+  // to sit in. Close the session instead of crashing (it CHECKed here).
+  if (!contents_web_view || (!overlay_view_ && !GetHostView())) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&OverlayBaseController::RequestSyncClose,
+                                  weak_factory_.GetWeakPtr(),
+                                  DismissalSource::kErrorScreenshotCreationFailed));
+    return;
+  }
 
   NotifyIsOverlayShowing(true);
   // If the view already exists, we just need to reshow it.
@@ -777,10 +785,12 @@ void OverlayBaseController::HideOverlay(bool /*entering_background*/) {
   auto* contents_web_view =
       BrowserElementsViews::From(tab_->GetBrowserWindowInterface())
           ->RetrieveView(kActiveContentsWebViewRetrievalId);
-  CHECK(contents_web_view);
-  contents_web_view->SetEnabled(true);
-  if (tab_->IsActivated()) {
-    contents_web_view->RequestFocus();
+  // Meridian: a window without it (see ShowOverlay) is no crash.
+  if (contents_web_view) {
+    contents_web_view->SetEnabled(true);
+    if (tab_->IsActivated()) {
+      contents_web_view->RequestFocus();
+    }
   }
 
   // Hide the overlay view, but keep the web view attached to the overlay view
@@ -853,8 +863,10 @@ void OverlayBaseController::CloseUI() {
   auto* contents_web_view =
       BrowserElementsViews::From(tab_->GetBrowserWindowInterface())
           ->RetrieveView(kActiveContentsWebViewRetrievalId);
-  CHECK(contents_web_view);
