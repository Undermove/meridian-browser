From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Tue, 3 Nov 2026 21:34:28 +0400
Subject: [PATCH 82/99] Sidebar written a second after a change, not ten

A space, pin or favorite made shortly before a crash, a forced quit or a
macOS logout was lost: ImportantFileWriter waited ten seconds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/sidebar_service.cc | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/meridian/sidebar_service.cc b/chrome/browser/meridian/sidebar_service.cc
index 53747ded20..233d27c259 100644
--- a/chrome/browser/meridian/sidebar_service.cc
+++ b/chrome/browser/meridian/sidebar_service.cc
@@ -203,7 +203,10 @@ SidebarService::SidebarService(const base::FilePath& profile_path)
           {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
            base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
   base::FilePath path = profile_path.Append(kFileName);
-  writer_ = std::make_unique<base::ImportantFileWriter>(path, file_runner);
+  // A second, not ImportantFileWriter's ten: a space or a pin made just before
+  // a crash or a forced quit is kept.
+  writer_ = std::make_unique<base::ImportantFileWriter>(path, file_runner,
+                                                        base::Seconds(1));
   file_runner->PostTaskAndReplyWithResult(
       FROM_HERE, base::BindOnce(&ReadFile, path),
       base::BindOnce(&SidebarService::OnLoaded, weak_factory_.GetWeakPtr()));
