From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 23 Nov 2026 16:47:31 +0400
Subject: [PATCH 232/235] Meridian: restarting Claude from the first run leaves
 a first request ready

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../browser/meridian/sidebar_handler_mac.mm   | 32 +++++++++++++++++--
 .../webui_browser/meridian/onboarding.html.ts |  4 ++-
 2 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/meridian/sidebar_handler_mac.mm b/chrome/browser/meridian/sidebar_handler_mac.mm
index e34768d810..bcdc3cd847 100644
--- a/chrome/browser/meridian/sidebar_handler_mac.mm
+++ b/chrome/browser/meridian/sidebar_handler_mac.mm
@@ -8,6 +8,7 @@
 #include "chrome/browser/meridian/sidebar_handler.h"
 
 #include "base/command_line.h"
+#include "base/strings/escape.h"
 #include "base/strings/sys_string_conversions.h"
 #include "chrome/app/chrome_command_ids.h"
 #include "chrome/browser/meridian/test_switches.h"
@@ -29,13 +30,37 @@ namespace {
 
 constexpr int kQuitChecks = 30;  // half a second each
 
+// The first thing to try in Claude. It asks for a plan and changes nothing, so
+// pressing Enter on it is safe. Claude never sends it by itself.
+constexpr char kFirstRequest[] =
+    "Look at the tabs open in Meridian and suggest how to organize them into "
+    "folders. Show me the plan and change nothing until I say yes.";
+constexpr char kRequestReady[] =
+    "Claude Desktop restarted. Your first request is ready: press Enter, then "
+    "Allow. If the box is empty, paste it with \u2318V.";
+
+std::string FirstRequestUrl() {
+  return "claude://claude.ai/new?q=" +
+         base::EscapeQueryParamValue(kFirstRequest, /*use_plus=*/false);
+}
+
 void OpenClaude(NSURL* url, base::OnceCallback<void(bool, const std::string&)> done) {
   if (!url) {
     std::move(done).Run(false, "Open Claude to start using Meridian there.");
     return;
   }
-  [NSWorkspace.sharedWorkspace openURL:url];
-  std::move(done).Run(true, "Claude Desktop restarted.");
+  // The link isn't a documented part of Claude, so the request is on the
+  // clipboard too, in case the box comes up empty.
+  NSPasteboard* board = NSPasteboard.generalPasteboard;
+  [board clearContents];
+  [board setString:base::SysUTF8ToNSString(kFirstRequest)
+           forType:NSPasteboardTypeString];
+  NSURL* ask = [NSURL URLWithString:base::SysUTF8ToNSString(FirstRequestUrl())];
+  [NSWorkspace.sharedWorkspace openURLs:@[ ask ]
+                   withApplicationAtURL:url
+                          configuration:[NSWorkspaceOpenConfiguration configuration]
+                      completionHandler:nil];
+  std::move(done).Run(true, kRequestReady);
 }
 
 void WaitForQuit(NSRunningApplication* app,
@@ -63,7 +88,8 @@ void SidebarHandler::RestartClaudeDesktop(
     RestartClaudeDesktopCallback callback) {
   // A test never touches a real Claude.
   if (TestSwitchesAllowed()) {
-    std::move(callback).Run(true, "Claude Desktop restarted.");
+    std::move(callback).Run(
+        true, std::string(kRequestReady) + " [" + FirstRequestUrl() + "]");
     return;
   }
   NSString* bundle = @"com.anthropic.claudefordesktop";
diff --git a/chrome/browser/resources/webui_browser/meridian/onboarding.html.ts b/chrome/browser/resources/webui_browser/meridian/onboarding.html.ts
index 54004163a7..b7afa0436e 100644
--- a/chrome/browser/resources/webui_browser/meridian/onboarding.html.ts
+++ b/chrome/browser/resources/webui_browser/meridian/onboarding.html.ts
@@ -252,7 +252,9 @@ export function getHtml(this: MeridianOnboardingElement) {
       <div class="card">
         <h3>Restart Claude?</h3>
         <p>Claude will close and open again so it can use Meridian. If you have
-          unsaved work there, Claude asks first, and nothing is forced.</p>
+          unsaved work there, Claude asks first, and nothing is forced. A first
+          request will be waiting in Claude and on your clipboard. It only
+          runs if you press Enter.</p>
         <div class="card-actions">
           <button class="btn ghost"
               @click="${this.onRestartCancelClick_}">Cancel</button>
