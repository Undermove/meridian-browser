+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/project_fs.h"
+
+#include <windows.h>
+
+#include <shellapi.h>
+
+#include <string>
+
+namespace meridian::workbench {
+
+// The Recycle Bin, without Explorer's questions or progress window.
+bool MoveToTrash(const base::FilePath& path) {
+  // SHFileOperation takes a list of paths: each ends with a NUL, the list
+  // with one more.
+  std::wstring from = path.value();
+  from.push_back(L'\0');
+  SHFILEOPSTRUCTW op = {};
+  op.wFunc = FO_DELETE;
+  op.pFrom = from.c_str();
+  op.fFlags = FOF_ALLOWUNDO | FOF_NO_UI;
+  return SHFileOperationW(&op) == 0 && !op.fAnyOperationsAborted;
+}
+
+}  // namespace meridian::workbench
