@@ -0,0 +1,144 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/native_dialog.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/meridian/test_switches.h"
+#include "components/constrained_window/constrained_window_views.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/base/mojom/ui_base_types.mojom.h"
+#include "ui/base/ui_base_types.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/controls/button/md_text_button.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/box_layout_view.h"
+#include "ui/views/layout/layout_provider.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/window/dialog_delegate.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+// The answer, given once: by a button, or as the first button when the dialog
+// goes away any other way (Escape, the window closing), as the macOS alert
+// does.
+class Answer : public base::RefCounted<Answer> {
+ public:
+  explicit Answer(base::OnceCallback<void(int)> done)
+      : done_(std::move(done)) {}
+
+  // False when it was already given.
+  bool Give(int index) {
+    if (!done_) {
+      return false;
+    }
+    std::move(done_).Run(index);
+    return true;
+  }
+
+ private:
+  friend class base::RefCounted<Answer>;
+  ~Answer() = default;
+
+  base::OnceCallback<void(int)> done_;
+};
+
+}  // namespace
+
+void AskNative(content::WebContents* contents,
+               const std::string& message,
+               const std::string& detail,
+               const std::vector<std::string>& buttons,
+               base::OnceCallback<void(int)> done) {
+  // Only for a profile in the temp folder (test_switches.h).
+  if (HasTestSwitch("meridian-test-dialog-answer")) {
+    std::string answer = TestSwitchValue("meridian-test-dialog-answer");
+    int index = 0;
+    for (size_t i = 0; i < buttons.size(); ++i) {
+      if (buttons[i] == answer) {
+        index = static_cast<int>(i);
+      }
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), index));
+    return;
+  }
+  gfx::NativeWindow parent =
+      contents ? contents->GetTopLevelNativeWindow() : gfx::NativeWindow();
+  if (!parent || buttons.empty()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), 0));
+    return;
+  }
+  // Windows and Linux: the question over the browser window, a button per
+  // answer, the first one the default (as in the macOS alert).
+  auto answer = base::MakeRefCounted<Answer>(std::move(done));
+  auto delegate = std::make_unique<views::DialogDelegate>();
+  views::DialogDelegate* dialog = delegate.get();
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  dialog->SetTitle(base::UTF8ToUTF16(message));
+  dialog->SetShowCloseButton(false);
+  dialog->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  dialog->RegisterWindowClosingCallback(base::BindOnce(
+      [](scoped_refptr<Answer> answer) { answer->Give(0); }, answer));
+
+  const views::LayoutProvider* provider = views::LayoutProvider::Get();
+  dialog->set_margins(provider->GetDialogInsetsForContentType(
+      views::DialogContentType::kText, views::DialogContentType::kControl));
+  auto view = std::make_unique<views::BoxLayoutView>();
+  view->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  view->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  view->SetBetweenChildSpacing(provider->GetDistanceMetric(
+      views::DISTANCE_UNRELATED_CONTROL_VERTICAL));
+  if (!detail.empty()) {
+    auto* label = view->AddChildView(
+        std::make_unique<views::Label>(base::UTF8ToUTF16(detail)));
+    label->SetMultiLine(true);
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetMaximumWidth(provider->GetDistanceMetric(
+        views::DISTANCE_MODAL_DIALOG_PREFERRED_WIDTH));
+  }
+  auto* row = view->AddChildView(std::make_unique<views::BoxLayoutView>());
+  row->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  row->SetMainAxisAlignment(views::BoxLayout::MainAxisAlignment::kEnd);
+  row->SetBetweenChildSpacing(provider->GetDistanceMetric(
+      views::DISTANCE_RELATED_BUTTON_HORIZONTAL));
+  // The default answer sits last, where a dialog's main button is. The
+  // buttons live inside the dialog's widget, so `dialog` outlives them.
+  for (size_t i = buttons.size(); i-- > 0;) {
+    auto* button = row->AddChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(
+            [](scoped_refptr<Answer> answer, views::DialogDelegate* dialog,
+               int index) {
+              if (answer->Give(index) && dialog->GetWidget()) {
+                dialog->GetWidget()->Close();
+              }
+            },
+            answer, base::Unretained(dialog), static_cast<int>(i)),
+        base::UTF8ToUTF16(buttons[i])));
+    if (i == 0) {
+      button->SetStyle(ui::ButtonStyle::kProminent);
+      button->SetIsDefault(true);
+      dialog->SetInitiallyFocusedView(button);
+    }
+  }
+  dialog->SetContentsView(std::move(view));
+  constrained_window::CreateBrowserModalDialogViews(std::move(delegate), parent)
+      ->Show();
+}
+
+}  // namespace meridian::workbench
