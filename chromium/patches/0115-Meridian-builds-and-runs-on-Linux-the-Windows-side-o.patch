+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/project_fs.h"
+
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/process/launch.h"
+
+namespace meridian::workbench {
+
+// The desktop's own trash (the freedesktop.org one: home and per-volume
+// trash folders, restore from the file manager), through GLib's `gio`, which
+// GNOME, KDE and the other desktops Chromium runs on install. Without it
+// nothing is removed, and the caller says so.
+bool MoveToTrash(const base::FilePath& path) {
+  base::CommandLine command(base::FilePath("gio"));
+  command.AppendArg("trash");
+  command.AppendArg("--");
+  command.AppendArgPath(path);
+  std::string output;
+  int exit_code = -1;
+  return base::GetAppOutputWithExitCode(command, &output, &exit_code) &&
+         exit_code == 0;
+}
+
+}  // namespace meridian::workbench
