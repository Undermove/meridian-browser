+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/updater.h"
+
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/meridian/test_switches.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+
+// Windows and Linux: Meridian doesn't replace itself there yet. The updater
+// (updater.cc) swaps a signed Meridian.app with macOS's own tools; these
+// builds are updated by installing a newer release. Settings shows this
+// build's version and nothing to install.
+namespace meridian {
+
+// static
+Updater& Updater::Get() {
+  static base::NoDestructor<Updater> updater;
+  return *updater;
+}
+
+Updater::Updater() = default;
+Updater::~Updater() = default;
+
+void Updater::Start() {}
+
+void Updater::CheckNow() {}
+
+bool Updater::Install() {
+  return false;
+}
+
+mojom::UpdateStatePtr Updater::State() const {
+  auto state = mojom::UpdateState::New();
+  state->status = status_;
+  state->current = HasTestSwitch("meridian-test-version")
+                       ? TestSwitchValue("meridian-test-version")
+                       : std::string(update::kVersion);
+  state->progress = 0;
+  return state;
+}
+
+void Updater::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void Updater::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+}  // namespace meridian
