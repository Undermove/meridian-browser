+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/agent/mcp_result.h"
+
+#include <algorithm>
+
+namespace meridian::mcp {
+
+bool WantsTextOnly(const std::vector<std::string_view>& args, const char* env) {
+  if (std::ranges::find(args, std::string_view(kTextOnlySwitch)) !=
+      args.end()) {
+    return true;
+  }
+  return env && *env && std::string_view(env) != "0";
+}
+
+std::string NoImagesText() {
+  return "No screenshot: this connection is text-only (Meridian --mcp-bridge "
+         "--text-only), because its AI model can't take images. See the page "
+         "with read_page and get_interactive_elements instead.";
+}
+
+std::string CapText(std::string text, size_t max_bytes) {
+  if (text.size() <= max_bytes) {
+    return text;
+  }
+  const size_t total = text.size();
+  size_t cut = max_bytes;
+  // Back to the first byte of a UTF-8 character.
+  while (cut > 0 && (static_cast<unsigned char>(text[cut]) & 0xC0) == 0x80) {
+    --cut;
+  }
+  text.resize(cut);
+  text += "\n\n[Cut here: this result was " + std::to_string(total / 1000) +
+          " KB, more than one message to an AI model should carry. Ask for "
+          "less: read_page with offset and max_chars, "
+          "get_interactive_elements with query, within or only_visible.]";
+  return text;
+}
+
+}  // namespace meridian::mcp
diff --git a/chrome/browser/meridian/agent/mcp_result.h b/chrome/browser/meridian/agent/mcp_result.h
new file mode 100644
index 0000000..31bd32a
--- /dev/null
+++ b/chrome/browser/meridian/agent/mcp_result.h
@@ -0,0 +1,46 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AGENT_MCP_RESULT_H_
+#define CHROME_BROWSER_MERIDIAN_AGENT_MCP_RESULT_H_
+
+#include <cstddef>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// What `Meridian --mcp-bridge` hands an MCP client, in a shape every AI
+// provider behind it takes. The client sends each tool result on to its
+// model with the rest of the conversation, every turn: a result a provider
+// can't read fails the whole request (an OpenAI-compatible endpoint answers
+// HTTP 400), and the agent is stuck.
+namespace meridian::mcp {
+
+// The switch, and the environment variable, for a client whose model takes
+// no images (many OpenAI-compatible models): screenshots are then left out.
+inline constexpr char kTextOnlySwitch[] = "--text-only";
+inline constexpr char kTextOnlyEnv[] = "MERIDIAN_MCP_TEXT_ONLY";
+
+// The tool that answers with an image.
+inline constexpr char kScreenshotTool[] = "screenshot";
+
+// The longest text one tool result gives, in bytes (a note is added when
+// more was cut). Larger answers (a whole page's text, 400 elements of a
+// shop's page) pile up in the conversation the client sends every turn.
+inline constexpr size_t kMaxResultBytes = 100000;
+
+// Whether the bridge was started for a text-only model: `--text-only` among
+// `args`, or `env` (MERIDIAN_MCP_TEXT_ONLY) set to anything but "" or "0".
+bool WantsTextOnly(const std::vector<std::string_view>& args, const char* env);
+
+// The answer to a screenshot in text-only mode, instead of the image.
+std::string NoImagesText();
+
+// `text` cut to at most `max_bytes` (on a whole UTF-8 character), with a
+// note on how to ask for less; unchanged when it fits.
+std::string CapText(std::string text, size_t max_bytes = kMaxResultBytes);
+
+}  // namespace meridian::mcp
+
+#endif  // CHROME_BROWSER_MERIDIAN_AGENT_MCP_RESULT_H_
diff --git a/chrome/browser/meridian/agent/mcp_result_unittest.cc b/chrome/browser/meridian/agent/mcp_result_unittest.cc
new file mode 100644
index 0000000..ae18aea
--- /dev/null
+++ b/chrome/browser/meridian/agent/mcp_result_unittest.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/agent/mcp_result.h"
+
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::mcp {
+namespace {
+
+TEST(McpResultTest, TextOnlyFromTheSwitch) {
+  EXPECT_TRUE(WantsTextOnly({"Meridian", "--mcp-bridge", "--text-only"},
+                            nullptr));
+  // Gemini and Qwen put "--" before the bridge's own arguments.
+  EXPECT_TRUE(
+      WantsTextOnly({"Meridian", "--", "--mcp-bridge", "--text-only"}, ""));
+  EXPECT_FALSE(WantsTextOnly({"Meridian", "--mcp-bridge"}, nullptr));
+  EXPECT_FALSE(WantsTextOnly({"Meridian", "--mcp-bridge", "--text-only=0",
+                              "--user-data-dir=/tmp/--text-only"},
+                             nullptr));
+}
+
+TEST(McpResultTest, TextOnlyFromTheEnvironment) {
+  EXPECT_TRUE(WantsTextOnly({"Meridian", "--mcp-bridge"}, "1"));
+  EXPECT_TRUE(WantsTextOnly({"Meridian", "--mcp-bridge"}, "yes"));
+  EXPECT_FALSE(WantsTextOnly({"Meridian", "--mcp-bridge"}, "0"));
+  EXPECT_FALSE(WantsTextOnly({"Meridian", "--mcp-bridge"}, ""));
+}
+
+TEST(McpResultTest, NoImagesPointsAtTheTextTools) {
+  const std::string text = NoImagesText();
+  EXPECT_NE(text.find("read_page"), std::string::npos);
+  EXPECT_NE(text.find("get_interactive_elements"), std::string::npos);
+}
+
+TEST(McpResultTest, ShortTextIsUnchanged) {
+  EXPECT_EQ(CapText("Фильтры: до 5000 ₽", 100), "Фильтры: до 5000 ₽");
+  EXPECT_EQ(CapText(std::string(100, 'a'), 100), std::string(100, 'a'));
+  EXPECT_EQ(CapText(""), "");
+}
+
+TEST(McpResultTest, LongTextIsCutWithANote) {
+  const std::string text = CapText(std::string(250000, 'a'));
+  EXPECT_EQ(text.substr(0, kMaxResultBytes), std::string(kMaxResultBytes, 'a'));
+  EXPECT_EQ(text[kMaxResultBytes], '\n');
+  EXPECT_NE(text.find("250 KB"), std::string::npos);
+  EXPECT_NE(text.find("max_chars"), std::string::npos);
+  EXPECT_LT(text.size(), kMaxResultBytes + 400);
+}
+
+TEST(McpResultTest, ACutKeepsWholeCharacters) {
+  // "ж" is two bytes, "₽" three: a cut in the middle of one drops all of it.
+  const std::string cyrillic = CapText("жжж", 3);
+  EXPECT_EQ(cyrillic.substr(0, cyrillic.find('\n')), "ж");
+  const std::string rouble = CapText("a₽₽", 5);
+  EXPECT_EQ(rouble.substr(0, rouble.find('\n')), "a₽");
+  const std::string emoji = CapText("\xF0\x9F\x9B\x92 cart", 2);
+  EXPECT_EQ(emoji.substr(0, emoji.find('\n')), "");
+}
+
+}  // namespace
+}  // namespace meridian::mcp
