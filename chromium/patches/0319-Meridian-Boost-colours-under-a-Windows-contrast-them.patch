From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Meridian <meridian@localhost>
Date: Thu, 26 Nov 2026 15:39:41 +0400
Subject: [PATCH] Meridian: Boost colours under a Windows contrast theme: the
 pad has its rim and field, and the page takes the colour

With a Windows contrast theme (forced colours) the Boost pad lost its rim of
hues and its dotted field (forced colours drop background images), so the
knobs seemed to move over the whole card, and the colour picked never
showed: Windows put its own colours over the page.

The pad and its knobs keep their own colours (forced-color-adjust: none),
and a boost with a colour has the page keep its colours on that site
(html { forced-color-adjust: none }), so the palette paints it. Only when a
colour is picked: other sites keep the contrast theme.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/meridian/boosts/boost_service.cc          | 4 ++++
 chrome/browser/meridian/boosts/boost_service_unittest.cc | 5 +++++
 .../resources/webui_browser/meridian/boost_editor.css    | 9 ++++++++-
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/meridian/boosts/boost_service.cc b/chrome/browser/meridian/boosts/boost_service.cc
index 1d9a82ba4c..a91a21f72f 100644
--- a/chrome/browser/meridian/boosts/boost_service.cc
+++ b/chrome/browser/meridian/boosts/boost_service.cc
@@ -191,6 +191,10 @@ std::string Boost::PageCss() const {
            base::NumberToString(tint2 >= 0 ? tint2 : tint) +
            "; --meridian-boost-strength: " +
            base::NumberToString(tint_strength) + "; }";
+    // A Windows contrast theme (forced colours) puts its own colours over
+    // the page's, so the picked colour wouldn't show: on this site, which
+    // the person chose to colour, the page keeps its colours.
+    out += "\nhtml { forced-color-adjust: none !important; }";
   }
   auto adjust = [&](const char* name, int percent) {
     if (percent != 100) {
diff --git a/chrome/browser/meridian/boosts/boost_service_unittest.cc b/chrome/browser/meridian/boosts/boost_service_unittest.cc
index 0a65febad6..06686351b3 100644
--- a/chrome/browser/meridian/boosts/boost_service_unittest.cc
+++ b/chrome/browser/meridian/boosts/boost_service_unittest.cc
@@ -82,6 +82,11 @@ TEST(BoostServiceTest, PageCssHasTintDarkSizeAndCase) {
   EXPECT_NE(css.find("--meridian-boost-tint: 30; --meridian-boost-tint2: 30; "
                      "--meridian-boost-strength: 50;"),
             std::string::npos);
+  // Its colours show under a Windows contrast theme too.
+  EXPECT_NE(css.find("html { forced-color-adjust: none !important; }"),
+            std::string::npos);
+  EXPECT_EQ(Make("example.com", "").PageCss().find("forced-color-adjust"),
+            std::string::npos);
   EXPECT_EQ(css.find("--meridian-boost-turn"), std::string::npos);
   EXPECT_EQ(css.find("html::before"), std::string::npos);
   EXPECT_EQ(css.find("mix-blend-mode"), std::string::npos);
diff --git a/chrome/browser/resources/webui_browser/meridian/boost_editor.css b/chrome/browser/resources/webui_browser/meridian/boost_editor.css
index 5ac25d03d4..c35a242ef3 100644
--- a/chrome/browser/resources/webui_browser/meridian/boost_editor.css
+++ b/chrome/browser/resources/webui_browser/meridian/boost_editor.css
@@ -141,7 +141,14 @@ svg {
 }
 
 /* As Arc's: a rim of the hues (red at the top, clockwise) around a dotted
- * field, tinted where the knob is. */
+ * field, tinted where the knob is. Its own colours also under a Windows
+ * contrast theme (forced colours), which would take the rim and the field
+ * away and leave the knobs over nothing. */
+.pad,
+.pad * {
+  forced-color-adjust: none;
+}
+
 .pad {
   position: relative;
   aspect-ratio: 1 / 0.92;
-- 
