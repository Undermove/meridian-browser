From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Fri, 30 Oct 2026 15:51:39 +0400
Subject: [PATCH 58/59] Meridian 0.5.6; the profile window swap brings an
 inactive app's window forward

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/profile_windows.cc | 3 +++
 chrome/browser/meridian/update_check.h     | 2 +-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/meridian/profile_windows.cc b/chrome/browser/meridian/profile_windows.cc
index f6454fe1eb..05ba6e35ce 100644
--- a/chrome/browser/meridian/profile_windows.cc
+++ b/chrome/browser/meridian/profile_windows.cc
@@ -167,6 +167,9 @@ void SwapSoon(int frame,
             if (!in_frame(target) || f.visible_of[frame] != target) {
               return;
             }
+            // Show() too: Activate() alone doesn't bring an inactive app's
+            // window forward.
+            target->GetWindow()->Show();
             target->GetWindow()->Activate();
             if (current && in_frame(current)) {
               current->GetWindow()->Hide();
diff --git a/chrome/browser/meridian/update_check.h b/chrome/browser/meridian/update_check.h
index b00f82f907..bbbf0539f4 100644
--- a/chrome/browser/meridian/update_check.h
+++ b/chrome/browser/meridian/update_check.h
@@ -17,7 +17,7 @@
 namespace meridian::update {
 
 // This build's version (the release tag without "v").
-inline constexpr char kVersion[] = "0.5.5";
+inline constexpr char kVersion[] = "0.5.6";
 
 // GitHub's latest release of Meridian.
 inline constexpr char kFeed[] =
