+  // Its rows render after the page (their own updates, still before the
+  // frame paints): until then the list is too short to be scrolled there.
+  private async restoreScroll_(spaceId: string) {
+    const page = this.shadowRoot.getElementById('spacePage');
+    if (!page) {
+      return;
+    }
+    const want = this.scrollOf_.get(spaceId) ?? 0;
+    page.scrollTop = want;
+    const rows = [...page.querySelectorAll<HTMLElement&{updateComplete: Promise<unknown>}>(
+        'meridian-tab-row, meridian-item')];
+    await Promise.all(rows.map(r => r.updateComplete));
+    if (this.shownSpaceId_ === spaceId) {
+      page.scrollTop = want;
+      this.scrollOf_.set(spaceId, want);
+    }
+  }
+
+  protected onPageScroll_(e: Event) {
+    if (this.shownSpaceId_) {
+      this.scrollOf_.set(this.shownSpaceId_, (e.target as HTMLElement).scrollTop);
+    }
+  }
