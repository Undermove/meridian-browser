+  // A feature picked in the command bar (its FEATURES id).
+  protected onCommandBarFeature_(e: CustomEvent<string>) {
+    const run = (command: Command) => this.$.tabstrip.runCommand(command, 0);
+    switch (e.detail) {
+      case 'workbench':
+        run(Command.kWorkbench);
+        break;
+      case 'mission':
+        run(Command.kMission);
+        break;
+      case 'chat':
+        run(Command.kChat);
+        break;
+      case 'ask':
+        run(Command.kAsk);
+        break;
+      case 'new-space':
+        this.$.tabstrip.addSpace();
+        break;
+      case 'theme': {
+        const space = this.$.tabstrip.activeSpace();
+        if (space) {
+          this.$.themeEditor.show(space);
+        }
+        break;
+      }
+      case 'archive':
+        run(Command.kShowArchive);
+        break;
+      case 'downloads':
+        run(Command.kDownloads);
+        break;
+      case 'history':
+        this.$.tabstrip.openUrl('chrome://history/');
+        break;
+      case 'sidebar':
+        this.onMeridianToggleSidebar_();
+        break;
+      case 'settings':
+        run(Command.kShowSettings);
+        break;
+      case 'extensions':
+        this.$.tabstrip.openUrl('chrome://extensions/');
+        break;
+      case 'passwords':
+        this.$.tabstrip.openUrl('chrome://password-manager/');
+        break;
+      case 'import-arc':
+        run(Command.kImportArc);
+        break;
+    }
+  }
+
   protected onCopyLinkClick_(e: Event) {
     e.stopPropagation();
     this.$.tabstrip.copyLink();
