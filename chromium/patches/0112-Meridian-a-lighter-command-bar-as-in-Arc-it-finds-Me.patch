+// One of Meridian's own features, found by its name or a word for it
+// ("workspace": the Workbench), like Arc's commands in its command bar.
+export interface CommandBarFeature {
+  id: string;
+  name: string;
+  hint: string;
+  keys: string;
+  icon: IconName;
+  words: string[];
+}
+
+export const FEATURES: CommandBarFeature[] = [
+  {id: 'workbench', name: 'Workbench', hint: 'Files, editor and terminals',
+   keys: '⇧⌘E', icon: 'code',
+   words: ['workspace', 'ide', 'editor', 'terminal', 'code', 'files',
+           'claude code', 'codex', 'project']},
+  {id: 'mission', name: 'Mission Control', hint: 'Agents at work',
+   keys: '⇧⌘M', icon: 'agents', words: ['agents', 'mcp', 'tasks']},
+  {id: 'chat', name: 'Chat', hint: 'Talk to Claude', keys: '⌥⌘J',
+   icon: 'chat', words: ['ai', 'claude', 'assistant']},
+  {id: 'ask', name: 'Ask About This Page', hint: 'Claude reads the page',
+   keys: '⌘J', icon: 'sparkles', words: ['ai', 'claude', 'summarize']},
+  {id: 'new-space', name: 'New Space', hint: '', keys: '', icon: 'layers',
+   words: ['space', 'workspace', 'profile']},
+  {id: 'theme', name: 'Edit Space Theme', hint: '', keys: '',
+   icon: 'palette', words: ['theme', 'colour', 'color', 'gradient']},
+  {id: 'archive', name: 'Archive', hint: 'Closed tabs', keys: '⌥⌘A',
+   icon: 'archive', words: ['closed tabs', 'reopen']},
+  {id: 'downloads', name: 'Downloads', hint: '', keys: '⇧⌘J',
+   icon: 'download', words: ['files']},
+  {id: 'history', name: 'History', hint: '', keys: '⌘Y', icon: 'history',
+   words: ['visited']},
+  {id: 'sidebar', name: 'Hide or Show Sidebar', hint: '', keys: '⌘S',
+   icon: 'sidebar', words: ['toggle sidebar']},
+  {id: 'settings', name: 'Settings', hint: '', keys: '⌘,', icon: 'settings',
+   words: ['preferences', 'options', 'config']},
+  {id: 'extensions', name: 'Extensions', hint: '', keys: '', icon: 'puzzle',
+   words: ['add-ons', 'plugins']},
+  {id: 'passwords', name: 'Passwords', hint: '', keys: '', icon: 'lock',
+   words: ['logins', 'keychain']},
+  {id: 'import-arc', name: 'Import from Arc', hint: '', keys: '',
+   icon: 'restore', words: ['arc', 'move in']},
+];
+
+// How well `q` names a feature: 2 a word of its name or a word for it starts
+// with it, 1 its name or a word for it contains it, 0 not at all.
+export function featureMatch(f: CommandBarFeature, q: string): number {
+  if (q.length < 2) {
+    return 0;
+  }
+  const names = [f.name.toLowerCase(), ...f.words];
+  if (names.some(n => n.split(/[\s-]+/).some(w => w.startsWith(q)) ||
+                      n.startsWith(q))) {
+    return 2;
+  }
+  return names.some(n => n.includes(q)) ? 1 : 0;
+}
