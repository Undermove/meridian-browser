@@ -252,6 +390,21 @@ std::vector<AgentCli> DetectAgentClis() {
   out.push_back({kDesktopId, "Claude Desktop",
                  DesktopInstalled() ? DesktopConfig().AsUTF8Unsafe() : "",
                  DesktopCommand(), DisplayPath(DesktopConfig())});
+  // Found: on the PATH, or it made its config folder. A test sees its
+  // fixture or nothing: never the person's real OpenCode.
+  std::string opencode;
+  base::FilePath opencode_dir;
+  if (!OpenCodeTestWithoutConfig()) {
+    opencode_dir = OpenCodeDir();
+    opencode = Which(kOpenCodeId, path);
+    if (opencode.empty() && base::DirectoryExists(opencode_dir)) {
+      opencode = opencode_dir.AsUTF8Unsafe();
+    }
+  }
+  out.push_back({kOpenCodeId, "OpenCode", opencode, OpenCodeCommand(Program()),
+                 opencode_dir.empty()
+                     ? std::string("~/.config/opencode/opencode.json")
+                     : DisplayPath(opencode_dir.AppendASCII("opencode.json"))});
   return out;
 }
 
