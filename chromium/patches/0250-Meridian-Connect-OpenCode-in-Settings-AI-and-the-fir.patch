index a3a9104d74..ed8e9853c4 100644
--- a/chrome/browser/meridian/agent/agent_cli.cc
+++ b/chrome/browser/meridian/agent/agent_cli.cc
@@ -241,8 +241,146 @@ bool ConnectDesktop(std::string* output) {
   return true;
 }
 
+// ---- OpenCode
+
+constexpr char kOpenCodeId[] = "opencode";
+
+std::string Program() {
+  return base::CommandLine::ForCurrentProcess()->GetProgram().AsUTF8Unsafe();
+}
+
+// A variable as the person's terminal has it (apps started from the Dock
+// don't inherit their shell's environment).
+std::string LoginVar(const char* name) {
+  std::string out;
+#if !BUILDFLAG(IS_WIN)
+  base::GetAppOutput(
+      base::CommandLine({Shell(), "-lc",
+                         std::string("printf '%s' \"$") + name + "\""}),
+      &out);
+#endif
+  if (out.empty()) {
+    out = base::Environment::Create()->GetVar(std::string(name)).value_or("");
+  }
+  return out;
+}
+
+// Where OpenCode reads its global config.
+base::FilePath OpenCodeDir() {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  if (cl->HasSwitch(kOpenCodeConfigSwitch)) {
+    return cl->GetSwitchValuePath(kOpenCodeConfigSwitch);
+  }
+  const std::string xdg = LoginVar("XDG_CONFIG_HOME");
+  if (!xdg.empty()) {
+    return base::FilePath::FromUTF8Unsafe(xdg).AppendASCII("opencode");
+  }
+  return base::GetHomeDir().AppendASCII(".config").AppendASCII("opencode");
+}
+
+bool OpenCodeTestWithoutConfig() {
+  return TestSwitchesAllowed() &&
+         !base::CommandLine::ForCurrentProcess()->HasSwitch(
+             kOpenCodeConfigSwitch);
+}
+
+base::DictValue OpenCodeServer(const std::string& program) {
+  return base::DictValue()
+      .Set("type", "local")
+      .Set("command", base::ListValue().Append(program).Append("--mcp-bridge"))
+      .Set("enabled", true);
+}
+
+// What Connect adds, the way the file will read.
+std::string OpenCodeCommand(const std::string& program) {
+  std::string quoted;
+  base::JSONWriter::Write(base::Value(program), &quoted);
+  return "\"mcp\": {\n  \"meridian\": {\n    \"type\": \"local\",\n"
+         "    \"command\": [" +
+         quoted +
+         ", \"--mcp-bridge\"],\n    \"enabled\": true\n  }\n}";
+}
+
 }  // namespace
 
+bool AddOpenCodeServer(const base::FilePath& dir,
+                       const std::string& program,
+                       std::string* output) {
+  base::FilePath config = dir.AppendASCII("opencode.json");
+  // Kept in a dotfiles repository and linked here: write where it really is.
+  if (base::IsLink(config)) {
+    base::FilePath real = base::MakeAbsoluteFilePath(config);
+    if (real.empty()) {
+      *output = config.AsUTF8Unsafe() + " links to a file that isn\u2019t "
+                "there; nothing was changed";
+      return false;
+    }
+    config = real;
+  }
+  const std::string by_hand = "Add this to it yourself:\n" +
+                              OpenCodeCommand(program);
+  base::DictValue root;
+  const bool existed = base::PathExists(config);
+  if (existed) {
+    std::string text;
+    if (!base::ReadFileToString(config, &text)) {
+      *output = "couldn\u2019t read " + config.AsUTF8Unsafe();
+      return false;
+    }
+    if (!base::TrimWhitespaceASCII(text, base::TRIM_ALL).empty()) {
+      // Plain JSON only: comments would be lost on the way back.
+      std::optional<base::DictValue> parsed =
+          base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+      if (!parsed) {
+        *output = config.AsUTF8Unsafe() +
+                  " isn\u2019t plain JSON (comments?), so Meridian left it "
+                  "as it is. " + by_hand;
+        return false;
+      }
+      root = std::move(*parsed);
+    }
+  } else {
+    root.Set("$schema", "https://opencode.ai/config.json");
+  }
+  base::Value* mcp = root.Find("mcp");
+  if (mcp && !mcp->is_dict()) {
+    *output = "\"mcp\" in " + config.AsUTF8Unsafe() +
+              " isn\u2019t an object; nothing was changed. " + by_hand;
+    return false;
+  }
+  base::DictValue server = OpenCodeServer(program);
+  if (mcp) {
+    const base::DictValue* current = mcp->GetDict().FindDict("meridian");
+    if (current && *current == server) {
+      *output = "already connected";
+      return true;
+    }
+  }
+  const base::FilePath backup = config.AddExtensionASCII("meridian-backup");
+  const bool back_up = existed && !base::PathExists(backup);
+  if (back_up && !base::CopyFile(config, backup)) {
+    *output = "couldn\u2019t back up " + config.AsUTF8Unsafe();
+    return false;
+  }
+  if (!mcp) {
+    mcp = root.Set("mcp", base::DictValue());
+  }
+  mcp->GetDict().Set("meridian", std::move(server));
+  std::string json;
+  base::JSONWriter::WriteWithOptions(
+      root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json);
+  if (!base::CreateDirectory(config.DirName()) ||
+      !base::ImportantFileWriter::WriteFileAtomically(config, json)) {
+    *output = "couldn\u2019t write " + config.AsUTF8Unsafe();
+    return false;
+  }
+  *output = !existed ? "a new config file"
+            : back_up ? "the old file is saved as " +
+                            backup.BaseName().AsUTF8Unsafe()
+                      : "updated " + config.BaseName().AsUTF8Unsafe();
+  return true;
+}
