 inline constexpr char kClaudeDesktopConfigSwitch[] =
     "meridian-claude-desktop-config";
 
+// OpenCode merges opencode.json and opencode.jsonc from its config folder
+// ($XDG_CONFIG_HOME/opencode, else ~/.config/opencode). Connect adds
+// "meridian" to the "mcp" of opencode.json only, the same way; opencode.jsonc,
+// where people keep their models (with comments), is never touched. The
+// switch is the config folder (tests).
+inline constexpr char kOpenCodeConfigSwitch[] = "meridian-opencode-config";
+
+// Adds `program --mcp-bridge` as "meridian" to `dir`/opencode.json, creating
+// it if needed. A file that isn't plain JSON is left alone and `output` says
+// what to add by hand. Same command already there counts as connected.
+bool AddOpenCodeServer(const base::FilePath& dir,
+                       const std::string& program,
+                       std::string* output);
+
 // Runs the CLI's "mcp add"; `output` is what it printed. Already registered
 // counts as connected.
 bool ConnectAgentCli(const std::string& id, std::string* output);
diff --git a/chrome/browser/meridian/agent/agent_cli_unittest.cc b/chrome/browser/meridian/agent/agent_cli_unittest.cc
new file mode 100644
index 0000000000..8a13740a48
--- /dev/null
+++ b/chrome/browser/meridian/agent/agent_cli_unittest.cc
@@ -0,0 +1,160 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/agent/agent_cli.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+constexpr char kProgram[] = "/Applications/Meridian.app/Contents/MacOS/Meridian";
+
+base::DictValue ReadConfig(const base::FilePath& file) {
+  std::string text;
+  EXPECT_TRUE(base::ReadFileToString(file, &text));
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+  EXPECT_TRUE(dict) << text;
+  return dict ? std::move(*dict) : base::DictValue();
+}
+
+void ExpectMeridian(const base::DictValue& root,
+                    const std::string& program = kProgram) {
+  const base::DictValue* server = root.FindDictByDottedPath("mcp.meridian");
+  ASSERT_TRUE(server);
+  EXPECT_EQ(*server->FindString("type"), "local");
+  EXPECT_EQ(server->FindBool("enabled"), true);
+  const base::ListValue* command = server->FindList("command");
+  ASSERT_TRUE(command);
+  ASSERT_EQ(command->size(), 2u);
+  EXPECT_EQ((*command)[0].GetString(), program);
+  EXPECT_EQ((*command)[1].GetString(), "--mcp-bridge");
+}
+
+class OpenCodeConnectTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_.CreateUniqueTempDir());
+    dir_ = temp_.GetPath().AppendASCII("opencode");
+  }
+  base::FilePath json() const { return dir_.AppendASCII("opencode.json"); }
+  base::FilePath jsonc() const { return dir_.AppendASCII("opencode.jsonc"); }
+  base::FilePath backup() const {
+    return dir_.AppendASCII("opencode.json.meridian-backup");
+  }
+
+  base::ScopedTempDir temp_;
+  base::FilePath dir_;
+};
+
+TEST_F(OpenCodeConnectTest, CreatesFolderAndFileWithSchema) {
+  std::string output;
+  ASSERT_TRUE(AddOpenCodeServer(dir_, kProgram, &output)) << output;
+  base::DictValue root = ReadConfig(json());
+  EXPECT_EQ(*root.FindString("$schema"), "https://opencode.ai/config.json");
+  ExpectMeridian(root);
+  EXPECT_FALSE(base::PathExists(backup()));
+  EXPECT_FALSE(base::PathExists(jsonc()));
+}
+
+TEST_F(OpenCodeConnectTest, MergesIntoExistingJsonAndKeepsABackup) {
+  ASSERT_TRUE(base::CreateDirectory(dir_));
+  const std::string before =
+      R"({"model": "anthropic/claude-sonnet-4-5", "theme": "tokyonight",
+          "mcp": {"files": {"type": "local", "command": ["npx", "fs"]}}})";
+  ASSERT_TRUE(base::WriteFile(json(), before));
+  std::string output;
+  ASSERT_TRUE(AddOpenCodeServer(dir_, kProgram, &output)) << output;
+  base::DictValue root = ReadConfig(json());
+  EXPECT_EQ(*root.FindString("model"), "anthropic/claude-sonnet-4-5");
+  EXPECT_EQ(*root.FindString("theme"), "tokyonight");
+  EXPECT_TRUE(root.FindDictByDottedPath("mcp.files"));
+  EXPECT_FALSE(root.FindString("$schema")) << "an existing file is not added to";
+  ExpectMeridian(root);
+  std::string saved;
+  ASSERT_TRUE(base::ReadFileToString(backup(), &saved));
+  EXPECT_EQ(saved, before);
+  EXPECT_NE(output.find("opencode.json.meridian-backup"), std::string::npos);
+}
+
+TEST_F(OpenCodeConnectTest, IdempotentAndUpdatesAnOldCommand) {
+  std::string output;
+  ASSERT_TRUE(AddOpenCodeServer(dir_, kProgram, &output));
+  std::string first;
+  ASSERT_TRUE(base::ReadFileToString(json(), &first));
+  ASSERT_TRUE(AddOpenCodeServer(dir_, kProgram, &output));
+  EXPECT_EQ(output, "already connected");
+  std::string second;
+  ASSERT_TRUE(base::ReadFileToString(json(), &second));
+  EXPECT_EQ(first, second);
+  EXPECT_FALSE(base::PathExists(backup())) << "nothing was rewritten";
+
+  // Meridian moved: the entry follows it; the first backup is kept.
+  ASSERT_TRUE(AddOpenCodeServer(dir_, "/Users/x/Applications/Meridian", &output))
+      << output;
+  ExpectMeridian(ReadConfig(json()), "/Users/x/Applications/Meridian");
+  std::string saved;
+  ASSERT_TRUE(base::ReadFileToString(backup(), &saved));
+  EXPECT_EQ(saved, first);
+  ASSERT_TRUE(AddOpenCodeServer(dir_, kProgram, &output));
+  ASSERT_TRUE(base::ReadFileToString(backup(), &saved));
+  EXPECT_EQ(saved, first) << "only the first backup is kept";
+}
+
+TEST_F(OpenCodeConnectTest, RefusesCommentedJsonAndSaysWhatToAdd) {
+  ASSERT_TRUE(base::CreateDirectory(dir_));
+  const std::string before =
+      "{\n  // my model\n  \"model\": \"openai/gpt-5\"\n}\n";
+  ASSERT_TRUE(base::WriteFile(json(), before));
+  std::string output;
+  EXPECT_FALSE(AddOpenCodeServer(dir_, kProgram, &output));
+  EXPECT_NE(output.find("isn’t plain JSON"), std::string::npos) << output;
+  EXPECT_NE(output.find("\"meridian\""), std::string::npos) << output;
+  EXPECT_NE(output.find("--mcp-bridge"), std::string::npos) << output;
+  std::string after;
+  ASSERT_TRUE(base::ReadFileToString(json(), &after));
+  EXPECT_EQ(after, before);
+  EXPECT_FALSE(base::PathExists(backup()));
+}
+
+TEST_F(OpenCodeConnectTest, RefusesMcpThatIsNotAnObject) {
+  ASSERT_TRUE(base::CreateDirectory(dir_));
+  ASSERT_TRUE(base::WriteFile(json(), R"({"mcp": []})"));
+  std::string output;
+  EXPECT_FALSE(AddOpenCodeServer(dir_, kProgram, &output));
+  std::string after;
+  ASSERT_TRUE(base::ReadFileToString(json(), &after));
+  EXPECT_EQ(after, R"({"mcp": []})");
+}
+
+TEST_F(OpenCodeConnectTest, NeverTouchesJsonc) {
+  ASSERT_TRUE(base::CreateDirectory(dir_));
+  const std::string models =
+      "{\n  // keys live elsewhere\n  \"model\": \"anthropic/claude\",\n}\n";
+  ASSERT_TRUE(base::WriteFile(jsonc(), models));
+  std::string output;
+  ASSERT_TRUE(AddOpenCodeServer(dir_, kProgram, &output)) << output;
+  ASSERT_TRUE(AddOpenCodeServer(dir_, kProgram, &output)) << output;
+  std::string after;
+  ASSERT_TRUE(base::ReadFileToString(jsonc(), &after));
+  EXPECT_EQ(after, models);
+  ExpectMeridian(ReadConfig(json()));
+  EXPECT_FALSE(ReadConfig(json()).FindString("model"));
+}
+
+TEST_F(OpenCodeConnectTest, EmptyFileCountsAsNone) {
+  ASSERT_TRUE(base::CreateDirectory(dir_));
+  ASSERT_TRUE(base::WriteFile(json(), "  \n"));
+  std::string output;
+  ASSERT_TRUE(AddOpenCodeServer(dir_, kProgram, &output)) << output;
+  ExpectMeridian(ReadConfig(json()));
+}
+
+}  // namespace
+}  // namespace meridian
