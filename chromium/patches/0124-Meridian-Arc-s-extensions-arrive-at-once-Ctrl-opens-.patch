From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Sun, 15 Nov 2026 16:36:03 +0400
Subject: [PATCH 125/202] Meridian: Arc's extensions arrive at once; Ctrl+,
 opens Meridian's Settings
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Arc's extensions were queued and then waited for hours on Windows. After
queueing them Meridian asked for an update check "soon", which is dropped
while a check of everything is under way, and the browser starts one of its
own right after it opens (an extension another program put in the Windows
registry is enough). It now asks the updater for exactly those extensions,
to be installed at once.

Off macOS the Options command (Ctrl+,) opened Chromium's settings page. It
opens Meridian's Settings panel, as ⌘, does on macOS from the app menu.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 chrome/browser/meridian/sidebar_handler.cc     | 18 +++++++++++++++---
 .../browser/ui/browser_command_controller.cc   |  8 ++++++++
 2 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index 19371e7c12..250bd46346 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -72,6 +72,7 @@
 #include "chrome/browser/meridian/tab_data.h"
 #include "chrome/browser/meridian/site_control.h"
 #include "chrome/browser/extensions/extension_service.h"
+#include "chrome/browser/extensions/updater/extension_updater.h"
 #include "extensions/browser/disable_reason.h"
 #include "extensions/browser/extension_prefs.h"
 #include "extensions/browser/extension_registrar.h"
@@ -2794,10 +2795,21 @@ void SidebarHandler::OnArcExtensionsRead(std::vector<ArcExtension> found) {
     }
   }
   for (auto& [profile, ids] : added) {
+    // Asked for by name, now. "Check for updates soon" is dropped while a
+    // check of everything is under way, and the browser starts one of its own
+    // right after it opens (on Windows an extension another program put in
+    // the registry is enough for that): Arc's extensions then waited for the
+    // next scheduled check, hours later.
+    extensions::ExtensionUpdater* updater =
+        extensions::ExtensionUpdater::Get(profile);
+    if (updater && updater->enabled()) {
+      extensions::ExtensionUpdater::CheckParams params;
+      params.ids.assign(ids.begin(), ids.end());
+      params.install_immediately = true;
+      params.fetch_priority = extensions::DownloadFetchPriority::kForeground;
+      updater->CheckNow(std::move(params));
+    }
     new ArcExtensionsArrival(profile, std::move(ids));
-    extensions::ExtensionSystem::Get(profile)
-        ->extension_service()
-        ->CheckForUpdatesSoon();
   }
   if (!now_done.empty()) {
     ScopedListPrefUpdate update(prefs, prefs::kArcExtensionsAdded);
diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index 2584c76738..c8d5184a92 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -1386,6 +1386,14 @@ void BrowserCommandController::HandleCommandWithDisposition(
                           chrome::kPerformanceSubPage);
       break;
     case IDC_OPTIONS:
+#if !BUILDFLAG(IS_MAC)
+      // Meridian: Settings is Meridian's own panel, as on macOS, where ⌘,
+      // reaches it from the app menu (app_controller_mac.mm). Chromium's
+      // settings pages are opened from there.
+      if (meridian::SidebarHandler::ShowSettings(browser_)) {
+        break;
+      }
+#endif
       ShowSettings(webui::GetBrowserForOpeningWebUi(browser_));
       break;
     case IDC_EDIT_SEARCH_ENGINES:
