diff --git a/chrome/browser/meridian/status_bubble.cc b/chrome/browser/meridian/status_bubble.cc
new file mode 100644
index 0000000000..51df447298
--- /dev/null
+++ b/chrome/browser/meridian/status_bubble.cc
@@ -0,0 +1,55 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/status_bubble.h"
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/meridian/sidebar_handler.h"
+#include "components/url_formatter/url_formatter.h"
+
+namespace meridian {
+
+StatusBubble::StatusBubble(BrowserWindowInterface* browser)
+    : browser_(browser) {}
+
+StatusBubble::~StatusBubble() = default;
+
+void StatusBubble::SetStatus(const std::u16string& status) {
+  status_ = status;
+  Show();
+}
+
+void StatusBubble::SetURL(const GURL& url) {
+  url_text_ = url.is_empty() ? std::u16string()
+                             : url_formatter::FormatUrl(
+                                   url, url_formatter::kFormatUrlOmitDefaults,
+                                   base::UnescapeRule::SPACES, nullptr,
+                                   nullptr, nullptr);
+  Show();
+}
+
+void StatusBubble::Hide() {
+  status_.clear();
+  url_text_.clear();
+  Show();
+}
+
+void StatusBubble::MouseMoved(bool left_content) {
+  if (left_content) {
+    url_text_.clear();
+    Show();
+  }
+}
+
+void StatusBubble::Show() {
+  // A hovered link wins over the page's status text, like Chrome.
+  const std::u16string& text = url_text_.empty() ? status_ : url_text_;
+  if (text == shown_) {
+    return;
+  }
+  shown_ = text;
+  SidebarHandler::SetStatusText(browser_, base::UTF16ToUTF8(text));
+}
+
+}  // namespace meridian
diff --git a/chrome/browser/meridian/status_bubble.h b/chrome/browser/meridian/status_bubble.h
new file mode 100644
index 0000000000..82045ebc35
--- /dev/null
+++ b/chrome/browser/meridian/status_bubble.h
@@ -0,0 +1,44 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_STATUS_BUBBLE_H_
+#define CHROME_BROWSER_MERIDIAN_STATUS_BUBBLE_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/status_bubble.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+
+namespace meridian {
+
+// The link-hover / status text at the bottom of the page, drawn by the
+// Meridian UI (the WebUI browser has no views status bubble).
+class StatusBubble : public ::StatusBubble {
+ public:
+  explicit StatusBubble(BrowserWindowInterface* browser);
+  StatusBubble(const StatusBubble&) = delete;
+  StatusBubble& operator=(const StatusBubble&) = delete;
+  ~StatusBubble() override;
+
+  // ::StatusBubble:
+  void SetStatus(const std::u16string& status) override;
+  void SetURL(const GURL& url) override;
+  void Hide() override;
+  void MouseMoved(bool left_content) override;
+
+ private:
+  void Show();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  std::u16string status_;
+  std::u16string url_text_;
+  std::u16string shown_;
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_STATUS_BUBBLE_H_
