   display: flex;
@@ -307,3 +308,26 @@ cr-icon-button[hidden] {
 :host([sidebar-hidden]:not([sidebar-peek])) #sidebar {
   pointer-events: none;
 }
+
+/* The hovered link's address, bottom left of the page (status bubble). */
+#statusBubble {
+  position: absolute;
+  left: calc(var(--meridian-gap) + 6px);
+  bottom: calc(var(--meridian-gap) + 6px);
+  max-width: 60%;
+  padding: 3px 8px;
+  border-radius: 6px;
+  background: color-mix(in srgb, var(--meridian-surface) 92%, transparent);
+  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18), 0 0 0 0.5px var(--meridian-border);
+  color: var(--meridian-text);
+  font-size: 12px;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  pointer-events: none;
+  z-index: 10;
+}
+
+#statusBubble[hidden] {
+  display: none;
+}
