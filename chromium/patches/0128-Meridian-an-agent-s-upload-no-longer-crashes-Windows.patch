From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Sun, 15 Nov 2026 18:51:16 +0400
Subject: [PATCH 129/202] Meridian: an agent's upload no longer crashes Windows

upload_file asked the person with a message built from call->client while
the same call's last argument moved `call` into the answer's callback. The
order a function's arguments are evaluated in isn't fixed: a Mac build read
the name first, a Windows build moved first and crashed the browser on the
null pointer. The name is now read before the call.

The same in the Workbench's sandbox start: the Mission Control token was
read beside std::move(registration), so a Windows build handed the sandbox
an empty token.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 chrome/browser/meridian/agent/agent_service.cc         | 10 +++++++---
 chrome/browser/meridian/workbench/workbench_handler.cc |  6 +++++-
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/meridian/agent/agent_service.cc b/chrome/browser/meridian/agent/agent_service.cc
index ca84106986..aac6c5c8b0 100644
--- a/chrome/browser/meridian/agent/agent_service.cc
+++ b/chrome/browser/meridian/agent/agent_service.cc
@@ -1973,14 +1973,18 @@ void AgentService::UploadChecked(
                           " KB";
             content::WebContents* contents = tab->GetContents();
             std::string host(contents->GetLastCommittedURL().host());
+            // Read before the call below moves `call` away: the order a
+            // function's arguments are worked out in isn't fixed (Windows
+            // does the last one first).
+            std::string who =
+                call->client.empty() ? std::string("An agent") : call->client;
             // Always asked, whatever the access level: a local file leaves
             // the computer.
             workbench::AskNative(
                 contents,
                 "Upload a file from your computer to " + host + "?",
-                (call->client.empty() ? std::string("An agent") : call->client) +
-                    " wants to upload:\n" + real.AsUTF8Unsafe() + "\nSize: " + mb +
-                    "\nInto: “" + label + "”",
+                who + " wants to upload:\n" + real.AsUTF8Unsafe() +
+                    "\nSize: " + mb + "\nInto: “" + label + "”",
                 {"Don’t upload", "Upload this file"},
                 base::BindOnce(
                     [](base::WeakPtr<AgentService> self,
diff --git a/chrome/browser/meridian/workbench/workbench_handler.cc b/chrome/browser/meridian/workbench/workbench_handler.cc
index 1acf09b684..c00cc34401 100644
--- a/chrome/browser/meridian/workbench/workbench_handler.cc
+++ b/chrome/browser/meridian/workbench/workbench_handler.cc
@@ -2231,6 +2231,10 @@ void WorkbenchHandler::CreateSandbox(std::string kind,
   // Counted from now (a container may start), on the profile's sandbox
   // sequence: no review settles this root's baseline away meanwhile.
   workbench->SandboxStarting(root);
+  // Read before the call below moves `registration` away: the order a
+  // function's arguments are worked out in isn't fixed (Windows does the
+  // last one first).
+  std::string mission_token = registration.token;
   workbench->sandbox_files()->PostTaskAndReplyWithResult(
       FROM_HERE,
       base::BindOnce(
@@ -2267,7 +2271,7 @@ void WorkbenchHandler::CreateSandbox(std::string kind,
                         docker ? *docker : std::string()};
           },
           kind, root, std::move(secrets), forbidden, StorePath(),
-          ReviewPath(profile_), registration.token, std::move(claude_settings)),
+          ReviewPath(profile_), mission_token, std::move(claude_settings)),
       base::BindOnce(
           [](base::WeakPtr<WorkbenchHandler> self,
              base::WeakPtr<WorkbenchService> service, std::string root,
