+// Claude Code switched to another model mid-session: the cache is per model,
+// so the next request writes everything again. Named only when the model
+// really changed; a collapse with the same model stays unexplained.
+TEST(AgentInsightsTest, ClaudeModelSwitchWritesTheCacheAgain) {
+  ContextInsights ci;
+  int n = 0;
+  auto req = [&](int s, const char* model, int read, int write) {
+    ++n;
+    ci.Feed(base::StringPrintf(
+        R"({"type":"assistant","requestId":"r%d","timestamp":"%s",)"
+        R"("message":{"id":"m%d","model":"%s","role":"assistant",)"
+        R"("content":[],"usage":{"input_tokens":5,)"
+        R"("cache_creation_input_tokens":%d,"cache_read_input_tokens":%d,)"
+        R"("output_tokens":100}}})",
+        n, Iso(T(s)).c_str(), n, model, write, read));
+  };
+  ci.Feed(base::StringPrintf(
+      R"({"type":"user","timestamp":"%s","message":{"role":"user",)"
+      R"("content":"Fix the login page"}})",
+      Iso(T(0)).c_str()));
+  req(1, "claude-sonnet-4-5-20250929", 0, 20000);
+  req(5, "claude-sonnet-4-5-20250929", 20000, 300);
+  req(10, "claude-opus-5-5", 0, 20400);
+  req(15, "claude-opus-5-5", 20400, 200);
+  req(20, "claude-opus-5-5", 0, 20700);
+  ci.Feed(R"({"type":"cost-state","totalCostUSD":1})");
+  base::DictValue r = ci.Result(std::nullopt);
+  EXPECT_EQ(Causes(r), (std::vector<std::string>{"cold", "normal", "model",
+                                                 "normal", "unknown"}));
+  EXPECT_EQ(Why(r, 3),
+            "Model switched from Sonnet 4.5 to Opus 5.5: the cache is per "
+            "model, so 20.4k tokens written again");
+}
