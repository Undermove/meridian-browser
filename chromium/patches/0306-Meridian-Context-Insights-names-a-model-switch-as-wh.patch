+// A model's id as people say it: "claude-opus-5-5" is Opus 5.5,
+// "claude-sonnet-4-5-20250929" Sonnet 4.5. Other ids stay as they are.
+std::string ModelName(const std::string& id) {
+  if (!id.starts_with("claude-")) {
+    return id;
+  }
+  std::vector<std::string> parts;
+  size_t start = 7;
+  for (size_t dash; (dash = id.find('-', start)) != std::string::npos;
+       start = dash + 1) {
+    parts.push_back(id.substr(start, dash - start));
+  }
+  parts.push_back(id.substr(start));
+  std::string family, version;
+  for (const std::string& p : parts) {
+    const bool digits =
+        !p.empty() && std::all_of(p.begin(), p.end(), [](char c) {
+          return c >= '0' && c <= '9';
+        });
+    if (!digits) {
+      if (family.empty() && version.empty()) {
+        family = p;
+      }
+    } else if (p.size() <= 2) {
+      version += (version.empty() ? "" : ".") + p;
+    }
+  }
+  if (family.empty()) {
+    return id;
+  }
+  family[0] = static_cast<char>(family[0] - 'a' + 'A');
+  return version.empty() ? family : family + " " + version;
+}
