diff --git a/chrome/browser/meridian/atc.cc b/chrome/browser/meridian/atc.cc
new file mode 100644
index 0000000000..27044b9f89
--- /dev/null
+++ b/chrome/browser/meridian/atc.cc
@@ -0,0 +1,136 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/atc.h"
+
+#include <algorithm>
+
+#include "base/strings/string_util.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace meridian {
+
+namespace {
+
+// Lower case, without a scheme or a leading "www.".
+std::string NormalizePattern(std::string_view pattern) {
+  std::string p = base::ToLowerASCII(
+      base::TrimWhitespaceASCII(pattern, base::TRIM_ALL));
+  size_t scheme_end = p.find("://");
+  if (scheme_end != std::string::npos && scheme_end > 0 &&
+      base::IsAsciiAlpha(p[0]) &&
+      p.find_first_not_of("abcdefghijklmnopqrstuvwxyz0123456789+.-") ==
+          scheme_end) {
+    p = p.substr(scheme_end + 3);
+  }
+  if (p.starts_with("www.")) {
+    p = p.substr(4);
+  }
+  return p;
+}
+
+// `*` matches any run of characters; everything else is literal.
+bool GlobMatches(std::string_view glob, std::string_view text) {
+  size_t g = 0, t = 0;
+  size_t star = std::string_view::npos, resume = 0;
+  while (t < text.size()) {
+    if (g < glob.size() && glob[g] == '*') {
+      star = g++;
+      resume = t;
+    } else if (g < glob.size() && glob[g] == text[t]) {
+      ++g;
+      ++t;
+    } else if (star != std::string_view::npos) {
+      g = star + 1;
+      t = ++resume;
+    } else {
+      return false;
+    }
+  }
+  while (g < glob.size() && glob[g] == '*') {
+    ++g;
+  }
+  return g == glob.size();
+}
+
+AtcRoute ResolveTarget(const std::string* target,
+                       const std::vector<std::string>& space_ids) {
+  AtcRoute route;
+  if (!target) {
+    return route;
+  }
+  if (target->starts_with("space:")) {
+    std::string space_id = target->substr(6);
+    if (std::ranges::find(space_ids, space_id) != space_ids.end()) {
+      route.target = AtcRoute::Target::kSpace;
+      route.space_id = space_id;
+    } else {
+      route.target = AtcRoute::Target::kMain;
+    }
+  } else if (*target == "main") {
+    route.target = AtcRoute::Target::kMain;
+  }
+  return route;
+}
+
+}  // namespace
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterDictionaryPref(kAtcPref);
+}
+
+bool AtcRuleMatches(std::string_view pattern, const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  std::string p = NormalizePattern(pattern);
+  if (p.empty()) {
+    return false;
+  }
+  std::string host = base::ToLowerASCII(url.host());
+  if (host.starts_with("www.")) {
+    host = host.substr(4);
+  }
+  if (p.find('/') == std::string::npos) {
+    if (p.starts_with("*.")) {
+      return host.ends_with(p.substr(1));
+    }
+    if (p.find('*') != std::string::npos) {
+      return GlobMatches(p, host);
+    }
+    return host == p || host.ends_with("." + p);
+  }
+  std::string target = host + base::ToLowerASCII(url.path());
+  if (url.has_query()) {
+    target += "?" + base::ToLowerASCII(url.query());
+  }
+  if (p.find('*') != std::string::npos) {
+    if (GlobMatches(p, target)) {
+      return true;
+    }
+    return p.ends_with("/*") &&
+           GlobMatches(p.substr(0, p.size() - 2), target);
+  }
+  return target == p || target.starts_with(p.ends_with('/') ? p : p + "/") ||
+         target.starts_with(p + "?");
+}
+
+AtcRoute RouteLink(const base::DictValue& atc,
+                   const GURL& url,
+                   const std::vector<std::string>& space_ids) {
+  if (const base::ListValue* rules = atc.FindList("rules")) {
+    for (const base::Value& rule : *rules) {
+      const base::DictValue* dict = rule.GetIfDict();
+      const std::string* pattern = dict ? dict->FindString("pattern") : nullptr;
+      if (pattern && AtcRuleMatches(*pattern, url)) {
+        return ResolveTarget(dict->FindString("target"), space_ids);
+      }
+    }
+  }
+  return ResolveTarget(atc.FindString("fallback"), space_ids);
+}
+
+}  // namespace meridian
diff --git a/chrome/browser/meridian/atc.h b/chrome/browser/meridian/atc.h
new file mode 100644
index 0000000000..81c71de799
--- /dev/null
+++ b/chrome/browser/meridian/atc.h
@@ -0,0 +1,52 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_ATC_H_
+#define CHROME_BROWSER_MERIDIAN_ATC_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+
+class GURL;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace meridian {
+
+// Air Traffic Control: where a link opened from another app goes (like Arc's).
+//
+// The pref is { "fallback": "little" | "main",
+//               "rules": [{ "id", "pattern", "target" }] }
+//   pattern  "github.com"        the domain and its subdomains
+//            "*.google.com"      subdomains only
+//            "notion.so/acme/*"  a URL prefix or glob (host + path, scheme
+//                                ignored)
+//   target   "little"            the Little window
+//            "main"              a new tab in the space you're in
+//            "space:<id>"        a new tab in that space ("main" if it's gone)
+// Rules are checked top to bottom; the first match wins.
+inline constexpr char kAtcPref[] = "meridian.atc";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+bool AtcRuleMatches(std::string_view pattern, const GURL& url);
+
+struct AtcRoute {
+  enum class Target { kLittle, kMain, kSpace };
+  Target target = Target::kLittle;
+  std::string space_id;
+};
+
+AtcRoute RouteLink(const base::DictValue& atc,
+                   const GURL& url,
+                   const std::vector<std::string>& space_ids);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_ATC_H_
diff --git a/chrome/browser/meridian/atc_unittest.cc b/chrome/browser/meridian/atc_unittest.cc
new file mode 100644
index 0000000000..f9114c8633
--- /dev/null
+++ b/chrome/browser/meridian/atc_unittest.cc
@@ -0,0 +1,71 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/atc.h"
+
+#include "base/json/json_reader.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace meridian {
+namespace {
+
+bool Matches(const char* pattern, const char* url) {
+  return AtcRuleMatches(pattern, GURL(url));
+}
+
+TEST(AtcTest, DomainMatchesItselfAndSubdomains) {
+  EXPECT_TRUE(Matches("github.com", "https://github.com/x"));
+  EXPECT_TRUE(Matches("github.com", "https://www.github.com/"));
+  EXPECT_TRUE(Matches("github.com", "https://gist.github.com/"));
+  EXPECT_TRUE(Matches("https://GitHub.com", "https://github.com/"));
+  EXPECT_FALSE(Matches("github.com", "https://notgithub.com/"));
+  EXPECT_FALSE(Matches("github.com", "file:///github.com"));
+  EXPECT_FALSE(Matches("", "https://github.com/"));
+}
+
+TEST(AtcTest, WildcardSubdomainsOnly) {
+  EXPECT_TRUE(Matches("*.google.com", "https://docs.google.com/"));
+  EXPECT_FALSE(Matches("*.google.com", "https://google.com/"));
+  EXPECT_TRUE(Matches("mail.*.com", "https://mail.example.com/"));
+}
+
+TEST(AtcTest, PathPrefixesAndGlobs) {
+  EXPECT_TRUE(Matches("notion.so/acme", "https://notion.so/acme"));
+  EXPECT_TRUE(Matches("notion.so/acme", "https://www.notion.so/acme/page"));
+  EXPECT_TRUE(Matches("notion.so/acme", "https://notion.so/acme?p=1"));
+  EXPECT_FALSE(Matches("notion.so/acme", "https://notion.so/acmeco"));
+  EXPECT_TRUE(Matches("notion.so/acme/*", "https://notion.so/acme/page"));
+  EXPECT_TRUE(Matches("notion.so/acme/*", "https://notion.so/acme"));
+  EXPECT_FALSE(Matches("notion.so/acme/*", "https://notion.so/other"));
+  EXPECT_TRUE(Matches("example.com/a?b", "https://example.com/a?b"));
+}
+
+TEST(AtcTest, RoutesByFirstMatchingRuleThenFallback) {
+  base::DictValue atc = std::move(*base::JSONReader::Read(R"({
+    "fallback": "main",
+    "rules": [
+      {"id": "1", "pattern": "figma.com", "target": "space:work"},
+      {"id": "2", "pattern": "figma.com", "target": "little"},
+      {"id": "3", "pattern": "gone.com", "target": "space:deleted"},
+      {"id": "4", "pattern": "x.com", "target": "little"}
+    ]})", 0)).TakeDict();
+  std::vector<std::string> spaces = {"home", "work"};
+
+  AtcRoute r = RouteLink(atc, GURL("https://figma.com/f"), spaces);
+  EXPECT_EQ(r.target, AtcRoute::Target::kSpace);
+  EXPECT_EQ(r.space_id, "work");
+  EXPECT_EQ(RouteLink(atc, GURL("https://gone.com"), spaces).target,
+            AtcRoute::Target::kMain);
+  EXPECT_EQ(RouteLink(atc, GURL("https://x.com"), spaces).target,
+            AtcRoute::Target::kLittle);
+  EXPECT_EQ(RouteLink(atc, GURL("https://other.org"), spaces).target,
+            AtcRoute::Target::kMain);
+  // Without settings, links go to the Little window.
+  EXPECT_EQ(RouteLink(base::DictValue(), GURL("https://a.b"), spaces).target,
+            AtcRoute::Target::kLittle);
+}
+
+}  // namespace
+}  // namespace meridian
