 #include "ui/display/screen.h"
@@ -67,4 +74,56 @@ bool IsLittleWindow(const BrowserWindowInterface* browser) {
   return LittleWindows().contains(browser);
 }
 
+BrowserWindowInterface* FindOrCreateMainWindow(
+    Profile* profile,
+    const BrowserWindowInterface* except) {
+  BrowserWindowInterface* found = nullptr;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (browser != except &&
+            browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+            !IsLittleWindow(browser)) {
+          found = browser;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  if (found) {
+    return found;
+  }
+  BrowserWindowCreateParams params(*profile, /*from_user_gesture=*/true);
+  params.should_trigger_session_restore = false;
+  return CreateBrowserWindow(std::move(params));
+}
+
+void OpenExternalLink(Profile* profile, const GURL& url) {
+  SidebarService* service = SidebarServiceFactory::GetForProfile(profile);
+  std::vector<std::string> space_ids;
+  for (const Space& space : service->spaces()) {
+    space_ids.push_back(space.id);
+  }
+  AtcRoute route =
+      RouteLink(profile->GetPrefs()->GetDict(kAtcPref), url, space_ids);
+  if (route.target == AtcRoute::Target::kLittle) {
+    OpenLittleWindow(profile, url);
+    return;
+  }
+  BrowserWindowInterface* browser = FindOrCreateMainWindow(profile);
+  if (!browser) {
+    return;
+  }
+  std::string space_id = route.target == AtcRoute::Target::kSpace
+                             ? route.space_id
+                             : service->active_space_id();
+  service->SetActiveSpace(space_id);
+  NavigateParams nav(browser, url, ui::PAGE_TRANSITION_LINK);
+  nav.disposition = WindowOpenDisposition::kNewForegroundTab;
+  Navigate(&nav);
+  if (nav.navigated_or_inserted_contents) {
+    TabData::Set(nav.navigated_or_inserted_contents, space_id, std::string());
+  }
+  browser->GetWindow()->Show();
+}
+
 }  // namespace meridian
