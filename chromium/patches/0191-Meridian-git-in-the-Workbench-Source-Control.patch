   }
   if (method == "sandboxStatus" || method == "sandboxNetwork") {
@@ -1088,6 +1091,65 @@ void WorkbenchHandler::HubCall(const std::string& method,
                         web_ui()->GetWebContents()->GetTopLevelNativeWindow());
     return;
   }
+  // Source Control: git (and gh for pull requests) in the project, only the
+  // commands and options the panel uses (git_command.h).
+  if (method == "git" || method == "gh" || method == "gitInfo") {
+    if (!project_) {
+      return std::move(reply).Run(base::unexpected("no project is open"));
+    }
+    std::vector<std::string> args;
+    if (params.size() && params[0].is_list()) {
+      for (const base::Value& a : params[0].GetList()) {
+        if (a.is_string()) {
+          args.push_back(a.GetString());
+        }
+      }
+    }
+    std::optional<std::string> stdin_text;
+    if (params.size() > 1 && params[1].is_dict()) {
+      if (const std::string* in = params[1].GetDict().FindString("stdin")) {
+        stdin_text = in->substr(0, 1 << 20);
+      }
+    }
+    const bool is_git = method != "gh";
+    if (method != "gitInfo") {
+      std::string why = is_git ? CheckGitArgs(args) : CheckGhArgs(args);
+      if (!why.empty()) {
+        return std::move(reply).Run(base::unexpected(why));
+      }
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::WithBaseSyncPrimitives(),
+         base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(
+            [](std::string method, base::FilePath root,
+               std::vector<std::string> args,
+               std::optional<std::string> stdin_text) -> Result {
+              std::map<std::string, std::string> env = TerminalEnv();
+              std::string git = GitPath(env["PATH"]);
+              std::string gh = FindExecutable("gh", env["PATH"]);
+              if (method == "gitInfo") {
+                return base::Value(base::DictValue()
+                                       .Set("git", !git.empty())
+                                       .Set("gh", !gh.empty()));
+              }
+              const std::string& program = method == "gh" ? gh : git;
+              if (program.empty()) {
+                return base::unexpected(
+                    method == "gh"
+                        ? std::string("The GitHub CLI (gh) isn't installed.")
+                        : std::string("git isn't installed."));
+              }
+              return base::Value(RunGitCommand(program, method != "gh", root,
+                                               args, stdin_text,
+                                               std::move(env)));
+            },
+            method, project_->root(), std::move(args), std::move(stdin_text)),
+        base::BindOnce([](Reply reply, Result r) { std::move(reply).Run(std::move(r)); },
+                       std::move(reply)));
+    return;
+  }
   if (method == "hubInfo") {
     return OnProject(base::BindOnce([](const ProjectFs& p) -> Result {
                        return base::Value(HubInfo(p.root()));
