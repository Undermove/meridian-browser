+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_GIT_COMMAND_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_GIT_COMMAND_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/values.h"
+
+namespace meridian::workbench {
+
+// The Workbench's Source Control panel runs git (and gh, for pull requests)
+// in the open project: only the commands it uses, with paths inside the
+// project, no options that would run another program or reach outside it,
+// no shell. Empty when `args` may run, else why not.
+std::string CheckGitArgs(const std::vector<std::string>& args);
+std::string CheckGhArgs(const std::vector<std::string>& args);
+
+// Runs `program` (git or gh, an absolute path) with `args` in `root`:
+// {code, stdout, stderr, timedOut, truncated}. Blocking.
+base::DictValue RunGitCommand(const std::string& program,
+                              bool is_git,
+                              const base::FilePath& root,
+                              const std::vector<std::string>& args,
+                              const std::optional<std::string>& stdin_text,
+                              std::map<std::string, std::string> env);
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_GIT_COMMAND_H_
