new file mode 100644
index 0000000000..1436d6e31b
--- /dev/null
+++ b/chrome/browser/meridian/workbench/git_command.cc
@@ -0,0 +1,186 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/git_command.h"
+
+#include <algorithm>
+#include <array>
+#include <string_view>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/meridian/ai/process_runner.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+constexpr auto kGitCommands = std::to_array<std::string_view>({
+    "status", "diff", "show", "add", "restore", "commit", "branch", "switch",
+    "log", "rev-parse", "fetch", "pull", "push", "remote", "stash",
+    "ls-files", "rev-list", "for-each-ref", "init",
+});
+
+// Options that run another program, read or write outside the project, or
+// change git's configuration for the run.
+bool Dangerous(std::string_view a) {
+  for (std::string_view bad :
+       {"--exec", "--upload-pack", "--receive-pack", "--git-dir",
+        "--work-tree", "--namespace", "--config", "--output", "--ext-diff",
+        "--textconv", "--template", "--separate-git-dir", "--super-prefix",
+        "--exec-path", "--receive", "--upload"}) {
+    if (a.starts_with(bad)) {
+      return true;
+    }
+  }
+  // Short options git reads a program or a directory from.
+  return a == "-c" || a == "-C" || a == "-o" || a.starts_with("-u") ||
+         a.contains("::");
+}
+
+// A path the panel names: inside the project.
+bool InsideProject(std::string_view p) {
+  if (p.empty()) {
+    return true;
+  }
+  if (p.starts_with("/") || p.starts_with("\\") || p.starts_with("~") ||
+      (p.size() > 1 && p[1] == ':') || p.contains('\0')) {
+    return false;
+  }
+  for (std::string_view part :
+       base::SplitStringPiece(p, "/\\", base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_ALL)) {
+    if (part == "..") {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+std::string CheckGitArgs(const std::vector<std::string>& args) {
+  if (args.empty() || args.size() > 200) {
+    return "git: no command";
+  }
+  if (std::ranges::find(kGitCommands, args[0]) == kGitCommands.end()) {
+    return "git " + args[0] + " isn't available in the Workbench";
+  }
+  bool paths = false;
+  for (size_t i = 1; i < args.size(); ++i) {
+    const std::string& a = args[i];
+    if (a.size() > 4096) {
+      return "git: argument too long";
+    }
+    if (a == "--") {
+      paths = true;
+      continue;
+    }
+    if (paths) {
+      if (!InsideProject(a)) {
+        return "git: a path outside the project";
+      }
+      continue;
+    }
+    if (a.starts_with("-") && Dangerous(a)) {
+      return "git: the option " + a + " isn't available in the Workbench";
+    }
+    // "HEAD:path" and ":path" (a file at a commit or in the index).
+    if (size_t colon = a.find(':'); colon != std::string::npos &&
+                                    !a.starts_with("-") &&
+                                    !InsideProject(a.substr(colon + 1))) {
+      return "git: a path outside the project";
+    }
+    // Remotes are named, not given as an address (no ext::, file:// or a
+    // path): a remote's name, a branch, a refspec.
+    if ((args[0] == "push" || args[0] == "pull" || args[0] == "fetch") &&
+        !a.starts_with("-")) {
+      const bool name_like =
+          !a.contains("::") && !a.contains("//") && !a.starts_with("/") &&
+          !a.starts_with(".") && !a.contains('@') &&
+          std::ranges::all_of(a, [](char c) {
+            return base::IsAsciiAlphaNumeric(c) || c == '-' || c == '_' ||
+                   c == '.' || c == '/' || c == ':' || c == '+';
+          });
+      if (!name_like) {
+        return "git: name the remote, not its address";
+      }
+    }
+  }
+  if (args[0] == "remote" && args.size() > 1 && args[1] != "-v" &&
+      args[1] != "get-url") {
+    return "git remote: only listing";
+  }
+  return std::string();
+}
+
+std::string CheckGhArgs(const std::vector<std::string>& args) {
+  if (args.size() < 2) {
+    return "gh: no command";
+  }
+  const std::string cmd = args[0] + " " + args[1];
+  if (cmd != "pr list" && cmd != "pr view" && cmd != "pr create" &&
+      cmd != "pr status" && cmd != "pr checkout" && cmd != "auth status" &&
+      cmd != "pr diff") {
+    return "gh " + cmd + " isn't available in the Workbench";
+  }
+  for (const std::string& a : args) {
+    if (a.starts_with("--repo") || a == "-R" || a.contains('\0') ||
+        a.size() > 8192) {
+      return "gh: the option " + a + " isn't available in the Workbench";
+    }
+  }
+  return std::string();
+}
+
+base::DictValue RunGitCommand(const std::string& program,
+                              bool is_git,
+                              const base::FilePath& root,
+                              const std::vector<std::string>& args,
+                              const std::optional<std::string>& stdin_text,
+                              std::map<std::string, std::string> env) {
+  ai::ProcessSpec spec;
+  spec.argv = {program};
+  if (is_git) {
+    // Nothing configured runs another program on the side, no pager, no
+    // prompt for a password (the terminal is there for that).
+    for (const char* c :
+         {"core.fsmonitor=false", "core.pager=cat", "diff.external=",
+          "protocol.ext.allow=never", "core.sshCommand=ssh -oBatchMode=yes",
+          "credential.interactive=never", "color.ui=false"}) {
+      spec.argv.push_back("-c");
+      spec.argv.push_back(c);
+    }
+    spec.argv.push_back("--no-pager");
+  }
+  spec.argv.insert(spec.argv.end(), args.begin(), args.end());
+  env["GIT_TERMINAL_PROMPT"] = "0";
+  env["GIT_OPTIONAL_LOCKS"] = "0";
+  env["GH_PROMPT_DISABLED"] = "1";
+  env["NO_COLOR"] = "1";
+  env["LC_ALL"] = "C";
+  spec.env = std::move(env);
+  spec.cwd = root.AsUTF8Unsafe();
+  spec.stdin_text = stdin_text;
+  const bool network = args[0] == "fetch" || args[0] == "pull" ||
+                       args[0] == "push" || !is_git;
+  spec.timeout = network ? base::Seconds(120) : base::Seconds(20);
+  spec.max_output = 8u << 20;
+  std::string out;
+  ai::ProcessResult r = ai::RunProcess(
+      spec, base::MakeRefCounted<ai::CancelFlag>(),
+      base::BindRepeating([](std::string* out,
+                             std::string_view chunk) { out->append(chunk); },
+                          base::Unretained(&out)));
+  return base::DictValue()
+      .Set("started", r.started)
+      .Set("code", r.exit_code)
+      .Set("stdout", std::move(out))
+      .Set("stderr", r.stderr_text)
+      .Set("timedOut", r.timed_out)
+      .Set("truncated", r.too_long);
+}
+
+}  // namespace meridian::workbench
