From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Wed, 4 Nov 2026 01:00:51 +0400
Subject: [PATCH 084/105] The sidebar follows the active tab
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Like Arc: whatever makes a tab active (⌘⌥↑/↓, ⌃⇥, Switch to Tab, a link),
its row scrolls into the sidebar's view. Stepping through a long Today
used to walk the active tab out of sight.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../webui_browser/meridian/sidebar.ts         | 45 +++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
index 7238d5d01a..104d91a0c5 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
@@ -207,6 +207,8 @@ export class MeridianSidebarElement extends CrLitElement implements
   protected accessor playerToggle_: string = 'pause';
   protected accessor playerToggleIcon_: IconName = 'pause';
   private nowPlayingTimer_ = 0;
+  // The active tab the sidebar last scrolled to (Arc keeps it in sight).
+  private shownActive_: string|null = null;
   private nowPlayingPoll_ = 0;
   // Which side it comes from: 1 the right (the next space), -1 the left.
   private ghostDir_ = 1;
@@ -1511,6 +1513,10 @@ export class MeridianSidebarElement extends CrLitElement implements
     if (changed.has('menu_' as keyof MeridianSidebarElement)) {
       this.placeMenus_();
     }
+    if (changed.has('tabs_' as keyof MeridianSidebarElement) ||
+        changed.has('rev_' as keyof MeridianSidebarElement)) {
+      this.keepActiveInSight_();
+    }
     // The space being renamed may only render after the next state push.
     const input =
         this.shadowRoot.querySelector<HTMLInputElement>('input.rename');
@@ -1522,6 +1528,45 @@ export class MeridianSidebarElement extends CrLitElement implements
   }
 
 
+  // Arc: whatever made a tab active (⌘⌥↑/↓, ⌃⇥, Switch to Tab, a link), its
+  // row scrolls into the sidebar's view, once it has rendered.
+  private keepActiveInSight_() {
+    const active = [...this.tabs_.values()].find(t => t.isActive);
+    const id = active ? active.id : null;
+    if (id === this.shownActive_) {
+      return;
+    }
+    this.shownActive_ = id;
+    // After the rows (and a pinned row's own render) caught up.
+    setTimeout(() => {
+      const rows = [
+        ...this.shadowRoot.querySelectorAll<HTMLElement>('meridian-tab-row'),
+      ];
+      let row: HTMLElement|undefined =
+          rows.find(r => (r as unknown as {tab: Tab}).tab?.isActive);
+      if (!row) {
+        // A pinned tab, maybe inside a folder.
+        const find = (root: ShadowRoot|null): HTMLElement|undefined => {
+          for (const item of root?.querySelectorAll<HTMLElement>(
+                   'meridian-item') || []) {
+            const own = item.shadowRoot?.querySelector<HTMLElement>(
+                '.row.pinned.active');
+            if (own) {
+              return own;
+            }
+            const inner = find(item.shadowRoot);
+            if (inner) {
+              return inner;
+            }
+          }
+          return undefined;
+        };
+        row = find(this.shadowRoot);
+      }
+      row?.scrollIntoView({block: 'nearest'});
+    });
+  }
+
   // --------------------------------------------------------------- menus
 
   // The other spaces, as a "Move to Space" submenu.
