+.ai-question {
+  margin: 0 0 10px;
+  font-size: 19px;
+  opacity: 0.75;
+}
+
+.ai-ask .whisper {
+  max-width: 460px;
+  margin-top: 8px;
+}
+
+.ai-orb {
+  position: relative;
+  width: 76px;
+  height: 76px;
+  animation: ai-turn 9s linear infinite;
+}
+
+.ai-orb i {
+  position: absolute;
+  width: 46px;
+  height: 46px;
+  border-radius: 50%;
+  mix-blend-mode: multiply;
+  opacity: 0.85;
+}
+
+.ai-orb i:nth-child(1) {
+  top: 0;
+  left: 15px;
+  background: #d97757;
+}
+
+.ai-orb i:nth-child(2) {
+  bottom: 0;
+  left: 0;
+  background: #8a8fe0;
+}
+
+.ai-orb i:nth-child(3) {
+  right: 0;
+  bottom: 0;
+  background: #e8b84a;
+}
+
+@keyframes ai-turn {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+.tries {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 10px;
+  width: min(620px, 86vw);
+  margin-top: 18px;
+}
+
+.try {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 3px;
+  padding: 13px 14px;
+  border: 0;
+  border-radius: 12px;
+  background: color-mix(in srgb, currentColor 7%, transparent);
+  color: inherit;
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+  transition: transform 0.14s ease, background 0.14s ease;
+}
+
+.try:hover {
+  background: color-mix(in srgb, currentColor 13%, transparent);
+  transform: translateY(-2px);
+}
+
+.try-ic {
+  margin-bottom: 5px;
+  opacity: 0.8;
+}
+
+.try b {
+  font-size: 13.5px;
+  font-weight: 600;
+}
+
+.try em {
+  font-size: 12px;
+  font-style: normal;
+  opacity: 0.65;
+}
+
+.ai-done {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  margin-top: 16px;
+  font-size: 13px;
+}
+
+.ai-done .restart {
+  flex: none;
+  padding: 6px 14px;
+  font-size: 13px;
+  background: color-mix(in srgb, currentColor 14%, transparent);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ai-orb {
+    animation: none;
+  }
+
+  .try {
+    transition: none;
+  }
+}
