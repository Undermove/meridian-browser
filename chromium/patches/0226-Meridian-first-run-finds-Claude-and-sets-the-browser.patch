+void SidebarHandler::GrantAgentAccess() {
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  if (prefs->GetBoolean(prefs::kAgentAccessDecided) ||
+      prefs->GetString(prefs::kAgentAccess) != "off") {
