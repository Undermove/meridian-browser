 namespace meridian {
 
+namespace {
+
+constexpr int kQuitChecks = 30;  // half a second each
+
+void OpenClaude(NSURL* url, base::OnceCallback<void(bool, const std::string&)> done) {
+  if (!url) {
+    std::move(done).Run(false, "Open Claude to start using Meridian there.");
+    return;
+  }
+  [NSWorkspace.sharedWorkspace openURL:url];
+  std::move(done).Run(true, "Claude Desktop restarted.");
+}
+
+void WaitForQuit(NSRunningApplication* app,
+                 NSURL* url,
+                 int checks,
+                 base::OnceCallback<void(bool, const std::string&)> done) {
+  if (app.terminated) {
+    return OpenClaude(url, std::move(done));
+  }
+  if (checks <= 0) {
+    // It may be asking about unsaved work: never forced.
+    std::move(done).Run(false,
+                        "Claude is still open. Quit it, then open it again.");
+    return;
+  }
+  content::GetUIThreadTaskRunner({})->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&WaitForQuit, app, url, checks - 1, std::move(done)),
+      base::Milliseconds(500));
+}
+
+}  // namespace
+
+void SidebarHandler::RestartClaudeDesktop(
+    RestartClaudeDesktopCallback callback) {
+  // A test never touches a real Claude.
+  if (TestSwitchesAllowed()) {
+    std::move(callback).Run(true, "Claude Desktop restarted.");
+    return;
+  }
+  NSString* bundle = @"com.anthropic.claudefordesktop";
+  NSURL* url =
+      [NSWorkspace.sharedWorkspace URLForApplicationWithBundleIdentifier:bundle];
+  NSRunningApplication* app =
+      [NSRunningApplication runningApplicationsWithBundleIdentifier:bundle]
+          .firstObject;
+  if (!app) {
+    return OpenClaude(url, std::move(callback));
+  }
+  // A normal quit: Claude itself asks about anything unsaved.
+  [app terminate];
+  WaitForQuit(app, url, kQuitChecks, std::move(callback));
+}
