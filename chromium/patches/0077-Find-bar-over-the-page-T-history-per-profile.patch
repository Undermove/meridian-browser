+namespace {
+
+// The enabled main-menu item whose shortcut is `chars` with `modifiers`.
+NSMenuItem* MenuItemFor(NSMenu* menu, NSString* chars, uint32_t modifiers) {
+  const NSEventModifierFlags mask =
+      NSEventModifierFlagCommand | NSEventModifierFlagShift |
+      NSEventModifierFlagOption | NSEventModifierFlagControl;
+  for (NSMenuItem* item in menu.itemArray) {
+    if (item.submenu) {
+      if (NSMenuItem* found = MenuItemFor(item.submenu, chars, modifiers)) {
+        return found;
+      }
+    } else if (item.action && item.keyEquivalent.length &&
+               [item.keyEquivalent.lowercaseString
+                   isEqualToString:chars.lowercaseString] &&
+               (item.keyEquivalentModifierMask & mask) == (modifiers & mask)) {
+      return item;
+    }
+  }
+  return nil;
+}
+
+}  // namespace
+
 void SidebarHandler::TestKeyPress(uint16_t key_code,
                                   const std::string& characters,
                                   uint32_t modifiers) {
@@ -95,11 +119,22 @@ void SidebarHandler::TestKeyPress(uint16_t key_code,
                                      isARepeat:NO
                                        keyCode:key_code];
     // What -[NSApplication sendEvent:] does for the key window, which a test
-    // window in the background isn't: key equivalents first, then the
-    // window's first responder.
-    if (type == NSEventTypeKeyUp || ![window performKeyEquivalent:event]) {
-      [window sendEvent:event];
+    // window in the background isn't: key equivalents first (the window's,
+    // then the main menu's), then the window's first responder.
+    if (type == NSEventTypeKeyUp || [window performKeyEquivalent:event]) {
+      if (type == NSEventTypeKeyUp) {
+        [window sendEvent:event];
+      }
+      continue;
+    }
+    // The main menu sends its items to the key window; aim them at this one.
+    if (NSMenuItem* item = (modifiers & NSEventModifierFlagCommand)
+                               ? MenuItemFor(NSApp.mainMenu, chars, modifiers)
+                               : nil) {
+      [NSApp sendAction:item.action to:window from:item];
+      continue;
     }
+    [window sendEvent:event];
   }
 }
 
