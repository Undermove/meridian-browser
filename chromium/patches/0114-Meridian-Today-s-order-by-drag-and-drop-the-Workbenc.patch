+  // Shows `tab` right above or below `target` at once; the browser moves it
+  // in the strip too, so a restart keeps the order.
+  private moveTodayTab_(tab: NodeId, target: NodeId, above: boolean) {
+    const today = this.todayTabs();
+    const from = today.findIndex(t => t.id === tab);
+    const at = today.findIndex(t => t.id === target);
+    if (from < 0 || at < 0) {
+      return;
+    }
+    const ids = today.map(t => t.id).filter(id => id !== tab);
+    ids.splice(ids.indexOf(target) + (above ? 0 : 1), 0, tab);
+    // Newest first: the same order numbers, handed out top to bottom.
+    const orders = ids.map(id => this.order_.get(id) ?? 0)
+                       .sort((a, b) => b - a);
+    ids.forEach((id, i) => this.order_.set(id, orders[i]!));
+    this.today_ = this.todayTabs();
+    this.handler_.moveTodayTab(tab, target, above);
+  }
+
