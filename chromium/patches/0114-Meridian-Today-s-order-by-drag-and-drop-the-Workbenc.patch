+void SidebarHandler::MoveTodayTab(const tabs_api::NodeId& tab_id,
+                                  const tabs_api::NodeId& target_id,
+                                  bool above) {
+  tabs::TabInterface* tab = TabFor(tab_id);
+  tabs::TabInterface* target = TabFor(target_id);
+  if (!tab || !target || tab == target || tab->GetSplit() ||
+      target->GetSplit()) {
+    return;
+  }
+  // Today lists the newest first: above a tab is after it in the strip, and
+  // the strip's order is what a restart brings back.
+  int from = model()->GetIndexOfTab(tab);
+  int to = model()->GetIndexOfTab(target) + (above ? 1 : 0);
+  if (from < to) {
+    --to;
+  }
+  if (from != to) {
+    model()->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+  }
+}
