From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Wed, 4 Nov 2026 02:01:09 +0400
Subject: [PATCH 89/95] Archive Below, as in Arc

Right-click a Today tab > Archive Below: the tabs under it go to the Archive.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../browser/resources/webui_browser/meridian/sidebar.ts  | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
index 284d251ee2..ad09561783 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.ts
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.ts
@@ -1597,6 +1597,8 @@ export class MeridianSidebarElement extends CrLitElement implements
     const space = this.activeSpace();
     assert(space);
     const move = this.moveToSpaceMenu_(id => this.handler_.moveTabToSpace(tab.id, id));
+    const at = this.today_.findIndex(t => t.id === tab.id);
+    const below = at < 0 ? [] : this.today_.slice(at + 1).map(t => t.id);
     this.openMenu_(e, [
       {
         label: 'Copy Link',
@@ -1636,6 +1638,13 @@ export class MeridianSidebarElement extends CrLitElement implements
         separatorBefore: true,
         action: () => this.tabStripService_.closeNodes([tab.id]),
       },
+      // Arc: the Today tabs under this one go to the Archive.
+      {
+        label: 'Archive Below',
+        icon: 'archive',
+        enabled: below.length > 0,
+        action: () => this.tabStripService_.closeNodes(below),
+      },
     ]);
   }
 
