+namespace meridian {
+
+void SidebarHandler::GetStudioPersona(GetStudioPersonaCallback callback) {
+  Profile* profile = browser_->GetProfile();
+  if (!workbench::StudioEnabled(profile)) {
+    std::move(callback).Run(false, std::string(), std::string(), false);
+    return;
+  }
+  PrefService* prefs = MainProfileFor(profile)->GetPrefs();
+  const std::string persona = prefs->GetString(prefs::kStudioPersona);
+  const bool offered = prefs->GetBoolean(prefs::kStudioPersonaOffered);
+  std::string forced = TestSwitchValue("meridian-test-persona");
+  if (!forced.empty() || prefs->GetString(prefs::kMode) == "developer") {
+    std::move(callback).Run(true, persona,
+                            forced.empty() ? std::string("developer") : forced,
+                            offered);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [] { return GuessPersona(InstalledApps(), StrongDevSignals()); }),
+      base::BindOnce(
+          [](GetStudioPersonaCallback callback, std::string persona,
+             bool offered, std::string guess) {
+            std::move(callback).Run(true, persona, guess, offered);
+          },
+          std::move(callback), persona, offered));
+}
+
+void SidebarHandler::SetStudioPersona(const std::string& persona, bool route) {
+  Profile* profile = browser_->GetProfile();
+  if (!workbench::StudioEnabled(profile) ||
+      !workbench::IsStudioPersona(persona)) {
+    return;
+  }
+  PrefService* prefs = MainProfileFor(profile)->GetPrefs();
+  prefs->SetString(prefs::kStudioPersona, persona);
+  prefs->SetBoolean(prefs::kStudioPersonaOffered, true);
+  const std::string where = workbench::StudioRouteFor(persona);
+  if (!route || where.empty()) {
+    return;
+  }
+  // Studio (or the Workbench) one click away in this space, and open.
+  const GURL url(where == "studio" ? "chrome://workbench/?view=studio"
+                                   : "chrome://workbench/?view=workbench");
+  NavigateParams params(browser_, url, ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  Navigate(&params);
+  if (params.navigated_or_inserted_contents) {
+    PinTabContents(params.navigated_or_inserted_contents, false, url,
+                   where == "studio" ? "Studio" : "Workbench");
+  }
+}
+
+void SidebarHandler::SetStudioPersonaOffered() {
+  Profile* profile = browser_->GetProfile();
+  if (workbench::StudioEnabled(profile)) {
+    MainProfileFor(profile)->GetPrefs()->SetBoolean(
+        prefs::kStudioPersonaOffered, true);
+  }
+}
+
+}  // namespace meridian
