+namespace {
+
+// Bytes [from, to) of the file, or "" (read error).
+std::string ReadRange(base::File& file, int64_t from, int64_t to) {
+  if (to <= from) {
+    return std::string();
+  }
+  std::string text(static_cast<size_t>(to - from), '\0');
+  std::optional<size_t> read =
+      file.Read(from, base::as_writable_byte_span(text));
+  text.resize(read.value_or(0));
+  return text;
+}
+
+std::string ValidUtf8(std::string text) {
+  if (!base::IsStringUTF8AllowingNoncharacters(text)) {
+    text = base::UTF16ToUTF8(base::UTF8ToUTF16(text));
+  }
+  return text;
+}
+
+}  // namespace
+
+base::DictValue ReadTranscriptTail(const base::FilePath& path, int64_t max) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  const int64_t size = file.IsValid() ? file.GetLength() : 0;
+  int64_t from = std::max<int64_t>(0, size - max);
+  std::string text = file.IsValid() ? ReadRange(file, from, size) : "";
+  // From the first whole line (unless that is the file's start).
+  if (from > 0) {
+    const size_t nl = text.find('\n');
+    const size_t cut = nl == std::string::npos ? text.size() : nl + 1;
+    text.erase(0, cut);
+    from += static_cast<int64_t>(cut);
+  }
+  // To the last whole line.
+  const size_t end = text.rfind('\n');
+  text.resize(end == std::string::npos ? 0 : end + 1);
+  const double next = static_cast<double>(from + text.size());
+  return base::DictValue()
+      .Set("size", static_cast<double>(size))
+      .Set("start", static_cast<double>(from))
+      .Set("next", next)
+      .Set("text", ValidUtf8(std::move(text)))
+      .Set("reset", false);
+}
+
+base::DictValue ReadTranscriptBefore(const base::FilePath& path,
+                                     int64_t end,
+                                     int64_t max) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  const int64_t size = file.IsValid() ? file.GetLength() : 0;
+  end = std::clamp<int64_t>(end, 0, size);
+  int64_t from = std::max<int64_t>(0, end - max);
+  std::string text = file.IsValid() ? ReadRange(file, from, end) : "";
+  if (from > 0) {
+    const size_t nl = text.find('\n');
+    const size_t cut = nl == std::string::npos ? text.size() : nl + 1;
+    text.erase(0, cut);
+    from += static_cast<int64_t>(cut);
+  }
+  return base::DictValue()
+      .Set("size", static_cast<double>(size))
+      .Set("start", static_cast<double>(from))
+      .Set("next", static_cast<double>(end))
+      .Set("text", ValidUtf8(std::move(text)))
+      .Set("reset", false);
+}
