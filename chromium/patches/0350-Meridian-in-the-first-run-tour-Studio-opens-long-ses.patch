+.plate h3 { position: relative; margin: 0; font: 800 23px/1 'Alegreya SC', Georgia, serif; letter-spacing: .02em; color: #fff; text-shadow: 0 0 14px color-mix(in srgb, var(--c) 70%, transparent), 0 1px 0 rgba(0,0,0,.5); }
+.cls { position: absolute; left: 0; right: 0; top: 324px; text-align: center; font-size: 12px; color: rgba(233,229,255,.75); z-index: 3; }
+.cls b { color: color-mix(in srgb, var(--c) 70%, #fff); font-weight: 700; font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; }
+.perks { position: absolute; left: 20px; right: 12px; top: 356px; margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 11px; z-index: 3; }
+.perks li { display: flex; gap: 10px; align-items: center; font-size: 12.5px; line-height: 1.3; color: #ece9ff; }
+.pi { flex: none; width: 24px; height: 24px; display: grid; place-items: center; color: color-mix(in srgb, var(--c) 80%, #fff); position: relative; }
+.pi::before { content: ''; position: absolute; inset: 2px; transform: rotate(45deg); border-radius: 4px; border: 1px solid color-mix(in srgb, var(--c) 60%, transparent); background: color-mix(in srgb, var(--c) 14%, transparent); }
+.pi svg { position: relative; }
+.opens { position: absolute; left: 0; right: 0; bottom: 22px; display: flex; gap: 6px; justify-content: center; align-items: center; font-size: 11.5px; color: rgba(233,229,255,.7); z-index: 3; }
+.opens b { color: #fff; font-weight: 600; }
+/* "looks like you" — a ribbon tab hanging from the frame, never over the art */
+.guess { position: absolute; left: 50%; bottom: -30px; transform: translateX(-50%); z-index: 4; white-space: nowrap; display: inline-flex; align-items: center; gap: 7px;
+  height: 26px; padding: 0 14px 0 6px; font-size: 11.5px; font-weight: 650; color: #2a1c08;
+  background: linear-gradient(90deg, #f3d48b, #fff1c9 50%, #f0c873); clip-path: polygon(0 0, 100% 0, calc(100% - 8px) 50%, 100% 100%, 0 100%, 8px 50%); padding-left: 16px; padding-right: 20px; }
+.guess .seal { width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: #2a1c08; color: #ffe2a0; }
+.pc .check { position: absolute; right: -9px; top: 279px; z-index: 5; width: 26px; height: 26px; border-radius: 50%; background: #fff; color: #1f1640; display: grid; place-items: center; box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 70%, transparent), 0 4px 12px rgba(0,0,0,.4); }
+/* footer */
+.foot { margin-top: 56px; display: flex; gap: 14px; align-items: center; z-index: 1; }
+.btn { height: 46px; padding: 0 30px; font-size: 15px; font-weight: 650; display: inline-flex; align-items: center; cursor: pointer; }
+.btn.pri { background: linear-gradient(180deg, #fff, #ece6ff); color: #22184a; clip-path: polygon(12px 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 12px 100%, 0 50%); padding: 0 36px; }
+.btn.ghost { color: rgba(236,232,255,.8); }
+.note { margin-top: 14px; font-size: 12.5px; color: rgba(236,232,255,.6); z-index: 1; }
+@media (prefers-reduced-motion: reduce) {
+  .pc, .beam, .floor, .edge-glow { transition: none; }
+  .tilt { transition: transform .2s ease; }
+  .pc:hover .tilt { transform: translateY(-8px); }
+  .foil, .scan, .flash, .stk canvas, .bust img.rgb, .dust { display: none; }
+}
+/* A narrower window: two by two. */
+@media (max-width: 1240px) {
+  .cards { grid-template-columns: repeat(2, 262px); row-gap: 72px; }
+}
+.pc:focus-visible { outline: none; }
+.pc:focus-visible .floor { opacity: .9; }
+h2 { margin-top: 0; }
