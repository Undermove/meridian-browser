+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianHeroPickerElement} from './hero_picker.js';
+import {icon} from './icons.js';
+
+export function getHtml(this: MeridianHeroPickerElement) {
+  return html`<!--_html_template_start_-->
+<canvas class="dust"></canvas>
+<h2>${this.text_.title}</h2>
+<p class="lead">${this.text_.lead}</p>
+<div class="cards" role="radiogroup" aria-label="${this.text_.title}"
+    @keydown="${this.onKeydown_}">
+  ${this.heroes_.map((h, i) => {
+    const art = `meridian/persona/hero-${h.k}.webp`;
+    const sel = h.id === this.selected;
+    return html`
+    <div class="pc ${sel ? 'sel' : ''}" data-k="${h.k}" data-id="${h.id}"
+        data-cta="${h.cta}" tabindex="0" role="radio"
+        aria-checked="${sel ? 'true' : 'false'}" aria-label="${h.name}"
+        style="--c:${h.c};--c2:${h.c2};--hc:${h.c};--i:${i}">
+      <div class="beam"></div><div class="floor"></div>
+      <img class="frame" src="meridian/persona/frame-${h.k}.svg" alt="">
+      <div class="art"><div class="tilt">
+        <div class="stk" style="--img:url(${art})">
+          <canvas class="back"></canvas>
+          <div class="bust">
+            <img class="hero" src="${art}" alt="">
+            ${h.k === 'dev' ? html`<img class="rgb r" src="${art}" alt="">
+              <img class="rgb b" src="${art}" alt="">` : ''}
+            <span class="mask foil"><i></i></span>
+            ${h.k === 'dev' ? html`<span class="mask scan"><i></i></span>` : ''}
+            <span class="mask flash-m"><span class="flash"></span></span>
+          </div>
+          <canvas class="front"></canvas>
+        </div>
+      </div></div>
+      <div class="plate">
+        <svg class="ribbon" width="292" height="46" viewBox="0 0 292 46"
+            aria-hidden="true">
+          <path d="M0 10 h20 v-6 h252 v6 h20 l-10 13 10 13 h-20 v6 h-252 v-6 h-20 l10 -13z"
+              fill="${h.bg}" stroke="${h.c}" stroke-opacity=".7"></path>
+          <path d="M20 4 v6 M272 4 v6 M20 36 v6 M272 36 v6" stroke="${h.c}"
+              stroke-opacity=".7"></path>
+        </svg>
+        <h3>${h.name}</h3>
+      </div>
+      <div class="cls"><b>${h.cls}</b> · ${h.role}</div>
+      <ul class="perks">
+        ${h.perks.map(([name, text]) => html`
+          <li><span class="pi">${icon(name, 15)}</span><span>${text}</span></li>`)}
+      </ul>
+      <div class="opens">${icon('arrowRight', 13)}
+        <span>${h.opens} <b>${h.opensWhat}</b></span></div>
+      ${h.id === this.guess ? html`
+        <div class="guess"><span class="seal">${icon('sparkles', 12)}</span>
+          ${this.text_.guess}</div>` : ''}
+    </div>`;
+  })}
+</div>
+${this.guess ? html`<p class="note">${this.text_.note}</p>` : ''}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/hero_picker.ts b/chrome/browser/resources/webui_browser/meridian/hero_picker.ts
new file mode 100644
index 0000000000..10000960dd
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/hero_picker.ts
@@ -0,0 +1,208 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// «Кто вы?»: four heroes, as a game's character select (the persona agent's
+// v4 art: persona/, effects: hero_fx.ts). Shown by the first-run tour
+// (onboarding.ts) when Studio is on, and from Settings. The pick decides
+// what opens after the tour: Studio for designers and managers, the
+// Workbench for developers, nothing for everyday browsing. It fires
+// 'hero-change' with the persona; the tour's own button goes on.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {IconName} from './icons.js';
+import {heroDust, heroFx} from './hero_fx.js';
+import {getCss} from './hero_picker.css.js';
+import {getHtml} from './hero_picker.html.js';
+
+export type Persona = 'developer'|'designer'|'manager'|'everyday';
+
+export interface Hero {
+  id: Persona;
+  k: string;
+  c: string;
+  c2: string;
+  bg: string;
+  name: string;
+  cls: string;
+  role: string;
+  perks: Array<[IconName, string]>;
+  opens: string;
+  opensWhat: string;
+  cta: string;
+}
+
+const RU = /^ru\b/i.test(navigator.language || '');
+
+const HEROES: Hero[] = RU ?
+    [
+      {id: 'developer', k: 'dev', c: '#2ef2d2', c2: '#ff4fd8', bg: '#081019',
+       name: 'Разработчик', cls: 'Нетраннер', role: 'код и агенты',
+       perks: [['terminal', 'Код и терминал в Workbench'],
+               ['globe', 'Агенты водят браузер'],
+               ['grid', 'Все агенты — в Mission Control']],
+       opens: 'Откроется', opensWhat: 'Workbench',
+       cta: 'Я разработчик — дальше'},
+      {id: 'designer', k: 'des', c: '#c58cff', c2: '#ffcf7a', bg: '#120c26',
+       name: 'Дизайнер', cls: 'Чародейка', role: 'макеты и сайты',
+       perks: [['pencil', 'Правки словами на сайте'],
+               ['palette', 'Бренд из Figma не уплывёт'],
+               ['history', 'Любую правку можно отменить']],
+       opens: 'Откроется', opensWhat: 'Студия', cta: 'Я дизайнер — дальше'},
+      {id: 'manager', k: 'man', c: '#ffd36b', c2: '#9aa6ff', bg: '#0c0b22',
+       name: 'Менеджер', cls: 'Волшебница', role: 'задачи и отчёты',
+       perks: [['file', 'Отчёт из задач на глазах'],
+               ['shield', 'Наружу — только после «да»'],
+               ['split', 'Работа и личное — раздельно']],
+       opens: 'Откроется', opensWhat: 'Студия', cta: 'Я менеджер — дальше'},
+      {id: 'everyday', k: 'use', c: '#ff9a6b', c2: '#9fd8ff', bg: '#110b1f',
+       name: 'Просто пользуюсь', cls: 'Путешественник', role: 'сайты и почта',
+       perks: [['folder', 'Вкладки сами в порядке'],
+               ['search', 'Поиск по открытым вкладкам'],
+               ['sparkles', 'AI — только по просьбе']],
+       opens: 'Будет', opensWhat: 'обычный браузер',
+       cta: 'Просто пользуюсь — дальше'},
+    ] :
+    [
+      {id: 'developer', k: 'dev', c: '#2ef2d2', c2: '#ff4fd8', bg: '#081019',
+       name: 'Developer', cls: 'Netrunner', role: 'code and agents',
+       perks: [['terminal', 'Code and terminal in the Workbench'],
+               ['globe', 'Agents drive the browser'],
+               ['grid', 'Every agent in Mission Control']],
+       opens: 'Opens', opensWhat: 'the Workbench',
+       cta: 'I’m a developer — next'},
+      {id: 'designer', k: 'des', c: '#c58cff', c2: '#ffcf7a', bg: '#120c26',
+       name: 'Designer', cls: 'Enchantress', role: 'mockups and sites',
+       perks: [['pencil', 'Change the site in words'],
+               ['palette', 'The Figma brand stays put'],
+               ['history', 'Every change can be undone']],
+       opens: 'Opens', opensWhat: 'Studio', cta: 'I’m a designer — next'},
+      {id: 'manager', k: 'man', c: '#ffd36b', c2: '#9aa6ff', bg: '#0c0b22',
+       name: 'Manager', cls: 'Sorceress', role: 'tasks and reports',
+       perks: [['file', 'Reports from tasks, live'],
+               ['shield', 'Nothing goes out without a yes'],
+               ['split', 'Work and personal apart']],
+       opens: 'Opens', opensWhat: 'Studio', cta: 'I’m a manager — next'},
+      {id: 'everyday', k: 'use', c: '#ff9a6b', c2: '#9fd8ff', bg: '#110b1f',
+       name: 'Just browsing', cls: 'Traveller', role: 'sites and mail',
+       perks: [['folder', 'Tabs that tidy themselves'],
+               ['search', 'Find any open tab'],
+               ['sparkles', 'AI only when asked']],
+       opens: 'Stays', opensWhat: 'a plain browser',
+       cta: 'Just browsing — next'},
+    ];
+
+export const HERO_TEXT = RU ?
+    {
+      title: 'Кто вы?',
+      lead: 'Выберите героя — Meridian подстроится под вашу работу. ' +
+          'Поменять можно в любой момент в Настройках.',
+      guess: 'Похоже на вас',
+      note: 'Догадка — по приложениям на этом компьютере. Никуда не ' +
+          'отправляется.',
+    } :
+    {
+      title: 'Who are you?',
+      lead: 'Pick a hero — Meridian fits itself to your work. Change it any ' +
+          'time in Settings.',
+      guess: 'Looks like you',
+      note: 'The guess comes from the apps on this computer. Nothing is ' +
+          'sent anywhere.',
+    };
+
+export function heroCta(persona: string): string {
+  return HEROES.find(h => h.id === persona)?.cta || HEROES[1]!.cta;
+}
+
+// The display font, once, in the document (a shadow root can't hold
+// @font-face). SIL OFL 1.1: persona/OFL.txt.
+function addFont() {
+  if (document.getElementById('meridian-hero-font')) {
+    return;
+  }
+  const style = document.createElement('style');
+  style.id = 'meridian-hero-font';
+  style.textContent =
+      `@font-face{font-family:'Alegreya SC';font-weight:800;font-display:block;src:url(meridian/persona/AlegreyaSC-800-cyr.woff2) format('woff2');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;}` +
+      `@font-face{font-family:'Alegreya SC';font-weight:800;font-display:block;src:url(meridian/persona/AlegreyaSC-800-lat.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}`;
+  document.head.appendChild(style);
+}
+
+export class MeridianHeroPickerElement extends CrLitElement {
+  static get is() {
+    return 'meridian-hero-picker';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  static override get properties() {
+    return {
+      selected: {type: String},
+      guess: {type: String},
+    };
+  }
+
+  // Set before it's shown; the cards are drawn once (the effects own their
+  // classes from then on).
+  accessor selected: string = 'designer';
+  accessor guess: string = '';
+
+  protected heroes_: Hero[] = HEROES;
+  protected text_ = HERO_TEXT;
+  private wired_ = false;
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  override shouldUpdate(_changed: PropertyValues<this>) {
+    // Once drawn, a later property change doesn't redraw the cards.
+    return !this.wired_;
+  }
+
+  override firstUpdated() {
+    addFont();
+    this.wired_ = true;
+    const root = this.shadowRoot!;
+    heroDust(root);
+    heroFx(root, (k: string) => {
+      const hero = this.heroes_.find(h => h.k === k);
+      if (hero) {
+        this.selected = hero.id;
+        this.fire('hero-change', hero.id);
+      }
+    });
+  }
+
+  // Arrows move between the heroes, Enter or Space picks (no motion for
+  // keys: the effects run on the pointer only).
+  protected onKeydown_(e: KeyboardEvent) {
+    const card = (e.target as HTMLElement).closest<HTMLElement>('.pc');
+    if (!card) {
+      return;
+    }
+    if (e.key === 'Enter' || e.key === ' ') {
+      e.preventDefault();
+      card.click();
+    } else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
+      e.preventDefault();
+      const next = (e.key === 'ArrowRight' ? card.nextElementSibling :
+                                             card.previousElementSibling) as
+          HTMLElement |
+          null;
+      next?.focus();
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-hero-picker': MeridianHeroPickerElement;
+  }
+}
+
+customElements.define(MeridianHeroPickerElement.is, MeridianHeroPickerElement);
