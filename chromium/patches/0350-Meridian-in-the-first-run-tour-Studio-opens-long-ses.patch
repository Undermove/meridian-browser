+bool StudioFigmaReachable() {
+#if BUILDFLAG(IS_POSIX)
+  const int fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (fd < 0) {
+    return false;
+  }
+  fcntl(fd, F_SETFL, fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+  sockaddr_in addr = {};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(kStudioFigmaMcpPort);
+  addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  bool ok = connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) == 0;
+  if (!ok && errno == EINPROGRESS) {
+    pollfd p = {fd, POLLOUT, 0};
+    int error = 0;
+    socklen_t len = sizeof(error);
+    ok = poll(&p, 1, 300) == 1 &&
+         getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &len) == 0 && error == 0;
+  }
+  close(fd);
+  return ok;
+#else
+  // (Windows: not checked; Studio says to open Figma.)
+  return false;
+#endif
+}
+
+bool IsStudioPersona(std::string_view persona) {
+  return persona == "developer" || persona == "designer" ||
+         persona == "manager" || persona == "everyday";
+}
+
+std::string StudioRouteFor(std::string_view persona) {
+  if (persona == "designer" || persona == "manager") {
+    return "studio";
+  }
+  return persona == "developer" ? "workbench" : "";
+}
+
+bool IsStudioPageFile(std::string_view path) {
+  const std::string lower = base::ToLowerASCII(path);
+  return lower.ends_with(".html") || lower.ends_with(".htm") ||
+         lower.ends_with(".pdf");
+}
