 #include "components/input/native_web_keyboard_event.h"
 #import "components/remote_cocoa/app_shim/native_widget_ns_window_bridge.h"
 #include "ui/base/accelerators/global_accelerator_listener/global_accelerator_listener.h"
 #include "ui/base/window_open_disposition.h"
+#include "ui/events/blink/blink_event_util.h"
 #include "ui/views/cocoa/native_widget_mac_ns_window_host.h"
 #include "ui/views/widget/native_widget_mac.h"
 
@@ -85,6 +87,22 @@ int WebUIBrowserWindow::ReservedCommandForKeyEvent(
       }
     }
   }
+  if (command == NO_COMMAND) {
+    // Or a menu item's shortcut (⌃Tab, ⌘⌥←/→), by the key's code and
+    // modifiers, as the menus would match it.
+    const ui::Accelerator key(
+        static_cast<ui::KeyboardCode>(event.windows_key_code),
+        ui::WebEventModifiersToEventFlags(event.GetModifiers()) &
+            (ui::EF_SHIFT_DOWN | ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+             ui::EF_COMMAND_DOWN));
+    for (const auto& [id, accelerator] : *AcceleratorsCocoa::GetInstance()) {
+      if (accelerator.key_code() == key.key_code() &&
+          accelerator.modifiers() == key.modifiers()) {
+        command = id;
+        break;
+      }
+    }
+  }
   if (command == NO_COMMAND ||
       !chrome::BrowserCommandController::From(browser_.get())
            ->IsReservedCommandOrKey(command, event)) {
