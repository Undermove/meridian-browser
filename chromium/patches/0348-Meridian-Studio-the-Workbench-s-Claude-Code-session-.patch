index 0000000000..33eb550d39
--- /dev/null
+++ b/chrome/browser/meridian/workbench/studio_core.cc
@@ -0,0 +1,172 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Studio's parts that need no browser (unit-tested): its rules, Mission
+// Control's view for it, and reading a transcript.
+
+#include <algorithm>
+#include <map>
+#include <optional>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/meridian/workbench/studio.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+constexpr int64_t kChunk = 8 * 1024 * 1024;
+constexpr size_t kLogShown = 40;
+
+}  // namespace
+
+std::string StudioRules() {
+  return "You are working in Meridian Studio, for a person who does not use a "
+         "terminal (a designer or a manager). They see your work as a chat "
+         "with steps, and the result next to it. Rules:\n"
+         "1. Never overwrite, move or delete the person's original files. "
+         "Before changing a file, copy it into a folder named \"Drafts\" "
+         "(\"Черновики\" if the person writes in Russian) in the project "
+         "folder and change the copy. New files go there too.\n"
+         "2. Keep notes.md in that folder: what you changed and why, in plain "
+         "words, a few lines.\n"
+         "3. Say what you do in plain, friendly words. No jargon: never "
+         "mention MCP, CLI, tokens, terminals, git, commits or flags.\n"
+         "4. Never send, publish, upload, push or post anything outside this "
+         "computer without asking first.\n"
+         "5. To change how a live website looks, use Meridian's browser tools "
+         "on the open tab (set_boost with CSS): it can be undone at once. "
+         "Take a screenshot before and after.\n"
+         "6. If the task is big, first propose splitting it into 2-4 steps "
+         "and wait for a yes.\n"
+         "7. Answer in the language the person writes in.\n"
+         "8. Ask your questions as plain text at the end of your answer, not "
+         "with a question or plan tool: the person answers in the chat.\n"
+         "9. A remark about one element of the open site goes on the page as "
+         "a pin: write it as [[pin: <CSS selector> | <short remark>]] in your "
+         "answer.\n"
+         "10. When the person changed things by hand on the page, keep those "
+         "changes: never undo or overwrite them.";
+}
+
+base::DictValue StudioTerms(const base::DictValue& snapshot,
+                            int owner_tab,
+                            const std::set<std::string>& term_ids) {
+  base::DictValue out;
+  std::map<std::string, std::string> term_of_node;
+  if (const base::ListValue* nodes = snapshot.FindList("nodes")) {
+    for (const base::Value& v : *nodes) {
+      const base::DictValue& n = v.GetDict();
+      const std::string* term = n.FindString("termId");
+      const std::string* id = n.FindString("id");
+      if (!term || !id || n.FindInt("ownerTab").value_or(0) != owner_tab ||
+          !term_ids.contains(*term)) {
+        continue;
+      }
+      // The session's own row (its subagents have a parent).
+      const std::string* parent = n.FindString("parentId");
+      if (parent && !parent->empty()) {
+        continue;
+      }
+      term_of_node[*id] = *term;
+      base::DictValue entry;
+      for (const char* key : {"status", "statusText", "label"}) {
+        if (const std::string* s = n.FindString(key)) {
+          entry.Set(key, *s);
+        }
+      }
+      if (const base::Value* tool = n.Find("tool"); tool && tool->is_dict()) {
+        entry.Set("tool", tool->Clone());
+      }
+      if (std::optional<double> w = n.FindDouble("waitingSince")) {
+        entry.Set("waitingSince", *w);
+      }
+      base::ListValue log;
+      if (const base::ListValue* l = n.FindList("log")) {
+        size_t from = l->size() > kLogShown ? l->size() - kLogShown : 0;
+        for (size_t i = from; i < l->size(); ++i) {
+          log.Append((*l)[i].Clone());
+        }
+      }
+      entry.Set("log", std::move(log));
+      entry.Set("asks", base::ListValue());
+      out.Set(*term, std::move(entry));
+    }
+  }
+  if (const base::ListValue* asks = snapshot.FindList("asks")) {
+    for (const base::Value& v : *asks) {
+      const base::DictValue& a = v.GetDict();
+      const std::string* node = a.FindString("nodeId");
+      if (!node || !term_of_node.contains(*node)) {
+        continue;
+      }
+      base::DictValue* entry = out.FindDict(term_of_node[*node]);
+      if (!entry) {
+        continue;
+      }
+      base::DictValue ask;
+      for (const char* key : {"id", "kind", "tool", "summary"}) {
+        if (const std::string* s = a.FindString(key)) {
+          ask.Set(key, *s);
+        }
+      }
+      ask.Set("answerable", a.FindBool("answerable").value_or(false));
+      ask.Set("canAlways", a.FindBool("canAlways").value_or(false));
+      entry->FindList("asks")->Append(std::move(ask));
+    }
+  }
+  return out;
+}
+
+base::DictValue ReadTranscriptChunk(const base::FilePath& path,
+                                    int64_t offset) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return base::DictValue()
+        .Set("size", 0)
+        .Set("next", 0)
+        .Set("text", "")
+        .Set("reset", false);
+  }
+  const int64_t size = file.GetLength();
+  bool reset = false;
+  if (offset < 0 || offset > size) {
+    offset = 0;
+    reset = true;
+  }
+  const int64_t want = std::min<int64_t>(kChunk, size - offset);
+  std::string text(static_cast<size_t>(std::max<int64_t>(want, 0)), '\0');
+  std::optional<size_t> read =
+      want > 0 ? file.Read(offset, base::as_writable_byte_span(text))
+               : std::optional<size_t>(0);
+  text.resize(read.value_or(0));
+  // Whole lines only: the last one may still be being written.
+  size_t end = text.rfind('\n');
+  bool skipped = false;
+  if (end == std::string::npos && want == kChunk && !text.empty()) {
+    // One line longer than a chunk (a huge picture): skipped; the reader
+    // drops the rest of it, which doesn't parse.
+    skipped = true;
+    end = text.size() - 1;
+  }
+  text.resize(end == std::string::npos ? 0 : end + 1);
+  const double next = static_cast<double>(offset + text.size());
+  if (skipped) {
+    text.clear();
+  }
+  if (!base::IsStringUTF8AllowingNoncharacters(text)) {
+    text = base::UTF16ToUTF8(base::UTF8ToUTF16(text));
+  }
+  return base::DictValue()
+      .Set("size", static_cast<double>(size))
+      .Set("next", next)
+      .Set("text", std::move(text))
+      .Set("reset", reset);
+}
+
+}  // namespace meridian::workbench
