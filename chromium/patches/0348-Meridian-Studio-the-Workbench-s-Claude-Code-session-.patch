+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_STUDIO_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_STUDIO_H_
+
+#include <cstdint>
+#include <set>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/values.h"
+
+class Profile;
+
+namespace meridian::workbench {
+
+// Studio: the Workbench's Claude Code sessions shown as a chat for people who
+// don't use a terminal (designers, managers). The same page, the same
+// terminals; only another view. Off unless `meridian.studio.enabled` (main
+// profile) or --enable-meridian-studio; off, nothing of it runs.
+bool StudioEnabled(Profile* profile);
+
+// What a session started from Studio is told on top of Claude Code's own
+// prompt (--append-system-prompt): keep the person's originals, say what it
+// does in plain words, ask before anything leaves the computer.
+std::string StudioRules();
+
+// The Figma desktop app's MCP server (Preferences › Enable Dev Mode MCP
+// Server): design context only, nothing in Figma changes.
+inline constexpr char kStudioFigmaMcpUrl[] = "http://127.0.0.1:3845/mcp";
+
+// Mission Control's view of this Workbench's terminals for Studio, by
+// terminal id: status, what it does now, its open questions and recent steps.
+base::DictValue StudioTerms(const base::DictValue& snapshot,
+                            int owner_tab,
+                            const std::set<std::string>& term_ids);
+
+// The transcript from `offset`: whole lines only, at most 8 MB (a longer
+// line is skipped). `next` is where to go on; a file that shrank (a new
+// session) starts over at 0. Blocking.
+base::DictValue ReadTranscriptChunk(const base::FilePath& path,
+                                    int64_t offset);
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_STUDIO_H_
diff --git a/chrome/browser/meridian/workbench/studio_core.cc b/chrome/browser/meridian/workbench/studio_core.cc
