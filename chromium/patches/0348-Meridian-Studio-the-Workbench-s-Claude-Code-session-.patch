+      const bg = hex(s.backgroundColor), fg = hex(s.color);
+      if (bg) colors.set(bg, (colors.get(bg) || 0) + Math.min(40, (r.width * r.height) / 3000) + 1);
+      if (fg && el.childNodes.length && [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim())) colors.set(fg, (colors.get(fg) || 0) + 1);
+      const fam = s.fontFamily.split(',')[0].replace(/["']/g, '').trim();
+      if (fam && [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim())) {
+        const head = /^h[1-3]$/i.test(el.tagName) || parseFloat(s.fontSize) >= 24;
+        const f = fonts.get(fam) || { family: fam, head: 0, text: 0 };
+        f[head ? 'head' : 'text']++;
+        fonts.set(fam, f);
+      }
+    }
+    // Close shades count as one (the most used of them).
+    const list = [...colors.entries()].sort((a, b) => b[1] - a[1]);
+    const kept = [];
+    for (const [c, n] of list) if (!kept.some((k) => dist(parse(k.value), parse(c)) < 14)) kept.push({ value: c, weight: Math.round(n) });
+    return {
+      colors: kept.slice(0, 8),
+      fonts: [...fonts.values()].filter((f) => !/^(-apple-system|system-ui|BlinkMacSystemFont|sans-serif|serif)$/i.test(f.family))
+        .sort((a, b) => b.head + b.text - a.head - a.text).slice(0, 3).map((f) => ({ family: f.family, use: f.head ? 'head' : 'text' })),
+    };
+  }
+  // Elements whose colour is near no brand colour (but not far from everything: photos aside).
+  function brandCheck(brand) {
+    const tokens = (brand || []).map((c) => ({ c, v: parse(c) })).filter((x) => x.v);
+    if (!tokens.length) return [];
+    const out = [];
+    for (const el of els()) {
+      const s = getComputedStyle(el);
+      for (const prop of ['background-color', 'color']) {
+        const v = rgb(s.getPropertyValue(prop));
+        if (!v) continue;
+        if (prop === 'color' && ![...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim())) continue;
+        const near = tokens.map((t) => ({ t, d: dist(t.v, v) })).sort((a, b) => a.d - b.d)[0];
+        // Neutral greys near white/black are the page, not the brand.
+        const grey = Math.max(...v) - Math.min(...v) < 10 && (Math.min(...v) > 236 || Math.max(...v) < 24);
+        if (near.d > 6 && !grey) out.push({ sel: selector(el), name: label(el), prop, value: hex(s.getPropertyValue(prop)), nearest: near.t.c });
+      }
+      if (out.length >= 120) break;
+    }
+    return out;
+  }
+  function brandShow(items) {
+    if (!S.host || !S.host.isConnected) build();
+    S.pins = (items || []).slice(0, 30).map((x, i) => ({ n: i + 1, sel: x.sel, text: x.text || '', who: x.who || '', kind: 'brand' }));
+    drawPins();
+    return true;
+  }
+
+  window.__meridianStudioPoint = {
+    brand: (op, arg) => (op === 'read' ? brandRead() : op === 'check' ? brandCheck(arg) : op === 'show' ? brandShow(arg) : null),
+    start, stop,
+    // What happened since the last call (selected, said, changed by hand, a pin answered, Esc).
+    take: () => { const e = S.events; S.events = []; return { on: S.on, events: e }; },
+    pins: (list) => {
+      S.pins = Array.isArray(list) ? list.slice(0, 30) : [];
+      if (!S.host || !S.host.isConnected) { if (!S.pins.length) return true; build(); $('.hero').hidden = !S.on; }
+      if (!S.on) addEventListener('scroll', redraw, true);
+      drawPins();
+      return true;
+    },
+    // Hand changes Studio has put into the site's Boost: the page's own copy goes.
+    settled: () => { S.live.clear(); document.getElementById('meridian-studio-hand')?.remove(); return true; },
+  };
+})();
