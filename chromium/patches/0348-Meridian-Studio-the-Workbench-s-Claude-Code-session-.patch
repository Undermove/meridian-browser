+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_STUDIO_POINT_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_STUDIO_POINT_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace meridian::workbench {
+
+// Studio's "point and say" on the site it shows next to itself
+// (studio_point.js, in an isolated world of that tab): the person picks
+// elements, says what to change or changes them by hand; Studio's remarks
+// show there as pins. What happens there reaches the Studio page through
+// `emit` ({type: "studio-point", on, events}).
+class StudioPoint {
+ public:
+  explicit StudioPoint(base::RepeatingCallback<void(base::Value)> emit);
+  StudioPoint(const StudioPoint&) = delete;
+  StudioPoint& operator=(const StudioPoint&) = delete;
+  ~StudioPoint();
+
+  // The tab Studio opened the site in (its result).
+  void SetSite(content::WebContents* contents);
+  content::WebContents* site() const { return site_.get(); }
+
+  // On: the overlay in the site's tab (again after it reloads), `config`
+  // its language and colours. False when there is no site tab.
+  bool Start(base::DictValue config);
+  void Stop();
+  bool on() const { return on_; }
+  // Studio's remarks as numbered pins ([{n, sel, text}]).
+  void Pins(base::ListValue pins);
+  // The hand changes are in the site's Boost now: the page's copy goes.
+  void Settled();
+  // The brand (studio_point.js): "read" what the page uses, "check" it
+  // against `arg` (brand colours), "show" places. `done` gets the result
+  // (null without a site tab).
+  void Brand(const std::string& op,
+             base::Value arg,
+             base::OnceCallback<void(base::Value)> done);
+
+ private:
+  void Run(const std::string& script);
+  void Poll();
+  void OnPolled(base::Value result);
+
+  base::RepeatingCallback<void(base::Value)> emit_;
+  base::WeakPtr<content::WebContents> site_;
+  base::DictValue config_;
+  base::ListValue pins_;
+  bool on_ = false;
+  base::RepeatingTimer timer_;
+  base::WeakPtrFactory<StudioPoint> weak_factory_{this};
+};
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_STUDIO_POINT_H_
diff --git a/chrome/browser/meridian/workbench/studio_point.js b/chrome/browser/meridian/workbench/studio_point.js
new file mode 100644
index 0000000000..d0a28f01f5
--- /dev/null
+++ b/chrome/browser/meridian/workbench/studio_point.js
@@ -0,0 +1,494 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Studio's "point and say" on the site next to it (runs in an isolated world
+// of that tab; studio_point.cc). Hover outlines the element under the
+// pointer; a click picks it (Shift adds more): a frame with its name, a field
+// to say what to change, and handles to change it by hand (colour, text size,
+// corner radius, spacing). Hand changes show at once in the page and go out
+// as events (Studio puts them into the site's Boost); so do the words. Studio's
+// remarks show as numbered pins on their elements. Esc ends it.
+//   window.__meridianStudioPoint.start(cfg) / .stop() / .take() / .pins(list)
+(() => {
+  if (window.__meridianStudioPoint) return;
+  const S = { on: false, sel: [], events: [], pins: [], cfg: {}, hover: null, host: null, root: null, live: new Map(), open: -1 };
+  const T = {
+    ru: { button: 'Кнопка', link: 'Ссылка', heading: 'Заголовок', image: 'Картинка', text: 'Текст', field: 'Поле', menu: 'Меню', block: 'Блок', card: 'Карточка',
+      more: (n) => `+ ещё ${n}`, say: 'Скажите, что поменять…', chips: ['Крупнее', 'Мельче', 'В цвет бренда', 'Убрать'], all: 'Все такие — одинаковыми',
+      color: 'Цвет', size: 'Текст', radius: 'Скругление', space: 'Отступы', site: 'цвета сайта', note: 'Сразу на странице, через Boost — можно отменить. Claude узнает, что вы поменяли.',
+      hero: 'Ткни и скажи', esc: 'Esc — выйти', yes: 'Да', no: 'Нет' },
+    en: { button: 'Button', link: 'Link', heading: 'Heading', image: 'Picture', text: 'Text', field: 'Field', menu: 'Menu', block: 'Block', card: 'Card',
+      more: (n) => `+ ${n} more`, say: 'Say what to change…', chips: ['Bigger', 'Smaller', 'In brand colour', 'Remove'], all: 'Make all like it the same',
+      color: 'Colour', size: 'Text', radius: 'Corners', space: 'Spacing', site: 'site colours', note: 'Right on the page, through Boost — can be undone. Claude learns what you changed.',
+      hero: 'Point and say', esc: 'Esc — exit', yes: 'Yes', no: 'No' },
+  };
+  const w = () => T[S.cfg.lang === 'ru' ? 'ru' : 'en'];
+  const css = (s) => (window.CSS && CSS.escape ? CSS.escape(s) : String(s).replace(/[^\w-]/g, '\\$&'));
+
+  // ---- what an element is called, and a selector that finds it again
+  function kind(el) {
+    const t = el.tagName.toLowerCase();
+    const role = el.getAttribute('role');
+    if (t === 'button' || role === 'button' || (t === 'a' && /btn|button/i.test(el.className))) return w().button;
+    if (t === 'a') return w().link;
+    if (/^h[1-6]$/.test(t)) return w().heading;
+    if (t === 'img' || t === 'svg' || t === 'picture' || t === 'video') return w().image;
+    if (t === 'input' || t === 'textarea' || t === 'select') return w().field;
+    if (t === 'nav' || t === 'header') return w().menu;
+    if (/card|item|product/i.test(el.className)) return w().card;
+    // Looks like a button: a short label on a filled, rounded shape.
+    const cs = getComputedStyle(el);
+    const filled = !/rgba\(.*, 0\)$|transparent/.test(cs.backgroundColor) || parseFloat(cs.borderTopWidth) > 0;
+    if (filled && parseFloat(cs.borderTopLeftRadius) >= 6 && (el.innerText || '').trim().length <= 40 && el.children.length <= 2 && el.getBoundingClientRect().height <= 64) return w().button;
+    if (t === 'p' || t === 'span' || t === 'li' || t === 'label') return w().text;
+    return w().block;
+  }
+  function label(el) {
+    const text = (el.getAttribute('aria-label') || el.innerText || el.getAttribute('alt') || el.getAttribute('placeholder') || '').replace(/\s+/g, ' ').trim();
+    const k = kind(el);
+    return text ? `${k} · «${text.length > 28 ? text.slice(0, 27) + '…' : text}»` : k;
+  }
+  function selector(el) {
+    if (el.id && document.querySelectorAll('#' + css(el.id)).length === 1) return '#' + css(el.id);
+    const parts = [];
+    for (let e = el; e && e.nodeType === 1 && e !== document.documentElement; e = e.parentElement) {
+      let p = e.tagName.toLowerCase();
+      if (e.id && document.querySelectorAll('#' + css(e.id)).length === 1) { parts.unshift('#' + css(e.id)); break; }
+      const same = e.parentElement ? [...e.parentElement.children].filter((c) => c.tagName === e.tagName) : [];
+      if (same.length > 1) p += `:nth-of-type(${same.indexOf(e) + 1})`;
+      parts.unshift(p);
+      if (e === document.body) break;
+    }
+    return parts.join(' > ');
+  }
+  // The elements "like it": the same tag and the same classes.
+  function alike(el) {
+    const cls = [...el.classList].filter((c) => /^[\w-]+$/.test(c)).slice(0, 4);
+    const sel = el.tagName.toLowerCase() + cls.map((c) => '.' + css(c)).join('');
+    try { return [...document.querySelectorAll(sel)].filter(visible).slice(0, 60); } catch { return [el]; }
+  }
+  const visible = (el) => { const r = el.getBoundingClientRect(); return r.width > 2 && r.height > 2; };
+  const ours = (el) => el === S.host || S.host?.contains(el);
+
+  // ---- the page's own colours (until a brand is connected)
+  function palette() {
+    if (Array.isArray(S.cfg.colors) && S.cfg.colors.length) return S.cfg.colors.slice(0, 8);
+    const count = new Map();
+    const add = (c, n) => { if (!c || /rgba\(.*, 0\)$/.test(c) || c === 'transparent') return; count.set(c, (count.get(c) || 0) + n); };
+    for (const el of [...document.querySelectorAll('body *')].slice(0, 1500)) {
+      if (ours(el) || !visible(el)) continue;
+      const s = getComputedStyle(el);
+      const r = el.getBoundingClientRect();
+      add(s.backgroundColor, Math.min(40, (r.width * r.height) / 4000));
+      add(s.color, 1);
+    }
+    return [...count.entries()].sort((a, b) => b[1] - a[1]).slice(0, 7).map(([c]) => c);
+  }
+
+  // ---- the overlay (closed shadow root: the page can't style or read it)
+  const STYLE = `
+    :host { all: initial; }
+    * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif; }
+    .layer { position: fixed; inset: 0; pointer-events: none; z-index: 2147483646; }
+    .hover { position: fixed; border: 1.5px solid #6d6fd6; border-radius: 6px; opacity: 0; transition: opacity 120ms ease-out; }
+    .hover.on { opacity: .7; }
+    .frame { position: fixed; left: 0; top: 0; border-radius: 8px; outline: 1.5px solid #6d6fd6; outline-offset: 2px; box-shadow: 0 0 0 5.5px rgba(109,111,214,.14);
+      transition: transform 260ms cubic-bezier(.2,1.25,.4,1), width 260ms cubic-bezier(.2,1.25,.4,1), height 260ms cubic-bezier(.2,1.25,.4,1); }
+    .frame.more { outline-color: rgba(109,111,214,.6); box-shadow: none; }
+    .tag { position: fixed; left: 0; top: 0; font-size: 11px; font-weight: 600; color: #fff; background: #6d6fd6; padding: 3px 8px; border-radius: 6px; white-space: nowrap;
