+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/studio.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::workbench {
+namespace {
+
+TEST(StudioTest, TranscriptComesInWholeLinesAndStartsOverWhenItShrinks) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::FilePath file = dir.GetPath().AppendASCII("s.jsonl");
+  ASSERT_TRUE(base::WriteFile(file, "{\"a\":1}\n{\"b\":2}\n{\"c\""));
+  base::DictValue first = ReadTranscriptChunk(file, 0);
+  EXPECT_EQ(*first.FindString("text"), "{\"a\":1}\n{\"b\":2}\n");
+  EXPECT_EQ(first.FindDouble("next").value_or(-1), 16);
+  // Nothing new yet: the half-written line waits.
+  base::DictValue again = ReadTranscriptChunk(file, 16);
+  EXPECT_EQ(*again.FindString("text"), "");
+  EXPECT_EQ(again.FindDouble("next").value_or(-1), 16);
+  // A shorter file (another session): from the start.
+  ASSERT_TRUE(base::WriteFile(file, "{\"x\":1}\n"));
+  base::DictValue reset = ReadTranscriptChunk(file, 16);
+  EXPECT_TRUE(reset.FindBool("reset").value_or(false));
+  EXPECT_EQ(*reset.FindString("text"), "{\"x\":1}\n");
+  // No file: nothing, no error.
+  EXPECT_EQ(*ReadTranscriptChunk(dir.GetPath().AppendASCII("none"), 0)
+                 .FindString("text"),
+            "");
+}
+
+TEST(StudioTest, TermsOnlyOfThisPageWithTheirQuestions) {
+  std::optional<base::Value> snapshot = base::JSONReader::Read(R"({
+    "nodes": [
+      {"id": "n1", "termId": "t1", "ownerTab": 7, "status": "waiting",
+       "statusText": "Needs you", "log": [{"name": "Read", "summary": "a.md"}]},
+      {"id": "n2", "termId": "t1", "ownerTab": 9, "status": "thinking"},
+      {"id": "n3", "termId": "t2", "ownerTab": 7, "parentId": "n1",
+       "status": "tool"}
+    ],
+    "asks": [
+      {"id": "q1", "nodeId": "n1", "tool": "Edit", "summary": "Brand/a.css",
+       "answerable": true, "canAlways": true},
+      {"id": "q2", "nodeId": "n2", "tool": "Bash", "summary": "rm -rf /"}
+    ]})", 0);
+  ASSERT_TRUE(snapshot);
+  base::DictValue terms = StudioTerms(snapshot->GetDict(), 7, {"t1", "t2"});
+  ASSERT_EQ(terms.size(), 1u);
+  const base::DictValue* t1 = terms.FindDict("t1");
+  ASSERT_TRUE(t1);
+  EXPECT_EQ(*t1->FindString("status"), "waiting");
+  ASSERT_EQ(t1->FindList("asks")->size(), 1u);
+  EXPECT_EQ(*(*t1->FindList("asks"))[0].GetDict().FindString("id"), "q1");
+  EXPECT_EQ(t1->FindList("log")->size(), 1u);
+}
+
+TEST(StudioTest, RulesKeepOriginalsAndAvoidJargon) {
+  const std::string rules = StudioRules();
+  EXPECT_NE(rules.find("Never overwrite"), std::string::npos);
+  EXPECT_NE(rules.find("without asking first"), std::string::npos);
+}
+
+}  // namespace
+}  // namespace meridian::workbench
