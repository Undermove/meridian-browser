+namespace meridian::workbench {
+
+bool StudioEnabled(Profile* profile) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "enable-meridian-studio") ||
+      HasTestSwitch("meridian-studio")) {
+    return true;
+  }
+  return profile &&
+         MainProfileFor(profile)->GetPrefs()->GetBoolean(prefs::kStudioEnabled);
+}
+
+StudioPoint* WorkbenchHandler::studio_point() {
+  if (!studio_point_) {
+    studio_point_ = std::make_unique<StudioPoint>(base::BindRepeating(
+        [](base::WeakPtr<WorkbenchHandler> self, base::Value event) {
+          if (self) {
+            self->Emit("wb:command", std::move(event));
+          }
+        },
+        weak_factory_.GetWeakPtr()));
+  }
+  return studio_point_.get();
+}
+
+void WorkbenchHandler::DispatchStudio(const std::string& method,
+                                      const base::ListValue& params,
+                                      Reply reply) {
+  auto str = [&](size_t i) {
+    return i < params.size() && params[i].is_string() ? params[i].GetString()
+                                                      : std::string();
+  };
+  const bool on = StudioEnabled(profile_);
+  if (method == "studioInfo") {
+    base::DictValue info;
+    info.Set("enabled", on);
+    if (!on) {
+      return std::move(reply).Run(base::Value(std::move(info)));
+    }
+    info.Set("figma", MainProfileFor(profile_)->GetPrefs()->GetBoolean(
+                          prefs::kStudioFigma));
+    // Picked in "Кто вы?", else a guess (the tour's): the picker starts on it.
+    const std::string chosen =
+        MainProfileFor(profile_)->GetPrefs()->GetString(prefs::kStudioPersona);
+    info.Set("chosen", !chosen.empty());
+    std::string forced = TestSwitchValue("meridian-test-persona");
+    // "Кто вы?" shows until the person picks (tests that name a persona skip
+    // it).
+    info.Set("ask", chosen.empty() && forced.empty());
+    if (!chosen.empty() || !forced.empty() ||
+        MainProfileFor(profile_)->GetPrefs()->GetString(prefs::kMode) ==
+            "developer") {
+      info.Set("persona", !chosen.empty()   ? chosen
+                          : !forced.empty() ? forced
+                                            : std::string("developer"));
+      return std::move(reply).Run(base::Value(std::move(info)));
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(
+            [] { return GuessPersona(InstalledApps(), StrongDevSignals()); }),
+        base::BindOnce(
+            [](Reply reply, base::DictValue info, std::string persona) {
+              info.Set("persona", persona);
+              std::move(reply).Run(base::Value(std::move(info)));
+            },
+            std::move(reply), std::move(info)));
+    return;
+  }
+  if (!on) {
+    return std::move(reply).Run(base::unexpected("Studio is off."));
+  }
+  if (method == "studioFigma") {
+    // Connect (true) or disconnect Figma for Studio's next tasks.
+    const bool connect =
+        !params.empty() && params[0].is_bool() && params[0].GetBool();
+    MainProfileFor(profile_)->GetPrefs()->SetBoolean(prefs::kStudioFigma,
+                                                     connect);
+    return std::move(reply).Run(base::Value(connect));
+  }
+  if (method == "studioSetPersona") {
+    const std::string persona = str(0);
+    if (persona != "developer" && persona != "designer" &&
+        persona != "manager" && persona != "everyday") {
+      return std::move(reply).Run(base::unexpected("Not a persona."));
+    }
+    MainProfileFor(profile_)->GetPrefs()->SetString(prefs::kStudioPersona,
+                                                    persona);
+    return std::move(reply).Run(base::Value(true));
+  }
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(web_ui()->GetWebContents());
+  const int self = tab ? tab->GetHandle().raw_value() : 0;
+  mission::MissionControl* mission =
+      mission::MissionControlFactory::GetForProfile(profile_);
+  if (method == "studioTranscript") {
+    // Only a terminal of this page, and only its own session's transcript.
+    const std::string term = str(0);
+    if (!terms_.contains(term) || !mission) {
+      return std::move(reply).Run(base::unexpected("No such terminal."));
+    }
+    const std::string path = mission->TranscriptOf(self, term);
+    const int64_t offset =
+        params.size() > 1 && params[1].is_double()
+            ? static_cast<int64_t>(params[1].GetDouble())
+            : (params.size() > 1 && params[1].is_int() ? params[1].GetInt()
+                                                       : 0);
+    if (path.empty()) {
+      return std::move(reply).Run(base::Value(base::DictValue()
+                                                  .Set("size", 0)
+                                                  .Set("next", 0)
+                                                  .Set("text", "")
+                                                  .Set("reset", false)));
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ReadTranscriptChunk, base::FilePath::FromUTF8Unsafe(path),
+                       offset),
+        base::BindOnce(
+            [](Reply reply, base::DictValue chunk) {
+              std::move(reply).Run(base::Value(std::move(chunk)));
+            },
+            std::move(reply)));
+    return;
+  }
+  if (method == "studioAnswer") {
+    // A question of one of this page's sessions, answered from the chat.
+    const std::string id = str(0);
+    const std::string choice = str(1);
+    if (!mission || !(choice == "allow" || choice == "deny" ||
+                      choice == "session")) {
+      return std::move(reply).Run(base::unexpected("Not an answer."));
+    }
+    std::set<std::string> ids;
+    for (const auto& [term_id, term] : terms_) {
+      ids.insert(term_id);
+    }
+    const base::DictValue terms = StudioTerms(mission->Snapshot(), self, ids);
+    bool ours = false;
+    for (const auto [term_id, entry] : terms) {
+      for (const base::Value& a : *entry.GetDict().FindList("asks")) {
+        const std::string* ask_id = a.GetDict().FindString("id");
+        ours = ours || (ask_id && *ask_id == id);
+      }
+    }
+    if (!ours) {
+      return std::move(reply).Run(base::unexpected("That question is gone."));
+    }
+    return std::move(reply).Run(
+        base::Value(mission->AnswerPermission(id, choice)));
+  }
+  if (method == "studioPoint") {
+    // Point and say on the site tab Studio opened (studio_point.h).
+    const std::string op = str(0);
+    StudioPoint* point = studio_point();
+    if (op == "start") {
+      base::DictValue config;
+      if (params.size() > 1 && params[1].is_dict()) {
+        config = params[1].GetDict().Clone();
+      }
+      return std::move(reply).Run(base::Value(point->Start(std::move(config))));
+    }
+    if (op == "stop") {
+      point->Stop();
+      return std::move(reply).Run(base::Value(true));
+    }
+    if (op == "pins") {
+      base::ListValue pins;
+      if (params.size() > 1 && params[1].is_list()) {
+        for (const base::Value& p : params[1].GetList()) {
+          if (p.is_dict() && pins.size() < 30) {
+            pins.Append(p.Clone());
+          }
+        }
+      }
+      point->Pins(std::move(pins));
+      return std::move(reply).Run(base::Value(true));
+    }
+    if (op == "brand") {
+      // {op: "read" | "check" | "show", arg}: the brand on the site tab.
+      const base::DictValue* d =
+          params.size() > 1 && params[1].is_dict() ? &params[1].GetDict()
+                                                   : nullptr;
+      const std::string* what = d ? d->FindString("op") : nullptr;
+      if (!what || !(*what == "read" || *what == "check" || *what == "show")) {
+        return std::move(reply).Run(base::unexpected("Unknown brand action."));
+      }
+      const base::Value* arg = d->Find("arg");
+      point->Brand(*what, arg ? arg->Clone() : base::Value(),
+                   base::BindOnce(
+                       [](Reply reply, base::Value result) {
+                         std::move(reply).Run(std::move(result));
+                       },
+                       std::move(reply)));
+      return;
+    }
+    if (op == "settled") {
+      point->Settled();
+      return std::move(reply).Run(base::Value(true));
+    }
+    if (op == "site") {
+      content::WebContents* site = point->site();
+      return std::move(reply).Run(base::Value(
+          base::DictValue()
+              .Set("open", !!site)
+              .Set("on", point->on())
+              .Set("url", site ? site->GetLastCommittedURL().spec()
+                               : std::string())));
+    }
+    return std::move(reply).Run(base::unexpected("Unknown point action."));
+  }
+  if (method == "studioBoost") {
+    // The result pane's Boost: what the site has now (to put back), До/После
+    // (the boost on or off) and "undo" (the site as it was before the task).
+    const std::string op = str(0);
+    const std::string host = str(1);
+    if (host.empty() || BoostHostFor(GURL("https://" + host)) != host) {
+      return std::move(reply).Run(base::unexpected("Not a site."));
+    }
+    BoostService* service = BoostServiceFactory::GetForProfile(profile_);
+    if (!service) {
+      return std::move(reply).Run(base::unexpected("Boosts are unavailable."));
+    }
+    auto list = [&] {
+      base::ListValue all;
+      for (const Boost* b : service->AllForHost(host)) {
+        if (b->host == host) {
+          all.Append(b->ToValue());
+        }
+      }
+      return all;
+    };
+    if (op == "get") {
+      return std::move(reply).Run(base::Value(list()));
+    }
+    if (op == "enable") {
+      const std::string id = str(2);
+      const bool enabled =
+          params.size() > 3 && params[3].is_bool() && params[3].GetBool();
+      for (const Boost& b : service->boosts()) {
+        if (b.id == id && b.host == host) {
+          Boost copy = b;
+          copy.enabled = enabled;
+          service->Set(std::move(copy));
+          return std::move(reply).Run(base::Value(list()));
+        }
+      }
+      return std::move(reply).Run(base::unexpected("No such boost."));
+    }
+    if (op == "hand") {
+      // The person's hand changes (point and say), as the CSS of a boost of
+      // their own; the site's first boost stays the one agents change.
+      const std::string id = "studio-hand-" + host;
+      const std::string css = str(2);
+      if (css.size() > 200000) {
+        return std::move(reply).Run(base::unexpected("Too much CSS."));
+      }
+      const Boost* hand = nullptr;
+      for (const Boost& b : service->boosts()) {
+        if (b.id == id) {
+          hand = &b;
+        }
+      }
+      if (css.empty()) {
+        if (hand) {
+          service->Remove(id);
+        }
+        return std::move(reply).Run(base::Value(list()));
+      }
+      if (!hand && service->AllForHost(host).empty()) {
+        Boost site;
+        site.host = host;
+        site.name = host;
+        service->Set(std::move(site));
+      }
+      Boost boost = hand ? *hand : Boost();
+      boost.id = id;
+      boost.host = host;
+      boost.name = "Studio · " + host;
+      boost.enabled = true;
+      boost.css = css;
+      service->Set(std::move(boost));
+      return std::move(reply).Run(base::Value(list()));
+    }
+    if (op == "restore") {
+      // The site's boosts exactly as they were.
+      if (params.size() < 3 || !params[2].is_list()) {
+        return std::move(reply).Run(base::unexpected("Nothing to restore."));
+      }
+      std::vector<Boost> before;
+      for (const base::Value& v : params[2].GetList()) {
+        if (!v.is_dict()) {
+          continue;
+        }
+        std::optional<Boost> b = Boost::FromValue(v.GetDict());
+        if (b && b->host == host) {
+          before.push_back(std::move(*b));
+        }
+      }
+      std::vector<std::string> now;
+      for (const Boost* b : service->AllForHost(host)) {
+        if (b->host == host) {
+          now.push_back(b->id);
+        }
+      }
+      for (const std::string& id : now) {
+        service->Remove(id);
+      }
+      for (Boost& b : before) {
+        service->Set(std::move(b));
+      }
+      return std::move(reply).Run(base::Value(list()));
+    }
+    return std::move(reply).Run(base::unexpected("Unknown boost action."));
+  }
+  std::move(reply).Run(base::unexpected("Unknown method: " + method));
+}
+
