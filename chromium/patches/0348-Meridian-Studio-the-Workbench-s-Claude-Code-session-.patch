+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/studio_point.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/meridian/agent/agent_embed.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+// The overlay's object, (re)made when the page has none (a new page).
+std::string Ensure() {
+  return std::string(kStudioPointJs) + "\n";
+}
+
+}  // namespace
+
+StudioPoint::StudioPoint(base::RepeatingCallback<void(base::Value)> emit)
+    : emit_(std::move(emit)) {}
+
+StudioPoint::~StudioPoint() = default;
+
+void StudioPoint::SetSite(content::WebContents* contents) {
+  site_ = contents ? contents->GetWeakPtr() : nullptr;
+}
+
+void StudioPoint::Run(const std::string& script) {
+  content::WebContents* contents = site_.get();
+  if (!contents) {
+    return;
+  }
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(script), base::NullCallback(),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+bool StudioPoint::Start(base::DictValue config) {
+  if (!site_) {
+    return false;
+  }
+  config_ = std::move(config);
+  on_ = true;
+  Run(Ensure() + "window.__meridianStudioPoint.start(" +
+      base::WriteJson(config_).value_or("{}") + ");" +
+      "window.__meridianStudioPoint.pins(" +
+      base::WriteJson(pins_).value_or("[]") + ");");
+  timer_.Start(FROM_HERE, base::Milliseconds(200), this, &StudioPoint::Poll);
+  return true;
+}
+
+void StudioPoint::Stop() {
+  on_ = false;
+  timer_.Stop();
+  Run("window.__meridianStudioPoint && window.__meridianStudioPoint.stop();");
+}
+
+void StudioPoint::Pins(base::ListValue pins) {
+  pins_ = std::move(pins);
+  Run(Ensure() + "window.__meridianStudioPoint.pins(" +
+      base::WriteJson(pins_).value_or("[]") + ");");
+}
+
+void StudioPoint::Settled() {
+  Run("window.__meridianStudioPoint && window.__meridianStudioPoint.settled();");
+}
+
+void StudioPoint::Brand(const std::string& op,
+                        base::Value arg,
+                        base::OnceCallback<void(base::Value)> done) {
+  content::WebContents* contents = site_.get();
+  if (!contents) {
+    return std::move(done).Run(base::Value());
+  }
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(Ensure() + "window.__meridianStudioPoint.brand(" +
+                        base::WriteJson(base::Value(op)).value_or("\"\"") +
+                        ", " + base::WriteJson(arg).value_or("null") + ");"),
+      std::move(done), ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void StudioPoint::Poll() {
+  content::WebContents* contents = site_.get();
+  if (!contents) {
+    on_ = false;
+    timer_.Stop();
+    emit_.Run(base::Value(base::DictValue()
+                              .Set("type", "studio-point")
+                              .Set("on", false)
+                              .Set("gone", true)
+                              .Set("events", base::ListValue())));
+    return;
+  }
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      u"window.__meridianStudioPoint ? window.__meridianStudioPoint.take() : "
+      u"null",
+      base::BindOnce(&StudioPoint::OnPolled, weak_factory_.GetWeakPtr()),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void StudioPoint::OnPolled(base::Value result) {
+  if (!on_) {
+    return;
+  }
+  // A new page: the overlay again, as it was.
+  if (!result.is_dict()) {
+    Run(Ensure() + "window.__meridianStudioPoint.start(" +
+        base::WriteJson(config_).value_or("{}") + ");" +
+        "window.__meridianStudioPoint.pins(" +
+        base::WriteJson(pins_).value_or("[]") + ");");
+    return;
+  }
+  const base::ListValue* events = result.GetDict().FindList("events");
+  const bool still = result.GetDict().FindBool("on").value_or(false);
+  if (!still) {
+    on_ = false;
+    timer_.Stop();
+  }
+  if ((events && !events->empty()) || !still) {
+    emit_.Run(base::Value(
+        base::DictValue()
+            .Set("type", "studio-point")
+            .Set("on", still)
+            .Set("events", events ? events->Clone() : base::ListValue())));
+  }
+}
+
+}  // namespace meridian::workbench
