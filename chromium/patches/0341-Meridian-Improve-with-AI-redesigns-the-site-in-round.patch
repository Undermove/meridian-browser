+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './boost_magic.css.js';
+import {getHtml} from './boost_magic.html.js';
+
+// What the Boost editor says about a running Improve with AI.
+export interface BoostMagicState {
+  // 'running' while the AI works, 'done' when it finished (Undo offered),
+  // 'off' to go away (an error, Undo, the editor closed).
+  state: 'running'|'done'|'off';
+  // "Designing… 1/3" and what the round is about.
+  label?: string;
+  detail?: string;
+  // Rounds whose CSS reached the page: each one is revealed softly.
+  applied?: number;
+  undo?: () => void;
+}
+
+// "Magic in progress" over the page while Improve with AI runs: an
+// iridescent glow sweeping round the page's edges, a faint shimmer over it, a
+// status pill with the round, a soft reveal when a round's CSS lands, and a
+// short "Done" with Undo. Drawn by the browser over the tab (never in the
+// page, so never in the screenshots the AI gets); it never takes the pointer
+// except the pill's Undo. Only transform and opacity move; with reduced
+// motion it stands still.
+export class MeridianBoostMagicElement extends CrLitElement {
+  static get is() {
+    return 'meridian-boost-magic';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      state: {type: String, reflect: true},
+      label_: {state: true, type: String},
+      detail_: {state: true, type: String},
+      veil_: {state: true, type: Boolean},
+    };
+  }
+
+  // Reflected: the styles follow it.
+  accessor state: 'running'|'done'|'off' = 'off';
+  protected accessor label_: string = '';
+  protected accessor detail_: string = '';
+  protected accessor veil_: boolean = false;
+  private target_: HTMLElement|null = null;
+  private applied_: number = 0;
+  private undo_: (() => void)|null = null;
+  private doneTimer_: number = 0;
+  private resize_: ResizeObserver|null = null;
+  private onWindowResize_ = () => this.place_();
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    this.unwatch_();
+    clearTimeout(this.doneTimer_);
+  }
+
+  // Over `target` (the page's area), as `s` says.
+  show(s: BoostMagicState, target: HTMLElement) {
+    clearTimeout(this.doneTimer_);
+    if (s.state === 'off') {
+      this.state = 'off';
+      this.unwatch_();
+      return;
+    }
+    if (this.state === 'off') {
+      this.applied_ = 0;
+    }
+    this.target_ = target;
+    this.watch_();
+    this.place_();
+    if (s.state === 'running') {
+      this.label_ = s.label || 'Designing…';
+      this.detail_ = s.detail || '';
+      if ((s.applied || 0) > this.applied_) {
+        this.reveal_();
+      }
+      this.applied_ = s.applied || 0;
+    }
+    if (s.state === 'done') {
+      if (this.state === 'running') {
+        this.reveal_();
+      }
+      this.undo_ = s.undo || null;
+      // A moment to enjoy it, then it goes.
+      this.doneTimer_ = setTimeout(() => {
+        this.state = 'off';
+        this.unwatch_();
+      }, 4500);
+    }
+    this.state = s.state;
+  }
+
+  // The new look comes in from under a soft veil (no hard flash).
+  private reveal_() {
+    this.veil_ = false;
+    requestAnimationFrame(() => {
+      this.veil_ = true;
+    });
+  }
+
+  protected onVeilAnimationend_() {
+    this.veil_ = false;
+  }
+
+  protected onUndoClick_() {
+    const undo = this.undo_;
+    this.undo_ = null;
+    this.state = 'off';
+    this.unwatch_();
+    undo?.();
+  }
+
+  private place_() {
+    if (!this.target_) {
+      return;
+    }
+    const r = this.target_.getBoundingClientRect();
+    this.style.left = `${r.left}px`;
+    this.style.top = `${r.top}px`;
+    this.style.width = `${r.width}px`;
+    this.style.height = `${r.height}px`;
+  }
+
+  private watch_() {
+    if (this.resize_ || !this.target_) {
+      return;
+    }
+    this.resize_ = new ResizeObserver(() => this.place_());
+    this.resize_.observe(this.target_);
+    window.addEventListener('resize', this.onWindowResize_);
+  }
+
+  private unwatch_() {
+    this.resize_?.disconnect();
+    this.resize_ = null;
+    window.removeEventListener('resize', this.onWindowResize_);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-boost-magic': MeridianBoostMagicElement;
+  }
+}
+
+customElements.define(MeridianBoostMagicElement.is, MeridianBoostMagicElement);
