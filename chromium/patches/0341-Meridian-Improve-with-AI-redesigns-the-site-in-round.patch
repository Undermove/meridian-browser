+TEST(ProvidersTest, ClaudeCodeGetsScreenshotsAsOneStreamJsonMessage) {
+  Turn turn;
+  turn.prompt = "Redesign it.";
+  CommandSpec plain =
+      BuildCommand(*FindProvider("claude-code"), turn, "/tmp/x");
+  EXPECT_EQ(plain.stdin_text, "Redesign it.");
+  EXPECT_EQ(std::ranges::find(plain.args, "--input-format"), plain.args.end());
+
+  turn.images = {"AAAA"};
+  CommandSpec spec = BuildCommand(*FindProvider("claude-code"), turn, "/tmp/x");
+  auto at = std::ranges::find(spec.args, "--input-format");
+  ASSERT_NE(at, spec.args.end());
+  EXPECT_EQ(*(at + 1), "stream-json");
+  // Still no tools: the picture is in the message, not a file to read.
+  auto tools = std::ranges::find(spec.args, "--tools");
+  ASSERT_NE(tools, spec.args.end());
+  EXPECT_EQ(*(tools + 1), "");
+  ASSERT_TRUE(spec.stdin_text);
+  EXPECT_TRUE(spec.stdin_text->ends_with("\n"));
+  std::optional<base::Value> line = base::JSONReader::Read(*spec.stdin_text, 0);
+  ASSERT_TRUE(line && line->is_dict());
+  EXPECT_EQ(*line->GetDict().FindString("type"), "user");
+  const base::ListValue* content =
+      line->GetDict().FindListByDottedPath("message.content");
+  ASSERT_TRUE(content);
+  ASSERT_EQ(content->size(), 2u);
+  EXPECT_EQ(*(*content)[0].GetDict().FindString("type"), "image");
+  EXPECT_EQ(*(*content)[0].GetDict().FindStringByDottedPath("source.data"),
+            "AAAA");
+  EXPECT_EQ(*(*content)[1].GetDict().FindString("text"), "Redesign it.");
