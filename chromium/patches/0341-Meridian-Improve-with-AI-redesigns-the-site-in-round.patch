+#include "chrome/browser/meridian/boosts/boost_service_factory.h"
+#include "chrome/browser/meridian/space_profiles.h"
+#include "chrome/browser/meridian/tab_data.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "components/viz/common/frame_sinks/copy_output_result.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/codec/jpeg_codec.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/image/image_skia_operations.h"
+
+namespace meridian {
+
+namespace {
+
+// No round after the first starts this late, and one running then is
+// stopped (its CSS so far is kept).
+constexpr base::TimeDelta kNoNewRoundAfter = base::Seconds(50);
+constexpr base::TimeDelta kDeadline = base::Seconds(90);
+// The first round alone: past this, Improve gives up.
+constexpr base::TimeDelta kFirstRoundLimit = base::Seconds(170);
+// For the page to take the CSS (and its fonts) before the screenshot.
+constexpr base::TimeDelta kSettle = base::Milliseconds(900);
+// Screenshots at most this wide (CSS pixels at 1x are enough to judge).
+constexpr int kShotWidth = 1280;
+
+// The page measured for a designer: what boost_ai::ContextText reads.
+constexpr char kContext[] = R"JS((() => {
+  const vw = innerWidth, vh = innerHeight, screen = vw * vh;
+  const stable = (c) => c && !/\d{3}|[_-][a-zA-Z0-9]{5,}$|^css-|^sc-|^jsx-/.test(c);
+  const q = (s) => String(s).replace(/["\\]/g, '\\$&').slice(0, 40);
+  const name = (el) => {
+    let d = el.localName;
+    if (el.id && stable(el.id)) return d + '#' + CSS.escape(el.id);
+    const cs = [...el.classList].filter(stable).slice(0, 2);
+    if (cs.length) d += cs.map((c) => '.' + CSS.escape(c)).join('');
+    const role = el.getAttribute('role');
+    if (role) d += `[role="${q(role)}"]`;
+    else if (el.getAttribute('data-testid')) d += `[data-testid="${q(el.getAttribute('data-testid'))}"]`;
+    return d;
+  };
+  const path = (el) => {
+    const own = name(el);
+    if (own.includes('#') || !el.parentElement || el.parentElement === document.body) return own;
+    return name(el.parentElement) + ' > ' + own;
+  };
+  const rgb = (c) => {
+    const m = c && c.match(/rgba?\(([\d.]+)[, ]+([\d.]+)[, ]+([\d.]+)(?:[,/ ]+([\d.]+%?))?\)/);
+    if (!m) return null;
+    const a = m[4] === undefined ? 1 : m[4].endsWith('%') ? parseFloat(m[4]) / 100 : +m[4];
+    return a < 0.06 ? null : [+m[1], +m[2], +m[3], a];
+  };
+  const hex = (v) => '#' + v.slice(0, 3).map((n) => Math.round(n).toString(16).padStart(2, '0')).join('') +
+      (v[3] < 0.98 ? Math.round(v[3] * 255).toString(16).padStart(2, '0') : '');
+  const lin = (v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
+  const lum = (v) => 0.2126 * lin(v[0] / 255) + 0.7152 * lin(v[1] / 255) + 0.0722 * lin(v[2] / 255);
+  const chroma = (v) => Math.max(v[0], v[1], v[2]) - Math.min(v[0], v[1], v[2]);
+  const visible = (r) => r.width > 0 && r.height > 0 && r.bottom > 0 && r.right > 0 && r.top < vh * 3 && r.left < vw;
+  const seen = (r) => Math.max(0, Math.min(r.right, vw) - Math.max(r.left, 0)) * Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
+  const count = (map, key, n = 1, extra) => { const e = map.get(key) || { n: 0, ...extra }; e.n += n; map.set(key, e); return e; };
+  const top = (map, k) => [...map.entries()].sort((a, b) => b[1].n - a[1].n).slice(0, k);
+  const own = (el) => [...el.childNodes].filter((n) => n.nodeType === 3).map((n) => n.textContent.trim()).join(' ').replace(/\s+/g, ' ');
+
+  const out = { viewport: { w: vw, h: vh, dpr: devicePixelRatio } };
+  if (!document.body) return out;
+  const pageBg = rgb(getComputedStyle(document.body).backgroundColor) || rgb(getComputedStyle(document.documentElement).backgroundColor) || [255, 255, 255, 1];
+  out.scheme = lum(pageBg) < 0.2 ? 'dark' : 'light';
+  out.prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
+
+  // Theme variables and whether the site follows the system's theme.
+  const vars = new Map();
+  const addVars = (style, el) => {
+    for (let i = 0; i < style.length && vars.size < 160; i++) {
+      const p = style[i];
+      if (p.startsWith('--') && !p.startsWith('--meridian') && !vars.has(p)) {
+        const v = getComputedStyle(el).getPropertyValue(p).trim();
+        if (v && v.length < 120) vars.set(p, v);
+      }
+    }
+  };
+  let follows = false;
+  const scan = (rules, depth) => {
+    for (const r of rules) {
+      if (r.media && /prefers-color-scheme/.test(r.media.mediaText)) follows = true;
+      if (r.style && /^(:root|html|body|:host)\b|\[data-theme|\.theme|\.dark|\.light/.test(r.selectorText || '')) addVars(r.style, document.documentElement);
+      if (r.cssRules && depth < 3) scan(r.cssRules, depth + 1);
+    }
+  };
+  for (const sheet of document.styleSheets) {
+    if (sheet.ownerNode?.id?.startsWith('meridian')) continue;
+    try { scan(sheet.cssRules, 0); } catch {}
+  }
+  addVars(getComputedStyle(document.documentElement), document.documentElement);
+  addVars(getComputedStyle(document.body), document.body);
+  const colorish = (v) => /#|rgb|hsl|oklch|lab\(|color/.test(v);
+  out.vars = [...vars.entries()].sort((a, b) => colorish(b[1]) - colorish(a[1]))
+      .slice(0, 80).map(([n, v]) => ({ name: n, value: v }));
+  out.followsSystem = follows;
+
+  const els = [...document.body.querySelectorAll('*')].slice(0, 7000);
+  const skip = new Set(['script', 'style', 'noscript', 'template', 'link', 'meta', 'path', 'br', 'wbr', 'source', 'track', 'svg', 'g', 'use']);
+  const bgs = new Map(), texts = new Map(), accents = new Map(), type = new Map(), comps = new Map(), radii = new Map();
+  let shadows = 0, interactive = 0, lineChars = 0;
+  const landmarks = [];
+  const landmarkSel = 'header,nav,main,aside,footer,[role=banner],[role=navigation],[role=main],[role=complementary],[role=contentinfo],[role=search],[role=dialog],[role=toolbar],[role=tablist]';
+  for (const el of els) {
+    if (skip.has(el.localName) || el.closest('svg') || el.id?.startsWith('meridian')) continue;
+    const r = el.getBoundingClientRect();
+    if (!visible(r)) continue;
+    const cs = getComputedStyle(el);
+    if (cs.display === 'none' || cs.visibility === 'hidden') continue;
+    const area = seen(r);
+    const bg = rgb(cs.backgroundColor);
+    if (bg && area) count(bgs, hex(bg), area);
+    if (el.matches('a[href],button,input,select,textarea,[role=button],[role=tab],[role=link]') && r.top < vh) {
+      interactive++;
+      const c = rgb(el.localName === 'a' ? cs.color : cs.backgroundColor);
+      if (c && chroma(c) > 40) count(accents, hex(c));
+    }
+    if (parseFloat(cs.borderRadius) > 0 && (bg || parseFloat(cs.borderTopWidth) > 0)) count(radii, cs.borderRadius.split(' ')[0]);
+    if (cs.boxShadow !== 'none') shadows++;
+    const t = own(el);
+    if (t.length > 1) {
+      const fg = rgb(cs.color);
+      if (fg) count(texts, hex(fg));
+      const family = cs.fontFamily.split(',')[0].replace(/["']/g, '').trim();
+      const lh = cs.lineHeight === 'normal' ? 'normal' : (parseFloat(cs.lineHeight) / parseFloat(cs.fontSize)).toFixed(2);
+      const e = count(type, `${parseFloat(cs.fontSize)}|${cs.fontWeight}|${family}|${lh}`, 1, { sample: t.slice(0, 40) });
+      e.size = parseFloat(cs.fontSize); e.weight = +cs.fontWeight || 400; e.family = family; e.lh = lh;
+      if (t.length > 80) lineChars = Math.max(lineChars, Math.round(r.width / (parseFloat(cs.fontSize) * 0.5)));
+    }
+    if (el.matches(landmarkSel) && landmarks.length < 24) landmarks.push({ el, r, cs });
+    const cls = [...el.classList].find(stable);
+    if (cls && r.width >= 40 && r.height >= 14 && r.height <= 420) {
+      const e = count(comps, el.localName + '.' + CSS.escape(cls), 1, { hs: [], w: r.width, sample: (el.innerText || '').trim().replace(/\s+/g, ' ').slice(0, 60) });
+      if (e.hs.length < 30) e.hs.push(r.height);
+    }
+  }
+  // Big regions of an app without landmarks (a sidebar, a channel view…).
+  const regions = [];
+  const walk = (el, depth) => {
+    if (depth > 6 || regions.length > 14) return;
+    for (const c of el.children) {
+      const r = c.getBoundingClientRect();
+      if (!visible(r) || skip.has(c.localName)) continue;
+      const share = seen(r) / screen;
+      const pr = el.getBoundingClientRect();
+      if (share > 0.05 && (r.width < pr.width * 0.9 || r.height < pr.height * 0.9)) regions.push(c);
+      if (share > 0.05) walk(c, depth + 1);
+    }
+  };
+  walk(document.body, 0);
+  const all = [...landmarks.map((l) => l.el), ...regions.filter((e) => !landmarks.some((l) => l.el === e))].slice(0, 24);
+  out.landmarks = all.map((el) => {
+    const r = el.getBoundingClientRect(), cs = getComputedStyle(el), bg = rgb(cs.backgroundColor);
+    return { sel: path(el), w: r.width, h: r.height, x: r.left, y: r.top,
+      pos: ['fixed', 'sticky'].includes(cs.position) ? cs.position : '', bg: bg ? hex(bg) : '' };
+  });
+  const median = (a) => { const s = [...a].sort((x, y) => x - y); return s[Math.floor(s.length / 2)] || 0; };
+  out.components = top(new Map([...comps].filter(([, e]) => e.n >= 3)), 60)
+      .map(([sel, e]) => ({ sel, n: e.n, w: e.w, h: median(e.hs), sample: e.sample, score: e.n * Math.sqrt(e.w * median(e.hs)) }))
+      .sort((a, b) => b.score - a.score).slice(0, 20).map(({ score, ...c }) => c);
+  out.type = top(type, 12).map(([, e]) => ({ size: e.size, weight: e.weight, family: e.family, lh: e.lh, n: e.n, sample: e.sample }));
+  const total = Math.max(1, screen);
+  out.backgrounds = top(bgs, 10).map(([color, e]) => ({ color, share: Math.min(100, Math.round(e.n / total * 100)) }));
+  out.texts = top(texts, 10).map(([color, e]) => ({ color, n: e.n }));
+  out.accents = top(accents, 8).map(([color, e]) => ({ color, n: e.n }));
+  out.shape = top(radii, 4).map(([r, e]) => `radius ${r} ×${e.n}`).join(', ') + (shadows ? `; ${shadows} elements with a box-shadow` : '; no shadows');
+  const rows = out.components[0];
+  const bodySize = type.size ? top(type, 1)[0][1].size : parseFloat(getComputedStyle(document.body).fontSize);
+  const long = document.querySelectorAll('article p, main p, p').length;
+  out.density = { interactive, bodySize, lineChars, rowHeight: rows ? rows.h : undefined,
+    kind: interactive > 120 || (rows && rows.n > 15 && rows.h < 64 && long < 8) ? 'a dense app' : long > 6 ? 'a reading page' : 'mixed' };
+
+  // The outline, as before: elements with a little of their text.
+  const lines = [];
+  let size = 0;
+  const outline = (el, depth) => {
+    if (size > 28000 || depth > 14 || skip.has(el.localName) || el.id?.startsWith('meridian')) return;
+    const r = el.getBoundingClientRect();
+    const st = getComputedStyle(el);
+    if (st.display === 'none' || (r.width < 2 && r.height < 2 && !el.children.length)) return;
+    let d = el.localName;
+    if (el.id) d += '#' + el.id;
+    for (const c of [...el.classList].slice(0, 4)) d += '.' + c;
+    for (const a of ['role', 'aria-label', 'data-testid']) {
+      const v = el.getAttribute(a);
+      if (v) d += `[${a}="${v.slice(0, 40)}"]`;
+    }
+    d += ` ${Math.round(r.width)}x${Math.round(r.height)}`;
+    if (st.position === 'fixed' || st.position === 'sticky') d += ' ' + st.position;
+    const t = own(el).slice(0, 80);
+    const line = '  '.repeat(depth) + d + (t ? ` "${t}"` : '');
+    lines.push(line);
+    size += line.length + 1;
+    for (const c of el.children) outline(c, depth + 1);
+  };
+  outline(document.body, 0);
+  out.outline = lines.join('\n');
+  return out;
+})())JS";
+
+// Of the answer's clutter selectors, the ones safe to zap on this page:
+// they match something, not too much, and never the content, the focused
+// field or a big part of the page that isn't an overlay.
+constexpr char kSafeHide[] = R"JS(((sels) => {
+  const screen = innerWidth * innerHeight;
+  const main = document.querySelector('main, [role=main], article');
+  const all = (document.body?.innerText || '').length;
+  const ok = [];
+  for (const s of sels) {
+    let els;
+    try { els = [...document.querySelectorAll(s)]; } catch { continue; }
+    if (!els.length || els.length > 60) continue;
+    const bad = els.some((el) => {
+      if (el === document.body || el === document.documentElement) return true;
+      if (main && el.contains(main)) return true;
+      const a = document.activeElement;
+      if (a && a !== document.body && el.contains(a)) return true;
+      if (el.querySelector('input:not([type=hidden]):not([type=checkbox]):not([type=email]), textarea, [contenteditable=true]')) return true;
+      const r = el.getBoundingClientRect();
+      const overlay = ['fixed', 'sticky'].includes(getComputedStyle(el).position);
+      if (!overlay && r.width * r.height > screen * 0.4) return true;
+      return all > 400 && (el.innerText || '').length > all * 0.3;
+    });
+    if (!bad) ok.push(s);
+  }
+  return ok;
+}))JS";
+
+void RunInFrame(content::RenderFrameHost* frame,
+                const std::string& script,
+                content::RenderFrameHost::JavaScriptResultCallback done) {
+  frame->ExecuteJavaScriptInIsolatedWorld(base::UTF8ToUTF16(script),
+                                          std::move(done),
+                                          ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+std::string Jpeg(SkBitmap bitmap) {
+  if (bitmap.drawsNothing()) {
+    return std::string();
+  }
+  if (bitmap.width() > kShotWidth) {
+    gfx::ImageSkia image = gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+    bitmap = *gfx::ImageSkiaOperations::CreateResizedImage(
+                  image, skia::ImageOperations::RESIZE_GOOD,
+                  gfx::Size(kShotWidth,
+                            bitmap.height() * kShotWidth / bitmap.width()))
+                  .bitmap();
+  }
+  std::optional<std::vector<uint8_t>> jpeg = gfx::JPEGCodec::Encode(bitmap, 72);
+  return jpeg ? base::Base64Encode(*jpeg) : std::string();
+}
+
+// The person's direction, short enough for the status pill.
+std::string Short(const std::string& wish) {
+  std::u16string text = base::UTF8ToUTF16(wish);
+  if (text.size() <= 40) {
+    return wish;
+  }
+  return base::UTF16ToUTF8(text.substr(0, 38)) + "…";
+}
+
+std::string Round(int n) {
+  return base::NumberToString(n) + "/" +
+         base::NumberToString(boost_ai::kMaxRounds);
+}
+
+}  // namespace
+
+BoostImprover::BoostImprover(content::WebContents* contents)
+    : contents_(contents) {}
+
+BoostImprover::~BoostImprover() {
+  if (done_ && !session_.empty()) {
+    if (AiService* ai = this->ai()) {
+      ai->Stop(session_);
+      ai->Reset(session_);
+    }
+  }
+  if (done_) {
+    // The tab is going: the editor still gets an answer.
+    std::move(done_).Run(applied_ ? std::string() : "The tab was closed.",
+                         applied_ ? summary_ : std::string());
+  }
+}
+
+BoostService* BoostImprover::service() {
+  return BoostServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(contents_->GetBrowserContext()));
+}
+
+AiService* BoostImprover::ai() {
+  // The AI is set up in the main profile (Settings > AI), also for a tab of
+  // a space with its own profile.
+  return AiServiceFactory::GetForProfile(MainProfileFor(
+      Profile::FromBrowserContext(contents_->GetBrowserContext())));
+}
+
+const Boost* BoostImprover::Target() {
+  BoostService* s = service();
+  if (!s) {
+    return nullptr;
+  }
+  for (const Boost* boost : s->AllForHost(host_)) {
+    if (boost->id == boost_id_) {
+      return boost;
+    }
+  }
+  return s->ForHost(host_);
+}
+
+void BoostImprover::SetProgress(std::string text, std::string detail) {
+  progress_ = std::move(text);
+  detail_ = std::move(detail);
+}
+
+void BoostImprover::Start(const std::string& boost_id,
+                          const std::string& wish,
+                          const std::string& provider,
+                          Done done) {
+  if (running()) {
+    std::move(done).Run("It’s already being improved.", std::string());
+    return;
+  }
+  content::RenderFrameHost* frame = contents_->GetPrimaryMainFrame();
+  const GURL url = frame->GetLastCommittedURL();
+  host_ = BoostHostFor(url);
+  if (host_.empty() || !frame->IsRenderFrameLive()) {
+    std::move(done).Run("Only websites can be boosted.", std::string());
+    return;
+  }
+  AiService* ai = this->ai();
+  if (!ai || !service()) {
+    std::move(done).Run("The AI isn’t available here.", std::string());
+    return;
+  }
+  if (provider.empty() && ai->CurrentProvider().empty()) {
+    const ai::Provider* signed_out = ai::FindProvider(ai->SignedOutProvider());
+    std::move(done).Run(
+        signed_out
+            ? signed_out->label + " isn’t signed in yet. Sign in to it, then "
+                                  "try again."
+            : "Set up an AI in Settings > AI: Claude Code, Codex or an API "
+              "key.",
+        std::string());
+    return;
+  }
+  boost_id_ = boost_id;
+  wish_ = wish;
+  provider_ = provider;
+  url_ = url.spec();
+  title_ = base::UTF16ToUTF8(contents_->GetTitle());
+  sees_images_ = ai->SeesImages(provider);
+  round_ = 0;
+  css_.clear();
+  problems_.clear();
+  summary_.clear();
+  applied_ = false;
+  const Boost* target = Target();
+  css_before_ = target ? target->css : std::string();
+  done_ = std::move(done);
+  started_ = base::TimeTicks::Now();
+  applied_count_ = 0;
+  SetProgress("Looking at the page…", "measuring the layout");
+  RunInFrame(frame, kContext,
+             base::BindOnce(&BoostImprover::OnContext,
+                            run_weak_factory_.GetWeakPtr()));
+}
+
+void BoostImprover::OnContext(base::Value context) {
+  context_ = context.is_dict() ? boost_ai::ContextText(context.GetDict())
+                               : std::string();
+  round_ = 1;
+  if (!sees_images_) {
+    Ask(std::string());
+    return;
+  }
+  Capture(base::BindOnce(&BoostImprover::Ask, run_weak_factory_.GetWeakPtr()));
+}
+
+void BoostImprover::Capture(base::OnceCallback<void(std::string)> next) {
+  content::RenderWidgetHostView* view = contents_->GetRenderWidgetHostView();
+  if (!view) {
+    std::move(next).Run(std::string());
+    return;
+  }
+  // On the screen: a copy of what it shows; else (a covered window) one
+  // frame of a video capture, as the agents' screenshot.
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), base::Seconds(5),
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents,
+             base::OnceCallback<void(std::string)> next,
+             const content::CopyFromSurfaceResult& result) {
+            if (result.has_value() && !result->bitmap.drawsNothing()) {
+              std::move(next).Run(Jpeg(result->bitmap));
+              return;
+            }
+            content::RenderWidgetHostView* view =
+                contents ? contents->GetRenderWidgetHostView() : nullptr;
+            if (!view) {
+              std::move(next).Run(std::string());
+              return;
+            }
+            const gfx::Size size = gfx::ScaleToCeiledSize(
+                view->GetViewBounds().size(), view->GetDeviceScaleFactor());
+            CaptureTabFrame(
+                view, size.IsEmpty() ? gfx::Size(1280, 800) : size,
+                base::Seconds(5),
+                base::BindOnce(
+                    [](base::OnceCallback<void(std::string)> next,
+                       SkBitmap bitmap) {
+                      std::move(next).Run(Jpeg(std::move(bitmap)));
+                    },
+                    std::move(next)));
+          },
+          contents_->GetWeakPtr(), std::move(next)));
+}
+
+void BoostImprover::Ask(std::string image) {
+  AiService* ai = this->ai();
+  if (!ai) {
+    Finish("The AI isn’t available here.");
+    return;
+  }
+  const Boost* target = Target();
+  boost_ai::RoundInput in;
+  in.round = round_;
+  in.host = host_;
+  in.url = url_;
+  in.title = title_;
+  in.context = context_;
+  in.wish = wish_;
+  in.css = round_ == 1 ? css_before_ : css_;
+  in.problems = problems_;
+  in.screenshot = !image.empty();
+  in.tint = target ? target->tint : -1;
+
+  AiService::Request request;
+  session_ = "boost-" + base::Uuid::GenerateRandomV4().AsLowercaseString();
+  request.session_id = session_;
+  request.text = boost_ai::RoundPrompt(in);
+  request.system = boost_ai::SystemPrompt();
+  request.provider = provider_;
+  request.mode = "chat";
+  if (!image.empty()) {
+    request.images.push_back(std::move(image));
+  }
+  // The tab's space: its AI account, as Ask uses it (ai/account_prefs.h).
+  if (const TabData* data = TabData::Get(contents_)) {
+    request.space_id = data->space_id();
+  }
+  answer_.clear();
+  if (round_ == 1) {
+    SetProgress("Designing… " + Round(1),
+                wish_.empty() ? std::string("a new palette, type and spacing")
+                              : "going for “" + Short(wish_) + "”");
+  }
+  if (round_ == 1) {
+    deadline_.Start(FROM_HERE, kFirstRoundLimit,
+                    base::BindOnce(&BoostImprover::OnDeadline,
+                                   run_weak_factory_.GetWeakPtr()));
+  } else {
+    const base::TimeDelta left =
+        kDeadline - (base::TimeTicks::Now() - started_);
+    deadline_.Start(FROM_HERE, std::max(left, base::Seconds(5)),
+                    base::BindOnce(&BoostImprover::OnDeadline,
+                                   run_weak_factory_.GetWeakPtr()));
+  }
+  ai->Chat(std::move(request),
+           base::BindRepeating(&BoostImprover::OnAiEvent,
+                               run_weak_factory_.GetWeakPtr(), round_));
+}
+
+void BoostImprover::OnAiEvent(int round,
+                              const std::string& type,
+                              const std::string& text) {
+  if (round != round_) {
+    return;
+  }
+  if (type == "text") {
+    answer_ += text;
+    return;
+  }
+  if (type != "done" && type != "error") {
+    return;
+  }
+  deadline_.Stop();
+  // The session's callback is running: drop it afterwards.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<AiService> ai, std::string session) {
+                       if (ai) {
+                         ai->Reset(session);
+                       }
+                     },
+                     ai() ? ai()->GetWeakPtr() : base::WeakPtr<AiService>(),
+                     session_));
+  if (type == "error") {
+    // A later round's error keeps what the earlier ones made.
+    Finish(applied_ ? std::string() : text);
+    return;
+  }
+  if (text == "stopped") {
+    Finish(applied_ ? std::string() : "Stopped.");
+    return;
+  }
+  OnAnswer(round, std::move(answer_));
+}
+
+void BoostImprover::OnAnswer(int round, std::string text) {
+  std::optional<boost_ai::Answer> answer = boost_ai::ParseAnswer(text);
+  if (!answer) {
+    Finish(applied_ ? std::string()
+                    : "The AI didn’t answer with a boost. Try again.");
+    return;
+  }
+  if (answer->done || (round > 1 && answer->css.empty())) {
+    Finish(std::string());
+    return;
+  }
+  boost_ai::CssCheck check = boost_ai::CheckCss(answer->css);
+  if (!check.ok) {
+    if (!applied_) {
+      Finish("The AI’s CSS couldn’t be used" +
+             (check.problems.empty() ? std::string(".")
+                                     : ": " + check.problems.front() + ".") +
+             " Try again.");
+      return;
+    }
+    // Keep the last good one; the next round hears why.
+    problems_ = check.problems;
+    NextRound();
+    return;
+  }
+  if (round > 1 && check.css == css_) {
+    Finish(std::string());
+    return;
+  }
+  // The clutter to zap, as this page has it.
+  base::ListValue hide;
+  for (const std::string& sel : answer->hide) {
+    hide.Append(sel);
+  }
+  content::RenderFrameHost* frame = contents_->GetPrimaryMainFrame();
+  if (hide.empty() || !frame->IsRenderFrameLive()) {
+    OnHideChecked(std::move(*answer), std::move(check),
+                  base::Value(base::ListValue()));
+    return;
+  }
+  RunInFrame(frame,
+             std::string("(") + kSafeHide + ")(" +
+                 base::WriteJson(hide).value_or("[]") + ")",
+             base::BindOnce(&BoostImprover::OnHideChecked,
+                            run_weak_factory_.GetWeakPtr(), std::move(*answer),
+                            std::move(check)));
+}
+
+void BoostImprover::OnHideChecked(boost_ai::Answer answer,
+                                  boost_ai::CssCheck check,
+                                  base::Value safe) {
+  BoostService* s = service();
+  if (!s) {
+    Finish(applied_ ? std::string() : "The AI isn’t available here.");
+    return;
+  }
+  const Boost* existing = Target();
+  Boost boost = existing ? *existing : Boost();
+  boost.host = host_;
+  boost.enabled = true;
+  boost.css = check.css;
+  if (safe.is_list()) {
+    for (const base::Value& sel : safe.GetList()) {
+      if (sel.is_string() && !std::ranges::contains(boost.zaps, sel.GetString())) {
+        boost.zaps.push_back(sel.GetString());
+      }
+    }
+  }
+  if (boost.name.empty() || boost.name == host_ || boost.name == "My Boost") {
+    boost.name = !answer.name.empty() ? answer.name : host_;
+  }
+  boost_id_ = s->Set(std::move(boost));
+  css_ = check.css;
+  problems_ = check.problems;
+  applied_ = true;
+  ++applied_count_;
+  if (summary_.empty() || round_ == 1) {
+    summary_ = answer.summary;
+  }
+  NextRound();
+}
+
+void BoostImprover::NextRound() {
+  if (round_ >= boost_ai::kMaxRounds ||
+      base::TimeTicks::Now() - started_ > kNoNewRoundAfter) {
+    Finish(std::string());
+    return;
+  }
+  ++round_;
+  SetProgress((round_ == 2 ? "Reviewing… " : "Polishing… ") + Round(round_),
+              !problems_.empty() ? std::string("fixing what the checks took out")
+              : round_ == 2      ? std::string("checking contrast and alignment")
+                                 : std::string("the last details"));
+  // The page takes the CSS first; then it's photographed.
+  settle_.Start(
+      FROM_HERE, kSettle,
+      base::BindOnce(
+          [](base::WeakPtr<BoostImprover> self) {
+            if (!self) {
+              return;
+            }
+            if (!self->sees_images_) {
+              self->Ask(std::string());
+              return;
+            }
+            self->Capture(base::BindOnce(
+                &BoostImprover::Ask, self->run_weak_factory_.GetWeakPtr()));
+          },
+          run_weak_factory_.GetWeakPtr()));
+}
+
+void BoostImprover::OnDeadline() {
+  if (AiService* ai = this->ai()) {
+    ai->Stop(session_);
+    ai->Reset(session_);
+  }
+  Finish(applied_ ? std::string()
+                  : "The AI took too long. Try again, or with a shorter "
+                    "direction.");
+}
+
+void BoostImprover::Finish(std::string error) {
+  run_weak_factory_.InvalidateWeakPtrs();
+  deadline_.Stop();
+  settle_.Stop();
+  progress_.clear();
+  detail_.clear();
+  if (!done_) {
+    return;
+  }
+  if (!error.empty()) {
+    std::move(done_).Run(std::move(error), std::string());
+    return;
+  }
+  std::move(done_).Run(std::string(),
+                       summary_.empty() ? std::string("Done.") : summary_);
+}
+
+}  // namespace meridian
