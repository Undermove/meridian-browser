+CssCheck CheckCss(const std::string& css) {
+  CssCheck out;
+  if (css.size() > kMaxCss) {
+    out.problems.push_back("the CSS is too big (" +
+                           base::NumberToString(css.size() / 1024) +
+                           " KB, at most " +
+                           base::NumberToString(kMaxCss / 1024) + ")");
+    return out;
+  }
+  std::string text = StripComments(css);
+  // Markup around it ("<style>…").
+  base::ReplaceSubstringsAfterOffset(&text, 0, "<style>", "");
+  base::ReplaceSubstringsAfterOffset(&text, 0, "</style>", "");
+  Checker checker;
+  std::string rules = checker.Rules(text, 0, true);
+  std::string imports;
+  for (const std::string& url : checker.imports) {
+    imports += "@import url(\"" + url + "\");\n";
+  }
+  out.problems = std::move(checker.problems);
+  out.rules = checker.rules;
+  out.declarations = checker.declarations;
+  out.ok = checker.declarations > 0;
+  out.css = out.ok ? imports + rules : std::string();
+  return out;
+}
+
+std::vector<std::string> CheckHide(const base::ListValue* selectors) {
+  std::vector<std::string> out;
+  if (!selectors) {
+    return out;
+  }
+  // The page, its content and its controls: never a zap's last part.
+  static constexpr const char* kKept[] = {
+      "html",   "body",     "main",   ":root",  "*",      "article",
+      "form",   "input",    "button", "select", "textarea", "nav",
+      "header", "footer",   "a",      "label",  "video",  "h1",
+      "[role=\"main\"]", "[role=main]", "[role=\"navigation\"]",
+      "[role=navigation]", "[role=\"textbox\"]", "[role=textbox]",
+      "[role=\"button\"]", "[role=button]", "[contenteditable]"};
+  for (const base::Value& v : *selectors) {
+    if (!v.is_string() || out.size() >= kMaxHide) {
+      continue;
+    }
+    std::string sel(base::TrimWhitespaceASCII(v.GetString(), base::TRIM_ALL));
+    if (sel.empty() || sel.size() > 300 ||
+        sel.find_first_of("{};<@\\") != std::string::npos ||
+        Has(base::ToLowerASCII(sel), "meridian")) {
+      continue;
+    }
+    bool kept = false;
+    for (const std::string& part : SplitTop(sel, ',')) {
+      std::string p = base::ToLowerASCII(
+          base::TrimWhitespaceASCII(part, base::TRIM_ALL));
+      // Its last compound ("main > div.ad" is fine, "div > main" isn't).
+      size_t cut = p.find_last_of(" >+~");
+      std::string last = cut == std::string::npos ? p : p.substr(cut + 1);
+      std::string tag = last.substr(0, last.find_first_of(".#[:"));
+      if (p.empty() || In(kKept, last) ||
+          In(kKept, tag) ||
+          Has(p, ":has(") || Has(p, ":not(")) {
+        kept = true;
+      }
+      for (const char* k : kKept) {
+        if (k[0] == '[' && Has(last, k)) {
+          kept = true;
+        }
+      }
+    }
+    if (!kept && !In(out, sel)) {
+      out.push_back(sel);
+    }
+  }
+  return out;
+}
+
+std::string ContextText(const base::DictValue& ctx) {
+  std::string out;
+  if (const base::DictValue* vp = ctx.FindDict("viewport")) {
+    out += "Viewport: " + Num(*vp, "w") + "x" + Num(*vp, "h") + " CSS px, " +
+           "device pixel ratio " + Num(*vp, "dpr") + ".\n";
+  }
+  const std::string scheme = Str(ctx, "scheme");
+  if (!scheme.empty()) {
+    out += "Theme: the page is " + scheme;
+    if (ctx.FindBool("prefersDark").value_or(false)) {
+      out += "; the person's system is in dark mode";
+    }
+    if (ctx.FindBool("followsSystem").value_or(false)) {
+      out += "; the site has its own prefers-color-scheme styles";
+    }
+    out += ".\n";
+  }
+  if (const base::DictValue* d = ctx.FindDict("density")) {
+    out += "Density: " + Num(*d, "interactive") +
+           " visible links and controls, body text " + Num(*d, "bodySize") +
+           " px, longest text line about " + Num(*d, "lineChars") +
+           " characters";
+    if (d->FindDouble("rowHeight")) {
+      out += ", repeated rows about " + Num(*d, "rowHeight") + " px tall";
+    }
+    out += " (" + Str(*d, "kind") + ").\n";
+  }
+  std::string section = Lines(ctx, "landmarks", 24, [](const auto& l) {
+    return Str(l, "sel") + " " + Num(l, "w") + "x" + Num(l, "h") + " at " +
+           Num(l, "x") + "," + Num(l, "y") +
+           (Str(l, "pos").empty() ? "" : " " + Str(l, "pos")) +
+           (Str(l, "bg").empty() ? "" : ", background " + Str(l, "bg"));
+  });
+  if (!section.empty()) {
+    out += "\nLandmarks (main regions):\n" + section;
+  }
+  section = Lines(ctx, "components", 20, [](const auto& c) {
+    return Str(c, "sel") + " ×" + Num(c, "n") + ", about " + Num(c, "w") +
+           "x" + Num(c, "h") +
+           (Str(c, "sample").empty() ? "" : ": “" + Str(c, "sample") + "”");
+  });
+  if (!section.empty()) {
+    out += "\nRepeated components:\n" + section;
+  }
+  section = Lines(ctx, "type", 12, [](const auto& t) {
+    return Num(t, "size") + " px / " + Num(t, "weight") + ", line-height " +
+           Str(t, "lh") + ", " + Str(t, "family") + " (" + Num(t, "n") +
+           " elements" +
+           (Str(t, "sample").empty() ? "" : ", e.g. " + Str(t, "sample")) +
+           ")";
+  });
+  if (!section.empty()) {
+    out += "\nType scale in use (most used first):\n" + section;
+  }
+  section = Lines(ctx, "backgrounds", 10, [](const auto& c) {
+    return Str(c, "color") + " (" + Num(c, "share") + "% of the screen)";
+  });
+  if (!section.empty()) {
+    out += "\nBackground colours:\n" + section;
+  }
+  section = Lines(ctx, "texts", 10, [](const auto& c) {
+    return Str(c, "color") + " (" + Num(c, "n") + " elements)";
+  });
+  if (!section.empty()) {
+    out += "\nText colours:\n" + section;
+  }
+  section = Lines(ctx, "accents", 8, [](const auto& c) {
+    return Str(c, "color") + " (" + Num(c, "n") + " links and buttons)";
+  });
+  if (!section.empty()) {
+    out += "\nAccent colours:\n" + section;
+  }
+  section = Lines(ctx, "vars", 80, [](const auto& v) {
+    return Str(v, "name") + ": " + Str(v, "value");
+  });
+  if (!section.empty()) {
+    out += "\nThe site's theme variables (on :root/html/body):\n" + section;
+  }
+  const std::string shape = Str(ctx, "shape");
+  if (!shape.empty()) {
+    out += "\nShapes: " + shape + "\n";
+  }
+  const std::string outline = Str(ctx, "outline");
+  if (!outline.empty()) {
+    out += "\n<page_outline>\n" + outline + "\n</page_outline>\n";
+  }
+  return out;
+}
+
+std::string SystemPrompt() {
+  return kSystem;
+}
+
+std::string RoundPrompt(const RoundInput& in) {
+  std::string out = "<site host=\"" + Escape(in.host) + "\" url=\"" +
+                    Escape(in.url.substr(0, 300)) + "\">\n" +
+                    Escape(in.title.substr(0, 200)) + "\n</site>\n\n";
+  out += "<page>\n" + in.context + "</page>\n\n";
+  if (in.tint >= 0) {
+    out += "The person's colour pick (hue " + base::NumberToString(in.tint) +
+           "°) also recolours the page: build the palette around that "
+           "hue.\n\n";
+  }
+  const std::string direction =
+      in.wish.empty()
+          ? std::string("none given: a redesign of your own that suits the "
+                        "site, polished and calm.")
+          : Escape(in.wish);
+  if (in.round == 1) {
+    if (!in.css.empty()) {
+      out += "<boost_css_so_far>\n" + Escape(in.css) +
+             "\n</boost_css_so_far>\n\n";
+    }
+    out += std::string(in.screenshot
+                           ? "The screenshot shows the page as it is now. "
+                           : "No screenshot: work from the measurements. ") +
+           "Redesign it.\n";
+  } else {
+    out += "<css_on_the_page>\n" + Escape(in.css) +
+           "\n</css_on_the_page>\n\n";
+    if (!in.problems.empty()) {
+      out += "These parts of your last CSS were removed by the checks:\n";
+      for (const std::string& p : in.problems) {
+        out += "- " + Escape(p) + "\n";
+      }
+      out += "\n";
+    }
+    out += "Review round " + base::NumberToString(in.round) + " of " +
+           base::NumberToString(kMaxRounds) + ". " +
+           (in.screenshot ? "The screenshot shows the page with the CSS "
+                            "above applied. "
+                          : "") +
+           "Critique it as a demanding design lead: what looks broken, ugly, "
+           "unreadable or inconsistent (low contrast, clashing colours, "
+           "misaligned or cramped parts, things that lost their state, "
+           "leftovers of the old look)? Then answer with the whole fixed "
+           "CSS. If it's already good, answer {\"done\": true, \"css\": \"\", "
+           "\"summary\": \"\"}.\n";
+  }
+  out += "\nThe person's direction: " + direction;
+  return out;
+}
+
+std::optional<Answer> ParseAnswer(const std::string& text) {
+  size_t from = text.find('{');
+  size_t to = text.rfind('}');
+  if (from == std::string::npos || to == std::string::npos || to < from) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> v = base::JSONReader::Read(
+      text.substr(from, to - from + 1), base::JSON_ALLOW_TRAILING_COMMAS);
+  if (!v || !v->is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& d = v->GetDict();
+  Answer a;
+  const std::string* css = d.FindString("css");
+  a.done = d.FindBool("done").value_or(false);
+  if (!css && !a.done) {
+    return std::nullopt;
+  }
+  if (css) {
+    a.css = *css;
+  }
+  if (const std::string* name = d.FindString("name")) {
+    a.name = name->substr(0, 60);
+  }
+  if (const std::string* summary = d.FindString("summary")) {
+    a.summary = summary->substr(0, 400);
+  }
+  a.hide = CheckHide(d.FindList("hide"));
+  return a;
+}
+
+}  // namespace meridian::boost_ai
