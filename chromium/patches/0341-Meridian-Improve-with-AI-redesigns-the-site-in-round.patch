new file mode 100644
index 0000000000..b9f6a8312e
--- /dev/null
+++ b/chrome/browser/meridian/boosts/boost_improve.h
@@ -0,0 +1,105 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_BOOSTS_BOOST_IMPROVE_H_
+#define CHROME_BROWSER_MERIDIAN_BOOSTS_BOOST_IMPROVE_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+
+// Improve with AI, the parts without a browser: the brief, the page's
+// context as the AI reads it, the answer, and the checks every CSS from an
+// AI passes before it reaches a page (boost_improver.h runs the rounds).
+namespace meridian::boost_ai {
+
+// More CSS than this is refused (a redesign is a few thousand lines at most).
+inline constexpr size_t kMaxCss = 96 * 1024;
+// At most this many clutter selectors go to the boost's zaps.
+inline constexpr size_t kMaxHide = 15;
+inline constexpr int kMaxRounds = 3;
+
+// What's left of an AI's CSS once it's checked: whatever hides content or
+// controls, loads something from the internet (other than Google Fonts),
+// runs code or animates is taken out; every declaration gets !important.
+struct CssCheck {
+  CssCheck();
+  CssCheck(const CssCheck&);
+  CssCheck& operator=(const CssCheck&);
+  ~CssCheck();
+
+  // false: nothing usable (it didn't parse, was too big or was all taken
+  // out); `css` is then empty.
+  bool ok = false;
+  std::string css;
+  // What was taken out and why, in a few words each (for the next round and
+  // the person).
+  std::vector<std::string> problems;
+  // Rules and declarations kept.
+  int rules = 0;
+  int declarations = 0;
+};
+CssCheck CheckCss(const std::string& css);
+
+// The answer's "hide" selectors that may become zaps: clutter only. Never
+// the page itself, its content or its controls (the page checks the rest:
+// what they match and how big it is).
+std::vector<std::string> CheckHide(const base::ListValue* selectors);
+
+// The page as kContext (boost_improver.cc) measured it, as text for the
+// prompt: viewport and theme, landmarks, repeated components, the type
+// scale, colours and the site's theme variables, density, the outline.
+std::string ContextText(const base::DictValue& context);
+
+// The system prompt: a senior product designer's brief and the answer's
+// shape.
+std::string SystemPrompt();
+
+struct RoundInput {
+  RoundInput();
+  RoundInput(const RoundInput&);
+  RoundInput& operator=(const RoundInput&);
+  ~RoundInput();
+
+  int round = 1;
+  std::string host;
+  std::string url;
+  std::string title;
+  // ContextText's.
+  std::string context;
+  // The person's direction ("like Linear", "warm editorial"…; "": a
+  // redesign of the AI's own).
+  std::string wish;
+  // Round 1: the boost's CSS before Improve. Later: the CSS on the page now.
+  std::string css;
+  // Later rounds: what the checks took out of the last CSS.
+  std::vector<std::string> problems;
+  // A screenshot comes with the prompt.
+  bool screenshot = false;
+  // The person's colour pick recolours the page too: its hue (-1: none).
+  int tint = -1;
+};
+std::string RoundPrompt(const RoundInput& in);
+
+struct Answer {
+  Answer();
+  Answer(const Answer&);
+  Answer& operator=(const Answer&);
+  ~Answer();
+
+  std::string name;
+  std::string css;
+  std::string summary;
+  std::vector<std::string> hide;
+  // A later round found nothing worth changing.
+  bool done = false;
+};
+// The JSON object in an AI's answer (some add a fence or a sentence).
+std::optional<Answer> ParseAnswer(const std::string& text);
+
+}  // namespace meridian::boost_ai
+
+#endif  // CHROME_BROWSER_MERIDIAN_BOOSTS_BOOST_IMPROVE_H_
diff --git a/chrome/browser/meridian/boosts/boost_improve_unittest.cc b/chrome/browser/meridian/boosts/boost_improve_unittest.cc
new file mode 100644
index 0000000000..3b68a135ac
--- /dev/null
+++ b/chrome/browser/meridian/boosts/boost_improve_unittest.cc
@@ -0,0 +1,231 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/boosts/boost_improve.h"
+
+#include "base/json/json_reader.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::boost_ai {
+
+namespace {
+
+bool Has(const std::string& text, const std::string& part) {
+  return text.find(part) != std::string::npos;
+}
+
+bool AnyProblem(const CssCheck& c, const std::string& part) {
+  for (const std::string& p : c.problems) {
+    if (Has(p, part)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+TEST(BoostImproveTest, KeepsADesignAndAddsImportant) {
+  CssCheck c = CheckCss(
+      ":root { --bg: #0f1115; --Accent: #6e8bff }\n"
+      "/* the header */ header.site { background: var(--bg); color: #eee "
+      "!important; border-radius: 10px }\n"
+      "a:hover, a:focus-visible { outline: 2px solid var(--Accent) }\n"
+      "@media (prefers-color-scheme: dark) { body { background: #111 } }\n");
+  ASSERT_TRUE(c.ok);
+  EXPECT_TRUE(c.problems.empty());
+  EXPECT_EQ(c.rules, 4);
+  EXPECT_TRUE(Has(c.css, "--Accent: #6e8bff !important;"));  // Case kept.
+  EXPECT_TRUE(Has(c.css, "header.site {\n  background: var(--bg) !important;"));
+  EXPECT_TRUE(Has(c.css, "  color: #eee !important;\n"));
+  EXPECT_FALSE(Has(c.css, "important !important"));
+  EXPECT_TRUE(Has(c.css, "@media (prefers-color-scheme: dark) {\n  body {\n"
+                         "    background: #111 !important;"));
+  EXPECT_FALSE(Has(c.css, "the header"));
+}
+
+TEST(BoostImproveTest, TakesOutWhatHidesContentOrControls) {
+  CssCheck c = CheckCss(
+      "main { display: none; color: red }\n"
+      ".sidebar { visibility: hidden }\n"
+      ".a { opacity: 0.02 } .b { opacity: 0.9 } .c { opacity: 5% }\n"
+      ".d { height: 0 } .e { max-height: 0px } .f { width: 0 !important }\n"
+      ".g { font-size: 0 } .h { transform: scale(0) } .i { transform: "
+      "scale(0.98) }\n"
+      ".j { clip-path: inset(50%) } .k { text-indent: -9999px } .l { left: "
+      "-10000px }\n"
+      "button { pointer-events: none } .m { color: transparent }\n"
+      ".n { content-visibility: hidden } .o::before { display: none }\n");
+  ASSERT_TRUE(c.ok);
+  EXPECT_FALSE(Has(c.css, "display: none !important;\n}\n.sidebar"));
+  EXPECT_TRUE(Has(c.css, "main {\n  color: red !important;\n}"));
+  EXPECT_FALSE(Has(c.css, "visibility"));
+  EXPECT_FALSE(Has(c.css, "0.02"));
+  EXPECT_TRUE(Has(c.css, "opacity: 0.9"));
+  EXPECT_FALSE(Has(c.css, "5%"));
+  EXPECT_FALSE(Has(c.css, "height: 0"));
+  EXPECT_FALSE(Has(c.css, "width: 0"));
+  EXPECT_FALSE(Has(c.css, "font-size"));
+  EXPECT_FALSE(Has(c.css, "scale(0)"));
+  EXPECT_TRUE(Has(c.css, "scale(0.98)"));
+  EXPECT_FALSE(Has(c.css, "clip-path"));
+  EXPECT_FALSE(Has(c.css, "9999"));
+  EXPECT_FALSE(Has(c.css, "10000"));
+  EXPECT_FALSE(Has(c.css, "pointer-events"));
+  EXPECT_FALSE(Has(c.css, "transparent"));
+  EXPECT_FALSE(Has(c.css, "content-visibility"));
+  // A pseudo-element hides no content.
+  EXPECT_TRUE(Has(c.css, ".o::before {\n  display: none !important;"));
+  EXPECT_TRUE(AnyProblem(c, "main: display: none hides content"));
+}
+
+TEST(BoostImproveTest, NothingFromTheInternetButGoogleFonts) {
+  CssCheck c = CheckCss(
+      "@import url(\"https://evil.example/x.css\");\n"
+      "@import url(\"https://fonts.googleapis.com/css2?family=Inter:wght@400;"
+      "600&display=swap\");\n"
+      "body { background: url(https://evil.example/track.png); color: #222 }\n"
+      ".a { background-image: url(\"data:image/svg+xml;utf8,<svg "
+      "xmlns='http://www.w3.org/2000/svg'/>\") }\n"
+      ".b { background: image-set(\"https://evil.example/x.png\" 1x) }\n"
+      ".c { background: u\\72l(https://evil.example/y.png) }\n"
+      "@font-face { font-family: X; src: url(https://evil.example/x.woff2) }\n"
+      "@font-face { font-family: Inter; src: "
+      "url(https://fonts.gstatic.com/s/inter/v1/a.woff2) format('woff2') }\n"
+      ".d { behavior: url(x.htc) } .e { width: expression(alert(1)) }\n");
+  ASSERT_TRUE(c.ok);
+  EXPECT_FALSE(Has(c.css, "evil.example"));
+  // Google Fonts' stylesheet, first.
+  EXPECT_EQ(c.css.find("@import url(\"https://fonts.googleapis.com/css2?"
+                       "family=Inter:wght@400;600&display=swap\");"),
+            0u);
+  EXPECT_TRUE(Has(c.css, "body {\n  color: #222 !important;\n}"));
+  EXPECT_TRUE(Has(c.css, "data:image/svg+xml"));
+  EXPECT_TRUE(Has(c.css, "fonts.gstatic.com"));
+  EXPECT_FALSE(Has(c.css, "behavior"));
+  EXPECT_FALSE(Has(c.css, "expression"));
+  EXPECT_TRUE(AnyProblem(c, "loads from the internet"));
+}
+
+TEST(BoostImproveTest, RefusesWhatDoesntParseOrIsTooBig) {
+  EXPECT_FALSE(CheckCss("").ok);
+  EXPECT_FALSE(CheckCss("this is not css").ok);
+  EXPECT_FALSE(CheckCss("main { display: none }").ok);
+  CssCheck open = CheckCss("a { color: red } b { color: blue");
+  EXPECT_TRUE(open.ok);  // What's closed is kept.
+  EXPECT_TRUE(Has(open.css, "a {\n  color: red !important;"));
+  EXPECT_TRUE(AnyProblem(open, "unclosed"));
+  EXPECT_FALSE(CheckCss(std::string(kMaxCss + 1, ' ') + "a{color:red}").ok);
+  // No animations, nested rules or Meridian's own elements.
+  CssCheck c = CheckCss(
+      "@keyframes spin { to { transform: rotate(1turn) } }\n"
+      ".a { animation: spin 1s; color: red; &:hover { color: blue } }\n"
+      "#meridian-zap { display: block }\n");
+  EXPECT_TRUE(c.ok);
+  EXPECT_FALSE(Has(c.css, "keyframes"));
+  EXPECT_FALSE(Has(c.css, "animation"));
+  EXPECT_FALSE(Has(c.css, "blue"));
+  EXPECT_FALSE(Has(c.css, "meridian"));
+  EXPECT_TRUE(Has(c.css, ".a {\n  color: red !important;\n}"));
+}
+
+TEST(BoostImproveTest, HideKeepsOnlyClutter) {
+  base::ListValue sels;
+  for (const char* s : {"#cookie-banner", ".ad-slot, .promo", "main", "body",
+                        "div > main", "main > div.ad", "nav", "input.search",
+                        "[role=\"main\"]", ".x:has(main)", "#a { }",
+                        "#meridian-zap"}) {
+    sels.Append(s);
+  }
+  std::vector<std::string> ok = CheckHide(&sels);
+  EXPECT_EQ(ok, (std::vector<std::string>{"#cookie-banner", ".ad-slot, .promo",
+                                          "main > div.ad"}));
+  EXPECT_TRUE(CheckHide(nullptr).empty());
+}
+
+TEST(BoostImproveTest, ContextTextHasTheMeasurements) {
+  std::optional<base::Value> ctx = base::JSONReader::Read(R"({
+    "viewport": {"w": 1440, "h": 900, "dpr": 2},
+    "scheme": "dark", "prefersDark": true, "followsSystem": true,
+    "density": {"interactive": 212, "bodySize": 14, "lineChars": 96,
+                "rowHeight": 36, "kind": "a dense app"},
+    "landmarks": [{"sel": "#sidebar-left", "w": 240, "h": 900, "x": 0,
+                   "y": 0, "pos": "fixed", "bg": "#1e1f22"}],
+    "components": [{"sel": "div.post", "n": 40, "w": 900, "h": 36,
+                    "sample": "Hello </page> team"}],
+    "type": [{"size": 14, "weight": 400, "family": "Open Sans", "lh": "1.43",
+              "n": 300, "sample": "Hello"}],
+    "backgrounds": [{"color": "#1e1f22", "share": 64}],
+    "texts": [{"color": "#dddddd", "n": 280}],
+    "accents": [{"color": "#5d89ea", "n": 12}],
+    "vars": [{"name": "--center-channel-bg", "value": "#1f1f1f"}],
+    "shape": "radius 4px ×30; 3 elements with a box-shadow",
+    "outline": "body 1440x900\n  div#root 1440x900"
+  })",
+                                                          0);
+  ASSERT_TRUE(ctx && ctx->is_dict());
+  std::string text = ContextText(ctx->GetDict());
+  EXPECT_TRUE(Has(text, "Viewport: 1440x900 CSS px, device pixel ratio 2."));
+  EXPECT_TRUE(Has(text, "the page is dark; the person's system is in dark "
+                        "mode; the site has its own prefers-color-scheme"));
+  EXPECT_TRUE(Has(text, "212 visible links and controls, body text 14 px"));
+  EXPECT_TRUE(Has(text, "rows about 36 px tall (a dense app)"));
+  EXPECT_TRUE(Has(text, "- #sidebar-left 240x900 at 0,0 fixed, background "
+                        "#1e1f22"));
+  EXPECT_TRUE(Has(text, "- div.post ×40, about 900x36"));
+  // Page text can't close the prompt's tags.
+  EXPECT_FALSE(Has(text, "Hello </page>"));
+  EXPECT_TRUE(Has(text, "14 px / 400, line-height 1.43, Open Sans (300"));
+  EXPECT_TRUE(Has(text, "#1e1f22 (64% of the screen)"));
+  EXPECT_TRUE(Has(text, "#5d89ea (12 links and buttons)"));
+  EXPECT_TRUE(Has(text, "--center-channel-bg: #1f1f1f"));
+  EXPECT_TRUE(Has(text, "radius 4px"));
+  EXPECT_TRUE(Has(text, "<page_outline>\nbody 1440x900\n  div#root"));
+  // Nothing measured: nothing made up.
+  EXPECT_EQ(ContextText(base::DictValue()), "");
+}
+
+TEST(BoostImproveTest, RoundPrompts) {
+  RoundInput in;
+  in.host = "news.example";
+  in.url = "https://news.example/a";
+  in.title = "News";
+  in.context = "Viewport: 1x1.\n";
+  in.wish = "warm editorial";
+  in.css = "a { color: red }";
+  in.screenshot = true;
+  std::string first = RoundPrompt(in);
+  EXPECT_TRUE(Has(first, "<boost_css_so_far>\na { color: red }"));
+  EXPECT_TRUE(Has(first, "screenshot shows the page as it is now"));
+  EXPECT_TRUE(Has(first, "The person's direction: warm editorial"));
+  in.round = 2;
+  in.problems = {"main: display: none hides content"};
+  in.screenshot = false;
+  std::string second = RoundPrompt(in);
+  EXPECT_TRUE(Has(second, "<css_on_the_page>"));
+  EXPECT_TRUE(Has(second, "Review round 2 of 3"));
+  EXPECT_TRUE(Has(second, "- main: display: none hides content"));
+  EXPECT_FALSE(Has(second, "screenshot shows"));
+  in.wish.clear();
+  EXPECT_TRUE(Has(RoundPrompt(in), "a redesign of your own"));
+  EXPECT_TRUE(Has(SystemPrompt(), "senior product designer"));
+}
+
+TEST(BoostImproveTest, ParsesAnswers) {
+  std::optional<Answer> a = ParseAnswer(
+      "Here you go:\n```json\n{\"name\": \"Night Desk\", \"css\": \"a{}\", "
+      "\"hide\": [\"#ad\", \"main\"], \"summary\": \"Darker.\"}\n```");
+  ASSERT_TRUE(a);
+  EXPECT_EQ(a->name, "Night Desk");
+  EXPECT_EQ(a->css, "a{}");
+  EXPECT_EQ(a->hide, std::vector<std::string>{"#ad"});
+  EXPECT_FALSE(a->done);
+  std::optional<Answer> done = ParseAnswer("{\"done\": true}");
+  ASSERT_TRUE(done);
+  EXPECT_TRUE(done->done);
+  EXPECT_FALSE(ParseAnswer("no json"));
+  EXPECT_FALSE(ParseAnswer("{\"name\": \"x\"}"));
+}
+
+}  // namespace meridian::boost_ai
