diff --git a/chrome/browser/resources/webui_browser/meridian/boost_magic.css b/chrome/browser/resources/webui_browser/meridian/boost_magic.css
new file mode 100644
index 0000000000..0baf170c0b
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/boost_magic.css
@@ -0,0 +1,246 @@
+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+/* Over the page's area (placed by boost_magic.ts), under the Boost editor. */
+:host {
+  position: fixed;
+  z-index: 93;
+  pointer-events: none;
+  display: block;
+  border-radius: var(--meridian-radius, 10px);
+  overflow: hidden;
+  opacity: 0;
+  visibility: hidden;
+  transition: opacity 450ms ease, visibility 0s linear 450ms;
+  /* Our iridescence: violet, blue, cyan, mint, peach, rose. */
+  --magic: conic-gradient(from 0deg, #8b5cf6, #3b82f6, #22d3ee, #34d399,
+      #fbbf24, #fb7185, #c084fc, #8b5cf6);
+}
+
+:host([state='running']),
+:host([state='done']) {
+  opacity: 1;
+  visibility: visible;
+  transition: opacity 450ms ease;
+}
+
+#frame {
+  position: absolute;
+  inset: 0;
+}
+
+/* A ring: a big square of the gradient turning, seen only at the edges. */
+.ring {
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  mask: linear-gradient(#000 0 0) content-box exclude,
+      linear-gradient(#000 0 0);
+  overflow: hidden;
+}
+
+.ring i {
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  /* Covers the page's corners while it turns (its diagonal). */
+  width: 150vmax;
+  height: 150vmax;
+  margin: -75vmax 0 0 -75vmax;
+  background: var(--magic);
+  animation: magic-turn 4.5s linear infinite;
+  will-change: transform;
+}
+
+.ring.edge {
+  padding: 2.5px;
+  opacity: 0.95;
+}
+
+/* The soft glow inside the edge, breathing. */
+.ring.glow {
+  padding: 22px;
+  filter: blur(14px);
+  opacity: 0.55;
+  animation: magic-breathe 2.6s ease-in-out infinite alternate;
+}
+
+/* A faint light passing over the page. */
+.shimmer {
+  position: absolute;
+  inset: 0;
+  overflow: hidden;
+}
+
+.shimmer i {
+  position: absolute;
+  top: -20%;
+  bottom: -20%;
+  left: 0;
+  width: 45%;
+  background: linear-gradient(100deg, transparent,
+      rgba(255, 255, 255, 0.10) 40%, rgba(190, 170, 255, 0.12) 50%,
+      rgba(255, 255, 255, 0.10) 60%, transparent);
+  transform: translateX(-120%) skewX(-12deg);
+  animation: magic-sweep 3.2s ease-in-out infinite;
+  will-change: transform;
+}
+
+/* A round's CSS landed: a soft veil lifts off the new look. */
+.veil {
+  position: absolute;
+  inset: 0;
+  background: rgba(250, 248, 255, 0.55);
+  opacity: 0;
+}
+
+.veil.on {
+  animation: magic-reveal 900ms ease-out;
+}
+
+.pill {
+  position: absolute;
+  left: 50%;
+  bottom: 22px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  max-width: calc(100% - 48px);
+  padding: 8px 14px 8px 10px;
+  border-radius: 999px;
+  color: #fff;
+  font: 500 12.5px/1.3 system-ui, -apple-system, sans-serif;
+  white-space: nowrap;
+  background: rgba(22, 20, 34, 0.78);
+  box-shadow: 0 8px 28px rgba(40, 20, 90, 0.35),
+      inset 0 0 0 1px rgba(255, 255, 255, 0.12);
+  backdrop-filter: blur(14px) saturate(1.4);
+  transform: translate(-50%, 0);
+  animation: magic-pill-in 420ms cubic-bezier(0.2, 0.9, 0.3, 1.2);
+}
+
+.pill .text {
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.pill .detail {
+  margin-left: 6px;
+  opacity: 0.72;
+  font-weight: 400;
+}
+
+.spark {
+  display: grid;
+  place-items: center;
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  background: var(--magic);
+  animation: magic-turn 3s linear infinite;
+}
+
+.spark svg {
+  /* Upright while the disc turns under it. */
+  animation: magic-turn 3s linear infinite reverse;
+}
+
+.undo {
+  pointer-events: auto;
+  border: 0;
+  padding: 3px 10px;
+  border-radius: 999px;
+  font: inherit;
+  font-weight: 600;
+  color: #1b1530;
+  background: #fff;
+  cursor: pointer;
+}
+
+.undo:focus-visible {
+  outline: 2px solid #a78bfa;
+  outline-offset: 2px;
+}
+
+/* Done: the glow resolves into one calm ring that fades. */
+:host([state='done']) .ring i,
+:host([state='done']) .spark,
+:host([state='done']) .spark svg {
+  animation-play-state: paused;
+}
+
+:host([state='done']) .ring.glow {
+  animation: magic-resolve 1.2s ease-out forwards;
+}
+
+:host([state='done']) .shimmer {
+  opacity: 0;
+  transition: opacity 600ms ease;
+}
+
+@keyframes magic-turn {
+  to { transform: rotate(1turn); }
+}
+
+@keyframes magic-breathe {
+  from { opacity: 0.35; }
+  to { opacity: 0.7; }
+}
+
+@keyframes magic-sweep {
+  0% { transform: translateX(-120%) skewX(-12deg); }
+  70%,
+  100% { transform: translateX(320%) skewX(-12deg); }
+}
+
+@keyframes magic-reveal {
+  from { opacity: 1; }
+  to { opacity: 0; }
+}
+
+@keyframes magic-resolve {
+  from { opacity: 0.8; }
+  to { opacity: 0.15; }
+}
+
+@keyframes magic-pill-in {
+  from {
+    opacity: 0;
+    transform: translate(-50%, 10px) scale(0.96);
+  }
+
+  to {
+    opacity: 1;
+    transform: translate(-50%, 0) scale(1);
+  }
+}
+
+/* Reduced motion: the same glow, standing still, and the text. */
+@media (prefers-reduced-motion: reduce) {
+  .ring i,
+  .ring.glow,
+  .shimmer i,
+  .spark,
+  .spark svg,
+  .pill,
+  .veil.on,
+  :host([state='done']) .ring.glow {
+    animation: none;
+  }
+
+  .shimmer {
+    display: none;
+  }
+
+  :host,
+  :host([state='running']),
+  :host([state='done']) {
+    transition: none;
+  }
+}
