+<div id="pill" class="pill" role="status" aria-live="polite">
+  <span class="spark">${icon('sparkles', 14)}</span>
+  ${this.state === 'done' ? html`
+    <span class="text"><b>Done</b></span>
+    <button id="magicUndo" class="undo" @click="${this.onUndoClick_}">
+      Undo</button>` : html`
+    <span class="text"><b>${this.label_}</b>${this.detail_ ? html`
+      <span class="detail">${this.detail_}</span>` : ''}</span>`}
+</div>
+<!--_html_template_end_-->`;
+}
