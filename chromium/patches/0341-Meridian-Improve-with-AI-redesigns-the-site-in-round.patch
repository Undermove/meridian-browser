+// Improve with AI for one tab: a redesign in up to three rounds. The page is
+// measured (boost_ai::ContextText) and, for the AIs that see pictures,
+// photographed; the AI answers with CSS, which is checked
+// (boost_ai::CheckCss) and saved into the boost, so the page shows it; then
+// a new screenshot goes back for a critique and a fixed CSS, until the AI
+// says it's done, three rounds, or the time is up (the last good CSS stays).
+class BoostImprover {
+ public:
+  using Done = base::OnceCallback<void(std::string error, std::string summary)>;
+
+  explicit BoostImprover(content::WebContents* contents);
+  BoostImprover(const BoostImprover&) = delete;
+  BoostImprover& operator=(const BoostImprover&) = delete;
+  ~BoostImprover();
+
+  // `boost_id`: the boost it goes into ("" or gone: the site's first, or a
+  // new one). `wish`: the person's direction. `provider` "": Settings > AI.
+  void Start(const std::string& boost_id,
+             const std::string& wish,
+             const std::string& provider,
+             Done done);
+  bool running() const { return !done_.is_null(); }
+  // "Designing… 1/3" and so on while it runs, else "".
+  const std::string& progress() const { return progress_; }
+  // What the round is about ("looking at the layout"), for the page's
+  // status pill.
+  const std::string& detail() const { return detail_; }
+  // How many rounds' CSS reached the page so far (the page's overlay
+  // softens each change).
+  int applied() const { return applied_count_; }
+
+ private:
+  BoostService* service();
+  AiService* ai();
+  // The boost it changes, if there is one yet.
+  const Boost* Target();
+  void OnContext(base::Value context);
+  // A JPEG of the tab (base64), or "" when it can't be had.
+  void Capture(base::OnceCallback<void(std::string)> next);
+  void Ask(std::string image);
+  void OnAiEvent(int round, const std::string& type, const std::string& text);
+  void OnAnswer(int round, std::string answer);
+  void OnHideChecked(boost_ai::Answer answer,
+                     boost_ai::CssCheck check,
+                     base::Value safe);
+  void NextRound();
+  void OnDeadline();
+  // Ends the run: `error` if nothing was applied, else the summary.
+  void Finish(std::string error);
+  void SetProgress(std::string text, std::string detail);
+
+  raw_ptr<content::WebContents> contents_;
+  std::string boost_id_;
+  std::string wish_;
+  std::string provider_;
+  std::string host_;
+  std::string url_;
+  std::string title_;
+  std::string context_;
+  bool sees_images_ = false;
+  int round_ = 0;
+  // The CSS on the page from the last good round ("" before the first).
+  std::string css_;
+  // The boost's CSS before Improve.
+  std::string css_before_;
+  std::vector<std::string> problems_;
+  std::string summary_;
+  bool applied_ = false;
+  // The round being asked.
+  std::string session_;
+  std::string answer_;
+  base::TimeTicks started_;
+  base::OneShotTimer deadline_;
+  base::OneShotTimer settle_;
+  Done done_;
+  std::string progress_;
+  std::string detail_;
+  int applied_count_ = 0;
+  base::WeakPtrFactory<BoostImprover> run_weak_factory_{this};
+  base::WeakPtrFactory<BoostImprover> weak_factory_{this};
+};
+
+}  // namespace meridian
