@@ -137,6 +139,79 @@ export class TabWebviewElement extends WebviewElement {
     }
   }
 
+  // Meridian: DevTools docked in this tab cover its area, as in Chrome; the
+  // page lies over them where they say (their splitter is their own).
+  private devtools_: WebviewElement|null = null;
+  private devtoolsLayout_: DevtoolsLayout|null = null;
+  private devtoolsResize_: ResizeObserver|null = null;
+
+  setDevtools(layout: DevtoolsLayout|null) {
+    this.devtoolsLayout_ = layout;
+    if (!layout) {
+      this.devtools_?.remove();
+      this.devtools_ = null;
+      this.devtoolsResize_?.disconnect();
+      this.devtoolsResize_ = null;
+      this.toggleAttribute('devtools', false);
+      this.style.removeProperty('--page-rect');
+      this.placePage_();
+      return;
+    }
+    if (!this.devtools_) {
+      this.devtools_ = document.createElement('cr-webview');
+      this.devtools_.classList.add('devtools');
+      this.devtools_.allowPinchZoom = false;
+      this.shadowRoot.prepend(this.devtools_);
+      this.devtoolsResize_ = new ResizeObserver(() => this.placePage_());
+      this.devtoolsResize_.observe(this);
+    }
+    const id = layout.devtoolsId;
+    if (this.devtools_.guestId !== id) {
+      this.devtools_.guestId = id;
+    }
+    this.toggleAttribute('devtools', true);
+    this.placePage_();
+  }
+
+  // DevTools' resizing strategy applied to this tab's size (Chrome:
+  // ApplyDevToolsContentsResizingStrategy).
+  private placePage_() {
+    const layout = this.devtoolsLayout_;
+    const target = this.pageElement_();
+    if (!target) {
+      return;
+    }
+    if (!layout || (!layout.hideInspected && (!layout.width || !layout.height))) {
+      target.style.removeProperty('left');
+      target.style.removeProperty('top');
+      target.style.removeProperty('width');
+      target.style.removeProperty('height');
+      target.style.removeProperty('visibility');
+      return;
+    }
+    const w = this.clientWidth;
+    const h = this.clientHeight;
+    const left = Math.min(layout.x, w);
+    const top = Math.min(layout.y, h);
+    let width = Math.min(layout.width, w);
+    let height = Math.min(layout.height, h);
+    if (layout.dockSide === 'right') {
+      width = Math.min(width, Math.max(0, w - 250));
+    } else if (layout.dockSide === 'bottom') {
+      height = Math.min(height, Math.max(0, h - 72));
+    }
+    target.style.left = `${left}px`;
+    target.style.top = `${top}px`;
+    target.style.width = `${width}px`;
+    target.style.height = `${height}px`;
+    target.style.visibility = layout.hideInspected ? 'hidden' : '';
+  }
+
+  // The tab's own page (the DevTools one is inside their <cr-webview>).
+  private pageElement_(): HTMLElement|null {
+    return this.shadowRoot.querySelector<HTMLElement>('.content');
+  }
+
   openPageInfoMenu() {
     this.guestHandler.openPageInfoMenu();
   }
