+void WebUIBrowserWindow::UpdateDevtoolsForContents(
+    content::WebContents* inspected) {
+  tabs::TabInterface* tab =
+      inspected ? tabs::TabInterface::MaybeGetFromContents(inspected) : nullptr;
+  webui_browser::mojom::Page* page = GetWebUIBrowserUI()->page();
+  if (!tab || !page) {
+    return;
+  }
+  DevToolsContentsResizingStrategy strategy;
+  content::WebContents* devtools =
+      DevToolsWindow::GetInTabWebContents(inspected, &strategy);
+  // DevTools leaving the tab (undocked into their own window, or closed) let
+  // go of the embed now: their window takes them right after this, before the
+  // WebUI's own detach arrives, which would leave them hidden there, 0x0.
+  const tabs::TabHandle handle = tab->GetHandle();
+  if (auto it = docked_devtools_.find(handle); it != docked_devtools_.end()) {
+    content::WebContents* before = it->second.get();
+    if (before && before != devtools) {
+      if (auto* connector = before->GetSurfaceEmbedConnector()) {
+        connector->GetDelegate()->DetachedByHost();
+      }
+    }
+    docked_devtools_.erase(it);
+  }
+  if (devtools) {
+    docked_devtools_[handle] = devtools->GetWeakPtr();
+  }
+  webui_browser::mojom::DevtoolsLayoutPtr layout;
+  if (devtools) {
+    surface_embed::SurfaceEmbedHandle::CreateForWebContents(devtools);
+    layout = webui_browser::mojom::DevtoolsLayout::New();
+    layout->devtools_id =
+        surface_embed::SurfaceEmbedHandle::FromWebContents(devtools)->id();
+    layout->x = strategy.bounds().x();
+    layout->y = strategy.bounds().y();
+    layout->width = strategy.bounds().width();
+    layout->height = strategy.bounds().height();
+    layout->hide_inspected = strategy.hide_inspected_contents();
+    switch (strategy.dock_side()) {
+      case devtools::DockSide::kRight:
+        layout->dock_side = "right";
+        break;
+      case devtools::DockSide::kBottom:
+        layout->dock_side = "bottom";
+        break;
+      case devtools::DockSide::kLeft:
+        layout->dock_side = "left";
+        break;
+      default:
+        break;
+    }
+  }
+  page->OnDevtoolsChanged(tabs_api::NodeId::FromTabHandle(tab->GetHandle()),
+                          std::move(layout));
+}
+
