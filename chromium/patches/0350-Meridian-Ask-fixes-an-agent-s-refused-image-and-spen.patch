+TEST(ProvidersTest, ImageRefusalsAreRecognised) {
+  // The report: a Spring gateway in front of an OpenAI-compatible model.
+  EXPECT_TRUE(LooksLikeImageRefused(
+      "Provider request failed with HTTP 400: {\"source\":\"CLIENT\","
+      "\"type\":\"VALIDATION\",\"internalMessage\":\"400 BAD_REQUEST "
+      "\\\"Failed to read HTTP message\\\"\"}"));
+  EXPECT_TRUE(LooksLikeImageRefused("This model does not support image input"));
+  EXPECT_TRUE(LooksLikeImageRefused("Image content is not supported"));
+  EXPECT_TRUE(LooksLikeImageRefused("unknown variant `image_url`, expected `text`"));
+  EXPECT_FALSE(LooksLikeImageRefused("HTTP 401 unauthorized"));
+  EXPECT_FALSE(LooksLikeImageRefused("Free usage limit reached"));
+  EXPECT_FALSE(LooksLikeImageRefused(""));
+}
