+  const std::string said = run->error + "\n" + stderr_text;
+  const bool failed = !timed_out && !too_long && !killed &&
+                      (!run->error.empty() || exit_code != 0);
+  // The provider refused an image (a screenshot from an MCP server, say):
+  // once more without any, remembered for this agent and model.
+  if (failed && !run->text_only && !run->retried &&
+      LooksLikeImageRefused(said)) {
+    const std::string key = run->provider_id + "|" + run->model;
+    ScopedListPrefUpdate update(profile_->GetPrefs(), prefs::kAiTextOnly);
+    if (std::ranges::find(*update, base::Value(key)) == update->end()) {
+      update->Append(key);
+    }
+    run->retried = true;
+    run->turn.text_only = true;
+    run->text.clear();
+    run->final_text.clear();
+    run->error.clear();
+    run->events.Run("reset", std::string());
+    StartCli(run_id);
+    return;
