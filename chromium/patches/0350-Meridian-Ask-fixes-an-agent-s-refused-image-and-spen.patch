+std::vector<std::string> OpenCodeConfiguredModels(
+    const std::vector<std::string>& configs) {
+  std::vector<std::string> out;
+  for (const std::string& text : configs) {
+    std::optional<base::DictValue> root = ReadJsonc(text);
+    const base::DictValue* providers =
+        root ? root->FindDict("provider") : nullptr;
+    if (!providers) {
+      continue;
+    }
+    for (const auto [provider_id, provider] : *providers) {
+      const base::DictValue* models =
+          provider.is_dict() ? provider.GetDict().FindDict("models") : nullptr;
+      if (!models || provider_id == "opencode") {
+        continue;
+      }
+      for (const auto [model_id, model] : *models) {
+        const std::string ref = provider_id + "/" + model_id;
+        if (IsModelRef(ref) && std::ranges::find(out, ref) == out.end()) {
+          out.push_back(ref);
+        }
+      }
+    }
+  }
+  return out;
+}
+
+bool LooksLikeImageRefused(const std::string& error) {
+  return RE2::PartialMatch(
+      error,
+      "(?i)failed to read http message|"
+      "(?:does not|doesn.t|cannot|can.t) (?:support|accept|read|process) "
+      "(?:image|vision)|"
+      "image(?: input| content| parts?|s)? (?:is |are )?(?:not supported|"
+      "unsupported|not allowed)|"
+      "unsupported (?:content type|image|media)|invalid (?:image|content "
+      "type)|unknown variant .?image_url");
+}
+
+bool IsOpenCodeFreeLimit(const std::string& error) {
+  return RE2::PartialMatch(error, "(?i)free usage limit");
+}
