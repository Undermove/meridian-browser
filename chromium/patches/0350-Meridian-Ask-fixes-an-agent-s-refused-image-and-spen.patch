+void SidebarHandler::SetCliModel(const std::string& id,
+                                 const std::string& model) {
+  const ai::Provider* p = ai::FindProvider(id);
+  if (!p || p->kind != ai::Kind::kCli || model.size() > 200) {
+    return;
+  }
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              prefs::kAiModels);
+  if (model.empty()) {
+    update->Remove(id);
+  } else {
+    update->Set(id, model);
+  }
+}
