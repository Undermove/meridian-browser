+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianFavElement} from './fav.js';
+
+export function getHtml(this: MeridianFavElement) {
+  return html`<!--_html_template_start_-->
+${this.item ? html`
+  <div class="fav ${this.tab_ ? 'loaded' : ''} ${
+      this.tab_?.isActive ? 'active' : ''}" data-item="${this.item.id}"
+      title="${this.item.title}" @mousedown="${this.onTileMousedown_}"
+      @contextmenu="${this.onTileContextmenu_}">
+    <img src="${this.favicon_}" width="20" height="20" alt="">
+  </div>
+` : ''}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/fav.ts b/chrome/browser/resources/webui_browser/meridian/fav.ts
new file mode 100644
index 0000000000..92d4a7c5f8
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/fav.ts
@@ -0,0 +1,70 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A favorite tile at the top of the sidebar.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+import type {Tab} from '/tab_strip_api/tab_strip_api_data_model.mojom-webui.js';
+
+import type {Item} from '../sidebar.mojom-webui.js';
+
+import {getHtml} from './fav.html.js';
+import {getCss} from './rows.css.js';
+import {FAVORITES} from './sidebar.js';
+import type {MeridianSidebarElement} from './sidebar.js';
+
+export class MeridianFavElement extends CrLitElement {
+  static get is() {
+    return 'meridian-fav';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      item: {type: Object},
+      host: {type: Object},
+      rev: {type: Number},
+      tab_: {state: true, type: Object},
+      favicon_: {state: true, type: String},
+    };
+  }
+
+  accessor item: Item|null = null;
+  accessor host: MeridianSidebarElement|null = null;
+  accessor rev: number = 0;
+  protected accessor tab_: Tab|null = null;
+  protected accessor favicon_: string = '';
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    if (this.item && this.host) {
+      this.tab_ = this.host.liveTab(this.item.id);
+      this.favicon_ = this.host.faviconFor(this.item, this.tab_);
+    }
+  }
+
+  protected onTileMousedown_(e: MouseEvent) {
+    this.host?.onItemMouseDown(e, this.item!);
+  }
+
+  protected onTileContextmenu_(e: MouseEvent) {
+    this.host?.onItemContextMenu(e, this.item!, FAVORITES);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-fav': MeridianFavElement;
+  }
+}
+
+customElements.define(MeridianFavElement.is, MeridianFavElement);
