+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+/* Rows, tiles and controls shared by the sidebar's elements. Mirrors the
+ * Electron sidebar (src/renderer/styles.css). */
+
+:host {
+  display: block;
+  color: var(--meridian-text);
+}
+
+button {
+  font: inherit;
+  color: inherit;
+  background: none;
+  border: 0;
+  padding: 0;
+  cursor: default;
+}
+
+.row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  height: 34px;
+  padding: 0 6px 0 calc(10px + var(--depth, 0) * 14px);
+  border-radius: 8px;
+  width: 100%;
+  box-sizing: border-box;
+  text-align: left;
+  position: relative;
+}
+
+.row:hover {
+  background: var(--meridian-row-hover);
+}
+
+.row.active {
+  background: var(--meridian-row-active);
+  box-shadow: var(--meridian-row-shadow);
+}
+
+.row .title {
+  flex: 1;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.row-btn {
+  width: 22px;
+  height: 22px;
+  border-radius: 6px;
+  flex: none;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--meridian-text-muted);
+}
+
+.row-btn:hover {
+  background: var(--meridian-row-hover);
+  color: var(--meridian-text);
+}
+
+.row .close {
+  opacity: 0;
+}
+
+.row:hover .close,
+.row.active .close {
+  opacity: 1;
+}
+
+.row .reset {
+  margin-left: -4px;
+  margin-right: -4px;
+  width: 16px;
+}
+
+.favicon {
+  display: inline-flex;
+  flex: none;
+  width: 16px;
+  height: 16px;
+  border-radius: 4px;
+  overflow: hidden;
+}
+
+.favicon img {
+  display: block;
+  object-fit: contain;
+}
+
+.folder-ic {
+  display: inline-flex;
+  width: 16px;
+  justify-content: center;
+  opacity: 0.75;
+}
+
+/* Folders read bold, like Arc, so they stand apart from pages. */
+.row.folder > .title {
+  font-weight: 650;
+}
+
+.folder-wrap.collapsed > .children {
+  display: none;
+}
+
+.fav {
+  height: 46px;
+  border-radius: 10px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: color-mix(in srgb, var(--meridian-row-active) 45%, transparent);
+  position: relative;
+}
+
+.fav:hover {
+  background: var(--meridian-row-active);
+}
+
+.fav.active {
+  background: var(--meridian-row-active);
+  box-shadow: var(--meridian-row-shadow),
+    inset 0 0 0 2px color-mix(in srgb, var(--meridian-space) 75%, transparent);
+}
+
+.fav.loaded::after {
+  content: '';
+  position: absolute;
+  bottom: 5px;
+  width: 4px;
+  height: 4px;
+  border-radius: 50%;
+  background: var(--meridian-text-muted);
+}
+
+input.rename {
+  flex: 1;
+  min-width: 0;
+  font: inherit;
+  color: var(--meridian-text);
+  background: var(--meridian-surface);
+  border: 0;
+  outline: 2px solid color-mix(in srgb, var(--meridian-space) 70%, transparent);
+  border-radius: 5px;
+  padding: 2px 5px;
+}
+
diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.css b/chrome/browser/resources/webui_browser/meridian/sidebar.css
