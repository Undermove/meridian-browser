+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/tab_data.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/web_contents.h"
+
+namespace meridian {
+
+namespace {
+constexpr char kSpaceKey[] = "meridian.space";
+constexpr char kItemKey[] = "meridian.item";
+}  // namespace
+
+TabData::TabData(content::WebContents* contents)
+    : content::WebContentsUserData<TabData>(*contents) {}
+
+TabData::~TabData() = default;
+
+// static
+const TabData* TabData::Get(content::WebContents* contents) {
+  return FromWebContents(contents);
+}
+
+// static
+void TabData::Set(content::WebContents* contents,
+                  const std::string& space_id,
+                  const std::string& item_id) {
+  CreateForWebContents(contents);
+  TabData* data = FromWebContents(contents);
+  if (data->space_id_ == space_id && data->item_id_ == item_id) {
+    return;
+  }
+  data->space_id_ = space_id;
+  data->item_id_ = item_id;
+  data->Persist();
+}
+
+// static
+void TabData::RestoreFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  auto space = extra_data.find(kSpaceKey);
+  if (space == extra_data.end()) {
+    return;
+  }
+  CreateForWebContents(contents);
+  TabData* data = FromWebContents(contents);
+  data->space_id_ = space->second;
+  auto item = extra_data.find(kItemKey);
+  data->item_id_ = item == extra_data.end() ? std::string() : item->second;
+}
+
+void TabData::Persist() {
+  content::WebContents* contents = &GetWebContents();
+  Profile* profile =
+      Profile::FromBrowserContext(contents->GetBrowserContext());
+  SessionService* session = SessionServiceFactory::GetForProfile(profile);
+  if (!session) {
+    return;  // incognito, or session saving is off
+  }
+  SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+  session->AddTabExtraData(window_id, tab_id, kSpaceKey, space_id_);
+  session->AddTabExtraData(window_id, tab_id, kItemKey, item_id_);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabData);
+
+}  // namespace meridian
