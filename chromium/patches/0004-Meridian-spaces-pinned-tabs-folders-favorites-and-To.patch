--- /dev/null
+++ b/chrome/browser/meridian/sidebar.mojom
@@ -0,0 +1,96 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module meridian.mojom;
+
+import "components/browser_apis/tab_strip/tab_strip_api_types.mojom";
+import "url/mojom/url.mojom";
+
+// A pinned link or a folder in the sidebar. Links remember their home URL;
+// the live tab for a link (if any) is found through TabInfo.item_id.
+struct Item {
+  string id;
+  bool is_folder;
+  string title;
+  url.mojom.Url url;
+  // Folders: expanded in the sidebar.
+  bool open;
+  array<Item> children;
+};
+
+struct Space {
+  string id;
+  string name;
+  // An emoji or a short icon name; empty for the default dot.
+  string icon;
+  // Two CSS colours for the window tint gradient.
+  string color;
+  string color2;
+  array<Item> pinned;
+};
+
+// Which space a live tab belongs to, and which pinned item / favorite it is
+// the live tab of (empty for a Today tab).
+struct TabInfo {
+  tabs_api.mojom.NodeId tab_id;
+  string space_id;
+  string item_id;
+};
+
+struct SidebarState {
+  array<Space> spaces;
+  string active_space_id;
+  // Shared by every space of the profile.
+  array<Item> favorites;
+  array<TabInfo> tabs;
+};
+
+// Where an item goes. `container` is a space id, or "favorites".
+struct ItemPosition {
+  string container;
+  // A folder id inside the container, or empty for the top level.
+  string parent_id;
+  int32 index;
+};
+
+interface SidebarHandlerFactory {
+  CreateSidebarHandler(pending_remote<SidebarPage> page,
+                       pending_receiver<SidebarHandler> handler);
+};
+
+interface SidebarPage {
+  // The whole state, after any change (from this window, another window or
+  // an agent).
+  OnStateChanged(SidebarState state);
+};
+
+interface SidebarHandler {
+  GetState() => (SidebarState state);
+
+  CreateSpace(string name, string icon, string color, string color2)
+      => (string space_id);
+  UpdateSpace(string space_id, string name, string icon, string color,
+              string color2);
+  // Closes the space's tabs and forgets its pinned items.
+  DeleteSpace(string space_id);
+  MoveSpace(string space_id, int32 index);
+  // Shows the space: its last active tab, or a new tab if it has none.
+  ActivateSpace(string space_id);
+  // Moves a live tab (and any item it is linked to stays where it is).
+  MoveTabToSpace(tabs_api.mojom.NodeId tab_id, string space_id);
+
+  // Pins a live tab: it becomes the live tab of a new item at `position`.
+  PinTab(tabs_api.mojom.NodeId tab_id, ItemPosition position);
+  AddFolder(ItemPosition position, string title) => (string item_id);
+  MoveItem(string item_id, ItemPosition position);
+  // Unpins: the item is forgotten and its live tab, if any, joins Today.
+  // Removing a folder unpins everything in it.
+  RemoveItem(string item_id);
+  RenameItem(string item_id, string title);
+  SetFolderOpen(string item_id, bool open);
+  // Activates the item's live tab, or opens its home URL in a new tab.
+  OpenItem(string item_id);
+  // Sends the item's live tab back to the home URL.
+  ResetItemToHome(string item_id);
+};
