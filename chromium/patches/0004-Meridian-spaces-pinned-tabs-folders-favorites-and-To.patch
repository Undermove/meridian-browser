+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import type {MeridianTabRowElement} from './tab_row.js';
+
+export function getHtml(this: MeridianTabRowElement) {
+  return html`<!--_html_template_start_-->
+${this.tab ? html`
+  <div class="row tab ${this.tab.isActive ? 'active' : ''}"
+      data-tab="${this.tab.id}" title="${this.tab.title}"
+      @mousedown="${this.onRowMousedown_}"
+      @contextmenu="${this.onRowContextmenu_}">
+    <span class="favicon">
+      <img src="${this.favicon_}" width="16" height="16" alt="">
+    </span>
+    <span class="title">${this.tab.title || this.tab.url}</span>
+    <button class="row-btn close" title="Close" @click="${this.onCloseClick_}">
+      ${icon('x', 14)}
+    </button>
+  </div>
+` : ''}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/tab_row.ts b/chrome/browser/resources/webui_browser/meridian/tab_row.ts
