diff --git a/chrome/browser/meridian/sidebar_service_unittest.cc b/chrome/browser/meridian/sidebar_service_unittest.cc
new file mode 100644
index 0000000000..9530a8f3df
--- /dev/null
+++ b/chrome/browser/meridian/sidebar_service_unittest.cc
@@ -0,0 +1,154 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/sidebar_service.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian {
+namespace {
+
+class Waiter : public SidebarService::Observer {
+ public:
+  explicit Waiter(SidebarService* s) : s_(s) { s_->AddObserver(this); }
+  ~Waiter() override { s_->RemoveObserver(this); }
+  void OnSidebarChanged() override { ++changes; }
+  int changes = 0;
+
+ private:
+  raw_ptr<SidebarService> s_;
+};
+
+Item Link(const std::string& title, const std::string& url) {
+  Item item;
+  item.title = title;
+  item.url = GURL(url);
+  return item;
+}
+
+Item Folder(const std::string& title) {
+  Item item;
+  item.is_folder = true;
+  item.title = title;
+  return item;
+}
+
+class SidebarServiceTest : public testing::Test {
+ protected:
+  base::test::TaskEnvironment env_;
+};
+
+TEST_F(SidebarServiceTest, StartsWithOneActiveSpace) {
+  SidebarService service{base::FilePath()};
+  ASSERT_TRUE(service.loaded());
+  ASSERT_EQ(service.spaces().size(), 1u);
+  EXPECT_EQ(service.active_space_id(), service.spaces()[0].id);
+  EXPECT_FALSE(service.DeleteSpace(service.spaces()[0].id))
+      << "the last space stays";
+}
+
+TEST_F(SidebarServiceTest, ItemsFoldersAndMoves) {
+  SidebarService service{base::FilePath()};
+  const std::string space = service.spaces()[0].id;
+  std::string folder = service.AddItem(space, "", -1, Folder("Work"));
+  std::string docs = service.AddItem(space, "", -1, Link("Docs", "https://docs.example/"));
+  std::string mail = service.AddItem(space, folder, -1, Link("Mail", "https://mail.example/"));
+  ASSERT_FALSE(folder.empty());
+  ASSERT_FALSE(mail.empty());
+  EXPECT_EQ(service.ContainerOf(mail), space);
+  EXPECT_EQ(service.SubtreeIds(folder).size(), 2u);
+
+  // Into the folder, then to favorites.
+  EXPECT_TRUE(service.MoveItem(docs, space, folder, 0));
+  EXPECT_EQ(service.FindItem(folder)->children[0].id, docs);
+  EXPECT_TRUE(service.MoveItem(docs, kFavorites, "", -1));
+  EXPECT_EQ(service.ContainerOf(docs), kFavorites);
+
+  // A folder can't go into itself or its children.
+  EXPECT_FALSE(service.MoveItem(folder, space, folder, 0));
+  std::string inner = service.AddItem(space, folder, -1, Folder("Inner"));
+  EXPECT_FALSE(service.MoveItem(folder, space, inner, 0));
+
+  // Adding into a link is not allowed.
+  EXPECT_TRUE(service.AddItem(space, mail, -1, Link("x", "https://x/")).empty());
+
+  // Removing a folder removes what's in it.
+  EXPECT_TRUE(service.RemoveItem(folder));
+  EXPECT_EQ(service.FindItem(mail), nullptr);
+}
+
+TEST_F(SidebarServiceTest, DeletingTheActiveSpaceActivatesANeighbour) {
+  SidebarService service{base::FilePath()};
+  std::string first = service.spaces()[0].id;
+  std::string second = service.CreateSpace("Work", "", "#e08a8a", "");
+  ASSERT_TRUE(service.SetActiveSpace(second));
+  ASSERT_TRUE(service.DeleteSpace(second));
+  EXPECT_EQ(service.active_space_id(), first);
+  EXPECT_FALSE(service.SetActiveSpace("nope"));
+}
+
+TEST_F(SidebarServiceTest, SavesAndLoadsJson) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  std::string space, fav;
+  {
+    SidebarService service(dir.GetPath());
+    env_.RunUntilIdle();
+    ASSERT_TRUE(service.loaded());
+    space = service.CreateSpace("Work", "💼", "#e08a8a", "#f0b5a8");
+    service.SetActiveSpace(space);
+    std::string folder = service.AddItem(space, "", -1, Folder("Design"));
+    service.AddItem(space, folder, -1, Link("Figma", "https://figma.com/"));
+    fav = service.AddItem(kFavorites, "", -1, Link("Mail", "https://mail.example/"));
+    service.SetFolderOpen(folder, false);
+    service.FlushForTesting();
+    env_.RunUntilIdle();
+  }
+  std::string json;
+  ASSERT_TRUE(base::ReadFileToString(
+      dir.GetPath().AppendASCII("Meridian Sidebar.json"), &json));
+  EXPECT_NE(json.find("Figma"), std::string::npos);
+
+  SidebarService again(dir.GetPath());
+  env_.RunUntilIdle();
+  ASSERT_TRUE(again.loaded());
+  ASSERT_EQ(again.spaces().size(), 2u);
+  EXPECT_EQ(again.active_space_id(), space);
+  const Space* work = again.FindSpace(space);
+  ASSERT_TRUE(work);
+  EXPECT_EQ(work->icon, "💼");
+  EXPECT_EQ(work->color2, "#f0b5a8");
+  ASSERT_EQ(work->pinned.size(), 1u);
+  EXPECT_FALSE(work->pinned[0].open);
+  ASSERT_EQ(work->pinned[0].children.size(), 1u);
+  EXPECT_EQ(work->pinned[0].children[0].url, GURL("https://figma.com/"));
+  ASSERT_NE(again.FindItem(fav), nullptr);
+}
+
+TEST_F(SidebarServiceTest, IgnoresBrokenEntries) {
+  std::vector<Space> spaces;
+  std::vector<Item> favorites;
+  std::string active;
+  auto value = base::JSONReader::ReadDict(
+      R"({"spaces":[{"id":"a","name":"A","pinned":[{"id":"x","url":"not a url"},
+          {"id":"y","url":"https://ok/"},{"title":"no id","url":"https://z/"}]},
+          {"name":"no id"}],"favorites":[1,"s",{"id":"f","url":"https://f/"}],
+          "activeSpace":"a"})",
+      base::JSON_PARSE_RFC);
+  ASSERT_TRUE(value);
+  ASSERT_TRUE(SidebarService::FromValue(*value, &spaces, &favorites, &active));
+  ASSERT_EQ(spaces.size(), 1u);
+  ASSERT_EQ(spaces[0].pinned.size(), 1u);
+  EXPECT_EQ(spaces[0].pinned[0].id, "y");
+  EXPECT_EQ(spaces[0].color, "#8a8fe0") << "default colour";
+  ASSERT_EQ(favorites.size(), 1u);
+}
+
+}  // namespace
+}  // namespace meridian
