@@ -0,0 +1,207 @@
+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #import=./rows.css.js
+ * #scheme=relative
+ * #include=rows
+ * #css_wrapper_metadata_end */
+
+/* Mirrors the Electron sidebar (src/renderer/styles.css). Colours come from
+ * the --meridian-* variables set on <webui-browser-app>. */
+
+:host {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  min-height: 0;
+  color: var(--meridian-text);
+}
+
+button {
+  font: inherit;
+  color: inherit;
+  background: none;
+  border: 0;
+  padding: 0;
+  cursor: default;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+/* ------------------------------------------------------------ favorites */
+
+#favorites {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
+  gap: 8px;
+  margin-bottom: 10px;
+}
+
+#favorites.empty {
+  margin-bottom: 4px;
+}
+
+/* ------------------------------------------------------------ space page */
+
+#spacePage {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  overflow-x: hidden;
+  margin: 0 -4px;
+  padding: 0 4px;
+}
+
+#spacePage::-webkit-scrollbar {
+  width: 0;
+}
+
+.space-header {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 2px 8px 8px;
+  font-weight: 600;
+  color: var(--meridian-text-muted);
+}
+
+.divider {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin: 10px 4px 4px;
+  color: var(--meridian-text-muted);
+  font-size: 11px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+.divider::after {
+  content: '';
+  flex: 1;
+  height: 1px;
+  background: var(--meridian-border);
+}
+
+.row.new-tab {
+  color: var(--meridian-text-muted);
+}
+
+.row.new-tab .ic {
+  display: inline-flex;
+  margin: 0 1px;
+}
+
+/* ------------------------------------------------------------ bottom */
+
+#bottom {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  padding-top: 8px;
+}
+
+#spaceDots {
+  flex: 1;
+  display: flex;
+  justify-content: center;
+  gap: 2px;
+  overflow: hidden;
+}
+
+.space-dot {
+  width: 26px;
+  height: 26px;
+  border-radius: 7px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  opacity: 0.55;
+}
+
+.space-dot:hover {
+  background: var(--meridian-row-hover);
+  opacity: 0.9;
+}
+
+.space-dot.active {
+  opacity: 1;
+}
+
+.space-dot .dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--dot);
+  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
+}
+
+.space-dot.active .dot {
+  width: 10px;
+  height: 10px;
+}
+
+.space-dot .emoji {
+  font-size: 14px;
+  filter: grayscale(0.6);
+}
+
+.space-dot.active .emoji {
+  filter: none;
+}
+
+.icon-btn {
+  width: 28px;
+  height: 28px;
+  border-radius: 7px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--meridian-text-muted);
+}
+
+.icon-btn:hover {
+  background: var(--meridian-row-hover);
+  color: var(--meridian-text);
+}
+
+/* ------------------------------------------------------------ menu */
+
+#menu {
+  position: fixed;
+  z-index: 100;
+  min-width: 200px;
+  padding: 5px;
+  border-radius: 10px;
+  background: var(--meridian-surface);
+  box-shadow: 0 10px 34px rgba(0, 0, 0, 0.22), 0 0 0 0.5px var(--meridian-border);
+}
+
+.menu-item {
+  display: block;
+  width: 100%;
+  text-align: left;
+  padding: 6px 10px;
+  border-radius: 6px;
+  white-space: nowrap;
+}
+
+.menu-item:hover {
+  background: color-mix(in srgb, var(--meridian-space) 22%, transparent);
+}
+
+.menu-item.danger {
+  color: #d13c3c;
+}
+
+.menu-sep {
+  height: 1px;
+  margin: 4px 6px;
+  background: var(--meridian-border);
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.html.ts b/chrome/browser/resources/webui_browser/meridian/sidebar.html.ts
new file mode 100644
index 0000000000..059bf5d7a4
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.html.ts
@@ -0,0 +1,76 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html, repeat} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import type {MeridianSidebarElement} from './sidebar.js';
+
+export function getHtml(this: MeridianSidebarElement) {
+  return html`<!--_html_template_start_-->
+<div id="favorites" class="${this.favorites_.length ? '' : 'empty'}">
+  ${repeat(this.favorites_, f => f.id, f => html`
+    <meridian-fav .item="${f}" .host="${this}" .rev="${this.rev_}">
+    </meridian-fav>`)}
+</div>
+<div id="spacePage">
+  ${this.space_ ? html`
+    <div class="space-header" data-space="${this.space_.id}"
+        @contextmenu="${this.onSpaceHeaderContextmenu_}"
+        @dblclick="${this.onSpaceHeaderDblclick_}">
+      ${this.space_.icon ? html`
+        <span class="space-icon">${this.space_.icon}</span>` : ''}
+      ${this.renaming_ === this.space_.id ? html`
+        <input class="rename" .value="${this.space_.name}" spellcheck="false"
+            @keydown="${this.onRenameKeydown}"
+            @blur="${this.onSpaceRenameBlur_}">
+      ` : html`<span class="space-name">${this.space_.name}</span>`}
+    </div>
+    <div id="pinned">
+      ${repeat(this.space_.pinned, i => i.id, i => html`
+        <meridian-item .item="${i}" .depth="${0}" .container="${this.space_!.id}"
+            .host="${this}" .rev="${this.rev_}" .renaming="${this.renaming_}">
+        </meridian-item>`)}
+    </div>
+    <div class="divider"><span>Today</span></div>
+    <button id="newTabButton" class="row new-tab"
+        @click="${this.onNewTabClick_}">
+      <span class="ic">${icon('plus', 16)}</span>
+      <span class="title">New Tab</span>
+    </button>
+    <div id="today">
+      ${repeat(this.today_, t => t.id, t => html`
+        <meridian-tab-row .tab="${t}" .host="${this}"></meridian-tab-row>`)}
+    </div>
+  ` : ''}
+</div>
+<div id="bottom">
+  <slot name="bottom-start"></slot>
+  <div id="spaceDots">
+    ${repeat(this.state_?.spaces || [], s => s.id, s => html`
+      <button class="space-dot ${s.id === this.space_?.id ? 'active' : ''}"
+          title="${s.name}" data-space="${s.id}" style="--dot:${s.color}"
+          @click="${this.onSpaceDotClick_}"
+          @contextmenu="${this.onSpaceDotContextmenu_}">
+        ${s.icon ? html`<span class="emoji">${s.icon}</span>` :
+                   html`<span class="dot"></span>`}
+      </button>`)}
+  </div>
+  <button id="addSpace" class="icon-btn" title="New Space"
+      @click="${this.onAddSpaceClick_}">
+    ${icon('plus', 16)}
+  </button>
+  <slot name="bottom-end"></slot>
+</div>
+<div id="menu" role="menu" ?hidden="${!this.menu_}"
+    style="left:${this.menu_?.x ?? 0}px; top:${this.menu_?.y ?? 0}px">
+  ${(this.menu_?.entries || []).map((entry, index) => html`
+    ${entry.separatorBefore ? html`<div class="menu-sep"></div>` : ''}
+    <button role="menuitem" class="menu-item ${entry.danger ? 'danger' : ''}"
+        data-index="${index}" @click="${this.onMenuEntryClick_}">
+      ${entry.label}
+    </button>`)}
+</div>
+<!--_html_template_end_-->`;
+}
