+    case 'folderOpen':
+      return html`<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 16.5v-9a2 2 0 0 1 2-2h3.6a2 2 0 0 1 1.4.6l1.3 1.3h5.7a2 2 0 0 1 2 2v1"/><path d="M3.5 16.5l2.1-5a2 2 0 0 1 1.8-1.2h12.1a1 1 0 0 1 .9 1.4l-2 4.8a2 2 0 0 1-1.8 1.2H5.5a2 2 0 0 1-2-1.2z"/></svg>`;
