+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_SIDEBAR_SERVICE_H_
+#define CHROME_BROWSER_MERIDIAN_SIDEBAR_SERVICE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/important_file_writer.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/values.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "url/gurl.h"
+
+namespace meridian {
+
+// The container id of the favorites, which every space of a profile shares.
+inline constexpr char kFavorites[] = "favorites";
+
+struct Item {
+  Item();
+  Item(const Item&);
+  Item(Item&&);
+  Item& operator=(const Item&);
+  Item& operator=(Item&&);
+  ~Item();
+
+  std::string id;
+  bool is_folder = false;
+  std::string title;
+  GURL url;  // home URL of a link
+  bool open = true;
+  std::vector<Item> children;
+};
+
+struct Space {
+  Space();
+  Space(const Space&);
+  Space(Space&&);
+  Space& operator=(const Space&);
+  Space& operator=(Space&&);
+  ~Space();
+
+  std::string id;
+  std::string name;
+  std::string icon;
+  std::string color;
+  std::string color2;
+  std::vector<Item> pinned;
+};
+
+// The Meridian sidebar of one profile: its spaces, each space's pinned items
+// and folders, and the favorites. Live tabs are not stored here; a tab points
+// at its space and item through TabData.
+//
+// Saved as JSON in "<profile>/Meridian Sidebar.json". Off-the-record profiles
+// keep it in memory only.
+class SidebarService : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnSidebarChanged() = 0;
+  };
+
+  // `profile_path` empty: nothing is read or written.
+  explicit SidebarService(const base::FilePath& profile_path);
+  SidebarService(const SidebarService&) = delete;
+  SidebarService& operator=(const SidebarService&) = delete;
+  ~SidebarService() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  bool loaded() const { return loaded_; }
+  const std::vector<Space>& spaces() const { return spaces_; }
+  const std::vector<Item>& favorites() const { return favorites_; }
+  const std::string& active_space_id() const { return active_space_id_; }
+  const Space* FindSpace(const std::string& space_id) const;
+  // Searches favorites and every space; nullptr if unknown.
+  const Item* FindItem(const std::string& item_id) const;
+  // The space (or kFavorites) holding `item_id`; empty if unknown.
+  std::string ContainerOf(const std::string& item_id) const;
+  // Ids of `item_id` and everything inside it.
+  std::vector<std::string> SubtreeIds(const std::string& item_id) const;
+
+  std::string CreateSpace(const std::string& name,
+                          const std::string& icon,
+                          const std::string& color,
+                          const std::string& color2);
+  bool UpdateSpace(const std::string& space_id,
+                   const std::string& name,
+                   const std::string& icon,
+                   const std::string& color,
+                   const std::string& color2);
+  // The last space can't be deleted.
+  bool DeleteSpace(const std::string& space_id);
+  bool MoveSpace(const std::string& space_id, int index);
+  bool SetActiveSpace(const std::string& space_id);
+
+  // `container` is a space id or kFavorites; `parent_id` a folder in it or
+  // empty. Returns the new item's id, or empty if the position is invalid.
+  std::string AddItem(const std::string& container,
+                      const std::string& parent_id,
+                      int index,
+                      Item item);
+  bool MoveItem(const std::string& item_id,
+                const std::string& container,
+                const std::string& parent_id,
+                int index);
+  bool RemoveItem(const std::string& item_id);
+  bool RenameItem(const std::string& item_id, const std::string& title);
+  bool SetFolderOpen(const std::string& item_id, bool open);
+
+  // For tests and import: replaces everything.
+  void ReplaceAll(std::vector<Space> spaces,
+                  std::vector<Item> favorites,
+                  const std::string& active_space_id);
+
+  // JSON (de)serialization, public for tests.
+  base::DictValue ToValue() const;
+  static bool FromValue(const base::DictValue& value,
+                        std::vector<Space>* spaces,
+                        std::vector<Item>* favorites,
+                        std::string* active_space_id);
+
+  // Writes any pending change now (tests).
+  void FlushForTesting();
+
+ private:
+  class Serializer;
+
+  void OnLoaded(std::optional<std::string> json);
+  void EnsureDefaultSpace();
+  std::vector<Item>* ListFor(const std::string& container,
+                             const std::string& parent_id);
+  void Changed();
+
+  std::vector<Space> spaces_;
+  std::vector<Item> favorites_;
+  std::string active_space_id_;
+  bool loaded_ = false;
+
+  std::unique_ptr<Serializer> serializer_;
+  std::unique_ptr<base::ImportantFileWriter> writer_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<SidebarService> weak_factory_{this};
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_SIDEBAR_SERVICE_H_
