+# found in the LICENSE file.
+
+import("//mojo/public/tools/bindings/mojom.gni")
+
+assert(!is_android)
+
+mojom("mojo_bindings") {
+  sources = [ "sidebar.mojom" ]
+  public_deps = [
+    "//components/browser_apis/tab_strip:mojom",
+    "//url/mojom:url_mojom_gurl",
+  ]
+  webui_module_path = "/"
+}
+
+# The sidebar model alone (no browser deps), so its tests stay small.
+source_set("model") {
+  sources = [
+    "sidebar_service.cc",
+    "sidebar_service.h",
+  ]
+  public_deps = [
+    "//base",
+    "//components/keyed_service/core",
+    "//url",
+  ]
+}
+
+source_set("meridian") {
+  sources = [
+    "sidebar_handler.cc",
+    "sidebar_handler.h",
+    "sidebar_service_factory.cc",
+    "sidebar_service_factory.h",
+    "tab_data.cc",
+    "tab_data.h",
+  ]
+  public_deps = [
+    ":mojo_bindings",
+    ":model",
+    "//base",
+    "//components/keyed_service/core",
+    "//content/public/browser",
+    "//mojo/public/cpp/bindings",
+    "//url",
+  ]
+  deps = [
+    "//chrome/browser/profiles:profile",
+    "//chrome/browser/sessions",
+    "//chrome/browser/ui/navigator",
+    "//chrome/browser/ui/browser_window",
+    "//chrome/browser/ui/tabs:tab_strip",
+    "//chrome/browser/ui/tabs:tab_strip_model_observer",
+    "//components/browser_apis/tab_strip/types",
+    "//components/sessions",
+    "//components/tabs:public",
+  ]
+}
+
+import("//testing/test.gni")
+
+# out/Release/meridian_unittests
+test("meridian_unittests") {
+  sources = [ "sidebar_service_unittest.cc" ]
