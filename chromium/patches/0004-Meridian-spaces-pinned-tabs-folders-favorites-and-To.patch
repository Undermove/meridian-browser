@@ -0,0 +1,406 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/sidebar_handler.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/meridian/sidebar_service_factory.h"
+#include "chrome/browser/meridian/tab_data.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/browser_apis/tab_strip/types/node_id.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace meridian {
+
+namespace {
+
+mojom::ItemPtr ToMojo(const Item& item) {
+  auto m = mojom::Item::New();
+  m->id = item.id;
+  m->is_folder = item.is_folder;
+  m->title = item.title;
+  m->url = item.url;
+  m->open = item.open;
+  for (const Item& child : item.children) {
+    m->children.push_back(ToMojo(child));
+  }
+  return m;
+}
+
+}  // namespace
+
+SidebarHandler::SidebarHandler(
+    BrowserWindowInterface* browser,
+    mojo::PendingRemote<mojom::SidebarPage> page,
+    mojo::PendingReceiver<mojom::SidebarHandler> receiver)
+    : browser_(browser),
+      service_(SidebarServiceFactory::GetForProfile(browser->GetProfile())),
+      page_(std::move(page)),
+      receiver_(this, std::move(receiver)) {
+  service_observation_.Observe(service_.get());
+  model()->AddObserver(this);
+  if (service_->loaded()) {
+    OnSidebarChanged();
+  }
+}
+
+SidebarHandler::~SidebarHandler() {
+  model()->RemoveObserver(this);
+}
+
+TabStripModel* SidebarHandler::model() {
+  return browser_->GetTabStripModel();
+}
+
+tabs::TabInterface* SidebarHandler::TabFor(const tabs_api::NodeId& id) {
+  std::optional<tabs::TabHandle> handle = id.ToTabHandle();
+  if (!handle) {
+    return nullptr;
+  }
+  tabs::TabInterface* tab = handle->Get();
+  return tab && model()->GetIndexOfTab(tab) != TabStripModel::kNoTab ? tab
+                                                                     : nullptr;
+}
+
+tabs::TabInterface* SidebarHandler::LiveTabOf(const std::string& item_id) {
+  for (int i = 0; i < model()->count(); ++i) {
+    tabs::TabInterface* tab = model()->GetTabAtIndex(i);
+    const TabData* data = TabData::Get(tab->GetContents());
+    if (data && data->item_id() == item_id) {
+      return tab;
+    }
+  }
+  return nullptr;
+}
+
+void SidebarHandler::Adopt(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  const TabData* data = TabData::Get(contents);
+  if (data && service_->FindSpace(data->space_id())) {
+    // A restored tab whose item was unpinned meanwhile joins Today.
+    if (!data->item_id().empty() && !service_->FindItem(data->item_id())) {
+      TabData::Set(contents, data->space_id(), std::string());
+    }
+    return;
+  }
+  TabData::Set(contents, service_->active_space_id(), std::string());
+}
+
+void SidebarHandler::OnActiveTabChanged(tabs::TabInterface* tab) {
+  if (!tab) {
+    return;
+  }
+  Adopt(tab);
+  const TabData* data = TabData::Get(tab->GetContents());
+  last_active_[data->space_id()] = tab->GetHandle();
+  // A favorite belongs to every space: opening one doesn't switch spaces.
+  bool favorite = !data->item_id().empty() &&
+                  service_->ContainerOf(data->item_id()) == kFavorites;
+  if (!favorite && data->space_id() != service_->active_space_id()) {
+    service_->SetActiveSpace(data->space_id());
+  }
+}
+
+void SidebarHandler::OnSidebarChanged() {
+  if (!service_->loaded()) {
+    return;
+  }
+  // Tabs from a deleted space, or created before the sidebar loaded.
+  for (int i = 0; i < model()->count(); ++i) {
+    Adopt(model()->GetTabAtIndex(i));
+  }
+  ScheduleNotify();
+}
+
+void SidebarHandler::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (!service_->loaded()) {
+    return;
+  }
+  if (change.type() == TabStripModelChange::kInserted) {
+    for (const auto& inserted : change.GetInsert()->contents) {
+      Adopt(inserted.tab);
+    }
+  }
+  if (selection.active_tab_changed()) {
+    OnActiveTabChanged(selection.new_tab);
+  }
+  ScheduleNotify();
+}
+
+mojom::SidebarStatePtr SidebarHandler::BuildState() {
+  auto state = mojom::SidebarState::New();
+  for (const Space& space : service_->spaces()) {
+    auto s = mojom::Space::New();
+    s->id = space.id;
+    s->name = space.name;
+    s->icon = space.icon;
+    s->color = space.color;
+    s->color2 = space.color2;
+    for (const Item& item : space.pinned) {
+      s->pinned.push_back(ToMojo(item));
+    }
+    state->spaces.push_back(std::move(s));
+  }
+  state->active_space_id = service_->active_space_id();
+  for (const Item& item : service_->favorites()) {
+    state->favorites.push_back(ToMojo(item));
+  }
+  for (int i = 0; i < model()->count(); ++i) {
+    tabs::TabInterface* tab = model()->GetTabAtIndex(i);
+    const TabData* data = TabData::Get(tab->GetContents());
+    auto info = mojom::TabInfo::New();
+    info->tab_id = tabs_api::NodeId::FromTabHandle(tab->GetHandle());
+    info->space_id = data ? data->space_id() : service_->active_space_id();
+    info->item_id = data ? data->item_id() : std::string();
+    state->tabs.push_back(std::move(info));
+  }
+  return state;
+}
+
+void SidebarHandler::ScheduleNotify() {
+  if (notify_pending_) {
+    return;
+  }
+  notify_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&SidebarHandler::Notify, weak_factory_.GetWeakPtr()));
+}
+
+void SidebarHandler::Notify() {
+  notify_pending_ = false;
+  page_->OnStateChanged(BuildState());
+}
+
+void SidebarHandler::GetState(GetStateCallback callback) {
+  std::move(callback).Run(BuildState());
+}
+
+void SidebarHandler::CreateSpace(const std::string& name,
+                                 const std::string& icon,
+                                 const std::string& color,
+                                 const std::string& color2,
+                                 CreateSpaceCallback callback) {
+  std::move(callback).Run(service_->CreateSpace(name, icon, color, color2));
+}
+
+void SidebarHandler::UpdateSpace(const std::string& space_id,
+                                 const std::string& name,
+                                 const std::string& icon,
+                                 const std::string& color,
+                                 const std::string& color2) {
+  service_->UpdateSpace(space_id, name, icon, color, color2);
+}
+
+void SidebarHandler::DeleteSpace(const std::string& space_id) {
+  if (service_->spaces().size() < 2 || !service_->FindSpace(space_id)) {
+    return;
+  }
+  bool was_active = service_->active_space_id() == space_id;
+  // Leave the space first, so closing its tabs doesn't activate one of them.
+  if (was_active) {
+    for (const Space& space : service_->spaces()) {
+      if (space.id != space_id) {
+        ActivateSpace(space.id);
+        break;
+      }
+    }
+  }
+  std::vector<content::WebContents*> to_close;
+  for (int i = 0; i < model()->count(); ++i) {
+    content::WebContents* contents = model()->GetTabAtIndex(i)->GetContents();
+    const TabData* data = TabData::Get(contents);
+    if (data && data->space_id() == space_id) {
+      to_close.push_back(contents);
+    }
+  }
+  service_->DeleteSpace(space_id);
+  last_active_.erase(space_id);
+  for (content::WebContents* contents : to_close) {
+    int index = model()->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab) {
+      model()->CloseWebContentsAt(index, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+}
+
+void SidebarHandler::MoveSpace(const std::string& space_id, int32_t index) {
+  service_->MoveSpace(space_id, index);
+}
+
+void SidebarHandler::ActivateSpace(const std::string& space_id) {
+  if (!service_->FindSpace(space_id)) {
+    return;
+  }
+  service_->SetActiveSpace(space_id);
+  tabs::TabInterface* target = nullptr;
+  auto last = last_active_.find(space_id);
+  if (last != last_active_.end()) {
+    target = last->second.Get();
+    if (target && model()->GetIndexOfTab(target) == TabStripModel::kNoTab) {
+      target = nullptr;
+    }
+  }
+  if (!target) {
+    for (int i = 0; i < model()->count(); ++i) {
+      tabs::TabInterface* tab = model()->GetTabAtIndex(i);
+      const TabData* data = TabData::Get(tab->GetContents());
+      if (data && data->space_id() == space_id) {
+        target = tab;
+        break;
+      }
+    }
+  }
+  if (target) {
+    model()->ActivateTab(target);
+    return;
+  }
+  // An empty space starts with a new tab, like Arc.
+  NavigateParams params(browser_, GURL("chrome://newtab/"),
+                        ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  Navigate(&params);
+}
+
+void SidebarHandler::MoveTabToSpace(const tabs_api::NodeId& tab_id,
+                                    const std::string& space_id) {
+  tabs::TabInterface* tab = TabFor(tab_id);
+  if (!tab || !service_->FindSpace(space_id)) {
+    return;
+  }
+  const TabData* data = TabData::Get(tab->GetContents());
+  std::string item_id = data ? data->item_id() : std::string();
+  // A tab leaving the space of its pinned item is no longer that item's tab.
+  if (!item_id.empty() && service_->ContainerOf(item_id) != space_id &&
+      service_->ContainerOf(item_id) != kFavorites) {
+    item_id.clear();
+  }
+  TabData::Set(tab->GetContents(), space_id, item_id);
+  ScheduleNotify();
+}
+
+void SidebarHandler::PinTab(const tabs_api::NodeId& tab_id,
+                            mojom::ItemPositionPtr position) {
+  tabs::TabInterface* tab = TabFor(tab_id);
+  if (!tab) {
+    return;
+  }
+  content::WebContents* contents = tab->GetContents();
+  GURL url = contents->GetLastCommittedURL();
+  if (!url.is_valid() || url.is_empty()) {
+    url = contents->GetVisibleURL();
+  }
+  Item item;
+  item.title = base::UTF16ToUTF8(contents->GetTitle());
+  item.url = url;
+  std::string item_id = service_->AddItem(
+      position->container, position->parent_id, position->index, item);
+  if (item_id.empty()) {
+    return;
+  }
+  const TabData* data = TabData::Get(contents);
+  std::string space_id = position->container == kFavorites
+                             ? (data ? data->space_id()
+                                     : service_->active_space_id())
+                             : position->container;
+  TabData::Set(contents, space_id, item_id);
+  ScheduleNotify();
+}
+
+void SidebarHandler::AddFolder(mojom::ItemPositionPtr position,
+                               const std::string& title,
+                               AddFolderCallback callback) {
+  Item folder;
+  folder.is_folder = true;
+  folder.title = title.empty() ? "New Folder" : title;
+  std::move(callback).Run(service_->AddItem(
+      position->container, position->parent_id, position->index, folder));
+}
+
+void SidebarHandler::MoveItem(const std::string& item_id,
+                              mojom::ItemPositionPtr position) {
+  if (!service_->MoveItem(item_id, position->container, position->parent_id,
+                          position->index)) {
+    return;
+  }
+  // The live tabs follow their items into another space.
+  if (position->container == kFavorites) {
+    return;
+  }
+  for (const std::string& id : service_->SubtreeIds(item_id)) {
+    if (tabs::TabInterface* tab = LiveTabOf(id)) {
+      TabData::Set(tab->GetContents(), position->container, id);
+    }
+  }
+  ScheduleNotify();
+}
+
+void SidebarHandler::RemoveItem(const std::string& item_id) {
+  std::vector<std::string> ids = service_->SubtreeIds(item_id);
+  for (const std::string& id : ids) {
+    if (tabs::TabInterface* tab = LiveTabOf(id)) {
+      const TabData* data = TabData::Get(tab->GetContents());
+      TabData::Set(tab->GetContents(), data->space_id(), std::string());
+    }
+  }
+  service_->RemoveItem(item_id);
+}
+
+void SidebarHandler::RenameItem(const std::string& item_id,
+                                const std::string& title) {
+  service_->RenameItem(item_id, title);
+}
+
+void SidebarHandler::SetFolderOpen(const std::string& item_id, bool open) {
+  service_->SetFolderOpen(item_id, open);
+}
+
+void SidebarHandler::OpenItem(const std::string& item_id) {
+  const Item* item = service_->FindItem(item_id);
+  if (!item || item->is_folder) {
+    return;
+  }
+  if (tabs::TabInterface* tab = LiveTabOf(item_id)) {
+    model()->ActivateTab(tab);
+    return;
+  }
+  std::string container = service_->ContainerOf(item_id);
+  std::string space_id =
+      container == kFavorites ? service_->active_space_id() : container;
+  NavigateParams params(browser_, item->url, ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  Navigate(&params);
+  if (params.navigated_or_inserted_contents) {
+    TabData::Set(params.navigated_or_inserted_contents, space_id, item_id);
+    ScheduleNotify();
+  }
+}
+
+void SidebarHandler::ResetItemToHome(const std::string& item_id) {
+  const Item* item = service_->FindItem(item_id);
+  tabs::TabInterface* tab = LiveTabOf(item_id);
+  if (!item || !tab) {
+    return;
+  }
+  tab->GetContents()->GetController().LoadURL(
+      item->url, content::Referrer(), ui::PAGE_TRANSITION_AUTO_BOOKMARK,
+      std::string());
+}
+
+}  // namespace meridian
