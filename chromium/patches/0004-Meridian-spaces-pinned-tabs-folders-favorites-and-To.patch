+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The Meridian sidebar: favorites, the active space's pinned tabs and
+// folders, Today, and the space switcher. Tabs come from TabStripService;
+// spaces, pinned items and which tab belongs where come from the C++
+// SidebarService (chrome/browser/meridian) through SidebarHandler.
+//
+// It fires the same tab-added / tab-closed / tab-updated events as the stock
+// <webui-browser-tab-strip>, so the content region keeps working unchanged.
+
+import {assert} from '//resources/js/assert.js';
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+import {TabStripService} from '/tab_strip_api/tab_strip_api.mojom-webui.js';
+import type {TabStripServiceRemote} from '/tab_strip_api/tab_strip_api.mojom-webui.js';
+import type {Container, Tab} from '/tab_strip_api/tab_strip_api_data_model.mojom-webui.js';
+import {OnDataChangedEventFieldTags, whichOnDataChangedEvent} from '/tab_strip_api/tab_strip_api_events.mojom-webui.js';
+import type {OnCollectionCreatedEvent, OnDataChangedEvent, OnNodeMovedEvent, OnNodesClosedEvent, OnTabsCreatedEvent} from '/tab_strip_api/tab_strip_api_events.mojom-webui.js';
+import type {NodeId} from '/tab_strip_api/tab_strip_api_types.mojom-webui.js';
+import {TabStripObservation} from '/tab_strip_api/tab_strip_observation.js';
+import type {TabStripObserver} from '/tab_strip_api/tab_strip_observer.js';
+
+import {browserProxyFactory as sidebarProxyFactory} from '../sidebar.mojom-webui.js';
+import type {Item, SidebarHandlerInterface, SidebarState, Space} from '../sidebar.mojom-webui.js';
+import type {TabAdded, TabClosed, TabUpdated} from '../tab_strip/events.js';
+
+import './fav.js';
+import './item.js';
+import './tab_row.js';
+
+import {getCss} from './sidebar.css.js';
+import {getHtml} from './sidebar.html.js';
+
+export const FAVORITES = 'favorites';
+
+// Colours offered to a new space, like Arc's first swatches.
+const SPACE_COLORS = [
+  ['#8a8fe0', '#b5a8f0'], ['#e08a8a', '#f0b5a8'], ['#7cc4a4', '#a8e0c8'],
+  ['#e0b46a', '#f0d29a'], ['#6aa9e0', '#9ac8f0'], ['#c08ae0', '#dcb5f0'],
+  ['#8a9aa8', '#b5c0c8'],
+];
+
+export interface MenuEntry {
+  label: string;
+  action: () => void;
+  danger?: boolean;
+  separatorBefore?: boolean;
+}
+
+export interface MeridianSidebarElement {
+  $: {
+    menu: HTMLElement,
+  };
+}
+
+export class MeridianSidebarElement extends CrLitElement implements
+    TabStripObserver {
+  static get is() {
+    return 'meridian-sidebar';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      tabs_: {state: true, type: Object},
+      state_: {state: true, type: Object},
+      menu_: {state: true, type: Object},
+      renaming_: {state: true, type: String},
+      rev_: {state: true, type: Number},
+      space_: {state: true, type: Object},
+      favorites_: {state: true, type: Array},
+      today_: {state: true, type: Array},
+    };
+  }
+
+  // Live tabs by id, and the order they appeared in (newest Today tab first).
+  protected accessor tabs_: Map<NodeId, Tab> = new Map();
+  protected accessor state_: SidebarState|null = null;
+  protected accessor menu_: {x: number, y: number, entries: MenuEntry[]}|null =
+      null;
+  // The item / space id being renamed in place.
+  protected accessor renaming_: string = '';
+  // Bumped on every change, so the row elements re-render with it.
+  protected accessor rev_: number = 0;
+  // Derived in willUpdate() for the template.
+  protected accessor space_: Space|null = null;
+  protected accessor favorites_: Item[] = [];
+  protected accessor today_: Tab[] = [];
+
+  private order_ = new Map<NodeId, number>();
+  // A new space being named; see activeSpace().
+  private namingSpace_ = '';
+  private nextOrder_ = 0;
+  private readonly tabStripService_: TabStripServiceRemote;
+  private readonly handler_: SidebarHandlerInterface;
+  private observation_: TabStripObservation|undefined;
+  private listenerId_: number|null = null;
+
+  constructor() {
+    super();
+    this.tabStripService_ = TabStripService.getRemote();
+    const proxy = sidebarProxyFactory.getInstance();
+    this.handler_ = proxy.handler;
+    this.listenerId_ = proxy.callbackRouter.onStateChanged.addListener(
+        (state: SidebarState) => this.setState_(state));
+  }
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.observation_ = new TabStripObservation(this);
+    this.load_(this.observation_);
+    this.handler_.getState().then(({state}) => this.setState_(state));
+    document.addEventListener('mousedown', this.onDocumentMouseDown_, true);
+    window.addEventListener('blur', this.closeMenu_);
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    this.observation_ = undefined;
+    if (this.listenerId_ !== null) {
+      sidebarProxyFactory.getInstance().callbackRouter.removeListener(
+          this.listenerId_);
+      this.listenerId_ = null;
+    }
+    document.removeEventListener('mousedown', this.onDocumentMouseDown_, true);
+    window.removeEventListener('blur', this.closeMenu_);
+  }
+
+  // ---------------------------------------------------------------- tabs
+
+  private async load_(observation: TabStripObservation) {
+    const snapshot = await this.tabStripService_.getTabs();
+    const tabs = new Map<NodeId, Tab>();
+    const walk = (c: Container) => {
+      if (c.data.tab) {
+        tabs.set(c.data.tab.id, c.data.tab);
+      }
+      for (const child of c.children || []) {
+        walk(child);
+      }
+    };
+    walk(snapshot.tabStrip);
+    for (const id of tabs.keys()) {
+      this.order_.set(id, this.nextOrder_++);
+    }
+    this.tabs_ = tabs;
+    this.rev_++;
+    for (const tab of tabs.values()) {
+      this.fire<TabAdded>('tab-added', {id: tab.id, isActive: tab.isActive});
+    }
+    observation.bind(snapshot.stream.handle);
+  }
+
+  onTabsCreated(event: OnTabsCreatedEvent) {
+    const tabs = new Map(this.tabs_);
+    let winner: NodeId|null = null;
+    for (const container of event.tabs) {
+      const tab = container.tab;
+      tabs.set(tab.id, tab);
+      this.order_.set(tab.id, this.nextOrder_++);
+      if (tab.isActive) {
+        winner = tab.id;
+      }
+      this.fire<TabAdded>('tab-added', {id: tab.id, isActive: tab.isActive});
+    }
+    this.tabs_ = this.withSingleActive_(tabs, winner);
+    this.rev_++;
+  }
+
+  onNodesClosed(event: OnNodesClosedEvent) {
+    const tabs = new Map(this.tabs_);
+    for (const id of event.nodeIds) {
+      if (tabs.delete(id)) {
+        this.order_.delete(id);
+        this.fire<TabClosed>('tab-closed', id);
+      }
+    }
+    this.tabs_ = tabs;
+    this.rev_++;
+  }
+
+  onDataChanged(event: OnDataChangedEvent) {
+    if (whichOnDataChangedEvent(event) !== OnDataChangedEventFieldTags.TAB) {
+      return;
+    }
+    const tab = event.tab!.data;
+    if (!this.tabs_.has(tab.id)) {
+      return;
+    }
+    const tabs = new Map(this.tabs_);
+    tabs.set(tab.id, tab);
+    this.tabs_ = this.withSingleActive_(tabs, tab.id);
+    this.rev_++;
+    this.fire<TabUpdated>('tab-updated', tab);
+  }
+
+  onCollectionCreated(_event: OnCollectionCreatedEvent) {}
+
+  onNodeMoved(_event: OnNodeMovedEvent) {}
+
+  // The browser reports an activation as data changes of two tabs, the newly
+  // active one first; the tab that just became active wins.
+  private withSingleActive_(tabs: Map<NodeId, Tab>, winner: NodeId|null):
+      Map<NodeId, Tab> {
+    if (winner === null || !tabs.get(winner)?.isActive) {
+      return tabs;
+    }
+    for (const [id, tab] of tabs) {
+      if (tab.isActive && id !== winner) {
+        tabs.set(id, {...tab, isActive: false});
+      }
+    }
+    return tabs;
+  }
+
+  // ------------------------------------------------------------- state
+
+  private setState_(state: SidebarState) {
+    this.state_ = state;
+    this.rev_++;
+    const space = this.activeSpace();
+    if (space) {
+      this.fire('meridian-space-changed',
+                {color: space.color, color2: space.color2});
+    }
+  }
+
+  // The space the sidebar shows: the active one, or a new space while it is
+  // being named (it opens once named, so its new tab doesn't take the focus
+  // from the name field).
+  activeSpace(): Space|null {
+    const state = this.state_;
+    if (!state) {
+      return null;
+    }
+    const id = this.namingSpace_ || state.activeSpaceId;
+    return state.spaces.find(s => s.id === id) || state.spaces[0] || null;
+  }
+
+  // The live tab of a pinned item / favorite.
+  liveTab(itemId: string): Tab|null {
+    for (const info of this.state_?.tabs || []) {
+      if (info.itemId === itemId) {
+        return this.tabs_.get(info.tabId) || null;
+      }
+    }
+    return null;
+  }
+
+  // Today: the active space's tabs that aren't a pinned item, newest first.
+  todayTabs(): Tab[] {
+    const space = this.activeSpace();
+    if (!space || !this.state_) {
+      return [];
+    }
+    const result: Tab[] = [];
+    const known = new Set<NodeId>();
+    for (const info of this.state_.tabs) {
+      known.add(info.tabId);
+      if (info.spaceId === space.id && !info.itemId) {
+        const tab = this.tabs_.get(info.tabId);
+        if (tab) {
+          result.push(tab);
+        }
+      }
+    }
+    // Tabs the browser created after the last state push: the active space.
+    for (const tab of this.tabs_.values()) {
+      if (!known.has(tab.id)) {
+        result.push(tab);
+      }
+    }
+    return result.sort(
+        (a, b) => (this.order_.get(b.id) ?? 0) - (this.order_.get(a.id) ?? 0));
+  }
+
+  // A pinned tab that has wandered away from its home URL shows "/".
+  awayFromHome(item: Item, tab: Tab|null): boolean {
+    if (!tab || item.isFolder) {
+      return false;
+    }
+    try {
+      const home = new URL(item.url);
+      const now = new URL(tab.url);
+      return home.origin !== now.origin || home.pathname !== now.pathname;
+    } catch {
+      return false;
+    }
+  }
+
+  faviconFor(item: Item|null, tab: Tab|null): string {
+    if (tab && tab.favicon.dataUrl) {
+      return tab.favicon.dataUrl;
+    }
+    const url = tab ? tab.url : item ? item.url : '';
+    return `chrome://favicon2/?size=16&scaleFactor=2x&allowGoogleServerFallback=0&pageUrl=${
+        encodeURIComponent(url)}`;
+  }
+
+  // ------------------------------------------------------------ actions
+
+  onTabMouseDown(e: MouseEvent, tab: Tab) {
+    if (e.button !== 0 || this.isButton_(e)) {
+      return;
+    }
+    e.preventDefault();
+    this.tabStripService_.activateTab(tab.id);
+  }
+
+  onItemMouseDown(e: MouseEvent, item: Item) {
+    if (e.button !== 0 || this.isButton_(e) || this.renaming_ === item.id) {
+      return;
+    }
+    e.preventDefault();
+    if (item.isFolder) {
+      this.handler_.setFolderOpen(item.id, !item.open);
+      return;
+    }
+    this.handler_.openItem(item.id);
+  }
+
+  onCloseClick(e: Event, tab: Tab) {
+    e.stopPropagation();
+    this.tabStripService_.closeNodes([tab.id]);
+  }
+
+  onResetClick(e: Event, item: Item) {
+    e.stopPropagation();
+    this.handler_.resetItemToHome(item.id);
+  }
+
+  protected onNewTabClick_() {
+    this.tabStripService_.createTabAt(null, null);
+  }
+
+  startRenaming(id: string) {
+    this.renaming_ = id;
+  }
+
+  private spaceFromEvent_(e: Event): Space|null {
+    const id = (e.currentTarget as HTMLElement).dataset['space'];
+    return this.state_?.spaces.find(s => s.id === id) || null;
+  }
+
+  protected onSpaceDotClick_(e: Event) {
+    const space = this.spaceFromEvent_(e);
+    if (space) {
+      this.handler_.activateSpace(space.id);
+    }
+  }
+
+  protected onSpaceDotContextmenu_(e: MouseEvent) {
+    const space = this.spaceFromEvent_(e);
+    if (space) {
+      this.openSpaceMenu_(e, space);
+    }
+  }
+
+  protected onSpaceHeaderContextmenu_(e: MouseEvent) {
+    const space = this.activeSpace();
+    if (space) {
+      this.openSpaceMenu_(e, space);
+    }
+  }
+
+  protected onSpaceHeaderDblclick_() {
+    const space = this.activeSpace();
+    if (space) {
+      this.renaming_ = space.id;
+    }
+  }
+
+  protected onSpaceRenameBlur_(e: Event) {
+    const space = this.activeSpace();
+    if (space) {
+      this.onRenameBlur(e, space.id, true);
+    }
+  }
+
+  protected async onAddSpaceClick_() {
+    const n = (this.state_?.spaces.length || 0);
+    const [color, color2] = SPACE_COLORS[n % SPACE_COLORS.length]!;
+    const {spaceId} = await this.handler_.createSpace(
+        `Space ${n + 1}`, '', color!, color2!);
+    this.namingSpace_ = spaceId;
+    this.renaming_ = spaceId;
+  }
+
+  private isButton_(e: Event): boolean {
+    return e.composedPath().some(
+        el => el instanceof HTMLElement &&
+            (el.classList.contains('row-btn') || el.localName === 'input'));
+  }
+
+  // ------------------------------------------------------------ renaming
+
+  onRenameKeydown(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      (e.target as HTMLInputElement).blur();
+    } else if (e.key === 'Escape') {
+      this.renaming_ = '';
+      this.openNamedSpace_();
+    }
+  }
+
+  private openNamedSpace_() {
+    if (this.namingSpace_) {
+      this.handler_.activateSpace(this.namingSpace_);
+      this.namingSpace_ = '';
+    }
+  }
+
+  onRenameBlur(e: Event, id: string, isSpace: boolean) {
+    if (this.renaming_ !== id) {
+      return;
+    }
+    const value = (e.target as HTMLInputElement).value.trim();
+    this.renaming_ = '';
+    if (isSpace) {
+      this.openNamedSpace_();
+    }
+    if (!value) {
+      return;
+    }
+    if (isSpace) {
+      const space = this.state_?.spaces.find(s => s.id === id);
+      if (space) {
+        this.handler_.updateSpace(id, value, space.icon, space.color,
+                                  space.color2);
+      }
+    } else {
+      this.handler_.renameItem(id, value);
+    }
+  }
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    this.space_ = this.activeSpace();
+    this.favorites_ = this.state_?.favorites || [];
+    this.today_ = this.todayTabs();
+  }
+
+  override updated(changed: PropertyValues<this>) {
+    super.updated(changed);
+    // The space being renamed may only render after the next state push.
+    const input =
+        this.shadowRoot.querySelector<HTMLInputElement>('input.rename');
+    if (input && input.dataset['focused'] !== '1') {
+      input.dataset['focused'] = '1';
+      input.focus();
+      input.select();
+    }
+  }
+
+
+  // --------------------------------------------------------------- menus
+
+  onTabContextMenu(e: MouseEvent, tab: Tab) {
+    const space = this.activeSpace();
+    assert(space);
+    const others = (this.state_?.spaces || []).filter(s => s.id !== space.id);
+    this.openMenu_(e, [
+      {
+        label: 'Pin to ' + space.name,
+        action: () => this.handler_.pinTab(
+            tab.id, {container: space.id, parentId: '', index: -1}),
+      },
+      {
+        label: 'Add to Favorites',
+        action: () => this.handler_.pinTab(
+            tab.id, {container: FAVORITES, parentId: '', index: -1}),
+      },
+      ...others.map((s, i) => ({
+        label: 'Move to ' + s.name,
+        action: () => this.handler_.moveTabToSpace(tab.id, s.id),
+        separatorBefore: i === 0,
+      })),
+      {
+        label: 'Copy Link',
+        action: () => navigator.clipboard.writeText(tab.url),
+        separatorBefore: true,
+      },
+      {
+        label: 'Close Tab',
+        action: () => this.tabStripService_.closeNodes([tab.id]),
+        danger: true,
+      },
+    ]);
+  }
+
+  onItemContextMenu(e: MouseEvent, item: Item, container: string) {
+    const space = this.activeSpace();
+    assert(space);
+    const tab = this.liveTab(item.id);
+    const entries: MenuEntry[] = [];
+    if (item.isFolder) {
+      entries.push(
+          {label: 'Rename Folder', action: () => this.renaming_ = item.id},
+          {
+            label: 'New Folder Inside',
+            action: () => this.addFolder_(space.id, item.id),
+          },
+          {
+            label: 'Delete Folder',
+            action: () => this.handler_.removeItem(item.id),
+            danger: true,
+            separatorBefore: true,
+          });
+    } else {
+      entries.push({label: 'Rename', action: () => this.renaming_ = item.id});
+      if (container === FAVORITES) {
+        entries.push({
+          label: 'Move to ' + space.name,
+          action: () => this.handler_.moveItem(
+              item.id, {container: space.id, parentId: '', index: -1}),
+        });
+      } else {
+        entries.push({
+          label: 'Move to Favorites',
+          action: () => this.handler_.moveItem(
+              item.id, {container: FAVORITES, parentId: '', index: -1}),
+        });
+      }
+      if (tab) {
+        entries.push({
+          label: 'Go to Home Page',
+          action: () => this.handler_.resetItemToHome(item.id),
+        });
+      }
+      entries.push(
+          {
+            label: 'Copy Link',
+            action: () =>
+                navigator.clipboard.writeText(tab ? tab.url : item.url),
+            separatorBefore: true,
+          },
+          {
+            label: container === FAVORITES ? 'Remove from Favorites' : 'Unpin',
+            action: () => this.handler_.removeItem(item.id),
+          });
+      if (tab) {
+        entries.push({
+          label: 'Close Tab',
+          action: () => this.tabStripService_.closeNodes([tab.id]),
+          danger: true,
+        });
+      }
+    }
+    this.openMenu_(e, entries);
+  }
+
+  private openSpaceMenu_(e: MouseEvent, space: Space) {
+    const entries: MenuEntry[] = [
+      {label: 'Rename Space', action: () => this.renaming_ = space.id},
+      {label: 'New Folder', action: () => this.addFolder_(space.id, '')},
+    ];
+    if ((this.state_?.spaces.length || 0) > 1) {
+      entries.push({
+        label: 'Delete Space',
+        action: () => this.handler_.deleteSpace(space.id),
+        danger: true,
+        separatorBefore: true,
+      });
+    }
+    this.openMenu_(e, entries);
+  }
+
+  private async addFolder_(spaceId: string, parentId: string) {
+    const {itemId} = await this.handler_.addFolder(
+        {container: spaceId, parentId, index: -1}, 'New Folder');
+    if (itemId) {
+      this.renaming_ = itemId;
+    }
+  }
+
+  private openMenu_(e: MouseEvent, entries: MenuEntry[]) {
+    e.preventDefault();
+    e.stopPropagation();
+    this.menu_ = {x: e.clientX, y: e.clientY, entries};
+  }
+
+  protected onMenuEntryClick_(e: Event) {
+    const index = Number((e.currentTarget as HTMLElement).dataset['index']);
+    const entry = this.menu_?.entries[index];
+    this.menu_ = null;
+    entry?.action();
+  }
+
+  private closeMenu_ = () => {
+    this.menu_ = null;
+  };
+
+  private onDocumentMouseDown_ = (e: MouseEvent) => {
+    if (this.menu_ && !e.composedPath().includes(this.$.menu)) {
+      this.menu_ = null;
+    }
+  };
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-sidebar': MeridianSidebarElement;
+  }
+}
+
+customElements.define(MeridianSidebarElement.is, MeridianSidebarElement);
