+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_TAB_DATA_H_
+#define CHROME_BROWSER_MERIDIAN_TAB_DATA_H_
+
+#include <map>
+#include <string>
+
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace meridian {
+
+// The Meridian space a tab belongs to and the pinned item or favorite it is
+// the live tab of (empty for a Today tab). Saved with the session as tab
+// extra data, so it survives a restart.
+class TabData : public content::WebContentsUserData<TabData> {
+ public:
+  ~TabData() override;
+
+  // nullptr if the tab has no Meridian data yet.
+  static const TabData* Get(content::WebContents* contents);
+  static void Set(content::WebContents* contents,
+                  const std::string& space_id,
+                  const std::string& item_id);
+  // Called from session restore with the tab's saved extra data.
+  static void RestoreFromExtraData(
+      content::WebContents* contents,
+      const std::map<std::string, std::string>& extra_data);
+
+  const std::string& space_id() const { return space_id_; }
+  const std::string& item_id() const { return item_id_; }
+
+ private:
+  friend class content::WebContentsUserData<TabData>;
+  explicit TabData(content::WebContents* contents);
+
+  void Persist();
+
+  std::string space_id_;
+  std::string item_id_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_TAB_DATA_H_
