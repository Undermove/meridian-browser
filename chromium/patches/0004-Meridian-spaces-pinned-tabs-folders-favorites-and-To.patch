+
+#ifndef CHROME_BROWSER_MERIDIAN_SIDEBAR_HANDLER_H_
+#define CHROME_BROWSER_MERIDIAN_SIDEBAR_HANDLER_H_
+
+#include <map>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/meridian/sidebar.mojom.h"
+#include "chrome/browser/meridian/sidebar_service.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/tabs/public/tab_interface.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace meridian {
+
+// Connects one window's sidebar (chrome://webui-browser) to the profile's
+// SidebarService and to the window's tabs: new tabs join the active space,
+// switching to a tab of another space switches the space, and each space
+// remembers its last active tab.
+class SidebarHandler : public mojom::SidebarHandler,
+                       public SidebarService::Observer,
+                       public TabStripModelObserver {
+ public:
+  SidebarHandler(BrowserWindowInterface* browser,
+                 mojo::PendingRemote<mojom::SidebarPage> page,
+                 mojo::PendingReceiver<mojom::SidebarHandler> receiver);
+  SidebarHandler(const SidebarHandler&) = delete;
+  SidebarHandler& operator=(const SidebarHandler&) = delete;
+  ~SidebarHandler() override;
+
+  // mojom::SidebarHandler:
+  void GetState(GetStateCallback callback) override;
+  void CreateSpace(const std::string& name,
+                   const std::string& icon,
+                   const std::string& color,
+                   const std::string& color2,
+                   CreateSpaceCallback callback) override;
+  void UpdateSpace(const std::string& space_id,
+                   const std::string& name,
+                   const std::string& icon,
+                   const std::string& color,
+                   const std::string& color2) override;
+  void DeleteSpace(const std::string& space_id) override;
+  void MoveSpace(const std::string& space_id, int32_t index) override;
+  void ActivateSpace(const std::string& space_id) override;
+  void MoveTabToSpace(const tabs_api::NodeId& tab_id,
+                      const std::string& space_id) override;
+  void PinTab(const tabs_api::NodeId& tab_id,
+              mojom::ItemPositionPtr position) override;
+  void AddFolder(mojom::ItemPositionPtr position,
+                 const std::string& title,
+                 AddFolderCallback callback) override;
+  void MoveItem(const std::string& item_id,
+                mojom::ItemPositionPtr position) override;
+  void RemoveItem(const std::string& item_id) override;
+  void RenameItem(const std::string& item_id,
+                  const std::string& title) override;
+  void SetFolderOpen(const std::string& item_id, bool open) override;
+  void OpenItem(const std::string& item_id) override;
+  void ResetItemToHome(const std::string& item_id) override;
+
+  // SidebarService::Observer:
+  void OnSidebarChanged() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+ private:
+  TabStripModel* model();
+  mojom::SidebarStatePtr BuildState();
+  // Coalesces notifications into one OnStateChanged per task.
+  void ScheduleNotify();
+  void Notify();
+  tabs::TabInterface* TabFor(const tabs_api::NodeId& id);
+  tabs::TabInterface* LiveTabOf(const std::string& item_id);
+  // Gives a tab without (valid) Meridian data the active space.
+  void Adopt(tabs::TabInterface* tab);
+  void OnActiveTabChanged(tabs::TabInterface* tab);
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<SidebarService> service_;
+  // Last active tab per space id.
+  std::map<std::string, tabs::TabHandle> last_active_;
+  bool notify_pending_ = false;
+
+  mojo::Remote<mojom::SidebarPage> page_;
+  mojo::Receiver<mojom::SidebarHandler> receiver_;
+  base::ScopedObservation<SidebarService, SidebarService::Observer>
+      service_observation_{this};
+  base::WeakPtrFactory<SidebarHandler> weak_factory_{this};
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_SIDEBAR_HANDLER_H_
diff --git a/chrome/browser/meridian/sidebar_service.cc b/chrome/browser/meridian/sidebar_service.cc
new file mode 100644
index 0000000000..5ae6dd89e6
--- /dev/null
+++ b/chrome/browser/meridian/sidebar_service.cc
@@ -0,0 +1,559 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/sidebar_service.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/task/thread_pool.h"
+#include "base/uuid.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr base::FilePath::CharType kFileName[] =
+    FILE_PATH_LITERAL("Meridian Sidebar.json");
+constexpr int kVersion = 1;
+constexpr char kDefaultColor[] = "#8a8fe0";
+
+std::string NewId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+base::DictValue ItemToValue(const Item& item) {
+  base::DictValue d;
+  d.Set("id", item.id);
+  d.Set("title", item.title);
+  if (item.is_folder) {
+    d.Set("folder", true);
+    d.Set("open", item.open);
+    base::ListValue children;
+    for (const Item& child : item.children) {
+      children.Append(ItemToValue(child));
+    }
+    d.Set("children", std::move(children));
+  } else {
+    d.Set("url", item.url.spec());
+  }
+  return d;
+}
+
+std::optional<Item> ItemFromValue(const base::DictValue& d) {
+  const std::string* id = d.FindString("id");
+  if (!id || id->empty()) {
+    return std::nullopt;
+  }
+  Item item;
+  item.id = *id;
+  if (const std::string* title = d.FindString("title")) {
+    item.title = *title;
+  }
+  item.is_folder = d.FindBool("folder").value_or(false);
+  if (item.is_folder) {
+    item.open = d.FindBool("open").value_or(true);
+    if (const base::ListValue* children = d.FindList("children")) {
+      for (const base::Value& child : *children) {
+        if (child.is_dict()) {
+          if (auto c = ItemFromValue(child.GetDict())) {
+            item.children.push_back(std::move(*c));
+          }
+        }
+      }
+    }
+  } else {
+    const std::string* url = d.FindString("url");
+    item.url = GURL(url ? *url : std::string());
+    if (!item.url.is_valid()) {
+      return std::nullopt;
+    }
+  }
+  return item;
+}
+
+base::ListValue ItemsToValue(const std::vector<Item>& items) {
+  base::ListValue list;
+  for (const Item& item : items) {
+    list.Append(ItemToValue(item));
+  }
+  return list;
+}
+
+std::vector<Item> ItemsFromValue(const base::ListValue* list) {
+  std::vector<Item> items;
+  if (!list) {
+    return items;
+  }
+  for (const base::Value& v : *list) {
+    if (v.is_dict()) {
+      if (auto item = ItemFromValue(v.GetDict())) {
+        items.push_back(std::move(*item));
+      }
+    }
+  }
+  return items;
+}
+
+// Depth-first search; returns the list holding the item and its index.
+bool Locate(std::vector<Item>& list,
+            const std::string& id,
+            std::vector<Item>** out_list,
+            size_t* out_index) {
+  for (size_t i = 0; i < list.size(); ++i) {
+    if (list[i].id == id) {
+      *out_list = &list;
+      *out_index = i;
+      return true;
+    }
+    if (list[i].is_folder && Locate(list[i].children, id, out_list, out_index)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+const Item* FindIn(const std::vector<Item>& list, const std::string& id) {
+  for (const Item& item : list) {
+    if (item.id == id) {
+      return &item;
+    }
+    if (item.is_folder) {
+      if (const Item* found = FindIn(item.children, id)) {
+        return found;
+      }
+    }
+  }
+  return nullptr;
+}
+
+void CollectIds(const Item& item, std::vector<std::string>* ids) {
+  ids->push_back(item.id);
+  for (const Item& child : item.children) {
+    CollectIds(child, ids);
+  }
+}
+
+bool Contains(const Item& item, const std::string& id) {
+  for (const Item& child : item.children) {
+    if (child.id == id || Contains(child, id)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::optional<std::string> ReadFile(const base::FilePath& path) {
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return std::nullopt;
+  }
+  return json;
+}
+
+}  // namespace
+
+Item::Item() = default;
+Item::Item(const Item&) = default;
+Item::Item(Item&&) = default;
+Item& Item::operator=(const Item&) = default;
+Item& Item::operator=(Item&&) = default;
+Item::~Item() = default;
+
+Space::Space() = default;
+Space::Space(const Space&) = default;
+Space::Space(Space&&) = default;
+Space& Space::operator=(const Space&) = default;
+Space& Space::operator=(Space&&) = default;
+Space::~Space() = default;
+
+class SidebarService::Serializer
+    : public base::ImportantFileWriter::DataSerializer {
+ public:
+  explicit Serializer(SidebarService* service) : service_(service) {}
+  std::optional<std::string> SerializeData() override {
+    return base::WriteJsonWithOptions(service_->ToValue(),
+                                      base::JSONWriter::OPTIONS_PRETTY_PRINT);
+  }
+
+ private:
+  raw_ptr<SidebarService> service_;
+};
+
+SidebarService::SidebarService(const base::FilePath& profile_path)
+    : serializer_(std::make_unique<Serializer>(this)) {
+  if (profile_path.empty()) {
+    OnLoaded(std::nullopt);
+    return;
+  }
+  scoped_refptr<base::SequencedTaskRunner> file_runner =
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
+  base::FilePath path = profile_path.Append(kFileName);
+  writer_ = std::make_unique<base::ImportantFileWriter>(path, file_runner);
+  file_runner->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ReadFile, path),
+      base::BindOnce(&SidebarService::OnLoaded, weak_factory_.GetWeakPtr()));
+}
+
+SidebarService::~SidebarService() {
+  if (writer_ && writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
+
+void SidebarService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SidebarService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void SidebarService::OnLoaded(std::optional<std::string> json) {
+  if (json) {
+    std::optional<base::DictValue> dict = base::JSONReader::ReadDict(*json, base::JSON_PARSE_RFC);
+    if (dict) {
+      FromValue(*dict, &spaces_, &favorites_, &active_space_id_);
+    }
+  }
+  EnsureDefaultSpace();
+  loaded_ = true;
+  for (Observer& o : observers_) {
+    o.OnSidebarChanged();
+  }
+}
+
+void SidebarService::EnsureDefaultSpace() {
+  if (spaces_.empty()) {
+    Space space;
+    space.id = NewId();
+    space.name = "Personal";
+    space.color = kDefaultColor;
+    space.color2 = kDefaultColor;
+    spaces_.push_back(std::move(space));
+  }
+  if (!FindSpace(active_space_id_)) {
+    active_space_id_ = spaces_.front().id;
+  }
+}
+
+const Space* SidebarService::FindSpace(const std::string& space_id) const {
+  auto it = std::ranges::find(spaces_, space_id, &Space::id);
+  return it == spaces_.end() ? nullptr : &*it;
+}
+
+const Item* SidebarService::FindItem(const std::string& item_id) const {
+  if (const Item* item = FindIn(favorites_, item_id)) {
+    return item;
+  }
+  for (const Space& space : spaces_) {
+    if (const Item* item = FindIn(space.pinned, item_id)) {
+      return item;
+    }
+  }
+  return nullptr;
+}
+
+std::string SidebarService::ContainerOf(const std::string& item_id) const {
+  if (FindIn(favorites_, item_id)) {
+    return kFavorites;
+  }
+  for (const Space& space : spaces_) {
+    if (FindIn(space.pinned, item_id)) {
+      return space.id;
+    }
+  }
+  return std::string();
+}
+
+std::vector<std::string> SidebarService::SubtreeIds(
+    const std::string& item_id) const {
+  std::vector<std::string> ids;
+  if (const Item* item = FindItem(item_id)) {
+    CollectIds(*item, &ids);
+  }
+  return ids;
+}
+
+std::string SidebarService::CreateSpace(const std::string& name,
+                                        const std::string& icon,
+                                        const std::string& color,
+                                        const std::string& color2) {
+  Space space;
+  space.id = NewId();
+  space.name = name.empty() ? "Space" : name;
+  space.icon = icon;
+  space.color = color.empty() ? kDefaultColor : color;
+  space.color2 = color2.empty() ? space.color : color2;
+  std::string id = space.id;
+  spaces_.push_back(std::move(space));
+  Changed();
+  return id;
+}
+
+bool SidebarService::UpdateSpace(const std::string& space_id,
+                                 const std::string& name,
+                                 const std::string& icon,
+                                 const std::string& color,
+                                 const std::string& color2) {
+  auto it = std::ranges::find(spaces_, space_id, &Space::id);
+  if (it == spaces_.end()) {
+    return false;
+  }
+  if (!name.empty()) {
+    it->name = name;
+  }
+  it->icon = icon;
+  if (!color.empty()) {
+    it->color = color;
+    it->color2 = color2.empty() ? color : color2;
+  }
+  Changed();
+  return true;
+}
+
+bool SidebarService::DeleteSpace(const std::string& space_id) {
+  if (spaces_.size() < 2) {
+    return false;
+  }
+  auto it = std::ranges::find(spaces_, space_id, &Space::id);
+  if (it == spaces_.end()) {
+    return false;
+  }
+  size_t index = it - spaces_.begin();
+  spaces_.erase(it);
+  if (active_space_id_ == space_id) {
+    active_space_id_ = spaces_[std::min(index, spaces_.size() - 1)].id;
+  }
+  Changed();
+  return true;
+}
+
+bool SidebarService::MoveSpace(const std::string& space_id, int index) {
+  auto it = std::ranges::find(spaces_, space_id, &Space::id);
+  if (it == spaces_.end()) {
+    return false;
+  }
+  Space space = std::move(*it);
+  spaces_.erase(it);
+  size_t to = std::clamp<int>(index, 0, spaces_.size());
+  spaces_.insert(spaces_.begin() + to, std::move(space));
+  Changed();
+  return true;
+}
+
+bool SidebarService::SetActiveSpace(const std::string& space_id) {
+  if (!FindSpace(space_id)) {
+    return false;
+  }
+  if (active_space_id_ != space_id) {
+    active_space_id_ = space_id;
+    Changed();
+  }
+  return true;
+}
+
+std::vector<Item>* SidebarService::ListFor(const std::string& container,
+                                           const std::string& parent_id) {
+  std::vector<Item>* top = nullptr;
+  if (container == kFavorites) {
+    top = &favorites_;
+  } else {
+    auto it = std::ranges::find(spaces_, container, &Space::id);
+    if (it == spaces_.end()) {
+      return nullptr;
+    }
+    top = &it->pinned;
+  }
+  if (parent_id.empty()) {
+    return top;
+  }
+  std::vector<Item>* list = nullptr;
+  size_t index = 0;
+  if (!Locate(*top, parent_id, &list, &index) || !(*list)[index].is_folder) {
+    return nullptr;
+  }
+  return &(*list)[index].children;
+}
+
+std::string SidebarService::AddItem(const std::string& container,
+                                    const std::string& parent_id,
+                                    int index,
+                                    Item item) {
+  std::vector<Item>* list = ListFor(container, parent_id);
+  if (!list) {
+    return std::string();
+  }
+  if (item.id.empty()) {
+    item.id = NewId();
+  }
+  std::string id = item.id;
+  size_t at = index < 0 ? list->size() : std::min<size_t>(index, list->size());
+  list->insert(list->begin() + at, std::move(item));
+  Changed();
+  return id;
+}
+
+bool SidebarService::MoveItem(const std::string& item_id,
+                              const std::string& container,
+                              const std::string& parent_id,
+                              int index) {
+  const Item* item = FindItem(item_id);
+  if (!item || (!parent_id.empty() &&
+                (parent_id == item_id || Contains(*item, parent_id)))) {
+    return false;  // unknown, or a folder into itself
+  }
+  if (!ListFor(container, parent_id)) {
+    return false;
+  }
+  // Take it out, then insert at the target.
+  std::vector<Item>* from = nullptr;
+  size_t from_index = 0;
+  bool found = Locate(favorites_, item_id, &from, &from_index);
+  for (size_t i = 0; !found && i < spaces_.size(); ++i) {
+    found = Locate(spaces_[i].pinned, item_id, &from, &from_index);
+  }
+  if (!found) {
+    return false;
+  }
+  Item moved = std::move((*from)[from_index]);
+  from->erase(from->begin() + from_index);
+  std::vector<Item>* to = ListFor(container, parent_id);
+  size_t at = index < 0 ? to->size() : std::min<size_t>(index, to->size());
+  to->insert(to->begin() + at, std::move(moved));
+  Changed();
+  return true;
+}
+
+bool SidebarService::RemoveItem(const std::string& item_id) {
+  std::vector<Item>* list = nullptr;
+  size_t index = 0;
+  bool found = Locate(favorites_, item_id, &list, &index);
+  for (size_t i = 0; !found && i < spaces_.size(); ++i) {
+    found = Locate(spaces_[i].pinned, item_id, &list, &index);
+  }
+  if (!found) {
+    return false;
+  }
+  list->erase(list->begin() + index);
+  Changed();
+  return true;
+}
+
+bool SidebarService::RenameItem(const std::string& item_id,
+                                const std::string& title) {
+  Item* item = const_cast<Item*>(FindItem(item_id));
+  if (!item) {
+    return false;
+  }
+  item->title = title;
+  Changed();
+  return true;
+}
+
+bool SidebarService::SetFolderOpen(const std::string& item_id, bool open) {
+  Item* item = const_cast<Item*>(FindItem(item_id));
+  if (!item || !item->is_folder) {
+    return false;
+  }
+  item->open = open;
+  Changed();
+  return true;
+}
+
+void SidebarService::ReplaceAll(std::vector<Space> spaces,
+                                std::vector<Item> favorites,
+                                const std::string& active_space_id) {
+  spaces_ = std::move(spaces);
+  favorites_ = std::move(favorites);
+  active_space_id_ = active_space_id;
+  EnsureDefaultSpace();
+  Changed();
+}
+
+base::DictValue SidebarService::ToValue() const {
+  base::DictValue root;
+  root.Set("version", kVersion);
+  root.Set("activeSpace", active_space_id_);
+  base::ListValue spaces;
+  for (const Space& space : spaces_) {
+    base::DictValue s;
+    s.Set("id", space.id);
+    s.Set("name", space.name);
+    s.Set("icon", space.icon);
+    s.Set("color", space.color);
+    s.Set("color2", space.color2);
+    s.Set("pinned", ItemsToValue(space.pinned));
+    spaces.Append(std::move(s));
+  }
+  root.Set("spaces", std::move(spaces));
+  root.Set("favorites", ItemsToValue(favorites_));
+  return root;
+}
+
+// static
+bool SidebarService::FromValue(const base::DictValue& value,
+                               std::vector<Space>* spaces,
+                               std::vector<Item>* favorites,
+                               std::string* active_space_id) {
+  const base::ListValue* list = value.FindList("spaces");
+  if (!list) {
+    return false;
+  }
+  spaces->clear();
+  for (const base::Value& v : *list) {
+    if (!v.is_dict()) {
+      continue;
+    }
+    const base::DictValue& d = v.GetDict();
+    const std::string* id = d.FindString("id");
+    if (!id || id->empty()) {
+      continue;
+    }
+    Space space;
+    space.id = *id;
+    auto str = [&](const char* key) {
+      const std::string* s = d.FindString(key);
+      return s ? *s : std::string();
+    };
+    space.name = str("name");
+    space.icon = str("icon");
+    space.color = str("color");
+    space.color2 = str("color2");
+    if (space.color.empty()) {
+      space.color = kDefaultColor;
+    }
+    if (space.color2.empty()) {
+      space.color2 = space.color;
+    }
+    space.pinned = ItemsFromValue(d.FindList("pinned"));
+    spaces->push_back(std::move(space));
+  }
+  *favorites = ItemsFromValue(value.FindList("favorites"));
+  const std::string* active = value.FindString("activeSpace");
+  *active_space_id = active ? *active : std::string();
+  return true;
+}
+
+void SidebarService::FlushForTesting() {
+  if (writer_ && writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
+
+void SidebarService::Changed() {
+  if (writer_) {
+    writer_->ScheduleWrite(serializer_.get());
+  }
+  for (Observer& o : observers_) {
+    o.OnSidebarChanged();
+  }
+}
+
+}  // namespace meridian
