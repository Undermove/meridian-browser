diff --git a/chrome/browser/resources/webui_browser/meridian/item.html.ts b/chrome/browser/resources/webui_browser/meridian/item.html.ts
new file mode 100644
index 0000000000..b70294dc9f
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/item.html.ts
@@ -0,0 +1,58 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html, repeat} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import type {MeridianItemElement} from './item.js';
+
+export function getHtml(this: MeridianItemElement) {
+  return html`<!--_html_template_start_-->
+${this.item?.isFolder ? html`
+  <div class="folder-wrap ${this.item.open ? '' : 'collapsed'}">
+    <div class="row folder" style="--depth:${this.depth}"
+        data-item="${this.item.id}" @mousedown="${this.onRowMousedown_}"
+        @contextmenu="${this.onRowContextmenu_}">
+      <span class="folder-ic">
+        ${icon(this.item.open ? 'folderOpen' : 'folder')}
+      </span>
+      ${this.renaming === this.item.id ? html`
+        <input class="rename" .value="${this.item.title}" spellcheck="false"
+            @keydown="${this.onRenameKeydown_}" @blur="${this.onRenameBlur_}">
+      ` : html`<span class="title">${this.item.title}</span>`}
+    </div>
+    <div class="children">
+      ${repeat(this.item.children, c => c.id, c => html`
+        <meridian-item .item="${c}" .depth="${this.depth + 1}"
+            .container="${this.container}" .host="${this.host}"
+            .rev="${this.rev}" .renaming="${this.renaming}">
+        </meridian-item>`)}
+    </div>
+  </div>
+` : ''}
+${this.item && !this.item.isFolder ? html`
+  <div class="row pinned ${this.tab_ ? '' : 'unloaded'} ${
+      this.tab_?.isActive ? 'active' : ''}" style="--depth:${this.depth}"
+      data-item="${this.item.id}" title="${this.title_}"
+      @mousedown="${this.onRowMousedown_}"
+      @contextmenu="${this.onRowContextmenu_}">
+    ${this.away_ ? html`
+      <button class="row-btn reset" title="Back to the pinned page"
+          @click="${this.onResetClick_}">${icon('slash', 14)}</button>
+    ` : ''}
+    <span class="favicon">
+      <img src="${this.favicon_}" width="16" height="16" alt="">
+    </span>
+    ${this.renaming === this.item.id ? html`
+      <input class="rename" .value="${this.item.title}" spellcheck="false"
+          @keydown="${this.onRenameKeydown_}" @blur="${this.onRenameBlur_}">
+    ` : html`<span class="title">${this.title_}</span>`}
+    ${this.tab_ ? html`
+      <button class="row-btn close" title="Close"
+          @click="${this.onCloseClick_}">${icon('x', 14)}</button>
+    ` : ''}
+  </div>
+` : ''}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/item.ts b/chrome/browser/resources/webui_browser/meridian/item.ts
new file mode 100644
index 0000000000..b4c2fcec95
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/item.ts
@@ -0,0 +1,118 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A pinned link or a folder in the sidebar (folders render their children
+// as nested <meridian-item>s). Actions go to the owning <meridian-sidebar>.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+import type {Tab} from '/tab_strip_api/tab_strip_api_data_model.mojom-webui.js';
+
+import type {Item} from '../sidebar.mojom-webui.js';
+
+import {getHtml} from './item.html.js';
+import {getCss} from './rows.css.js';
+import type {MeridianSidebarElement} from './sidebar.js';
+
+export class MeridianItemElement extends CrLitElement {
+  static get is() {
+    return 'meridian-item';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      item: {type: Object},
+      depth: {type: Number},
+      container: {type: String},
+      host: {type: Object},
+      rev: {type: Number},
+      renaming: {type: String},
+      tab_: {state: true, type: Object},
+      away_: {state: true, type: Boolean},
+      favicon_: {state: true, type: String},
+      title_: {state: true, type: String},
+    };
+  }
+
+  accessor item: Item|null = null;
+  accessor depth: number = 0;
+  accessor container: string = '';
+  accessor host: MeridianSidebarElement|null = null;
+  accessor rev: number = 0;
+  accessor renaming: string = '';
+  protected accessor tab_: Tab|null = null;
+  protected accessor away_: boolean = false;
+  protected accessor favicon_: string = '';
+  protected accessor title_: string = '';
+
+  override willUpdate(changed: PropertyValues<this>) {
+    super.willUpdate(changed);
+    const item = this.item;
+    const host = this.host;
+    if (!item || !host) {
+      return;
+    }
+    this.tab_ = host.liveTab(item.id);
+    this.away_ = host.awayFromHome(item, this.tab_);
+    this.favicon_ = host.faviconFor(item, this.tab_);
+    this.title_ = this.tab_ && this.away_ ?
+        this.tab_.title :
+        item.title || this.tab_?.title || item.url;
+  }
+
+  override updated(changed: PropertyValues<this>) {
+    super.updated(changed);
+    const input =
+        this.shadowRoot.querySelector<HTMLInputElement>('input.rename');
+    if (input && input.dataset['focused'] !== '1') {
+      input.dataset['focused'] = '1';
+      input.focus();
+      input.select();
+    }
+  }
+
+  protected onRowMousedown_(e: MouseEvent) {
+    e.stopPropagation();
+    this.host?.onItemMouseDown(e, this.item!);
+  }
+
+  protected onRowContextmenu_(e: MouseEvent) {
+    this.host?.onItemContextMenu(e, this.item!, this.container);
+  }
+
+  protected onCloseClick_(e: Event) {
+    const tab = this.tab_;
+    if (tab) {
+      this.host?.onCloseClick(e, tab);
+    }
+  }
+
+  protected onResetClick_(e: Event) {
+    this.host?.onResetClick(e, this.item!);
+  }
+
+  protected onRenameKeydown_(e: KeyboardEvent) {
+    this.host?.onRenameKeydown(e);
+  }
+
+  protected onRenameBlur_(e: Event) {
+    this.host?.onRenameBlur(e, this.item!.id, false);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-item': MeridianItemElement;
+  }
+}
+
+customElements.define(MeridianItemElement.is, MeridianItemElement);
