+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AGENT_AGENT_SERVER_H_
+#define CHROME_BROWSER_MERIDIAN_AGENT_AGENT_SERVER_H_
+
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+
+namespace base {
+class SequencedTaskRunner;
+}
+
+namespace meridian {
+
+// The local endpoint MCP bridges (`Meridian --mcp-bridge`) call: a unix socket
+// in a private folder, and a random token. Both are written to
+// "<user data>/Meridian Agent.json" (0600); every request carries the token.
+// No TCP port, so websites can't reach it; only this user's processes
+// connect.
+//
+// The protocol is one JSON object per line:
+//   -> {"token": "...", "id": 1, "client": "claude-code", "tool": "list_tabs",
+//       "input": {...}}
+//   <- {"id": 1, "result": {...}}  or  {"id": 1, "error": "..."}
+class AgentServer {
+ public:
+  // Called on the creating (UI) sequence; `reply` may be run from there.
+  using Handler = base::RepeatingCallback<void(
+      base::DictValue request,
+      base::OnceCallback<void(base::DictValue response)> reply)>;
+
+  AgentServer(const base::FilePath& user_data_dir, Handler handler);
+  AgentServer(const AgentServer&) = delete;
+  AgentServer& operator=(const AgentServer&) = delete;
+  // Stops listening and removes the socket and endpoint file.
+  ~AgentServer();
+
+  static base::FilePath EndpointPath(const base::FilePath& user_data_dir);
+
+ private:
+  class Core;
+
+  scoped_refptr<base::SequencedTaskRunner> socket_runner_;
+  std::unique_ptr<Core> core_;  // Lives and dies on `socket_runner_`.
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_AGENT_AGENT_SERVER_H_
