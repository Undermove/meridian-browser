@@ -0,0 +1,32 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AGENT_AGENT_CLI_H_
+#define CHROME_BROWSER_MERIDIAN_AGENT_AGENT_CLI_H_
+
+#include <string>
+#include <vector>
+
+namespace meridian {
+
+// "Connect Claude Code / Codex": registers Meridian's MCP server with a
+// coding-agent CLI. The CLIs are found on the login shell's PATH (apps
+// started from the Dock don't inherit it); the person sees the exact command
+// before it runs. Both functions block (they run processes).
+struct AgentCli {
+  std::string id;       // "claude" or "codex"
+  std::string name;     // "Claude Code"
+  std::string path;     // empty if not found
+  std::string command;  // what Connect runs
+};
+
+std::vector<AgentCli> DetectAgentClis();
+
+// Runs the CLI's "mcp add"; `output` is what it printed. Already registered
+// counts as connected.
+bool ConnectAgentCli(const std::string& id, std::string* output);
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_AGENT_AGENT_CLI_H_
diff --git a/chrome/browser/meridian/agent/agent_page.js b/chrome/browser/meridian/agent/agent_page.js
new file mode 100644
index 0000000000..0c62174105
--- /dev/null
+++ b/chrome/browser/meridian/agent/agent_page.js
@@ -0,0 +1,259 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// What agents do inside a page, from the Electron build's src/agent/hub.js.
+// Runs in an isolated world (the page can't tamper with it) as
+// window.__meridianAgent; AgentService calls its functions with JSON args.
+// Pages built from web components keep inputs inside shadow roots, which
+// querySelectorAll and innerText don't enter, so the helpers walk them too.
+(() => {
+  if (window.__meridianAgent) {
+    return;
+  }
+  const deepRoots = () => {
+    const roots = [document];
+    for (let i = 0; i < roots.length && roots.length < 2000; i++) {
+      for (const el of roots[i].querySelectorAll('*')) {
+        if (el.shadowRoot) roots.push(el.shadowRoot);
+      }
+    }
+    return roots;
+  };
+  const deepAll = (sel) => {
+    const out = [];
+    for (const r of deepRoots()) out.push(...r.querySelectorAll(sel));
+    return out;
+  };
+  const deepOne = (sel) => document.querySelector(sel) || deepAll(sel)[0] || null;
+  const hostOf = (el) => {
+    const r = el.getRootNode && el.getRootNode();
+    return r && r.host ? r.host : null;
+  };
+  // A custom element that only wraps the real control: act on the control.
+  const FOCUSABLE = 'input:not([type=hidden]),textarea,select,button,a[href],' +
+      '[contenteditable=""],[contenteditable=true],[role=textbox],[role=button]';
+  const drill = (el) => {
+    let cur = el;
+    for (let k = 0; k < 4 && cur && cur.shadowRoot && !cur.matches(FOCUSABLE); k++) {
+      cur = cur.shadowRoot.querySelector(FOCUSABLE) || cur;
+    }
+    return cur || el;
+  };
+  const inside = (node, anc) => {
+    for (let n = node; n; n = n.parentNode || n.host) if (n === anc) return true;
+    return false;
+  };
+  const deepHit = (x, y) => {
+    let hit = document.elementFromPoint(x, y);
+    for (let k = 0; k < 8 && hit && hit.shadowRoot; k++) {
+      const inner = hit.shadowRoot.elementFromPoint(x, y);
+      if (!inner || inner === hit) break;
+      hit = inner;
+    }
+    return hit;
+  };
+  const deepText = () => {
+    let t = (document.body ? document.body.innerText : '') || '';
+    for (const r of deepRoots().slice(1)) {
+      for (const c of r.children) {
+        if (c.tagName !== 'STYLE' && c.tagName !== 'SCRIPT' && c.innerText) t += '\n' + c.innerText;
+      }
+    }
+    return t;
+  };
+  const labelOf = (el) => el.getAttribute('aria-label') || el.innerText ||
+      el.getAttribute('placeholder') || el.getAttribute('title') ||
+      el.getAttribute('name') ||
+      (hostOf(el) && (hostOf(el).getAttribute('aria-label') ||
+                      hostOf(el).getAttribute('label') ||
+                      hostOf(el).getAttribute('placeholder') ||
+                      hostOf(el).getAttribute('name'))) || '';
+  const clip = (s, n) => (s || '').replace(/\s+/g, ' ').trim().slice(0, n);
+
+  const find = (spec) => {
+    let el = null;
+    if (Number.isInteger(spec.element_index)) {
+      el = (window.__meridianEls || [])[spec.element_index];
+      if (!el || !el.isConnected) return {error: 'element_index is stale — call get_interactive_elements again'};
+    } else if (spec.selector) {
+      try { el = deepOne(spec.selector); } catch (e) { return {error: 'invalid selector'}; }
+      if (el) el = drill(el);
+    } else if (spec.text) {
+      const want = spec.text.toLowerCase().trim();
+      const cands = deepAll('a,button,input:not([type=hidden]),textarea,[role=button],[role=link],[role=tab],[role=menuitem],[role=textbox],[contenteditable=""],[contenteditable=true],summary,label');
+      const label = (e) => (labelOf(e) || e.value || '').replace(/\s+/g, ' ').trim().toLowerCase();
+      el = cands.find((e) => label(e) === want) || cands.find((e) => label(e).includes(want));
+      if (el && el.tagName === 'LABEL' && el.control) el = el.control;
+      if (!el) {
+        let best = null;
+        for (const n of deepAll('*')) {
+          if (n.children.length > 50) continue;
+          const t = n.innerText;
+          if (t && t.toLowerCase().includes(want) && (!best || t.length < best.innerText.length)) best = n;
+        }
+        el = best && drill(best);
+      }
+    } else {
+      return {error: 'give element_index, selector or text'};
+    }
+    return el ? {el} : {error: 'element not found'};
+  };
+
+  window.__meridianAgent = {
+    read(offset, max) {
+      const text = deepText().replace(/[ \t ]+/g, ' ').replace(/\n\s*\n\s*\n+/g, '\n\n').trim();
+      return {url: location.href, title: document.title, total: text.length, offset, text: text.slice(offset, offset + max)};
+    },
+
+    elements(onlyVisible, query, within) {
+      query = String(query || '').toLowerCase();
+      let scope = null;
+      if (within) {
+        try { scope = deepOne(within); } catch { return {error: 'invalid within selector'}; }
+        if (!scope) return {error: 'nothing on the page matches within: ' + within};
+      }
+      const sel = 'a[href],button,input:not([type=hidden]),textarea,select,summary,[role=button],[role=link],[role=tab],[role=menuitem],[role=checkbox],[role=radio],[role=switch],[role=option],[role=textbox],[contenteditable=""],[contenteditable=true],[onclick],[tabindex]:not([tabindex="-1"])';
+      const els = deepAll(sel).filter((el) => {
+        const r = el.getBoundingClientRect();
+        if (r.width < 2 || r.height < 2) return false;
+        const cs = getComputedStyle(el);
+        if (cs.visibility === 'hidden' || cs.display === 'none' || Number(cs.opacity) === 0) return false;
+        if (onlyVisible && (r.bottom < 0 || r.top > innerHeight)) return false;
+        if (scope && !inside(el, scope)) return false;
+        if (query && !((labelOf(el) + ' ' + (el.innerText || '') + ' ' + (el.href || '')).toLowerCase().includes(query))) return false;
+        return true;
+      });
+      const capped = els.length > 400;
+      els.length = Math.min(els.length, 400);
+      window.__meridianEls = els;
+      return els.map((el, i) => {
+        const r = el.getBoundingClientRect();
+        const tag = el.tagName.toLowerCase();
+        const type = el.getAttribute('type') || undefined;
+        const label = clip(labelOf(el) || el.querySelector?.('img')?.alt || el.value && type !== 'password' && el.value || '', 100);
+        const out = {i, tag, label};
+        if (hostOf(el)) out.in_shadow_dom = true;
+        const visible = clip(el.innerText, 100);
+        if (visible && visible.toLowerCase() !== label.toLowerCase()) out.visible_text = visible;
+        const role = el.getAttribute('role');
+        if (role) out.role = role;
+        if (type) out.type = type;
+        if (tag === 'a') out.href = clip(el.href, 160);
+        if ((tag === 'input' || tag === 'textarea') && type !== 'password') {
+          const v = clip(el.value, 80);
+          if (v) out.value = v;
+        }
+        if (tag === 'input' && el.placeholder) out.placeholder = clip(el.placeholder, 60);
+        if (el.disabled) out.disabled = true;
+        if (r.bottom < 0 || r.top > innerHeight) out.offscreen = true;
+        return out;
+      }).concat(capped ? [{note: 'only the first 400 are listed: narrow it down with query or within'}] : []);
+    },
+
+    // Finds an element and scrolls it into view; its centre in CSS px.
+    locate(spec) {
+      const found = find(spec);
+      if (found.error) return found;
+      const el = found.el;
+      el.scrollIntoView({block: 'center', inline: 'center', behavior: 'instant'});
+      const r = el.getBoundingClientRect();
+      window.__meridianTarget = el;
+      return {
+        x: r.left + r.width / 2, y: r.top + r.height / 2, w: r.width, h: r.height,
+        tag: el.tagName.toLowerCase(),
+        label: clip(el.getAttribute('aria-label') || el.innerText || el.value || el.placeholder || '', 80),
+        visible: clip(el.innerText || el.value || '', 120),
+        password: el.type === 'password',
+        href: el.closest('a')?.href?.slice(0, 200) || undefined,
+        form: el.form?.action?.slice(0, 200) || undefined,
+      };
+    },
+
+    // After the person approved: is our element still the one at its centre?
+    verifyHit() {
+      const el = window.__meridianTarget;
+      if (!el || !el.isConnected) return {ok: false, why: 'element disappeared'};
+      el.scrollIntoView({block: 'center', inline: 'center', behavior: 'instant'});
+      const r = el.getBoundingClientRect();
+      const x = r.left + r.width / 2, y = r.top + r.height / 2;
+      const hit = deepHit(x, y);
+      if (!hit || !(inside(hit, el) || inside(el, hit))) return {ok: false, why: 'element is covered by something else'};
+      return {ok: true, x, y};
+    },
+
+    clickFallback() {
+      const el = window.__meridianTarget;
+      if (el) { el.click(); return true; }
+      return false;
+    },
+
+    readTarget() {
+      const el = window.__meridianTarget;
+      if (!el || !el.isConnected) return null;
+      return 'value' in el && typeof el.value === 'string' ? el.value : (el.innerText || '').replace(/\n$/, '');
+    },
+
+    focusForTyping(clear) {
+      const el = window.__meridianTarget;
+      if (!el) return false;
+      el.focus();
+      if (clear) {
+        if ('value' in el) {
+          el.select?.();
+        } else if (el.isContentEditable) {
+          // execCommand goes through the editor's own input events.
+          if (!document.execCommand('selectAll')) {
+            const r = document.createRange();
+            r.selectNodeContents(el);
+            const s = getSelection();
+            s.removeAllRanges();
+            s.addRange(r);
+          }
+        }
+      } else if ('value' in el && typeof el.setSelectionRange === 'function') {
+        try { el.setSelectionRange(el.value.length, el.value.length); } catch {}
+      }
+      return true;
+    },
+
+    // Enter without real input (a page that isn't drawing): submit the form.
+    submitFallback() {
+      const el = window.__meridianTarget || document.activeElement;
+      if (!el) return false;
+      const opts = {key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true};
+      const go = el.dispatchEvent(new KeyboardEvent('keydown', opts));
+      el.dispatchEvent(new KeyboardEvent('keyup', opts));
+      if (go && el.form) el.form.requestSubmit ? el.form.requestSubmit() : el.form.submit();
+      return true;
+    },
+
+    scrollTo(spec) {
+      let el = null;
+      if (Number.isInteger(spec.element_index)) el = (window.__meridianEls || [])[spec.element_index];
+      else if (spec.selector) {
+        try { el = deepOne(spec.selector); } catch { return {error: 'invalid selector'}; }
+      }
+      if (!el || !el.isConnected) {
+        return {error: Number.isInteger(spec.element_index) ? 'element_index is stale — call get_interactive_elements again' : 'nothing on the page matches that selector'};
+      }
+      el.scrollIntoView({block: 'center', inline: 'nearest'});
+      return {scrolled_to: clip(labelOf(el) || el.tagName.toLowerCase(), 80), scrollY: Math.round(scrollY)};
+    },
+
+    scroll(direction, screens) {
+      if (direction === 'top') scrollTo(0, 0);
+      else if (direction === 'bottom') scrollTo(0, document.documentElement.scrollHeight);
+      else scrollBy(0, (direction === 'up' ? -1 : 1) * innerHeight * 0.85 * (Number(screens) || 1));
+      return {scrollY: Math.round(scrollY), height: document.documentElement.scrollHeight, viewport: innerHeight};
+    },
+
+    has(text, selector) {
+      if (selector) {
+        try { if (deepOne(selector)) return true; } catch { return 'bad-selector'; }
+      }
+      if (text) return deepText().toLowerCase().includes(String(text).toLowerCase());
+      return false;
+    },
+  };
+})();
