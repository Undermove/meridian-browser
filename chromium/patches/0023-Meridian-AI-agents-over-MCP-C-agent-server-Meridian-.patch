+// One tool call in flight.
+struct AgentService::Call {
+  std::string tool;
+  std::string client;
+  base::DictValue input;
+  Reply reply;
+  // Keeps a hidden tab drawing (input and screenshots need frames).
+  base::ScopedClosureRunner capture;
+
+  const std::string* Str(const char* key) const {
+    return input.FindString(key);
+  }
+  std::string StrOr(const char* key, const std::string& fallback) const {
+    const std::string* s = input.FindString(key);
+    return s ? *s : fallback;
+  }
+  void Ok(base::Value result) {
+    base::DictValue response;
+    response.Set("result", std::move(result));
+    std::move(reply).Run(std::move(response));
+  }
+  void Fail(const std::string& error) {
+    base::DictValue response;
+    response.Set("error", error);
+    std::move(reply).Run(std::move(response));
+  }
+};
