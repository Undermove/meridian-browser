+namespace {
+
+// A URL, or a search with the default search engine.
+GURL ToUrl(Profile* profile, const std::string& text) {
+  GURL url(text);
+  if (url.is_valid() && (url.SchemeIsHTTPOrHTTPS() || url.SchemeIs("about") ||
+                         url.SchemeIsFile())) {
+    return url;
+  }
+  if (text.find(' ') == std::string::npos &&
+      text.find('.') != std::string::npos) {
+    GURL https("https://" + text);
+    if (https.is_valid()) {
+      return https;
+    }
+  }
+  TemplateURLService* search = TemplateURLServiceFactory::GetForProfile(profile);
+  const TemplateURL* engine =
+      search ? search->GetDefaultSearchProvider() : nullptr;
+  if (!engine) {
+    return GURL("https://www.google.com/search?q=" + text);
+  }
+  return GURL(engine->url_ref().ReplaceSearchTerms(
+      TemplateURLRef::SearchTermsArgs(base::UTF8ToUTF16(text)),
+      search->search_terms_data()));
+}
