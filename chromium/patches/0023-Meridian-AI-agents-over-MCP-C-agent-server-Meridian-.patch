+    return;
+  }
+  // Denied if the window goes away before the person answers.
+  handler->page_->AskAgent(
+      client, summary,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(done), false));
+}
+
+void SidebarHandler::SetAgentsPaused(bool paused) {
+  if (AgentService* agents =
+          AgentServiceFactory::GetForProfile(browser_->GetProfile())) {
+    agents->SetPaused(paused);
+  }
+}
+
+void SidebarHandler::GetAgentClis(GetAgentClisCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&DetectAgentClis),
+      base::BindOnce(
+          [](GetAgentClisCallback callback, std::vector<AgentCli> clis) {
+            std::vector<mojom::AgentCliPtr> out;
+            for (const AgentCli& cli : clis) {
+              auto m = mojom::AgentCli::New();
+              m->id = cli.id;
+              m->name = cli.name;
+              m->found = !cli.path.empty();
+              m->command = cli.command;
+              out.push_back(std::move(m));
+            }
+            std::move(callback).Run(std::move(out));
+          },
+          std::move(callback)));
+}
+
+void SidebarHandler::ConnectAgentCli(const std::string& id,
+                                     ConnectAgentCliCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](std::string id) {
+            std::string output;
+            bool ok = meridian::ConnectAgentCli(id, &output);
+            return std::make_pair(ok, output);
+          },
+          id),
+      base::BindOnce(
+          [](ConnectAgentCliCallback callback,
+             std::pair<bool, std::string> result) {
+            std::move(callback).Run(result.first, result.second);
+          },
+          std::move(callback)));
+}
