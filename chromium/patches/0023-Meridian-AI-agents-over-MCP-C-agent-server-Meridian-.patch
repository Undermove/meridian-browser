+// Waits until a tab stops loading (or 30 s pass).
+class LoadWaiter : public content::WebContentsObserver {
+ public:
+  static void Wait(content::WebContents* contents, base::OnceClosure done) {
+    if (!contents->IsLoading()) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE, std::move(done), base::Milliseconds(100));
+      return;
+    }
+    new LoadWaiter(contents, std::move(done));
+  }
+
+ private:
+  LoadWaiter(content::WebContents* contents, base::OnceClosure done)
+      : content::WebContentsObserver(contents), done_(std::move(done)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&LoadWaiter::Finish, weak_factory_.GetWeakPtr()),
+        base::Seconds(30));
+  }
+  void DidStopLoading() override { Finish(); }
+  void WebContentsDestroyed() override { Finish(); }
+  void Finish() {
+    if (done_) {
+      std::move(done_).Run();
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                               this);
+  }
+
+  base::OnceClosure done_;
+  base::WeakPtrFactory<LoadWaiter> weak_factory_{this};
+};
+
+// Minimal input validation: required keys and primitive types.
+std::string Validate(const base::DictValue& tool, const base::DictValue& in) {
+  const base::DictValue* schema = tool.FindDict("input_schema");
+  const base::DictValue* props = schema ? schema->FindDict("properties") : nullptr;
+  if (const base::ListValue* required =
+          schema ? schema->FindList("required") : nullptr) {
+    for (const base::Value& key : *required) {
+      const base::Value* v = in.Find(key.GetString());
+      bool empty_ok = *tool.FindString("name") == "type_text" &&
+                      key.GetString() == "value";
+      if (!v || v->is_none() ||
+          (v->is_string() && v->GetString().empty() && !empty_ok)) {
+        return "missing required field: " + key.GetString();
+      }
+    }
+  }
+  for (const auto [key, value] : in) {
+    const base::DictValue* spec = props ? props->FindDict(key) : nullptr;
+    if (!spec) {
+      return "unknown field: " + key;
+    }
+    const std::string* type = spec->FindString("type");
+    bool ok = !type || (*type == "string" && value.is_string()) ||
+              (*type == "integer" && value.is_int()) ||
+              (*type == "number" && (value.is_int() || value.is_double())) ||
+              (*type == "boolean" && value.is_bool());
+    if (!ok) {
+      return key + " must be a " + *type;
+    }
+    if (const base::ListValue* allowed = spec->FindList("enum")) {
+      if (std::ranges::find(*allowed, value) == allowed->end()) {
+        return key + " has an unexpected value";
+      }
+    }
+    if (value.is_string() && value.GetString().size() > 200000) {
+      return key + " is too long";
+    }
+  }
+  return std::string();
+}
+
+void SendKey(content::RenderWidgetHost* widget,
+             ui::KeyboardCode code,
+             ui::DomCode dom_code,
+             ui::DomKey dom_key,
+             char16_t text) {
+  using Type = blink::WebInputEvent::Type;
+  for (Type type : {Type::kRawKeyDown, Type::kChar, Type::kKeyUp}) {
+    if (type == Type::kChar && !text) {
+      continue;
+    }
+    input::NativeWebKeyboardEvent event(type, 0, base::TimeTicks::Now());
+    event.windows_key_code = code;
+    event.dom_code = static_cast<int>(dom_code);
+    event.dom_key = dom_key;
+    event.text[0] = text;
+    event.unmodified_text[0] = text;
+    widget->ForwardKeyboardEvent(event);
+  }
+}
