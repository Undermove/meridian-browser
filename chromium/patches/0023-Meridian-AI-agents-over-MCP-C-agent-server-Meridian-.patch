diff --git a/chrome/browser/meridian/agent/agent_cli.cc b/chrome/browser/meridian/agent/agent_cli.cc
new file mode 100644
index 0000000000..0c4efcc50f
--- /dev/null
+++ b/chrome/browser/meridian/agent/agent_cli.cc
@@ -0,0 +1,126 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/agent/agent_cli.h"
+
+#include "base/command_line.h"
+#include "base/environment.h"
+#include "base/files/file_util.h"
+#include "base/no_destructor.h"
+#include "base/process/launch.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace meridian {
+
+namespace {
+
+struct Known {
+  const char* id;
+  const char* name;
+  // Arguments before the server command.
+  std::vector<std::string> args;
+};
+
+const std::vector<Known>& KnownClis() {
+  static const base::NoDestructor<std::vector<Known>> clis(
+      std::vector<Known>{
+          {"claude", "Claude Code", {"mcp", "add", "-s", "user", "meridian", "--"}},
+          {"codex", "Codex", {"mcp", "add", "meridian", "--"}},
+      });
+  return *clis;
+}
+
+std::string Shell() {
+  std::optional<std::string> shell = base::Environment::Create()->GetVar("SHELL");
+  return shell && !shell->empty() ? *shell : "/bin/zsh";
+}
+
+// POSIX shell single quotes.
+std::string Quote(const std::string& s) {
+  std::string out = "'";
+  for (char c : s) {
+    out += c == '\'' ? std::string("'\\''") : std::string(1, c);
+  }
+  return out + "'";
+}
+
+std::string LoginPath() {
+  std::string out;
+  base::GetAppOutput(
+      base::CommandLine({Shell(), "-lc", "printf '%s' \"$PATH\""}), &out);
+  return out.empty() ? "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin" : out;
+}
+
+std::string Which(const std::string& name, const std::string& path) {
+  for (const std::string& dir : base::SplitString(
+           path, ":", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    base::FilePath candidate = base::FilePath(dir).Append(name);
+    if (base::PathIsReadable(candidate) && !base::DirectoryExists(candidate)) {
+      return candidate.value();
+    }
+  }
+  return std::string();
+}
+
+std::vector<std::string> Args(const Known& cli) {
+  std::vector<std::string> args = cli.args;
+  args.push_back(base::CommandLine::ForCurrentProcess()->GetProgram().value());
+  args.push_back("--mcp-bridge");
+  return args;
+}
+
+std::string CommandOf(const Known& cli) {
+  std::string command = cli.id;
+  for (const std::string& arg : Args(cli)) {
+    bool plain = std::ranges::all_of(arg, [](char c) {
+      return base::IsAsciiAlphaNumeric(c) || std::string_view("@%+=:,./-_").find(c) != std::string_view::npos;
+    });
+    command += " " + (plain ? arg : Quote(arg));
+  }
+  return command;
+}
+
+}  // namespace
+
+std::vector<AgentCli> DetectAgentClis() {
+  std::string path = LoginPath();
+  std::vector<AgentCli> out;
+  for (const Known& cli : KnownClis()) {
+    out.push_back({cli.id, cli.name, Which(cli.id, path), CommandOf(cli)});
+  }
+  return out;
+}
+
+bool ConnectAgentCli(const std::string& id, std::string* output) {
+  for (const Known& cli : KnownClis()) {
+    if (cli.id != id) {
+      continue;
+    }
+    std::string bin = Which(cli.id, LoginPath());
+    if (bin.empty()) {
+      *output = std::string(cli.id) + " was not found on your PATH";
+      return false;
+    }
+    // Through the login shell, for the CLI's own PATH (node and the like).
+    std::string script = Quote(bin);
+    for (const std::string& arg : Args(cli)) {
+      script += " " + Quote(arg);
+    }
+    int exit_code = -1;
+    base::GetAppOutputWithExitCode(
+        base::CommandLine({Shell(), "-lc", script + " 2>&1"}), output,
+        &exit_code);
+    if (output->size() > 2000) {
+      output->resize(2000);
+    }
+    return exit_code == 0 ||
+           base::ToLowerASCII(*output).find("already exists") !=
+               std::string::npos;
+  }
+  *output = "unknown CLI";
+  return false;
+}
+
+}  // namespace meridian
