+
+void AgentService::Click(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  Activity(*call, tab);
+  content::WebContents* contents = tab->GetContents();
+  call->capture = contents->IncrementCapturerCount(gfx::Size(), true, true,
+                                                   false);
+  base::DictValue spec;
+  for (const char* key : {"element_index", "selector", "text"}) {
+    if (const base::Value* v = call->input.Find(key)) {
+      spec.Set(key, v->Clone());
+    }
+  }
+  std::string expr = "__meridianAgent.locate(" +
+                     base::WriteJson(spec).value_or("{}") + ")";
+  tabs::TabHandle handle = tab->GetHandle();
+  RunInPage(
+      contents, expr,
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+             std::unique_ptr<Call> call, base::Value target) {
+            if (!self || !target.is_dict()) {
+              return call->Fail("couldn't look at the page");
+            }
+            if (const std::string* error = target.GetDict().FindString("error")) {
+              return call->Fail(*error);
+            }
+            const base::DictValue& t = target.GetDict();
+            std::string label = t.FindString("label") ? *t.FindString("label")
+                                                     : std::string();
+            std::string what = label.empty() ? *t.FindString("tag") : label;
+            std::string summary = "click “" + what + "”";
+            if (const std::string* href = t.FindString("href")) {
+              summary += "\nLink: " + *href;
+            }
+            self->Confirm(
+                std::move(call), summary,
+                base::BindOnce(
+                    [](base::WeakPtr<AgentService> self,
+                       tabs::TabHandle handle, std::string what,
+                       std::unique_ptr<Call> call) {
+                      tabs::TabInterface* tab = handle.Get();
+                      if (!self || !tab) {
+                        return call->Fail("the tab is gone");
+                      }
+                      content::WebContents* contents = tab->GetContents();
+                      // Still the same element under that point?
+                      self->RunInPage(
+                          contents, "__meridianAgent.verifyHit()",
+                          base::BindOnce(
+                              [](base::WeakPtr<AgentService> self,
+                                 base::WeakPtr<content::WebContents> contents,
+                                 std::string what, std::unique_ptr<Call> call,
+                                 base::Value hit) {
+                                if (!self || !contents) {
+                                  return call->Fail("the tab is gone");
+                                }
+                                const base::DictValue* h = hit.GetIfDict();
+                                bool ok = h && h->FindBool("ok").value_or(false);
+                                content::RenderWidgetHost* widget =
+                                    contents->GetPrimaryMainFrame()
+                                        ->GetRenderWidgetHost();
+                                if (ok && widget) {
+                                  double zoom = blink::ZoomLevelToZoomFactor(
+                                      zoom::ZoomController::GetZoomLevelForWebContents(
+                                          contents.get()));
+                                  gfx::PointF p(*h->FindDouble("x") * zoom,
+                                                *h->FindDouble("y") * zoom);
+                                  using Type = blink::WebInputEvent::Type;
+                                  for (Type type : {Type::kMouseMove,
+                                                    Type::kMouseDown,
+                                                    Type::kMouseUp}) {
+                                    bool move = type == Type::kMouseMove;
+                                    blink::WebMouseEvent event(
+                                        type, p, p,
+                                        move ? blink::WebPointerProperties::Button::kNoButton
+                                             : blink::WebPointerProperties::Button::kLeft,
+                                        move ? 0 : 1,
+                                        type == Type::kMouseDown
+                                            ? blink::WebInputEvent::kLeftButtonDown
+                                            : blink::WebInputEvent::kNoModifiers,
+                                        base::TimeTicks::Now());
+                                    widget->ForwardMouseEvent(event);
+                                  }
+                                } else {
+                                  // Covered or gone: the element's own click.
+                                  self->RunInPage(contents.get(),
+                                                  "__meridianAgent.clickFallback()",
+                                                  base::DoNothing());
+                                }
+                                base::SequencedTaskRunner::GetCurrentDefault()
+                                    ->PostDelayedTask(
+                                        FROM_HERE,
+                                        base::BindOnce(
+                                            [](std::unique_ptr<Call> call,
+                                               std::string what,
+                                               base::WeakPtr<content::WebContents>
+                                                   contents) {
+                                              call->Ok(base::Value(
+                                                  base::DictValue()
+                                                      .Set("clicked", what)
+                                                      .Set("url",
+                                                           contents
+                                                               ? contents
+                                                                     ->GetLastCommittedURL()
+                                                                     .spec()
+                                                               : std::string())));
+                                            },
+                                            std::move(call), what, contents),
+                                        base::Milliseconds(400));
+                              },
+                              self, contents->GetWeakPtr(), what,
+                              std::move(call)));
+                    },
+                    self, handle, what));
+          },
+          weak_factory_.GetWeakPtr(), handle, std::move(call)));
+}
+
+void AgentService::TypeText(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  Activity(*call, tab);
+  content::WebContents* contents = tab->GetContents();
+  call->capture = contents->IncrementCapturerCount(gfx::Size(), true, true,
+                                                   false);
+  base::DictValue spec;
+  for (const char* key : {"element_index", "selector", "text"}) {
+    if (const base::Value* v = call->input.Find(key)) {
+      spec.Set(key, v->Clone());
+    }
+  }
+  bool has_target = !spec.empty();
+  // Without a target: the focused field.
+  std::string expr =
+      has_target ? "__meridianAgent.locate(" +
+                       base::WriteJson(spec).value_or("{}") + ")"
+                 : "(window.__meridianTarget = document.activeElement, "
+                   "{tag: document.activeElement && "
+                   "document.activeElement.tagName.toLowerCase(), label: '', "
+                   "password: document.activeElement && "
+                   "document.activeElement.type === 'password'})";
+  tabs::TabHandle handle = tab->GetHandle();
+  RunInPage(
+      contents, expr,
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+             std::unique_ptr<Call> call, base::Value target) {
+            if (!self || !target.is_dict()) {
+              return call->Fail("couldn't look at the page");
+            }
+            const base::DictValue& t = target.GetDict();
+            if (const std::string* error = t.FindString("error")) {
+              return call->Fail(*error);
+            }
+            std::string value = call->StrOr("value", "");
+            bool submit = call->input.FindBool("submit").value_or(false);
+            std::string label = t.FindString("label") && !t.FindString("label")->empty()
+                                    ? *t.FindString("label")
+                                    : t.FindString("tag") ? *t.FindString("tag")
+                                                          : "the focused field";
+            bool password = t.FindBool("password").value_or(false);
+            std::string summary =
+                "type into " +
+                (password ? std::string("a PASSWORD field") : "“" + label + "”") +
+                (submit ? " and SUBMIT it (Enter)" : "") + "\nText (" +
+                base::NumberToString(value.size()) + " characters):\n" + value;
+            if (const std::string* form = t.FindString("form")) {
+              summary += "\n\nForm submits to: " + *form;
+            }
+            self->Confirm(
+                std::move(call), summary,
+                base::BindOnce(
+                    [](base::WeakPtr<AgentService> self,
+                       tabs::TabHandle handle, std::string value, bool submit,
+                       std::unique_ptr<Call> call) {
+                      tabs::TabInterface* tab = handle.Get();
+                      if (!self || !tab) {
+                        return call->Fail("the tab is gone");
+                      }
+                      content::WebContents* contents = tab->GetContents();
+                      bool clear = call->input.FindBool("clear").value_or(false);
+                      self->RunInPage(
+                          contents,
+                          std::string("__meridianAgent.focusForTyping(") +
+                              (clear ? "true" : "false") + ")",
+                          base::BindOnce(
+                              [](base::WeakPtr<AgentService> self,
+                                 base::WeakPtr<content::WebContents> contents,
+                                 std::string value, bool submit, bool clear,
+                                 std::unique_ptr<Call> call, base::Value) {
+                                if (!self || !contents) {
+                                  return call->Fail("the tab is gone");
+                                }
+                                content::RenderWidgetHost* widget =
+                                    contents->GetPrimaryMainFrame()
+                                        ->GetRenderWidgetHost();
+                                if (value.empty() && clear && widget) {
+                                  SendKey(widget, ui::VKEY_BACK,
+                                          ui::DomCode::BACKSPACE,
+                                          ui::DomKey::BACKSPACE, 0);
+                                } else {
+                                  // Into the focused field, as typing or a
+                                  // paste does (replaces a selection).
+                                  contents->Replace(base::UTF8ToUTF16(value));
+                                }
+                                if (submit && widget) {
+                                  SendKey(widget, ui::VKEY_RETURN,
+                                          ui::DomCode::ENTER,
+                                          ui::DomKey::ENTER, '\r');
+                                }
+                                base::SequencedTaskRunner::GetCurrentDefault()
+                                    ->PostDelayedTask(
+                                        FROM_HERE,
+                                        base::BindOnce(
+                                            [](base::WeakPtr<AgentService> self,
+                                               base::WeakPtr<content::WebContents>
+                                                   contents,
+                                               std::unique_ptr<Call> call) {
+                                              if (!self || !contents) {
+                                                return call->Fail(
+                                                    "the tab is gone");
+                                              }
+                                              self->RunInPage(
+                                                  contents.get(),
+                                                  "__meridianAgent.readTarget()",
+                                                  base::BindOnce(
+                                                      [](std::unique_ptr<Call> call,
+                                                         base::Value now) {
+                                                        base::DictValue out;
+                                                        out.Set("typed", true);
+                                                        if (now.is_string()) {
+                                                          out.Set("field_now",
+                                                                  now.GetString()
+                                                                      .substr(0, 500));
+                                                        }
+                                                        call->Ok(base::Value(
+                                                            std::move(out)));
+                                                      },
+                                                      std::move(call)));
+                                            },
+                                            self, contents, std::move(call)),
+                                        base::Milliseconds(300));
+                              },
+                              self, contents->GetWeakPtr(), value, submit,
+                              clear, std::move(call)));
+                    },
+                    self, handle, value, submit));
+          },
+          weak_factory_.GetWeakPtr(), handle, std::move(call)));
+}
+
+void AgentService::PressKey(std::unique_ptr<Call> call) {
+  struct Key {
+    const char* name;
+    ui::KeyboardCode code;
+    ui::DomCode dom_code;
+    ui::DomKey dom_key;
+    char16_t text;
+  };
+  static constexpr Key kKeys[] = {
+      {"Enter", ui::VKEY_RETURN, ui::DomCode::ENTER, ui::DomKey::ENTER, '\r'},
+      {"Escape", ui::VKEY_ESCAPE, ui::DomCode::ESCAPE, ui::DomKey::ESCAPE, 0},
+      {"Tab", ui::VKEY_TAB, ui::DomCode::TAB, ui::DomKey::TAB, '\t'},
+      {"Backspace", ui::VKEY_BACK, ui::DomCode::BACKSPACE,
+       ui::DomKey::BACKSPACE, 0},
+      {"Delete", ui::VKEY_DELETE, ui::DomCode::DEL, ui::DomKey::DEL, 0},
+      {"ArrowUp", ui::VKEY_UP, ui::DomCode::ARROW_UP, ui::DomKey::ARROW_UP, 0},
+      {"ArrowDown", ui::VKEY_DOWN, ui::DomCode::ARROW_DOWN,
+       ui::DomKey::ARROW_DOWN, 0},
+      {"ArrowLeft", ui::VKEY_LEFT, ui::DomCode::ARROW_LEFT,
+       ui::DomKey::ARROW_LEFT, 0},
+      {"ArrowRight", ui::VKEY_RIGHT, ui::DomCode::ARROW_RIGHT,
+       ui::DomKey::ARROW_RIGHT, 0},
+      {"PageUp", ui::VKEY_PRIOR, ui::DomCode::PAGE_UP, ui::DomKey::PAGE_UP, 0},
+      {"PageDown", ui::VKEY_NEXT, ui::DomCode::PAGE_DOWN,
+       ui::DomKey::PAGE_DOWN, 0},
+      {"Home", ui::VKEY_HOME, ui::DomCode::HOME, ui::DomKey::HOME, 0},
+      {"End", ui::VKEY_END, ui::DomCode::END, ui::DomKey::END, 0},
+      {"Space", ui::VKEY_SPACE, ui::DomCode::SPACE,
+       ui::DomKey::FromCharacter(' '), ' '},
+  };
+  std::string name = call->StrOr("key", "");
+  const Key* key = nullptr;
+  for (const Key& k : kKeys) {
+    if (base::EqualsCaseInsensitiveASCII(name, k.name) ||
+        (name == " " && k.text == ' ')) {
+      key = &k;
+    }
+  }
+  if (!key) {
+    return call->Fail("unknown key; use Enter, Escape, Tab, Backspace, Delete, "
+                      "ArrowUp/Down/Left/Right, PageUp, PageDown, Home, End or "
+                      "Space");
+  }
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  call->capture = tab->GetContents()->IncrementCapturerCount(gfx::Size(), true,
+                                                             true, false);
+  tabs::TabHandle handle = tab->GetHandle();
+  Confirm(std::move(call), std::string("press ") + key->name,
+          base::BindOnce(
+              [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+                 const Key* key, std::unique_ptr<Call> call) {
+                tabs::TabInterface* tab = handle.Get();
+                if (!self || !tab) {
+                  return call->Fail("the tab is gone");
+                }
+                self->Activity(*call, tab);
+                content::RenderWidgetHost* widget =
+                    tab->GetContents()->GetPrimaryMainFrame()
+                        ->GetRenderWidgetHost();
+                if (!widget) {
+                  return call->Fail("the page isn't ready");
+                }
+                SendKey(widget, key->code, key->dom_code, key->dom_key,
+                        key->text);
+                call->Ok(base::Value(base::DictValue().Set("pressed",
+                                                           key->name)));
+              },
+              weak_factory_.GetWeakPtr(), handle, key));
+}
+
+void AgentService::Scroll(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  std::string expr;
+  std::string summary;
+  if (call->input.Find("selector") || call->input.Find("element_index")) {
+    base::DictValue spec;
+    for (const char* key : {"element_index", "selector"}) {
+      if (const base::Value* v = call->input.Find(key)) {
+        spec.Set(key, v->Clone());
+      }
+    }
+    expr = "__meridianAgent.scrollTo(" + base::WriteJson(spec).value_or("{}") +
+           ")";
+    summary = "scroll to an element";
+  } else {
+    std::string direction = call->StrOr("direction", "down");
+    double screens = call->input.FindDouble("screens").value_or(1);
+    expr = base::StringPrintf(
+        "__meridianAgent.scroll(%s, %f)",
+        base::WriteJson(base::Value(direction)).value().c_str(), screens);
+    summary = "scroll " + direction;
+  }
+  tabs::TabHandle handle = tab->GetHandle();
+  Confirm(std::move(call), summary,
+          base::BindOnce(
+              [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+                 std::string expr, std::unique_ptr<Call> call) {
+                tabs::TabInterface* tab = handle.Get();
+                if (!self || !tab) {
+                  return call->Fail("the tab is gone");
+                }
+                self->Activity(*call, tab);
+                self->RunInPage(tab->GetContents(), expr,
+                                base::BindOnce(
+                                    [](std::unique_ptr<Call> call,
+                                       base::Value result) {
+                                      call->Ok(std::move(result));
+                                    },
+                                    std::move(call)));
+              },
+              weak_factory_.GetWeakPtr(), handle, expr));
+}
+
+void AgentService::WaitFor(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  Activity(*call, tab);
+  int timeout =
+      std::clamp(call->input.FindInt("timeout_ms").value_or(10000), 100, 30000);
+  std::string expr = base::StringPrintf(
+      "__meridianAgent.has(%s, %s)",
+      base::WriteJson(base::Value(call->StrOr("text", ""))).value().c_str(),
+      base::WriteJson(base::Value(call->StrOr("selector", ""))).value().c_str());
+  base::TimeTicks deadline = base::TimeTicks::Now() + base::Milliseconds(timeout);
+  struct Poll {
+    static void Step(base::WeakPtr<AgentService> self,
+                     base::WeakPtr<content::WebContents> contents,
+                     std::string expr, base::TimeTicks deadline,
+                     std::unique_ptr<Call> call) {
+      if (!self || !contents) {
+        return call->Fail("the tab is gone");
+      }
+      self->RunInPage(
+          contents.get(), expr,
+          base::BindOnce(
+              [](base::WeakPtr<AgentService> self,
+                 base::WeakPtr<content::WebContents> contents,
+                 std::string expr, base::TimeTicks deadline,
+                 std::unique_ptr<Call> call, base::Value found) {
+                if (found.is_string()) {
+                  return call->Fail("invalid selector");
+                }
+                if (found.is_bool() && found.GetBool()) {
+                  return call->Ok(
+                      base::Value(base::DictValue().Set("found", true)));
+                }
+                if (base::TimeTicks::Now() >= deadline) {
+                  return call->Ok(
+                      base::Value(base::DictValue().Set("found", false)));
+                }
+                base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+                    FROM_HERE,
+                    base::BindOnce(&Poll::Step, self, contents, expr, deadline,
+                                   std::move(call)),
+                    base::Milliseconds(250));
+              },
+              self, contents, expr, deadline, std::move(call)));
+    }
+  };
+  Poll::Step(weak_factory_.GetWeakPtr(), tab->GetContents()->GetWeakPtr(), expr,
+             deadline, std::move(call));
+}
+
+void AgentService::OrganizeTab(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  std::string action = call->StrOr("action", "");
+  std::string summary = action + " a tab";
+  base::ReplaceChars(summary, "_", " ", &summary);
+  tabs::TabHandle handle = tab->GetHandle();
+  Confirm(
+      std::move(call), summary,
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+             std::string action, std::unique_ptr<Call> call) {
+            tabs::TabInterface* tab = handle.Get();
+            SidebarHandler* handler =
+                self ? SidebarHandler::For(self->Window()) : nullptr;
+            if (!tab || !handler) {
+              return call->Fail("the tab is gone");
+            }
+            self->Activity(*call, tab);
+            SidebarService* service =
+                SidebarServiceFactory::GetForProfile(self->profile_);
+            const TabData* data = TabData::Get(tab->GetContents());
+            std::string item = data ? data->item_id() : std::string();
+            tabs_api::NodeId node =
+                tabs_api::NodeId::FromTabHandle(tab->GetHandle());
+            if (action == "pin" || action == "favorite") {
+              auto position = mojom::ItemPosition::New();
+              position->container =
+                  action == "favorite" ? kFavorites : service->active_space_id();
+              position->index = -1;
+              handler->PinTab(node, std::move(position));
+            } else if (action == "unpin") {
+              if (item.empty()) {
+                return call->Fail("that tab isn't pinned");
+              }
+              handler->RemoveItem(item);
+            } else if (action == "rename") {
+              if (item.empty()) {
+                return call->Fail("only pinned tabs and favorites have a name");
+              }
+              handler->RenameItem(item, call->StrOr("title", ""));
+            } else if (action == "move_to_space") {
+              const std::string* space = call->Str("space_id");
+              if (!space || !service->FindSpace(*space)) {
+                return call->Fail("unknown space_id");
+              }
+              handler->MoveTabToSpace(node, *space);
+            }
+            call->Ok(base::Value(base::DictValue().Set("done", action)));
+          },
+          weak_factory_.GetWeakPtr(), handle, action));
+}
+
+void AgentService::SplitView(std::unique_ptr<Call> call) {
+  Call& c = *call;
+  auto tab_by_id = [&](const char* key) -> tabs::TabInterface* {
+    base::DictValue saved = c.input.Clone();
+    c.input.Set("tab_id", c.StrOr(key, ""));
+    tabs::TabInterface* tab = TabFor(c);
+    c.input = std::move(saved);
+    return tab;
+  };
+  tabs::TabInterface* left = tab_by_id("left_tab_id");
+  tabs::TabInterface* right = tab_by_id("right_tab_id");
+  if (!left || !right || left == right) {
+    return call->Fail("give two different tab ids from list_tabs");
+  }
+  tabs::TabHandle l = left->GetHandle(), r = right->GetHandle();
+  Confirm(std::move(call), "show two tabs in split view",
+          base::BindOnce(
+              [](base::WeakPtr<AgentService> self, tabs::TabHandle l,
+                 tabs::TabHandle r, std::unique_ptr<Call> call) {
+                BrowserWindowInterface* window = self ? self->Window() : nullptr;
+                SidebarHandler* handler =
+                    window ? SidebarHandler::For(window) : nullptr;
+                if (!handler || !l.Get() || !r.Get()) {
+                  return call->Fail("the tabs are gone");
+                }
+                window->GetTabStripModel()->ActivateTab(l.Get());
+                handler->SplitWith(tabs_api::NodeId::FromTabHandle(r));
+                self->Activity(*call, l.Get());
+                call->Ok(base::Value(base::DictValue().Set("split", true)));
+              },
+              weak_factory_.GetWeakPtr(), l, r));
+}
+
+void AgentService::CreateSpace(std::unique_ptr<Call> call) {
+  std::string name = call->StrOr("name", "Space").substr(0, 40);
+  Confirm(std::move(call), "create a space “" + name + "”",
+          base::BindOnce(
+              [](base::WeakPtr<AgentService> self, std::string name,
+                 std::unique_ptr<Call> call) {
+                if (!self) {
+                  return;
+                }
+                std::string id =
+                    SidebarServiceFactory::GetForProfile(self->profile_)
+                        ->CreateSpace(name, call->StrOr("icon", ""), "#8a8fe0",
+                                      "#8a8fe0");
+                call->Ok(base::Value(base::DictValue().Set("space_id", id)));
+              },
+              weak_factory_.GetWeakPtr(), name));
+}
+
+void AgentService::RunJavaScript(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  std::string code = call->StrOr("code", "");
+  std::string summary = "run JavaScript on " +
+                        HostOf(tab->GetContents()->GetLastCommittedURL()) +
+                        "\nFull code (" + base::NumberToString(code.size()) +
+                        " characters):\n\n" + code;
+  tabs::TabHandle handle = tab->GetHandle();
+  Confirm(
+      std::move(call), summary,
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+             std::string code, std::unique_ptr<Call> call) {
+            tabs::TabInterface* tab = handle.Get();
+            if (!self || !tab) {
+              return call->Fail("the tab is gone");
+            }
+            self->Activity(*call, tab);
+            // A function body (with return) or an expression; the result,
+            // awaited, lands in window.__meridianJs for polling.
+            bool body = code.find("return") != std::string::npos;
+            std::string js =
+                "(window.__meridianJs = {done: false}, Promise.resolve().then("
+                "async () => " +
+                (body ? "{\n" + code + "\n}" : "(" + code + ")") +
+                ").then(v => { let out; try { out = JSON.parse(JSON.stringify("
+                "v === undefined ? null : v)); } catch { out = String(v); } "
+                "window.__meridianJs = {done: true, value: out}; }, e => { "
+                "window.__meridianJs = {done: true, error: String(e && "
+                "e.message || e)}; }), true)";
+            content::WebContents* contents = tab->GetContents();
+            base::TimeTicks deadline =
+                base::TimeTicks::Now() + base::Seconds(30);
+            struct Poll {
+              static void Step(base::WeakPtr<AgentService> self,
+                               base::WeakPtr<content::WebContents> contents,
+                               base::TimeTicks deadline,
+                               std::unique_ptr<Call> call) {
+                if (!self || !contents) {
+                  return call->Fail("the tab is gone");
+                }
+                self->RunInPage(
+                    contents.get(), "window.__meridianJs",
+                    base::BindOnce(
+                        [](base::WeakPtr<AgentService> self,
+                           base::WeakPtr<content::WebContents> contents,
+                           base::TimeTicks deadline,
+                           std::unique_ptr<Call> call, base::Value state) {
+                          const base::DictValue* s = state.GetIfDict();
+                          if (s && s->FindBool("done").value_or(false)) {
+                            if (const std::string* e = s->FindString("error")) {
+                              return call->Fail(*e);
+                            }
+                            const base::Value* v = s->Find("value");
+                            return call->Ok(v ? v->Clone() : base::Value());
+                          }
+                          if (base::TimeTicks::Now() >= deadline) {
+                            return call->Fail("timed out after 30 s");
+                          }
+                          base::SequencedTaskRunner::GetCurrentDefault()
+                              ->PostDelayedTask(
+                                  FROM_HERE,
+                                  base::BindOnce(&Poll::Step, self, contents,
+                                                 deadline, std::move(call)),
+                                  base::Milliseconds(100));
+                        },
+                        self, contents, deadline, std::move(call)));
+              }
+            };
+            self->RunInPage(
+                contents, js,
+                base::BindOnce(
+                    [](base::WeakPtr<AgentService> self,
+                       base::WeakPtr<content::WebContents> contents,
+                       base::TimeTicks deadline, std::unique_ptr<Call> call,
+                       base::Value) {
+                      Poll::Step(self, contents, deadline, std::move(call));
+                    },
+                    self, contents->GetWeakPtr(), deadline, std::move(call)));
+          },
+          weak_factory_.GetWeakPtr(), handle, code));
+}
+
+}  // namespace meridian
