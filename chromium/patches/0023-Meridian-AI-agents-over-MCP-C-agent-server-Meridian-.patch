+void AgentService::OpenTab(std::unique_ptr<Call> call) {
+  GURL url = ToUrl(profile_, call->StrOr("url", ""));
+  if (!url.is_valid()) {
+    return call->Fail("not a URL");
+  }
+  std::string summary = "open " + url.spec();
+  Confirm(
+      std::move(call), summary,
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, GURL url,
+             std::unique_ptr<Call> call) {
+            if (!self) {
+              return;
+            }
+            BrowserWindowInterface* window = self->Window();
+            SidebarService* service =
+                SidebarServiceFactory::GetForProfile(self->profile_);
+            const std::string* space = call->Str("space_id");
+            if (space && service->FindSpace(*space)) {
+              service->SetActiveSpace(*space);
+            }
+            bool activate = call->input.FindBool("activate").value_or(false);
+            NavigateParams params(window, url, ui::PAGE_TRANSITION_LINK);
+            params.disposition =
+                activate ? WindowOpenDisposition::kNewForegroundTab
+                         : WindowOpenDisposition::kNewBackgroundTab;
+            ::Navigate(&params);
+            content::WebContents* contents =
+                params.navigated_or_inserted_contents;
+            if (!contents) {
+              return call->Fail("couldn't open the tab");
+            }
+            tabs::TabInterface* tab =
+                tabs::TabInterface::GetFromContents(contents);
+            if (space && service->FindSpace(*space)) {
+              TabData::Set(contents, *space, std::string());
+            }
+            self->Activity(*call, tab);
+            std::string id = TabId(tab);
+            LoadWaiter::Wait(
+                contents,
+                base::BindOnce(
+                    [](std::unique_ptr<Call> call, std::string id,
+                       base::WeakPtr<content::WebContents> contents) {
+                      call->Ok(base::Value(
+                          base::DictValue()
+                              .Set("tab_id", id)
+                              .Set("url",
+                                   contents
+                                       ? contents->GetLastCommittedURL().spec()
+                                       : std::string())
+                              .Set("title",
+                                   contents ? base::UTF16ToUTF8(
+                                                  contents->GetTitle())
+                                            : std::string())));
+                    },
+                    std::move(call), id, contents->GetWeakPtr()));
+          },
+          weak_factory_.GetWeakPtr(), url));
+}
+
+void AgentService::Navigate(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  GURL url = ToUrl(profile_, call->StrOr("url", ""));
+  if (!url.is_valid()) {
+    return call->Fail("not a URL");
+  }
+  tabs::TabHandle handle = tab->GetHandle();
+  Confirm(std::move(call), "load " + url.spec(),
+          base::BindOnce(
+              [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+                 GURL url, std::unique_ptr<Call> call) {
+                tabs::TabInterface* tab = handle.Get();
+                if (!self || !tab) {
+                  return call->Fail("the tab is gone");
+                }
+                self->Activity(*call, tab);
+                content::WebContents* contents = tab->GetContents();
+                contents->GetController().LoadURL(
+                    url, content::Referrer(), ui::PAGE_TRANSITION_TYPED,
+                    std::string());
+                LoadWaiter::Wait(
+                    contents,
+                    base::BindOnce(
+                        [](std::unique_ptr<Call> call,
+                           base::WeakPtr<content::WebContents> contents) {
+                          if (!contents) {
+                            return call->Fail("the tab is gone");
+                          }
+                          call->Ok(base::Value(
+                              base::DictValue()
+                                  .Set("url",
+                                       contents->GetLastCommittedURL().spec())
+                                  .Set("title", base::UTF16ToUTF8(
+                                                    contents->GetTitle()))));
+                        },
+                        std::move(call), contents->GetWeakPtr()));
+              },
+              weak_factory_.GetWeakPtr(), handle, url));
+}
+
+void AgentService::HistoryNav(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  std::string action = call->StrOr("action", "");
+  tabs::TabHandle handle = tab->GetHandle();
+  Confirm(std::move(call), action == "reload" ? "reload" : "go " + action,
+          base::BindOnce(
+              [](base::WeakPtr<AgentService> self, tabs::TabHandle handle,
+                 std::string action, std::unique_ptr<Call> call) {
+                tabs::TabInterface* tab = handle.Get();
+                if (!self || !tab) {
+                  return call->Fail("the tab is gone");
+                }
+                self->Activity(*call, tab);
+                content::NavigationController& nav =
+                    tab->GetContents()->GetController();
+                if (action == "back" && nav.CanGoBack()) {
+                  nav.GoBack();
+                } else if (action == "forward" && nav.CanGoForward()) {
+                  nav.GoForward();
+                } else if (action == "reload") {
+                  nav.Reload(content::ReloadType::NORMAL, false);
+                } else {
+                  return call->Fail("can't go " + action);
+                }
+                content::WebContents* contents = tab->GetContents();
+                LoadWaiter::Wait(
+                    contents,
+                    base::BindOnce(
+                        [](std::unique_ptr<Call> call,
+                           base::WeakPtr<content::WebContents> contents) {
+                          call->Ok(base::Value(base::DictValue().Set(
+                              "url", contents ? contents->GetLastCommittedURL()
+                                                    .spec()
+                                              : std::string())));
+                        },
+                        std::move(call), contents->GetWeakPtr()));
+              },
+              weak_factory_.GetWeakPtr(), handle, action));
+}
