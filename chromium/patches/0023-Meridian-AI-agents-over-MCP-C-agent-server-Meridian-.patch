@@ -0,0 +1,36 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {MeridianAgentElement} from './agent.js';
+
+export function getHtml(this: MeridianAgentElement) {
+  return html`<!--_html_template_start_-->
+<div id="bar" ?hidden="${!this.working}" role="status">
+  <span class="dot ${this.paused_ ? 'paused' : ''}"></span>
+  ${this.paused_ ? html`
+    <span class="what">Agents are paused</span>
+    <button id="resume" class="btn" @click="${this.onResumeClick_}">
+      Resume</button>` : html`
+    <span class="what"><b>${this.client_}</b> ${this.tool_}${this.host_ ?
+        html` on ${this.host_}` : ''}</span>
+    <button id="stop" class="btn stop" @click="${this.onStopClick_}">
+      Stop</button>`}
+</div>
+${this.question_ ? html`
+  <div id="ask" role="dialog" aria-modal="true">
+    <div class="card" @keydown="${this.onCardKeydown_}">
+      <h3><b>${this.question_.client}</b> wants to</h3>
+      <pre class="summary">${this.question_.summary}</pre>
+      <div class="actions">
+        <button id="deny" class="btn" @click="${this.onDenyClick_}">Deny
+        </button>
+        <button id="allow" class="btn primary" @click="${this.onAllowClick_}">
+          Allow</button>
+      </div>
+    </div>
+  </div>` : ''}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/agent.ts b/chrome/browser/resources/webui_browser/meridian/agent.ts
new file mode 100644
index 0000000000..ef51cd1cf8
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/agent.ts
@@ -0,0 +1,161 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Agents in the window: a bar naming the agent and what it's doing, with
+// Stop (agents pause until Resume), and, at access level "ask", the
+// question for each action.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {AgentActivity, SidebarHandlerInterface} from '../sidebar.mojom-webui.js';
+
+import {getCss} from './agent.css.js';
+import {getHtml} from './agent.html.js';
+
+interface Question {
+  client: string;
+  summary: string;
+  answer: (allowed: boolean) => void;
+}
+
+// The bar stays this long after the last action.
+const SHOW_MS = 4000;
+
+export class MeridianAgentElement extends CrLitElement {
+  static get is() {
+    return 'meridian-agent';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      working: {type: Boolean, reflect: true},
+      paused_: {state: true, type: Boolean},
+      client_: {state: true, type: String},
+      host_: {state: true, type: String},
+      tool_: {state: true, type: String},
+      question_: {state: true, type: Object},
+    };
+  }
+
+  // An agent acted a moment ago (the bar shows).
+  accessor working: boolean = false;
+  protected accessor paused_: boolean = false;
+  protected accessor client_: string = '';
+  protected accessor host_: string = '';
+  protected accessor tool_: string = '';
+  protected accessor question_: Question|null = null;
+
+  private readonly handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  private listeners_: number[] = [];
+  private queue_: Question[] = [];
+  private hideTimer_: number|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    const router = browserProxyFactory.getInstance().callbackRouter;
+    this.listeners_ = [
+      router.onAgentActivity.addListener(
+          (activity: AgentActivity) => this.onActivity_(activity)),
+      router.askAgent.addListener(
+          (client: string, summary: string) =>
+              new Promise<{allowed: boolean}>(resolve => {
+                this.queue_.push({
+                  client,
+                  summary,
+                  answer: (allowed: boolean) => resolve({allowed}),
+                });
+                this.next_();
+              })),
+    ];
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    const router = browserProxyFactory.getInstance().callbackRouter;
+    this.listeners_.forEach(id => router.removeListener(id));
+    this.listeners_ = [];
+  }
+
+  private onActivity_(activity: AgentActivity) {
+    this.paused_ = activity.paused;
+    if (activity.client) {
+      this.client_ = activity.client;
+      this.host_ = activity.host;
+      this.tool_ = activity.tool.replace(/_/g, ' ');
+      this.fire('meridian-agent-tab', activity.tabId);
+    }
+    this.working = this.paused_ || !!activity.client;
+    if (this.hideTimer_ !== null) {
+      clearTimeout(this.hideTimer_);
+    }
+    if (!this.paused_) {
+      this.hideTimer_ = setTimeout(() => {
+        this.working = this.paused_;
+        this.fire('meridian-agent-tab', '');
+      }, SHOW_MS);
+    }
+  }
+
+  private next_() {
+    if (!this.question_) {
+      this.question_ = this.queue_.shift() || null;
+      if (this.question_) {
+        this.updateComplete.then(
+            () => this.shadowRoot.querySelector<HTMLElement>('#allow')?.focus());
+      }
+    }
+  }
+
+  private answer_(allowed: boolean) {
+    const q = this.question_;
+    this.question_ = null;
+    q?.answer(allowed);
+    this.next_();
+  }
+
+  protected onStopClick_() {
+    // Pending questions are denied too.
+    this.handler_.setAgentsPaused(true);
+    while (this.question_) {
+      this.answer_(false);
+    }
+  }
+
+  protected onResumeClick_() {
+    this.handler_.setAgentsPaused(false);
+  }
+
+  protected onAllowClick_() {
+    this.answer_(true);
+  }
+
+  protected onDenyClick_() {
+    this.answer_(false);
+  }
+
+  protected onCardKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.answer_(false);
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-agent': MeridianAgentElement;
+  }
+}
+
+customElements.define(MeridianAgentElement.is, MeridianAgentElement);
