+void AgentService::Handle(base::DictValue request, Reply reply) {
+  auto call = std::make_unique<Call>();
+  call->reply = std::move(reply);
+  const std::string* tool = request.FindString("tool");
+  call->tool = tool ? *tool : std::string();
+  const std::string* client = request.FindString("client");
+  call->client = client ? client->substr(0, 60) : "agent";
+  if (base::DictValue* input = request.FindDict("input")) {
+    call->input = std::move(*input);
+  }
+  const base::DictValue* def = nullptr;
+  for (const base::Value& t : Tools()) {
+    if (*t.GetDict().FindString("name") == call->tool) {
+      def = &t.GetDict();
+    }
+  }
+  if (!def) {
+    return call->Fail("unknown tool: " + call->tool);
+  }
+  std::string access = profile_->GetPrefs()->GetString(prefs::kAgentAccess);
+  const std::string& needs = *def->FindString("access");
+  if (Rank(access) == 0) {
+    return call->Fail(
+        "Agent access is off. Open Meridian > Settings > AI to choose an "
+        "access level.");
+  }
+  if (paused_) {
+    return call->Fail(
+        "The person stopped the agents in Meridian. Ask them to press Resume.");
+  }
+  if ((needs == "write" || needs == "js") && Rank(access) < kAsk) {
+    return call->Fail(
+        "Meridian's agent access is read-only; this tool changes things. The "
+        "person can allow it in Settings > AI.");
+  }
+  if (needs == "js" &&
+      !profile_->GetPrefs()->GetBoolean(prefs::kAgentAllowJs)) {
+    return call->Fail(
+        "Running JavaScript is off. The person can allow it in Settings > AI.");
+  }
+  std::string invalid = Validate(*def, call->input);
+  if (!invalid.empty()) {
+    return call->Fail(invalid);
+  }
+  Run(std::move(call));
+}
+
+void AgentService::Run(std::unique_ptr<Call> call) {
+  using Method = void (AgentService::*)(std::unique_ptr<Call>);
+  static const base::NoDestructor<std::map<std::string, Method>> methods({
+      {"list_spaces", &AgentService::ListSpaces},
+      {"list_tabs", &AgentService::ListTabs},
+      {"search_tabs", &AgentService::SearchTabs},
+      {"search_history", &AgentService::SearchHistory},
+      {"read_page", &AgentService::ReadPage},
+      {"get_interactive_elements", &AgentService::Elements},
+      {"screenshot", &AgentService::Screenshot},
+      {"open_tab", &AgentService::OpenTab},
+      {"navigate", &AgentService::Navigate},
+      {"history_nav", &AgentService::HistoryNav},
+      {"activate_tab", &AgentService::ActivateTab},
+      {"close_tab", &AgentService::CloseTab},
+      {"click", &AgentService::Click},
+      {"type_text", &AgentService::TypeText},
+      {"press_key", &AgentService::PressKey},
+      {"scroll", &AgentService::Scroll},
+      {"wait_for", &AgentService::WaitFor},
+      {"organize_tab", &AgentService::OrganizeTab},
+      {"split_view", &AgentService::SplitView},
+      {"create_space", &AgentService::CreateSpace},
+      {"run_javascript", &AgentService::RunJavaScript},
+  });
+  auto it = methods->find(call->tool);
+  if (it == methods->end()) {
+    return call->Fail("not available in this Meridian: " + call->tool);
+  }
+  (this->*(it->second))(std::move(call));
+}
+
+tabs::TabInterface* AgentService::TabFor(const Call& call) {
+  BrowserWindowInterface* window = Window();
+  if (!window) {
+    return nullptr;
+  }
+  TabStripModel* model = window->GetTabStripModel();
+  auto in_window = [&](tabs::TabInterface* tab) {
+    return tab && model->GetIndexOfTab(tab) != TabStripModel::kNoTab ? tab
+                                                                     : nullptr;
+  };
+  if (const std::string* id = call.Str("tab_id")) {
+    if (id->starts_with("item:")) {
+      // A pinned tab or favorite that isn't open: open it.
+      std::string item = id->substr(5);
+      for (int i = 0; i < model->count(); ++i) {
+        const TabData* data = TabData::Get(model->GetWebContentsAt(i));
+        if (data && data->item_id() == item) {
+          return model->GetTabAtIndex(i);
+        }
+      }
+      if (SidebarHandler* handler = SidebarHandler::For(window)) {
+        handler->OpenItem(item);
+        return model->GetActiveTab();
+      }
+      return nullptr;
+    }
+    int raw = 0;
+    if (!base::StringToInt(*id, &raw)) {
+      return nullptr;
+    }
+    return in_window(tabs::TabHandle(raw).Get());
+  }
+  auto current = current_tab_.find(call.client);
+  if (current != current_tab_.end()) {
+    if (tabs::TabInterface* tab = in_window(current->second.Get())) {
+      return tab;
+    }
+  }
+  return model->GetActiveTab();
+}
+
+void AgentService::Activity(const Call& call, tabs::TabInterface* tab) {
+  if (tab) {
+    current_tab_[call.client] = tab->GetHandle();
+  }
+  if (BrowserWindowInterface* window = Window()) {
+    SidebarHandler::AgentActivity(
+        window, call.client, call.tool, tab ? TabId(tab) : std::string(),
+        tab ? HostOf(tab->GetContents()->GetLastCommittedURL()) : std::string(),
+        paused_);
+  }
+}
+
+void AgentService::Confirm(
+    std::unique_ptr<Call> call,
+    std::string summary,
+    base::OnceCallback<void(std::unique_ptr<Call>)> then) {
+  if (profile_->GetPrefs()->GetString(prefs::kAgentAccess) != "ask") {
+    std::move(then).Run(std::move(call));
+    return;
+  }
+  BrowserWindowInterface* window = Window();
+  std::string client = call->client;
+  if (!window) {
+    return call->Fail("Meridian has no window to ask the person in.");
+  }
+  SidebarHandler::AskAgent(
+      window, client, summary,
+      base::BindOnce(
+          [](std::unique_ptr<Call> call,
+             base::OnceCallback<void(std::unique_ptr<Call>)> then,
+             bool allowed) {
+            if (!allowed) {
+              return call->Fail("The person declined this action.");
+            }
+            std::move(then).Run(std::move(call));
+          },
+          std::move(call), std::move(then)));
+}
