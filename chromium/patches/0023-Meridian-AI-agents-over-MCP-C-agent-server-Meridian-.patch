+
+// static
+void SidebarHandler::AgentActivity(BrowserWindowInterface* browser,
+                                   const std::string& client,
+                                   const std::string& tool,
+                                   const std::string& tab_id,
+                                   const std::string& host,
+                                   bool paused) {
+  SidebarHandler* handler = For(browser);
+  if (!handler || !handler->page_.is_connected()) {
+    return;
