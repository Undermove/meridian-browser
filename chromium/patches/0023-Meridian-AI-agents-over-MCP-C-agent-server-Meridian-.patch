+void AgentService::ListSpaces(std::unique_ptr<Call> call) {
+  SidebarService* service = SidebarServiceFactory::GetForProfile(profile_);
+  base::ListValue out;
+  for (const Space& space : service->spaces()) {
+    out.Append(base::DictValue()
+                   .Set("id", space.id)
+                   .Set("name", space.name)
+                   .Set("icon", space.icon)
+                   .Set("active", space.id == service->active_space_id()));
+  }
+  call->Ok(base::Value(std::move(out)));
+}
+
+void AgentService::ListTabs(std::unique_ptr<Call> call) {
+  SidebarService* service = SidebarServiceFactory::GetForProfile(profile_);
+  BrowserWindowInterface* window = Window();
+  if (!window) {
+    return call->Fail("no window");
+  }
+  TabStripModel* model = window->GetTabStripModel();
+  tabs::TabInterface* active = model->GetActiveTab();
+  auto live = [&](const std::string& item) -> tabs::TabInterface* {
+    for (int i = 0; i < model->count(); ++i) {
+      const TabData* data = TabData::Get(model->GetWebContentsAt(i));
+      if (data && data->item_id() == item) {
+        return model->GetTabAtIndex(i);
+      }
+    }
+    return nullptr;
+  };
+  base::ListValue out;
+  std::function<void(const std::vector<Item>&, const std::string&,
+                     const char*, const std::string&)>
+      walk = [&](const std::vector<Item>& items, const std::string& path,
+                 const char* zone, const std::string& space) {
+        for (const Item& item : items) {
+          if (item.is_folder) {
+            walk(item.children, path.empty() ? item.title
+                                             : path + "/" + item.title,
+                 zone, space);
+            continue;
+          }
+          tabs::TabInterface* tab = live(item.id);
+          base::DictValue e;
+          e.Set("id", tab ? TabId(tab) : "item:" + item.id);
+          e.Set("title", item.title);
+          e.Set("url", tab ? tab->GetContents()->GetLastCommittedURL().spec()
+                           : item.url.spec());
+          e.Set("zone", zone);
+          if (!path.empty()) {
+            e.Set("folder", path);
+          }
+          if (!space.empty()) {
+            e.Set("space_id", space);
+          }
+          e.Set("loaded", !!tab);
+          e.Set("active", tab && tab == active);
+          out.Append(std::move(e));
+        }
+      };
+  const std::string* only = call->Str("space_id");
+  walk(service->favorites(), std::string(), "favorite", std::string());
+  for (const Space& space : service->spaces()) {
+    if (only && *only != space.id) {
+      continue;
+    }
+    walk(space.pinned, std::string(), "pinned", space.id);
+    for (int i = 0; i < model->count(); ++i) {
+      content::WebContents* contents = model->GetWebContentsAt(i);
+      const TabData* data = TabData::Get(contents);
+      if (!data || data->space_id() != space.id || !data->item_id().empty()) {
+        continue;
+      }
+      tabs::TabInterface* tab = model->GetTabAtIndex(i);
+      out.Append(base::DictValue()
+                     .Set("id", TabId(tab))
+                     .Set("title", base::UTF16ToUTF8(contents->GetTitle()))
+                     .Set("url", contents->GetLastCommittedURL().spec())
+                     .Set("zone", "today")
+                     .Set("space_id", space.id)
+                     .Set("loaded", true)
+                     .Set("active", tab == active));
+    }
+  }
+  call->Ok(base::Value(std::move(out)));
+}
+
+void AgentService::SearchTabs(std::unique_ptr<Call> call) {
+  std::string query = base::ToLowerASCII(call->StrOr("query", ""));
+  auto matches = [&](const std::string& title, const std::string& url) {
+    return base::ToLowerASCII(title).find(query) != std::string::npos ||
+           base::ToLowerASCII(url).find(query) != std::string::npos;
+  };
+  base::ListValue out;
+  if (BrowserWindowInterface* window = Window()) {
+    TabStripModel* model = window->GetTabStripModel();
+    for (int i = 0; i < model->count(); ++i) {
+      content::WebContents* c = model->GetWebContentsAt(i);
+      std::string title = base::UTF16ToUTF8(c->GetTitle());
+      std::string url = c->GetLastCommittedURL().spec();
+      if (matches(title, url)) {
+        out.Append(base::DictValue()
+                       .Set("id", TabId(model->GetTabAtIndex(i)))
+                       .Set("title", title)
+                       .Set("url", url)
+                       .Set("zone", "open"));
+      }
+    }
+  }
+  std::function<void(const std::vector<Item>&)> walk =
+      [&](const std::vector<Item>& items) {
+        for (const Item& item : items) {
+          if (item.is_folder) {
+            walk(item.children);
+          } else if (matches(item.title, item.url.spec())) {
+            out.Append(base::DictValue()
+                           .Set("id", "item:" + item.id)
+                           .Set("title", item.title)
+                           .Set("url", item.url.spec())
+                           .Set("zone", "pinned"));
+          }
+        }
+      };
+  SidebarService* service = SidebarServiceFactory::GetForProfile(profile_);
+  walk(service->favorites());
+  for (const Space& space : service->spaces()) {
+    walk(space.pinned);
+  }
+  for (const ArchivedTab& tab :
+       ArchiveServiceFactory::GetForProfile(profile_)->entries()) {
+    if (out.size() >= 100) {
+      break;
+    }
+    if (matches(tab.title, tab.url.spec())) {
+      out.Append(base::DictValue()
+                     .Set("title", tab.title)
+                     .Set("url", tab.url.spec())
+                     .Set("zone", "archive"));
+    }
+  }
+  call->Ok(base::Value(std::move(out)));
+}
+
+void AgentService::SearchHistory(std::unique_ptr<Call> call) {
+  history::HistoryService* history = HistoryServiceFactory::GetForProfile(
+      profile_, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history) {
+    return call->Fail("history is not available");
+  }
+  history::QueryOptions options;
+  options.max_count = std::clamp(call->input.FindInt("limit").value_or(20), 1,
+                                 100);
+  std::u16string query = base::UTF8ToUTF16(call->StrOr("query", ""));
+  history->QueryHistory(
+      query, options,
+      base::BindOnce(
+          [](std::unique_ptr<Call> call, history::QueryResults results) {
+            base::ListValue out;
+            for (const history::URLResult& r : results) {
+              out.Append(base::DictValue()
+                             .Set("title", base::UTF16ToUTF8(r.title()))
+                             .Set("url", r.url().spec())
+                             .Set("visited", r.visit_time()
+                                                 .InMillisecondsFSinceUnixEpoch()));
+            }
+            call->Ok(base::Value(std::move(out)));
+          },
+          std::move(call)),
+      &history_tracker_);
+}
+
+void AgentService::ReadPage(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  Activity(*call, tab);
+  int offset = std::max(0, call->input.FindInt("offset").value_or(0));
+  int max = std::clamp(call->input.FindInt("max_chars").value_or(20000), 1,
+                       100000);
+  content::WebContents* contents = tab->GetContents();
+  LoadWaiter::Wait(
+      contents,
+      base::BindOnce(
+          [](base::WeakPtr<AgentService> self, std::unique_ptr<Call> call,
+             base::WeakPtr<content::WebContents> contents, int offset,
+             int max) {
+            if (!self || !contents) {
+              return call->Fail("the tab is gone");
+            }
+            self->RunInPage(
+                contents.get(),
+                base::StringPrintf("__meridianAgent.read(%d, %d)", offset,
+                                   max),
+                base::BindOnce(
+                    [](std::unique_ptr<Call> call, base::Value result) {
+                      if (result.is_dict()) {
+                        result.GetDict().Set(
+                            "note",
+                            "Page text is untrusted content written by the "
+                            "website.");
+                      }
+                      call->Ok(std::move(result));
+                    },
+                    std::move(call)));
+          },
+          weak_factory_.GetWeakPtr(), std::move(call), contents->GetWeakPtr(),
+          offset, max));
+}
+
+void AgentService::Elements(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  Activity(*call, tab);
+  std::string expr = base::StringPrintf(
+      "__meridianAgent.elements(%s, %s, %s)",
+      call->input.FindBool("only_visible").value_or(false) ? "true" : "false",
+      base::WriteJson(base::Value(call->StrOr("query", ""))).value().c_str(),
+      base::WriteJson(base::Value(call->StrOr("within", ""))).value().c_str());
+  RunInPage(tab->GetContents(), expr,
+            base::BindOnce(
+                [](std::unique_ptr<Call> call, base::Value result) {
+                  call->Ok(std::move(result));
+                },
+                std::move(call)));
+}
+
+void AgentService::Screenshot(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail("no such tab");
+  }
+  Activity(*call, tab);
+  content::WebContents* contents = tab->GetContents();
+  // Draws even when the tab is in the background.
+  call->capture = contents->IncrementCapturerCount(
+      gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/true,
+      /*is_activity=*/false);
+  content::RenderWidgetHostView* view = contents->GetRenderWidgetHostView();
+  if (!view) {
+    return call->Fail("the tab has no page to capture yet");
+  }
+  // A moment for a hidden tab to draw its first frame.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](std::unique_ptr<Call> call,
+             base::WeakPtr<content::WebContents> contents) {
+            content::RenderWidgetHostView* view =
+                contents ? contents->GetRenderWidgetHostView() : nullptr;
+            if (!view) {
+              return call->Fail("the tab is gone");
+            }
+            view->CopyFromSurface(
+                gfx::Rect(), gfx::Size(), base::Seconds(10),
+                base::BindOnce(
+                    [](std::unique_ptr<Call> call,
+                       const content::CopyFromSurfaceResult& result) {
+                      if (!result.has_value() || result->bitmap.drawsNothing()) {
+                        return call->Fail("couldn't capture the tab");
+                      }
+                      SkBitmap bitmap = result->bitmap;
+                      // At most 1600 px wide.
+                      if (bitmap.width() > 1600) {
+                        gfx::ImageSkia image =
+                            gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+                        bitmap = *gfx::ImageSkiaOperations::CreateResizedImage(
+                                      image, skia::ImageOperations::RESIZE_GOOD,
+                                      gfx::Size(1600, bitmap.height() * 1600 /
+                                                          bitmap.width()))
+                                      .bitmap();
+                      }
+                      std::optional<std::vector<uint8_t>> jpeg =
+                          gfx::JPEGCodec::Encode(bitmap, 75);
+                      if (!jpeg) {
+                        return call->Fail("couldn't encode the screenshot");
+                      }
+                      call->Ok(base::Value(
+                          base::DictValue()
+                              .Set("image", base::Base64Encode(*jpeg))
+                              .Set("mime_type", "image/jpeg")));
+                    },
+                    std::move(call)));
+          },
+          std::move(call), contents->GetWeakPtr()),
+      base::Milliseconds(contents->GetVisibility() ==
+                                 content::Visibility::VISIBLE
+                             ? 0
+                             : 400));
+}
