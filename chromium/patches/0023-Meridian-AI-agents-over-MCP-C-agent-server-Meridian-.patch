+++ b/chrome/browser/meridian/agent/agent_server.cc
@@ -0,0 +1,324 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/agent/agent_server.h"
+
+#include <unistd.h>
+
+#include <map>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "crypto/secure_util.h"
+#include "net/base/io_buffer.h"
+#include "net/base/net_errors.h"
+#include "net/socket/stream_socket.h"
+#include "net/socket/unix_domain_server_socket_posix.h"
+
+namespace meridian {
+
+namespace {
+
+constexpr size_t kMaxLine = 4 * 1024 * 1024;
+
+bool SameUser(const net::UnixDomainServerSocket::Credentials& credentials) {
+  return credentials.user_id == getuid();
+}
+
+// A short socket path: in the user data folder (private, 0700) if it fits the
+// ~104 byte limit, else in a new private temp folder.
+base::FilePath SocketPath(const base::FilePath& user_data_dir,
+                          base::FilePath* temp_dir) {
+  std::string name =
+      "agent-" + base::HexEncodeLower(base::RandBytesAsVector(4)) + ".sock";
+  base::FilePath in_profile = user_data_dir.AppendASCII(name);
+  if (in_profile.value().size() < 100) {
+    return in_profile;
+  }
+  if (base::CreateNewTempDirectory("meridian-agent", temp_dir)) {
+    base::SetPosixFilePermissions(*temp_dir, 0700);
+    return temp_dir->AppendASCII("agent.sock");
+  }
+  return in_profile;
+}
+
+}  // namespace
+
+// The socket side, on the server thread.
+class AgentServer::Core {
+ public:
+  Core(base::FilePath user_data_dir,
+       scoped_refptr<base::SequencedTaskRunner> ui,
+       Handler handler)
+      : user_data_dir_(std::move(user_data_dir)),
+        ui_(std::move(ui)),
+        handler_(std::move(handler)) {}
+
+  ~Core() {
+    server_.reset();
+    connections_.clear();
+    // Files on a thread that may block (this is the IO thread).
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+        base::BindOnce(
+            [](base::FilePath socket, base::FilePath endpoint,
+               base::FilePath temp_dir) {
+              if (!socket.empty()) {
+                base::DeleteFile(socket);
+              }
+              base::DeleteFile(endpoint);
+              if (!temp_dir.empty()) {
+                base::DeletePathRecursively(temp_dir);
+              }
+            },
+            socket_path_, EndpointPath(user_data_dir_), temp_dir_));
+  }
+
+  // On a thread that may block: picks the socket path, clears a stale one.
+  static std::pair<base::FilePath, base::FilePath> PreparePaths(
+      base::FilePath user_data_dir) {
+    base::FilePath temp_dir;
+    base::FilePath socket = SocketPath(user_data_dir, &temp_dir);
+    base::DeleteFile(socket);
+    return {socket, temp_dir};
+  }
+
+  void Start(std::pair<base::FilePath, base::FilePath> paths) {
+    token_ = base::HexEncodeLower(base::RandBytesAsVector(32));
+    socket_path_ = paths.first;
+    temp_dir_ = paths.second;
+    server_ = std::make_unique<net::UnixDomainServerSocket>(
+        base::BindRepeating(&SameUser), /*use_abstract_namespace=*/false);
+    if (server_->BindAndListen(socket_path_.value(), /*backlog=*/8) !=
+        net::OK) {
+      LOG(ERROR) << "Meridian agent socket failed";
+      server_.reset();
+      return;
+    }
+    base::DictValue endpoint;
+    endpoint.Set("socket", socket_path_.value());
+    endpoint.Set("token", token_);
+    endpoint.Set("pid", static_cast<int>(getpid()));
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(
+            [](base::FilePath socket, base::FilePath path, std::string json) {
+              base::SetPosixFilePermissions(socket, 0600);
+              // Created private, then filled: nobody else reads the token.
+              base::WriteFile(path, "");
+              base::SetPosixFilePermissions(path, 0600);
+              base::WriteFile(path, json);
+            },
+            socket_path_, EndpointPath(user_data_dir_),
+            base::WriteJson(endpoint).value_or("{}")));
+    Accept();
+  }
+
+ private:
+  struct Connection {
+    std::unique_ptr<net::StreamSocket> socket;
+    scoped_refptr<net::IOBuffer> read_buffer;
+    std::string pending;  // bytes read, not yet a whole line
+    std::string out;      // bytes to write
+    bool writing = false;
+  };
+
+  void Accept() {
+    int rv = server_->Accept(
+        &accepted_,
+        base::BindOnce(&Core::OnAccepted, weak_factory_.GetWeakPtr()));
+    if (rv != net::ERR_IO_PENDING) {
+      OnAccepted(rv);
+    }
+  }
+
+  void OnAccepted(int rv) {
+    if (rv == net::OK && accepted_) {
+      int id = next_id_++;
+      Connection& c = connections_[id];
+      c.socket = std::move(accepted_);
+      c.read_buffer = base::MakeRefCounted<net::IOBufferWithSize>(64 * 1024);
+      Read(id);
+    }
+    if (server_) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&Core::Accept, weak_factory_.GetWeakPtr()));
+    }
+  }
+
+  void Read(int id) {
+    auto it = connections_.find(id);
+    if (it == connections_.end()) {
+      return;
+    }
+    Connection& c = it->second;
+    int rv = c.socket->Read(
+        c.read_buffer.get(), c.read_buffer->size(),
+        base::BindOnce(&Core::OnRead, weak_factory_.GetWeakPtr(), id));
+    if (rv != net::ERR_IO_PENDING) {
+      OnRead(id, rv);
+    }
+  }
+
+  void OnRead(int id, int rv) {
+    auto it = connections_.find(id);
+    if (it == connections_.end()) {
+      return;
+    }
+    Connection& c = it->second;
+    if (rv <= 0) {
+      connections_.erase(it);
+      return;
+    }
+    c.pending.append(c.read_buffer->data(), rv);
+    size_t newline;
+    while ((newline = c.pending.find('\n')) != std::string::npos) {
+      std::string line = c.pending.substr(0, newline);
+      c.pending.erase(0, newline + 1);
+      HandleLine(id, line);
+    }
+    if (c.pending.size() > kMaxLine) {
+      connections_.erase(id);
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&Core::Read, weak_factory_.GetWeakPtr(), id));
+  }
+
+  void HandleLine(int id, const std::string& line) {
+    std::optional<base::Value> value = base::JSONReader::Read(line, 0);
+    if (!value || !value->is_dict()) {
+      Send(id, base::DictValue().Set("error", "bad request"));
+      return;
+    }
+    base::DictValue request = std::move(*value).TakeDict();
+    std::optional<base::Value> request_id;
+    if (const base::Value* rid = request.Find("id")) {
+      request_id = rid->Clone();
+    }
+    const std::string* token = request.FindString("token");
+    if (!token || token->size() != token_.size() ||
+        !crypto::SecureMemEqual(base::as_byte_span(*token),
+                                base::as_byte_span(token_))) {
+      base::DictValue response;
+      if (request_id) {
+        response.Set("id", request_id->Clone());
+      }
+      response.Set("error", "unauthorized");
+      Send(id, std::move(response));
+      return;
+    }
+    request.Remove("token");
+    // To the UI sequence, and the answer back here.
+    auto reply = base::BindOnce(
+        [](scoped_refptr<base::SequencedTaskRunner> server,
+           base::WeakPtr<Core> core, int id, std::optional<base::Value> rid,
+           base::DictValue response) {
+          if (rid) {
+            response.Set("id", std::move(*rid));
+          }
+          server->PostTask(FROM_HERE,
+                           base::BindOnce(&Core::Send, core, id,
+                                          std::move(response)));
+        },
+        base::SequencedTaskRunner::GetCurrentDefault(),
+        weak_factory_.GetWeakPtr(), id, std::move(request_id));
+    ui_->PostTask(FROM_HERE, base::BindOnce(handler_, std::move(request),
+                                            std::move(reply)));
+  }
+
+  void Send(int id, base::DictValue response) {
+    auto it = connections_.find(id);
+    if (it == connections_.end()) {
+      return;
+    }
+    it->second.out += base::WriteJson(response).value_or("{}") + "\n";
+    Write(id);
+  }
+
+  void Write(int id) {
+    auto it = connections_.find(id);
+    if (it == connections_.end() || it->second.writing ||
+        it->second.out.empty()) {
+      return;
+    }
+    Connection& c = it->second;
+    auto buffer = base::MakeRefCounted<net::StringIOBuffer>(c.out);
+    c.writing = true;
+    int size = buffer->size();
+    int rv = c.socket->Write(
+        buffer.get(), size,
+        base::BindOnce(&Core::OnWritten, weak_factory_.GetWeakPtr(), id),
+        TRAFFIC_ANNOTATION_WITHOUT_PROTO("meridian_agent_local_socket"));
+    if (rv != net::ERR_IO_PENDING) {
+      OnWritten(id, rv);
+    }
+  }
+
+  void OnWritten(int id, int rv) {
+    auto it = connections_.find(id);
+    if (it == connections_.end()) {
+      return;
+    }
+    Connection& c = it->second;
+    c.writing = false;
+    if (rv < 0) {
+      connections_.erase(it);
+      return;
+    }
+    c.out.erase(0, rv);
+    Write(id);
+  }
+
+  const base::FilePath user_data_dir_;
+  const scoped_refptr<base::SequencedTaskRunner> ui_;
+  const Handler handler_;
+  std::string token_;
+  base::FilePath socket_path_;
+  base::FilePath temp_dir_;
+  std::unique_ptr<net::UnixDomainServerSocket> server_;
+  std::unique_ptr<net::StreamSocket> accepted_;
+  std::map<int, Connection> connections_;
+  int next_id_ = 1;
+  base::WeakPtrFactory<Core> weak_factory_{this};
+};
+
+AgentServer::AgentServer(const base::FilePath& user_data_dir, Handler handler)
+    // net sockets live on the browser's IO thread.
+    : socket_runner_(content::GetIOThreadTaskRunner({})) {
+  core_ = std::make_unique<Core>(user_data_dir,
+                                 base::SequencedTaskRunner::GetCurrentDefault(),
+                                 std::move(handler));
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&Core::PreparePaths, user_data_dir),
+      base::BindOnce(
+          [](scoped_refptr<base::SequencedTaskRunner> io, Core* core,
+             std::pair<base::FilePath, base::FilePath> paths) {
+            io->PostTask(FROM_HERE,
+                         base::BindOnce(&Core::Start, base::Unretained(core),
+                                        std::move(paths)));
+          },
+          socket_runner_, base::Unretained(core_.get())));
+}
+
+AgentServer::~AgentServer() {
+  // Closes the socket and removes the files there.
+  socket_runner_->DeleteSoon(FROM_HERE, std::move(core_));
+}
+
+// static
+base::FilePath AgentServer::EndpointPath(const base::FilePath& user_data_dir) {
+  return user_data_dir.Append("Meridian Agent.json");
+}
+
+}  // namespace meridian
