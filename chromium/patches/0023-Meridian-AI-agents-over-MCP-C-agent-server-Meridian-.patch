+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MERIDIAN_AGENT_AGENT_SERVICE_H_
+#define CHROME_BROWSER_MERIDIAN_AGENT_AGENT_SERVICE_H_
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "base/values.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/tabs/public/tab_interface.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace content {
+class WebContents;
+}
+
+namespace meridian {
+
+class AgentServer;
+
+// The one place where AI agents (MCP clients through `Meridian --mcp-bridge`)
+// touch the browser.
+//
+// Security model (as in the Electron build):
+//  - Off by default. Access levels: off, read, ask (the person confirms every
+//    action), full. Running JavaScript in pages is a separate opt-in.
+//  - Clients connect over a private unix socket with a random token
+//    (AgentServer). Page scripts run in an isolated world, so a page can't
+//    tamper with them.
+//  - Every action shows in the window (the tab glows, an activity bar names
+//    the agent) and Stop pauses agents until the person resumes them.
+class AgentService : public KeyedService {
+ public:
+  using Reply = base::OnceCallback<void(base::DictValue response)>;
+
+  explicit AgentService(Profile* profile);
+  AgentService(const AgentService&) = delete;
+  AgentService& operator=(const AgentService&) = delete;
+  ~AgentService() override;
+
+  // The window's Stop / Resume.
+  void SetPaused(bool paused);
+  bool paused() const { return paused_; }
+
+  // A request from AgentServer; also used by tests.
+  void Handle(base::DictValue request, Reply reply);
+
+  // The tool definitions (agent_tools.json), for the bridge's tools/list.
+  static const base::ListValue& Tools();
+
+ private:
+  struct Call;
+
+  void OnAccessChanged();
+  BrowserWindowInterface* Window();
+  // A tab id from list_tabs, or the client's current tab.
+  tabs::TabInterface* TabFor(const Call& call);
+  void Run(std::unique_ptr<Call> call);
+  // Asks the person in the window when the access level is "ask".
+  void Confirm(std::unique_ptr<Call> call,
+               std::string summary,
+               base::OnceCallback<void(std::unique_ptr<Call>)> then);
+  void Activity(const Call& call, tabs::TabInterface* tab);
+  void RunInPage(content::WebContents* contents,
+                 const std::string& expression,
+                 base::OnceCallback<void(base::Value)> done);
+
+  // Tools.
+  void ListSpaces(std::unique_ptr<Call> call);
+  void ListTabs(std::unique_ptr<Call> call);
+  void SearchTabs(std::unique_ptr<Call> call);
+  void SearchHistory(std::unique_ptr<Call> call);
+  void ReadPage(std::unique_ptr<Call> call);
+  void Elements(std::unique_ptr<Call> call);
+  void Screenshot(std::unique_ptr<Call> call);
+  void OpenTab(std::unique_ptr<Call> call);
+  void Navigate(std::unique_ptr<Call> call);
+  void HistoryNav(std::unique_ptr<Call> call);
+  void ActivateTab(std::unique_ptr<Call> call);
+  void CloseTab(std::unique_ptr<Call> call);
+  void Click(std::unique_ptr<Call> call);
+  void TypeText(std::unique_ptr<Call> call);
+  void PressKey(std::unique_ptr<Call> call);
+  void Scroll(std::unique_ptr<Call> call);
+  void WaitFor(std::unique_ptr<Call> call);
+  void OrganizeTab(std::unique_ptr<Call> call);
+  void SplitView(std::unique_ptr<Call> call);
+  void CreateSpace(std::unique_ptr<Call> call);
+  void RunJavaScript(std::unique_ptr<Call> call);
+
+  raw_ptr<Profile> profile_;
+  PrefChangeRegistrar prefs_;
+  std::unique_ptr<AgentServer> server_;
+  bool paused_ = false;
+  // Each client's current tab (the last it opened or used).
+  std::map<std::string, tabs::TabHandle> current_tab_;
+  base::CancelableTaskTracker history_tracker_;
+  base::WeakPtrFactory<AgentService> weak_factory_{this};
+};
+
+}  // namespace meridian
+
+#endif  // CHROME_BROWSER_MERIDIAN_AGENT_AGENT_SERVICE_H_
