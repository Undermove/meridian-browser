From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Thu, 19 Nov 2026 22:43:32 +0400
Subject: [PATCH 190/202] Meridian: tests can leave out extensions registered
 for Google Chrome

On Windows every new profile installs the extensions other programs
register for Google Chrome in the registry (HKLM/HKCU\Software\GoogleChrome\Extensions); they download one at a time ahead of a test's own
store, which then never gets its turn. --meridian-test-no-external-extensions
(a test switch: temp-folder profiles only) leaves the registry provider out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/extensions/BUILD.gn              |  1 +
 .../extensions/external_provider_impl.cc        | 17 +++++++++++------
 2 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/extensions/BUILD.gn b/chrome/browser/extensions/BUILD.gn
index aa70420081..64cd652930 100644
--- a/chrome/browser/extensions/BUILD.gn
+++ b/chrome/browser/extensions/BUILD.gn
@@ -493,6 +493,7 @@ source_set("extensions") {
     "//chrome/browser/ui/toolbar",
   ]
   deps = [
+    "//chrome/browser/meridian:test_switches",
     "//base",
     "//chrome/app:command_ids",
     "//chrome/app/theme:chrome_unscaled_resources",
diff --git a/chrome/browser/extensions/external_provider_impl.cc b/chrome/browser/extensions/external_provider_impl.cc
index ba8b69a1b0..a40c2a45ca 100644
--- a/chrome/browser/extensions/external_provider_impl.cc
+++ b/chrome/browser/extensions/external_provider_impl.cc
@@ -93,6 +93,7 @@
 
 #if BUILDFLAG(IS_WIN)
 #include "chrome/browser/extensions/external_registry_loader_win.h"
+#include "chrome/browser/meridian/test_switches.h"
 #endif
 
 static_assert(BUILDFLAG(ENABLE_EXTENSIONS_CORE));
@@ -893,12 +894,16 @@ void ExternalProviderImpl::CreateExternalProviders(
         bundled_extension_creation_flags));
 #endif
 #if BUILDFLAG(IS_WIN)
-    auto registry_provider = std::make_unique<ExternalProviderImpl>(
-        service, new ExternalRegistryLoader, profile,
-        ManifestLocation::kExternalRegistry,
-        ManifestLocation::kExternalPrefDownload, Extension::NO_FLAGS);
-    registry_provider->set_allow_updates(true);
-    provider_list->push_back(std::move(registry_provider));
+    // Meridian: a test's profile leaves out the extensions other programs
+    // register for Google Chrome (HKLM/HKCU\Software\Google\Chrome    // Extensions); they download one by one ahead of the test's own.
+    if (!meridian::HasTestSwitch("meridian-test-no-external-extensions")) {
+      auto registry_provider = std::make_unique<ExternalProviderImpl>(
+          service, new ExternalRegistryLoader, profile,
+          ManifestLocation::kExternalRegistry,
+          ManifestLocation::kExternalPrefDownload, Extension::NO_FLAGS);
+      registry_provider->set_allow_updates(true);
+      provider_list->push_back(std::move(registry_provider));
+    }
 #else
     provider_list->push_back(std::make_unique<ExternalProviderImpl>(
         service,
