+
+void SidebarHandler::GetSearchKeywords(GetSearchKeywordsCallback callback) {
+  std::vector<mojom::SearchKeywordPtr> out;
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(ActiveSpaceProfile());
+  if (service) {
+    for (const TemplateURL* t : service->GetTemplateURLs()) {
+      // Searches the person can type a keyword for (not extensions' own).
+      if (t->type() != TemplateURL::NORMAL || t->keyword().empty() ||
+          !t->url_ref().SupportsReplacement(service->search_terms_data())) {
+        continue;
+      }
+      auto k = mojom::SearchKeyword::New();
+      k->keyword = base::UTF16ToUTF8(t->keyword());
+      k->name = base::UTF16ToUTF8(t->short_name());
+      out.push_back(std::move(k));
+    }
+  }
+  std::move(callback).Run(std::move(out));
+}
+
+void SidebarHandler::SearchUrl(const std::string& keyword,
+                               const std::string& terms,
+                               SearchUrlCallback callback) {
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(ActiveSpaceProfile());
+  const TemplateURL* t =
+      service ? service->GetTemplateURLForKeyword(base::UTF8ToUTF16(keyword))
+              : nullptr;
+  if (!t || !t->url_ref().SupportsReplacement(service->search_terms_data())) {
+    std::move(callback).Run(std::string());
+    return;
+  }
+  GURL url(t->url_ref().ReplaceSearchTerms(
+      TemplateURLRef::SearchTermsArgs(base::UTF8ToUTF16(terms)),
+      service->search_terms_data()));
+  std::move(callback).Run(url.is_valid() ? url.spec() : std::string());
+}
