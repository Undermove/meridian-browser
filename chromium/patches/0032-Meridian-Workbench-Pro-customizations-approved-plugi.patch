+#include "chrome/browser/meridian/workbench/hubs_texts.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+std::string Today() {
+  base::Time::Exploded e;
+  base::Time::Now().LocalExplode(&e);
+  return base::StringPrintf("%04d-%02d-%02d", e.year, e.month, e.day_of_month);
+}
+
+std::string Fill(std::string text, const std::string& name,
+                 const std::string& today) {
+  base::ReplaceSubstringsAfterOffset(&text, 0, "{{NAME}}", name);
+  base::ReplaceSubstringsAfterOffset(&text, 0, "{{TODAY}}", today);
+  return text;
+}
+
+// Creates `rel` under `root` exclusively (never overwriting).
+bool WriteNew(const base::FilePath& root,
+              const std::string& rel,
+              const std::string& content) {
+  base::FilePath abs = root.Append(rel);
+  if (!root.IsParent(abs) || rel.find("..") != std::string::npos) {
+    return false;
+  }
+  if (!base::CreateDirectory(abs.DirName())) {
+    return false;
+  }
+  base::ScopedFD fd(HANDLE_EINTR(
+      open(abs.value().c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0644)));
+  return fd.is_valid() && base::WriteFileDescriptor(fd.get(), content);
+}
+
+}  // namespace
+
+base::ListValue HubTemplates() {
+  base::ListValue out;
+  for (const texts::HubTemplate& t : texts::kHubTemplates) {
+    out.Append(base::DictValue()
+                   .Set("id", t.id)
+                   .Set("label", t.label)
+                   .Set("description", t.description));
+  }
+  return out;
+}
+
+std::string GitPath(const std::string& search_path) {
+  std::string git = FindExecutable("git", search_path);
+  if (git == "/usr/bin/git" &&
+      !base::PathExists(
+          base::FilePath("/Library/Developer/CommandLineTools/usr/bin/git")) &&
+      !base::PathExists(base::FilePath(
+          "/Applications/Xcode.app/Contents/Developer/usr/bin/git"))) {
+    return std::string();
+  }
+  return git;
+}
+
+base::expected<base::DictValue, std::string> CreateHub(
+    const base::FilePath& parent,
+    const std::string& raw_name,
+    const std::string& template_id,
+    bool git,
+    bool skills,
+    const std::string& git_path) {
+  const texts::HubTemplate* t = nullptr;
+  for (const texts::HubTemplate& candidate : texts::kHubTemplates) {
+    if (template_id == candidate.id) {
+      t = &candidate;
+    }
+  }
+  if (!t) {
+    return base::unexpected("Unknown template");
+  }
+  std::string name(base::TrimWhitespaceASCII(raw_name, base::TRIM_ALL));
+  if (name.empty() || name.size() > 80 || name == "." || name == ".." ||
+      name.starts_with(".") ||
+      name.find_first_of("\\/:*?\"<>|") != std::string::npos ||
+      name.find('\0') != std::string::npos) {
+    return base::unexpected(
+        "Use a plain folder name (no slashes, not starting with a dot).");
+  }
+  base::FilePath parent_real = base::MakeAbsoluteFilePath(parent);
+  if (parent_real.empty()) {
+    return base::unexpected("The parent folder doesn’t exist.");
+  }
+  base::FilePath root = parent_real.Append(name);
+  if (root.DirName() != parent_real) {
+    return base::unexpected("Invalid name");
+  }
+  if (base::PathExists(root)) {
+    base::FileEnumerator e(root, false,
+                           base::FileEnumerator::FILES |
+                               base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+      if (p.BaseName().value() != ".DS_Store") {
+        return base::unexpected("“" + name +
+                                "” already exists and isn’t empty. Pick "
+                                "another name, or open it with “Open folder "
+                                "as hub”.");
+      }
+    }
+  } else if (!base::CreateDirectory(root)) {
+    return base::unexpected("Couldn’t create the folder.");
+  }
+  std::string today = Today();
+  for (const char* d : t->dirs) {
+    base::CreateDirectory(root.Append(d));
+  }
+  for (const texts::HubFile& f : t->files) {
+    if (!WriteNew(root, Fill(f.path, name, today), Fill(f.content, name, today))) {
+      return base::unexpected(std::string("Couldn’t create ") + f.path);
+    }
+  }
+  WriteNew(root, "CLAUDE.md", texts::kHubClaudeMd);
+  WriteNew(root, ".gitignore", texts::kHubGitignore);
+  if (skills) {
+    WriteNew(root, ".claude/skills/hub-conventions/SKILL.md", t->skill);
+  }
+  base::DictValue out;
+  out.Set("root", root.value());
+  out.Set("git", false);
+  if (git) {
+    if (git_path.empty()) {
+      out.Set("reason", "git was not found on your PATH");
+    } else {
+      std::map<std::string, std::string> env = ai::LoginEnvironment();
+      int code = -1;
+      ai::CaptureOutput({git_path, "init", "-q"}, env, root.value(),
+                        base::Seconds(10), &code);
+      out.Set("git", code == 0);
+      if (code == 0) {
+        // The first commit is best-effort (fails without user.name/email).
+        int add = -1, commit = -1;
+        ai::CaptureOutput({git_path, "add", "-A"}, env, root.value(),
+                          base::Seconds(10), &add);
+        if (add == 0) {
+          ai::CaptureOutput({git_path, "-c", "commit.gpgsign=false", "commit",
+                             "-q", "--no-verify", "-m",
+                             "Create hub with Meridian"},
+                            env, root.value(), base::Seconds(10), &commit);
+        }
+        out.Set("committed", commit == 0);
+      }
+    }
+  }
+  return out;
+}
+
+base::DictValue HubInfo(const base::FilePath& folder) {
+  base::FilePath root = base::MakeAbsoluteFilePath(folder);
+  base::ListValue conventions;
+  bool is_hub = false;
+  for (const char* rel : {"AGENTS.md", "CLAUDE.md", "GEMINI.md",
+                          ".github/copilot-instructions.md", "README.md"}) {
+    base::FilePath real = base::MakeAbsoluteFilePath(root.Append(rel));
+    base::File::Info info;
+    if (real.empty() || !root.IsParent(real) || !base::GetFileInfo(real, &info) ||
+        info.is_directory) {
+      continue;
+    }
+    base::ListValue headings;
+    std::string text;
+    if (info.size < 512 * 1024 && std::string_view(rel) != "README.md" &&
+        base::ReadFileToString(real, &text)) {
+      std::vector<std::string> lines = base::SplitString(
+          text, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+      for (size_t i = 0; i < lines.size() && headings.size() < 30; ++i) {
+        std::string hashes, title;
+        if (RE2::FullMatch(lines[i], "(#{1,3})\\s+(.+)", &hashes, &title)) {
+          headings.Append(base::DictValue()
+                              .Set("level", static_cast<int>(hashes.size()))
+                              .Set("text", std::string(base::TrimWhitespaceASCII(
+                                               title, base::TRIM_ALL))
+                                               .substr(0, 120))
+                              .Set("line", static_cast<int>(i + 1)));
+        }
+      }
+    }
+    is_hub |= std::string_view(rel) != "README.md";
+    conventions.Append(base::DictValue()
+                           .Set("path", rel)
+                           .Set("size", static_cast<double>(info.size))
+                           .Set("headings", std::move(headings)));
+  }
+  base::ListValue skills;
+  base::FileEnumerator s(root.Append(".claude/skills"), false,
+                         base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath p = s.Next(); !p.empty() && skills.size() < 30;
+       p = s.Next()) {
+    skills.Append(p.BaseName().value());
+  }
+  static const base::NoDestructor<std::set<std::string>> skip(
+      std::set<std::string>{"node_modules", ".git", ".hg", ".svn", "dist",
+                            "build", ".next", "target", ".venv", "venv",
+                            "__pycache__", ".cache"});
+  std::vector<std::pair<double, std::string>> files;
+  int seen = 0;
+  std::vector<std::pair<base::FilePath, int>> stack = {{root, 0}};
+  while (!stack.empty() && seen < 8000) {
+    auto [dir, depth] = stack.back();
+    stack.pop_back();
+    if (depth > 5) {
+      continue;
+    }
+    base::FileEnumerator e(dir, false,
+                           base::FileEnumerator::FILES |
+                               base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+      if (++seen > 8000) {
+        break;
+      }
+      std::string name = p.BaseName().value();
+      if (name == ".DS_Store") {
+        continue;
+      }
+      if (e.GetInfo().IsDirectory()) {
+        if (!skip->contains(name) &&
+            !(name.starts_with(".") && name != ".claude")) {
+          stack.push_back({p, depth + 1});
+        }
+        continue;
+      }
+      base::FilePath rel;
+      root.AppendRelativePath(p, &rel);
+      files.emplace_back(
+          e.GetInfo().GetLastModifiedTime().InMillisecondsFSinceUnixEpoch(),
+          rel.value());
+    }
+  }
+  std::ranges::sort(files, std::greater<>());
+  base::ListValue recent;
+  for (size_t i = 0; i < files.size() && i < 15; ++i) {
+    recent.Append(base::DictValue()
+                      .Set("path", files[i].second)
+                      .Set("mtimeMs", files[i].first));
+  }
+  return base::DictValue()
+      .Set("isHub", is_hub)
+      .Set("conventions", std::move(conventions))
+      .Set("skills", std::move(skills))
+      .Set("recent", std::move(recent));
+}
+
+}  // namespace meridian::workbench
