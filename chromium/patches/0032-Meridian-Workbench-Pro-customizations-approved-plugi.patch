+void WorkbenchHandler::CustomCall(const std::string& method,
+                                  const base::ListValue& params,
+                                  Reply reply) {
+  WorkbenchService* service = WorkbenchServiceFactory::GetForProfile(profile_);
+  base::FilePath root = service->custom_root();
+  base::FilePath approvals = service->approvals_file();
+  std::string a = StringParam(params, 0);
+  bool flag = params.size() > 1 && params[1].is_bool() && params[1].GetBool();
+  if (method == "customState") {
+    bool safe = service->safe_mode();
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::FilePath root, base::FilePath approvals_file,
+               base::FilePath store_file, bool safe) -> Result {
+              base::DictValue st = CustomState(root);
+              base::DictValue approvals = LoadJson(approvals_file);
+              base::DictValue* approved = approvals.FindDict("plugins");
+              for (base::Value& p : *st.FindList("plugins")) {
+                base::DictValue& d = p.GetDict();
+                const std::string* sha = d.FindString("sha256");
+                const base::DictValue* entry =
+                    approved ? approved->FindDict(*d.FindString("file"))
+                             : nullptr;
+                const std::string* ok =
+                    entry ? entry->FindString("sha256") : nullptr;
+                d.Set("approved", sha && ok && *sha == *ok);
+                d.Set("everApproved", !!entry);
+              }
+              base::DictValue store = LoadStore(store_file);
+              const base::ListValue* disabled = store.FindList("disabledPlugins");
+              base::ListValue snapshots = CustomSnapshots(root);
+              while (snapshots.size() > 30) {
+                snapshots.erase(snapshots.end() - 1);
+              }
+              st.Set("safeMode", safe);
+              st.Set("disabled", disabled ? disabled->Clone() : base::ListValue());
+              st.Set("snapshots", std::move(snapshots));
+              return base::Value(std::move(st));
+            },
+            root, approvals, StorePath(), safe),
+        std::move(reply));
+    return;
+  }
+  if (method == "customSafeMode") {
+    bool on = !params.empty() && params[0].is_bool() && params[0].GetBool();
+    service->set_safe_mode(on);
+    for (auto& [contents, handler] : Handlers()) {
+      if (handler->profile_ == profile_) {
+        handler->Emit("wb:custom-change",
+                      base::Value(base::DictValue().Set("safeMode", on)));
+      }
+    }
+    return std::move(reply).Run(base::Value(on));
+  }
+  if (method == "customTogglePlugin") {
+    if (!RE2::FullMatch(a, "[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.js")) {
+      return std::move(reply).Run(base::unexpected("invalid plugin name"));
+    }
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::FilePath file, std::string plugin, bool enabled) -> Result {
+              base::DictValue store = LoadStore(file);
+              base::ListValue* disabled = store.EnsureList("disabledPlugins");
+              disabled->EraseValue(base::Value(plugin));
+              if (!enabled) {
+                disabled->Append(plugin);
+              }
+              base::ListValue out = disabled->Clone();
+              SaveStore(file, store);
+              return base::Value(std::move(out));
+            },
+            StorePath(), a, flag),
+        base::BindOnce(
+            [](base::WeakPtr<WorkbenchHandler> self, Reply reply, Result r) {
+              if (self) {
+                self->Broadcast("wb:custom-change");
+              }
+              std::move(reply).Run(std::move(r));
+            },
+            weak_factory_.GetWeakPtr(), std::move(reply)));
+    return;
+  }
+  if (method == "customRestore") {
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::FilePath root, std::string id) {
+              return Wrap(RestoreCustom(root, id));
+            },
+            root, a),
+        std::move(reply));
+    return;
+  }
+  if (method == "customOpen") {
+    return OpenProject(root, std::move(reply));
+  }
+  if (method == "customReveal") {
+    platform_util::OpenItem(profile_, root, platform_util::OPEN_FOLDER,
+                            base::DoNothing());
+    return std::move(reply).Run(base::Value(true));
+  }
+  if (method == "customApprovePlugins") {
+    // One native confirm for every new or changed (enabled) plugin. Only the
+    // browser writes approvals.
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::FilePath root, base::FilePath approvals_file,
+               base::FilePath store_file) {
+              base::ListValue pending;
+              base::DictValue approvals = LoadJson(approvals_file);
+              base::DictValue store = LoadStore(store_file);
+              const base::ListValue* disabled = store.FindList("disabledPlugins");
+              for (base::Value& p : CustomPlugins(root)) {
+                base::DictValue& d = p.GetDict();
+                const std::string* sha = d.FindString("sha256");
+                const std::string& file = *d.FindString("file");
+                if (!sha || (disabled && disabled->contains(file))) {
+                  continue;
+                }
+                const base::DictValue* plugins = approvals.FindDict("plugins");
+                const base::DictValue* entry =
+                    plugins ? plugins->FindDict(file) : nullptr;
+                const std::string* ok =
+                    entry ? entry->FindString("sha256") : nullptr;
+                if (ok && *ok == *sha) {
+                  continue;
+                }
+                d.Set("changed", ok != nullptr);
+                pending.Append(std::move(d));
+              }
+              return pending;
+            },
+            root, approvals, StorePath()),
+        base::BindOnce(
+            [](base::WeakPtr<WorkbenchHandler> self, base::FilePath approvals,
+               Reply reply, base::ListValue pending) {
+              if (!self) {
+                return;
+              }
+              if (pending.empty()) {
+                return std::move(reply).Run(base::Value(
+                    base::DictValue().Set("approved", base::ListValue())));
+              }
+              std::string lines;
+              for (size_t i = 0; i < pending.size() && i < 12; ++i) {
+                const base::DictValue& p = pending[i].GetDict();
+                double size = p.FindDouble("size").value_or(0);
+                lines += "• " + *p.FindString("file") + " — " +
+                         (size < 1024 ? base::NumberToString(
+                                            static_cast<int>(size)) + " bytes"
+                                      : base::StringPrintf("%.1f KB",
+                                                           size / 1024)) +
+                         ", " +
+                         (p.FindBool("changed").value_or(false)
+                              ? "CHANGED since you approved it"
+                              : "new") +
+                         "\n   " + ai::OneLine(*p.FindString("path"), 200) +
+                         "\n";
+              }
+              size_t n = pending.size();
+              AskNative(
+                  self->web_ui()->GetWebContents(),
+                  n == 1 ? "Run this Workbench plugin?"
+                         : "Run these " + base::NumberToString(n) +
+                               " Workbench plugins?",
+                  lines +
+                      "\nPlugins run inside the Workbench with its powers: "
+                      "they can open terminals and run commands, read and "
+                      "change project files, and use your vault secrets. Only "
+                      "run code you trust. Any later change to a plugin file "
+                      "needs your approval again.",
+                  {"Don’t run", n == 1 ? "Run this plugin"
+                                       : "Run " + base::NumberToString(n) +
+                                             " plugins"},
+                  base::BindOnce(
+                      [](base::WeakPtr<WorkbenchHandler> self,
+                         base::FilePath approvals, Reply reply,
+                         base::ListValue pending, int choice) {
+                        if (!self || choice != 1) {
+                          return std::move(reply).Run(base::Value(
+                              base::DictValue().Set("approved",
+                                                    base::ListValue())));
+                        }
+                        self->files_->PostTaskAndReplyWithResult(
+                            FROM_HERE,
+                            base::BindOnce(
+                                [](base::FilePath file,
+                                   base::ListValue pending) -> Result {
+                                  base::DictValue all = LoadJson(file);
+                                  base::DictValue* plugins =
+                                      all.EnsureDict("plugins");
+                                  base::ListValue names;
+                                  for (const base::Value& p : pending) {
+                                    const base::DictValue& d = p.GetDict();
+                                    plugins->Set(
+                                        *d.FindString("file"),
+                                        base::DictValue()
+                                            .Set("sha256",
+                                                 *d.FindString("sha256"))
+                                            .Set("size",
+                                                 d.FindDouble("size").value_or(0))
+                                            .Set("at",
+                                                 base::Time::Now()
+                                                     .InMillisecondsFSinceUnixEpoch()));
+                                    names.Append(*d.FindString("file"));
+                                  }
+                                  all.Set("version", 1);
+                                  SaveJson(file, all);
+                                  return base::Value(base::DictValue().Set(
+                                      "approved", std::move(names)));
+                                },
+                                approvals, std::move(pending)),
+                            base::BindOnce(
+                                [](base::WeakPtr<WorkbenchHandler> self,
+                                   Reply reply, Result r) {
+                                  if (self) {
+                                    self->Broadcast("wb:custom-change");
+                                  }
+                                  std::move(reply).Run(std::move(r));
+                                },
+                                self, std::move(reply)));
+                      },
+                      self, approvals, std::move(reply), std::move(pending)));
+            },
+            weak_factory_.GetWeakPtr(), approvals, std::move(reply)));
+    return;
+  }
+  std::move(reply).Run(base::unexpected("unknown customization call"));
+}
+
+void WorkbenchHandler::SetHubParent(const base::FilePath& picked,
+                                    Reply reply) {
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&base::MakeAbsoluteFilePath, picked),
+      base::BindOnce(
+          [](base::WeakPtr<WorkbenchHandler> self, Reply reply,
+             base::FilePath real) {
+            if (!self) {
+              return;
+            }
+            self->hub_parent_ = real;
+            std::move(reply).Run(real.empty() ? base::Value()
+                                              : base::Value(real.value()));
+          },
+          weak_factory_.GetWeakPtr(), std::move(reply)));
+}
+
+void WorkbenchHandler::HubCall(const std::string& method,
+                               const base::ListValue& params,
+                               Reply reply) {
+  if (method == "hubPickParent") {
+    const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+    if (cl->HasSwitch("meridian-test-hub-parent")) {
+      return SetHubParent(cl->GetSwitchValuePath("meridian-test-hub-parent"),
+                          std::move(reply));
+    }
+    if (dialog_) {
+      return std::move(reply).Run(base::Value());
+    }
+    pick_reply_ = std::move(reply);
+    picking_hub_parent_ = true;
+    dialog_ = ui::SelectFileDialog::Create(
+        this, std::make_unique<ChromeSelectFilePolicy>(
+                  web_ui()->GetWebContents()));
+    dialog_->SelectFile(ui::SelectFileDialog::SELECT_FOLDER,
+                        u"Where should the hub folder be created?",
+                        base::FilePath(), nullptr, 0,
+                        base::FilePath::StringType(),
+                        web_ui()->GetWebContents()->GetTopLevelNativeWindow());
+    return;
+  }
+  if (method == "hubInfo") {
+    return OnProject(base::BindOnce([](const ProjectFs& p) -> Result {
+                       return base::Value(HubInfo(p.root()));
+                     }),
+                     std::move(reply));
+  }
