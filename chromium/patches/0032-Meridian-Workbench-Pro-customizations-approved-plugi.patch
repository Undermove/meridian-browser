+TEST(HubsTest, CreatesAContentHubAndReadsItBack) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  EXPECT_EQ(HubTemplates().size(), 3u);
+  base::expected<base::DictValue, std::string> hub =
+      CreateHub(dir.GetPath(), "My Posts", "content", /*git=*/false,
+                /*skills=*/true, "");
+  ASSERT_TRUE(hub.has_value()) << hub.error();
+  base::FilePath root(*hub->FindString("root"));
+  std::string agents;
+  ASSERT_TRUE(base::ReadFileToString(root.Append("AGENTS.md"), &agents));
+  EXPECT_TRUE(agents.starts_with("# My Posts — instructions for agents"));
+  EXPECT_TRUE(base::DirectoryExists(root.Append("posts/drafts")));
+  EXPECT_TRUE(base::PathExists(
+      root.Append(".claude/skills/hub-conventions/SKILL.md")));
+  base::DictValue info = HubInfo(root);
+  EXPECT_TRUE(info.FindBool("isHub").value_or(false));
+  EXPECT_EQ(*(*info.FindList("skills"))[0].GetIfString(), "hub-conventions");
+  // Not into a folder that has things in it, and only plain names.
+  EXPECT_FALSE(CreateHub(dir.GetPath(), "My Posts", "content", false, false, "")
+                   .has_value());
+  EXPECT_FALSE(CreateHub(dir.GetPath(), "../escape", "content", false, false, "")
+                   .has_value());
+  EXPECT_FALSE(CreateHub(dir.GetPath(), ".hidden", "code", false, false, "")
+                   .has_value());
+}
