+void WorkbenchService::OnCustomFileChanged(const base::FilePath& path,
+                                           bool error) {
+  base::FilePath rel;
+  custom_root_.AppendRelativePath(path, &rel);
+  std::string r = rel.value();
+  if (r.starts_with(".history") || r == "API.md" || r.ends_with(".tmp") ||
+      r.ends_with("~")) {
+    return;
+  }
+  custom_timer_.Start(
+      FROM_HERE, base::Milliseconds(200),
+      base::BindOnce(
+          [](base::WeakPtr<WorkbenchService> self) {
+            if (!self) {
+              return;
