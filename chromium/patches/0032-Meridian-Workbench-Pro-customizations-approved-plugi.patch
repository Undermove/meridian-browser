+bool SidebarHandler::PinTabContents(content::WebContents* contents,
+                                    bool favorite,
+                                    const GURL& url,
+                                    const std::string& title) {
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  auto it = window ? Handlers().find(window) : Handlers().end();
+  if (it == Handlers().end()) {
+    return false;
+  }
+  SidebarHandler* self = it->second;
+  const TabData* data = TabData::Get(contents);
+  if (data && !data->item_id().empty()) {
+    bool in_favorites = std::ranges::any_of(
+        self->service_->favorites(),
+        [&](const Item& f) { return f.id == data->item_id(); });
+    if (favorite && !in_favorites) {
+      self->service_->MoveItem(data->item_id(), kFavorites, std::string(), -1);
+      self->ScheduleNotify();
+    }
+    return true;
+  }
+  std::string space_id = data && !data->space_id().empty()
+                             ? data->space_id()
+                             : self->service_->active_space_id();
+  Item item;
+  item.title = title.empty() ? base::UTF16ToUTF8(contents->GetTitle()) : title;
+  item.url = url;
+  std::string item_id = self->service_->AddItem(
+      favorite ? std::string(kFavorites) : space_id, std::string(), -1, item);
+  if (item_id.empty()) {
+    return false;
+  }
+  TabData::Set(contents, space_id, item_id);
+  self->ScheduleNotify();
+  return true;
+}
