+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/workbench/customizations.h"
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <algorithm>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "chrome/browser/meridian/workbench/customizations_texts.h"
+#include "crypto/hash.h"
+#include "third_party/re2/src/re2/re2.h"
+
+namespace meridian::workbench {
+
+namespace {
+
+constexpr int64_t kMaxFile = 2 * 1024 * 1024;
+constexpr size_t kMaxPlugins = 50;
+constexpr size_t kKeepSnapshots = 40;
+
+// Never overwrites.
+void Once(const base::FilePath& file, std::string_view text) {
+  base::ScopedFD fd(HANDLE_EINTR(
+      open(file.value().c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0644)));
+  if (fd.is_valid()) {
+    base::WriteFileDescriptor(fd.get(), text);
+  }
+}
+
+bool Inside(const base::FilePath& root, const base::FilePath& p) {
+  return p == root || root.IsParent(p);
+}
+
+base::FilePath Real(const base::FilePath& root) {
+  base::FilePath real = base::MakeAbsoluteFilePath(root);
+  return real.empty() ? root : real;
+}
+
+double Now() {
+  return base::Time::Now().InMillisecondsFSinceUnixEpoch();
+}
+
+// rel -> text of the files a snapshot covers.
+base::DictValue Collect(const base::FilePath& root) {
+  base::DictValue files;
+  for (const char* rel : {"user.css", "settings.json", "AGENTS.md"}) {
+    std::string text;
+    std::optional<int64_t> size = base::GetFileSize(root.Append(rel));
+    if (size && *size <= kMaxFile && base::ReadFileToString(root.Append(rel), &text)) {
+      files.Set(rel, text);
+    }
+  }
+  for (const base::Value& p : CustomPlugins(root)) {
+    const base::DictValue& d = p.GetDict();
+    if (d.FindDouble("size").value_or(0) > kMaxFile) {
+      continue;
+    }
+    std::string text;
+    if (base::ReadFileToString(
+            root.Append("plugins").Append(*d.FindString("file")), &text)) {
+      files.Set("plugins/" + *d.FindString("file"), text);
+    }
+  }
+  return files;
+}
+
+std::optional<base::DictValue> ReadSnapshot(const base::FilePath& root,
+                                            const std::string& id) {
+  if (!RE2::FullMatch(id, "\\d{13}-[a-z]+")) {
+    return std::nullopt;
+  }
+  base::FilePath dir = root.Append(".history").Append(id);
+  std::string json;
+  if (!base::ReadFileToString(dir.Append("manifest.json"), &json)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> manifest = base::JSONReader::Read(json, 0);
+  const base::ListValue* list =
+      manifest && manifest->is_dict() ? manifest->GetDict().FindList("files")
+                                      : nullptr;
+  base::DictValue files;
+  if (list) {
+    for (const base::Value& rel : *list) {
+      if (!rel.is_string() ||
+          !RE2::FullMatch(rel.GetString(),
+                          "user\\.css|settings\\.json|AGENTS\\.md|plugins/"
+                          "[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.js")) {
+        continue;
+      }
+      std::string text;
+      if (base::ReadFileToString(dir.Append(rel.GetString()), &text)) {
+        files.Set(rel.GetString(), text);
+      }
+    }
+  }
+  return files;
+}
+
+}  // namespace
+
+bool EnsureCustomFolder(const base::FilePath& root) {
+  if (!base::CreateDirectory(root.Append("plugins")) ||
+      !base::CreateDirectory(root.Append("examples")) ||
+      !base::CreateDirectory(root.Append(".history"))) {
+    return false;
+  }
+  Once(root.Append("user.css"), texts::kUserCss);
+  Once(root.Append("settings.json"), texts::kDefaultSettings);
+  Once(root.Append("AGENTS.md"), texts::kAgentsMd);
+  Once(root.Append("CLAUDE.md"), texts::kClaudeMd);
+  Once(root.Append("examples/hello-button.js"), texts::kExamplePlugin);
+  Once(root.Append(".gitignore"), ".history/\n");
+  base::WriteFile(root.Append("API.md"), texts::kApiMd);
+  return true;
+}
+
+base::ListValue CustomPlugins(const base::FilePath& folder) {
+  base::FilePath root = Real(folder);
+  std::vector<std::string> names;
+  base::FileEnumerator e(root.Append("plugins"), false,
+                         base::FileEnumerator::FILES |
+                             base::FileEnumerator::SHOW_SYM_LINKS);
+  for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+    std::string name = p.BaseName().value();
+    if (RE2::FullMatch(name, "[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.js")) {
+      names.push_back(name);
+    }
+  }
+  std::ranges::sort(names);
+  base::ListValue out;
+  for (const std::string& name : names) {
+    if (out.size() >= kMaxPlugins) {
+      break;
+    }
+    base::FilePath real =
+        base::MakeAbsoluteFilePath(root.Append("plugins").Append(name));
+    base::File::Info info;
+    if (real.empty() || !Inside(root, real) || !base::GetFileInfo(real, &info) ||
+        info.is_directory) {
+      continue;
+    }
+    base::DictValue item;
+    item.Set("file", name);
+    item.Set("path", real.value());
+    item.Set("mtimeMs", info.last_modified.InMillisecondsFSinceUnixEpoch());
+    item.Set("size", static_cast<double>(info.size));
+    std::string content;
+    if (info.size <= kMaxFile && base::ReadFileToString(real, &content)) {
+      item.Set("sha256", base::HexEncodeLower(crypto::hash::Sha256(content)));
+    } else {
+      item.Set("sha256", base::Value());
+    }
+    out.Append(std::move(item));
+  }
+  return out;
+}
+
+base::DictValue CustomState(const base::FilePath& folder) {
+  base::FilePath root = Real(folder);
+  std::string settings_text;
+  base::ReadFileToString(root.Append("settings.json"), &settings_text);
+  base::Value settings;
+  base::Value error;
+  if (!base::TrimWhitespaceASCII(settings_text, base::TRIM_ALL).empty()) {
+    auto parsed = base::JSONReader::ReadAndReturnValueWithError(settings_text, 0);
+    if (parsed.has_value()) {
+      settings = std::move(*parsed);
+    } else {
+      error = base::Value(parsed.error().message);
+    }
+  }
+  base::File::Info css;
+  double css_mtime = base::GetFileInfo(root.Append("user.css"), &css)
+                         ? css.last_modified.InMillisecondsFSinceUnixEpoch()
+                         : 0;
+  return base::DictValue()
+      .Set("root", root.value())
+      .Set("settings", std::move(settings))
+      .Set("settingsError", std::move(error))
+      .Set("cssMtime", css_mtime)
+      .Set("plugins", CustomPlugins(root));
+}
+
+std::optional<std::string> ServeCustomFile(const base::FilePath& folder,
+                                           const std::string& rel) {
+  if (!RE2::FullMatch(rel,
+                      "user\\.css|plugins/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*\\."
+                      "(js|css|json|svg|png)")) {
+    return std::nullopt;
+  }
+  for (const std::string& part : base::SplitString(
+           rel, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (part == ".." || part.starts_with(".")) {
+      return std::nullopt;
+    }
+  }
+  base::FilePath root = Real(folder);
+  base::FilePath real = base::MakeAbsoluteFilePath(root.Append(rel));
+  base::File::Info info;
+  std::string content;
+  if (real.empty() || !Inside(root, real) || !base::GetFileInfo(real, &info) ||
+      info.is_directory || info.size > kMaxFile ||
+      !base::ReadFileToString(real, &content)) {
+    return std::nullopt;
+  }
+  return content;
+}
+
+base::ListValue CustomSnapshots(const base::FilePath& folder) {
+  base::FilePath root = Real(folder);
+  std::vector<std::string> ids;
+  base::FileEnumerator e(root.Append(".history"), false,
+                         base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+    std::string id = p.BaseName().value();
+    if (RE2::FullMatch(id, "\\d{13}-[a-z]+")) {
+      ids.push_back(id);
+    }
+  }
+  std::ranges::sort(ids, std::greater<>());
+  base::ListValue out;
+  for (const std::string& id : ids) {
+    base::ListValue files;
+    if (std::optional<base::DictValue> snap = ReadSnapshot(root, id)) {
+      for (const auto [rel, text] : *snap) {
+        files.Append(rel);
+      }
+    }
+    double at = 0;
+    base::StringToDouble(id.substr(0, 13), &at);
+    out.Append(base::DictValue()
+                   .Set("id", id)
+                   .Set("at", at)
+                   .Set("reason", id.substr(14))
+                   .Set("files", std::move(files)));
+  }
+  return out;
+}
+
+std::string SnapshotCustom(const base::FilePath& folder,
+                           const std::string& reason) {
+  base::FilePath root = Real(folder);
+  base::DictValue files = Collect(root);
+  base::ListValue list = CustomSnapshots(root);
+  if (!list.empty()) {
+    const std::string& newest = *list[0].GetDict().FindString("id");
+    std::optional<base::DictValue> prev = ReadSnapshot(root, newest);
+    if (prev && *prev == files) {
+      return newest;
+    }
+  }
+  std::string id = base::NumberToString(static_cast<int64_t>(Now())) + "-" + reason;
+  base::FilePath dir = root.Append(".history").Append(id);
+  base::CreateDirectory(dir.Append("plugins"));
+  base::ListValue names;
+  for (const auto [rel, text] : files) {
+    base::WriteFile(dir.Append(rel), text.GetString());
+    names.Append(rel);
+  }
+  base::WriteFile(dir.Append("manifest.json"),
+                  base::WriteJson(base::DictValue().Set("files", std::move(names)))
+                      .value_or("{}"));
+  for (size_t i = kKeepSnapshots - 1; i < list.size(); ++i) {
+    base::DeletePathRecursively(
+        root.Append(".history").Append(*list[i].GetDict().FindString("id")));
+  }
+  return id;
+}
+
+base::expected<bool, std::string> RestoreCustom(const base::FilePath& folder,
+                                                const std::string& id) {
+  base::FilePath root = Real(folder);
+  std::optional<base::DictValue> files = ReadSnapshot(root, id);
+  if (!files) {
+    return base::unexpected("bad snapshot id");
+  }
+  SnapshotCustom(root, "before-revert");
+  for (const base::Value& p : CustomPlugins(root)) {
+    const std::string& file = *p.GetDict().FindString("file");
+    if (!files->Find("plugins/" + file)) {
+      base::DeleteFile(root.Append("plugins").Append(file));
+    }
+  }
+  for (const auto [rel, text] : *files) {
+    base::WriteFile(root.Append(rel), text.GetString());
+  }
+  return true;
+}
+
+}  // namespace meridian::workbench
