+
+#include "chrome/browser/meridian/workbench/customizations.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/threading/platform_thread.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace meridian::workbench {
+namespace {
+
+TEST(CustomizationsTest, StarterFilesPluginsServingAndRevert) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::FilePath root = base::MakeAbsoluteFilePath(dir.GetPath()).Append("c");
+  ASSERT_TRUE(EnsureCustomFolder(root));
+  std::string agents;
+  ASSERT_TRUE(base::ReadFileToString(root.Append("AGENTS.md"), &agents));
+  EXPECT_NE(agents.find("Read **API.md** first"), std::string::npos);
+  // The person's files are never overwritten.
+  ASSERT_TRUE(base::WriteFile(root.Append("user.css"), "body{}"));
+  ASSERT_TRUE(EnsureCustomFolder(root));
+  std::string css;
+  base::ReadFileToString(root.Append("user.css"), &css);
+  EXPECT_EQ(css, "body{}");
+
+  std::string first = SnapshotCustom(root, "initial");
+  ASSERT_TRUE(base::WriteFile(root.Append("plugins/deploy.js"), "1"));
+  base::ListValue plugins = CustomPlugins(root);
+  ASSERT_EQ(plugins.size(), 1u);
+  EXPECT_EQ(plugins[0].GetDict().FindString("sha256")->size(), 64u);
+  EXPECT_EQ(ServeCustomFile(root, "plugins/deploy.js"), "1");
+  EXPECT_FALSE(ServeCustomFile(root, "../c/plugins/deploy.js"));
+  EXPECT_FALSE(ServeCustomFile(root, "settings.json"));
+  EXPECT_FALSE(ServeCustomFile(root, ".history/x.js"));
+  ASSERT_TRUE(base::CreateSymbolicLink(base::FilePath("/etc/hosts"),
+                                       root.Append("plugins/evil.css")));
+  EXPECT_FALSE(ServeCustomFile(root, "plugins/evil.css"));
+
+  base::PlatformThread::Sleep(base::Milliseconds(5));
+  std::string second = SnapshotCustom(root, "auto");
+  EXPECT_NE(second, first);
+  EXPECT_EQ(SnapshotCustom(root, "auto"), second) << "unchanged: no new one";
+  ASSERT_TRUE(RestoreCustom(root, first).value_or(false));
+  EXPECT_FALSE(base::PathExists(root.Append("plugins/deploy.js")));
+  // "before-revert" equals the newest snapshot, so none is added.
+  EXPECT_EQ(CustomSnapshots(root).size(), 2u);
+}
+
+}  // namespace
+}  // namespace meridian::workbench
