+
+// Generated by chromium/tools/gen_custom_texts.py from src/dev/custom.js.
+
+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_CUSTOMIZATIONS_TEXTS_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_CUSTOMIZATIONS_TEXTS_H_
+
+namespace meridian::workbench::texts {
+
+inline constexpr char kUserCss[] = R"meridian(/* Workbench user styles — loaded after the built-in styles, hot-reloaded on save.
+ * Useful variables: --space (accent), --surface, --surface-2, --text, --text-muted, --border,
+ * --mono, --font, --tree-w, --term-h. Example:
+ *
+ *   #topbar { background: color-mix(in srgb, var(--space) 6%, var(--surface)); }
+ */
+)meridian";
+
+inline constexpr char kExamplePlugin[] = R"meridian(// Example plugin — copy this file into plugins/ to try it. Full reference: ../API.md
+workbenchPlugin({ id: 'hello', name: 'Hello button' }, (api) => {
+  api.toolbar.add({
+    id: 'hello', label: 'Hello', icon: 'bolt', title: 'Say hello',
+    onClick: () => api.toast('Hello from a plugin, ' + (api.project()?.name || 'no project')),
+  });
+  api.commands.add({ id: 'hello.git-status', title: 'Git: status in a terminal', keybinding: 'Mod+Shift+G', run: () => api.terminal.run('git status') });
+});
+)meridian";
+
+inline constexpr char kApiMd[] = R"meridian(# Meridian Workbench — plugin API
+
+> Generated by Meridian on every start. Don't edit; edit AGENTS.md, settings.json, user.css and plugins/ instead.
+
+Plugins are plain JavaScript files in `plugins/` (one file = one plugin, loaded in alphabetical
+order). They run inside the Workbench page, as classic scripts (no `import`, no `require`, no
+network: the page may only load files from Meridian itself). Every change to this folder is applied
+live: CSS and settings instantly, plugins are torn down and loaded again.
+
+## Registering
+
+```js
+workbenchPlugin({ id: 'deploy', name: 'Deploy button' }, (api) => {
+  // add things through api.* — they are removed automatically when the plugin reloads
+  return () => { /* optional extra cleanup */ };
+});
+```
+
+## api
+
+| Member | What it does |
+| --- | --- |
+| `api.toolbar.add({ id, label, icon?, title?, onClick })` | Button in the top bar (right of the agent launchers). `icon`: one of bolt, play, code, terminal, globe, file, folder, star, pin, layers, shield, lock, reload, search, settings. |
+| `api.commands.add({ id, title, run, keybinding? })` | Command in the palette (⌘⇧P / Ctrl+Shift+P). `keybinding` like `'Mod+Shift+D'` (Mod = ⌘ on macOS, Ctrl elsewhere; also Alt, Shift). |
+| `api.keybindings.add('Mod+Alt+T', fn)` | Bare keybinding. Keys Meridian uses app-wide (⌘T, ⌘L, ⌘W, ⌘D, ⌘S, ⌘J, ⌘1–9, …) never reach the page — prefer Mod+Alt+… or Mod+Shift+… combos. |
+| `api.panels.add({ id, title, icon?, render(el) })` | Panel in the right side pane. `render` gets an empty element; may return a cleanup function. |
+| `api.launchers.add({ id, label, command, mark?, color? })` | Launcher next to Claude Code / Codex / Shell: opens a shell in the project and runs `command`. |
+| `api.terminal.run(command, { title? })` | Opens a shell in the project and types `command` + Enter. Returns a promise. |
+| `api.files.read(rel)` / `api.files.write(rel, text)` / `api.files.open(rel)` | Project files (paths relative to the project root). |
+| `api.project()` | `{ root, name }` or `null`. |
+| `api.settings()` | Current effective settings (read-only copy). |
+| `api.on(event, fn)` | Events: `'project'` (project opened), `'file-open'` (rel path), `'file-save'` (rel path). |
+| `api.toast(text)` | Small notification. |
+| `api.css(text)` | Adds a style block (removed when the plugin reloads). |
+| `api.el(tag, props?, ...children)` | Tiny DOM helper: `api.el('button', { className: 'btn small', onclick }, 'Go')`. |
+
+Use `textContent` (or `api.el`) for any text that comes from files or terminals — never `innerHTML`
+with data you didn't write.
+
+## settings.json
+
+```json
+{
+  "editor": {
+    "fontSize": 13,
+    "fontFamily": "",
+    "lineHeight": 20,
+    "minimap": false,
+    "wordWrap": "off",
+    "tabSize": 2,
+    "theme": "auto"
+  },
+  "terminal": {
+    "fontSize": 12.5,
+    "fontFamily": "",
+    "lineHeight": 1.15
+  },
+  "layout": {
+    "treeWidth": 240,
+    "terminalHeight": "38%",
+    "sidePanelWidth": 320,
+    "showTree": true
+  },
+  "ui": {
+    "accent": ""
+  }
+}
+```
+
+- `editor.theme`: `"auto"` (follows the system), `"light"`, `"dark"`, `"hc-black"`, `"hc-light"`.
+- `layout.terminalHeight`: CSS length (`"40%"`, `"320px"`). `layout.showTree`: hide the file tree.
+- `ui.accent`: hex colour to override the space colour (`"#d97757"`), empty = follow the space.
+
+## user.css
+
+Loaded after the built-in styles. Main regions: `#topbar`, `#tree-pane`, `#editor-area`,
+`#term-area`, `#side-pane`, `#statusbar`. Variables: `--space`, `--surface`, `--surface-2`,
+`--text`, `--text-muted`, `--border`, `--mono`, `--font`.
+
+## Safety
+
+- Everything here runs with the Workbench's powers (terminals, project files). Only add code you'd
+  run yourself.
+- The user can switch any plugin off, start in Safe Mode (nothing from this folder loads) and revert
+  to any automatic snapshot from the Customize panel.
+- Never write API keys or tokens into these files. Secrets live in Meridian's vault and reach
+  processes as environment variables.
+)meridian";
+
+inline constexpr char kAgentsMd[] = R"meridian(# Workbench customizations — instructions for agents
+
+This folder customizes the Meridian Workbench (the mini IDE you are running in). The user asks for
+changes like "make the editor font bigger", "add a deploy button", "show a TODO panel"; you make
+them by editing files here. Meridian applies every saved change live — no restart, no build.
+
+Read **API.md** first: it is the exact, current plugin API and settings reference.
+
+## Where to change what
+
+- Font, sizes, theme, layout → `settings.json` (keep it valid JSON; unknown keys are ignored).
+- Colours, spacing, hiding things → `user.css`.
+- New buttons, commands, keybindings, panels, launchers → a plugin in `plugins/<name>.js`.
+  One feature per file, named after the feature (`plugins/deploy-button.js`).
+
+## Rules
+
+- Small, focused edits. Don't rewrite files you weren't asked to touch.
+- Plugins: classic scripts only (no import/require/fetch to the internet). Use `textContent` /
+  `api.el` for text; never build HTML from file or terminal contents.
+- Don't touch `.history/` (automatic snapshots) or `API.md` (regenerated by Meridian).
+- Never put secrets in these files. If a command needs a key, it is already in the environment of
+  terminals Meridian starts (ask the user to add it to the vault if it isn't).
+- After a change, tell the user what to look at. If something broke, they can revert from the
+  Customize panel; you can also restore files from `.history/<snapshot>/`.
+- `examples/` has a working plugin to copy from.
+)meridian";
+
+inline constexpr char kClaudeMd[] = R"meridian(# CLAUDE.md
+
+Read [AGENTS.md](AGENTS.md) and [API.md](API.md) before changing anything here.
+
+@AGENTS.md
+)meridian";
+
+inline constexpr char kDefaultSettings[] = R"meridian({
+  "editor": {
+    "fontSize": 13,
+    "fontFamily": "",
+    "lineHeight": 20,
+    "minimap": false,
+    "wordWrap": "off",
+    "tabSize": 2,
+    "theme": "auto"
+  },
+  "terminal": {
+    "fontSize": 12.5,
+    "fontFamily": "",
+    "lineHeight": 1.15
+  },
+  "layout": {
+    "treeWidth": 240,
+    "terminalHeight": "38%",
+    "sidePanelWidth": 320,
+    "showTree": true
+  },
+  "ui": {
+    "accent": ""
+  }
+}
+)meridian";
+
+
+}  // namespace meridian::workbench::texts
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_CUSTOMIZATIONS_TEXTS_H_
