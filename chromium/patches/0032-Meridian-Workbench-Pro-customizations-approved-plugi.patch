+#ifndef CHROME_BROWSER_MERIDIAN_WORKBENCH_CUSTOMIZATIONS_H_
+#define CHROME_BROWSER_MERIDIAN_WORKBENCH_CUSTOMIZATIONS_H_
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+
+namespace meridian::workbench {
+
+// The Workbench customization folder:
+//   user.css        extra styles (hot-swapped)
+//   settings.json   editor / terminal / layout settings
+//   plugins/*.js    plugins (classic scripts in the Workbench page)
+//   AGENTS.md       how coding agents should change all of the above
+//   API.md          the plugin API reference (rewritten on every start)
+//   .history/       automatic snapshots, for one-click revert
+// A plugin only runs after the person approved its exact content (SHA-256,
+// kept outside this folder) in a native dialog. Blocking functions.
+
+// Creates the folder and its starter files (never overwriting the person's).
+bool EnsureCustomFolder(const base::FilePath& root);
+
+// [{file, path, mtimeMs, size, sha256}] for plugins/*.js (sorted, capped).
+base::ListValue CustomPlugins(const base::FilePath& root);
+// {root, settings, settingsError, cssMtime, plugins}
+base::DictValue CustomState(const base::FilePath& root);
+// A file to serve at chrome://workbench/custom/<rel> (user.css and
+// plugins/…), by real path inside the folder; nullopt otherwise.
+std::optional<std::string> ServeCustomFile(const base::FilePath& root,
+                                           const std::string& rel);
+
+// Snapshots of user.css, settings.json, AGENTS.md and plugins/*.js:
+// [{id, at, reason, files}] newest first; Snapshot() skips when nothing
+// changed and keeps the newest 40; Restore() snapshots first, so a revert
+// can be reverted.
+base::ListValue CustomSnapshots(const base::FilePath& root);
+std::string SnapshotCustom(const base::FilePath& root,
+                           const std::string& reason);
+base::expected<bool, std::string> RestoreCustom(const base::FilePath& root,
+                                                const std::string& id);
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_CUSTOMIZATIONS_H_
