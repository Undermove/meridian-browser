+            self->files_->PostTaskAndReply(
+                FROM_HERE,
+                base::BindOnce(base::IgnoreResult(&SnapshotCustom),
+                               self->custom_root_, "auto"),
+                base::BindOnce(
+                    [](base::WeakPtr<WorkbenchService> self) {
