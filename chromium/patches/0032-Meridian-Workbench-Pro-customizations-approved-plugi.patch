+
+void WorkbenchService::ServeCustom(
+    const std::string& rel,
+    base::FilePath store_file,
+    base::OnceCallback<void(std::optional<std::string>)> done) {
+  if (safe_mode_) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath root, base::FilePath approvals_file,
+             base::FilePath store_file,
+             std::string rel) -> std::optional<std::string> {
+            std::string file;
+            if (RE2::FullMatch(rel, "(?i)plugins/.*\\.js")) {
+              if (!RE2::FullMatch(rel,
+                                  "plugins/([A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.js)",
+                                  &file)) {
+                return std::nullopt;  // never deeper scripts
+              }
+              std::string store_json;
+              base::ReadFileToString(store_file, &store_json);
+              std::optional<base::Value> store =
+                  base::JSONReader::Read(store_json, 0);
+              const base::ListValue* disabled =
+                  store && store->is_dict()
+                      ? store->GetDict().FindList("disabledPlugins")
+                      : nullptr;
+              if (disabled) {
+                for (const base::Value& d : *disabled) {
+                  if (d.is_string() && d.GetString() == file) {
+                    return std::nullopt;
+                  }
+                }
+              }
+            }
+            std::optional<std::string> body = ServeCustomFile(root, rel);
+            if (!body || file.empty()) {
+              return body;
+            }
+            std::string approvals_json;
+            base::ReadFileToString(approvals_file, &approvals_json);
+            std::optional<base::Value> approvals =
+                base::JSONReader::Read(approvals_json, 0);
+            // Not a dotted path: plugin names have dots.
+            const base::DictValue* plugins =
+                approvals && approvals->is_dict()
+                    ? approvals->GetDict().FindDict("plugins")
+                    : nullptr;
+            const base::DictValue* entry =
+                plugins ? plugins->FindDict(file) : nullptr;
+            const std::string* sha =
+                entry ? entry->FindString("sha256") : nullptr;
+            if (!sha ||
+                *sha != base::HexEncodeLower(crypto::hash::Sha256(*body))) {
+              return std::nullopt;
+            }
+            return body;
+          },
+          custom_root_, approvals_file_, std::move(store_file), rel),
+      std::move(done));
+}
