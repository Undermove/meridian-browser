+
+inline constexpr char kHubClaudeMd[] = R"meridian(# CLAUDE.md
+
+All instructions for agents live in [AGENTS.md](AGENTS.md). Read it first and follow it.
+
+@AGENTS.md
+)meridian";
+
+inline constexpr char kHubGitignore[] = R"meridian(# OS / editors
+.DS_Store
+Thumbs.db
+.idea/
+.vscode/
+*.swp
+
+# Secrets never go into git — keep them in the Meridian vault (they reach agents as env vars)
+.env
+.env.*
+!.env.example
+*.pem
+id_rsa*
+)meridian";
+
