+
+namespace meridian::workbench {
+
+// Context Insights: what a Claude Code session's context holds and where its
+// tokens (so its usage limits) went, from the session's transcript (JSONL).
+// Read on this computer; nothing leaves it. Sizes of text are estimates
+// (about 4 characters a token); the API's own counts are exact.
+class ContextInsights {
+ public:
+  ContextInsights();
+  ContextInsights(const ContextInsights&) = delete;
+  ContextInsights& operator=(const ContextInsights&) = delete;
+  ContextInsights& operator=(ContextInsights&&);
+  ~ContextInsights();
+
+  // Reads what was added to `path` since the last call (the whole file the
+  // first time; from the start again if it got shorter).
+  void ReadMore(const base::FilePath& path);
+  // One transcript line.
+  void Feed(std::string_view line);
+  // The analysis. `context_size`: the model's window, if known (else
+  // guessed from the largest context seen).
+  base::DictValue Result(std::optional<double> context_size) const;
+
+ private:
+  struct Request {
+    double ts = 0;
+    double input = 0;
+    double cache_read = 0;
+    double cache_write = 0;
+    double cache_write_1h = 0;
+    double output = 0;
+    double context() const { return input + cache_read + cache_write; }
+  };
+  struct ToolCall {
+    std::string name;
+    std::string target;
+    double tokens = 0;
+    bool images = false;
+    // The main request it entered (-1 until its result comes).
+    int entered = -1;
+    int prompt = -1;
+    bool sidechain = false;
+  };
+  struct Compaction {
+    double ts = 0;
+    double pre = 0;
+    double post = 0;
+    std::string trigger;
+    int at = 0;
+  };
+  struct Prompt {
+    double ts = 0;
+    std::string text;
+    int first_request = 0;
+  };
+
+  void FeedAssistant(const base::DictValue& entry, bool sidechain);
+  void FeedUser(const base::DictValue& entry, bool sidechain);
+  void FeedAttachment(const base::DictValue& entry);
+  void FeedShape(const base::DictValue& entry);
+
+  int64_t offset_ = 0;
+  std::string partial_;
+  std::vector<Request> requests_;
+  Request subagents_;
+  int subagent_requests_ = 0;
+  std::set<std::string> seen_requests_;
+  std::map<std::string, ToolCall> calls_;
+  std::vector<std::string> call_order_;
+  std::vector<Compaction> compactions_;
+  std::vector<Prompt> prompts_;
+  std::string model_;
+  // From the latest request shape: the system prompt and each tool's
+  // definition, in characters.
+  double system_chars_ = 0;
+  std::map<std::string, double> tool_chars_;
+  double skills_chars_ = 0;
+  std::map<std::string, double> memory_chars_;
+  double mcp_instructions_chars_ = 0;
+  base::DictValue model_costs_;
+  double total_cost_ = 0;
+};
+
+}  // namespace meridian::workbench
+
+#endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_CONTEXT_INSIGHTS_H_
