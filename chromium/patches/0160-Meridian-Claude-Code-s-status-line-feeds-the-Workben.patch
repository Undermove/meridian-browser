+// What a token costs against usage limits, relative to plain input: the
+// API's price ratios (cache reads a tenth, 5-minute cache writes 1.25×,
+// 1-hour writes 2×, output 5×).
+constexpr double kRead = 0.1;
+constexpr double kWrite5m = 1.25;
+constexpr double kWrite1h = 2.0;
+constexpr double kOutput = 5.0;
+// An image in a tool result, roughly (a screenshot near the size limit).
+constexpr double kImageTokens = 1600;
+// A pause after which a 5-minute cache has gone cold.
+constexpr double kColdAfter = 300;
+
+double Tokens(double chars) {
+  return std::round(chars / 4);
+}
+
+double Ts(const base::DictValue& entry) {
+  const std::string* ts = entry.FindString("timestamp");
+  base::Time t;
+  if (!ts || !base::Time::FromUTCString(ts->c_str(), &t)) {
+    return 0;
+  }
+  return t.InSecondsFSinceUnixEpoch();
+}
+
+double Num(const base::DictValue* d, const char* key) {
+  if (!d) {
+    return 0;
+  }
+  const base::Value* v = d->Find(key);
+  return v && (v->is_int() || v->is_double()) ? v->GetDouble() : 0;
+}
+
+std::string Short(std::string_view s, size_t n) {
+  std::string out;
+  for (char c : s) {
+    out += static_cast<unsigned char>(c) < 0x20 ? ' ' : c;
+    if (out.size() >= n) {
+      break;
+    }
+  }
+  if (out.size() >= n) {
+    while (!out.empty() && (out.back() & 0xc0) == 0x80) {
+      out.pop_back();
+    }
+    if (!out.empty()) {
+      out.pop_back();
+    }
+    out += "…";
+  }
+  return std::string(base::TrimWhitespaceASCII(out, base::TRIM_ALL));
+}
+
+// What a tool call works on: a file, a command, a host, a pattern.
+std::string TargetOf(const std::string& tool, const base::DictValue& input) {
+  for (const char* key : {"file_path", "notebook_path"}) {
+    if (const std::string* v = input.FindString(key)) {
+      return Short(*v, 160);
+    }
+  }
+  if (const std::string* v = input.FindString("command")) {
+    return "$ " + Short(*v, 80);
+  }
+  if (const std::string* v = input.FindString("url")) {
+    GURL url(*v);
+    return url.is_valid() ? Short(std::string(url.host()) + std::string(url.path()), 80) : Short(*v, 80);
+  }
+  for (const char* key :
+       {"pattern", "query", "description", "skill", "path", "selector"}) {
+    if (const std::string* v = input.FindString(key)) {
+      return Short(*v, 80);
+    }
+  }
+  return std::string();
+}
+
+// The characters (and images) of a tool result's content.
+std::pair<double, int> ContentSize(const base::Value* content) {
+  if (!content) {
+    return {0, 0};
+  }
+  if (content->is_string()) {
+    return {static_cast<double>(content->GetString().size()), 0};
+  }
+  double chars = 0;
+  int images = 0;
+  if (content->is_list()) {
+    for (const base::Value& block : content->GetList()) {
+      if (!block.is_dict()) {
+        continue;
+      }
+      const std::string* type = block.GetDict().FindString("type");
+      if (type && *type == "image") {
+        images++;
+      } else if (const std::string* text = block.GetDict().FindString("text")) {
+        chars += text->size();
+      } else if (const base::Value* inner = block.GetDict().Find("content")) {
+        auto [c, i] = ContentSize(inner);
+        chars += c;
+        images += i;
+      }
+    }
+  }
+  return {chars, images};
+}
+
+double Weighted(double input,
+                double read,
+                double write5m,
+                double write1h,
+                double output) {
+  return input + read * kRead + write5m * kWrite5m + write1h * kWrite1h +
+         output * kOutput;
+}
+
+base::DictValue Insight(const char* level,
+                        std::string title,
+                        std::string detail,
+                        double share) {
+  return base::DictValue()
+      .Set("level", level)
+      .Set("title", std::move(title))
+      .Set("detail", std::move(detail))
+      .Set("share", share);
+}
+
+std::string K(double tokens) {
+  if (tokens >= 1e6) {
+    return base::NumberToString(std::round(tokens / 1e5) / 10) + "M";
+  }
+  if (tokens >= 1000) {
+    return base::NumberToString(std::round(tokens / 100) / 10) + "k";
+  }
+  return base::NumberToString(static_cast<int>(tokens));
+}
+
+std::string Pct(double share) {
+  return base::NumberToString(static_cast<int>(std::round(share * 100))) + "%";
+}
