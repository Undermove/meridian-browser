+// ---- Status line (`--mission-hook --status-line`) ----
+
+std::optional<double> Num(const base::DictValue& d, std::string_view path) {
+  const base::Value* v = d.FindByDottedPath(path);
+  if (!v || !(v->is_int() || v->is_double())) {
+    return std::nullopt;
+  }
+  return v->GetDouble();
+}
+
+void SetNum(base::DictValue& out,
+            const char* key,
+            const base::DictValue& in,
+            std::string_view path) {
+  if (std::optional<double> v = Num(in, path)) {
+    out.Set(key, *v);
+  }
+}
+
+// A short cause name (prompt cache misses): letters, digits and _ only.
+std::optional<std::string> CauseName(std::string_view s) {
+  if (s.empty() || s.size() > 40) {
+    return std::nullopt;
+  }
+  for (char c : s) {
+    if (!base::IsAsciiAlphaNumeric(c) && c != '_') {
+      return std::nullopt;
+    }
+  }
+  return std::string(s);
+}
+
+// The settings file a status line of the person's own comes from: the
+// project's (local first), then their user settings. The session's
+// --settings (Meridian's) outranks them all, so Meridian runs theirs.
+std::optional<std::string> OwnStatusLine(const std::string& project_dir) {
+  std::vector<base::FilePath> files;
+  if (!project_dir.empty()) {
+    base::FilePath p = base::FilePath::FromUTF8Unsafe(project_dir)
+                           .AppendASCII(".claude");
+    files.push_back(p.AppendASCII("settings.local.json"));
+    files.push_back(p.AppendASCII("settings.json"));
+  }
+  if (const char* dir = getenv("CLAUDE_CONFIG_DIR"); dir && *dir) {
+    files.push_back(base::FilePath::FromUTF8Unsafe(dir).AppendASCII(
+        "settings.json"));
+  } else if (const char* home = getenv("HOME"); home && *home) {
+    files.push_back(base::FilePath::FromUTF8Unsafe(home)
+                        .AppendASCII(".claude")
+                        .AppendASCII("settings.json"));
+  }
+  for (const base::FilePath& file : files) {
+    std::string text;
+    if (!base::ReadFileToStringWithMaxSize(file, &text, 1 << 20)) {
+      continue;
+    }
+    std::optional<base::Value> v =
+        base::JSONReader::Read(text, base::JSON_ALLOW_TRAILING_COMMAS);
+    if (!v || !v->is_dict()) {
+      continue;
+    }
+    const base::DictValue* line = v->GetDict().FindDict("statusLine");
+    const std::string* command = line ? line->FindString("command") : nullptr;
+    if (command && !command->empty() &&
+        command->find("--mission-hook") == std::string::npos) {
+      return *command;
+    }
+  }
+  return std::nullopt;
+}
+
+#if BUILDFLAG(IS_POSIX)
+// Runs `command` in the shell with `input` on stdin; its stdout.
+std::string RunShell(const std::string& command, const std::string& input) {
+  int in[2], out[2];
+  if (pipe(in) != 0) {
+    return std::string();
+  }
+  if (pipe(out) != 0) {
+    close(in[0]);
+    close(in[1]);
+    return std::string();
+  }
+  pid_t pid = fork();
+  if (pid < 0) {
+    close(in[0]); close(in[1]); close(out[0]); close(out[1]);
+    return std::string();
+  }
+  if (pid == 0) {
+    dup2(in[0], 0);
+    dup2(out[1], 1);
+    close(in[0]); close(in[1]); close(out[0]); close(out[1]);
+    execl("/bin/sh", "sh", "-c", command.c_str(), static_cast<char*>(nullptr));
+    _exit(127);
+  }
+  close(in[0]);
+  close(out[1]);
+  std::string_view rest(input);
+  while (!rest.empty()) {
+    ssize_t n = write(in[1], rest.data(), rest.size());
+    if (n <= 0) {
+      break;
+    }
+    rest.remove_prefix(static_cast<size_t>(n));
+  }
+  close(in[1]);
+  std::string result;
+  char buf[4096];
+  for (ssize_t n; (n = read(out[0], buf, sizeof(buf))) > 0;) {
+    // SAFETY: read() filled `n` bytes of `buf`.
+    result.append(UNSAFE_BUFFERS(std::string_view(buf, static_cast<size_t>(n))));
+    if (result.size() > 64 * 1024) {
+      break;
+    }
+  }
+  close(out[0]);
+  int status = 0;
+  waitpid(pid, &status, 0);
+  return result;
+}
+#endif
+
+// Meridian's own line, when the person has none: context and limits.
+std::string DefaultStatusLine(const base::DictValue& line) {
+  std::string out;
+  auto pct = [](double v) {
+    return base::NumberToString(static_cast<int>(v + 0.5)) + "%";
+  };
+  if (std::optional<double> v = line.FindDouble("context_pct")) {
+    out += "context " + pct(*v);
+  }
+  if (std::optional<double> v = line.FindDouble("five_hour_pct")) {
+    out += (out.empty() ? "" : " · ") + std::string("5h limit ") + pct(*v);
+  }
+  if (std::optional<double> v = line.FindDouble("seven_day_pct")) {
+    out += (out.empty() ? "" : " · ") + std::string("week ") + pct(*v);
+  }
+  return out;
+}
+
 }  // namespace
 
+base::DictValue FromStatusLine(const base::DictValue& in) {
+  base::DictValue out;
+  out.Set("kind", "claude");
+  out.Set("event", "Status");
+  SetIf(out, "session_id", Str(in.Find("session_id"), 80));
+  SetIf(out, "session_name", Str(in.Find("session_name"), 80));
+  SetIf(out, "model", Str(in.FindByDottedPath("model.display_name"), 60));
+  SetIf(out, "version", Str(in.Find("version"), 30));
+  // Its own transcript: read by Meridian for Context Insights, on this
+  // computer; never shown.
+  SetIf(out, "transcript_path", Str(in.Find("transcript_path"), 1024));
+  SetNum(out, "context_pct", in, "context_window.used_percentage");
+  SetNum(out, "context_size", in, "context_window.context_window_size");
+  if (std::optional<double> input = Num(in, "context_window.current_usage.input_tokens")) {
+    out.Set("context_tokens",
+            *input +
+                Num(in, "context_window.current_usage.cache_creation_input_tokens").value_or(0) +
+                Num(in, "context_window.current_usage.cache_read_input_tokens").value_or(0));
+  }
+  SetNum(out, "five_hour_pct", in, "rate_limits.five_hour.used_percentage");
+  SetNum(out, "five_hour_reset", in, "rate_limits.five_hour.resets_at");
+  SetNum(out, "seven_day_pct", in, "rate_limits.seven_day.used_percentage");
+  SetNum(out, "seven_day_reset", in, "rate_limits.seven_day.resets_at");
+  SetNum(out, "spend_pct", in, "rate_limits.spend_limit.used_percentage");
+  SetNum(out, "spend_reset", in, "rate_limits.spend_limit.resets_at");
+  SetNum(out, "spend_usd", in, "rate_limits.spend_limit.used_usd");
+  SetNum(out, "spend_limit_usd", in, "rate_limits.spend_limit.limit_usd");
+  SetIf(out, "spend_period", Str(in.FindByDottedPath("rate_limits.spend_limit.period"), 10));
+  SetNum(out, "cost_usd", in, "cost.total_cost_usd");
+  SetNum(out, "duration_ms", in, "cost.total_duration_ms");
+  SetNum(out, "api_ms", in, "cost.total_api_duration_ms");
+  SetNum(out, "lines_added", in, "cost.total_lines_added");
+  SetNum(out, "lines_removed", in, "cost.total_lines_removed");
+  if (const base::DictValue* cache = in.FindDict("prompt_cache")) {
+    base::DictValue c;
+    for (const char* key :
+         {"requests", "misses", "expected_rebuilds", "hit_ratio",
+          "cache_write_tokens", "miss_recache_tokens", "expires_at",
+          "recache_tokens_if_cold", "last_miss_at"}) {
+      SetNum(c, key, *cache, key);
+    }
+    if (std::optional<bool> warm = cache->FindBool("warm")) {
+      c.Set("warm", *warm);
+    }
+    SetIf(c, "ttl", Str(cache->Find("ttl"), 4));
+    if (const base::DictValue* causes = cache->FindDict("miss_causes")) {
+      base::DictValue m;
+      for (const auto [name, count] : *causes) {
+        std::optional<std::string> cause = CauseName(name);
+        if (cause && (count.is_int() || count.is_double()) && m.size() < 20) {
+          m.Set(*cause, count.GetDouble());
+        }
+      }
+      c.Set("miss_causes", std::move(m));
+    }
+    out.Set("cache", std::move(c));
+  }
+  return out;
+}
