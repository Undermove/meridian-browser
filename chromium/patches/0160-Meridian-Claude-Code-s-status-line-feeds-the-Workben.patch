+ContextInsights::ContextInsights() = default;
+ContextInsights::~ContextInsights() = default;
+
+void ContextInsights::ReadMore(const base::FilePath& path) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return;
+  }
+  int64_t length = file.GetLength();
+  if (length < offset_) {
+    // Rewritten: start over.
+    *this = ContextInsights();
+  }
+  file.Seek(base::File::FROM_BEGIN, offset_);
+  std::vector<char> buf(1 << 20);
+  while (offset_ < length) {
+    std::optional<size_t> n = file.ReadAtCurrentPos(base::as_writable_byte_span(buf));
+    if (!n || *n == 0) {
+      break;
+    }
+    offset_ += static_cast<int64_t>(*n);
+    std::string_view chunk =
+        base::as_string_view(base::span(buf).first(*n));
+    size_t start = 0;
+    for (size_t nl; (nl = chunk.find('\n', start)) != std::string_view::npos;
+         start = nl + 1) {
+      if (partial_.empty()) {
+        Feed(chunk.substr(start, nl - start));
+      } else {
+        partial_.append(chunk.substr(start, nl - start));
+        Feed(partial_);
+        partial_.clear();
+      }
+    }
+    partial_.append(chunk.substr(start));
+    // A line too long to matter (a request body): dropped.
+    if (partial_.size() > (64u << 20)) {
+      partial_.clear();
+    }
+  }
+}
+
+ContextInsights& ContextInsights::operator=(ContextInsights&&) = default;
+
+void ContextInsights::Feed(std::string_view line) {
+  // Request bodies and request metadata: large, and nothing here needs them.
+  if (line.starts_with("{\"type\":\"api-request-blob\"") ||
+      (line.starts_with("{\"type\":\"api-request\"") &&
+       !line.starts_with("{\"type\":\"api-request-shape\""))) {
+    return;
+  }
+  std::optional<base::Value> v = base::JSONReader::Read(line, 0);
+  if (!v || !v->is_dict()) {
+    return;
+  }
+  const base::DictValue& entry = v->GetDict();
+  const std::string* type = entry.FindString("type");
+  if (!type) {
+    return;
+  }
+  bool sidechain = entry.FindBool("isSidechain").value_or(false);
+  if (*type == "assistant") {
+    FeedAssistant(entry, sidechain);
+  } else if (*type == "user") {
+    FeedUser(entry, sidechain);
+  } else if (*type == "attachment") {
+    FeedAttachment(entry);
+  } else if (*type == "api-request-shape") {
+    FeedShape(entry);
+  } else if (*type == "system") {
+    const std::string* subtype = entry.FindString("subtype");
+    if (subtype && *subtype == "compact_boundary" && !sidechain) {
+      const base::DictValue* meta = entry.FindDict("compactMetadata");
+      Compaction c;
+      c.ts = Ts(entry);
+      c.pre = Num(meta, "preTokens");
+      c.post = Num(meta, "postTokens");
+      const std::string* trigger = meta ? meta->FindString("trigger") : nullptr;
+      c.trigger = trigger ? Short(*trigger, 20) : std::string();
+      c.at = static_cast<int>(requests_.size());
+      compactions_.push_back(std::move(c));
+    }
+  } else if (*type == "cost-state") {
+    total_cost_ = Num(&entry, "totalCostUSD");
+    model_costs_.clear();
+    if (const base::DictValue* models = entry.FindDict("modelUsage")) {
+      for (const auto [name, usage] : *models) {
+        if (usage.is_dict()) {
+          model_costs_.Set(Short(name, 60), Num(&usage.GetDict(), "costUSD"));
+        }
+      }
+    }
+  }
+}
+
+void ContextInsights::FeedAssistant(const base::DictValue& entry,
+                                    bool sidechain) {
+  const base::DictValue* message = entry.FindDict("message");
+  if (!message) {
+    return;
+  }
+  const std::string* request_id = entry.FindString("requestId");
+  const std::string* message_id = message->FindString("id");
+  std::string key = request_id ? *request_id : message_id ? *message_id : "";
+  const base::DictValue* usage = message->FindDict("usage");
+  if (usage && !key.empty() && seen_requests_.insert(key).second) {
+    Request r;
+    r.ts = Ts(entry);
+    r.input = Num(usage, "input_tokens");
+    r.cache_read = Num(usage, "cache_read_input_tokens");
+    r.cache_write = Num(usage, "cache_creation_input_tokens");
+    r.cache_write_1h = Num(usage->FindDict("cache_creation"),
+                           "ephemeral_1h_input_tokens");
+    r.output = Num(usage, "output_tokens");
+    if (sidechain) {
+      subagents_.input += r.input;
+      subagents_.cache_read += r.cache_read;
+      subagents_.cache_write += r.cache_write;
+      subagents_.cache_write_1h += r.cache_write_1h;
+      subagents_.output += r.output;
+      subagent_requests_++;
+    } else {
+      requests_.push_back(r);
+      if (const std::string* model = message->FindString("model")) {
+        model_ = Short(*model, 60);
+      }
+    }
+  } else if (usage && !sidechain && !requests_.empty() &&
+             !key.empty()) {
+    // Later lines of the same response: the final output count.
+    requests_.back().output =
+        std::max(requests_.back().output, Num(usage, "output_tokens"));
+  }
+  const base::ListValue* content = message->FindList("content");
+  if (!content) {
+    return;
+  }
+  for (const base::Value& block : *content) {
+    if (!block.is_dict()) {
+      continue;
+    }
+    const base::DictValue& b = block.GetDict();
+    const std::string* type = b.FindString("type");
+    const std::string* id = b.FindString("id");
+    const std::string* name = b.FindString("name");
+    if (!type || *type != "tool_use" || !id || !name ||
+        calls_.contains(*id)) {
+      continue;
+    }
+    ToolCall call;
+    call.name = Short(*name, 80);
+    const base::DictValue* input = b.FindDict("input");
+    call.target = input ? TargetOf(call.name, *input) : std::string();
+    call.sidechain = sidechain;
+    call.prompt = static_cast<int>(prompts_.size()) - 1;
+    calls_[*id] = std::move(call);
+    call_order_.push_back(*id);
+  }
+}
+
+void ContextInsights::FeedUser(const base::DictValue& entry, bool sidechain) {
+  const base::DictValue* message = entry.FindDict("message");
+  if (!message) {
+    return;
+  }
+  const base::Value* content = message->Find("content");
+  bool meta = entry.FindBool("isMeta").value_or(false) ||
+              entry.FindBool("isCompactSummary").value_or(false);
+  auto prompt = [&](std::string_view text) {
+    if (sidechain || meta || text.empty() || text.starts_with("<")) {
+      return;
+    }
+    Prompt p;
+    p.ts = Ts(entry);
+    p.text = Short(text, 120);
+    p.first_request = static_cast<int>(requests_.size());
+    prompts_.push_back(std::move(p));
+  };
+  if (content && content->is_string()) {
+    prompt(content->GetString());
+    return;
+  }
+  if (!content || !content->is_list()) {
+    return;
+  }
+  bool results = false;
+  std::string text;
+  for (const base::Value& block : content->GetList()) {
+    if (!block.is_dict()) {
+      continue;
+    }
+    const base::DictValue& b = block.GetDict();
+    const std::string* type = b.FindString("type");
+    if (type && *type == "tool_result") {
+      results = true;
+      const std::string* id = b.FindString("tool_use_id");
+      auto it = id ? calls_.find(*id) : calls_.end();
+      if (it == calls_.end()) {
+        continue;
+      }
+      auto [chars, images] = ContentSize(b.Find("content"));
+      it->second.tokens = Tokens(chars) + images * kImageTokens;
+      it->second.images = images > 0;
+      if (!sidechain) {
+        it->second.entered = static_cast<int>(requests_.size());
+      }
+    } else if (type && *type == "text" && text.empty()) {
+      if (const std::string* t = b.FindString("text")) {
+        text = *t;
+      }
+    }
+  }
+  if (!results) {
+    prompt(text);
+  }
+}
+
+void ContextInsights::FeedAttachment(const base::DictValue& entry) {
+  const base::DictValue* a = entry.FindDict("attachment");
+  const std::string* type = a ? a->FindString("type") : nullptr;
+  if (!type) {
+    return;
+  }
+  if (*type == "skill_listing") {
+    if (const std::string* content = a->FindString("content")) {
+      if (a->FindBool("isInitial").value_or(false)) {
+        skills_chars_ = content->size();
+      } else {
+        skills_chars_ += content->size();
+      }
+    }
+  } else if (*type == "instructions") {
+    if (const base::ListValue* files = a->FindList("files")) {
+      for (const base::Value& f : *files) {
+        if (!f.is_dict()) {
+          continue;
+        }
+        const std::string* path = f.GetDict().FindString("path");
+        const std::string* content = f.GetDict().FindString("content");
+        if (path && content) {
+          memory_chars_[Short(*path, 200)] = content->size();
+        }
+      }
+    }
+  } else if (*type == "mcp_instructions_delta") {
+    if (const base::ListValue* blocks = a->FindList("addedBlocks")) {
+      for (const base::Value& block : *blocks) {
+        if (block.is_string()) {
+          mcp_instructions_chars_ += block.GetString().size();
+        }
+      }
+    }
+  }
+}
+
+void ContextInsights::FeedShape(const base::DictValue& entry) {
+  const base::DictValue* shape = entry.FindDict("shape");
+  if (!shape) {
+    return;
+  }
+  if (const base::ListValue* system = shape->FindList("system")) {
+    system_chars_ = 0;
+    for (const base::Value& block : *system) {
+      if (block.is_dict()) {
+        if (const std::string* text = block.GetDict().FindString("text")) {
+          system_chars_ += text->size();
+        }
+      }
+    }
+  }
+  if (const base::ListValue* tools = shape->FindList("tools")) {
+    tool_chars_.clear();
+    for (const base::Value& tool : *tools) {
+      if (!tool.is_dict()) {
+        continue;
+      }
+      const std::string* name = tool.GetDict().FindString("name");
+      if (name) {
+        tool_chars_[Short(*name, 120)] =
+            base::WriteJson(tool).value_or("").size();
+      }
+    }
+  }
+}
+
+base::DictValue ContextInsights::Result(
+    std::optional<double> context_size) const {
+  base::DictValue out;
+  double context = requests_.empty() ? 0 : requests_.back().context();
+  double peak = 0;
+  for (const Request& r : requests_) {
+    peak = std::max(peak, r.context());
+  }
+  double size = context_size.value_or(peak > 200000 ? 1000000 : 200000);
+  out.Set("model", model_);
+  out.Set("requests", static_cast<int>(requests_.size()));
+  out.Set("prompts", static_cast<int>(prompts_.size()));
+  out.Set("contextTokens", context);
+  out.Set("contextSize", size);
+  out.Set("costUsd", total_cost_);
+  out.Set("modelCosts", model_costs_.Clone());
+  if (!requests_.empty()) {
+    out.Set("startedAt", requests_.front().ts);
+    out.Set("lastAt", requests_.back().ts);
+  }
+
+  // ---- What the context holds now (estimates, but the total) ----
+  double system = Tokens(system_chars_);
+  double builtin = 0, mcp = 0;
+  std::map<std::string, std::vector<std::pair<std::string, double>>> servers;
+  for (const auto& [name, chars] : tool_chars_) {
+    if (name.starts_with("mcp__")) {
+      mcp += Tokens(chars);
+      size_t sep = name.find("__", 5);
+      std::string server =
+          sep == std::string::npos ? name.substr(5) : name.substr(5, sep - 5);
+      std::string tool =
+          sep == std::string::npos ? name : name.substr(sep + 2);
+      servers[server].emplace_back(tool, Tokens(chars));
+    } else {
+      builtin += Tokens(chars);
+    }
+  }
+  double skills = Tokens(skills_chars_);
+  double memory = 0;
+  base::ListValue memory_files;
+  for (const auto& [path, chars] : memory_chars_) {
+    memory += Tokens(chars);
+    memory_files.Append(
+        base::DictValue().Set("path", path).Set("tokens", Tokens(chars)));
+  }
+  double mcp_instructions = Tokens(mcp_instructions_chars_);
+  double setup = system + builtin + mcp + skills + memory + mcp_instructions;
+  double messages = std::max(0.0, context - setup);
+  out.Set("breakdown",
+          base::DictValue()
+              .Set("systemPrompt", system)
+              .Set("systemTools", builtin)
+              .Set("mcpTools", mcp)
+              .Set("mcpInstructions", mcp_instructions)
+              .Set("skills", skills)
+              .Set("memoryFiles", memory)
+              .Set("messages", messages)
+              .Set("free", std::max(0.0, size - context)));
+  base::ListValue mcp_list;
+  std::vector<std::pair<double, std::string>> server_order;
+  for (const auto& [server, tools] : servers) {
+    double sum = 0;
+    for (const auto& t : tools) {
+      sum += t.second;
+    }
+    server_order.emplace_back(sum, server);
+  }
+  std::sort(server_order.rbegin(), server_order.rend());
+  for (const auto& [sum, server] : server_order) {
+    std::vector<std::pair<std::string, double>> tools = servers.at(server);
+    std::sort(tools.begin(), tools.end(),
+              [](const auto& a, const auto& b) { return a.second > b.second; });
+    base::ListValue list;
+    for (const auto& [tool, tokens] : tools) {
+      list.Append(base::DictValue().Set("name", tool).Set("tokens", tokens));
+    }
+    mcp_list.Append(base::DictValue()
+                        .Set("server", server)
+                        .Set("tokens", sum)
+                        .Set("tools", std::move(list)));
+  }
+  out.Set("mcpServers", std::move(mcp_list));
+  out.Set("memoryFiles", std::move(memory_files));
+
+  // ---- Where the tokens went ----
+  Request total;
+  for (const Request& r : requests_) {
+    total.input += r.input;
+    total.cache_read += r.cache_read;
+    total.cache_write += r.cache_write;
+    total.cache_write_1h += r.cache_write_1h;
+    total.output += r.output;
+  }
+  auto weighted = [](const Request& r) {
+    return Weighted(r.input, r.cache_read, r.cache_write - r.cache_write_1h,
+                    r.cache_write_1h, r.output);
+  };
+  double main_w = weighted(total);
+  double sub_w = weighted(subagents_);
+  double all_w = std::max(1.0, main_w + sub_w);
+  out.Set("spend",
+          base::DictValue()
+              .Set("cacheRead", total.cache_read)
+              .Set("cacheWrite", total.cache_write)
+              .Set("input", total.input)
+              .Set("output", total.output)
+              .Set("subagentTokens", subagents_.context() + subagents_.output)
+              .Set("subagentRequests", subagent_requests_)
+              .Set("weights",
+                   base::DictValue()
+                       .Set("cacheRead", total.cache_read * kRead / all_w)
+                       .Set("cacheWrite",
+                            ((total.cache_write - total.cache_write_1h) *
+                                 kWrite5m +
+                             total.cache_write_1h * kWrite1h) /
+                                all_w)
+                       .Set("input", total.input / all_w)
+                       .Set("output", total.output * kOutput / all_w)
+                       .Set("subagents", sub_w / all_w)));
+
+  // Each tool result: written to the cache once, then read with every
+  // request after it until a compaction drops it.
+  struct Carried {
+    std::string id;
+    int requests;
+    double weight;
+  };
+  std::vector<Carried> carried;
+  std::map<std::string, base::DictValue> by_tool;
+  std::map<std::string, std::pair<int, double>> reads;
+  for (const std::string& id : call_order_) {
+    const ToolCall& c = calls_.at(id);
+    int n = 0;
+    double weight = c.tokens * kWrite5m;
+    if (!c.sidechain && c.entered >= 0) {
+      int end = static_cast<int>(requests_.size());
+      for (const Compaction& k : compactions_) {
+        if (k.at > c.entered) {
+          end = k.at;
+          break;
+        }
+      }
+      n = std::max(0, end - c.entered);
+      weight += c.tokens * n * kRead;
+      carried.push_back({id, n, weight});
+    }
+    base::DictValue& t = by_tool[c.name];
+    t.Set("calls", t.FindInt("calls").value_or(0) + 1);
+    t.Set("tokens", t.FindDouble("tokens").value_or(0) + c.tokens);
+    t.Set("share", t.FindDouble("share").value_or(0) + weight / all_w);
+    if (c.name == "Read" && !c.target.empty()) {
+      reads[c.target].first++;
+      reads[c.target].second += c.tokens;
+    }
+  }
+  std::sort(carried.begin(), carried.end(),
+            [](const Carried& a, const Carried& b) { return a.weight > b.weight; });
+  base::ListValue heavy;
+  for (size_t i = 0; i < carried.size() && i < 12; ++i) {
+    const Carried& c = carried[i];
+    const ToolCall& call = calls_.at(c.id);
+    heavy.Append(base::DictValue()
+                     .Set("tool", call.name)
+                     .Set("target", call.target)
+                     .Set("tokens", call.tokens)
+                     .Set("image", call.images)
+                     .Set("requests", c.requests)
+                     .Set("share", c.weight / all_w));
+  }
+  out.Set("heavyResults", std::move(heavy));
+  std::vector<std::pair<double, std::string>> tool_order;
+  for (const auto& [name, t] : by_tool) {
+    tool_order.emplace_back(t.FindDouble("share").value_or(0), name);
+  }
+  std::sort(tool_order.rbegin(), tool_order.rend());
+  base::ListValue tools;
+  for (size_t i = 0; i < tool_order.size() && i < 12; ++i) {
+    tools.Append(by_tool.at(tool_order[i].second).Clone().Set(
+        "name", tool_order[i].second));
+  }
+  out.Set("tools", std::move(tools));
+  std::vector<std::pair<int, std::string>> reread_order;
+  for (const auto& [path, r] : reads) {
+    if (r.first >= 2) {
+      reread_order.emplace_back(r.first, path);
+    }
+  }
+  std::sort(reread_order.rbegin(), reread_order.rend());
+  base::ListValue rereads;
+  for (size_t i = 0; i < reread_order.size() && i < 10; ++i) {
+    const auto& r = reads.at(reread_order[i].second);
+    rereads.Append(base::DictValue()
+                       .Set("path", reread_order[i].second)
+                       .Set("times", r.first)
+                       .Set("tokens", r.second));
+  }
+  out.Set("rereads", std::move(rereads));
+
+  // A pause long enough for the cache to go cold, then the whole context
+  // written to it again.
+  base::ListValue rebuilds;
+  double rebuilt = 0;
+  int rebuild_count = 0;
+  for (size_t i = 1; i < requests_.size(); ++i) {
+    const Request& r = requests_[i];
+    double gap = r.ts - requests_[i - 1].ts;
+    bool compacted = false;
+    for (const Compaction& k : compactions_) {
+      compacted |= k.at == static_cast<int>(i);
+    }
+    double ttl = r.cache_write_1h > r.cache_write / 2 ? 3600 : kColdAfter;
+    if (!compacted && gap >= ttl && r.cache_write >= 20000) {
+      rebuild_count++;
+      rebuilt += r.cache_write;
+      if (rebuilds.size() < 10) {
+        rebuilds.Append(base::DictValue()
+                            .Set("ts", r.ts)
+                            .Set("pauseMinutes", std::round(gap / 60))
+                            .Set("tokens", r.cache_write));
+      }
+    }
+  }
+  out.Set("coldCache", base::DictValue()
+                           .Set("count", rebuild_count)
+                           .Set("tokens", rebuilt)
+                           .Set("share", rebuilt * kWrite5m / all_w)
+                           .Set("list", std::move(rebuilds)));
+
+  // The prompts that cost the most: every request until the next prompt.
+  struct PromptCost {
+    size_t index;
+    int requests;
+    double weight;
+  };
+  std::vector<PromptCost> prompt_costs;
+  for (size_t p = 0; p < prompts_.size(); ++p) {
+    size_t from = static_cast<size_t>(prompts_[p].first_request);
+    size_t to = p + 1 < prompts_.size()
+                    ? static_cast<size_t>(prompts_[p + 1].first_request)
+                    : requests_.size();
+    double w = 0;
+    for (size_t i = from; i < to && i < requests_.size(); ++i) {
+      w += weighted(requests_[i]);
+    }
+    prompt_costs.push_back({p, static_cast<int>(to > from ? to - from : 0), w});
+  }
+  std::sort(prompt_costs.begin(), prompt_costs.end(),
+            [](const PromptCost& a, const PromptCost& b) {
+              return a.weight > b.weight;
+            });
+  base::ListValue top_prompts;
+  for (size_t i = 0; i < prompt_costs.size() && i < 8; ++i) {
+    const Prompt& p = prompts_[prompt_costs[i].index];
+    top_prompts.Append(base::DictValue()
+                           .Set("text", p.text)
+                           .Set("ts", p.ts)
+                           .Set("requests", prompt_costs[i].requests)
+                           .Set("share", prompt_costs[i].weight / all_w));
+  }
+  out.Set("prompts", std::move(top_prompts));
+
+  // How the context grew (at most 160 points) and where it was compacted.
+  base::ListValue growth;
+  size_t step = std::max<size_t>(1, requests_.size() / 160);
+  for (size_t i = 0; i < requests_.size(); i += step) {
+    growth.Append(base::DictValue()
+                      .Set("ts", requests_[i].ts)
+                      .Set("tokens", requests_[i].context()));
+  }
+  if (!requests_.empty() && (requests_.size() - 1) % step) {
+    growth.Append(base::DictValue()
+                      .Set("ts", requests_.back().ts)
+                      .Set("tokens", requests_.back().context()));
+  }
+  out.Set("growth", std::move(growth));
+  base::ListValue compactions;
+  for (const Compaction& c : compactions_) {
+    compactions.Append(base::DictValue()
+                           .Set("ts", c.ts)
+                           .Set("before", c.pre)
+                           .Set("after", c.post)
+                           .Set("trigger", c.trigger));
+  }
+  out.Set("compactions", std::move(compactions));
+
+  // ---- What to do about it ----
+  base::ListValue insights;
+  if (context >= size * 0.7) {
+    insights.Append(Insight(
+        "warn", "The context is " + Pct(context / size) + " full",
+        "Every request sends all of it again. Run /compact with a note on "
+        "what to keep, or start a new session for the next task.",
+        context / size));
+  }
+  if (compactions_.size() >= 2) {
+    insights.Append(Insight(
+        "info",
+        "Compacted " + base::NumberToString(compactions_.size()) + " times",
+        "A long session: each summary loses detail and the context fills "
+        "again. A fresh session per task keeps it small.",
+        0.05 * static_cast<double>(compactions_.size())));
+  }
+  std::set<std::string> told;
+  for (size_t i = 0, shown = 0; i < carried.size() && shown < 3; ++i) {
+    const Carried& c = carried[i];
+    const ToolCall* call = &calls_.at(c.id);
+    double share = c.weight / all_w;
+    if (share < 0.03 || call->tokens < 2000) {
+      break;
+    }
+    // One insight per file or command: the heaviest time.
+    if (!call->target.empty() && !told.insert(call->name + call->target).second) {
+      continue;
+    }
+    shown++;
+    std::string what = call->name +
+                       (call->target.empty() ? "" : " " + call->target);
+    std::string tip =
+        call->images ? "Screenshots are heavy: read the page as text "
+                         "where that's enough, or capture a smaller area."
+        : call->name == "Bash"
+            ? "Long command output: pipe it through tail, head or grep."
+        : call->name == "Read"
+            ? "A long file: read the part needed (offset and limit)."
+            : "A large result stays in the context until the next "
+              "compaction.";
+    insights.Append(Insight(
+        "warn",
+        what.size() > 90 ? what.substr(0, 90) + "…" : what,
+        "≈" + K(call->tokens) + " tokens, sent again in " +
+            base::NumberToString(c.requests) + " requests after it (" +
+            Pct(share) + " of this session's usage). " + tip,
+        share));
+  }
+  for (size_t i = 0; i < reread_order.size() && i < 2; ++i) {
+    const auto& r = reads.at(reread_order[i].second);
+    if (r.first < 3) {
+      break;
+    }
+    insights.Append(Insight(
+        "info",
+        "Read " + base::NumberToString(r.first) + " times: " +
+            reread_order[i].second,
+        "≈" + K(r.second) + " tokens in all. Each read adds the file to the "
+        "context again; a note of what matters in it, or CLAUDE.md, saves "
+        "the rereads.",
+        r.second * kWrite5m / all_w));
+  }
+  if (rebuild_count > 0 && rebuilt * kWrite5m / all_w >= 0.03) {
+    insights.Append(Insight(
+        "warn",
+        "The cache went cold " + base::NumberToString(rebuild_count) +
+            (rebuild_count == 1 ? " time" : " times"),
+        "After a pause of 5 minutes or more the whole context (" + K(rebuilt) +
+            " tokens in all) was written to the cache again, at 12× the price "
+            "of reading it. /compact before a long break makes the next "
+            "rewrite smaller.",
+        rebuilt * kWrite5m / all_w));
+  }
+  if (mcp >= size * 0.05 || (context > 0 && mcp >= context * 0.15)) {
+    std::string biggest = server_order.empty() ? "" : server_order[0].second;
+    insights.Append(Insight(
+        "info", "MCP tools take ≈" + K(mcp) + " tokens of every request",
+        "Their definitions go with each request" +
+            (biggest.empty() ? std::string(".")
+                             : "; the most from " + biggest + ".") +
+            " Turn off servers this project doesn't use.",
+        // Read from the cache with every request.
+        mcp * static_cast<double>(requests_.size()) * kRead / all_w));
+  }
+  double out_share = total.output * kOutput / all_w;
+  if (out_share >= 0.35) {
+    insights.Append(Insight(
+        "info", "Most of the usage is the model writing (" + Pct(out_share) +
+                    ")",
+        "Output and thinking cost 5× input. A lower effort level (/effort) "
+        "thinks less on simple steps.",
+        out_share));
+  }
+  if (sub_w / all_w >= 0.25) {
+    insights.Append(Insight(
+        "info", "Subagents used " + Pct(sub_w / all_w),
+        base::NumberToString(subagent_requests_) +
+            " requests in subagents. Each starts with its own context; give "
+            "them narrow tasks.",
+        sub_w / all_w));
+  }
+  std::vector<base::Value> sorted;
+  for (base::Value& i : insights) {
+    sorted.push_back(std::move(i));
+  }
+  std::stable_sort(sorted.begin(), sorted.end(),
+                   [](const base::Value& a, const base::Value& b) {
+                     return a.GetDict().FindDouble("share").value_or(0) >
+                            b.GetDict().FindDouble("share").value_or(0);
+                   });
+  base::ListValue sorted_list;
+  for (base::Value& i : sorted) {
+    sorted_list.Append(std::move(i));
+  }
+  out.Set("insights", std::move(sorted_list));
+  return out;
+}
+
+}  // namespace meridian::workbench
