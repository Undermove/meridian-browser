diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index f972a010b4..60867d2d55 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -331,7 +331,7 @@ export class WebuiBrowserAppElement extends CrLitElement {
 
   protected onTabDragMousedown_(e: MouseEvent) {
     if (e.target instanceof TabStripElement) {
-      this.$.tabstrip.dragMouseDown(e);
+      this.$.tabstrip.selectMouseDown(e);
     }
   }
 
diff --git a/chrome/browser/resources/webui_browser/tab_strip/tab_strip.ts b/chrome/browser/resources/webui_browser/tab_strip/tab_strip.ts
index 0cbaa1a47e..5203afc178 100644
--- a/chrome/browser/resources/webui_browser/tab_strip/tab_strip.ts
+++ b/chrome/browser/resources/webui_browser/tab_strip/tab_strip.ts
@@ -481,6 +481,26 @@ export class TabStripElement extends CrLitElement implements
     this.dragDelegate_.onMouseDown(e);
   }
 
+  // Meridian: the tabs are a vertical list, and the stock drag delegate only
+  // knows a horizontal strip (and tears tabs off when the mouse leaves it
+  // vertically). So a press just selects the tab; reordering comes separately.
+  selectMouseDown(e: MouseEvent) {
+    if (e.button !== 0) {
+      return;
+    }
+    const path = e.composedPath();
+    if (path.some(el => el instanceof Element && el.classList.contains('close'))) {
+      return;
+    }
+    const tab = path.find(
+        el => el instanceof Element && el.localName === 'webui-browser-tab') as
+        TabElement | undefined;
+    if (tab) {
+      e.preventDefault();
+      this.activateTab(tab.tabData.id);
+    }
+  }
+
   // DropTargetInterface implementation
   onDragEntered(
       sourceTabIds: NodeId[], localPoint: Point, mouseToTabXRatio: number) {
