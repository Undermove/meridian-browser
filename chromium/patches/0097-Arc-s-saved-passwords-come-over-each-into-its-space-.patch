+// Adds Arc's passwords to one profile's store, keeping the ones already
+// saved there for the same site and username. Deletes itself when done.
+class PasswordAdder : public password_manager::PasswordStoreConsumer {
+ public:
+  PasswordAdder(scoped_refptr<password_manager::PasswordStoreInterface> store,
+                std::vector<StoredCredential> passwords,
+                scoped_refptr<Writer> writer,
+                base::OnceClosure done)
+      : store_(std::move(store)),
+        passwords_(std::move(passwords)),
+        writer_(std::move(writer)),
+        done_(std::move(done)) {
+    store_->GetAllLogins(weak_factory_.GetWeakPtr());
+  }
+
+  void OnGetPasswordStoreResultsOrErrorFrom(
+      password_manager::PasswordStoreInterface* store,
+      base::expected<std::vector<StoredCredential>,
+                     password_manager::PasswordStoreBackendError> results)
+      override {
+    if (!results.has_value()) {
+      writer_->Failed(passwords_.size());
+      Done();
+      return;
+    }
+    std::set<std::pair<std::string, std::u16string>> have;
+    for (const StoredCredential& c : *results) {
+      have.insert({c.signon_realm, c.username_value});
+    }
+    std::vector<StoredCredential> add;
+    for (StoredCredential& c : passwords_) {
+      if (have.insert({c.signon_realm, c.username_value}).second) {
+        add.push_back(std::move(c));
+      }
+    }
+    passwords_.clear();
+    writer_->AddedPasswords(add.size());
+    if (add.empty()) {
+      Done();
+      return;
+    }
+    store_->AddLogins(std::move(add), base::BindOnce(&PasswordAdder::Done,
+                                                     base::Unretained(this)));
+  }
+
+ private:
+  ~PasswordAdder() override = default;
+
+  void Done() {
+    std::move(done_).Run();
+    delete this;
+  }
+
+  scoped_refptr<password_manager::PasswordStoreInterface> store_;
+  std::vector<StoredCredential> passwords_;
+  scoped_refptr<Writer> writer_;
+  base::OnceClosure done_;
+  base::WeakPtrFactory<PasswordAdder> weak_factory_{this};
+};
