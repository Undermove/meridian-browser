+using LoginKey = std::tuple<std::string, GURL, std::u16string, std::u16string,
+                            std::u16string>;
+
+// Reads one Arc "Login Data" database (from a private copy) into passwords.
+// Federated and Android-app sign-ins stay behind.
+bool ReadPasswords(const base::FilePath& db_file,
+                   base::span<const uint8_t> key,
+                   std::set<LoginKey>& seen,
+                   std::vector<StoredCredential>& passwords,
+                   int& failed) {
+  base::ScopedTempDir tmp;
+  sql::Database db(sql::Database::Tag("Passwords"));
+  if (!OpenCopy(db_file, tmp, db) || !db.DoesTableExist("logins")) {
+    return false;
+  }
+  static constexpr base::cstring_view kColumns[] = {
+      "origin_url",          "action_url",     "username_element",
+      "username_value",      "password_element", "password_value",
+      "submit_element",      "signon_realm",   "date_created",
+      "blacklisted_by_user", "scheme",         "times_used",
+      "date_last_used",      "date_password_modified", "federation_url"};
+  sql::Statement s(db.GetUniqueStatement(SelectOf(db, "logins", kColumns)));
+  while (s.Step()) {
+    StoredCredential c;
+    c.url = GURL(s.ColumnString(0));
+    c.action = GURL(s.ColumnString(1));
+    c.username_element = base::UTF8ToUTF16(s.ColumnString(2));
+    c.username_value = base::UTF8ToUTF16(s.ColumnString(3));
+    c.password_element = base::UTF8ToUTF16(s.ColumnString(4));
+    base::span<const uint8_t> enc = s.ColumnBlob(5);
+    c.submit_element = base::UTF8ToUTF16(s.ColumnString(6));
+    c.signon_realm = s.ColumnString(7);
+    c.date_created = FromWindows(s.ColumnInt64(8));
+    c.blocked_by_user = s.ColumnInt64(9);
+    int scheme = s.ColumnInt64(10);
+    c.times_used_in_html_form = s.ColumnInt64(11);
+    c.date_last_used = FromWindows(s.ColumnInt64(12));
+    c.date_password_modified = FromWindows(s.ColumnInt64(13));
+    if (!s.ColumnString(14).empty() || !c.url.SchemeIsHTTPOrHTTPS() ||
+        c.signon_realm.empty() || scheme < 0 || scheme > 2) {
+      continue;
+    }
+    c.scheme = static_cast<PasswordForm::Scheme>(scheme);
+    if (!c.blocked_by_user) {
+      std::optional<std::string> value = Decrypt(enc, key, std::string(), 0);
+      if (!value || value->empty()) {
+        if (!value) {
+          ++failed;
+        }
+        continue;
+      }
+      std::u16string password = base::UTF8ToUTF16(*value);
+      OPENSSL_cleanse(value->data(), value->size());
+      c.password_value = password_manager::PasswordString(std::move(password));
+    }
+    if (!seen.insert({c.signon_realm, c.url, c.username_element,
+                      c.username_value, c.password_element})
+             .second) {
+      continue;  // in both of its databases, or an earlier Arc profile's
+    }
+    if (c.date_created.is_null()) {
+      c.date_created = base::Time::Now();
+    }
+    c.type = PasswordForm::Type::kImported;
+    c.in_store = PasswordForm::Store::kProfileStore;
+    passwords.push_back(std::move(c));
+  }
+  return true;
+}
