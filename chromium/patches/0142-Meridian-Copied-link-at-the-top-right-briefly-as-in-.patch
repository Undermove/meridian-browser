From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 16 Nov 2026 12:46:13 +0400
Subject: [PATCH 143/202] Meridian: "Copied link" at the top right, briefly, as
 in Arc

Plain confirmations slide in at the top right for 1.5 s; an agent's news
stays at the bottom with its Show button.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 .../browser/resources/webui_browser/app.css   | 19 +++++++++++++++++++
 .../resources/webui_browser/app.html.ts       |  3 ++-
 chrome/browser/resources/webui_browser/app.ts |  2 +-
 3 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/resources/webui_browser/app.css b/chrome/browser/resources/webui_browser/app.css
index b2b5763775..2779547c5c 100644
--- a/chrome/browser/resources/webui_browser/app.css
+++ b/chrome/browser/resources/webui_browser/app.css
@@ -706,6 +706,25 @@ cr-icon-button[hidden] {
   font-size: 13px;
 }
 
+/* A plain confirmation ("Copied link"): at the top right, sliding in, as in
+ * Arc. */
+#missionToast.plain {
+  left: auto;
+  right: 14px;
+  top: 12px;
+  bottom: auto;
+  transform: none;
+  font-weight: 550;
+  animation: toast-in 180ms ease-out;
+}
+
+@keyframes toast-in {
+  from {
+    opacity: 0;
+    transform: translateX(24px);
+  }
+}
+
 #missionToast .mt-title {
   overflow: hidden;
   text-overflow: ellipsis;
diff --git a/chrome/browser/resources/webui_browser/app.html.ts b/chrome/browser/resources/webui_browser/app.html.ts
index a631ec5547..ae1d3f3f58 100644
--- a/chrome/browser/resources/webui_browser/app.html.ts
+++ b/chrome/browser/resources/webui_browser/app.html.ts
@@ -172,7 +172,8 @@ export function getHtml(this: WebuiBrowserAppElement) {
       @meridian-mission-workbench="${this.onMeridianMissionWorkbench_}">
   </meridian-mission>
   ${this.missionToast_ ? html`
-    <div id="missionToast" role="status">
+    <div id="missionToast" role="status"
+        class="${this.missionToast_.nodeId ? '' : 'plain'}">
       <span class="mt-title">${this.missionToast_.title}</span>
       ${this.missionToast_.nodeId ? html`
         <button id="missionToastShow"
diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index 6e2d119a4b..5d240235a2 100644
--- a/chrome/browser/resources/webui_browser/app.ts
+++ b/chrome/browser/resources/webui_browser/app.ts
@@ -820,7 +820,7 @@ export class WebuiBrowserAppElement extends CrLitElement {
     }
     // A plain confirmation ("Copied link") goes sooner than an agent's news.
     this.missionToastTimer_ = setTimeout(
-        () => this.missionToast_ = null, e.detail.nodeId ? 8000 : 1800);
+        () => this.missionToast_ = null, e.detail.nodeId ? 8000 : 1500);
   }
 
   protected onMissionToastShowClick_() {
