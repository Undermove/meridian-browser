index 0000000000..fbb2f8ce3b
--- /dev/null
+++ b/chrome/browser/meridian/clean_url_unittest.cc
@@ -0,0 +1,33 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/clean_url.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace meridian {
+namespace {
+
+std::string Clean(const char* url) {
+  return WithoutTracking(GURL(url)).spec();
+}
+
+TEST(CleanUrlTest, DropsTrackingKeepsTheRest) {
+  EXPECT_EQ(Clean("https://example.com/a?utm_source=x&id=7&utm_medium=y"),
+            "https://example.com/a?id=7");
+  EXPECT_EQ(Clean("https://example.com/?fbclid=abc"), "https://example.com/");
+  EXPECT_EQ(Clean("https://example.com/p?gclid=1&q=a%20b#top"),
+            "https://example.com/p?q=a%20b#top");
+  EXPECT_EQ(Clean("https://youtu.be/xyz?si=share&t=42"),
+            "https://youtu.be/xyz?t=42");
+  // "si" is YouTube's; elsewhere it may mean something.
+  EXPECT_EQ(Clean("https://example.com/?si=1"), "https://example.com/?si=1");
+  EXPECT_EQ(Clean("https://example.com/?a=1&b"), "https://example.com/?a=1&b");
+  EXPECT_EQ(Clean("chrome://settings/?utm_source=x"),
+            "chrome://settings/?utm_source=x");
+}
+
+}  // namespace
+}  // namespace meridian
