diff --git a/chrome/browser/meridian/clean_url.cc b/chrome/browser/meridian/clean_url.cc
new file mode 100644
index 0000000000..1962df51ca
--- /dev/null
+++ b/chrome/browser/meridian/clean_url.cc
@@ -0,0 +1,67 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/meridian/clean_url.h"
+
+#include <string>
+#include <string_view>
+
+#include "base/containers/fixed_flat_set.h"
+#include "base/strings/string_util.h"
+#include "net/base/url_util.h"
+#include "url/gurl.h"
+
+namespace meridian {
+
+namespace {
+
+bool IsTracking(std::string_view key) {
+  static constexpr auto kKeys = base::MakeFixedFlatSet<std::string_view>({
+      "_hsenc", "_hsmi", "dclid", "fbclid", "gbraid", "gclid", "gclsrc",
+      "igsh", "igshid", "mc_cid", "mc_eid", "mkt_tok", "msclkid", "oly_anon_id",
+      "oly_enc_id", "rb_clickid", "s_cid", "twclid", "vero_id", "wbraid",
+      "yclid",
+  });
+  return base::StartsWith(key, "utm_") || kKeys.contains(key);
+}
+
+}  // namespace
+
+GURL WithoutTracking(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS() || !url.has_query()) {
+    return url;
+  }
+  std::string query;
+  bool removed = false;
+  for (net::QueryIterator it(url); !it.IsAtEnd(); it.Advance()) {
+    std::string_view key = it.GetKey();
+    // YouTube's share id ("si") says who shared the link.
+    if (IsTracking(key) ||
+        (key == "si" && (url.DomainIs("youtube.com") ||
+                         url.DomainIs("youtu.be")))) {
+      removed = true;
+      continue;
+    }
+    if (!query.empty()) {
+      query += '&';
+    }
+    query += key;
+    if (!it.GetValue().empty()) {
+      query += '=';
+      query += it.GetValue();
+    }
+  }
+  if (!removed) {
+    return url;
+  }
+  GURL::Replacements replacements;
+  if (query.empty()) {
+    replacements.ClearQuery();
+  } else {
+    replacements.SetQueryStr(query);
+  }
+  return url.ReplaceComponents(replacements);
+}
+
+}  // namespace meridian
