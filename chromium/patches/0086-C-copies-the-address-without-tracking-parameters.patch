+namespace {
+
+// The active tab's address, without tracking parameters, to the clipboard.
+void CopyActiveLink(BrowserWindowInterface* browser) {
+  tabs::TabInterface* tab = browser->GetActiveTabInterface();
+  if (!tab) {
+    return;
+  }
+  ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+      .WriteText(base::UTF8ToUTF16(
+          WithoutTracking(tab->GetContents()->GetVisibleURL()).spec()));
+  SidebarHandler::ShowToast(browser, "Copied link");
+}
+
+}  // namespace
+
+void SidebarHandler::CopyLink() {
+  CopyActiveLink(browser_);
+}
