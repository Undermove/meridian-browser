+
+/* Drag and drop (Electron: .row.drop-*, .fav.drop-*). */
+.row.dragging,
+.fav.dragging {
+  opacity: 0.4;
+}
+
+.row.drop-before::before,
+.row.drop-after::after {
+  content: '';
+  position: absolute;
+  left: 8px;
+  right: 8px;
+  height: 2px;
+  border-radius: 2px;
+  background: var(--meridian-space);
+}
+
+.row.drop-before::before {
+  top: -1px;
+}
+
+.row.drop-after::after {
+  bottom: -1px;
+}
+
+.row.drop-into {
+  background: color-mix(in srgb, var(--meridian-space) 30%, transparent);
+}
+
+.fav.drop-before {
+  box-shadow: -3px 0 0 var(--meridian-space);
+}
+
+.fav.drop-after {
+  box-shadow: 3px 0 0 var(--meridian-space);
+}
