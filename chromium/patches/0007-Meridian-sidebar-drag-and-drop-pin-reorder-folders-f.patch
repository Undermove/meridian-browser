+  // -------------------------------------------------------- drag & drop
+
+  // What is being dragged: a Today tab or a pinned item / favorite.
+  private drag_: {tab?: NodeId, item?: string, el: HTMLElement}|null = null;
+  private dropMarker_: HTMLElement|null = null;
+
+  private onDragStart_ = (e: DragEvent) => {
+    const el = this.dragSource_(e);
+    if (!el) {
+      return;
+    }
+    this.drag_ = {
+      tab: el.dataset['tab'] || undefined,
+      item: el.dataset['item'] || undefined,
+      el,
+    };
+    el.classList.add('dragging');
+    // Opens the drop zone of empty favorites. Deferred: a layout change in
+    // dragstart can cancel the drag.
+    setTimeout(() => this.toggleAttribute('dragging', !!this.drag_), 0);
+    e.dataTransfer!.effectAllowed = 'move';
+    const url = this.drag_.tab ? this.tabs_.get(this.drag_.tab)?.url :
+                                 this.liveTab(this.drag_.item!)?.url;
+    if (url) {
+      e.dataTransfer!.setData('text/uri-list', url);
+    }
+    e.dataTransfer!.setData('text/x-meridian', '1');
+  };
+
+  private onDragEnd_ = () => {
+    this.drag_?.el.classList.remove('dragging');
+    this.drag_ = null;
+    this.removeAttribute('dragging');
+    this.clearDropMarker_();
+  };
+
+  private dragSource_(e: Event): HTMLElement|null {
+    for (const el of e.composedPath()) {
+      if (el instanceof HTMLElement && el.draggable &&
+          (el.dataset['tab'] || el.dataset['item'])) {
+        return el;
+      }
+    }
+    return null;
+  }
+
+  // Where a drop at the pointer would go.
+  private dropTarget_(e: DragEvent):
+      {el: HTMLElement, pos?: 'before'|'after'|'into', zone?: string}|null {
+    for (const el of e.composedPath()) {
+      if (!(el instanceof HTMLElement)) {
+        continue;
+      }
+      if (el.dataset['fav']) {
+        const r = el.getBoundingClientRect();
+        return {el, pos: e.clientX < r.left + r.width / 2 ? 'before' : 'after'};
+      }
+      if (el.dataset['item'] && el.classList.contains('row')) {
+        const r = el.getBoundingClientRect();
+        const y = (e.clientY - r.top) / r.height;
+        if (el.classList.contains('folder')) {
+          return {el, pos: y < 0.3 ? 'before' : y > 0.7 ? 'after' : 'into'};
+        }
+        return {el, pos: y < 0.5 ? 'before' : 'after'};
+      }
+      if (el.dataset['space'] && el.classList.contains('space-dot')) {
+        return {el, zone: 'space'};
+      }
+      if (el.id === 'favorites') {
+        return {el, zone: 'favorites'};
+      }
+      if (el.id === 'today' || el.id === 'newTabButton' ||
+          el.classList.contains('divider') || el.dataset['tab']) {
+        return {el: this.shadowRoot.getElementById('today')!, zone: 'today'};
+      }
+      if (el.id === 'pinned' || el.classList.contains('space-header')) {
+        return {el: this.shadowRoot.getElementById('pinned')!, zone: 'pinned'};
+      }
+    }
+    return null;
+  }
+
+  private clearDropMarker_() {
+    const m = this.dropMarker_;
+    if (m) {
+      m.classList.remove('drop-before', 'drop-after', 'drop-into',
+                         'drop-target');
+    }
+    this.dropMarker_ = null;
+  }
+
+  private onDragOver_ = (e: DragEvent) => {
+    if (!this.drag_) {
+      return;
+    }
+    const t = this.dropTarget_(e);
+    this.clearDropMarker_();
+    if (!t || t.el === this.drag_.el) {
+      return;
+    }
+    e.preventDefault();
+    e.dataTransfer!.dropEffect = 'move';
+    this.dropMarker_ = t.el;
+    t.el.classList.add(t.pos ? 'drop-' + t.pos : 'drop-target');
+  };
+
+  // The list and index an item sits at, for dropping next to it.
+  private locate_(itemId: string):
+      {container: string, parentId: string, index: number}|null {
+    const find = (items: Item[], container: string, parentId: string):
+        {container: string, parentId: string, index: number}|null => {
+      for (let i = 0; i < items.length; ++i) {
+        if (items[i]!.id === itemId) {
+          return {container, parentId, index: i};
+        }
+        if (items[i]!.isFolder) {
+          const found = find(items[i]!.children, container, items[i]!.id);
+          if (found) {
+            return found;
+          }
+        }
+      }
+      return null;
+    };
+    const state = this.state_;
+    if (!state) {
+      return null;
+    }
+    const fav = find(state.favorites, FAVORITES, '');
+    if (fav) {
+      return fav;
+    }
+    for (const space of state.spaces) {
+      const found = find(space.pinned, space.id, '');
+      if (found) {
+        return found;
+      }
+    }
+    return null;
+  }
+
+  private onDrop_ = (e: DragEvent) => {
+    const drag = this.drag_;
+    if (!drag) {
+      return;
+    }
+    e.preventDefault();
+    const t = this.dropTarget_(e);
+    this.clearDropMarker_();
+    this.removeAttribute('dragging');
+    const space = this.activeSpace();
+    if (!t || !space || t.el === drag.el) {
+      return;
+    }
+    let position: {container: string, parentId: string, index: number}|null =
+        null;
+    if (t.zone === 'today') {
+      // Back to Today: unpin (the tab, if open, stays).
+      if (drag.item) {
+        this.handler_.removeItem(drag.item);
+      }
+      return;
+    }
+    if (t.zone === 'space') {
+      const target = t.el.dataset['space']!;
+      if (drag.tab) {
+        this.handler_.moveTabToSpace(drag.tab, target);
+      } else if (drag.item) {
+        this.handler_.moveItem(
+            drag.item, {container: target, parentId: '', index: -1});
+      }
+      return;
+    }
+    if (t.zone === 'favorites') {
+      position = {container: FAVORITES, parentId: '', index: -1};
+    } else if (t.zone === 'pinned') {
+      position = {container: space.id, parentId: '', index: -1};
+    } else if (t.pos === 'into') {
+      position = {container: space.id, parentId: t.el.dataset['item']!,
+                  index: 0};
+    } else {
+      const ref = this.locate_(t.el.dataset['item']!);
+      if (!ref) {
+        return;
+      }
+      position = {...ref, index: ref.index + (t.pos === 'after' ? 1 : 0)};
+      // Moving down within the same list: the item leaves its old slot first.
+      if (drag.item) {
+        const from = this.locate_(drag.item);
+        if (from && from.container === ref.container &&
+            from.parentId === ref.parentId && from.index < position.index) {
+          position.index--;
+        }
+      }
+    }
+    if (drag.tab) {
+      this.handler_.pinTab(drag.tab, position);
+    } else if (drag.item && drag.item !== t.el.dataset['item']) {
+      this.handler_.moveItem(drag.item, position);
+    }
+  };
+
   // ----------------------------------------------------------- commands
 
   // What ⌘1-9 and ⌃Tab walk through, top to bottom: favorites, the space's
@@ -427,10 +633,10 @@ export class MeridianSidebarElement extends CrLitElement implements
   // ------------------------------------------------------------ actions
 
   onTabMouseDown(e: MouseEvent, tab: Tab) {
+    // No preventDefault(): it would stop the row from being dragged.
     if (e.button !== 0 || this.isButton_(e)) {
       return;
     }
-    e.preventDefault();
     this.tabStripService_.activateTab(tab.id);
   }
 
@@ -438,7 +644,6 @@ export class MeridianSidebarElement extends CrLitElement implements
     if (e.button !== 0 || this.isButton_(e) || this.renaming_ === item.id) {
       return;
     }
-    e.preventDefault();
     if (item.isFolder) {
       this.handler_.setFolderOpen(item.id, !item.open);
       return;
