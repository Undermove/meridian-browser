     this.showingSidePanel_ = false;
   }
 
+  // The ⌘S choice of the window, while full screen hides the sidebar.
+  private sidebarHiddenOutsideFullscreen_: boolean|null = null;
+
   protected onFullscreenModeChanged_(
       isFullscreen: boolean, context: FullscreenContext|null) {
+    this.updateFullscreenMode_(isFullscreen, context);
+    // Arc: full screen hides the sidebar; it slides over the page from the
+    // left edge, as after ⌘S. Leaving it brings back the window's own choice.
+    if (this.fullscreenMode_ === 'browser' &&
+        this.sidebarHiddenOutsideFullscreen_ === null) {
+      this.sidebarHiddenOutsideFullscreen_ = this.sidebarHidden_;
+      this.closeSiteControl_();
+      this.sidebarHidden_ = true;
+      this.sidebarPeek_ = false;
+    } else if (!this.fullscreenMode_ &&
+               this.sidebarHiddenOutsideFullscreen_ !== null) {
+      this.closeSiteControl_();
+      this.sidebarHidden_ = this.sidebarHiddenOutsideFullscreen_;
+      this.sidebarHiddenOutsideFullscreen_ = null;
+      this.sidebarPeek_ = false;
+    }
+  }
+
