 void WebUIBrowserWindow::ProcessFullscreen(bool fullscreen) {
   widget_->SetFullscreen(fullscreen);
+  SyncFullscreenMode();
+}
 
+// Tells the WebUI which full screen the window is in. Called when the window
+// enters or leaves it (the menu, the green button) and when the controller's
+// state changes without the window changing: a video going full screen in a
+// window that already is, and back.
+void WebUIBrowserWindow::SyncFullscreenMode() {
   auto* manager = ExclusiveAccessManager::From(browser_);
   if (!manager) {
     return;
   }
-
   auto* controller = manager->fullscreen_controller();
+  if (!fullscreen_changed_subscription_) {
+    fullscreen_changed_subscription_ =
+        controller->RegisterOnFullscreenStateChanged(
+            base::BindRepeating(&WebUIBrowserWindow::SyncFullscreenMode,
+                                base::Unretained(this)));
+  }
 
+  const bool fullscreen = widget_->IsFullscreen();
   std::optional<webui_browser::mojom::FullscreenContext> context;
   if (fullscreen) {
-    if (controller->IsTabFullscreen()) {
-      context = webui_browser::mojom::FullscreenContext::kTab;
-    } else if (controller->IsFullscreenForBrowser()) {
-      context = webui_browser::mojom::FullscreenContext::kBrowser;
-    }
+    context = controller->IsTabFullscreen()
+                  ? webui_browser::mojom::FullscreenContext::kTab
+                  : webui_browser::mojom::FullscreenContext::kBrowser;
   }
+  const bool window_changed = fullscreen != window_fullscreen_;
+  window_fullscreen_ = fullscreen;
+  if (!window_changed && sent_fullscreen_context_ == context) {
+    return;
+  }
+  sent_fullscreen_context_ = context;
 
-  // Notify the WebUI about the fullscreen mode.
   if (webui_browser::mojom::Page* page = GetWebUIBrowserUI()->page()) {
     page->OnFullscreenModeChanged(fullscreen, context);
   }
-
-  ExclusiveAccessManager::From(browser_)
-      ->fullscreen_controller()
-      ->WindowFullscreenStateChanged();
+  if (window_changed) {
+    controller->WindowFullscreenStateChanged();
+  }
 }
 
