   // ⌘L and the like: the command bar, editing the current URL.
-  protected setFocusToLocationBar(_isUserInitiated: boolean) {
+  protected setFocusToLocationBar(isUserInitiated: boolean) {
+    // Arc: ⌘L (or ⌘T) again closes the bar.
+    if (isUserInitiated && this.$.commandBar.open) {
+      this.$.commandBar.hide();
+      return;
+    }
     this.showCommandBar_(/*newTab=*/ false, this.url_);
   }
 
@@ -821,6 +826,10 @@ export class WebuiBrowserAppElement extends CrLitElement {
   }
 
   protected onMeridianShowCommandBar_() {
+    if (this.$.commandBar.open) {
+      this.$.commandBar.hide();
+      return;
+    }
     this.showCommandBar_(/*newTab=*/ true, '');
   }
 
@@ -956,6 +965,10 @@ export class WebuiBrowserAppElement extends CrLitElement {
     this.$.commandBar.show(newTab, text);
   }
 
+  protected onCommandBarReload_() {
+    this.$.contentRegion.activeWebview?.reload();
+  }
+
   // The keys back to the page, through its element here, so this page and
   // the browser agree on who has the focus (the next ⌘T's field takes it).
