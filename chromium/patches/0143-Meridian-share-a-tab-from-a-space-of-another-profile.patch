From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Mon, 16 Nov 2026 12:46:16 +0400
Subject: [PATCH 144/202] Meridian: share a tab from a space of another profile

The tab picker took tabs from the windows of the call's profile; the
window holding every space is the main profile's, so a call in a space
of another profile saw no tab. Tabs are matched by their own profile.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/media/webrtc/tab_desktop_media_list.cc | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/media/webrtc/tab_desktop_media_list.cc b/chrome/browser/media/webrtc/tab_desktop_media_list.cc
index 973bd0c91b..48d3fa84f4 100644
--- a/chrome/browser/media/webrtc/tab_desktop_media_list.cc
+++ b/chrome/browser/media/webrtc/tab_desktop_media_list.cc
@@ -130,14 +130,15 @@ void TabDesktopMediaList::Refresh(bool update_thumbnails) {
 
   std::vector<BrowserWindowInterface*> browsers;
   ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
-      [&browsers, profile](BrowserWindowInterface* browser) {
+      [&browsers](BrowserWindowInterface* browser) {
         // Omit all the IWAs for TabDesktopMediaList as they are already
         // present in NativeDesktopMediaList.
         if ((!base::FeatureList::IsEnabled(
                  features::kRemovalOfIWAsFromTabCapture) ||
              !web_app::AppBrowserController::IsIsolatedWebApp(browser)) &&
-            browser->GetProfile()->GetOriginalProfile() ==
-                profile->GetOriginalProfile()) {
+            // Meridian: any window; its tabs are filtered by their own
+            // profile below (a window holds every profile's spaces).
+            browser->GetProfile()) {
           browsers.push_back(browser);
         }
         return true;
@@ -153,6 +154,10 @@ void TabDesktopMediaList::Refresh(bool update_thumbnails) {
       // Create id for tab.
       WebContents* contents = tab_strip_model->GetWebContentsAt(i);
       CHECK(contents, base::NotFatalUntil::M161);
+      if (Profile::FromBrowserContext(contents->GetBrowserContext())
+              ->GetOriginalProfile() != profile->GetOriginalProfile()) {
+        continue;
+      }
       contents_list.push_back(contents);
     }
   }
