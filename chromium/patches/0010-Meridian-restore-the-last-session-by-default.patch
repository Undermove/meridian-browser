From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Tue, 27 Oct 2026 13:46:08 +0400
Subject: [PATCH 11/50] Meridian: restore the last session by default

---
 chrome/browser/prefs/session_startup_pref.cc | 18 +-----------------
 1 file changed, 1 insertion(+), 17 deletions(-)

diff --git a/chrome/browser/prefs/session_startup_pref.cc b/chrome/browser/prefs/session_startup_pref.cc
index 72fc94f516..7cc4fab2ce 100644
--- a/chrome/browser/prefs/session_startup_pref.cc
+++ b/chrome/browser/prefs/session_startup_pref.cc
@@ -66,24 +66,8 @@ void SessionStartupPref::RegisterProfilePrefs(
 
 // static
 SessionStartupPref::Type SessionStartupPref::GetDefaultStartupType() {
-#if BUILDFLAG(IS_CHROMEOS)
+  // Meridian: like Arc, your spaces and tabs come back after a restart.
   return SessionStartupPref::LAST;
-#else
-#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_MAC)
-  if (features::kSetDefaultToContinueSession.Get()) {
-    return SessionStartupPref::LAST;
-  }
-#elif BUILDFLAG(IS_ANDROID)
-  // On Android desktop, restoring the last session is the default startup
-  // behavior when the restore-on-startup pref is synced.
-  if (base::android::device_info::is_desktop() &&
-      base::FeatureList::IsEnabled(
-          chrome::android::kSyncRestoreOnStartupPref)) {
-    return SessionStartupPref::LAST;
-  }
-#endif
-  return SessionStartupPref::DEFAULT;
-#endif
 }
 
 // static
