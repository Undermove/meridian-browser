From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Thu, 26 Nov 2026 02:07:37 +0400
Subject: [PATCH 302/304] Meridian: AI subscriptions build on Windows

Adding a subscription's folder made it private with
base::SetPosixFilePermissions, which is POSIX only: on Windows the
folder under the user's profile is already theirs. And the account
test's base::FilePath("/Users/...") literal is FromASCII there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/meridian/ai/accounts_unittest.cc |  5 +++--
 chrome/browser/meridian/sidebar_handler.cc      | 10 ++++++++--
 2 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/meridian/ai/accounts_unittest.cc b/chrome/browser/meridian/ai/accounts_unittest.cc
index a432c925c6..9bcfb137ec 100644
--- a/chrome/browser/meridian/ai/accounts_unittest.cc
+++ b/chrome/browser/meridian/ai/accounts_unittest.cc
@@ -114,8 +114,9 @@ TEST_F(AccountsTest, EnvSetsTheVariableOrTakesItAway) {
   env = AccountEnv(gemini, home_, home_.AppendASCII(".gemini-work"));
   EXPECT_EQ(env["GEMINI_CLI_HOME"],
             home_.AppendASCII(".gemini-work").AsUTF8Unsafe());
-  EXPECT_EQ(AccountLoginCommand(claude, home_,
-                                base::FilePath("/Users/me/.claude-o'k")),
+  EXPECT_EQ(AccountLoginCommand(
+                claude, home_,
+                base::FilePath::FromASCII("/Users/me/.claude-o'k")),
             "CLAUDE_CONFIG_DIR='/Users/me/.claude-o'\\''k' claude");
   EXPECT_EQ(AccountLoginCommand(claude, home_, home_.AppendASCII(".claude")),
             "env -u CLAUDE_CONFIG_DIR claude");
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index acd8b9455c..4c09dc41b7 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -4699,8 +4699,14 @@ void SidebarHandler::AddAiAccount(const std::string& vendor_id,
             if (base::DirectoryExists(dir)) {
               return true;
             }
-            return base::CreateDirectory(dir) &&
-                   base::SetPosixFilePermissions(dir, 0700);
+            if (!base::CreateDirectory(dir)) {
+              return false;
+            }
+#if BUILDFLAG(IS_POSIX)
+            return base::SetPosixFilePermissions(dir, 0700);
+#else
+            return true;  // Windows: the user's profile folder is theirs.
+#endif
           },
           *dir),
       base::BindOnce(
-- 
