diff --git a/chrome/browser/meridian/sidebar_service.cc b/chrome/browser/meridian/sidebar_service.cc
index 233d27c259..e145002516 100644
--- a/chrome/browser/meridian/sidebar_service.cc
+++ b/chrome/browser/meridian/sidebar_service.cc
@@ -625,6 +625,16 @@ bool SidebarService::RenameItem(const std::string& item_id,
   return true;
 }
 
+bool SidebarService::SetItemUrl(const std::string& item_id, const GURL& url) {
+  Item* item = const_cast<Item*>(FindItem(item_id));
+  if (!item || item->is_folder || !url.is_valid()) {
+    return false;
+  }
+  item->url = url;
+  Changed();
+  return true;
+}
