+ClaudeDesktopState DesktopState() {
+  ClaudeDesktopState state;
+  state.installed = DesktopInstalled();
+  if (!state.installed) {
+    return state;
+  }
+  state.config = DesktopConfig();
+  std::string text;
+  if (base::ReadFileToString(state.config, &text)) {
+    std::optional<base::DictValue> root =
+        base::JSONReader::ReadDict(text, base::JSON_ALLOW_TRAILING_COMMAS);
+    const base::DictValue* servers =
+        root ? root->FindDict("mcpServers") : nullptr;
+    state.connected = servers && servers->FindDict("meridian");
+  }
+  return state;
+}
