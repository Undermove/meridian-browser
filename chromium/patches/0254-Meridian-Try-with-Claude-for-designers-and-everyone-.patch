+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import {SHOWCASE} from './showcase.js';
+import type {MeridianShowcaseElement} from './showcase.js';
+
+export function getHtml(this: MeridianShowcaseElement) {
+  return html`<!--_html_template_start_-->
+${this.claude === 'missing' ? html`
+  <div class="cards two">
+    <button class="card" data-action="get-claude" id="getClaude"
+        @click="${this.onOtherClick_}">
+      <span class="ic">${icon('external', 17)}</span>
+      <b>Get Claude for Mac</b>
+      <em>Free to download. Meridian sets it up for you.</em>
+    </button>
+    <button class="card" data-action="ask" id="askInstead"
+        @click="${this.onOtherClick_}">
+      <span class="ic">${icon('sparkles', 17)}</span>
+      <b>Ask about this page</b>
+      <em>Meridian’s own helper, right here (⌘J).</em>
+    </button>
+  </div>` : html`
+  <div class="cards">
+    ${SHOWCASE.map(c => html`
+      <div class="card ${c.id}" data-id="${c.id}" role="button" tabindex="0"
+          @click="${this.onCardClick_}" @keydown="${this.onCardKeydown_}">
+        <span class="ic">${icon(c.icon, 17)}</span>
+        <b>${c.title}</b>
+        ${c.id === 'moodboard' ? html`
+          <input class="topic" .value="${this.topic_}"
+              aria-label="What to look for" spellcheck="false"
+              @click="${this.onTopicClick_}" @keydown="${this.onTopicKeydown_}"
+              @input="${this.onTopicInput_}">` : html`
+          <em>${c.text}</em>`}
+      </div>`)}
+  </div>`}
+<!--_html_template_end_-->`;
+}
