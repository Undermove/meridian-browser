+bool StrongDevSignals() {
+  base::FilePath home;
+  base::PathService::Get(base::DIR_HOME, &home);
+  for (const char* path :
+       {"/opt/homebrew/bin/brew", "/usr/local/bin/brew", "/usr/local/Homebrew"}) {
+    if (base::PathExists(base::FilePath(path))) {
+      return true;
+    }
+  }
+  for (const char* name : {".claude.json", ".claude/local", ".codex",
+                           ".local/bin/claude", ".gemini"}) {
+    if (base::PathExists(home.AppendASCII(name))) {
+      return true;
+    }
+  }
+  for (const char* name :
+       {"repos", "code", "Code", "projects", "Projects", "src", "dev",
+        "Developer", "git", "GitHub"}) {
+    base::FileEnumerator repos(home.AppendASCII(name), false,
+                               base::FileEnumerator::DIRECTORIES);
+    int looked = 0;
+    for (base::FilePath dir = repos.Next(); !dir.empty() && looked < 50;
+         dir = repos.Next(), ++looked) {
+      if (base::PathExists(dir.AppendASCII(".git"))) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
