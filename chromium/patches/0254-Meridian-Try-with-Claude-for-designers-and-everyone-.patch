+TEST(SetupProfileTest, DesignAppsMakeADesignerWithoutStrongDevSigns) {
+  // An editor next to Figma isn't enough to be a developer…
+  EXPECT_EQ(GuessPersona({"Figma", "Visual Studio Code", "Slack"}, false),
