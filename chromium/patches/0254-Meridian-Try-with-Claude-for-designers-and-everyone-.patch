@@ -0,0 +1,150 @@
+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #css_wrapper_metadata_end */
+
+/* "Try with Claude" cards: they take the colour of where they sit (the
+ * welcome tour's dark stage, the home page, the sheet). */
+
+:host {
+  display: block;
+  width: 100%;
+}
+
+button {
+  font: inherit;
+  color: inherit;
+  background: none;
+  border: 0;
+  padding: 0;
+  cursor: pointer;
+}
+
+.cards {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
+  gap: 10px;
+}
+
+.cards.two {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.card {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 4px;
+  min-height: 96px;
+  padding: 14px 15px;
+  box-sizing: border-box;
+  border-radius: 14px;
+  background: color-mix(in srgb, currentColor 7%, transparent);
+  text-align: left;
+  cursor: pointer;
+  outline: none;
+  transition: transform 0.16s cubic-bezier(0.2, 0, 0, 1),
+      background 0.16s ease;
+  animation: rise 0.32s cubic-bezier(0.05, 0.7, 0.1, 1) both;
+}
+
+.card:nth-child(2) {
+  animation-delay: 40ms;
+}
+
+.card:nth-child(3) {
+  animation-delay: 80ms;
+}
+
+.card:nth-child(4) {
+  animation-delay: 120ms;
+}
+
+.card:nth-child(5) {
+  animation-delay: 160ms;
+}
+
+@keyframes rise {
+  from {
+    opacity: 0;
+    transform: translateY(8px);
+  }
+}
+
+.card:hover,
+.card:focus-visible {
+  background: color-mix(in srgb, currentColor 13%, transparent);
+  transform: translateY(-2px);
+}
+
+.card:focus-visible {
+  box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 40%, transparent);
+}
+
+.ic {
+  display: grid;
+  place-items: center;
+  width: 30px;
+  height: 30px;
+  margin-bottom: 6px;
+  border-radius: 9px;
+  color: #fff;
+  background: #d97757;
+}
+
+.restyle .ic {
+  background: linear-gradient(135deg, #c471f5, #fa71cd);
+}
+
+.moodboard .ic {
+  background: #e60023;
+}
+
+.critique .ic {
+  background: linear-gradient(135deg, #4facfe, #6a7cf6);
+}
+
+.tidy .ic {
+  background: linear-gradient(135deg, #43cea2, #2f9e83);
+}
+
+b {
+  font-size: 13.5px;
+  font-weight: 650;
+  line-height: 1.3;
+}
+
+em {
+  font-size: 12px;
+  font-style: normal;
+  line-height: 1.4;
+  opacity: 0.68;
+}
+
+.topic {
+  width: 100%;
+  margin-top: 4px;
+  padding: 5px 8px;
+  box-sizing: border-box;
+  border: 0;
+  border-radius: 7px;
+  font: inherit;
+  font-size: 12px;
+  color: inherit;
+  background: color-mix(in srgb, currentColor 10%, transparent);
+  outline: none;
+}
+
+.topic:focus {
+  box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 30%, transparent);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .card {
+    animation: none;
+    transition: none;
+  }
+}
