new file mode 100644
index 0000000000..5dbbfa3155
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/showcase.ts
@@ -0,0 +1,201 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// "Try with Claude": one-click things Claude (the Mac app) does in Meridian.
+// Each card gets the scene ready here (the right page in front), then opens
+// Claude with the request typed in; the person presses Enter there. The cards
+// show in the welcome tour, on the home page and from the command bar
+// ("Try with Claude…"). Without Claude on the computer they say where to get
+// it, and offer Meridian's own Ask (⌘J) instead.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+
+import type {IconName} from './icons.js';
+import {getCss} from './showcase.css.js';
+import {getHtml} from './showcase.html.js';
+
+export type ShowcaseId = 'restyle'|'moodboard'|'critique'|'tidy'|'guide';
+
+export interface ShowcaseCard {
+  id: ShowcaseId;
+  title: string;
+  text: string;
+  icon: IconName;
+}
+
+export const SHOWCASE: ShowcaseCard[] = [
+  {id: 'restyle', title: 'Give this site a new look',
+   text: 'Claude restyles the page live. One word puts it back.',
+   icon: 'palette'},
+  {id: 'moodboard', title: 'Find design trends on Pinterest',
+   text: 'Six references, pinned in a new Moodboard folder.', icon: 'grid'},
+  {id: 'critique', title: 'Critique this page like a senior designer',
+   text: 'Five concrete suggestions, nothing changed.', icon: 'eye'},
+  {id: 'tidy', title: 'Tidy my tabs',
+   text: 'A plan first. Nothing moves until you say yes.', icon: 'wand'},
+  {id: 'guide', title: 'What else can Meridian do?',
+   text: 'A quick tour, and three things to try now.', icon: 'sparkles'},
+];
+
+export const DEFAULT_TOPIC = 'UI design trends 2026';
+
+// Plain pages that always load: the first website ever (CERN keeps it as it
+// was in 1992), and a famously bare one to critique.
+export const RESTYLE_PAGE =
+    'https://info.cern.ch/hypertext/WWW/TheProject.html';
+export const CRITIQUE_PAGE = 'https://news.ycombinator.com/';
+
+function isWebPage(url: string): boolean {
+  return /^https?:\/\//.test(url);
+}
+
+// The page to open first, or '' to keep the one in front.
+export function sceneFor(id: ShowcaseId, activeUrl: string): string {
+  if (id === 'restyle' && !isWebPage(activeUrl)) {
+    return RESTYLE_PAGE;
+  }
+  if (id === 'critique' && !isWebPage(activeUrl)) {
+    return CRITIQUE_PAGE;
+  }
+  return '';
+}
+
+// "Reply in Russian." for a person whose Meridian isn't in English.
+function replyIn(lang: string): string {
+  const code = (lang || 'en').split('-')[0]!.toLowerCase();
+  if (code === 'en') {
+    return '';
+  }
+  let name = code;
+  try {
+    name = new Intl.DisplayNames(['en'], {type: 'language'}).of(code) || code;
+  } catch {
+    // An odd tag: the code itself is still understood.
+  }
+  return ` Reply in ${name}.`;
+}
+
+// What Claude gets (typed in for the person, never sent by itself).
+export function showcaseRequest(
+    id: ShowcaseId, topic: string = DEFAULT_TOPIC,
+    lang: string = navigator.language): string {
+  const subject = topic.trim() || DEFAULT_TOPIC;
+  const requests: Record<ShowcaseId, string> = {
+    restyle:
+        'In Meridian, give the page in my current tab a fresh new look. ' +
+        'First read it and take a screenshot. Then restyle it with a ' +
+        'Meridian Boost: modern typography, a calm colour palette, generous ' +
+        'spacing and clear hierarchy. Change only how it looks, never what ' +
+        'it says. When it’s done, tell me in two lines what you changed, and ' +
+        'that I can say "undo" to put it back as it was.',
+    moodboard:
+        `In Meridian, open Pinterest in a new tab and search for "${
+            subject}". Pick 6 strong, varied references, open each one in ` +
+        'its own tab, and pin them all into a new folder called ' +
+        '"Moodboard". Then sum up the trends you saw in three short lines.',
+    critique:
+        'In Meridian, take a screenshot of the page in my current tab and ' +
+        'read it. Then critique it like a senior product designer: give me ' +
+        '5 concrete suggestions (layout, typography, colour, hierarchy, ' +
+        'accessibility), each with what to change and why. Don’t change ' +
+        'anything on the page.',
+    tidy:
+        'Look at the tabs open in Meridian and suggest how to organize them ' +
+        'into folders. Show me the plan and change nothing until I say yes.',
+    guide:
+        'Use Meridian’s guide to tell me what Meridian can do, briefly and ' +
+        'in plain words. Then suggest three things I could try right now, ' +
+        'based on the tabs I have open.',
+  };
+  return requests[id] + replyIn(lang);
+}
+
+export interface ShowcaseRun {
+  action: 'run'|'get-claude'|'ask';
+  id?: ShowcaseId;
+  topic?: string;
+}
+
+// The cards. `claude`: '' while unknown, 'ready' or 'missing'.
+export class MeridianShowcaseElement extends CrLitElement {
+  static get is() {
+    return 'meridian-showcase';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      claude: {type: String, reflect: true},
+      topic_: {state: true, type: String},
+    };
+  }
+
+  accessor claude: string = '';
+  protected accessor topic_: string = DEFAULT_TOPIC;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.refresh();
+  }
+
+  async refresh() {
+    const {installed} =
+        await browserProxyFactory.getInstance().handler.getClaudeDesktop();
+    this.claude = installed ? 'ready' : 'missing';
+  }
+
+  private run_(id: ShowcaseId) {
+    this.fire('meridian-showcase',
+              {action: 'run', id, topic: this.topic_} as ShowcaseRun);
+  }
+
+  protected onCardClick_(e: Event) {
+    this.run_((e.currentTarget as HTMLElement).dataset['id'] as ShowcaseId);
+  }
+
+  protected onCardKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter' || e.key === ' ') {
+      e.preventDefault();
+      this.run_((e.currentTarget as HTMLElement).dataset['id'] as ShowcaseId);
+    }
+  }
+
+  protected onTopicClick_(e: Event) {
+    e.stopPropagation();
+  }
+
+  protected onTopicKeydown_(e: KeyboardEvent) {
+    e.stopPropagation();
+    if (e.key === 'Enter') {
+      this.run_('moodboard');
+    }
+  }
+
+  protected onTopicInput_(e: Event) {
+    this.topic_ = (e.target as HTMLInputElement).value;
+  }
+
+  protected onOtherClick_(e: Event) {
+    const action = (e.currentTarget as HTMLElement).dataset['action'] as
+        ShowcaseRun['action'];
+    this.fire('meridian-showcase', {action} as ShowcaseRun);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-showcase': MeridianShowcaseElement;
+  }
+}
+
+customElements.define(MeridianShowcaseElement.is, MeridianShowcaseElement);
