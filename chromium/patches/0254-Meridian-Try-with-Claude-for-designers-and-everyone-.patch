+void SidebarHandler::GetClaudeDesktop(GetClaudeDesktopCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce([] {
+        ClaudeDesktopState state = GetClaudeDesktopState();
+        base::File::Info info;
+        base::Time changed;
+        if (state.connected && base::GetFileInfo(state.config, &info)) {
+          changed = info.last_modified;
+        }
+        return std::make_pair(state, changed);
+      }),
+      base::BindOnce(
+          [](GetClaudeDesktopCallback callback,
+             std::pair<ClaudeDesktopState, base::Time> found) {
+            const ClaudeDesktopState& state = found.first;
+            // A test never looks at a real Claude.
+            bool restart =
+                TestSwitchesAllowed()
+                    ? HasTestSwitch("meridian-test-claude-needs-restart")
+                    : state.connected && !found.second.is_null() &&
+                          ClaudeDesktopStartedBefore(found.second);
+            std::move(callback).Run(state.installed, state.connected,
+                                    state.connected && restart);
+          },
+          std::move(callback)));
+}
+
+void SidebarHandler::GetPersona(GetPersonaCallback callback) {
+  std::string forced = TestSwitchValue("meridian-test-persona");
+  if (!forced.empty()) {
+    std::move(callback).Run(forced);
+    return;
+  }
+  if (MainProfileFor(browser_->GetProfile())
+          ->GetPrefs()
+          ->GetString(prefs::kMode) == "developer") {
+    std::move(callback).Run("developer");
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [] { return GuessPersona(InstalledApps(), StrongDevSignals()); }),
+      std::move(callback));
+}
