@@ -0,0 +1,60 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {icon} from './icons.js';
+import type {MeridianTryClaudeElement} from './try_claude.js';
+
+export function getHtml(this: MeridianTryClaudeElement) {
+  return html`<!--_html_template_start_-->
+${this.mode === 'sheet' ? html`
+  <div class="scrim" @click="${this.onScrimClick_}"
+      @keydown="${this.onKeydown_}">
+    <div class="sheet" role="dialog" aria-modal="true"
+        aria-label="Try with Claude" @click="${this.onSheetClick_}">
+      <div class="head">
+        <h3>Try with Claude</h3>
+        <button id="close" class="x" title="Close"
+            @click="${this.onCloseClick_}">${icon('x', 14)}</button>
+      </div>
+      <p class="sub">Pick one. Meridian gets the page ready and opens
+        Claude with your request typed in: press Enter, then Allow.</p>
+      <meridian-showcase id="cards"></meridian-showcase>
+    </div>
+  </div>` : ''}
+${this.mode === 'restart' ? html`
+  <div class="scrim" @keydown="${this.onKeydown_}">
+    <div class="card" role="dialog" aria-modal="true"
+        aria-labelledby="restartTitle">
+      <h3 id="restartTitle">Claude needs a quick restart</h3>
+      <p>Claude closes and opens again so it can use Meridian. If
+        something there isn’t saved, Claude asks first.</p>
+      <p>Your request will be waiting: press <b>Enter</b>. The first
+        time, Claude asks to use Meridian. Click <b>Allow</b>.</p>
+      <meridian-allow-mock></meridian-allow-mock>
+      <p class="small">Its words may differ a little. Meridian may ask
+        too before Claude changes something here: Allow that as
+        well.</p>
+      <div class="actions">
+        <button id="restartLater" class="btn ghost"
+            @click="${this.onCloseClick_}">Not now</button>
+        <button id="restartGo" class="btn primary"
+            ?disabled="${this.busy_}" @click="${this.onRestartClick_}">
+          ${this.busy_ ? 'Restarting…' : 'Restart Claude'}</button>
+      </div>
+    </div>
+  </div>` : ''}
+${this.mode === 'sent' ? html`
+  <div id="sent" class="toast ${this.ok_ ? '' : 'bad'}" role="status">
+    <span class="mark"></span>
+    <div class="words">
+      <b>${this.ok_ ? 'Over to Claude' : 'Claude didn’t open'}</b>
+      <span id="sentText">${this.message_}</span>
+    </div>
+    <button class="x" title="Close" @click="${this.onCloseClick_}">
+      ${icon('x', 12)}</button>
+  </div>` : ''}
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/meridian/try_claude.ts b/chrome/browser/resources/webui_browser/meridian/try_claude.ts
new file mode 100644
index 0000000000..57415d6114
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/meridian/try_claude.ts
@@ -0,0 +1,166 @@
+// Copyright 2026 The Meridian Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Runs a "Try with Claude" card (showcase.ts): sets Meridian up with Claude
+// if it isn't yet, gets the scene ready, says what will happen before Claude
+// restarts, and opens Claude with the request typed in. Also the sheet of
+// cards for the command bar's "Try with Claude…".
+
+import './allow_mock.js';
+import './showcase.js';
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from '../sidebar.mojom-webui.js';
+import type {SidebarHandlerInterface} from '../sidebar.mojom-webui.js';
+
+import {sceneFor, showcaseRequest} from './showcase.js';
+import type {MeridianShowcaseElement, ShowcaseId} from './showcase.js';
+import {getCss} from './try_claude.css.js';
+import {getHtml} from './try_claude.html.js';
+
+// The window's side of it: what's in front, and opening a page.
+export interface TryClaudeHost {
+  activeUrl(): string;
+  openUrl(url: string): void;
+}
+
+export type Mode = ''|'sheet'|'restart'|'sent';
+
+// The note after Claude opens stays this long.
+const SENT_MS = 20000;
+
+export class MeridianTryClaudeElement extends CrLitElement {
+  static get is() {
+    return 'meridian-try-claude';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      mode: {type: String, reflect: true},
+      message_: {state: true, type: String},
+      ok_: {state: true, type: Boolean},
+      busy_: {state: true, type: Boolean},
+    };
+  }
+
+  accessor mode: Mode = '';
+  protected accessor message_: string = '';
+  protected accessor ok_: boolean = true;
+  protected accessor busy_: boolean = false;
+
+  host: TryClaudeHost|null = null;
+  private readonly handler_: SidebarHandlerInterface =
+      browserProxyFactory.getInstance().handler;
+  // The request waiting for Claude's restart.
+  private request_: string = '';
+  private sentTimer_: number|null = null;
+
+  // The command bar's "Try with Claude…".
+  async showCards() {
+    this.mode = 'sheet';
+    await this.updateComplete;
+    const cards =
+        this.shadowRoot.querySelector<MeridianShowcaseElement>('#cards');
+    cards?.refresh();
+    cards?.focus();
+  }
+
+  close() {
+    this.mode = '';
+    this.busy_ = false;
+    this.clearTimer_();
+  }
+
+  async run(id: ShowcaseId, topic: string) {
+    this.close();
+    let claude = await this.handler_.getClaudeDesktop();
+    if (!claude.installed) {
+      // Nothing to open: say where to get it, with Ask as the way now.
+      return this.showCards();
+    }
+    if (!claude.connected) {
+      const {ok} = await this.handler_.connectAgentCli('claude-desktop');
+      if (ok) {
+        this.handler_.grantAgentAccess();
+      }
+      claude = await this.handler_.getClaudeDesktop();
+    }
+    const scene = sceneFor(id, this.host?.activeUrl() || '');
+    if (scene) {
+      this.host?.openUrl(scene);
+    }
+    this.request_ = showcaseRequest(id, topic);
+    if (claude.needsRestart) {
+      this.mode = 'restart';
+      await this.updateComplete;
+      this.shadowRoot.querySelector<HTMLElement>('#restartGo')?.focus();
+      return;
+    }
+    return this.send_();
+  }
+
+  private async send_() {
+    this.busy_ = true;
+    const {ok, message} = await this.handler_.openInClaude(this.request_);
+    this.busy_ = false;
+    this.ok_ = ok;
+    this.message_ = message;
+    this.mode = 'sent';
+    this.clearTimer_();
+    this.sentTimer_ = setTimeout(() => {
+      if (this.mode === 'sent') {
+        this.mode = '';
+      }
+    }, SENT_MS);
+  }
+
+  private clearTimer_() {
+    if (this.sentTimer_ !== null) {
+      clearTimeout(this.sentTimer_);
+      this.sentTimer_ = null;
+    }
+  }
+
+  protected onRestartClick_() {
+    if (!this.busy_) {
+      this.send_();
+    }
+  }
+
+  protected onScrimClick_() {
+    this.close();
+  }
+
+  protected onSheetClick_(e: Event) {
+    e.stopPropagation();
+  }
+
+  protected onCloseClick_() {
+    this.close();
+  }
+
+  protected onKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.close();
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'meridian-try-claude': MeridianTryClaudeElement;
+  }
+}
+
+customElements.define(MeridianTryClaudeElement.is, MeridianTryClaudeElement);
