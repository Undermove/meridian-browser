+  constexpr char kReady[] =
+      "Claude is open with your request. Press Enter there, then Allow. If "
+      "the box is empty, paste it with \u2318V.";
+  constexpr char kStarted[] = "Claude is ready for Meridian.";
+  ClaudeOpen open{request, request.empty() ? kStarted : kReady};
+  // A test never touches a real Claude: it gets the link instead.
+  if (TestSwitchesAllowed()) {
+    std::string link = request.empty() ? "claude://" : RequestUrl(request);
+    base::FilePath log = TestSwitchPath("meridian-test-claude-log");
+    if (!log.empty()) {
+      base::ThreadPool::PostTask(
+          FROM_HERE, {base::MayBlock()},
+          base::BindOnce(
+              [](base::FilePath log, std::string line) {
+                line += "\n";
+                if (!base::PathExists(log)) {
+                  base::WriteFile(log, line);
+                } else {
+                  base::AppendToFile(log, line);
+                }
+              },
+              log, link));
+    }
+    std::move(callback).Run(true, open.ready + " [" + link + "]");
+    return;
+  }
+  NSString* bundle = base::SysUTF8ToNSString(kClaudeBundle);
+  NSURL* url =
+      [NSWorkspace.sharedWorkspace URLForApplicationWithBundleIdentifier:bundle];
+  if (!url) {
+    std::move(callback).Run(false, "Claude isn’t on this Mac yet.");
+    return;
+  }
+  // Claude reads Meridian's entry only when it starts: one that started
+  // before the entry was added quits first (asking about unsaved work
+  // itself), then opens again.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce([] {
+        ClaudeDesktopState state = GetClaudeDesktopState();
+        base::File::Info info;
+        return state.connected && base::GetFileInfo(state.config, &info)
+                   ? info.last_modified
+                   : base::Time();
+      }),
+      base::BindOnce(
+          [](NSURL* url, ClaudeOpen open, OpenInClaudeCallback callback,
+             base::Time changed) {
+            NSRunningApplication* app = [NSRunningApplication
+                runningApplicationsWithBundleIdentifier:
+                    base::SysUTF8ToNSString(kClaudeBundle)]
+                                            .firstObject;
+            if (app && !changed.is_null() &&
+                ClaudeDesktopStartedBefore(changed)) {
+              [app terminate];
+              return WaitForQuit(app, url, std::move(open), kQuitChecks,
+                                 std::move(callback));
+            }
+            if (app && open.request.empty()) {
+              // Already running with Meridian: nothing to do.
+              return std::move(callback).Run(true, open.ready);
+            }
+            OpenClaude(url, std::move(open), std::move(callback));
+          },
+          url, std::move(open), std::move(callback)));
 }
 
