@@ -0,0 +1,214 @@
+/* Copyright 2026 The Meridian Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #css_wrapper_metadata_end */
+
+/* "Try with Claude": the sheet of cards, the note before Claude restarts,
+ * and the note once Claude is open. */
+
+:host {
+  font-family: system-ui, -apple-system, sans-serif;
+}
+
+button {
+  font: inherit;
+  color: inherit;
+  background: none;
+  border: 0;
+  padding: 0;
+  cursor: pointer;
+}
+
+.scrim {
+  position: fixed;
+  inset: 0;
+  z-index: 190;
+  display: grid;
+  place-items: center;
+  background: rgba(10, 10, 16, 0.36);
+  animation: fade 0.2s ease;
+}
+
+@keyframes fade {
+  from {
+    opacity: 0;
+  }
+}
+
+.sheet,
+.card {
+  box-sizing: border-box;
+  border-radius: 18px;
+  background: var(--meridian-surface, #fff);
+  color: var(--meridian-text, #17171c);
+  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35),
+      0 0 0 0.5px var(--meridian-border, rgba(0, 0, 0, 0.1));
+  animation: pop 0.26s cubic-bezier(0.05, 0.7, 0.1, 1);
+}
+
+@keyframes pop {
+  from {
+    opacity: 0;
+    transform: translateY(10px) scale(0.98);
+  }
+}
+
+.sheet {
+  width: min(680px, 92vw);
+  max-height: 86vh;
+  overflow-y: auto;
+  padding: 20px 22px 22px;
+}
+
+.head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+h3 {
+  margin: 0;
+  font-size: 18px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+}
+
+.sub {
+  margin: 6px 0 16px;
+  font-size: 13px;
+  line-height: 1.5;
+  color: var(--meridian-text-muted, #66655f);
+}
+
+.x {
+  display: grid;
+  place-items: center;
+  width: 26px;
+  height: 26px;
+  border-radius: 8px;
+  color: var(--meridian-text-muted, #66655f);
+}
+
+.x:hover {
+  background: color-mix(in srgb, currentColor 12%, transparent);
+}
+
+.card {
+  width: min(440px, 90vw);
+  padding: 22px 24px 18px;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+}
+
+.card p {
+  margin: 0 0 10px;
+  font-size: 13.5px;
+  line-height: 1.5;
+  color: var(--meridian-text-muted, #44444c);
+}
+
+.card p b {
+  color: var(--meridian-text, #17171c);
+}
+
+.card meridian-allow-mock {
+  margin: 14px auto 12px;
+}
+
+.card p.small {
+  font-size: 12px;
+}
+
+.actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  margin-top: 14px;
+}
+
+.btn {
+  height: 36px;
+  padding: 0 16px;
+  border-radius: 10px;
+  font-size: 13.5px;
+  font-weight: 600;
+}
+
+.btn.primary {
+  background: var(--meridian-text, #17171c);
+  color: var(--meridian-surface, #fff);
+}
+
+.btn.primary:disabled {
+  opacity: 0.7;
+}
+
+.btn.ghost:hover {
+  background: color-mix(in srgb, currentColor 8%, transparent);
+}
+
+.toast {
+  position: fixed;
+  right: 16px;
+  bottom: 18px;
+  z-index: 190;
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+  width: min(360px, 80vw);
+  box-sizing: border-box;
+  padding: 13px 12px 13px 14px;
+  border-radius: 14px;
+  background: var(--meridian-surface, #fff);
+  color: var(--meridian-text, #17171c);
+  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.28),
+      0 0 0 0.5px var(--meridian-border, rgba(0, 0, 0, 0.1));
+  font-size: 13px;
+  line-height: 1.45;
+  animation: slide 0.24s cubic-bezier(0.05, 0.7, 0.1, 1);
+}
+
+@keyframes slide {
+  from {
+    opacity: 0;
+    transform: translateY(12px);
+  }
+}
+
+.toast .mark {
+  flex: none;
+  width: 22px;
+  height: 22px;
+  margin-top: 1px;
+  border-radius: 7px;
+  background: #d97757;
+}
+
+.toast.bad .mark {
+  background: #c9a227;
+}
+
+.words {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.words span {
+  color: var(--meridian-text-muted, #66655f);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .scrim,
+  .sheet,
+  .card,
+  .toast {
+    animation: none;
+  }
+}
