+// ---- Codex's config.toml, line by line: only Meridian's own table is
+// written or taken out; every other line stays as it is.
+
+// "[mcp_servers.meridian]", "[mcp_servers.\"meridian\".env]".
+bool IsMeridianTable(std::string_view trimmed) {
+  return RE2::FullMatch(
+      trimmed,
+      "\\[\\s*mcp_servers\\s*\\.\\s*(meridian|\"meridian\")(\\s*\\.[^\\]]*)?\\s*\\]\\s*(#.*)?");
+}
+
+// A table header ("[x]", "[[x]]"), not a line of a multi-line array.
+bool IsTableHeader(std::string_view trimmed) {
+  return RE2::FullMatch(trimmed,
+                        "\\[\\[?\\s*[A-Za-z0-9_\"'.\\- ]+\\]\\]?\\s*(#.*)?");
+}
+
+std::string CodexTable(const std::string& program) {
+  return "[mcp_servers.meridian]\ncommand = " + JsonString(program) +
+         "\nargs = [\"--mcp-bridge\"]\n";
+}
+
+
+// Codex's home for an account's environment changes (ai::AccountEnv):
+// its CODEX_HOME, else the default one (the login environment's, else
+// ~/.codex). "" in a test without its own home.
+base::FilePath CodexDir(const std::map<std::string, std::string>& env) {
+  if (auto it = env.find("CODEX_HOME");
+      it != env.end() && !it->second.empty()) {
+    return base::FilePath::FromUTF8Unsafe(it->second);
+  }
+  const base::FilePath home = StateHome();
+  if (home.empty()) {
+    return base::FilePath();
+  }
+  // Taken away (the CLI's own folder): ~/.codex, whatever the login says.
+  if (env.contains("CODEX_HOME")) {
+    return home.AppendASCII(".codex");
+  }
+  return DefaultDir("CODEX_HOME", ".codex", home);
+}
+
+// Copilot's folder for an account's environment changes, as for Codex.
+base::FilePath CopilotDir(const std::map<std::string, std::string>& env) {
+  if (auto it = env.find("COPILOT_HOME");
+      it != env.end() && !it->second.empty()) {
+    return base::FilePath::FromUTF8Unsafe(it->second);
+  }
+  const FileAgent& agent = *FindFileAgent("copilot");
+  if (TestWithoutConfig(agent)) {
+    return base::FilePath();
+  }
+  return env.contains("COPILOT_HOME")
+             ? StateHome().AppendASCII(".copilot")
+             : ConfigDir(agent, std::string());
+}
+
 }  // namespace
 
+std::string WithoutCodexServer(const std::string& toml, bool* removed) {
+  *removed = false;
+  std::vector<std::string> out;
+  bool skipping = false;
+  for (const std::string& line : base::SplitString(
+           toml, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    const std::string_view trimmed =
+        base::TrimWhitespaceASCII(line, base::TRIM_ALL);
+    if (IsTableHeader(trimmed)) {
+      skipping = IsMeridianTable(trimmed);
+      *removed |= skipping;
+    }
+    if (!skipping) {
+      out.push_back(line);
+    }
+  }
+  // No run of blank lines where the table was, none at the end.
+  std::vector<std::string> tidy;
+  for (std::string& line : out) {
+    const bool blank = base::TrimWhitespaceASCII(line, base::TRIM_ALL).empty();
+    if (blank && (tidy.empty() ||
+                  base::TrimWhitespaceASCII(tidy.back(), base::TRIM_ALL)
+                      .empty())) {
+      continue;
+    }
+    tidy.push_back(std::move(line));
+  }
+  while (!tidy.empty() &&
+         base::TrimWhitespaceASCII(tidy.back(), base::TRIM_ALL).empty()) {
+    tidy.pop_back();
+  }
+  return tidy.empty() ? std::string() : base::JoinString(tidy, "\n") + "\n";
+}
+
+std::string WithCodexServer(const std::string& toml,
+                            const std::string& program,
+                            bool* changed) {
+  const std::string table = CodexTable(program);
+  bool had = false;
+  const std::string rest = WithoutCodexServer(toml, &had);
+  if (had && toml.find(table) != std::string::npos) {
+    *changed = false;
+    return toml;
+  }
+  *changed = true;
+  return rest.empty() ? table : rest + "\n" + table;
+}
+
+bool AddCodexServer(const base::FilePath& dir,
+                    const std::string& program,
+                    std::string* output) {
+  base::FilePath config = dir.AppendASCII("config.toml");
+  if (!FollowLink(&config, output)) {
+    return false;
+  }
+  const bool existed = base::PathExists(config);
+  std::string text;
+  if (existed && !base::ReadFileToString(config, &text)) {
+    *output = "couldn’t read " + config.AsUTF8Unsafe();
+    return false;
+  }
+  bool changed = false;
+  const std::string next = WithCodexServer(text, program, &changed);
+  if (!changed) {
+    *output = "already connected";
+    return true;
+  }
+  return WriteConfig(config, existed, next, output);
+}
+
+bool RemoveCodexServer(const base::FilePath& dir, std::string* output) {
+  base::FilePath config = dir.AppendASCII("config.toml");
+  if (!FollowLink(&config, output)) {
+    return false;
+  }
+  std::string text;
+  if (!base::PathExists(config)) {
+    *output = "not connected";
+    return true;
+  }
+  if (!base::ReadFileToString(config, &text)) {
+    *output = "couldn’t read " + config.AsUTF8Unsafe();
+    return false;
+  }
+  bool removed = false;
+  const std::string next = WithoutCodexServer(text, &removed);
+  if (!removed) {
+    *output = "not connected";
+    return true;
+  }
+  return WriteConfig(config, true, next, output);
+}
