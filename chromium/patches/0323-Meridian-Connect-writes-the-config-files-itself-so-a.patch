+// Copilot's portable mcp-config.json: a local server with all its tools.
+TEST_F(AgentConfigTest, CopilotIsALocalServerWithItsTools) {
+  std::string output;
+  ASSERT_TRUE(AddAgentServer("copilot", dir_, kProgram, &output)) << output;
+  base::DictValue root = ReadConfig(file("mcp-config.json"));
+  const base::DictValue* server =
+      root.FindDictByDottedPath("mcpServers.meridian");
+  ExpectCommandArgs(server);
+  EXPECT_EQ(*server->FindString("type"), "local");
+  ASSERT_TRUE(server->FindList("tools"));
+  EXPECT_EQ((*server->FindList("tools"))[0].GetString(), "*");
+}
+
+// Codex's config.toml: Meridian's table added, replaced or taken out; every
+// other line (comments, other servers, their subtables) as it was.
+TEST(CodexTomlTest, AddsReplacesAndRemovesOnlyItsTable) {
+  const std::string before =
+      "# my settings\n"
+      "model = \"gpt-5\"\n"
+      "\n"
+      "[mcp_servers.files]\n"
+      "command = \"npx\"\n"
+      "args = [\n"
+      "  \"-y\",\n"
+      "  \"files\",\n"
+      "]\n";
+  bool changed = false;
+  std::string with = WithCodexServer(before, kProgram, &changed);
+  EXPECT_TRUE(changed);
+  EXPECT_EQ(with, before + "\n[mcp_servers.meridian]\ncommand = \"" +
+                      std::string(kProgram) +
+                      "\"\nargs = [\"--mcp-bridge\"]\n");
+  // Again: nothing to do.
+  EXPECT_EQ(WithCodexServer(with, kProgram, &changed), with);
+  EXPECT_FALSE(changed);
+  // An old entry (another path, an env subtable) is replaced, the rest stays.
+  const std::string old = before +
+                          "\n[mcp_servers.\"meridian\"]\n"
+                          "command = \"/Volumes/Meridian/Meridian\"\n"
+                          "[mcp_servers.meridian.env]\nX = \"1\"\n"
+                          "\n[profiles.work]\nmodel = \"o3\"\n";
+  std::string replaced = WithCodexServer(old, kProgram, &changed);
+  EXPECT_TRUE(changed);
+  EXPECT_EQ(replaced.find("/Volumes/"), std::string::npos);
+  EXPECT_EQ(replaced.find("X = \"1\""), std::string::npos);
+  EXPECT_NE(replaced.find("[profiles.work]\nmodel = \"o3\"\n"),
+            std::string::npos);
+  EXPECT_NE(replaced.find("[mcp_servers.files]"), std::string::npos);
+  // Taken out: exactly what was there before.
+  bool removed = false;
+  EXPECT_EQ(WithoutCodexServer(with, &removed), before);
+  EXPECT_TRUE(removed);
+  EXPECT_EQ(WithoutCodexServer(before, &removed), before);
+  EXPECT_FALSE(removed);
+  // A new file is just the table.
+  EXPECT_EQ(WithCodexServer("", kProgram, &changed),
+            "[mcp_servers.meridian]\ncommand = \"" + std::string(kProgram) +
+                "\"\nargs = [\"--mcp-bridge\"]\n");
+}
