+// VS Code (Copilot's agent mode) and Visual Studio: "servers", a stdio
+// entry; everything else in the file stays, the old file kept.
+TEST_F(AgentConfigTest, VsCodeAndVisualStudioUseServers) {
+  for (const char* id : {"vscode", "visualstudio"}) {
+    const char* name =
+        std::string_view(id) == "vscode" ? "mcp.json" : ".mcp.json";
+    base::CreateDirectory(dir_);
+    ASSERT_TRUE(base::WriteFile(
+        file(name),
+        R"({"servers": {"github": {"type": "http", "url": "https://x"}},)"
+        R"( "inputs": [{"id": "token"}]})"));
+    std::string output;
+    ASSERT_TRUE(AddAgentServer(id, dir_, kProgram, &output)) << output;
+    base::DictValue root = ReadConfig(file(name));
+    const base::DictValue* server = root.FindDictByDottedPath("servers.meridian");
+    ExpectCommandArgs(server);
+    EXPECT_EQ(*server->FindString("type"), "stdio");
+    EXPECT_TRUE(root.FindDictByDottedPath("servers.github"));
+    EXPECT_TRUE(root.FindList("inputs"));
+    EXPECT_TRUE(base::PathExists(dir_.AppendASCII(std::string(name) +
+                                                  ".meridian-backup")));
+    ASSERT_TRUE(AddAgentServer(id, dir_, kProgram, &output));
+    EXPECT_EQ(output, "already connected");
+    base::DeleteFile(file(name));
+    base::DeleteFile(dir_.AppendASCII(std::string(name) + ".meridian-backup"));
+  }
+}
