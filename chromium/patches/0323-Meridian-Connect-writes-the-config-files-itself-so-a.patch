+  EXPECT_EQ(Read("config.toml.meridian-backup"), "model = \"gpt-5\"\n");
+  ASSERT_TRUE(AddCodexServer(dir_, kProgram, &output));
+  EXPECT_EQ(output, "already connected");
+  ASSERT_TRUE(RemoveCodexServer(dir_, &output)) << output;
+  EXPECT_EQ(Read("config.toml"), "model = \"gpt-5\"\n");
+}
