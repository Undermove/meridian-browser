+// A session file in Chrome's format (SNSS 3) of the given commands.
+std::string Snss(
+    const std::vector<std::unique_ptr<sessions::SessionCommand>>& commands) {
+  std::string out("SNSS\x03\x00\x00\x00", 8);
+  for (const auto& command : commands) {
+    uint16_t size = static_cast<uint16_t>(command->contents().size() + 1);
+    out.push_back(static_cast<char>(size & 0xff));
+    out.push_back(static_cast<char>(size >> 8));
+    out.push_back(static_cast<char>(command->id()));
+    out.append(base::as_string_view(command->contents()));
+  }
+  return out;
+}
+
+std::unique_ptr<sessions::SessionCommand> Nav(SessionID tab,
+                                              int index,
+                                              const char* url,
+                                              const char* title) {
+  sessions::SerializedNavigationEntry nav;
+  nav.set_index(index);
+  nav.set_virtual_url(GURL(url));
+  nav.set_title(base::UTF8ToUTF16(title));
+  return sessions::CreateUpdateTabNavigationCommand(/*kUpdateTabNavigation*/ 6,
+                                                    tab, nav);
+}
+
+// A Chrome session's open tabs: the current page of each, in tab order,
+// window by window; closed tabs, closed windows and app windows left out.
+// And without taking the browser's session ids: this runs in the thread pool,
+// and SessionIdGenerator writes Local State (a CHECK there in 1.2.0 RC).
+TEST(ImportSourceTest, ChromeOpenTabs) {
+  auto id = [](int n) { return SessionID::FromSerializedValue(n); };
+  SessionID w1 = id(1), w2 = id(2), app = id(3), gone = id(4);
+  std::vector<std::unique_ptr<sessions::SessionCommand>> c;
+  c.push_back(sessions::CreateSetWindowTypeCommand(
+      w1, sessions::SessionWindow::TYPE_NORMAL));
+  c.push_back(sessions::CreateSetWindowTypeCommand(
+      w2, sessions::SessionWindow::TYPE_NORMAL));
+  c.push_back(sessions::CreateSetWindowTypeCommand(
+      app, sessions::SessionWindow::TYPE_APP));
+  c.push_back(sessions::CreateSetWindowTypeCommand(
+      gone, sessions::SessionWindow::TYPE_NORMAL));
+  // Window 1: tab 11 (back at its first page), then tab 12 (shown second).
+  c.push_back(sessions::CreateSetTabWindowCommand(w1, id(12)));
+  c.push_back(sessions::CreateSetTabIndexInWindowCommand(id(12), 1));
+  c.push_back(Nav(id(12), 0, "https://b.example/", "B"));
+  c.push_back(sessions::CreateSetTabWindowCommand(w1, id(11)));
+  c.push_back(sessions::CreateSetTabIndexInWindowCommand(id(11), 0));
+  c.push_back(Nav(id(11), 0, "https://a.example/", "A"));
+  c.push_back(Nav(id(11), 1, "https://a.example/next", "A next"));
+  c.push_back(sessions::CreateSetSelectedNavigationIndexCommand(id(11), 0));
+  // A closed tab.
+  c.push_back(sessions::CreateSetTabWindowCommand(w1, id(13)));
+  c.push_back(Nav(id(13), 0, "https://closed.example/", "Closed"));
+  c.push_back(sessions::CreateTabClosedCommand(id(13)));
+  // Window 2: a page without a title, and a chrome:// page (skipped).
+  c.push_back(sessions::CreateSetTabWindowCommand(w2, id(21)));
+  c.push_back(Nav(id(21), 0, "https://c.example/", ""));
+  c.push_back(sessions::CreateSetTabWindowCommand(w2, id(22)));
+  c.push_back(sessions::CreateSetTabIndexInWindowCommand(id(22), 1));
+  c.push_back(Nav(id(22), 0, "chrome://settings/", "Settings"));
+  // An app window, and a closed window.
+  c.push_back(sessions::CreateSetTabWindowCommand(app, id(31)));
+  c.push_back(Nav(id(31), 0, "https://app.example/", "App"));
+  c.push_back(sessions::CreateSetTabWindowCommand(gone, id(41)));
+  c.push_back(Nav(id(41), 0, "https://gone.example/", "Gone"));
+  c.push_back(sessions::CreateWindowClosedCommand(gone));
+
+  SessionID before = SessionID::NewUnique();
+  std::vector<ArcSidebar::Tab> tabs = internal::ChromeOpenTabs(Snss(c));
+  EXPECT_EQ(SessionID::NewUnique().id(), before.id() + 1);
+
+  ASSERT_EQ(tabs.size(), 3u);
+  EXPECT_EQ(tabs[0].url, GURL("https://a.example/"));
+  EXPECT_EQ(tabs[0].title, "A");
+  EXPECT_EQ(tabs[1].url, GURL("https://b.example/"));
+  EXPECT_EQ(tabs[2].url, GURL("https://c.example/"));
+  EXPECT_EQ(tabs[2].title, "https://c.example/");
+
+  // Not a session file, or an encrypted one (version 5): nothing.
+  EXPECT_TRUE(internal::ChromeOpenTabs("hello").empty());
+  std::string encrypted = Snss(c);
+  encrypted[4] = 5;
+  EXPECT_TRUE(internal::ChromeOpenTabs(encrypted).empty());
+}
+
 }  // namespace
 }  // namespace meridian
