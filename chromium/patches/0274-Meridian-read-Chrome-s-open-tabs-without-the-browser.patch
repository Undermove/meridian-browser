+  // Replays the commands that matter for open tabs. Not with
+  // sessions::RestoreSessionFromCommands: its SessionWindow and SessionTab
+  // take ids from the browser's SessionIdGenerator, which writes Local State
+  // and must only be used on the UI thread; this runs in the thread pool
+  // (a CHECK in ImportantFileWriter once Local State had no write pending).
+  struct Tab {
+    SessionID::id_type window = 0;
+    int visual_index = 0;
+    int current = 0;
+    std::vector<sessions::SerializedNavigationEntry> navigations;  // by index
+  };
+  struct Window {
+    bool typed = false;  // only windows Chrome gave a type were open ones
+    int type = sessions::SessionWindow::TYPE_NORMAL;
+  };
+  std::map<SessionID::id_type, Tab> tabs;
+  std::map<SessionID::id_type, Window> windows;
+  struct IdAndIndex {
+    SessionID::id_type id;
+    int32_t index;
+  };
+  struct Closed {
+    SessionID::id_type id;
+    int64_t close_time;
+  };
+  struct Pruned {
+    SessionID::id_type id;
+    int32_t index;
+    int32_t count;
+  };
+  auto closest = [](std::vector<sessions::SerializedNavigationEntry>& navs,
+                    int index) {
+    return std::ranges::lower_bound(
+        navs, index, {}, &sessions::SerializedNavigationEntry::index);
+  };
+  auto prune = [&](Tab& tab, int index, int count) {
+    if (tab.current >= index && tab.current < index + count) {
+      tab.current = index - 1;
+    } else if (tab.current >= index + count) {
+      tab.current -= count;
     }
-    for (const auto& tab : window->tabs) {
-      if (tab->navigations.empty()) {
-        continue;
+    tab.navigations.erase(closest(tab.navigations, index),
+                          closest(tab.navigations, index + count));
+    for (auto& nav : tab.navigations) {
+      if (nav.index() >= index) {
+        nav.set_index(nav.index() - count);
+      }
+    }
+  };
+  // Chrome's command ids (session_service_commands.cc).
+  for (const auto& command : commands) {
+    bool ok = true;
+    switch (command->id()) {
+      case 0: {  // kCommandSetTabWindow: window id, tab id
+        SessionID::id_type payload[2];
+        if ((ok = command->GetContents(payload))) {
+          tabs[payload[1]].window = payload[0];
+        }
+        break;
+      }
+      case 2: {  // kCommandSetTabIndexInWindow
+        IdAndIndex payload;
+        if ((ok = command->GetContents(payload))) {
+          tabs[payload.id].visual_index = payload.index;
+        }
+        break;
+      }
+      case 16:    // kCommandTabClosed
+      case 17: {  // kCommandWindowClosed
+        Closed payload;
+        if ((ok = command->GetContents(payload))) {
+          if (command->id() == 16) {
+            tabs.erase(payload.id);
+          } else {
+            windows.erase(payload.id);
+          }
+        }
+        break;
+      }
+      case 5: {  // kCommandTabNavigationPathPrunedFromBack
+        IdAndIndex payload;
+        if ((ok = command->GetContents(payload))) {
+          Tab& tab = tabs[payload.id];
+          tab.navigations.erase(closest(tab.navigations, payload.index),
+                                tab.navigations.end());
+        }
+        break;
+      }
+      case 11: {  // kCommandTabNavigationPathPrunedFromFront
+        IdAndIndex payload;
+        if ((ok = command->GetContents(payload) && payload.index > 0)) {
+          prune(tabs[payload.id], 0, payload.index);
+        }
+        break;
+      }
+      case 24: {  // kCommandTabNavigationPathPruned
+        Pruned payload;
+        if ((ok = command->GetContents(payload) && payload.index >= 0 &&
+                  payload.count > 0)) {
+          prune(tabs[payload.id], payload.index, payload.count);
+        }
+        break;
+      }
+      case 6: {  // kCommandUpdateTabNavigation
+        sessions::SerializedNavigationEntry nav;
+        SessionID tab_id = SessionID::InvalidValue();
+        if ((ok = sessions::RestoreUpdateTabNavigationCommand(*command, &nav,
+                                                              &tab_id))) {
+          auto& navs = tabs[tab_id.id()].navigations;
+          auto it = closest(navs, nav.index());
+          if (it != navs.end() && it->index() == nav.index()) {
+            *it = nav;
+          } else {
+            navs.insert(it, nav);
+          }
+        }
+        break;
       }
+      case 7: {  // kCommandSetSelectedNavigationIndex
+        IdAndIndex payload;
+        if ((ok = command->GetContents(payload))) {
+          tabs[payload.id].current = payload.index;
+        }
+        break;
+      }
+      case 9: {  // kCommandSetWindowType
+        IdAndIndex payload;
+        if ((ok = command->GetContents(payload))) {
+          windows[payload.id] = {true, payload.index};
+        }
+        break;
+      }
+      default:  // bounds, pinning, groups...: nothing for open tabs
+        break;
+    }
+    if (!ok) {
+      break;  // a damaged command: keep what was read before it
+    }
+  }
+  // Window by window (oldest first), the tabs in their order.
+  std::map<SessionID::id_type, std::vector<std::pair<int, SessionID::id_type>>>
+      order;
