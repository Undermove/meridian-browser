+bool RunCli(const Known& cli, std::string* output) {
+  std::string bin = Locate(cli, LoginPath());
+  if (bin.empty()) {
+    *output = std::string(cli.bin) + " was not found on your PATH";
+    return false;
+  }
+  const std::vector<std::string> args = cli.args(Program());
+  int exit_code = -1;
+#if BUILDFLAG(IS_WIN)
+  base::CommandLine command(base::FilePath::FromUTF8Unsafe(bin));
+  for (const std::string& arg : args) {
+    command.AppendArgNative(base::UTF8ToWide(arg));
+  }
+  base::GetAppOutputAndError(command, output);
+  // (Only the output says how it went there.)
+  exit_code =
+      base::ToLowerASCII(*output).find("error") == std::string::npos ? 0 : 1;
+#else
+  // Through the login shell, for the CLI's own PATH (node and the like).
+  std::string script = Quote(bin);
+  for (const std::string& arg : args) {
+    script += " " + Quote(arg);
+  }
+  base::GetAppOutputWithExitCode(
+      base::CommandLine({Shell(), "-lc", script + " 2>&1"}), output,
+      &exit_code);
+#endif
+  if (output->size() > 2000) {
+    output->resize(2000);
+  }
+  return exit_code == 0 ||
+         base::ToLowerASCII(*output).find("already exists") !=
+             std::string::npos;
+}
