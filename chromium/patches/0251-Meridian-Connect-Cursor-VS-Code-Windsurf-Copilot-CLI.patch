+        std::string_view(id) == "cursor" ? "mcp.json" : "mcp_config.json";
+    std::string output;
+    ASSERT_TRUE(AddAgentServer(id, dir_, kProgram, &output)) << output;
+    EXPECT_EQ(output, "a new config file");
+    base::DictValue root = ReadConfig(file(name));
+    ExpectCommandArgs(root.FindDictByDottedPath("mcpServers.meridian"));
+    EXPECT_EQ(root.size(), 1u) << "nothing else in a new file";
+    ASSERT_TRUE(AddAgentServer(id, dir_, kProgram, &output));
+    EXPECT_EQ(output, "already connected");
+  }
+}
