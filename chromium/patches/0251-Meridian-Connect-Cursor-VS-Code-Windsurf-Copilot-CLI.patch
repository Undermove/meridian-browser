+// JSON with lists on one line, the way people write it.
+std::string Render(const base::Value& value) {
+  if (!value.is_list()) {
+    std::string out;
+    base::JSONWriter::Write(value, &out);
+    return out;
+  }
+  std::vector<std::string> items;
+  for (const base::Value& item : value.GetList()) {
+    items.push_back(Render(item));
+  }
+  return "[" + base::JoinString(items, ", ") + "]";
