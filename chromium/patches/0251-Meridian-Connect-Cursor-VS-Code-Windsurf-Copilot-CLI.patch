+bool AddGoose(const base::FilePath& config,
+              bool existed,
+              const std::string& text,
+              const std::string& program,
+              std::string* output) {
+  const std::string refused =
+      config.AsUTF8Unsafe() +
+      " is written in a way Meridian can’t safely add to, so it left "
+      "it as it is. " + ByHand("goose", program);
+  if (text.find('\t') != std::string::npos ||
+      text.find('\r') != std::string::npos) {
+    *output = refused;
+    return false;
+  }
+  std::vector<std::string> lines = base::SplitString(
+      text, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  while (!lines.empty() && Blank(lines.back())) {
+    lines.pop_back();
+  }
+  // A plain mapping at the top, with at most one "extensions".
+  size_t ext = std::string::npos;
+  std::string_view ext_rest;
+  for (size_t i = 0; i < lines.size(); ++i) {
+    const std::string& line = lines[i];
+    if (Blank(line) || Comment(line) || Indent(line) > 0) {
+      continue;
+    }
+    if (line == "---" && i == 0) {
+      continue;
+    }
+    if (std::string_view("-[{?&*!|>%@`.").find(line[0]) !=
+        std::string_view::npos) {
+      *output = refused;
+      return false;
+    }
+    bool plain = false;
+    std::string_view rest;
+    if (IsKey(line, "extensions", &plain, &rest)) {
+      if (!plain || ext != std::string::npos) {
+        *output = refused;
+        return false;
+      }
+      ext = i;
+      ext_rest = rest;
+    }
+  }
+
+  std::vector<std::string> block;
+  if (ext == std::string::npos) {
+    lines.push_back("extensions:");
+    block = GooseBlock(2, program);
+    lines.insert(lines.end(), block.begin(), block.end());
+  } else if (ext_rest == "{}") {
+    lines[ext] = "extensions:";
+    block = GooseBlock(2, program);
+    lines.insert(lines.begin() + ext + 1, block.begin(), block.end());
+  } else if (!ext_rest.empty() && ext_rest[0] != '#') {
+    *output = refused;
+    return false;
+  } else {
+    size_t end = ext + 1;
+    while (end < lines.size() &&
+           (Blank(lines[end]) || Comment(lines[end]) ||
+            Indent(lines[end]) > 0)) {
+      ++end;
+    }
+    size_t indent = 0;
+    size_t meridian = std::string::npos;
+    for (size_t j = ext + 1; j < end; ++j) {
+      const std::string& line = lines[j];
+      if (Blank(line) || Comment(line)) {
+        continue;
+      }
+      if (!indent) {
+        indent = Indent(line);
+      }
+      if (Indent(line) < indent) {
+        *output = refused;
+        return false;
+      }
+      if (Indent(line) > indent) {
+        continue;
+      }
+      std::string_view key = std::string_view(line).substr(indent);
+      if (key[0] == '-') {
+        *output = refused;
+        return false;
+      }
+      bool plain = false;
+      std::string_view rest;
+      if (IsKey(key, "meridian", &plain, &rest)) {
+        if (!plain || !rest.empty() || meridian != std::string::npos) {
+          *output = refused;
+          return false;
