+// ---- Goose's config.yaml, without a YAML library: Meridian only adds to
+// the plain block style Goose itself writes, and leaves anything else alone.
+
+bool Blank(std::string_view line) {
+  return base::TrimWhitespaceASCII(line, base::TRIM_ALL).empty();
+}
+
+bool Comment(std::string_view line) {
+  return base::StartsWith(base::TrimWhitespaceASCII(line, base::TRIM_LEADING),
+                          "#");
+}
+
+size_t Indent(std::string_view line) {
+  size_t n = line.find_first_not_of(' ');
+  return n == std::string_view::npos ? line.size() : n;
+}
+
+// `line` (unindented) is the mapping key `key`: `key:`, `"key" :` and the
+// like. `plain` is the form Goose writes (key: …); `rest` what follows ':'.
+bool IsKey(std::string_view line,
+           std::string_view key,
+           bool* plain,
+           std::string_view* rest) {
+  std::string_view s = line;
+  char quote = 0;
+  if (!s.empty() && (s[0] == '"' || s[0] == '\'')) {
+    quote = s[0];
+    s.remove_prefix(1);
+  }
+  if (!base::StartsWith(s, key)) {
     return false;
   }
-  *output = !existed ? "a new config file"
-            : back_up ? "the old file is saved as " +
-                            backup.BaseName().AsUTF8Unsafe()
-                      : "updated " + config.BaseName().AsUTF8Unsafe();
+  s.remove_prefix(key.size());
+  if (quote) {
+    if (s.empty() || s[0] != quote) {
+      return false;
+    }
+    s.remove_prefix(1);
+  }
+  size_t spaces = s.find_first_not_of(' ');
+  if (spaces == std::string_view::npos || s[spaces] != ':' ||
+      (spaces + 1 < s.size() && s[spaces + 1] != ' ')) {
+    return false;
+  }
+  *plain = !quote && spaces == 0;
+  *rest = base::TrimWhitespaceASCII(s.substr(spaces + 1), base::TRIM_ALL);
   return true;
