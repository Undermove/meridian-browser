+        meridian = j;
+      }
+    }
+    if (!indent) {
+      indent = 2;
+    }
+    block = GooseBlock(indent, program);
+    if (meridian != std::string::npos) {
+      size_t stop = meridian + 1;
+      while (stop < end && (Blank(lines[stop]) || Comment(lines[stop]) ||
+                            Indent(lines[stop]) > indent)) {
+        ++stop;
+      }
+      while (stop > meridian + 1 &&
+             (Blank(lines[stop - 1]) || Comment(lines[stop - 1]))) {
+        --stop;
+      }
+      if (std::vector<std::string>(lines.begin() + meridian,
+                                   lines.begin() + stop) == block) {
+        *output = "already connected";
+        return true;
+      }
+      lines.erase(lines.begin() + meridian, lines.begin() + stop);
+      lines.insert(lines.begin() + meridian, block.begin(), block.end());
