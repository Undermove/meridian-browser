+// ---- Goose (YAML)
+
+std::string GooseEntry(const std::string& indent = "  ",
+                       const std::string& program = kProgram) {
+  const std::string f = indent + indent;
+  return indent + "meridian:\n" + f + "enabled: true\n" + f + "type: stdio\n" +
+         f + "name: meridian\n" + f +
+         "description: Control the Meridian browser\n" + f + "cmd: \"" +
+         program + "\"\n" + f + "args: [\"--mcp-bridge\"]\n" + f +
+         "envs: {}\n" + f + "env_keys: []\n" + f + "timeout: 300\n";
+}
+
+constexpr char kGooseConfig[] =
+    "GOOSE_PROVIDER: anthropic\n"
+    "GOOSE_MODEL: claude-sonnet-4-5\n"
+    "extensions:\n"
+    "  developer:\n"
+    "    available_tools: []\n"
+    "    bundled: true\n"
+    "    description: null\n"
+    "    display_name: Developer\n"
+    "    enabled: true\n"
+    "    name: developer\n"
+    "    timeout: 300\n"
+    "    type: builtin\n"
+    "  github:\n"
+    "    args:\n"
+    "    - -y\n"
+    "    - github-mcp\n"
+    "    cmd: npx\n"
+    "    enabled: false\n"
+    "    envs: {}\n"
+    "    name: github\n"
+    "    type: stdio\n"
+    "GOOSE_MODE: smart_approve\n";
+
+TEST_F(AgentConfigTest, GooseNewFile) {
+  std::string output;
+  ASSERT_TRUE(AddAgentServer("goose", dir_, kProgram, &output)) << output;
+  EXPECT_EQ(Read("config.yaml"), "extensions:\n" + GooseEntry());
+}
+
+TEST_F(AgentConfigTest, GooseAddsToItsExtensionsAndKeepsTheRest) {
+  ASSERT_TRUE(base::CreateDirectory(dir_));
+  ASSERT_TRUE(base::WriteFile(file("config.yaml"), kGooseConfig));
+  std::string output;
+  ASSERT_TRUE(AddAgentServer("goose", dir_, kProgram, &output)) << output;
+  std::string expected = kGooseConfig;
+  expected.insert(expected.find("GOOSE_MODE:"), GooseEntry());
+  EXPECT_EQ(Read("config.yaml"), expected);
+  EXPECT_EQ(Read("config.yaml.meridian-backup"), kGooseConfig);
+
+  ASSERT_TRUE(AddAgentServer("goose", dir_, kProgram, &output));
+  EXPECT_EQ(output, "already connected");
+  EXPECT_EQ(Read("config.yaml"), expected);
+
+  // Meridian moved: the entry follows it, in place; the first backup stays.
+  ASSERT_TRUE(
+      AddAgentServer("goose", dir_, "/Users/x/Applications/Meridian", &output))
+      << output;
+  std::string moved = kGooseConfig;
+  moved.insert(moved.find("GOOSE_MODE:"),
+               GooseEntry("  ", "/Users/x/Applications/Meridian"));
+  EXPECT_EQ(Read("config.yaml"), moved);
+  EXPECT_EQ(Read("config.yaml.meridian-backup"), kGooseConfig);
+}
+
+TEST_F(AgentConfigTest, GooseEmptyExtensionsOrNone) {
+  ASSERT_TRUE(base::CreateDirectory(dir_));
+  ASSERT_TRUE(base::WriteFile(file("config.yaml"),
+                              "GOOSE_MODEL: x\nextensions: {}\nGOOSE_MODE: auto\n"));
+  std::string output;
+  ASSERT_TRUE(AddAgentServer("goose", dir_, kProgram, &output)) << output;
+  EXPECT_EQ(Read("config.yaml"),
+            "GOOSE_MODEL: x\nextensions:\n" + GooseEntry() + "GOOSE_MODE: auto\n");
+
+  ASSERT_TRUE(base::WriteFile(file("config.yaml"), "GOOSE_MODEL: x"));
+  ASSERT_TRUE(AddAgentServer("goose", dir_, kProgram, &output)) << output;
+  EXPECT_EQ(Read("config.yaml"), "GOOSE_MODEL: x\nextensions:\n" + GooseEntry());
+}
+
+TEST_F(AgentConfigTest, GooseFollowsTheFilesIndent) {
+  ASSERT_TRUE(base::CreateDirectory(dir_));
+  const std::string before =
+      "extensions:\n    developer:\n        enabled: true\n"
+      "        type: builtin\n        name: developer\n";
+  ASSERT_TRUE(base::WriteFile(file("config.yaml"), before));
+  std::string output;
+  ASSERT_TRUE(AddAgentServer("goose", dir_, kProgram, &output)) << output;
+  EXPECT_EQ(Read("config.yaml"), before + GooseEntry("    "));
+}
+
+TEST_F(AgentConfigTest, GooseLeavesWhatItCantReadAlone) {
+  ASSERT_TRUE(base::CreateDirectory(dir_));
+  for (const char* before : {
+           "extensions: {developer: {enabled: true}}\n",
+           "extensions:\n  \"meridian\":\n    enabled: true\n",
+           "extensions:\n  meridian: {enabled: true}\n",
+           "extensions:\n\tdeveloper:\n\t\tenabled: true\n",
+           "extensions:\n- developer\n",
+           "\"extensions\":\n  developer: {}\n",
+           "extensions: &ext\n  developer: {}\n",
+           "- a\n- b\n",
+           "a: 1\n---\nb: 2\n",
+       }) {
+    ASSERT_TRUE(base::WriteFile(file("config.yaml"), before));
+    std::string output;
+    EXPECT_FALSE(AddAgentServer("goose", dir_, kProgram, &output)) << before;
+    EXPECT_NE(output.find("can’t safely add"), std::string::npos) << output;
+    EXPECT_NE(output.find("extensions:\n  meridian:\n    enabled: true"),
+              std::string::npos)
+        << output;
+    EXPECT_EQ(Read("config.yaml"), before);
+    EXPECT_FALSE(base::PathExists(file("config.yaml.meridian-backup")));
+  }
+}
