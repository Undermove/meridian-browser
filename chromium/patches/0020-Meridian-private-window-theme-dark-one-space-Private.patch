+      private_: {type: Boolean, reflect: true, attribute: 'private'},
       sidebarPeek_: {type: Boolean, reflect: true, attribute: 'sidebar-peek'},
       inactive_: {
         type: Boolean,
@@ -148,6 +149,7 @@ export class WebuiBrowserAppElement extends CrLitElement {
   // A Little window: a link from another app, without the sidebar.
   protected accessor little_: boolean = false;
   protected accessor sidebarRight_: boolean = false;
+  protected accessor private_: boolean = false;
 
   constructor() {
     super();
@@ -514,6 +516,10 @@ export class WebuiBrowserAppElement extends CrLitElement {
     this.$.settings.show(this.$.tabstrip.spaces());
   }
 
+  protected onMeridianPrivate_(e: CustomEvent<boolean>) {
+    this.private_ = e.detail;
+  }
+
   protected onMeridianSidebarSide_(e: CustomEvent<boolean>) {
     this.sidebarRight_ = e.detail;
   }
diff --git a/chrome/browser/resources/webui_browser/meridian/sidebar.css b/chrome/browser/resources/webui_browser/meridian/sidebar.css
index 11bd6c7147..4b772b3e0c 100644
--- a/chrome/browser/resources/webui_browser/meridian/sidebar.css
+++ b/chrome/browser/resources/webui_browser/meridian/sidebar.css
@@ -255,3 +255,9 @@ button {
 #today {
   min-height: 34px;
 }
+
+/* A private window has one space. */
+:host([private]) #spaceDots,
+:host([private]) #addSpace {
+  visibility: hidden;
+}
