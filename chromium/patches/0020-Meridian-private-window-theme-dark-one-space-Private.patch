       this.onboardingShown_ = true;
@@ -852,6 +856,8 @@ export class MeridianSidebarElement extends CrLitElement implements
   override willUpdate(changed: PropertyValues<this>) {
     super.willUpdate(changed);
     this.space_ = this.activeSpace();
