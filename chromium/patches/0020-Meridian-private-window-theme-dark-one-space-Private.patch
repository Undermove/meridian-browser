@@ -115,6 +115,7 @@ export class WebuiBrowserAppElement extends CrLitElement {
       sidebarHidden_: {type: Boolean, reflect: true, attribute: 'sidebar-hidden'},
       little_: {type: Boolean, reflect: true, attribute: 'little'},
