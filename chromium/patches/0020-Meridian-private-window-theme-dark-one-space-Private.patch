From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Tue, 27 Oct 2026 19:16:50 +0400
Subject: [PATCH 21/68] Meridian: private window theme (dark, one space,
 Private badge)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/sidebar.mojom         |  2 ++
 chrome/browser/meridian/sidebar_handler.cc    |  1 +
 .../browser/resources/webui_browser/app.css   | 36 +++++++++++++++++++
 .../resources/webui_browser/app.html.ts       |  8 +++--
 chrome/browser/resources/webui_browser/app.ts |  6 ++++
 .../webui_browser/meridian/sidebar.css        |  6 ++++
 .../webui_browser/meridian/sidebar.html.ts    |  2 +-
 .../webui_browser/meridian/sidebar.ts         |  6 ++++
 8 files changed, 64 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/meridian/sidebar.mojom b/chrome/browser/meridian/sidebar.mojom
index d0c89b9057..42a17666a6 100644
--- a/chrome/browser/meridian/sidebar.mojom
+++ b/chrome/browser/meridian/sidebar.mojom
@@ -71,6 +71,8 @@ struct SidebarState {
   bool onboarding;
   // Settings that change how every window looks.
   bool sidebar_right;
+  // A private (incognito) window: dark, one space, nothing kept.
+  bool off_the_record;
   // A Little window (a link from another app): no sidebar, a bar with
   // "Open in Meridian".
   bool little;
diff --git a/chrome/browser/meridian/sidebar_handler.cc b/chrome/browser/meridian/sidebar_handler.cc
index 2c75d47a42..1c4a7b201c 100644
--- a/chrome/browser/meridian/sidebar_handler.cc
+++ b/chrome/browser/meridian/sidebar_handler.cc
@@ -863,6 +863,7 @@ mojom::SidebarStatePtr SidebarHandler::BuildState() {
   state->little = IsLittleWindow(browser_);
   state->sidebar_right =
       browser_->GetProfile()->GetPrefs()->GetBoolean(prefs::kSidebarRight);
+  state->off_the_record = browser_->GetProfile()->IsOffTheRecord();
   // Tests open the tour with --meridian-onboarding; --no-first-run (what
   // automation passes) keeps it closed.
   const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
diff --git a/chrome/browser/resources/webui_browser/app.css b/chrome/browser/resources/webui_browser/app.css
index c59ef3f256..c023adc967 100644
--- a/chrome/browser/resources/webui_browser/app.css
+++ b/chrome/browser/resources/webui_browser/app.css
@@ -449,3 +449,39 @@ cr-icon-button[hidden] {
 :host([sidebar-right][sidebar-hidden]) #main {
   padding: var(--meridian-gap);
 }
+
+/* A private (incognito) window, as in the Electron build: dark and grey,
+ * one space, nothing kept. */
+:host([private]) {
+  --meridian-space: #9a9aa6;
+  --meridian-space2: #6b6b76;
+  --meridian-text: #ececf1;
+  --meridian-text-muted: rgba(236, 236, 241, 0.55);
+  --meridian-border: rgba(255, 255, 255, 0.09);
+  --meridian-row-hover: rgba(255, 255, 255, 0.07);
+  --meridian-row-active: rgba(255, 255, 255, 0.15);
+  --meridian-row-shadow: none;
+  --meridian-field: rgba(255, 255, 255, 0.08);
+  --meridian-surface: #1f1f24;
+  --meridian-overlay: rgba(0, 0, 0, 0.5);
+  color-scheme: dark;
+  background: linear-gradient(160deg, #26262c, #141417);
+}
+
+.private-badge {
+  display: inline-flex;
+  align-items: center;
+  height: 22px;
+  padding: 0 8px;
+  margin-left: 6px;
+  border-radius: 11px;
+  font-size: 11.5px;
+  font-weight: 600;
+  color: #d8d8e0;
+  background: rgba(255, 255, 255, 0.1);
+  box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.15);
+}
+
+.private-badge[hidden] {
+  display: none;
+}
diff --git a/chrome/browser/resources/webui_browser/app.html.ts b/chrome/browser/resources/webui_browser/app.html.ts
index 90f38b24fe..93d8d72e8f 100644
--- a/chrome/browser/resources/webui_browser/app.html.ts
+++ b/chrome/browser/resources/webui_browser/app.html.ts
@@ -29,6 +29,8 @@ export function getHtml(this: WebuiBrowserAppElement) {
         </cr-button>
       </div>
 </if>
+      <span id="privateBadge" class="private-badge"
+          ?hidden="${!this.private_}">Private</span>
       <div class="grow"></div>
       <webui-browser-extensions-bar id="extensionsBar">
       </webui-browser-extensions-bar>
@@ -57,7 +59,8 @@ export function getHtml(this: WebuiBrowserAppElement) {
       </cr-button>
       <span class="host">${this.urlHost_}</span>
     </div>
-    <meridian-sidebar id="tabstrip" @tab-added="${this.onTabAdded_}"
+    <meridian-sidebar id="tabstrip" ?private="${this.private_}"
+        @tab-added="${this.onTabAdded_}"
         @tab-closed="${this.onTabClosed_}" @tab-updated="${this.onTabUpdated_}"
         @meridian-space-changed="${this.onMeridianSpaceChanged_}"
         @meridian-show-command-bar="${this.onMeridianShowCommandBar_}"
@@ -70,7 +73,8 @@ export function getHtml(this: WebuiBrowserAppElement) {
         @meridian-onboarding="${this.onMeridianOnboarding_}"
         @meridian-show-settings="${this.onMeridianShowSettings_}"
         @meridian-sidebar-side="${this.onMeridianSidebarSide_}"
-        @meridian-edit-theme="${this.onMeridianEditTheme_}">
+        @meridian-edit-theme="${this.onMeridianEditTheme_}"
+        @meridian-private="${this.onMeridianPrivate_}">
       <cr-icon-button slot="bottom-start" id="appMenuButton"
           iron-icon="cr:more-vert" title="$i18n{appMenuTooltip}"
           @click="${this.onAppMenuClick_}">
diff --git a/chrome/browser/resources/webui_browser/app.ts b/chrome/browser/resources/webui_browser/app.ts
index c00886da88..658a2b4488 100644
