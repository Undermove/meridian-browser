+    case 'done':
+      return html`<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 12.6l4.2 4.2 8.8-9.3"/></svg>`;
+    default:
+      return html`<span class="wb-dot"></span>`;
+  }
+}
+
+const TITLES: Record<WorkbenchKind, (n: number) => string> = {
+  permission: n => `${n} waiting for permission`,
+  question: n => `${n} asking you something`,
+  needs: n => `${n} ${n === 1 ? 'session needs' : 'sessions need'} you`,
+  error: n => `${n} ended with an error`,
+  pr: n => `${n} with a pull request to review`,
+  result: n => `${n} with a result ready`,
+  done: n => `${n} finished, not seen yet`,
+  working: n => `${n} working`,
+};
+
 export function workbenchBadgeHtml(badge: WorkbenchBadge|null) {
   if (!badge) {
     return '';
   }
-  const title = badge.kind === 'needs' ?
-      `${badge.count} ${
-          badge.count === 1 ? 'session needs' : 'sessions need'} you` :
-      badge.kind === 'done' ?
-      `${badge.count} finished, not seen yet` :
-      `${badge.count} working`;
-  return html`<span class="wb-badge ${badge.kind}" title="${title}"
+  return html`<span class="wb-badge ${badge.kind}"
+      title="${TITLES[badge.kind](badge.count)}"
       data-kind="${badge.kind}">${badge.kind === 'working' ?
       html`<span class="wb-spin"></span>` :
-      html`<span class="wb-dot"></span><span class="wb-count">${
+      html`${kindIcon(badge.kind)}<span class="wb-count">${
           badge.count}</span>`}</span>`;
 }
