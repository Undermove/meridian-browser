+void MissionControl::SetChatsBadge(int owner_tab,
+                                   const std::string& kind,
+                                   int count) {
+  static constexpr std::string_view kKinds[] = {
+      "", "permission", "question", "error", "pr", "result", "done", "working"};
+  auto view = chats_.find(owner_tab);
+  if (view == chats_.end() || !std::ranges::contains(kKinds, kind)) {
+    return;
+  }
+  count = std::clamp(count, 0, 999);
+  if (view->second.badge_kind == kind && view->second.badge_count == count) {
+    return;
+  }
+  view->second.badge_kind = kind;
+  view->second.badge_count = count;
+  Changed();
+}
