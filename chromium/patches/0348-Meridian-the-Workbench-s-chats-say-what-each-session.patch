 // found in the LICENSE file.
 
 // One mark on a Workbench tab's row whose page lists its sessions as chats (a
-// preview the Workbench turns on): orange with a count when sessions need
-// you, else blue with a count when turns ended that you haven't seen, else a
-// calm spinner while any works, else nothing. From Mission Control's snapshot
-// ("chats": per Workbench tab, from the sessions' own hooks).
+// preview the Workbench turns on). The page sorts its sessions out (it reads
+// their answers) and sends the top kind: permission or question (amber), an
+// error (red), a PR to look at or a result (blue), done (a blue check), with a
+// count; else a calm spinner while any works; else nothing. Older pages send
+// no kind: then orange when sessions need you, else blue when turns ended
+// unseen, else the spinner (Mission Control's own counts).
 
 import {html} from '//resources/lit/v3_0/lit.rollup.js';
+import type {TemplateResult} from '//resources/lit/v3_0/lit.rollup.js';
+
+export type WorkbenchKind =
+    'permission'|'question'|'error'|'pr'|'result'|'done'|'needs'|'working';
 
 export interface WorkbenchBadge {
-  kind: 'needs'|'done'|'working';
+  kind: WorkbenchKind;
   count: number;
   // The Mission Control node of the first session that needs you (in the
   // Workbench's list order): a click on the row opens it.
@@ -24,21 +30,35 @@ interface ChatsEntry {
   done: number;
   working: number;
   first: string;
+  kind?: string;
+  count?: number;
 }
 
+const KINDS: WorkbenchKind[] =
+    ['permission', 'question', 'error', 'pr', 'result', 'done', 'working'];
+
 // Tab handle -> mark.
 let badges = new Map<string, WorkbenchBadge>();
 let key = '';
 const listeners = new Set<() => void>();
 
+function badgeOf(c: ChatsEntry): WorkbenchBadge|null {
+  const first = c.needs > 0 ? c.first || '' : '';
+  if (typeof c.kind === 'string' && c.kind) {
+    const kind = KINDS.find(k => k === c.kind);
+    return kind ? {kind, count: Math.max(0, Number(c.count) || 0), first} :
+                  null;
+  }
+  return c.needs > 0 ? {kind: 'needs', count: c.needs, first} :
+      c.done > 0     ? {kind: 'done', count: c.done, first: ''} :
+      c.working > 0  ? {kind: 'working', count: c.working, first: ''} :
+                       null;
+}
+
 export function setWorkbenchChats(chats: ChatsEntry[]|undefined) {
   const next = new Map<string, WorkbenchBadge>();
   for (const c of Array.isArray(chats) ? chats : []) {
-    const badge: WorkbenchBadge|null = c.needs > 0 ?
-        {kind: 'needs', count: c.needs, first: c.first || ''} :
-        c.done > 0    ? {kind: 'done', count: c.done, first: ''} :
-        c.working > 0 ? {kind: 'working', count: c.working, first: ''} :
-                        null;
+    const badge = badgeOf(c);
     if (badge) {
       next.set(String(c.tab), badge);
     }
@@ -64,19 +84,45 @@ export function onWorkbenchBadges(fn: () => void): () => void {
   return () => listeners.delete(fn);
 }
 
