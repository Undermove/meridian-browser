+
+std::string TranslateTab(content::WebContents* contents,
+                         bool on,
+                         const std::string& target) {
+  ChromeTranslateClient* client =
+      contents ? ChromeTranslateClient::FromWebContents(contents) : nullptr;
+  translate::TranslateManager* manager =
+      client ? client->GetTranslateManager() : nullptr;
+  if (!manager || !IsWebSite(contents->GetLastCommittedURL())) {
+    return "this page can't be translated";
+  }
+  const translate::LanguageState& state = client->GetLanguageState();
+  if (!on) {
+    if (state.IsPageTranslated()) {
+      manager->RevertTranslation();
+    }
+    return std::string();
+  }
+  std::string to = target.empty() ? TranslateTarget(contents) : target;
+  if (state.IsPageTranslated() && state.current_language() == to) {
+    return std::string();  // already in it
+  }
+  // Before (or without) Chromium's language detection model, Google
+  // Translate tells the language itself.
+  std::string from = state.source_language();
+  manager->TranslatePage(from.empty() ? "und" : from, to,
+                         /*triggered_from_menu=*/true);
+  return std::string();
+}
