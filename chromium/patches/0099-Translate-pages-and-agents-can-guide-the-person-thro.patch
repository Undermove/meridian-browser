+    // Guide: a ring around an element and a note by it, for the person to
+    // do the step themselves. The overlay lives in a closed shadow root that
+    // ignores the mouse, follows the element and notes when the person
+    // clicks it or types into it (never what they type).
+    guide(spec, note, step, keep) {
+      const r = find(spec);
+      if (r.error) return r;
+      const el = r.el;
+      const g = window.__meridianGuide || (window.__meridianGuide = {marks: [], state: null});
+      if (!keep) this.clearGuide();
+      if (!g.host || !g.host.isConnected) {
+        g.host = document.createElement('meridian-guide');
+        g.host.style.cssText = 'all:initial;position:fixed;inset:0;pointer-events:none;z-index:2147483647';
+        g.root = g.host.attachShadow({mode: 'closed'});
+        g.root.innerHTML = `<style>
+          .ring{position:fixed;border:3px solid #7c5cff;border-radius:10px;box-shadow:0 0 0 4px rgba(124,92,255,.25),0 0 24px rgba(124,92,255,.55);animation:p 1.4s ease-in-out infinite;transition:all .12s}
+          @keyframes p{50%{box-shadow:0 0 0 9px rgba(124,92,255,.12),0 0 32px rgba(124,92,255,.7)}}
+          .tip{position:fixed;max-width:300px;background:#1f1a33;color:#fff;font:500 14px/1.4 -apple-system,system-ui,sans-serif;padding:10px 12px;border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,.3)}
+          .tip b{display:inline-block;background:#7c5cff;border-radius:6px;padding:0 6px;margin-right:6px;font-size:12px}
+          .tip:after{content:"";position:absolute;left:18px;border:7px solid transparent}
+          .tip.below:after{top:-14px;border-bottom-color:#1f1a33}.tip.above:after{bottom:-14px;border-top-color:#1f1a33}
+        </style>`;
+        document.documentElement.appendChild(g.host);
+      }
+      const ring = document.createElement('div');
+      ring.className = 'ring';
+      const tip = document.createElement('div');
+      tip.className = 'tip';
+      if (Number.isInteger(step)) {
+        const b = document.createElement('b');
+        b.textContent = 'Step ' + step;
+        tip.appendChild(b);
+      }
+      tip.appendChild(document.createTextNode(String(note || '')));
+      g.root.append(ring, tip);
+      const state = {clicked: false, typed: false};
+      const onClick = () => { state.clicked = true; };
+      const onInput = () => { state.typed = true; };
+      el.addEventListener('click', onClick, true);
+      el.addEventListener('input', onInput, true);
+      el.addEventListener('change', onInput, true);
+      const mark = {el, ring, tip, state, off: () => {
+        el.removeEventListener('click', onClick, true);
+        el.removeEventListener('input', onInput, true);
+        el.removeEventListener('change', onInput, true);
+        ring.remove(); tip.remove();
+      }};
+      g.marks.push(mark);
+      g.state = state;
+      el.scrollIntoView({block: 'center', inline: 'nearest'});
+      const place = () => {
+        if (!g.marks.includes(mark)) return;
+        const b = el.getBoundingClientRect();
+        const shown = el.isConnected && b.width + b.height > 0;
+        ring.style.display = tip.style.display = shown ? '' : 'none';
+        ring.style.left = (b.left - 6) + 'px'; ring.style.top = (b.top - 6) + 'px';
+        ring.style.width = (b.width + 6) + 'px'; ring.style.height = (b.height + 6) + 'px';
+        const th = tip.offsetHeight || 40;
+        const below = b.bottom + 14 + th < innerHeight || b.top - 14 - th < 0;
+        tip.className = 'tip ' + (below ? 'below' : 'above');
+        tip.style.left = Math.max(8, Math.min(b.left, innerWidth - tip.offsetWidth - 8)) + 'px';
+        tip.style.top = (below ? b.bottom + 14 : b.top - 14 - th) + 'px';
+        requestAnimationFrame(place);
+      };
+      place();
+      return {highlighted: clip(labelOf(el) || el.tagName.toLowerCase(), 80), marks: g.marks.length};
+    },
+
+    // What the person did with the last highlighted element.
+    guideState() {
+      const g = window.__meridianGuide;
+      if (!g || !g.state) return {none: true};
+      const last = g.marks[g.marks.length - 1];
+      return {clicked: g.state.clicked, typed: g.state.typed,
+              gone: !last || !last.el.isConnected};
+    },
+
+    clearGuide() {
+      const g = window.__meridianGuide;
+      if (!g) return {cleared: 0};
+      const n = g.marks.length;
+      for (const m of g.marks) m.off();
+      g.marks = [];
+      g.state = null;
+      return {cleared: n};
+    },
+
     has(text, selector) {
       if (selector) {
         try { if (deepOne(selector)) return true; } catch { return 'bad-selector'; }
