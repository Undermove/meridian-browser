+  // Translate (Chromium's, Google Translate): shown unless the page is in
+  // the person's language already.
+  protected translatable_(): boolean {
+    const info = this.info_;
+    return !!info && !!info.origin && !!info.translateTo &&
+        (this.translated_() || info.pageLanguage !== info.translateTo);
