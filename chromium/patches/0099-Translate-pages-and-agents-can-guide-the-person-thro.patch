+void AgentService::TranslatePage(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail(kNoTab);
+  }
+  Activity(*call, tab);
+  content::WebContents* contents = tab->GetContents();
+  bool original = call->input.FindBool("original").value_or(false);
+  std::string to = call->StrOr("to", "");
+  if (to.empty()) {
+    to = meridian::TranslateTarget(contents);
+  }
+  std::string error = meridian::TranslateTab(contents, !original, to);
+  if (!error.empty()) {
+    return call->Fail(error);
+  }
+  if (original) {
+    return call->Ok(base::Value(base::DictValue().Set("shown", "original")));
+  }
+  // Until Chromium says it's done and the page shows it (Google Translate
+  // marks the page "translated-ltr"/"-rtl"), 20 s at most.
+  struct Poll {
+    static void Step(base::WeakPtr<AgentService> self,
+                     base::WeakPtr<content::WebContents> contents,
+                     std::string to, int left, std::unique_ptr<Call> call) {
+      ChromeTranslateClient* client =
+          contents ? ChromeTranslateClient::FromWebContents(contents.get())
+                   : nullptr;
+      if (!self || !client) {
+        return call->Fail("the tab is gone");
+      }
+      const translate::LanguageState& state = client->GetLanguageState();
+      if (state.translation_error()) {
+        return call->Fail("the translator couldn't translate this page");
+      }
+      auto again = [](base::WeakPtr<AgentService> self,
+                      base::WeakPtr<content::WebContents> contents,
+                      std::string to, int left, std::unique_ptr<Call> call) {
+        if (left <= 0) {
+          return call->Ok(base::Value(
+              base::DictValue().Set("translating", true).Set("to", to)));
+        }
+        base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+            FROM_HERE,
+            base::BindOnce(&Poll::Step, self, contents, to, left - 1,
+                           std::move(call)),
+            base::Milliseconds(250));
+      };
+      if (state.translation_pending() || state.current_language() != to) {
+        return again(self, contents, to, left, std::move(call));
+      }
+      self->RunInPage(
+          contents.get(),
+          "/\\btranslated-(ltr|rtl)\\b/.test(document.documentElement."
+          "className)",
+          base::BindOnce(
+              [](decltype(again) again, base::WeakPtr<AgentService> self,
+                 base::WeakPtr<content::WebContents> contents, std::string to,
+                 int left, std::string from, std::unique_ptr<Call> call,
+                 base::Value shown) {
+                if (shown.is_bool() && shown.GetBool()) {
+                  return call->Ok(base::Value(base::DictValue()
+                                                  .Set("translated_to", to)
+                                                  .Set("from", from)));
+                }
+                again(self, contents, to, left, std::move(call));
+              },
+              again, self, contents, to, left, state.source_language(),
+              std::move(call)));
+    }
+  };
+  Poll::Step(weak_factory_.GetWeakPtr(), contents->GetWeakPtr(), to, 80,
+             std::move(call));
+}
+
+void AgentService::Highlight(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail(kNoTab);
+  }
+  Activity(*call, tab);
+  base::DictValue spec;
+  for (const char* key : {"element_index", "selector", "text"}) {
+    if (const base::Value* v = call->input.Find(key)) {
+      spec.Set(key, v->Clone());
+    }
+  }
+  std::optional<int> step = call->input.FindInt("step");
+  std::string expr = base::StringPrintf(
+      "__meridianAgent.guide(%s, %s, %s, %s)",
+      base::WriteJson(spec).value_or("{}").c_str(),
+      base::WriteJson(base::Value(call->StrOr("note", ""))).value().c_str(),
+      step ? base::NumberToString(*step).c_str() : "null",
+      call->input.FindBool("keep").value_or(false) ? "true" : "false");
+  RunInPage(tab->GetContents(), expr,
+            base::BindOnce(
+                [](std::unique_ptr<Call> call, base::Value result) {
+                  if (const base::DictValue* d = result.GetIfDict()) {
+                    if (const std::string* error = d->FindString("error")) {
+                      return call->Fail(*error);
+                    }
+                  }
+                  call->Ok(std::move(result));
+                },
+                std::move(call)));
+}
+
+void AgentService::WaitForUser(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail(kNoTab);
+  }
+  Activity(*call, tab);
+  content::WebContents* contents = tab->GetContents();
+  int timeout = std::clamp(call->input.FindInt("timeout_seconds").value_or(60),
+                           1, 300);
+  content::NavigationEntry* entry =
+      contents->GetController().GetLastCommittedEntry();
+  int page = entry ? entry->GetUniqueID() : 0;
+  base::TimeTicks deadline = base::TimeTicks::Now() + base::Seconds(timeout);
+  struct Poll {
+    static void Step(base::WeakPtr<AgentService> self,
+                     base::WeakPtr<content::WebContents> contents, int page,
+                     base::TimeTicks deadline, bool first,
+                     std::unique_ptr<Call> call) {
+      if (!self || !contents) {
+        return call->Fail("the tab is gone");
+      }
+      content::NavigationEntry* entry =
+          contents->GetController().GetLastCommittedEntry();
+      if ((entry ? entry->GetUniqueID() : 0) != page) {
+        return call->Ok(base::Value(base::DictValue().Set("did", "navigated")));
+      }
+      self->RunInPage(
+          contents.get(), "__meridianAgent.guideState()",
+          base::BindOnce(
+              [](base::WeakPtr<AgentService> self,
+                 base::WeakPtr<content::WebContents> contents, int page,
+                 base::TimeTicks deadline, bool first,
+                 std::unique_ptr<Call> call, base::Value state) {
+                const base::DictValue* s = state.GetIfDict();
+                if (s && s->FindBool("none").value_or(false)) {
+                  return first ? call->Fail("nothing is highlighted: call "
+                                            "highlight first")
+                               : call->Ok(base::Value(base::DictValue().Set(
+                                     "did", "the highlight went away")));
+                }
+                for (const char* did : {"clicked", "typed"}) {
+                  if (s && s->FindBool(did).value_or(false)) {
+                    return call->Ok(
+                        base::Value(base::DictValue().Set("did", did)));
+                  }
+                }
+                if (s && s->FindBool("gone").value_or(false)) {
+                  return call->Ok(base::Value(
+                      base::DictValue().Set("did", "the element went away")));
+                }
+                if (base::TimeTicks::Now() >= deadline) {
+                  return call->Ok(
+                      base::Value(base::DictValue().Set("did", "nothing yet")));
+                }
+                base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+                    FROM_HERE,
+                    base::BindOnce(&Poll::Step, self, contents, page, deadline,
+                                   false, std::move(call)),
+                    base::Milliseconds(300));
+              },
+              self, contents, page, deadline, first, std::move(call)));
+    }
+  };
+  Poll::Step(weak_factory_.GetWeakPtr(), contents->GetWeakPtr(), page,
+             deadline, true, std::move(call));
+}
+
+void AgentService::ClearHighlights(std::unique_ptr<Call> call) {
+  tabs::TabInterface* tab = TabFor(*call);
+  if (!tab) {
+    return call->Fail(kNoTab);
+  }
+  RunInPage(tab->GetContents(), "__meridianAgent.clearGuide()",
+            base::BindOnce(
+                [](std::unique_ptr<Call> call, base::Value result) {
+                  call->Ok(std::move(result));
+                },
+                std::move(call)));
+}
