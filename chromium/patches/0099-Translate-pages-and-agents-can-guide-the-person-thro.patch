+  protected languageName_(code: string): string {
+    try {
+      return new Intl.DisplayNames(['en'], {type: 'language'}).of(code) ||
+          code;
+    } catch {
+      return code;
+    }
+  }
+
+  protected translateState_(): string {
+    const info = this.info_!;
+    if (info.translating) {
