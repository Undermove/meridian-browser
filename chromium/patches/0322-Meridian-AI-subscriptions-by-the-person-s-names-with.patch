+// 1.4/1.5 prefs: a space's choice keeps working by its id; a kept "Default"
+// reads as the folder's name; with no main subscription kept, spaces that
+// never chose run the CLI's default as before.
+TEST_F(AccountsTest, MigratesOldPrefs) {
+  const AccountVendor& claude = *FindAccountVendor("claude");
+  Make(".claude", "settings.json");
+  base::FilePath personal = Make(".claude-personal", "settings.json");
+  base::DictValue saved;
+  saved.Set("claude", base::ListValue().Append(
+                          base::DictValue()
+                              .Set("dir", home_.AppendASCII(".claude")
+                                              .AsUTF8Unsafe())
+                              .Set("label", "Default")));
+  std::vector<Account> list = Of(
+      ListAccounts(home_, {{"CLAUDE_CONFIG_DIR", personal.AsUTF8Unsafe()}},
+                   saved),
+      "claude");
+  ASSERT_EQ(list.size(), 2u);
+  EXPECT_EQ(list[1].label, "Claude (~/.claude)");
+  EXPECT_EQ(ShownAccountLabel(claude, home_, personal, "Personal"),
+            "Personal");
+  // The 1.5 shape: space -> vendor -> {id, dir}; no main subscription.
+  const std::string own_id = AccountId(home_.AppendASCII(".claude"));
+  base::DictValue spaces;
+  spaces.Set("work",
+             base::DictValue().Set(
+                 "claude", base::DictValue()
+                               .Set("id", own_id)
+                               .Set("dir", home_.AppendASCII(".claude")
+                                               .AsUTF8Unsafe())));
+  bool from_main = true;
+  std::optional<ChosenAccount> work =
+      ChosenAccountFor(spaces, base::DictValue(), "work", "claude", &from_main);
+  ASSERT_TRUE(work);
+  EXPECT_EQ(work->id, own_id);
+  EXPECT_EQ(work->id, list[1].id);
+  EXPECT_FALSE(from_main);
+  // Never chose, no main: the CLI's default (nothing changes in its env).
+  EXPECT_FALSE(ChosenAccountFor(spaces, base::DictValue(), "home", "claude"));
+  EXPECT_FALSE(ChosenAccountFor(spaces, base::DictValue(), "work", "codex"));
+  // A main subscription: spaces that never chose (and new ones) follow it;
+  // a space's own choice still wins.
+  base::DictValue main;
+  main.Set("claude", base::DictValue()
+                         .Set("id", AccountId(personal))
+                         .Set("dir", personal.AsUTF8Unsafe()));
+  std::optional<ChosenAccount> home =
+      ChosenAccountFor(spaces, main, "home", "claude", &from_main);
+  ASSERT_TRUE(home);
+  EXPECT_EQ(home->dir, personal);
+  EXPECT_TRUE(from_main);
+  EXPECT_EQ(ChosenAccountFor(spaces, main, "work", "claude")->id, own_id);
+  EXPECT_EQ(ChosenAccountFor(spaces, main, "", "claude")->id,
+            AccountId(personal));
+  // Broken entries are ignored, not half-used.
+  base::DictValue broken;
+  broken.Set("x", base::DictValue().Set("claude",
+                                        base::DictValue().Set("id", "1")));
+  EXPECT_FALSE(ChosenAccountFor(broken, base::DictValue(), "x", "claude"));
+}
