+std::optional<ChosenAccount> ChosenAccountFor(const base::DictValue& spaces,
+                                              const base::DictValue& main,
+                                              const std::string& space_id,
+                                              const std::string& vendor_id,
+                                              bool* from_main) {
+  if (from_main) {
+    *from_main = false;
+  }
+  auto read = [](const base::DictValue* entry) -> std::optional<ChosenAccount> {
+    const std::string* id = entry ? entry->FindString("id") : nullptr;
+    const std::string* dir = entry ? entry->FindString("dir") : nullptr;
+    if (!id || id->empty() || !dir || dir->empty()) {
+      return std::nullopt;
+    }
+    return ChosenAccount{*id, base::FilePath::FromUTF8Unsafe(*dir)};
+  };
+  if (!space_id.empty()) {
+    const base::DictValue* space = spaces.FindDict(space_id);
+    if (auto own = read(space ? space->FindDict(vendor_id) : nullptr)) {
+      return own;
+    }
+  }
+  std::optional<ChosenAccount> m = read(main.FindDict(vendor_id));
+  if (m && from_main) {
+    *from_main = true;
+  }
+  return m;
+}
