+std::optional<base::FilePath> NewManagedAccountDir(const AccountVendor& vendor,
+                                                   const base::FilePath& root,
+                                                   const std::string& name,
+                                                   std::string* error) {
+  const std::string slug = Slug(name);
+  if (slug.empty()) {
+    *error = std::string(base::TrimWhitespaceASCII(name, base::TRIM_ALL))
+                     .empty()
+                 ? "Give it a name, such as Work."
+                 : "Use letters or digits in the name.";
+    return std::nullopt;
+  }
+  const std::string base_name = vendor.id + "-" + slug;
+  base::FilePath dir = root.AppendASCII(base_name);
+  for (int n = 2; base::PathExists(dir) && n < 100; n++) {
+    dir = root.AppendASCII(base_name + "-" + base::NumberToString(n));
+  }
+  return dir;
