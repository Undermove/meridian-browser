+// "Client X 2" -> "client-x-2".
+std::string Slug(const std::string& typed) {
+  std::string slug;
+  for (char c : Lower(typed)) {
+    if (base::IsAsciiAlphaNumeric(c)) {
+      slug += c;
+    } else if (!slug.empty() && slug.back() != '-') {
+      slug += '-';
+    }
+  }
+  while (!slug.empty() && slug.back() == '-') {
+    slug.pop_back();
+  }
+  if (slug.size() > 40) {
+    slug.resize(40);
+  }
+  return slug;
+}
