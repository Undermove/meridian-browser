+// The icon best for the sidebar: 32 px (16 px on a Retina screen), else the
+// nearest bigger one, else the biggest.
+bool BetterIcon(int width, int than) {
+  if (than == 32 || width == than) {
+    return false;
+  }
+  if (width == 32) {
+    return true;
+  }
+  if (width > 32) {
+    return than < 32 || width < than;
+  }
+  return than < 32 && width > than;
+}
+
+// Arc's site icons (its Favicons database), for the pages it showed them on;
+// a sidebar page Arc has none for gets its site's.
+void ReadFavicons(const base::FilePath& file,
+                  const std::map<GURL, std::u16string>& sidebar,
+                  ProfileRead& out) {
+  base::ScopedTempDir tmp;
+  sql::Database db(sql::Database::Tag("Thumbnail"));
+  if (!OpenCopy(file, tmp, db) || !db.DoesTableExist("favicons") ||
+      !db.DoesTableExist("favicon_bitmaps") ||
+      !db.DoesTableExist("icon_mapping")) {
+    return;
+  }
+  struct Icon {
+    GURL url;
+    int width = 0;
+    std::vector<uint8_t> png;
+    std::set<GURL> pages;
+  };
+  std::map<int64_t, Icon> icons;
+  sql::Statement s(db.GetUniqueStatement(
+      "SELECT f.id, f.url, b.image_data, b.width FROM favicons f "
+      "JOIN favicon_bitmaps b ON b.icon_id = f.id WHERE f.icon_type = 1"));
+  while (s.Step()) {
+    Icon& icon = icons[s.ColumnInt64(0)];
+    int width = s.ColumnInt(3);
+    if (!icon.png.empty() && !BetterIcon(width, icon.width)) {
+      continue;
+    }
+    std::vector<uint8_t> png = s.ColumnBlobAsVector(2);
+    if (png.empty()) {
+      continue;
+    }
+    icon.url = GURL(s.ColumnString(1));
+    icon.width = width;
+    icon.png = std::move(png);
+  }
+  std::erase_if(icons, [](const auto& i) {
+    return i.second.png.empty() || !i.second.url.is_valid();
+  });
+  // A site's icon: the one most of its pages have.
+  std::map<std::string, std::map<int64_t, int>> by_host;
+  sql::Statement m(
+      db.GetUniqueStatement("SELECT page_url, icon_id FROM icon_mapping"));
+  while (m.Step()) {
+    auto icon = icons.find(m.ColumnInt64(1));
+    GURL page(m.ColumnString(0));
+    if (icon == icons.end() || !page.is_valid()) {
+      continue;
+    }
+    icon->second.pages.insert(page);
+    ++by_host[page.GetHost()][icon->first];
+  }
+  for (const auto& [page, title] : sidebar) {
+    auto own = std::ranges::find_if(
+        icons, [&](const auto& i) { return i.second.pages.contains(page); });
+    if (own == icons.end()) {
+      auto host = by_host.find(page.GetHost());
+      if (host == by_host.end()) {
+        continue;
+      }
+      int64_t id = std::ranges::max_element(host->second, {},
+                                            [](const auto& c) {
+                                              return c.second;
+                                            })->first;
+      icons[id].pages.insert(page);
+    }
+    out.sidebar_pages.emplace(page, title);
+  }
+  for (auto& [id, icon] : icons) {
+    if (icon.pages.empty()) {
+      continue;
+    }
+    favicon_base::FaviconUsageData data;
+    data.favicon_url = icon.url;
+    data.png_data = std::move(icon.png);
+    data.urls = std::move(icon.pages);
+    out.favicons.push_back(std::move(data));
+  }
+}
+
+// The sidebar's pages in Arc, by Meridian profile id: pinned tabs (in folders
+// too), open tabs and favorites.
+std::map<std::string, std::map<GURL, std::u16string>> SidebarPages(
+    const ArcSidebar& sidebar) {
+  std::map<std::string, std::map<GURL, std::u16string>> out;
+  auto add = [&](const std::string& profile, const GURL& url,
+                 const std::string& title) {
+    if (url.is_valid() && url.SchemeIsHTTPOrHTTPS()) {
+      out[profile].emplace(url, base::UTF8ToUTF16(title));
+    }
+  };
+  std::function<void(const std::string&, const std::vector<Item>&)> add_items =
+      [&](const std::string& profile, const std::vector<Item>& items) {
+        for (const Item& item : items) {
+          add(profile, item.url, item.title);
+          add_items(profile, item.children);
+        }
+      };
+  for (size_t i = 0; i < sidebar.spaces.size(); ++i) {
+    const Space& space = sidebar.spaces[i];
+    add_items(space.profile, space.pinned);
+    if (i < sidebar.today.size()) {
+      for (const ArcSidebar::Tab& tab : sidebar.today[i]) {
+        add(space.profile, tab.url, tab.title);
+      }
+    }
+  }
+  add_items(std::string(), sidebar.favorites);
+  for (const auto& [profile, items] : sidebar.profile_favorites) {
+    add_items(profile, items);
+  }
+  return out;
+}
