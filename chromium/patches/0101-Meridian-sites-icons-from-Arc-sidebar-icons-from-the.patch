+  // Arc: a row clicked where the list shows it whole stays where it is. A
+  // pinned tab that isn't loaded shows in Today while it opens, then comes
+  // back: the list doesn't follow it there and back.
+  private pickedInView_ = 0;
+  private notePickedInView_(e: MouseEvent) {
+    const page = this.shadowRoot.getElementById('spacePage');
+    const row = e.currentTarget as HTMLElement | null;
+    if (!page || !row?.getBoundingClientRect) {
+      return;
+    }
+    const v = page.getBoundingClientRect();
+    const r = row.getBoundingClientRect();
+    this.pickedInView_ =
+        r.top >= v.top - 1 && r.bottom <= v.bottom + 1 ? performance.now() : 0;
+  }
