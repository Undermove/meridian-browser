@@ -294,4 +300,85 @@ base::DictValue ReadTranscriptChunk(const base::FilePath& path,
       .Set("reset", reset);
 }
 
+base::FilePath StudioHomeDir() {
+  if (HasTestSwitch("meridian-test-studio-home")) {
+    return TestSwitchPath("meridian-test-studio-home");
+  }
+  base::FilePath docs;
+  if (!base::PathService::Get(chrome::DIR_USER_DOCUMENTS, &docs)) {
+    docs = base::GetHomeDir().Append("Documents");
+  }
+  return docs.Append("Meridian Studio");
+}
+
+std::string StudioTaskFolderName(std::string_view title,
+                                 const base::Time::Exploded& day) {
+  std::u16string in = base::UTF8ToUTF16(title);
+  std::u16string out;
+  bool space = false;
+  for (char16_t c : in) {
+    // Nothing Finder or a shell minds: separators, controls, quotes.
+    const bool bad = c < 0x20 || c == 0x7f || c == '/' || c == '\\' ||
+                     c == ':' || c == '*' || c == '?' || c == '"' ||
+                     c == '<' || c == '>' || c == '|' || c == '`' ||
+                     (c >= 0x2028 && c <= 0x2029);
+    if (bad || c == ' ' || c == '\t' || c == 0xa0) {
+      space = !out.empty();
+      continue;
+    }
+    if (space) {
+      out.push_back(' ');
+      space = false;
+    }
+    out.push_back(c);
+  }
+  // Not hidden, not ".." and not ending in dots.
+  while (!out.empty() && (out.front() == '.' || out.front() == '-')) {
+    out.erase(out.begin());
+  }
+  if (out.size() > 60) {
+    out.resize(60);
+    // At a word's end when there is one near.
+    const size_t cut = out.rfind(' ');
+    if (cut != std::u16string::npos && cut > 30) {
+      out.resize(cut);
+    }
+    if (!out.empty() && CBU16_IS_LEAD(out.back())) {
+      out.pop_back();
+    }
+  }
+  while (!out.empty() && (out.back() == '.' || out.back() == ' ' ||
+                          out.back() == ',')) {
+    out.pop_back();
+  }
+  std::string name = out.empty() ? std::string("Задача") : base::UTF16ToUTF8(out);
+  return base::StringPrintf("%s, %02d.%02d.%04d", name.c_str(),
+                            day.day_of_month, day.month, day.year);
+}
+
+std::string MakeStudioTaskFolder(const base::FilePath& parent,
+                                 const std::string& name) {
+  if (!IsStudioTaskFolder(name) || !base::CreateDirectory(parent)) {
+    return std::string();
+  }
+  for (int i = 1; i <= 50; ++i) {
+    const std::string pick =
+        i == 1 ? name : base::StringPrintf("%s (%d)", name.c_str(), i);
+    const base::FilePath dir = parent.Append(base::FilePath::FromUTF8Unsafe(pick));
+    if (base::PathExists(dir)) {
+      continue;
+    }
+    return base::CreateDirectory(dir) ? pick : std::string();
+  }
+  return std::string();
+}
+
+bool IsStudioTaskFolder(std::string_view name) {
+  return !name.empty() && name.size() <= 255 && name.front() != '.' &&
+         name.find('/') == std::string_view::npos &&
+         name.find('\\') == std::string_view::npos &&
+         name.find('\0') == std::string_view::npos && name != "." &&
+         name != ".." && base::IsStringUTF8(name);
+}
+
 }  // namespace meridian::workbench
