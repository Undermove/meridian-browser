 #include "base/values.h"
 
 class Profile;
@@ -67,6 +68,26 @@ base::DictValue ReadTranscriptBefore(const base::FilePath& path,
                                      int64_t end,
                                      int64_t max);
 
+// Where Studio's tasks live when the person picked no folder of their own:
+// ~/Documents/Meridian Studio (a test may point it elsewhere). Studio never
+// asks for a folder: it opens this one.
+base::FilePath StudioHomeDir();
+
+// A new task's folder name in Studio's home: its first words and the date,
+// "Две картинки, 27.11.2026"; nothing a file system minds, at most 60
+// characters before the date.
+std::string StudioTaskFolderName(std::string_view title,
+                                 const base::Time::Exploded& day);
+
+// Makes `parent`/`name` (or "name (2)", "name (3)"… when taken) and returns
+// the name made, or "" when it couldn't. Blocking.
+std::string MakeStudioTaskFolder(const base::FilePath& parent,
+                                 const std::string& name);
+
+// A task folder a terminal may start in: one plain name, nothing hidden or
+// climbing out.
+bool IsStudioTaskFolder(std::string_view name);
+
 }  // namespace meridian::workbench
 
 #endif  // CHROME_BROWSER_MERIDIAN_WORKBENCH_STUDIO_H_
diff --git a/chrome/browser/meridian/workbench/studio_core.cc b/chrome/browser/meridian/workbench/studio_core.cc
index 9c2e0a8247..e0e8a0023d 100644
--- a/chrome/browser/meridian/workbench/studio_core.cc
