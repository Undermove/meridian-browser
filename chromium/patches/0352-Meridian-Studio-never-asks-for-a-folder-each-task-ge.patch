   EXPECT_NE(rules.find("without asking first"), std::string::npos);
 }
 
+// A new task's folder: its words and the date, nothing a file system minds,
+// a second one with the same name gets "(2)".
+TEST(StudioTest, TaskFolders) {
+  base::Time::Exploded day = {};
+  day.year = 2026;
+  day.month = 11;
+  day.day_of_month = 27;
+  EXPECT_EQ(StudioTaskFolderName("Две картинки", day), "Две картинки, 27.11.2026");
+  EXPECT_EQ(StudioTaskFolderName("  ../a/b:c?  ", day), "a b c, 27.11.2026");
+  EXPECT_EQ(StudioTaskFolderName("", day), "Задача, 27.11.2026");
+  const std::string long_name = StudioTaskFolderName(
+      "Мне нужно сделать две картинки чтобы я сравнил их сайд бай сайд и ещё "
+      "что-нибудь",
+      day);
+  EXPECT_LE(base::UTF8ToUTF16(long_name).size(), 72u);
+  EXPECT_TRUE(base::IsStringUTF8(long_name));
+  EXPECT_TRUE(IsStudioTaskFolder("Две картинки, 27.11.2026"));
+  for (const char* bad : {"", ".", "..", ".hidden", "a/b", "a\\b"}) {
+    EXPECT_FALSE(IsStudioTaskFolder(bad)) << bad;
+  }
+
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath home = temp.GetPath().Append("Meridian Studio");
+  EXPECT_EQ(MakeStudioTaskFolder(home, "Логотип, 27.11.2026"),
+            "Логотип, 27.11.2026");
+  EXPECT_EQ(MakeStudioTaskFolder(home, "Логотип, 27.11.2026"),
+            "Логотип, 27.11.2026 (2)");
+  EXPECT_TRUE(base::DirectoryExists(
+      home.Append(base::FilePath::FromUTF8Unsafe("Логотип, 27.11.2026 (2)"))));
+  EXPECT_EQ(MakeStudioTaskFolder(home, "../x"), "");
+}
+
 }  // namespace
 }  // namespace meridian::workbench
