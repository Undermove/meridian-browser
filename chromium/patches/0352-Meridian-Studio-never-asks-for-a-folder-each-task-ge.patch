+            },
+            weak_factory_.GetWeakPtr(), home, std::move(reply)));
+    return;
+  }
+  if (method == "studioTaskFolder") {
+    // A new task's own folder in Studio's home ("" in the person's own
+    // folder: there the task works in it).
