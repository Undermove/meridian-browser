From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Fri, 20 Nov 2026 18:12:54 +0400
Subject: [PATCH 204/204] Meridian: agents get a clear refusal for file:// URLs
 instead of https://file///

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SwxrQ2eLfJ2bv8cCoG2va1
---
 chrome/browser/meridian/agent/agent_service.cc | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/meridian/agent/agent_service.cc b/chrome/browser/meridian/agent/agent_service.cc
index fe9f48d616..9c52bf2dd3 100644
--- a/chrome/browser/meridian/agent/agent_service.cc
+++ b/chrome/browser/meridian/agent/agent_service.cc
@@ -1247,6 +1247,15 @@ GURL ToUrl(Profile* profile, const std::string& text) {
   if (url.is_valid() && (url.SchemeIsHTTPOrHTTPS() || url.IsAboutBlank())) {
     return url;
   }
+  // Any other scheme (file:, chrome:, data:, ...) is refused, not turned
+  // into "https://file///...".
+  if (url.is_valid() &&
+      (url.SchemeIsFile() || url.SchemeIsFileSystem() ||
+       url.SchemeIsBlob() || url.SchemeIs("chrome") ||
+       url.SchemeIs("chrome-extension") || url.SchemeIs("view-source") ||
+       url.SchemeIs("data") || url.SchemeIs("javascript"))) {
+    return GURL();
+  }
   if (text.find(' ') == std::string::npos &&
       text.find('.') != std::string::npos) {
     GURL https("https://" + text);
@@ -1270,7 +1279,9 @@ GURL ToUrl(Profile* profile, const std::string& text) {
 void AgentService::OpenTab(std::unique_ptr<Call> call) {
   GURL url = ToUrl(profile_, call->StrOr("url", ""));
   if (!url.is_valid()) {
-    return call->Fail("not a URL");
+    return call->Fail(
+        "only http(s) URLs can be opened by an agent (file://, chrome:// and "
+        "other schemes are blocked so a page can't read local files)");
   }
   std::string summary = "open " + url.spec();
   Confirm(
