+// The SHA-256 of what is left to read in `file`, or nothing if it can't be
+// read. Blocking.
+std::optional<std::string> HashOf(base::File& file) {
   crypto::hash::Hasher hasher(crypto::hash::kSha256);
   std::vector<uint8_t> buffer(1 << 20);
   while (true) {
     std::optional<size_t> n = file.ReadAtCurrentPos(buffer);
     if (!n) {
-      return fail("The download couldn’t be read.");
+      return std::nullopt;
     }
     if (*n == 0) {
       break;
@@ -171,7 +164,141 @@ std::pair<std::string, std::string> Verify(base::FilePath installer,
   }
   std::array<uint8_t, crypto::hash::kSha256Size> digest;
   hasher.Finish(digest);
-  if (base::HexEncodeLower(digest) != sum) {
+  return base::HexEncodeLower(digest);
+}
+
+// An update handed over and waiting for Meridian to quit: the script, and the
+// process that keeps the installer and the script open until it has run.
+struct PendingInstall {
+  base::Process script;
+  base::Process holder;
+  base::FilePath installer;
+};
+
+// On the UI thread.
+PendingInstall& Pending() {
+  static base::NoDestructor<PendingInstall> pending;
+  return *pending;
+}
+bool g_install_starting = false;
+
+// On a worker: checks the installer against the signed checksum and starts
+// the script. The handle it reads through stays open in a small process that
+// outlives Meridian, until the script is done. That process is a ping and not
+// the script because whatever cmd starts inherits cmd's handles, and the
+// browser it opens would then keep the installer open. An error for the
+// person, or none, and what is now pending.
+std::pair<std::string, PendingInstall> StartInstall(PendingInstall old,
+                                                    base::FilePath dir,
+                                                    base::FilePath installer,
+                                                    std::string sum,
+                                                    std::string script) {
+  auto fail = [](std::string error) {
+    return std::make_pair(std::move(error), PendingInstall());
+  };
+  // Asked again after a quit that was cancelled.
+  if (old.installer == installer && old.script.IsValid() &&
+      old.holder.IsValid() && old.script.IsRunning() &&
+      old.holder.IsRunning()) {
+    return std::make_pair(std::string(), std::move(old));
+  }
+  if (old.script.IsValid()) {
+    old.script.Terminate(0, /*wait=*/true);
+  }
+  if (old.holder.IsValid()) {
+    old.holder.Terminate(0, /*wait=*/true);
+  }
+  if (!old.installer.empty() && old.installer != installer) {
+    base::DeleteFile(old.installer);
+  }
+
+  base::File held(installer, base::File::FLAG_OPEN | base::File::FLAG_READ |
+                                 base::File::FLAG_WIN_EXCLUSIVE_WRITE);
+  if (!held.IsValid()) {
+    return fail("The update couldn’t be checked before installing.");
+  }
+  std::optional<std::string> hash = HashOf(held);
+  if (!hash || sum.empty() || *hash != sum) {
+    held.Close();
+    base::DeleteFile(installer);
+    return fail("The update couldn’t be verified, so it wasn’t installed.");
+  }
+
+  base::FilePath path = dir.AppendASCII("update.cmd");
+  base::FilePath system;
+  if (!base::DeleteFile(path) ||
+      !base::PathService::Get(base::DIR_SYSTEM, &system)) {
+    return fail("Couldn’t start the update.");
+  }
+  // Created new, through the handle that stays open.
+  base::File held_script(path, base::File::FLAG_CREATE |
+                                   base::File::FLAG_WRITE |
+                                   base::File::FLAG_WIN_EXCLUSIVE_WRITE);
+  if (!held_script.IsValid() ||
+      !held_script.WriteAtCurrentPosAndCheck(base::as_byte_span(script))) {
+    return fail("Couldn’t start the update.");
+  }
+  HANDLE handles[] = {held.GetPlatformFile(), held_script.GetPlatformFile()};
+  for (HANDLE handle : handles) {
+    if (!::SetHandleInformation(handle, HANDLE_FLAG_INHERIT,
+                                HANDLE_FLAG_INHERIT)) {
+      return fail("Couldn’t start the update.");
+    }
+  }
+
+  base::CommandLine hold(system.AppendASCII("ping.exe"));
+  hold.AppendArg("-n");
+  hold.AppendArg("86400");
+  hold.AppendArg("127.0.0.1");
+  base::LaunchOptions hold_options;
+  hold_options.start_hidden = true;
+  hold_options.current_directory = system;
+  hold_options.handles_to_inherit = {handles[0], handles[1]};
+  PendingInstall pending;
+  pending.installer = installer;
+  pending.holder = base::LaunchProcess(hold, hold_options);
+  if (!pending.holder.IsValid()) {
+    return fail("Couldn’t start the update.");
+  }
+
+  base::CommandLine line(system.AppendASCII("cmd.exe"));
+  line.AppendArgNative(L"/d");
+  line.AppendArgNative(L"/c");
+  line.AppendArgPath(path);
+  base::LaunchOptions options;
+  // No console window; the script outlives Meridian.
+  options.start_hidden = true;
+  // Not in Meridian's own folder (<version>, where the browser runs): the
+  // installer replaces that folder, and Windows doesn't let go of a folder
+  // some process is in.
+  options.current_directory = system;
+  options.environment[L"MERIDIAN_UPDATE_HOLD"] =
+      base::NumberToWString(pending.holder.Pid());
+  pending.script = base::LaunchProcess(line, options);
+  if (!pending.script.IsValid()) {
+    pending.holder.Terminate(0, /*wait=*/false);
+    return fail("Couldn’t start the update.");
+  }
+  return std::make_pair(std::string(), std::move(pending));
+}
+
+// On a worker: whether the downloaded installer is the one the signed
+// checksums name. An error for the person, or none (the second of the pair
+// is the macOS updater's code-signing requirement; there is none here).
+std::pair<std::string, std::string> Verify(base::FilePath installer,
+                                           std::string sum) {
+  auto fail = [](std::string error) {
+    return std::make_pair(std::move(error), std::string());
+  };
+  base::File file(installer, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return fail("The download is missing.");
+  }
+  std::optional<std::string> hash = HashOf(file);
+  if (!hash) {
+    return fail("The download couldn’t be read.");
+  }
+  if (*hash != sum) {
     file.Close();
     base::DeleteFile(installer);
     return fail("The download doesn’t match the release’s checksum.");
@@ -404,6 +531,7 @@ void Updater::OnSig(std::optional<std::string> body) {
     Fail("The release has no checksum for Windows.");
