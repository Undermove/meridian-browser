diff --git a/chrome/browser/meridian/update_check.cc b/chrome/browser/meridian/update_check.cc
index 55b7e123d4..fd5e4eff68 100644
--- a/chrome/browser/meridian/update_check.cc
+++ b/chrome/browser/meridian/update_check.cc
@@ -196,21 +196,24 @@ std::string WindowsInstallScript(int pid,
   const std::string id = base::NumberToString(pid);
   std::string script =
       "@echo off\r\n"
-      "chcp 65001 >nul\r\n"
+      "%SystemRoot%\\System32\\chcp.com 65001 >nul\r\n"
       // ping is the wait that works without a console.
       ":wait\r\n"
-      "tasklist /fi \"PID eq " + id + "\" 2>nul | find \" " + id +
-      " \" >nul && (ping -n 2 127.0.0.1 >nul & goto wait)\r\n"
+      "%SystemRoot%\\System32\\tasklist.exe /fi \"PID eq " + id +
+      "\" 2>nul | %SystemRoot%\\System32\\find.exe \" " + id +
+      " \" >nul && (%SystemRoot%\\System32\\ping.exe -n 2 127.0.0.1 >nul & "
+      "goto wait)\r\n"
       "set tries=0\r\n"
       ":install\r\n"
-      "ping -n 3 127.0.0.1 >nul\r\n" +
-      quoted(setup) +
+      "%SystemRoot%\\System32\\ping.exe -n 3 127.0.0.1 >nul\r\n" +
+      kWindowsCheckHold + quoted(setup) +
       " --do-not-launch-chrome\r\n"
       "if not errorlevel 1 goto done\r\n"
       "set /a tries+=1\r\n"
       "if %tries% lss 5 goto install\r\n"
       "echo the installer failed\r\n"
       ":done\r\n";
+  script += kWindowsReleaseHold;
   if (!browser.empty()) {
     script += "start \"\" " + quoted(browser) + "\r\n";
   }
diff --git a/chrome/browser/meridian/update_check.h b/chrome/browser/meridian/update_check.h
index 8846dadbab..6bf5c04c1b 100644
--- a/chrome/browser/meridian/update_check.h
+++ b/chrome/browser/meridian/update_check.h
@@ -71,6 +71,9 @@ struct Release {
     std::string url;
   };
   std::map<std::string, Delta> deltas;
+  // Windows: the installer's SHA-256 from the signed checksums, once they
+  // have been verified. The installer is checked against it before it runs.
+  std::string sum;
 };
 
 // Whether the updater may download `url`: https only, or also http from a
@@ -96,6 +99,23 @@ std::optional<Release> ParseWindowsRelease(std::string_view json,
 // hidden with cmd.exe): waits for `pid` to exit, runs the installer `setup`
 // (a few tries: Meridian's other processes may take a moment to go), then
 // opens `browser` unless it is empty, and removes the installer.
+// A process (its id in MERIDIAN_UPDATE_HOLD) keeps both files open until then.
+// kWindowsCheckHold stops the script, without installing, if it has ended; the
+// next Restart to update checks the installer again. kWindowsReleaseHold ends
+// it. Windows's own tools by their full path: a `find` or `ping` from Git or
+// Cygwin may come first on PATH.
+inline constexpr char kWindowsCheckHold[] =
+    "if not defined MERIDIAN_UPDATE_HOLD exit /b 3\r\n"
+    "%SystemRoot%\\System32\\tasklist.exe "
+    "/fi \"PID eq %MERIDIAN_UPDATE_HOLD%\" "
+    "/fi \"imagename eq ping.exe\" 2>nul | "
+    "%SystemRoot%\\System32\\find.exe \" %MERIDIAN_UPDATE_HOLD% \" >nul "
+    "|| exit /b 3\r\n";
+inline constexpr char kWindowsReleaseHold[] =
+    "if defined MERIDIAN_UPDATE_HOLD (%SystemRoot%\\System32\\taskkill.exe "
+    "/f /pid %MERIDIAN_UPDATE_HOLD% /fi \"imagename eq ping.exe\" >nul 2>&1 & "
+    "%SystemRoot%\\System32\\ping.exe -n 2 127.0.0.1 >nul)\r\n"
+    "set MERIDIAN_UPDATE_HOLD=\r\n";
 std::string WindowsInstallScript(int pid,
                                  const base::FilePath& setup,
                                  const base::FilePath& browser);
