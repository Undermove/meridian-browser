+TEST(UpdateCheckTest, TheWindowsInstallScriptNeedsItsHold) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  base::FilePath system;
+  ASSERT_TRUE(base::PathService::Get(base::DIR_SYSTEM, &system));
+  // A process that has ended, for an id that is no longer a hold.
+  base::CommandLine done(system.AppendASCII("ping.exe"));
+  done.AppendArg("-n");
+  done.AppendArg("1");
+  done.AppendArg("127.0.0.1");
+  base::LaunchOptions done_options;
+  done_options.start_hidden = true;
+  base::Process ended = base::LaunchProcess(done, done_options);
+  ASSERT_TRUE(ended.IsValid());
+  ASSERT_TRUE(ended.WaitForExitWithTimeout(base::Seconds(10), nullptr));
+  const std::string ended_id = base::NumberToString(ended.Pid());
+
+  base::FilePath setup = dir.GetPath().AppendASCII("setup.cmd");
+  base::FilePath ran = dir.GetPath().AppendASCII("ran");
+  ASSERT_TRUE(base::WriteFile(
+      setup, "@echo ran> \"" + ran.AsUTF8Unsafe() + "\"\r\n"));
+  base::FilePath script = dir.GetPath().AppendASCII("update.cmd");
+  ASSERT_TRUE(base::WriteFile(
+      script, WindowsInstallScript(999999, setup, base::FilePath())));
+  base::CommandLine line(system.AppendASCII("cmd.exe"));
+  line.AppendArgNative(L"/d");
+  line.AppendArgNative(L"/c");
+  line.AppendArgPath(script);
+  for (bool has_id : {false, true}) {
+    std::optional<base::ScopedEnvironmentVariableOverride> env;
+    if (has_id) {
+      env.emplace("MERIDIAN_UPDATE_HOLD", ended_id);
+    } else {
+      env.emplace("MERIDIAN_UPDATE_HOLD");
+    }
+    std::string out;
+    int code = 0;
+    ASSERT_TRUE(base::GetAppOutputWithExitCode(line, &out, &code));
+    EXPECT_EQ(code, 3) << out;
+    EXPECT_FALSE(base::PathExists(ran));
+    EXPECT_TRUE(base::PathExists(setup));
+  }
 }
 #endif
 
