From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove1@gmail.com>
Date: Thu, 19 Nov 2026 21:33:30 +0400
Subject: [PATCH 186/202] Meridian: a Windows shell tab is named cmd or
 PowerShell

Until the shell sets a title, a shell tab is named after the shell; on
Windows that was the file (cmd.exe, powershell.exe). Now it is the name:
cmd, or PowerShell for powershell.exe and pwsh.exe.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/meridian/workbench/agents.cc   | 22 ++++++++++++++++++-
 .../meridian/workbench/agents_unittest.cc     |  7 ++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/meridian/workbench/agents.cc b/chrome/browser/meridian/workbench/agents.cc
index 5b2c4e54a8..a558deefe7 100644
--- a/chrome/browser/meridian/workbench/agents.cc
+++ b/chrome/browser/meridian/workbench/agents.cc
@@ -199,6 +199,26 @@ base::DictValue DetectAgents(const std::string& search_path) {
   return out;
 }
 
+namespace {
+
+// A shell tab's name until the shell sets a title.
+std::string ShellTitle(const std::string& shell) {
+  base::FilePath name = base::FilePath::FromUTF8Unsafe(shell).BaseName();
+#if BUILDFLAG(IS_WIN)
+  // "cmd", "PowerShell": the name, not the file.
+  std::string stem =
+      base::ToLowerASCII(name.RemoveExtension().AsUTF8Unsafe());
+  if (stem == "powershell" || stem == "pwsh") {
+    return "PowerShell";
+  }
+  return stem;
+#else
+  return name.AsUTF8Unsafe();
+#endif
+}
+
+}  // namespace
+
 base::expected<LaunchSpec, std::string> MakeLaunchSpec(
     const std::string& kind,
     const std::string& search_path,
@@ -206,7 +226,7 @@ base::expected<LaunchSpec, std::string> MakeLaunchSpec(
     const McpBridge& bridge) {
   LaunchSpec spec;
   if (kind == "shell") {
-    spec.title = base::FilePath::FromUTF8Unsafe(shell).BaseName().AsUTF8Unsafe();
+    spec.title = ShellTitle(shell);
 #if BUILDFLAG(IS_WIN)
     // (cmd.exe and PowerShell have no login mode.)
     spec.argv = {shell};
diff --git a/chrome/browser/meridian/workbench/agents_unittest.cc b/chrome/browser/meridian/workbench/agents_unittest.cc
index d0a6a441cc..1064237631 100644
--- a/chrome/browser/meridian/workbench/agents_unittest.cc
+++ b/chrome/browser/meridian/workbench/agents_unittest.cc
@@ -58,6 +58,13 @@ TEST(WorkbenchAgentsTest, MissingAgentSaysHowToInstall) {
   EXPECT_EQ(MakeLaunchSpec("shell", "", "C:\\Windows\\System32\\cmd.exe", {})
                 ->argv,
             (std::vector<std::string>{"C:\\Windows\\System32\\cmd.exe"}));
+  EXPECT_EQ(MakeLaunchSpec("shell", "", "C:\\Windows\\System32\\cmd.exe", {})
+                ->title,
+            "cmd");
+  EXPECT_EQ(MakeLaunchSpec("shell", "",
+                           "C:\\Program Files\\PowerShell\\7\\pwsh.exe", {})
+                ->title,
+            "PowerShell");
 #else
   EXPECT_EQ(MakeLaunchSpec("shell", "", "/bin/zsh", {})->argv,
             (std::vector<std::string>{"/bin/zsh", "-l"}));
