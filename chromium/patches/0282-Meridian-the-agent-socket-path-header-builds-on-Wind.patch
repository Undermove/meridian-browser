From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Afonchenko <undermove@yandex.ru>
Date: Wed, 25 Nov 2026 12:29:33 +0400
Subject: [PATCH 282/297] Meridian: the agent socket path header builds on
 Windows

AgentSocketPath is not on Windows (no unix socket there), but its
header's default argument base::FilePath("/tmp") doesn't compile
there, and meridian_unittests includes it on every platform. Declare
it on POSIX only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/meridian/agent/socket_path.h | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/chrome/browser/meridian/agent/socket_path.h b/chrome/browser/meridian/agent/socket_path.h
index effd001c37..d667ce4e2c 100644
--- a/chrome/browser/meridian/agent/socket_path.h
+++ b/chrome/browser/meridian/agent/socket_path.h
@@ -6,9 +6,11 @@
 #define CHROME_BROWSER_MERIDIAN_AGENT_SOCKET_PATH_H_
 
 #include "base/files/file_path.h"
+#include "build/build_config.h"
 
 namespace meridian {
 
+#if !BUILDFLAG(IS_WIN)
 // Where the agent socket goes (AgentServer, not on Windows). A unix socket's
 // path must stay under ~104 bytes, and profile folders (or TMPDIR) can be
 // longer: in `user_data_dir` when it fits, else
@@ -20,6 +22,7 @@ base::FilePath AgentSocketPath(
     const base::FilePath& user_data_dir,
     base::FilePath* temp_dir,
     const base::FilePath& short_root = base::FilePath("/tmp"));
+#endif  // !BUILDFLAG(IS_WIN)
 
 }  // namespace meridian
 
