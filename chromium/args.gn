# Lean release build: no debug symbols, one big binary. ~9 GB in out/, ~2.5 h first build on an M4.
is_debug = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
is_component_build = false
# What users run: Chromium's internal checks (DCHECKs) off, as in Chrome. They crash on a failed
# assertion, which is for catching bugs while developing, not for people's browsers.
dcheck_always_on = false
# H.264, AAC and HEVC video plays, but decoded by the system, whose maker holds the licences, as
# Firefox does: macOS (VideoToolbox, AudioToolbox) and Windows (Direct3D 11, Media Foundation).
# Meridian's own FFmpeg has no H.264 or AAC decoder there (the FFmpeg patches in
# patches/third_party/ffmpeg take them out), and no OpenH264 is bundled. Linux has no such
# decoder of its own: its build still carries FFmpeg's, which is to be settled before a release.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
media_use_openh264 = false
