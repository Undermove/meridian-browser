# Lean release build: no debug symbols, one big binary. ~9 GB in out/, ~2.5 h first build on an M4.
is_debug = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
is_component_build = false
# What users run: Chromium's internal checks (DCHECKs) off, as in Chrome. They crash on a failed
# assertion, which is for catching bugs while developing, not for people's browsers.
dcheck_always_on = false
