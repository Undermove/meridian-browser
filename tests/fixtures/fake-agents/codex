#!/usr/bin/env node
// Fake `codex` for the Mission Control e2e test: finds the `-c notify=[…]` override Meridian passed
// and runs that program with a synthetic agent-turn-complete payload, like Codex does after a turn.
'use strict';
const fs = require('fs');
const { spawnSync } = require('child_process');
const args = process.argv.slice(2);
let notify = null;
for (let i = 0; i < args.length; i++) if (args[i] === '-c' && /^notify=/.test(args[i + 1] || '')) notify = JSON.parse(args[i + 1].slice(7));
console.log(`fake-codex: notify=${notify ? 'yes' : 'no'}`);
const script = JSON.parse(fs.readFileSync(process.env.FAKE_AGENT_SCRIPT, 'utf8')).codex || [];
const sleep = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
for (const step of script) {
  if (step.sleep) sleep(step.sleep);
  if (step.waitFile) { while (!fs.existsSync(step.waitFile)) sleep(100); }
  if (step.exit !== undefined) process.exit(step.exit);
  if (step.turn && notify) {
    const payload = { type: 'agent-turn-complete', 'thread-id': 'thread-1', 'turn-id': String(step.turn), cwd: process.cwd(), 'input-messages': ['secret input'], 'last-assistant-message': 'secret answer' };
    spawnSync(notify[0], [...notify.slice(1), JSON.stringify(payload)], { env: process.env, timeout: 5000 });
  }
}
setInterval(() => {}, 1000);
