{
  "name": "meridian-browser",
  "productName": "Meridian",
  "version": "0.1.0",
  "description": "Meridian — the open-source Arc browser alternative. Spaces, pinned tabs, auto-archiving Today, split view, Peek, command bar, and one-click import from Arc.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir",
    "dist:dmg": "electron-builder --mac dmg"
  },
  "keywords": [
    "arc",
    "arc-browser",
    "arc-alternative",
    "arc-browser-alternative",
    "browser",
    "web-browser",
    "electron",
    "chromium",
    "vertical-tabs",
    "spaces",
    "split-view",
    "open-source"
  ],
  "author": "Dmitry Afonchenko",
  "license": "MIT",
  "build": {
    "appId": "dev.meridian.browser",
    "productName": "Meridian",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir",
        "dmg"
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ]
          }
        ],
        "NSCameraUsageDescription": "Websites you allow can use the camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use the microphone."
      }
    },
    "protocols": [
      {
        "name": "Web URL",
        "schemes": [
          "http",
          "https"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "cross-fetch": "^4.1.0"
  }
}
