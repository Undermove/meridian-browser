{
  "name": "meridian-browser",
  "productName": "Meridian",
  "version": "0.2.2",
  "description": "Meridian — the open-source Arc browser alternative for macOS, Windows and Linux. Spaces, pinned tabs, auto-archiving Today, split view, Peek, command bar, one-click Arc import, and a built-in MCP server so AI agents like Claude can drive the browser.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:mcp": "esbuild mcp/meridian-mcp.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist-mcp/meridian-mcp.cjs",
    "dist": "npm run build:mcp && electron-builder --dir",
    "dist:mac": "npm run build:mcp && electron-builder --mac",
    "dist:win": "npm run build:mcp && electron-builder --win",
    "dist:linux": "npm run build:mcp && electron-builder --linux",
    "mcp": "node mcp/meridian-mcp.js",
    "postinstall": "node build/fix-node-pty.js",
    "test:e2e": "playwright test -c tests/playwright.config.js",
    "dist:local": "npm run build:mcp && electron-builder --mac dir --arm64 -c.directories.output=dist-next && scripts/sign-local.sh dist-next/mac-arm64/Meridian.app"
  },
  "keywords": [
    "arc",
    "arc-browser",
    "arc-alternative",
    "arc-browser-alternative",
    "browser",
    "web-browser",
    "electron",
    "chromium",
    "vertical-tabs",
    "spaces",
    "split-view",
    "mcp",
    "mcp-server",
    "ai-browser",
    "claude",
    "open-source",
    "windows",
    "linux",
    "macos"
  ],
  "author": "Dmitry Afonchenko <undermove1@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Undermove/meridian-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/Undermove/meridian-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Undermove/meridian-browser/issues"
  },
  "build": {
    "appId": "dev.meridian.browser",
    "productName": "Meridian",
    "files": [
      "src/**/*",
      "build/icon-1024.png",
      "build/sandbox/**",
      "package.json",
      "!node_modules/monaco-editor/{esm,dev}/**",
      "!node_modules/monaco-editor/**/*.map",
      "!node_modules/@xterm/**/*.map",
      "!node_modules/node-pty/{src,deps,third_party,scripts,typings}/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "src/dev/hooks/**",
      "src/agents/hooks/**"
    ],
    "extraResources": [
      {
        "from": "dist-mcp",
        "to": "mcp"
      }
    ],
    "protocols": [
      {
        "name": "Web URL",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ]
          }
        ],
        "NSCameraUsageDescription": "Websites you allow can use the camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use the microphone."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-1024.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        }
      ],
      "icon": "build/icon-1024.png",
      "category": "Network;WebBrowser",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "Meridian"
        }
      },
      "maintainer": "Dmitry Afonchenko <undermove1@gmail.com>"
    },
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": null
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@ghostery/adblocker-electron": "^2.20.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cross-fetch": "^4.1.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0"
  }
}
